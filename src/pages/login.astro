---
import Layout from '../layouts/Layout.astro';
import { getUserFromCookies } from '../lib/auth';

// Si ya está autenticado, redirigir directamente al Dashboard
const currentUser = getUserFromCookies(Astro.cookies);
if (currentUser) {
  return Astro.redirect('/dashboard');
}
---

<Layout title="Iniciar Sesión | Envías - Logística Central" description="Acceso al portal administrativo y operativo de Envías.">
  <main class="w-full max-w-md bg-white rounded-3xl shadow-2xl border border-slate-200/80 p-7 sm:p-9 my-auto transition-all duration-300 relative">
    
    <!-- Encabezado con Logo y Marca -->
    <header class="flex flex-col items-center text-center gap-3 border-b border-slate-100 pb-6 mb-6">
      <div class="flex items-center justify-center">
        <img 
          src="/logo.png" 
          alt="Envías C.A." 
          class="h-10 sm:h-11 w-auto object-contain mix-blend-multiply filter contrast-[1.20] brightness-[0.96]"
          loading="eager"
        />
      </div>
      <div>
        <div class="flex items-center justify-center gap-2 mt-1">
          <span class="text-[11px] font-bold px-2 py-0.5 rounded-md bg-slate-900 text-white uppercase tracking-wider">Acceso Operativo</span>
        </div>
        <p class="text-xs text-slate-500 mt-1.5">Control Central y Despacho de Envíos</p>
      </div>
    </header>

    <!-- Banner de Error Dinámico -->
    <div id="error-banner" class="hidden bg-rose-50 border border-rose-200 text-rose-700 rounded-2xl p-3.5 mb-5 text-xs flex items-start gap-2.5 animate-fadeIn">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
      </svg>
      <span id="error-message" class="font-medium leading-relaxed">Credenciales incorrectas</span>
    </div>

    <!-- Formulario de Autenticación -->
    <form id="login-form" class="space-y-4" autocomplete="on">
      
      <!-- Campo: Email o Teléfono -->
      <div class="space-y-1.5">
        <label for="email" class="block text-xs font-semibold text-slate-700">
          Correo Electrónico o Teléfono
        </label>
        <div class="relative">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.206" />
          </svg>
          <input
            type="text"
            id="email"
            name="email"
            required
            placeholder="admin@envias.com"
            class="w-full text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-2xl pl-10 pr-3.5 py-3 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
          />
        </div>
      </div>

      <!-- Campo: Contraseña -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="password" class="block text-xs font-semibold text-slate-700">
            Contraseña
          </label>
        </div>
        <div class="relative">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <input
            type="password"
            id="password"
            name="password"
            required
            placeholder="••••••••"
            class="w-full text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-2xl pl-10 pr-10 py-3 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
          />
          <button
            type="button"
            id="toggle-pwd-btn"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1 cursor-pointer"
            title="Mostrar u ocultar contraseña"
          >
            <svg id="eye-open" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <svg id="eye-closed" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Botón Principal de Inicio de Sesión -->
      <div class="pt-2">
        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-slate-900 hover:bg-black text-white font-semibold text-xs sm:text-sm py-3.5 px-4 rounded-2xl transition-all duration-200 active:scale-[0.98] shadow-lg shadow-slate-900/10 flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Iniciar Sesión</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </div>
    </form>

    <!-- Credenciales Rápidas para Pruebas -->
    <div class="mt-6 pt-5 border-t border-slate-100 space-y-2.5">
      <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider text-center">Credenciales de Acceso</p>
      <div class="grid grid-cols-2 gap-2 text-left">
        <button
          type="button"
          id="btn-fill-admin"
          class="p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200/70 text-[11px] transition-colors cursor-pointer flex items-start gap-2"
        >
          <div class="w-6 h-6 rounded-lg bg-slate-200/80 text-slate-700 flex items-center justify-center shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div class="truncate">
            <span class="font-bold text-slate-800 block">Logística</span>
            <span class="text-slate-500 font-mono block text-[10px] truncate">admin@envias.com</span>
          </div>
        </button>

        <button
          type="button"
          id="btn-fill-chofer"
          class="p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200/70 text-[11px] transition-colors cursor-pointer flex items-start gap-2"
        >
          <div class="w-6 h-6 rounded-lg bg-slate-200/80 text-slate-700 flex items-center justify-center shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
            </svg>
          </div>
          <div class="truncate">
            <span class="font-bold text-slate-800 block">Chofer</span>
            <span class="text-slate-500 font-mono block text-[10px] truncate">carlos@envias.com</span>
          </div>
        </button>
      </div>
    </div>

    <!-- Pie de página -->
    <footer class="mt-6 text-center">
      <p class="text-[11px] text-slate-400">
        Sistema seguro conectado a PostgreSQL en Railway
      </p>
    </footer>
  </main>
</Layout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const errorBanner = document.getElementById('error-banner') as HTMLElement;
  const errorMessage = document.getElementById('error-message') as HTMLElement;

  const togglePwdBtn = document.getElementById('toggle-pwd-btn') as HTMLButtonElement;
  const eyeOpen = document.getElementById('eye-open') as HTMLElement;
  const eyeClosed = document.getElementById('eye-closed') as HTMLElement;

  const btnFillAdmin = document.getElementById('btn-fill-admin') as HTMLButtonElement;
  const btnFillChofer = document.getElementById('btn-fill-chofer') as HTMLButtonElement;

  // Toggle mostrar contraseña
  togglePwdBtn?.addEventListener('click', () => {
    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
      eyeOpen?.classList.add('hidden');
      eyeClosed?.classList.remove('hidden');
    } else {
      passwordInput.type = 'password';
      eyeOpen?.classList.remove('hidden');
      eyeClosed?.classList.add('hidden');
    }
  });

  // Botones de autocompletado para pruebas
  btnFillAdmin?.addEventListener('click', () => {
    emailInput.value = 'admin@envias.com';
    passwordInput.focus();
    errorBanner?.classList.add('hidden');
  });

  btnFillChofer?.addEventListener('click', () => {
    emailInput.value = 'carlos@envias.com';
    passwordInput.focus();
    errorBanner?.classList.add('hidden');
  });

  // Enviar Login
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBanner?.classList.add('hidden');

    const email = emailInput.value.trim();
    const password = passwordInput.value.trim();

    if (!email || !password) {
      showError('Por favor ingresa tu correo y contraseña.');
      return;
    }

    submitBtn.disabled = true;
    const originalBtn = submitBtn.innerHTML;
    submitBtn.innerHTML = `
      <svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span>Verificando...</span>
    `;

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password })
      });

      const data = await res.json();

      if (res.ok && data.ok) {
        // Redirigir según el rol del usuario
        if (data.user?.rol === 'Chofer') {
          window.location.href = '/dashboard';
        } else {
          window.location.href = '/dashboard';
        }
      } else {
        showError(data.error || 'Credenciales inválidas. Verifica tu correo y contraseña.');
      }
    } catch (err) {
      console.error('Error login:', err);
      showError('Error de red al intentar iniciar sesión.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalBtn;
    }
  });

  function showError(msg: string) {
    if (errorMessage) errorMessage.textContent = msg;
    errorBanner?.classList.remove('hidden');
  }
</script>
