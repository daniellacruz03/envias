---
import Layout from '../layouts/Layout.astro';
import { query } from '../lib/db';
import { getCatalogoParaCliente } from '../lib/cobertura';

const { searchParams } = Astro.url;
const rawGuia = searchParams.get('guia');
const guiaId = rawGuia ? rawGuia.trim().toUpperCase() : null;

let guiaData: any = null;
let guiasAsociadas: any[] = [];
let errorNotFound = false;

if (guiaId) {
  try {
    const result = await query(`
      SELECT 
        id_guia, 
        destinatario, 
        telefono_principal, 
        telefono_secundario, 
        ciudad_destino, 
        piezas, 
        pies_cubicos, 
        direccion_referencia, 
        estado, 
        gps_latitud, 
        gps_longitud, 
        gps_confirmado 
      FROM guias 
      WHERE id_guia = $1
    `, [guiaId]);

    if (result.rows.length > 0) {
      guiaData = result.rows[0];

      // Consultar otras guías pendientes del mismo cliente
      if (guiaData.destinatario && guiaData.ciudad_destino) {
        try {
          const asocRes = await query(`
            SELECT id_guia, piezas, pies_cubicos
            FROM guias
            WHERE (
              (LOWER(TRIM(destinatario)) = LOWER(TRIM($1)) AND LOWER(TRIM(ciudad_destino)) = LOWER(TRIM($2)))
              OR (telefono_principal = $3 AND LENGTH($3) >= 7)
            )
            AND id_guia != $4
            AND estado != 'Entregado'
            ORDER BY id_guia ASC
          `, [guiaData.destinatario, guiaData.ciudad_destino, guiaData.telefono_principal || '', guiaId]);
          guiasAsociadas = asocRes.rows || [];
        } catch (asocErr) {
          console.warn('[confirmar.astro Associated Guias Error]:', asocErr);
        }
      }
    } else {
      errorNotFound = true;
    }
  } catch (err) {
    console.error('[confirmar.astro SSR DB Error]:', err);
    errorNotFound = true;
  }
} else {
  errorNotFound = true;
}

const catalogoCobertura = getCatalogoParaCliente();
---
<Layout title={guiaData ? `Confirmar Entrega - Guia #${guiaData.id_guia}` : 'Confirmar Entrega | Envias Logistica'}>

  <style>
    .tab-active {
      background-color: #0f172a !important;
      color: #ffffff !important;
      border-color: #0f172a !important;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
    }
    input[type="time"]::-webkit-calendar-picker-indicator {
      opacity: 0.5;
      cursor: pointer;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeIn { animation: fadeIn 0.3s ease-out forwards; }
  </style>

  <main class="w-full max-w-lg bg-white rounded-3xl shadow-2xl border border-slate-200/80 p-6 sm:p-7 my-auto transition-all duration-300 relative">

    <!-- Encabezado -->
    <header class="flex flex-col items-center text-center gap-2.5 border-b border-slate-100 pb-5 mb-5">
      <div class="flex items-center justify-center">
        <img src="/logo.png" alt="Envias C.A." class="h-9 sm:h-10 w-auto object-contain mix-blend-multiply filter contrast-[1.20] brightness-[0.96]" loading="eager" />
      </div>
      <div>
        <div class="flex items-center justify-center gap-1.5">
          <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-slate-900 text-white uppercase tracking-wider">Confirmacion de Entrega</span>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">Venezuela</span>
        </div>
        <p class="text-xs text-slate-500 mt-1 font-medium">Portal de Autoservicio para Destinatarios</p>
      </div>
    </header>

    {errorNotFound ? (
      <div class="text-center py-8 space-y-4">
        <div class="w-14 h-14 bg-amber-50 border border-amber-200 text-amber-600 rounded-2xl flex items-center justify-center mx-auto shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div class="space-y-1.5">
          <h2 class="text-base font-bold text-slate-900">Guia no encontrada</h2>
          <p class="text-xs text-slate-500 max-w-xs mx-auto leading-relaxed">
            {rawGuia ? `No encontramos ningun registro para la guia #${rawGuia}.` : 'No se especifico un numero de guia valido en el enlace.'}
          </p>
        </div>
        <div class="pt-3">
          <a href="/" class="inline-flex items-center gap-2 bg-slate-900 hover:bg-black text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition-all shadow-sm cursor-pointer">
            <span>Ir al Inicio</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    ) : (
      <div id="confirmation-container">

        {guiasAsociadas && guiasAsociadas.length > 0 && (
          <div class="mb-4 p-3.5 bg-gradient-to-br from-indigo-50 via-slate-50 to-indigo-50 border border-indigo-200/80 rounded-2xl flex items-start gap-3 shadow-2xs animate-fadeIn">
            <div class="w-7 h-7 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-black text-xs shrink-0 mt-0.5 shadow-sm">
              {guiasAsociadas.length + 1}
            </div>
            <div class="space-y-1 text-xs">
              <p class="font-extrabold text-indigo-950 flex items-center gap-1.5">
                <span>¡Tienes {guiasAsociadas.length + 1} paquetes para recibir!</span>
                <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-indigo-200/60 text-indigo-900 uppercase">Mismo Destino</span>
              </p>
              <p class="text-[11px] text-slate-600 font-medium leading-relaxed">
                Esta confirmación de ubicación satelital se aplicará a tu guía principal <strong class="font-mono font-bold text-slate-900">#{guiaData.id_guia}</strong> y a tus otras guías asociadas: {guiasAsociadas.map((g, idx) => (
                  <span>
                    <strong class="font-mono font-bold text-indigo-700">#{g.id_guia}</strong>{idx < guiasAsociadas.length - 1 ? ', ' : ''}
                  </span>
                ))}.
              </p>
            </div>
          </div>
        )}

        <div class="mb-2 px-1">
          <p class="text-xs font-bold text-slate-800">Tu numero de guia es:</p>
        </div>

        <!-- Resumen de la Guia -->
        <section class="bg-slate-50/90 border border-slate-200/70 rounded-2xl p-4 mb-5 space-y-2.5 shadow-2xs">
          <div class="flex items-center justify-between border-b border-slate-200/60 pb-2">
            <div class="flex items-center gap-2">
              <span class="text-xs text-slate-500 font-medium">Guia de Entrega:</span>
              <span class="font-mono font-extrabold text-slate-900 text-sm tracking-wide">#{guiaData.id_guia}</span>
            </div>
            <span class="text-[11px] font-bold bg-white border border-slate-200 px-2.5 py-0.5 rounded-lg text-slate-800 shadow-2xs">
              {guiaData.piezas || 1} {guiaData.piezas === 1 ? 'Pieza' : 'Piezas'}{guiaData.pies_cubicos ? ` • ${Number(guiaData.pies_cubicos).toFixed(2)} ft³` : ''}
            </span>
          </div>
          <div class="grid grid-cols-2 gap-2 text-xs">
            <div>
              <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Destinatario</span>
              <p class="font-bold text-slate-900 truncate mt-0.5" title={guiaData.destinatario}>{guiaData.destinatario}</p>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Ciudad Destino</span>
              <p class="font-bold text-slate-900 truncate mt-0.5 flex items-center gap-1.5" title={guiaData.ciudad_destino}>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>{guiaData.ciudad_destino}</span>
              </p>
            </div>
          </div>
        </section>

        <!-- Tabs de Metodo de Ubicacion -->
        <div class="space-y-3">
          <label class="block text-xs font-bold text-slate-800">
            Selecciona como deseas indicar tu ubicacion: <span class="text-rose-500">*</span>
          </label>

          <!-- 2 columnas -->
          <div class="grid grid-cols-2 gap-1.5 p-1 bg-slate-100 rounded-2xl border border-slate-200/70 text-xs font-semibold">
            <button type="button" id="tab-btn-gps"
              class="tab-active py-2.5 px-3 rounded-xl transition-all flex flex-row items-center justify-center gap-2 cursor-pointer text-[12px]">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
              </svg>
              <span>Ubicacion GPS Actual</span>
            </button>

            <button type="button" id="tab-btn-coords"
              class="py-2.5 px-3 rounded-xl text-slate-600 hover:text-slate-900 transition-all flex flex-row items-center justify-center gap-2 cursor-pointer text-[12px]">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
              <span>Pegar Coordenadas</span>
            </button>
          </div>

          <!-- Panel GPS -->
          <div id="tab-panel-gps" class="space-y-3 mt-3">
            <button type="button" id="btn-get-gps"
              class="w-full bg-slate-900 hover:bg-black active:scale-[0.98] text-white font-semibold text-xs sm:text-sm py-3 px-4 rounded-2xl transition-all duration-200 shadow-md shadow-slate-900/10 flex items-center justify-center gap-2 cursor-pointer">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
              </svg>
              <span id="gps-btn-text">Usar mi ubicacion GPS actual</span>
            </button>
            <p class="text-[11px] text-slate-400 text-center font-medium">
              Tu telefono o navegador te solicitara permiso para acceder a tu posicion satelital.
            </p>
          </div>

          <!-- Panel Pegar Coordenadas -->
          <div id="tab-panel-coords" class="hidden space-y-3 mt-3">
            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <label for="input-coords" class="block text-xs font-semibold text-slate-700">
                  Pega tus coordenadas o enlace de mapa:
                </label>
                <button type="button" id="btn-paste-clipboard"
                  class="text-[11px] font-semibold text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200/80 px-2 py-0.5 rounded-lg flex items-center gap-1 transition-all cursor-pointer">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                  </svg>
                  <span>Pegar</span>
                </button>
              </div>
              <textarea id="input-coords" rows="2"
                placeholder="Ej: 10.0808, -69.3756 o enlace de Google Maps / Plus Code..."
                class="w-full text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-2xl p-3 font-mono text-slate-900 placeholder:text-slate-400 placeholder:font-sans focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all resize-none"
              ></textarea>
            </div>

            <!-- Formatos y ejemplos rápidos -->
            <div class="space-y-1.5">
              <p class="text-[11px] text-slate-500 font-medium">
                Formatos compatibles: Coordenadas (Lat, Lng), enlaces de Google Maps/Waze, o Plus Code (OLC).
              </p>
              <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Ejemplos:</span>
                <button type="button" class="btn-coords-sample text-[10px] font-mono font-bold px-2 py-0.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200 cursor-pointer transition-colors" data-coords="10.0808, -69.3756">
                  10.0808, -69.3756
                </button>
                <button type="button" class="btn-coords-sample text-[10px] font-mono font-bold px-2 py-0.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200 cursor-pointer transition-colors" data-coords="https://www.google.com/maps/place/10.0808,-69.3756/@10.0808,-69.3756,17z">
                  Link Google Maps
                </button>
                <button type="button" class="btn-coords-sample text-[10px] font-mono font-bold px-2 py-0.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200 cursor-pointer transition-colors" data-coords="772G3JJF+8Q">
                  772G3JJF+8Q (OLC)
                </button>
              </div>
            </div>
          </div>

          <!-- Feedback de estado listo -->
          <div id="coords-status-card" class="hidden bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-2xl p-3.5 text-xs animate-fadeIn space-y-1.5 mt-3 transition-all duration-300">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2 font-bold" id="coords-source-row">
                <span id="coords-status-icon" class="shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                </span>
                <span id="coords-source-badge">Ubicacion lista</span>
              </div>
              <span id="cobertura-badge" class="hidden text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-200/70 text-emerald-800 transition-all duration-300">VERDE</span>
            </div>
            <div id="coords-latlng-row" class="hidden flex items-center gap-2 text-[11px] font-mono text-emerald-700 pl-6">
              <span>Lat: <strong id="coords-lat">--</strong></span>
              <span>&bull;</span>
              <span>Lng: <strong id="coords-lng">--</strong></span>
            </div>
            <p id="cobertura-msg" class="hidden text-[11px] leading-snug pl-6 font-medium"></p>
          </div>

          <!-- Feedback de error -->
          <div id="gps-error-card" class="hidden bg-rose-50 border border-rose-200 text-rose-800 rounded-2xl p-3 text-xs animate-fadeIn space-y-1 mt-3">
            <div class="flex items-center gap-2 font-bold text-rose-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-rose-500 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
              </svg>
              <span id="gps-error-title">No se pudo obtener la ubicacion</span>
            </div>
            <p id="gps-error-desc" class="text-[11px] text-rose-600 leading-snug pl-6">
              Por favor intenta de nuevo o pega tus coordenadas.
            </p>
          </div>
        </div>

        <!-- Formulario Final -->
        <form id="gps-form" class="space-y-4 mt-4">

          <!-- Referencias adicionales -->
          <div id="referencias-container" class="space-y-1.5">
            <label for="referencias" class="block text-xs font-bold text-slate-800">
              Puntos de referencia adicionales <span class="text-slate-400 font-normal">(opcional)</span>
            </label>
            <textarea id="referencias" name="referencias" rows="2"
              placeholder="Ej: Frente al centro comercial, casa con porton negro..."
              class="w-full text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-2xl p-3 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all resize-none"
            ></textarea>
          </div>

          <!-- Selector de Hora Disponible -->
          <div class="space-y-2 p-4 bg-slate-50 border border-slate-200/70 rounded-2xl">
            <label for="hora-disponible" class="block text-xs font-bold text-slate-800 flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Hasta que hora estara disponible en esta direccion?
              <span class="text-slate-400 font-normal">(opcional)</span>
            </label>
            <input
              type="time"
              id="hora-disponible"
              name="hora_disponible"
              min="06:00"
              max="22:00"
              class="w-full text-sm bg-white border border-slate-200 rounded-xl p-2.5 pl-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all font-mono"
            />
            <p class="text-[11px] text-slate-400 font-medium leading-snug flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Esto le indica al chofer el tiempo disponible para llegar a tu puerta.
            </p>
          </div>

          <!-- Boton de Confirmacion -->
          <div class="pt-1">
            <button type="submit" id="btn-submit-confirmation" disabled
              class="w-full bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-200 disabled:text-slate-400 disabled:cursor-not-allowed text-white font-bold text-xs sm:text-sm py-3.5 px-4 rounded-2xl transition-all duration-200 active:scale-[0.98] shadow-lg shadow-emerald-600/10 flex items-center justify-center gap-2 cursor-pointer">
              <span>Confirmar Entrega</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </button>
            <p id="submit-hint" class="text-[10px] text-slate-400 text-center mt-2 font-medium">
              Indica tu ubicacion mediante GPS satelital o pegando tus coordenadas para confirmar.
            </p>
          </div>
        </form>

      </div>

      <!-- Pantalla de Exito -->
      <div id="success-screen" class="hidden text-center py-6 space-y-4 animate-fadeIn">
        <div class="w-16 h-16 bg-emerald-100 border-2 border-emerald-500 text-emerald-600 rounded-full flex items-center justify-center mx-auto shadow-lg shadow-emerald-500/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <div class="space-y-1.5">
          <h2 class="text-lg font-extrabold text-slate-900">Ubicacion Confirmada con Exito!</h2>
          <p class="text-xs text-slate-600 max-w-xs mx-auto leading-relaxed">
            Tu informacion de entrega ha sido registrada correctamente. El chofer estara al tanto.
          </p>
        </div>
        <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-4 text-xs space-y-2 max-w-xs mx-auto text-left">
          <div class="flex items-center justify-between text-slate-600 border-b border-slate-200/60 pb-1.5">
            <span>Guia:</span>
            <span class="font-mono font-bold text-slate-900">#{guiaData.id_guia}</span>
          </div>
          <div class="flex items-center justify-between text-slate-600">
            <span>Destinatario:</span>
            <span class="font-bold text-slate-900">{guiaData.destinatario}</span>
          </div>
          <div class="flex items-center justify-between text-slate-600">
            <span>Ciudad:</span>
            <span class="font-bold text-slate-900">{guiaData.ciudad_destino}, Venezuela</span>
          </div>
          <div id="success-hora-row" class="hidden items-center justify-between text-slate-600">
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Disponible hasta:
            </span>
            <span id="success-hora-value" class="font-bold text-slate-900 font-mono"></span>
          </div>
        </div>
        <div class="pt-3">
          <p class="text-[11px] text-slate-400 font-medium">Gracias por confiar en Envias Logistica.</p>
        </div>
      </div>
    )}

    <!-- Pie de pagina -->
    <footer class="mt-6 pt-4 border-t border-slate-100 text-center">
      <p class="text-[11px] text-slate-400 flex items-center justify-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>Envias C.A. - Cobertura Nacional en Venezuela</span>
      </p>
    </footer>
  </main>
</Layout>

<script define:vars={{ guiaData, catalogoCobertura }}>
  if (guiaData) {
    let currentCoords = null;
    let isSubmitting = false;
    let currentActiveTab = 'gps';
    let zonaActual = null;

    // =====================
    // GEOFENCING (Haversine)
    // =====================
    const FACTOR_AMARILLO = 2.5;

    function haversineKm(lat1, lng1, lat2, lng2) {
      const R = 6371;
      const dLat = ((lat2 - lat1) * Math.PI) / 180;
      const dLng = ((lng2 - lng1) * Math.PI) / 180;
      const a = Math.sin(dLat/2)**2 + Math.cos((lat1*Math.PI)/180) * Math.cos((lat2*Math.PI)/180) * Math.sin(dLng/2)**2;
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function validarZona(lat, lng) {
      if (lat < 0.6 || lat > 12.5 || lng < -73.5 || lng > -59.5)
        return { zona: 'ROJO', mensaje: 'Ubicacion fuera de Venezuela. Envias C.A. solo opera a nivel nacional.' };
      const hint = (guiaData.ciudad_destino || '').toLowerCase().trim();
      let ciudades = [...catalogoCobertura];
      if (hint) ciudades.sort((a,b) => (a.nombre.toLowerCase().includes(hint)?-1:0) - (b.nombre.toLowerCase().includes(hint)?-1:0));
      let mejor = null, dist = Infinity;
      for (const c of ciudades) { const d = haversineKm(lat,lng,c.lat,c.lng); if(d<dist){dist=d;mejor=c;} }
      if (!mejor) return { zona: 'ROJO', mensaje: 'No se pudo determinar la zona.' };
      if (dist <= mejor.radio) return { zona: 'VERDE', mensaje: `Cobertura confirmada en ${mejor.nombre} (${mejor.region}).` };
      if (dist <= mejor.radio * FACTOR_AMARILLO) return { zona: 'AMARILLO', mensaje: `Zona especial cerca de ${mejor.nombre}, sujeta a validacion.` };
      return { zona: 'ROJO', mensaje: `Fuera de cobertura. Ciudad mas cercana: ${mejor.nombre} (${Math.round(dist)} km).` };
    }

    function updateCoberturaUI(res) {
      zonaActual = res.zona;
      const badge = document.getElementById('cobertura-badge');
      const msg   = document.getElementById('cobertura-msg');
      const card  = document.getElementById('coords-status-card');
      const icon  = document.getElementById('coords-status-icon');
      const row   = document.getElementById('coords-source-row');
      if (!badge||!msg||!card) return;
      card.classList.remove('bg-emerald-50','border-emerald-200','text-emerald-900','bg-amber-50','border-amber-200','text-amber-900','bg-red-50','border-red-200','text-red-900');
      badge.classList.remove('hidden'); msg.classList.remove('hidden'); msg.textContent = res.mensaje;

      if (res.zona === 'VERDE') {
        card.classList.add('bg-emerald-50','border-emerald-200','text-emerald-900');
        badge.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-200 text-emerald-800 transition-all duration-300'; badge.textContent='COBERTURA OK';
        msg.className='text-[11px] leading-snug pl-6 font-medium text-emerald-700';
        if(icon) icon.innerHTML=`<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>`;
        if(row){row.classList.remove('text-amber-800','text-red-800');row.classList.add('text-emerald-800');}
        enableSubmit('Ubicacion satelital capturada');

      } else if (res.zona === 'AMARILLO') {
        card.classList.add('bg-amber-50','border-amber-200','text-amber-900');
        badge.className='text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-200 text-amber-800 transition-all duration-300'; badge.textContent='ZONA ESPECIAL';
        msg.className='text-[11px] leading-snug pl-6 font-medium text-amber-700';
        if(icon) icon.innerHTML=`<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>`;
        if(row){row.classList.remove('text-emerald-800','text-red-800');row.classList.add('text-amber-800');}
        enableSubmit('Ubicacion capturada (zona especial)');

      } else {
        card.classList.add('bg-red-50','border-red-200','text-red-900');
        badge.className='text-[10px] font-bold px-2 py-0.5 rounded-full bg-red-200 text-red-800 transition-all duration-300'; badge.textContent='SIN COBERTURA';
        msg.className='text-[11px] leading-snug pl-6 font-medium text-red-700';
        if(icon) icon.innerHTML=`<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>`;
        if(row){row.classList.remove('text-emerald-800','text-amber-800');row.classList.add('text-red-800');}
        disableSubmit('Ubicacion fuera de la zona de cobertura.');
      }
    }

    // =====================
    // OLC / PLUS CODE MOTOR
    // =====================
    const OLC_ALPHABET = '23456789CFGHJMPQRVWX';

    function decodeFullOLC(code) {
      const clean = code.toUpperCase().replace('+', '').replace(/\s+/g, '');
      if (clean.length < 8) return null;
      let lat = -90;
      let lng = -180;
      let latVal = 20;
      let lngVal = 20;

      for (let i = 0; i < Math.min(clean.length, 10); i += 2) {
        const latDigit = OLC_ALPHABET.indexOf(clean[i]);
        const lngDigit = OLC_ALPHABET.indexOf(clean[i + 1]);
        if (latDigit === -1 || lngDigit === -1) return null;
        lat += latDigit * latVal;
        lng += lngDigit * lngVal;
        latVal /= 20;
        lngVal /= 20;
      }
      lat += latVal / 2;
      lng += lngVal / 2;
      return { lat, lng };
    }

    function decodeShortOLC(shortCode, refLat = 10.0808, refLng = -69.3756) {
      const clean = shortCode.toUpperCase().replace('+', '').replace(/\s+/g, '');
      let bestCoords = null;
      let minDiff = Infinity;

      for (let c1 of '78') {
        for (let c2 of '67') {
          for (let c3 of OLC_ALPHABET) {
            for (let c4 of OLC_ALPHABET) {
              const full = `${c1}${c2}${c3}${c4}${clean}`;
              const decoded = decodeFullOLC(full);
              if (decoded) {
                const diff = Math.abs(decoded.lat - refLat) + Math.abs(decoded.lng - refLng);
                if (diff < minDiff) {
                  minDiff = diff;
                  bestCoords = decoded;
                }
              }
            }
          }
        }
      }
      return bestCoords;
    }

    // ====================================
    // DECODIFICADOR UNIVERSAL DE COORDENADAS
    // ====================================
    function parseUniversalLocation(input) {
      if (!input || typeof input !== 'string') return null;
      const trimmed = input.trim();
      if (!trimmed) return null;

      // 1. Google Maps URLs / Apple Maps / Waze
      // Ej: /@10.0808,-69.3756,17z o /place/10.0808,-69.3756 o ?q=10.0808,-69.3756 o ll=10.0808,-69.3756
      const urlMatch = trimmed.match(/[@?&/](?:q|query|ll|loc|center|place)?[:=/]*(-?\d{1,2}\.\d{3,})[,/]+(-?\d{2,3}\.\d{3,})/i);
      if (urlMatch) {
        const lat = parseFloat(urlMatch[1]);
        const lng = parseFloat(urlMatch[2]);
        if (!isNaN(lat) && !isNaN(lng)) {
          return { lat, lng, type: 'url' };
        }
      }

      // 2. Grados Minutos Segundos (DMS)
      // Ej: 10°04'50.9"N 69°22'32.2"W o 10 4 50.9 N, 69 22 32.2 W
      const dmsMatch = trimmed.match(/(\d{1,2})[°\s]+(\d{1,2})['\s]+([0-9.]+)?["\s]*([NSns])\s*[,;\s/|]+\s*(\d{1,3})[°\s]+(\d{1,2})['\s]+([0-9.]+)?["\s]*([EWewOo])/i);
      if (dmsMatch) {
        let lat = parseFloat(dmsMatch[1]) + (parseFloat(dmsMatch[2]) || 0)/60 + (parseFloat(dmsMatch[3]) || 0)/3600;
        let lng = parseFloat(dmsMatch[5]) + (parseFloat(dmsMatch[6]) || 0)/60 + (parseFloat(dmsMatch[7]) || 0)/3600;
        if (dmsMatch[4].toUpperCase() === 'S') lat = -lat;
        if (['W', 'O'].includes(dmsMatch[8].toUpperCase())) lng = -lng;
        return { lat, lng, type: 'dms' };
      }

      // 3. Coordenadas Decimales Directas (con o sin letras N/S/E/W/O y °)
      // Ej: "10.0808, -69.3756", "10.0808 -69.3756", "10.0808° N, 69.3756° W", "10.0808 / -69.3756"
      const coordMatch = trimmed.match(/(-?\d{1,2}\.\d{3,})\s*(?:°\s*)?([NSns])?\s*[,;\s/|]+\s*(-?\d{1,3}\.\d{3,})\s*(?:°\s*)?([EWewOo])?/i);
      if (coordMatch) {
        let lat = parseFloat(coordMatch[1]);
        let lng = parseFloat(coordMatch[3]);
        if (coordMatch[2] && coordMatch[2].toUpperCase() === 'S') lat = -Math.abs(lat);
        if (coordMatch[4] && ['W', 'O'].includes(coordMatch[4].toUpperCase())) lng = -Math.abs(lng);
        // Si no tiene signo y lng parece positivo en longitud de Venezuela, invertir a negativo
        if (lng > 50 && lng < 80) lng = -lng;
        return { lat, lng, type: 'decimal' };
      }

      // 4. Código OLC Completo (Plus Code de 8 a 11 chars con +)
      // Ej: 772G3JJF+8Q
      const fullOlcMatch = trimmed.match(/([23456789CFGHJMPQRVWX]{8}\+[23456789CFGHJMPQRVWX]{2,3})/i);
      if (fullOlcMatch) {
        const decoded = decodeFullOLC(fullOlcMatch[1]);
        if (decoded) return { lat: decoded.lat, lng: decoded.lng, type: 'olc_full' };
      }

      // 5. Código OLC Corto (ej: 3M33+54 Barquisimeto)
      const shortOlcMatch = trimmed.match(/([23456789CFGHJMPQRVWX]{4,7}\+[23456789CFGHJMPQRVWX]{2,3})/i);
      if (shortOlcMatch) {
        let refLat = 10.0808;
        let refLng = -69.3756;
        const normalized = trimmed.toLowerCase();
        for (const c of catalogoCobertura) {
          if (normalized.includes(c.nombre.toLowerCase())) {
            refLat = c.lat;
            refLng = c.lng;
            break;
          }
        }
        const decoded = decodeShortOLC(shortOlcMatch[1], refLat, refLng);
        if (decoded) return { lat: decoded.lat, lng: decoded.lng, type: 'olc_short' };
      }

      return null;
    }

    // DOM refs
    const tabBtnGps        = document.getElementById('tab-btn-gps');
    const tabBtnCoords     = document.getElementById('tab-btn-coords');
    const tabPanelGps      = document.getElementById('tab-panel-gps');
    const tabPanelCoords   = document.getElementById('tab-panel-coords');
    const btnGetGps        = document.getElementById('btn-get-gps');
    const gpsBtnText       = document.getElementById('gps-btn-text');
    const inputCoords      = document.getElementById('input-coords');
    const btnPasteClip     = document.getElementById('btn-paste-clipboard');
    const refContainer     = document.getElementById('referencias-container');
    const statusCard       = document.getElementById('coords-status-card');
    const sourceBadge      = document.getElementById('coords-source-badge');
    const latlngRow        = document.getElementById('coords-latlng-row');
    const latEl            = document.getElementById('coords-lat');
    const lngEl            = document.getElementById('coords-lng');
    const errorCard        = document.getElementById('gps-error-card');
    const errorTitle       = document.getElementById('gps-error-title');
    const errorDesc        = document.getElementById('gps-error-desc');
    const refInput         = document.getElementById('referencias');
    const horaInput        = document.getElementById('hora-disponible');
    const btnSubmit        = document.getElementById('btn-submit-confirmation');
    const submitHint       = document.getElementById('submit-hint');
    const gpsForm          = document.getElementById('gps-form');
    const container        = document.getElementById('confirmation-container');
    const successScreen    = document.getElementById('success-screen');

    // =====================
    // TABS
    // =====================
    function switchTab(tab) {
      currentActiveTab = tab;
      [[tabBtnGps, tabPanelGps, 'gps'], [tabBtnCoords, tabPanelCoords, 'coords']].forEach(([btn, panel, id]) => {
        if (id === tab) {
          btn?.classList.add('tab-active');
          btn?.classList.remove('text-slate-600');
          panel?.classList.remove('hidden');
        } else {
          btn?.classList.remove('tab-active');
          btn?.classList.add('text-slate-600');
          panel?.classList.add('hidden');
        }
      });

      if (tab === 'coords') {
        validatePastedCoords();
      } else {
        if (currentCoords) {
          updateCoordsState(currentCoords.latitude, currentCoords.longitude, 'Ubicacion GPS satelital');
        } else {
          disableSubmit();
          statusCard?.classList.add('hidden');
        }
      }
    }

    tabBtnGps?.addEventListener('click', () => switchTab('gps'));
    tabBtnCoords?.addEventListener('click', () => switchTab('coords'));

    // =====================
    // GPS NATIVO
    // =====================
    btnGetGps?.addEventListener('click', () => {
      if (!navigator.geolocation) {
        showError('Geolocalizacion no disponible', 'Tu navegador no soporta GPS.');
        return;
      }
      hideError();
      if (gpsBtnText) gpsBtnText.textContent = 'Obteniendo senal GPS...';
      btnGetGps.disabled = true;
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          updateCoordsState(pos.coords.latitude, pos.coords.longitude, 'Ubicacion GPS satelital');
          if (gpsBtnText) gpsBtnText.textContent = 'Ubicacion GPS Capturada';
          btnGetGps.disabled = false;
        },
        (err) => {
          btnGetGps.disabled = false;
          if (gpsBtnText) gpsBtnText.textContent = 'Reintentar capturar GPS';
          let t = 'Error al obtener ubicacion';
          let d = 'Activa el GPS y concede permisos.';
          if (err.code === err.PERMISSION_DENIED) {
            t = 'Permiso GPS Denegado';
            d = 'Debes otorgar permiso de ubicacion en los ajustes de tu navegador o usar la pestana de Pegar Coordenadas.';
          } else if (err.code === err.TIMEOUT) {
            t = 'Tiempo agotado';
            d = 'No se pudo obtener senal satelital. Intenta de nuevo o pega tus coordenadas.';
          }
          showError(t, d);
        },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
      );
    });

    // =====================
    // PEGAR COORDENADAS
    // =====================
    function validatePastedCoords() {
      const raw = inputCoords?.value?.trim() || '';
      if (!raw) {
        if (currentActiveTab === 'coords') {
          currentCoords = null;
          statusCard?.classList.add('hidden');
          disableSubmit('Pega tus coordenadas o enlace de mapa para continuar.');
        }
        return;
      }

      const parsed = parseUniversalLocation(raw);
      if (parsed) {
        hideError();
        let sourceLabel = 'Coordenadas validadas';
        if (parsed.type === 'url') sourceLabel = 'Enlace de mapa decodificado';
        else if (parsed.type.startsWith('olc')) sourceLabel = 'Plus Code OLC decodificado';
        updateCoordsState(parsed.lat, parsed.lng, sourceLabel);
      } else {
        currentCoords = null;
        statusCard?.classList.add('hidden');
        showError('Formato no reconocido', 'Ingresa coordenadas como "10.0808, -69.3756", un enlace de Google Maps o un Plus Code (OLC).');
        disableSubmit('Formato de coordenadas no valido.');
      }
    }

    inputCoords?.addEventListener('input', validatePastedCoords);
    inputCoords?.addEventListener('paste', () => {
      setTimeout(validatePastedCoords, 60);
    });

    // Botón de pegar portapapeles
    btnPasteClip?.addEventListener('click', async () => {
      try {
        if (navigator.clipboard && navigator.clipboard.readText) {
          const clipText = await navigator.clipboard.readText();
          if (clipText && inputCoords) {
            inputCoords.value = clipText.trim();
            validatePastedCoords();
          }
        } else if (inputCoords) {
          inputCoords.focus();
        }
      } catch (e) {
        if (inputCoords) inputCoords.focus();
      }
    });

    // Botones de ejemplos rápidos
    document.querySelectorAll('.btn-coords-sample').forEach((btn) => {
      btn.addEventListener('click', () => {
        const sample = btn.getAttribute('data-coords');
        if (sample && inputCoords) {
          inputCoords.value = sample;
          validatePastedCoords();
        }
      });
    });

    // =====================
    // UPDATE COORDS STATE
    // =====================
    function updateCoordsState(lat, lng, label) {
      currentCoords = { latitude: lat, longitude: lng };
      if (latEl) latEl.textContent = lat.toFixed(6);
      if (lngEl) lngEl.textContent = lng.toFixed(6);
      if (sourceBadge && label) sourceBadge.textContent = label;
      statusCard?.classList.remove('hidden');
      latlngRow?.classList.remove('hidden');
      hideError();
      updateCoberturaUI(validarZona(lat, lng));
    }

    function enableSubmit(label) {
      if (btnSubmit) {
        btnSubmit.disabled = false;
        btnSubmit.classList.remove('bg-slate-400', 'cursor-not-allowed');
        btnSubmit.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
      }
      if (submitHint) {
        submitHint.textContent = zonaActual === 'AMARILLO'
          ? 'Zona especial: el equipo validara tu entrega. Puedes confirmar.'
          : 'Ubicacion lista. Presiona "Confirmar Entrega" para finalizar.';
        submitHint.classList.remove('text-slate-400', 'text-red-600');
        submitHint.classList.add(zonaActual === 'AMARILLO' ? 'text-amber-600' : 'text-emerald-600', 'font-semibold');
      }
    }

    function disableSubmit(reason) {
      if (btnSubmit) btnSubmit.disabled = true;
      if (submitHint) {
        submitHint.textContent = reason || 'Indica tu ubicacion mediante GPS satelital o pegando tus coordenadas para confirmar.';
        submitHint.classList.remove('text-emerald-600', 'text-amber-600', 'font-semibold');
        submitHint.classList.add(reason ? 'text-red-600' : 'text-slate-400');
      }
    }

    function showError(t, d) {
      if (errorTitle) errorTitle.textContent = t;
      if (errorDesc) errorDesc.textContent = d;
      errorCard?.classList.remove('hidden');
    }

    function hideError() {
      errorCard?.classList.add('hidden');
    }

    // =====================
    // SUBMIT
    // =====================
    gpsForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isSubmitting) return;

      if (!currentCoords) {
        showError('Faltan coordenadas', 'Por favor captura tu posicion GPS o pega tus coordenadas antes de confirmar.');
        return;
      }

      if (zonaActual === 'ROJO') {
        showError('Fuera de cobertura', 'La ubicacion indicada esta fuera de la zona de cobertura de Envias C.A.');
        return;
      }

      const refs = refInput?.value?.trim() || '';
      const hora = horaInput?.value?.trim() || null;

      isSubmitting = true;
      btnSubmit.disabled = true;
      const orig = btnSubmit.innerHTML;
      btnSubmit.innerHTML = `<svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span>Guardando confirmacion...</span>`;

      try {
        const res = await fetch('/api/confirmar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id_guia: guiaData.id_guia,
            latitud: currentCoords.latitude,
            longitud: currentCoords.longitude,
            direccion_referencia: refs || undefined,
            hora_disponible: hora || undefined
          })
        });

        const json = await res.json();
        if (res.ok && json.success) {
          if (hora) {
            const [h, m] = hora.split(':');
            const h12 = new Date(0, 0, 0, +h, +m).toLocaleTimeString('es-VE', { hour: '2-digit', minute: '2-digit', hour12: true });
            const el = document.getElementById('success-hora-value');
            if (el) el.textContent = h12;
            const row = document.getElementById('success-hora-row');
            if (row) {
              row.classList.remove('hidden');
              row.style.display = 'flex';
            }
          }
          container?.classList.add('hidden');
          successScreen?.classList.remove('hidden');
        } else {
          showError('Error al guardar', json.message || 'No se pudo guardar en el servidor.');
          btnSubmit.disabled = false;
          btnSubmit.innerHTML = orig;
          isSubmitting = false;
        }
      } catch (err) {
        showError('Error de conexion', 'Hubo un fallo de conexion. Por favor reintenta.');
        btnSubmit.disabled = false;
        btnSubmit.innerHTML = orig;
        isSubmitting = false;
      }
    });
  }
</script>
