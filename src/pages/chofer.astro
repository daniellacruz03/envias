          <h4 id="lightbox-title" class="font-extrabold text-sm sm:text-base">Comprobante de Entrega</h4>
          <p id="lightbox-info" class="text-xs text-slate-400">Guía</p>
        </div>
        <button id="lightbox-close-btn" type="button" class="p-2 text-white/80 hover:text-white bg-white/10 hover:bg-white/20 rounded-xl transition-colors cursor-pointer">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
