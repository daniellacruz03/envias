              (function() {
                var pCount = stop.comprobante_url.split(',').filter(Boolean).length;
                var pText = pCount > 1 ? ('Ver Comprobantes (' + pCount + ' fotos)') : 'Ver Comprobante de Entrega';
                return '<button type="button" onclick="window.openLightbox(\'' + stop.comprobante_url + '\', \'Parada #' + stopNum + ' - ' + stop.destinatario + '\', \'Guías: ' + stop.guiasLabel + '\', \'' + firstGuiaId + '\')" class="w-full tap-active py-3 px-4 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs flex items-center justify-center gap-2 transition-colors cursor-pointer text-center">' +
                  '<svg class="w-4 h-4 text-slate-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>' +
                  '<span>' + pText + '</span>' +
                '</button>';
              })() :
              '<button type="button" onclick="window.openDeliveryModal(\'' + stop.guiasIds + '\', \'' + destEscaped + '\', \'' + dirEscaped + '\', ' + stopNum + ', \'' + stop.guiasLabel + '\', ' + stop.totalPiezas + ', ' + stop.totalPiesCubicos + ')" class="w-full tap-active py-3 px-4 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center justify-center gap-2 cursor-pointer text-center">' +
                '<span>Actualizar Estado de Entrega</span>' +
              '</button>'
            )) +
          '</div>' +
        '</div>';
      }

      function renderCards() {
        updateStats();
        if (!cardsContainer) return;

        var allStops = buildClientStops(guiasData);
        var filteredStops = getFilteredClientStops();
        var activeStopContainer = document.getElementById('active-stop-card-container');

        // Actualizar Banner de Ciudad Hero de forma inteligente
        var activeCityTitle = document.getElementById('active-city-title');
        var activeCitySubtitle = document.getElementById('active-city-subtitle');

        var cityCounts = {};
        allStops.forEach(function(s) {
          var c = (s.ciudad_destino || '').trim();
          if (c) cityCounts[c] = (cityCounts[c] || 0) + 1;
        });
        var sortedCitiesByCount = Object.keys(cityCounts).sort(function(a, b) { return cityCounts[b] - cityCounts[a]; });

        // Buscar siguiente parada cliente pendiente
        var nextPendingStop = (allStops || []).find(function(s) {
          return s.estado !== 'Entregado' && s.estado !== 'No entregado';
        });

        var mainCity = (nextPendingStop && nextPendingStop.ciudad_destino) 
          ? nextPendingStop.ciudad_destino 
          : (sortedCitiesByCount[0] || 'Venezuela');

        if (activeCityTitle) activeCityTitle.textContent = mainCity.toUpperCase();
        if (activeCitySubtitle) activeCitySubtitle.textContent = 'Ver Clientes (' + mainCity + ')';

        if (activeStopContainer) {
          if (nextPendingStop) {
            var nextStopNum = nextPendingStop.orden_ruta && nextPendingStop.orden_ruta > 0 ? nextPendingStop.orden_ruta : 1;
            var nextStopCity = (nextPendingStop.ciudad_destino || mainCity).toUpperCase();

            activeStopContainer.innerHTML =
              '<div class="space-y-2 animate-fadeIn">' +
                '<div class="flex items-center gap-2.5 pt-1 px-1">' +
                  '<span class="w-8 h-8 rounded-xl bg-slate-950 text-white font-black text-xs flex items-center justify-center shadow-xs">#' + nextStopNum + '</span>' +
                  '<h3 class="text-base sm:text-lg font-black text-slate-900 uppercase tracking-tight">' + nextStopCity + ' – Ruta Local</h3>' +
