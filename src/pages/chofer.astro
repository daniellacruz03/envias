    <!-- Modal Lightbox para ver Comprobante en Grande -->
    <div id="lightbox-modal" class="fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm hidden items-center justify-center p-4 transition-all">
      <div class="relative max-w-lg w-full bg-white rounded-3xl p-5 shadow-2xl space-y-3 animate-fadeIn">
        <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
          <h3 class="text-xs font-bold text-slate-900" id="lightbox-title">Comprobante de Entrega</h3>
          <button id="lightbox-close-btn" class="p-1 text-slate-400 hover:text-slate-700 rounded-lg cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="rounded-2xl overflow-hidden bg-slate-100 border border-slate-200 flex items-center justify-center max-h-[60vh]">
          <img id="lightbox-img" class="w-full h-auto max-h-[60vh] object-contain" alt="Comprobante de Entrega" />
        </div>
        <p class="text-[11px] text-slate-500 text-center" id="lightbox-info"></p>
      </div>
    </div>

    <!-- TOAST NOTIFICATION FLOTANTE -->
    <div id="toast" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 bg-slate-900 text-white px-4 py-2.5 rounded-2xl shadow-xl text-xs font-semibold flex items-center gap-2 hidden transition-all duration-300">
      <span id="toast-icon"></span>
      <span id="toast-message">Mensaje</span>
    </div>

    <!-- ========================================== -->
    <!-- 7. SCRIPT CLIENTE (LEAFLET + REACTIVIDAD)  -->
    <!-- ========================================== -->
    <script define:vars={{ initialGuias, targetChoferId }}>
      let currentChoferId = targetChoferId;
      let guiasData = initialGuias || [];
      let activeTab = 'pendientes'; // 'pendientes' | 'entregados' | 'todos'
      let searchQuery = '';
      let selectedCity = '';
      let activeModalGuiaId = null;

      // Leaflet Map State
      let map = null;
      let markersLayer = null;
      let routePolyline = null;
      let isMapVisible = true;
      let userHasInteractedWithMap = false;

      // Elementos DOM
      const cardsContainer = document.getElementById('cards-container');
      const emptyState = document.getElementById('empty-state');
      const emptyTitle = document.getElementById('empty-title');
      const emptyDesc = document.getElementById('empty-desc');
      const searchInput = document.getElementById('search-input');
      const cityFilter = document.getElementById('city-filter');
      
      const tabPendientes = document.getElementById('tab-pendientes');
      const tabEntregados = document.getElementById('tab-entregados');
      const tabTodos = document.getElementById('tab-todos');
      
      const badgeTabPendientes = document.getElementById('badge-tab-pendientes');
      const badgeTabEntregados = document.getElementById('badge-tab-entregados');
      const badgeTabTodos = document.getElementById('badge-tab-todos');

      const statPendientes = document.getElementById('stat-pendientes');
      const statEntregados = document.getElementById('stat-entregados');
      const statTotal = document.getElementById('stat-total');
      const progressText = document.getElementById('progress-text');
      const progressBarFill = document.getElementById('progress-bar-fill');
      
      const refreshBtn = document.getElementById('refresh-btn');
      const refreshIcon = document.getElementById('refresh-icon');
      const driverSelectSwitch = document.getElementById('driver-select-switch');

      const mapWrapper = document.getElementById('map-wrapper');
      const toggleMapBtn = document.getElementById('toggle-map-btn');
      const toggleMapText = document.getElementById('toggle-map-text');
      const toggleMapIcon = document.getElementById('toggle-map-icon');
      const recenterMapBtn = document.getElementById('recenter-map-btn');
      const routeInfoPill = document.getElementById('route-info-pill');
      const routeDistanceText = document.getElementById('route-distance-text');

      // Modal Elements
      const deliveryModal = document.getElementById('delivery-modal');
      const modalCloseBtn = document.getElementById('modal-close-btn');
      const modalCancelBtn = document.getElementById('modal-cancel-btn');
      const modalConfirmBtn = document.getElementById('modal-confirm-btn');
      const modalGuiaCode = document.getElementById('modal-guia-code');
      const modalDestinatario = document.getElementById('modal-destinatario');
      const modalDireccion = document.getElementById('modal-direccion');
      const modalRecibidoPor = document.getElementById('modal-recibido-por');

      // Photo Upload & Compression Elements
      const dropzonePhoto = document.getElementById('dropzone-photo');
      const modalPhotoInput = document.getElementById('modal-photo-input');
      const photoPlaceholder = document.getElementById('photo-placeholder');
      const photoPreviewContainer = document.getElementById('photo-preview-container');
      const photoPreviewImg = document.getElementById('photo-preview-img');
      const photoSizeBadge = document.getElementById('photo-size-badge');
      const photoStatusText = document.getElementById('photo-status-text');
      const btnRetakePhoto = document.getElementById('btn-retake-photo');

      // Lightbox Elements
      const lightboxModal = document.getElementById('lightbox-modal');
      const lightboxCloseBtn = document.getElementById('lightbox-close-btn');
      const lightboxImg = document.getElementById('lightbox-img');
      const lightboxTitle = document.getElementById('lightbox-title');
      const lightboxInfo = document.getElementById('lightbox-info');

      let currentCompressedFile = null;

      // Toast Element
      const toast = document.getElementById('toast');
      const toastIcon = document.getElementById('toast-icon');
      const toastMessage = document.getElementById('toast-message');

      // 1. Normalización de teléfono para WhatsApp
      function formatPhoneForWhatsApp(phone) {
        if (!phone) return '';
        let cleaned = phone.replace(/[^0-9]/g, '');
        if (cleaned.startsWith('0')) {
          cleaned = '58' + cleaned.substring(1);
        } else if (cleaned.length === 10 && !cleaned.startsWith('58')) {
          cleaned = '58' + cleaned;
        }
        return cleaned;
      }

      // 2. Inicializar Mapa Leaflet
      function initMap() {
        if (typeof L === 'undefined') return;

        // Centro inicial por defecto (Venezuela)
        map = L.map('route-map', {
          zoomControl: false,
          attributionControl: false
        }).setView([7.8500, -66.0000], 6);

        // Tile layer limpio corporativo (CartoDB Positron / OSM)
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
          maxZoom: 19,
          subdomains: 'abcd'
        }).addTo(map);

        // Control de zoom en esquina superior derecha
        L.control.zoom({ position: 'topright' }).addTo(map);

        // Detectar si el chofer interactúa manualmente para no resetear su vista
        map.on('zoomstart', () => { userHasInteractedWithMap = true; });
        map.on('dragstart', () => { userHasInteractedWithMap = true; });

        markersLayer = L.layerGroup().addTo(map);
        updateMapMarkers(true);
      }

      // 3. Actualizar Marcadores y Polilínea en el Mapa
      // Diccionario de Coordenadas de Sedes y Ciudades de Venezuela
      const VENEZUELA_COORDS = {
        'barquisimeto': [10.0808, -69.3756],
        'sede principal barquisimeto': [10.0808, -69.3756],
        'cabudare': [10.0333, -69.2667],
        'carora': [10.1755, -70.0827],
        'el tocuyo': [9.7872, -69.7928],
        'quibor': [9.9286, -69.6201],
        'caracas': [10.4934, -66.9299],
        'sede caracas': [10.4934, -66.9299],
        'chacao': [10.4925, -66.8530],
        'baruta': [10.4344, -66.8744],
        'el hatillo': [10.4267, -66.8258],
        'petare': [10.4789, -66.8094],
        'catia': [10.5186, -66.9442],
        'los teques': [10.3444, -67.0428],
        'guarenas': [10.4681, -66.6172],
        'guatire': [10.4722, -66.5414],
        'merida': [8.5738, -71.1851],
        'sede merida': [8.5738, -71.1851],
        'timotes': [8.9833, -70.7333],
        'apartaderos': [8.8000, -70.8500],
        'paramo': [8.8000, -70.8500],
        'el paramo': [8.8000, -70.8500],
        'mucuchies': [8.7500, -70.9167],
        'santo domingo': [8.8600, -70.6800],
        'tabay': [8.6350, -71.0720],
        'el vigia': [8.6250, -71.6500],
        'ejido': [8.5475, -71.2425],
        'tovar': [8.3375, -71.7583],
        'lagunillas': [8.5147, -71.3911],
        'san cristobal': [7.7669, -72.2250],
        'tariba': [7.8186, -72.2242],
        'rubio': [7.7058, -72.3556],
        'san antonio': [7.8147, -72.4439],
        'la grita': [8.1342, -71.9844],
        'maracaibo': [10.6544, -71.6385],
        'san francisco': [10.5753, -71.6586],
        'cabimas': [10.3986, -71.4428],
        'ciudad ojeda': [10.2036, -71.3117],
        'valencia': [10.1620, -68.0077],
        'naguanagua': [10.2544, -68.0125],
        'san diego': [10.2589, -67.9547],
        'puerto cabello': [10.4731, -68.0125],
        'maracay': [10.2469, -67.5958],
        'turmero': [10.2289, -67.4744],
        'cagua': [10.1864, -67.4594],
        'la victoria': [10.2269, -67.3314],
        'barinas': [8.6226, -70.2075],
        'socopo': [8.2347, -70.7686],
        'valera': [9.3178, -70.6036],
        'trujillo': [9.3664, -70.4356],
        'bocono': [9.2500, -70.2667],
        'acarigua': [9.5545, -69.2006],
        'araure': [9.5603, -69.2147],
        'guanare': [9.0439, -69.7421],
        'san felipe': [10.3397, -68.7425],
        'yaritagua': [10.0811, -69.1239],
        'chivacoa': [10.1606, -68.8953],
        'punto fijo': [11.6956, -70.1996],
        'coro': [11.4045, -69.6734],
        'barcelona': [10.1362, -64.6862],
        'puerto la cruz': [10.2138, -64.6328],
        'lecheria': [10.1919, -64.6908],
        'el tigre': [8.8875, -64.2458],
        'ciudad guayana': [8.3533, -62.6467],
        'puerto ordaz': [8.3533, -62.6467],
        'ciudad bolivar': [8.1292, -63.5408],
        'maturin': [9.7469, -63.1832],
        'cumana': [10.4536, -64.1750],
        'san juan de los morros': [9.9115, -67.3538],
        'calabozo': [8.9242, -67.4294],
        'san fernando de apure': [7.8939, -67.4724],
        'la guaira': [10.6019, -66.9328],
        'maiquetia': [10.6006, -66.9567],
        'porlamar': [10.9577, -63.8697]
      };

      function resolveLocationCoords(locName) {
        if (!locName) return null;
        const clean = locName.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();

        if (clean.includes('barquisimeto')) return VENEZUELA_COORDS['barquisimeto'];
        if (clean.includes('caracas')) return VENEZUELA_COORDS['caracas'];
        if (clean.includes('merida')) return VENEZUELA_COORDS['merida'];
        if (clean.includes('vigia')) return VENEZUELA_COORDS['el vigia'];
        if (clean.includes('valencia')) return VENEZUELA_COORDS['valencia'];
        if (clean.includes('maracaibo')) return VENEZUELA_COORDS['maracaibo'];
        if (clean.includes('san cristobal')) return VENEZUELA_COORDS['san cristobal'];
        if (clean.includes('maracay')) return VENEZUELA_COORDS['maracay'];
        if (clean.includes('barinas')) return VENEZUELA_COORDS['barinas'];
        if (clean.includes('valera')) return VENEZUELA_COORDS['valera'];
        if (clean.includes('trujillo')) return VENEZUELA_COORDS['trujillo'];
        if (clean.includes('acarigua')) return VENEZUELA_COORDS['acarigua'];
        if (clean.includes('guanare')) return VENEZUELA_COORDS['guanare'];
        if (clean.includes('san felipe') || clean.includes('yaritagua')) return VENEZUELA_COORDS['san felipe'];
        if (clean.includes('punto fijo') || clean.includes('coro')) return VENEZUELA_COORDS['coro'];
        if (clean.includes('puerto la cruz') || clean.includes('barcelona') || clean.includes('lecheria')) return VENEZUELA_COORDS['puerto la cruz'];
        if (clean.includes('guayana') || clean.includes('puerto ordaz') || clean.includes('bolivar')) return VENEZUELA_COORDS['ciudad guayana'];
        if (clean.includes('maturin')) return VENEZUELA_COORDS['maturin'];
        if (clean.includes('cumana')) return VENEZUELA_COORDS['cumana'];
        if (clean.includes('san juan de los morros')) return VENEZUELA_COORDS['san juan de los morros'];
        if (clean.includes('apure')) return VENEZUELA_COORDS['san fernando de apure'];
        if (clean.includes('la guaira') || clean.includes('maiquetia')) return VENEZUELA_COORDS['la guaira'];
        if (clean.includes('porlamar') || clean.includes('margarita')) return VENEZUELA_COORDS['porlamar'];

        for (const [key, coords] of Object.entries(VENEZUELA_COORDS)) {
          if (clean.includes(key)) return coords;
        }
        return null;
      }

      // 3. Actualizar Marcadores y Polilínea en el Mapa
      function updateMapMarkers(forceFitBounds = false) {
        if (!map || !markersLayer) return;

        markersLayer.clearLayers();
        if (routePolyline) {
          map.removeLayer(routePolyline);
          routePolyline = null;
        }

        const latLngs = [];

        // 1. Punto de Salida / Origen (ej. Sede Principal Barquisimeto)
        const originName = (guiasData.length > 0 && guiasData[0].ruta_origen) || 'Sede Principal Barquisimeto';
        const originCoords = resolveLocationCoords(originName);

        if (originCoords) {
          latLngs.push(originCoords);

          const startPinHtml = `
            <div class="relative flex items-center justify-center w-8 h-8 rounded-full bg-slate-900 border-2 border-white shadow-xl text-white text-[10px] font-black transition-transform hover:scale-110">
              <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
              <div class="absolute -bottom-4 bg-slate-900 text-white text-[9px] px-1 py-0.2 rounded font-extrabold shadow-sm whitespace-nowrap">SALIDA</div>
            </div>
          `;

          const startIcon = L.divIcon({
            html: startPinHtml,
            className: 'custom-start-icon',
            iconSize: [32, 32],
            iconAnchor: [16, 16],
            popupAnchor: [0, -16]
          });

          const startMarker = L.marker(originCoords, { icon: startIcon });
          startMarker.bindPopup(`
            <div class="space-y-1 min-w-[150px]">
              <span class="text-[10px] font-bold px-1.5 py-0.2 rounded bg-slate-900 text-white">PUNTO DE SALIDA</span>
              <p class="text-xs font-bold text-slate-900">${originName}</p>
            </div>
          `);
          markersLayer.addLayer(startMarker);
        }

        // 2. Paradas de Entrega de los Clientes
        guiasData.forEach((guia, index) => {
          const stopNumber = index + 1;
          const hasCoords = Boolean(guia.gps_confirmado && guia.gps_latitud && guia.gps_longitud);
          
          if (hasCoords) {
            const lat = Number(guia.gps_latitud);
            const lng = Number(guia.gps_longitud);
            const isEntregado = guia.estado === 'Entregado';

            latLngs.push([lat, lng]);

            // Custom HTML Pin estilo Spoke / Amazon Flex
            const markerHtml = `
              <div class="relative flex items-center justify-center w-8 h-8 rounded-full ${
                isEntregado 
                  ? 'bg-emerald-600 border-2 border-white shadow-md text-white' 
                  : 'bg-indigo-600 border-2 border-white shadow-lg text-white'
              } text-xs font-black transition-transform hover:scale-110">
                <span>${stopNumber}</span>
                ${isEntregado ? `
                  <div class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-emerald-500 rounded-full border border-white flex items-center justify-center text-white">
                    <svg class="w-2 h-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                  </div>
                ` : ''}
              </div>
            `;

            const customIcon = L.divIcon({
              html: markerHtml,
              className: 'custom-stop-icon',
              iconSize: [32, 32],
              iconAnchor: [16, 16],
              popupAnchor: [0, -16]
            });

            const marker = L.marker([lat, lng], { icon: customIcon });

            // Popup con acciones rápidas
            const navUrl = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;
            const popupHtml = `
              <div class="space-y-1.5 min-w-[180px]">
                <div class="flex items-center justify-between gap-1 border-b border-slate-100 pb-1">
                  <span class="text-[10px] font-bold px-1.5 py-0.2 rounded bg-indigo-50 text-indigo-700">Parada #${stopNumber}</span>
                  <span class="text-[10px] font-mono font-bold text-slate-500">#${guia.id_guia}</span>
                </div>
                <p class="text-xs font-bold text-slate-900">${guia.destinatario}</p>
                <p class="text-[11px] text-slate-500 leading-snug">${guia.direccion_referencia || guia.ciudad_destino}</p>
                <a href="${navUrl}" target="_blank" class="mt-1 w-full py-1.5 px-2.5 rounded-lg bg-slate-900 text-white text-[11px] font-bold flex items-center justify-center gap-1.5 shadow-xs">
                  <span>Navegar GPS</span>
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
              </div>
            `;

            marker.bindPopup(popupHtml);
            markersLayer.addLayer(marker);
          }
        });

        // 3. Punto de Destino / Retorno (si aplica)
        const destinoName = (guiasData.length > 0 && guiasData[0].ruta_destino) || 'Retorno a Sede Principal Barquisimeto';
        const isUltimaParada = destinoName.toLowerCase().includes('ultima parada') || destinoName.toLowerCase().includes('sin retorno');
        
        if (!isUltimaParada) {
          const destCoords = resolveLocationCoords(destinoName);
          if (destCoords) {
            latLngs.push(destCoords);

            const destPinHtml = `
              <div class="relative flex items-center justify-center w-8 h-8 rounded-full bg-slate-900 border-2 border-white shadow-xl text-white text-[10px] font-black transition-transform hover:scale-110">
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <div class="absolute -bottom-4 bg-emerald-700 text-white text-[9px] px-1 py-0.2 rounded font-extrabold shadow-sm whitespace-nowrap">RETORNO</div>
              </div>
            `;

            const destIcon = L.divIcon({
              html: destPinHtml,
              className: 'custom-dest-icon',
              iconSize: [32, 32],
              iconAnchor: [16, 16],
              popupAnchor: [0, -16]
            });

            const destMarker = L.marker(destCoords, { icon: destIcon });
            destMarker.bindPopup(`
              <div class="space-y-1 min-w-[150px]">
                <span class="text-[10px] font-bold px-1.5 py-0.2 rounded bg-emerald-700 text-white">PUNTO DE RETORNO</span>
                <p class="text-xs font-bold text-slate-900">${destinoName}</p>
              </div>
            `);
            markersLayer.addLayer(destMarker);
          }
        }

        // Verificar si la ruta va de Barquisimeto/Trujillo hacia Mérida para asegurar el paso por el Páramo (Troncal 7)
        const isBqtoMerida = (originName.toLowerCase().includes('barquisimeto') || originName.toLowerCase().includes('lara') || originName.toLowerCase().includes('trujillo') || originName.toLowerCase().includes('valera')) && destinoName.toLowerCase().includes('merida');
        const hasVigiaStop = guiasData.some(g => (g.ciudad_destino || '').toLowerCase().includes('vigia') || (g.direccion_referencia || '').toLowerCase().includes('vigia'));

        let routingLatLngs = [...latLngs];
        if (isBqtoMerida && !hasVigiaStop && routingLatLngs.length >= 2) {
          // Insertar waypoint estratégico del Páramo de Mucuchíes / Apartaderos antes del destino final de Mérida
          const paramoCoords = VENEZUELA_COORDS['apartaderos'] || [8.8000, -70.8500];
          const lastIdx = routingLatLngs.length - 1;
          routingLatLngs.splice(lastIdx, 0, paramoCoords);
        }

        // Trazo de ruta real por carreteras (OSRM Driving Engine)
        if (routingLatLngs.length > 1) {
          const coordinatesQuery = routingLatLngs.map(pt => `${pt[1]},${pt[0]}`).join(';');
          const osrmUrl = `https://router.project-osrm.org/route/v1/driving/${coordinatesQuery}?overview=full&geometries=geojson`;

          if (routeInfoPill && routeDistanceText) {
            routeDistanceText.textContent = 'Calculando ruta por carretera...';
            routeInfoPill.classList.remove('hidden');
          }

          fetch(osrmUrl)
            .then(res => res.json())
            .then(data => {
              if (data && data.code === 'Ok' && data.routes && data.routes.length > 0) {
                const route = data.routes[0];
                const roadCoordinates = route.geometry.coordinates.map(coord => [coord[1], coord[0]]);
                
                if (routePolyline) {
                  map.removeLayer(routePolyline);
                }

                // Línea de ruta real que sigue autopistas y carreteras
                routePolyline = L.polyline(roadCoordinates, {
                  color: '#4f46e5',
                  weight: 5,
                  opacity: 0.9,
                  lineCap: 'round',
                  lineJoin: 'round'
                }).addTo(map);

                // Distancia y tiempo en carretera
                const distanceKm = (route.distance / 1000).toFixed(0);
                const durationMinutes = Math.round(route.duration / 60);
                const durationFormatted = durationMinutes >= 60 
                  ? `${Math.floor(durationMinutes / 60)}h ${durationMinutes % 60}m`
                  : `${durationMinutes} min`;

                if (routeInfoPill && routeDistanceText) {
                  routeDistanceText.textContent = `${distanceKm} km en carretera (Vía El Páramo) • ~${durationFormatted}`;
                  routeInfoPill.innerHTML = `
                    <span class="flex h-2 w-2 relative">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600"></span>
                    </span>
                    <span>${distanceKm} km (Vía El Páramo) • ~${durationFormatted}</span>
                  `;
                  routeInfoPill.classList.remove('hidden');
                }
              } else {
                drawFallbackPolyline(latLngs);
              }
            })
            .catch(err => {
              console.warn('[OSRM Routing Fallback]:', err);
              drawFallbackPolyline(latLngs);
            });
        } else {
          if (routeInfoPill) routeInfoPill.classList.add('hidden');
        }

        // Auto-encuadre de marcadores solo si se solicita o en carga inicial
        if (latLngs.length > 0 && (forceFitBounds || !userHasInteractedWithMap)) {
          map.fitBounds(latLngs, { padding: [40, 40], maxZoom: 15 });
        }
      }

      function drawFallbackPolyline(latLngs) {
        if (routePolyline) map.removeLayer(routePolyline);
        routePolyline = L.polyline(latLngs, {
          color: '#4f46e5',
          weight: 3.5,
          opacity: 0.75,
          dashArray: '6, 8',
          lineCap: 'round',
          lineJoin: 'round'
        }).addTo(map);
        if (routeInfoPill) routeInfoPill.classList.add('hidden');
      }

      // 4. Renderizar Tarjetas de Entrega Secuenciales
      function renderCards() {
        const query = searchQuery.trim().toLowerCase();
        
        let filtered = guiasData.filter((guia, index) => {
          const isEntregado = guia.estado === 'Entregado';
          
          let matchTab = true;
          if (activeTab === 'pendientes') matchTab = !isEntregado;
          else if (activeTab === 'entregados') matchTab = isEntregado;

          if (!matchTab) return false;

          if (selectedCity && guia.ciudad_destino !== selectedCity) return false;
          
          if (query) {
            const id = (guia.id_guia || '').toLowerCase();
            const dest = (guia.destinatario || '').toLowerCase();
            const ciudad = (guia.ciudad_destino || '').toLowerCase();
            const dir = (guia.direccion_referencia || '').toLowerCase();
            return id.includes(query) || dest.includes(query) || ciudad.includes(query) || dir.includes(query);
          }
          return true;
        });

        cardsContainer.innerHTML = '';

        if (filtered.length === 0) {
          emptyState.classList.remove('hidden');
          if (activeTab === 'pendientes') {
            emptyTitle.textContent = '¡Sin paradas pendientes!';
            emptyDesc.textContent = 'Todas las entregas han sido completadas o no hay paquetes en ruta.';
          } else {
            emptyTitle.textContent = 'Sin entregas en este filtro';
            emptyDesc.textContent = 'No se encontraron paradas que coincidan con la búsqueda.';
          }
        } else {
          emptyState.classList.add('hidden');

          filtered.forEach(guia => {
            // Posición real en la lista completa (Parada #X)
            const stopNumber = guiasData.findIndex(g => g.id_guia === guia.id_guia) + 1;
            const isGpsConfirmed = Boolean(guia.gps_confirmado);
            const hasCoordinates = Boolean(isGpsConfirmed && guia.gps_latitud && guia.gps_longitud);
            const lat = guia.gps_latitud;
            const lng = guia.gps_longitud;
            const isEntregado = guia.estado === 'Entregado';
            const portalUrl = `${window.location.origin}/confirmar?guia=${guia.id_guia}`;

            // URL de Navegación
            const navUrl = hasCoordinates 
              ? `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`
              : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent((guia.direccion_referencia || '') + ' ' + (guia.ciudad_destino || ''))}`;

            // URL de WhatsApp
            const waPhone = formatPhoneForWhatsApp(guia.telefono_principal);
            const waMessage = isGpsConfirmed
              ? encodeURIComponent(`Hola *${guia.destinatario}*, le escribe su chofer de *Envías C.A.* Ya tengo su ubicación confirmada y voy en camino con su paquete *#${guia.id_guia}* (${guia.piezas || 1} pieza/s). ¿Se encuentra disponible en su dirección?`)
              : encodeURIComponent(`Hola *${guia.destinatario}*, le escribe su chofer de *Envías C.A.* Para poder coordinar y llevar su paquete *#${guia.id_guia}*, por favor confirme su ubicación y dirección exacta en el siguiente enlace:\n\n${portalUrl}`);
            
            const waUrl = waPhone ? `https://wa.me/${waPhone}?text=${waMessage}` : '#';

            const card = document.createElement('article');
            card.className = `bg-white rounded-2xl border ${isEntregado ? 'border-slate-200/60 opacity-80' : 'border-slate-200/90 hover:border-slate-300'} p-4 shadow-sm space-y-3 transition-all`;

