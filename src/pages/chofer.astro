      // ----------------------------------------------------
      // MOTOR GEOGRÁFICO Y ENRUTADOR LOCAL ULTRA-PRECISO
      // ----------------------------------------------------
      var map = null;
      var markersLayer = null;
      var routePolyline = null;
      var isMapVisible = true;
      var markersByGuiaId = {};

      function normalizeGeoText(text) {
        if (!text) return '';
        return text
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .trim();
      }

      // Validación estricta de coordenadas reales dentro del territorio venezolano
      function getGuiaCoords(item) {
        if (!item) return null;
        var lat = parseFloat(item.gps_latitud);
        var lng = parseFloat(item.gps_longitud);
        if (isNaN(lat) || isNaN(lng) || lat === 0 || lng === 0) return null;

        // Auto-corrección si latitud y longitud vinieran invertidas
        if (lat < 0 && lng > 0) {
          var tmp = lat; lat = lng; lng = tmp;
        }

        // Bounding Box Geográfico Oficial de Venezuela (Lat: 0.5 a 13.5, Lng: -74.0 a -59.0)
        if (lat >= 0.5 && lat <= 13.5 && lng >= -74.0 && lng <= -59.0) {
          return [lat, lng];
        }
        return null;
      }

      function haversineDistance(lat1, lon1, lat2, lon2) {
        var R = 6371;
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLon = (lon2 - lon1) * Math.PI / 180;
        var a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon/2) * Math.sin(dLon/2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      }

      // Consulta de geometría vial real vía OSRM (optimizada y con filtrado de duplicados)
      async function fetchOSRMRouteGeometry(waypoints) {
        if (!waypoints || waypoints.length < 2) return waypoints;
        try {
          // Filtrar puntos repetidos o extremadamente cercanos (< 15 metros) para evitar bucles
          var deduped = [waypoints[0]];
          for (var i = 1; i < waypoints.length; i++) {
            var prev = deduped[deduped.length - 1];
            var cur = waypoints[i];
            if (haversineDistance(prev[0], prev[1], cur[0], cur[1]) > 0.015) {
              deduped.push(cur);
            }
          }
          if (deduped.length < 2) return waypoints;

          var pointsToRequest = deduped.slice(0, 25);
          var url = 'https://router.project-osrm.org/route/v1/driving/' +
            pointsToRequest.map(function(p) { return p[1].toFixed(5) + ',' + p[0].toFixed(5); }).join(';') +
            '?overview=full&geometries=geojson';

          var controller = new AbortController();
          var timeoutId = setTimeout(function() { controller.abort(); }, 4000);
          var res = await fetch(url, { signal: controller.signal });
          clearTimeout(timeoutId);

          if (!res.ok) return waypoints;
          var data = await res.json();
          if (data.code === 'Ok' && data.routes && data.routes[0] && data.routes[0].geometry) {
            return data.routes[0].geometry.coordinates.map(function(c) {
              return [c[1], c[0]];
            });
          }
        } catch (e) {
          console.warn('[OSRM Routing Fallback to Direct Lines]:', e);
        }
        return waypoints;
      }

      // Inicialización segura del mapa Leaflet
      function initMap() {
        try {
          if (typeof L === 'undefined') return;
          var mapContainer = document.getElementById('route-map');
          if (!mapContainer || map) return;

          map = L.map('route-map', { zoomControl: true, attributionControl: false }).setView([10.0808, -69.3756], 12);
          L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
          }).addTo(map);

          markersLayer = L.layerGroup().addTo(map);
          updateMapMarkers();
        } catch (err) {
          console.warn('[Map Init Warning]:', err);
        }
      }

      async function updateMapMarkers() {
        if (!map || !markersLayer || typeof L === 'undefined') return;
        markersLayer.clearLayers();
        markersByGuiaId = {};

        var clientStops = buildClientStops(guiasData);

        // Respetar estrictamente la secuencia oficial del despacho (orden_ruta)
        var sortedStops = clientStops.slice().sort(function(a, b) {
          var ordA = (a.orden_ruta && a.orden_ruta > 0) ? a.orden_ruta : 999999;
          var ordB = (b.orden_ruta && b.orden_ruta > 0) ? b.orden_ruta : 999999;
          if (ordA !== ordB) return ordA - ordB;
          return (a.destinatario || '').localeCompare(b.destinatario || '');
        });

        // Buscar siguiente parada cliente pendiente
        var nextPendingStop = sortedStops.find(function(s) { return s.estado !== 'Entregado' && s.estado !== 'No entregado'; });

        var waypoints = [];
        var stopsWithGpsCount = 0;

        // Marcadores de paradas reales con coordenadas válidas
        sortedStops.forEach(function(stop, idx) {
          var coords = getGuiaCoords(stop);
          if (coords) {
            stopsWithGpsCount++;
            var stopNum = stop.orden_ruta && stop.orden_ruta > 0 ? stop.orden_ruta : (idx + 1);
            var isDelivered = stop.estado === 'Entregado';
            var isIncident = stop.estado === 'No entregado';
            var isNextActive = nextPendingStop && nextPendingStop.key === stop.key;

            var bgColor = isDelivered ? '#059669' : isIncident ? '#e11d48' : isNextActive ? '#4f46e5' : '#0f172a';
            var pulseClass = isNextActive ? 'active-stop-pulse' : '';
            var size = isNextActive ? 32 : 26;

            var iconHtml = '<div class="' + pulseClass + '" style="background:' + bgColor + ';width:' + size + 'px;height:' + size + 'px;border-radius:50%;border:2px solid white;color:white;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;box-shadow:0 2px 6px rgba(0,0,0,0.35);">' +
                stopNum +
              '</div>';
            var icon = L.divIcon({ html: iconHtml, className: '', iconSize: [size, size], iconAnchor: [size/2, size/2] });
            var marker = L.marker(coords, { icon: icon }).addTo(markersLayer);

            var volInfo = stop.totalPiesCubicos > 0 ? (' &bull; ' + Number(stop.totalPiesCubicos).toFixed(2) + ' ft³') : '';
            var guiasBadge = stop.totalGuias > 1 ? ('<span style="background:#eef2ff;color:#4338ca;padding:1px 6px;border-radius:4px;font-size:10px;font-weight:800;border:1px solid #c7d2fe;">' + stop.totalGuias + ' Guías</span>') : '';

            var popupContent = '<div style="font-family:inherit;font-size:12px;min-width:185px;">' +
              '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:3px;">' +
                '<span style="font-weight:900;color:#0f172a;font-size:12px;">Parada #' + stopNum + '</span>' +
                guiasBadge +
              '</div>' +
              '<div style="font-weight:800;color:#4338ca;font-size:12px;">' + stop.destinatario + '</div>' +
              '<div style="font-family:monospace;font-size:10px;color:#64748b;margin-top:1px;font-weight:700;">Guía(s): ' + stop.guiasLabel + '</div>' +
              '<div style="font-size:11px;color:#475569;margin-top:2px;">' + stop.totalPiezas + ' pieza(s)' + volInfo + '</div>' +
              '<div style="font-size:11px;color:#64748b;margin-top:2px;">' + (stop.ciudad_destino || '') + (stop.direccion_referencia ? ' &bull; ' + stop.direccion_referencia : '') + '</div>' +
              '<div style="margin-top:6px;"><span style="background:' + (isDelivered ? '#ecfdf5;color:#065f46;' : isIncident ? '#fff1f2;color:#9f1239;' : isNextActive ? '#eef2ff;color:#4338ca;' : '#f8fafc;color:#334155;') + 'padding:2px 7px;border-radius:6px;font-weight:800;font-size:10px;border:1px solid #cbd5e1;">' + (isDelivered ? 'Entregado' : isIncident ? 'No entregado' : isNextActive ? 'Siguiente Parada' : 'Pendiente') + '</span></div>' +
            '</div>';

            marker.bindPopup(popupContent);
            stop.guias.forEach(function(g) {
              markersByGuiaId[g.id_guia] = { marker: marker, latLng: coords, stopNum: stopNum };
            });
            waypoints.push(coords);
          }
        });

        // Actualizar textos del banner de itinerario
        var routeStartText = document.getElementById('route-start-text');
        var routeEndText = document.getElementById('route-end-text');
        var routeStopsCountText = document.getElementById('route-stops-count-text');
        var firstStopName = sortedStops[0] ? sortedStops[0].destinatario : 'Inicio de Ruta';
        var lastStopName = sortedStops.length > 1 ? sortedStops[sortedStops.length - 1].destinatario : 'Fin de Ruta';

        if (routeStartText) routeStartText.textContent = firstStopName;
        if (routeEndText) routeEndText.textContent = lastStopName;
        if (routeStopsCountText) routeStopsCountText.textContent = sortedStops.length + ' paradas (' + stopsWithGpsCount + ' con GPS)';

        // Trazado de ruta vial limpia (sin manchas gigantes ni loops irreales a otras ciudades)
        if (routePolyline) { map.removeLayer(routePolyline); routePolyline = null; }

        if (waypoints.length > 1) {
          // Polyline inicial nítida
          routePolyline = L.polyline(waypoints, {
            color: '#4f46e5',
            weight: 3.5,
            opacity: 0.85,
            dashArray: '6, 6',
            lineCap: 'round',
            lineJoin: 'round'
          }).addTo(map);

          map.fitBounds(L.latLngBounds(waypoints), { padding: [35, 35], maxZoom: 16 });

          // Trazo vial con OSRM sobre las calles reales
          fetchOSRMRouteGeometry(waypoints).then(function(roadCoords) {
            if (!roadCoords || roadCoords.length < 2 || !map) return;
            if (routePolyline) map.removeLayer(routePolyline);

            routePolyline = L.polyline(roadCoords, {
              color: '#4f46e5',
              weight: 3.5,
              opacity: 0.9,
              lineCap: 'round',
              lineJoin: 'round'
            }).addTo(map);
          });
        } else if (waypoints.length === 1) {
          map.setView(waypoints[0], 15);
        }
      }

      // Centrar y enfocar parada desde tarjeta
      window.focusStopOnMap = function(guiaId) {
        var item = markersByGuiaId[guiaId];
