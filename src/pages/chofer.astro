      const toast = document.getElementById('toast');
      const toastIcon = document.getElementById('toast-icon');
      const toastMessage = document.getElementById('toast-message');

      // 1. Normalización de teléfono para WhatsApp
      function formatPhoneForWhatsApp(phone) {
        if (!phone) return '';
        let cleaned = phone.replace(/[^0-9]/g, '');
        if (cleaned.startsWith('0')) {
          cleaned = '58' + cleaned.substring(1);
        } else if (cleaned.length === 10 && !cleaned.startsWith('58')) {
          cleaned = '58' + cleaned;
        }
        return cleaned;
      }

      // 2. Inicializar Mapa Leaflet de forma segura
      function initMap() {
        try {
          if (typeof L === 'undefined') return;
          const mapEl = document.getElementById('route-map');
          if (!mapEl) return;

          if (map) {
            map.invalidateSize();
            return;
          }

          map = L.map('route-map', {
            zoomControl: false,
            attributionControl: false
          }).setView([7.8500, -66.0000], 6);

          L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
            maxZoom: 19,
            subdomains: 'abcd'
          }).addTo(map);

          L.control.zoom({ position: 'topright' }).addTo(map);

          map.on('zoomstart', () => { userHasInteractedWithMap = true; });
          map.on('dragstart', () => { userHasInteractedWithMap = true; });

          markersLayer = L.layerGroup().addTo(map);
          updateMapMarkers(true);
        } catch (err) {
          console.warn('[Leaflet Init Safe Catch]:', err);
        }
      }

      // 3. Actualizar Marcadores y Polilínea en el Mapa
      const VENEZUELA_COORDS = {
        'barquisimeto': [10.0808, -69.3756],
        'sede principal barquisimeto': [10.0808, -69.3756],
        'cabudare': [10.0333, -69.2667],
        'carora': [10.1755, -70.0827],
        'el tocuyo': [9.7872, -69.7928],
        'quibor': [9.9286, -69.6201],
        'caracas': [10.4934, -66.9299],
        'chacao': [10.4925, -66.8530],
        'baruta': [10.4344, -66.8744],
        'el hatillo': [10.4267, -66.8258],
        'petare': [10.4789, -66.8094],
        'catia': [10.5186, -66.9442],
        'los teques': [10.3444, -67.0428],
        'guarenas': [10.4681, -66.6172],
        'guatire': [10.4722, -66.5414],
        'merida': [8.5738, -71.1851],
        'timotes': [8.9833, -70.7333],
        'apartaderos': [8.8000, -70.8500],
        'paramo': [8.8000, -70.8500],
        'el paramo': [8.8000, -70.8500],
        'mucuchies': [8.7500, -70.9167],
        'santo domingo': [8.8600, -70.6800],
        'tabay': [8.6350, -71.0720],
        'el vigia': [8.6250, -71.6500],
        'ejido': [8.5475, -71.2425],
        'tovar': [8.3375, -71.7583],
        'lagunillas': [8.5147, -71.3911],
        'san cristobal': [7.7669, -72.2250],
        'tariba': [7.8186, -72.2242],
        'rubio': [7.7058, -72.3556],
        'san antonio': [7.8147, -72.4439],
        'la grita': [8.1342, -71.9844],
        'maracaibo': [10.6544, -71.6385],
        'san francisco': [10.5753, -71.6586],
        'cabimas': [10.3986, -71.4428],
        'ciudad ojeda': [10.2036, -71.3117],
        'valencia': [10.1620, -68.0077],
        'naguanagua': [10.2544, -68.0125],
        'san diego': [10.2589, -67.9547],
        'puerto cabello': [10.4731, -68.0125],
        'maracay': [10.2469, -67.5958],
        'turmero': [10.2289, -67.4744],
        'cagua': [10.1864, -67.4594],
        'la victoria': [10.2269, -67.3314],
        'barinas': [8.6226, -70.2075],
        'socopo': [8.2347, -70.7686],
        'valera': [9.3178, -70.6036],
        'trujillo': [9.3664, -70.4356],
        'bocono': [9.2500, -70.2667],
        'acarigua': [9.5545, -69.2006],
        'araure': [9.5603, -69.2147],
        'guanare': [9.0439, -69.7421],
        'san felipe': [10.3397, -68.7425],
        'yaritagua': [10.0811, -69.1239],
        'chivacoa': [10.1606, -68.8953],
        'punto fijo': [11.6956, -70.1996],
        'coro': [11.4045, -69.6734],
        'barcelona': [10.1362, -64.6862],
        'puerto la cruz': [10.2138, -64.6328],
        'lecheria': [10.1919, -64.6908],
        'el tigre': [8.8875, -64.2458],
        'ciudad guayana': [8.3533, -62.6467],
        'puerto ordaz': [8.3533, -62.6467],
        'ciudad bolivar': [8.1292, -63.5408],
        'maturin': [9.7469, -63.1832],
        'cumana': [10.4536, -64.1750],
        'san juan de los morros': [9.9115, -67.3538],
        'calabozo': [8.9242, -67.4294],
        'san fernando de apure': [7.8939, -67.4724],
        'la guaira': [10.6019, -66.9328],
        'maiquetia': [10.6006, -66.9567],
        'porlamar': [10.9577, -63.8697]
      };

      function parseLocationCoords(text) {
        if (!text) return null;
        const normalized = text.toLowerCase().trim();
        const match = normalized.match(/(-?\d{1,2}\.\d{3,})[,\s]+(-?\d{2,3}\.\d{3,})/);
        if (match) {
          return [parseFloat(match[1]), parseFloat(match[2])];
        }
        for (const [key, coords] of Object.entries(VENEZUELA_COORDS)) {
          if (normalized.includes(key)) {
            return coords;
          }
        }
        return null;
      }

      function updateMapMarkers(forceFitBounds = false) {
        if (!map || !markersLayer) return;

        markersLayer.clearLayers();
        const latLngs = [];

        // 1. Origen / Salida (Pin Azul)
        const firstWithRoute = guiasData.find(g => g.ruta_origen);
        const originCoords = firstWithRoute?.ruta_origen ? parseLocationCoords(firstWithRoute.ruta_origen) : [10.0808, -69.3756];

        if (originCoords) {
          const startHtml = `
            <div class="relative flex items-center justify-center w-7 h-7 rounded-full bg-indigo-600 border-2 border-white shadow-md text-white text-[10px] font-black">
              S
            </div>
          `;
          const startIcon = L.divIcon({ html: startHtml, className: 'start-pin', iconSize: [28, 28], iconAnchor: [14, 14] });
          L.marker(originCoords, { icon: startIcon }).addTo(markersLayer)
            .bindPopup(`<b>Punto de Salida:</b><br>${firstWithRoute?.ruta_origen || 'Sede Principal Barquisimeto'}`);
          latLngs.push(originCoords);
        }

        // 2. Paradas de Entrega Numeradas
        guiasData.forEach((guia, idx) => {
          if (guia.gps_confirmado && guia.gps_latitud && guia.gps_longitud) {
            const lat = Number(guia.gps_latitud);
            const lng = Number(guia.gps_longitud);
            const isEntregado = guia.estado === 'Entregado';
            const isNoEntregado = guia.estado === 'No entregado';
            latLngs.push([lat, lng]);

            const stopNum = guia.orden_ruta || (idx + 1);

            let pinBg = 'bg-slate-900 border-emerald-400 text-emerald-300';
            if (isEntregado) pinBg = 'bg-emerald-600 border-white text-white';
            else if (isNoEntregado) pinBg = 'bg-rose-600 border-white text-white';

            const pinHtml = `
              <div class="relative flex items-center justify-center w-7 h-7 rounded-full ${pinBg} border-2 shadow-md text-[10px] font-extrabold cursor-pointer">
                ${isEntregado ? '✓' : (isNoEntregado ? '✕' : stopNum)}
              </div>
            `;
            const icon = L.divIcon({ html: pinHtml, className: 'stop-pin', iconSize: [28, 28], iconAnchor: [14, 14] });

            const marker = L.marker([lat, lng], { icon }).addTo(markersLayer);
            marker.bindPopup(`
              <div class="p-1 space-y-1 text-xs">
                <div class="flex items-center gap-1.5">
                  <span class="font-mono font-bold text-slate-900">#${guia.id_guia}</span>
                  <span class="px-1.5 py-0.2 rounded text-[10px] font-bold ${isEntregado ? 'bg-emerald-100 text-emerald-800' : (isNoEntregado ? 'bg-rose-100 text-rose-800' : 'bg-slate-100 text-slate-700')}">
                    ${isEntregado ? 'Entregado' : (isNoEntregado ? 'No entregado' : `Parada #${stopNum}`)}
                  </span>
                </div>
                <p class="font-bold text-slate-800">${guia.destinatario}</p>
                <p class="text-slate-500 text-[11px]">${guia.direccion_referencia || guia.ciudad_destino}</p>
              </div>
            `);
          }
        });

        // 3. Trazado de Ruta
        if (latLngs.length >= 2) {
          if (routePolyline) map.removeLayer(routePolyline);

          const osrmCoords = latLngs.map(pt => `${pt[1]},${pt[0]}`).join(';');
          const osrmUrl = `https://router.project-osrm.org/route/v1/driving/${osrmCoords}?overview=full&geometries=geojson`;

          fetch(osrmUrl)
            .then(res => res.json())
            .then(data => {
              if (data.code === 'Ok' && data.routes && data.routes.length > 0) {
                const route = data.routes[0];
                const distanceKm = (route.distance / 1000).toFixed(1);
                const durationMinutes = Math.round(route.duration / 60);
                const hours = Math.floor(durationMinutes / 60);
                const mins = durationMinutes % 60;
                const durationFormatted = hours > 0 ? `${hours}h ${mins}m` : `${mins} min`;

                const geojsonCoords = route.geometry.coordinates.map(coord => [coord[1], coord[0]]);
                if (routePolyline) map.removeLayer(routePolyline);
                routePolyline = L.polyline(geojsonCoords, {
                  color: '#4f46e5',
                  weight: 4,
                  opacity: 0.85,
                  lineCap: 'round',
                  lineJoin: 'round'
                }).addTo(map);

                if (routeInfoPill && routeDistanceText) {
                  routeDistanceText.textContent = `${distanceKm} km en carretera • ~${durationFormatted}`;
                  routeInfoPill.innerHTML = `
                    <span class="flex h-2 w-2 relative">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600"></span>
                    </span>
                    <span>${distanceKm} km • ~${durationFormatted}</span>
                  `;
                  routeInfoPill.classList.remove('hidden');
                }
              } else {
                drawFallbackPolyline(latLngs);
              }
            })
            .catch(err => {
              console.warn('[OSRM Routing Fallback]:', err);
              drawFallbackPolyline(latLngs);
            });
        } else {
          if (routeInfoPill) routeInfoPill.classList.add('hidden');
        }

        if (latLngs.length > 0 && (forceFitBounds || !userHasInteractedWithMap)) {
          map.fitBounds(latLngs, { padding: [40, 40], maxZoom: 15 });
        }
      }

      function drawFallbackPolyline(latLngs) {
        if (routePolyline) map.removeLayer(routePolyline);
        routePolyline = L.polyline(latLngs, {
          color: '#4f46e5',
          weight: 3.5,
          opacity: 0.75,
          dashArray: '6, 8',
          lineCap: 'round',
          lineJoin: 'round'
        }).addTo(map);
        if (routeInfoPill) routeInfoPill.classList.add('hidden');
      }

      // 4. Renderizar Tarjetas de Entrega Secuenciales
      function renderCards() {
        const noRoutesContainer = document.getElementById('no-routes-container');
        const activeRoutesContainer = document.getElementById('active-routes-container');

        if (guiasData.length === 0) {
          noRoutesContainer?.classList.remove('hidden');
          activeRoutesContainer?.classList.add('hidden');
          updateStats();
          return;
        } else {
          noRoutesContainer?.classList.add('hidden');
          activeRoutesContainer?.classList.remove('hidden');
        }

        const query = searchQuery.trim().toLowerCase();
        
        let filtered = guiasData.filter((guia) => {
          const isEntregado = guia.estado === 'Entregado';
          const isNoEntregado = guia.estado === 'No entregado';
          
          let matchTab = true;
          if (activeTab === 'pendientes') matchTab = (!isEntregado && !isNoEntregado);
          else if (activeTab === 'entregados') matchTab = isEntregado;
          else if (activeTab === 'no_entregados') matchTab = isNoEntregado;

          if (!matchTab) return false;

          if (selectedCity && guia.ciudad_destino !== selectedCity) return false;
          
          if (query) {
            const id = (guia.id_guia || '').toLowerCase();
            const dest = (guia.destinatario || '').toLowerCase();
            const ciudad = (guia.ciudad_destino || '').toLowerCase();
            const dir = (guia.direccion_referencia || '').toLowerCase();
            return id.includes(query) || dest.includes(query) || ciudad.includes(query) || dir.includes(query);
          }
          return true;
        });

        cardsContainer.innerHTML = '';

        if (filtered.length === 0) {
          emptyState.classList.remove('hidden');
          if (activeTab === 'pendientes') {
            emptyTitle.textContent = '¡Sin paradas pendientes!';
            emptyDesc.textContent = 'Todas las entregas han sido completadas o no hay paquetes en ruta.';
          } else if (activeTab === 'no_entregados') {
            emptyTitle.textContent = '¡Sin incidencias!';
            emptyDesc.textContent = 'No hay entregas reportadas como fallidas o no contestadas.';
          } else {
            emptyTitle.textContent = 'Sin entregas en este filtro';
            emptyDesc.textContent = 'No se encontraron paradas que coincidan con la búsqueda.';
          }
        } else {
          emptyState.classList.add('hidden');

          filtered.forEach(guia => {
            const stopNumber = guiasData.findIndex(g => g.id_guia === guia.id_guia) + 1;
            const isGpsConfirmed = Boolean(guia.gps_confirmado);
            const hasCoordinates = Boolean(isGpsConfirmed && guia.gps_latitud && guia.gps_longitud);
            const lat = guia.gps_latitud;
            const lng = guia.gps_longitud;
            const isEntregado = guia.estado === 'Entregado';
            const isNoEntregado = guia.estado === 'No entregado';
            const portalUrl = `${window.location.origin}/confirmar?guia=${guia.id_guia}`;

            const navUrl = hasCoordinates 
              ? `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`
              : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent((guia.direccion_referencia || '') + ' ' + (guia.ciudad_destino || ''))}`;

            const waPhone = formatPhoneForWhatsApp(guia.telefono_principal);
            const waMessage = isGpsConfirmed
              ? encodeURIComponent(`Hola *${guia.destinatario}*, le escribe su chofer de *Envías C.A.* Ya tengo su ubicación confirmada y voy en camino con su paquete *#${guia.id_guia}* (${guia.piezas || 1} pieza/s). ¿Se encuentra disponible en su dirección?`)
