                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      <div class="space-y-0.5">
                        <p class="text-[10px] uppercase font-bold text-amber-800 tracking-wider">Ubicación pendiente</p>
                        <p class="text-xs text-amber-900 font-medium leading-relaxed">
                          El cliente aún no ha confirmado su ubicación exacta en el portal.
                        </p>
                        ${guia.direccion_referencia ? `
                          <p class="text-[11px] text-slate-600 bg-white/70 px-2 py-0.5 rounded border border-amber-200/50 mt-1">
                            <span class="font-bold text-slate-700">Nota almacén:</span> ${guia.direccion_referencia}
                          </p>
                        ` : ''}
                      </div>
                    </div>
                  </div>
                `}
              </div>

              <!-- BOTONES DE ACCIÓN RÁPIDA (SPARK/SPOKE STYLE) -->
              <div class="space-y-2 pt-1">
                
                ${isGpsConfirmed ? `
                  <!-- Botón 1-Toque: Navegar Satelital -->
                  <a 
                    href="${navUrl}" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="w-full py-3 px-4 rounded-xl bg-slate-900 hover:bg-black active:scale-[0.98] text-white text-xs font-bold flex items-center justify-center gap-2 shadow-sm transition-all cursor-pointer tap-active"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                    </svg>
                    <span>${hasCoordinates ? 'Navegar con GPS Exacto' : 'Navegar a Dirección'}</span>
