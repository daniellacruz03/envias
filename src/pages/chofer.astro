    <div id="lightbox-modal" class="fixed inset-0 z-50 bg-black/95 backdrop-blur-md hidden flex-col items-center justify-between p-4 sm:p-6 animate-fadeIn">
      <div class="w-full max-w-2xl flex items-center justify-between text-white border-b border-white/10 pb-3">
