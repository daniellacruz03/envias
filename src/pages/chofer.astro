    <!-- 6. MODAL DE LISTÍN DE IMPRESIÓN             -->
    <!-- ========================================== -->
    <div id="chofer-listin-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs hidden items-center justify-center p-2 sm:p-4">
      <div class="w-full max-w-3xl bg-white border border-slate-200 rounded-3xl p-4 sm:p-6 shadow-2xl space-y-4 max-h-[92vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <div>
            <h3 class="text-sm sm:text-base font-extrabold text-slate-900">Listín Oficial de Despacho</h3>
            <p class="text-xs text-slate-500">Hoja de ruta para control de carga</p>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" onclick="window.print()" class="px-3 py-2 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-xs">
              <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
              <span>Imprimir</span>
            </button>
