                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      <div>
                        <p class="text-[10px] uppercase font-bold text-emerald-700 tracking-wider">Dirección confirmada por cliente</p>
