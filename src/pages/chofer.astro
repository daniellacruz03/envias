      <span id="toast-icon"></span>
      <span id="toast-message">Mensaje</span>
    </div>

    <!-- ========================================== -->
    <!-- 7. SCRIPT CLIENTE DINÁMICO                 -->
    <!-- ========================================== -->
    <script define:vars={{ initialGuias, targetChoferId }}>
      var guiasData = initialGuias || [];
      var activeTab = 'pendientes';
      var searchQuery = '';
      var selectedCity = '';
      var sessionScannedCount = 0;
      var isUploadingScans = false;

      // Toast UI
      var toastEl = document.getElementById('toast');
      var toastIconEl = document.getElementById('toast-icon');
      var toastMsgEl = document.getElementById('toast-message');
      var toastTimeout = null;

      function showToast(message, type) {
        if (!type) type = 'info';
        if (!toastEl || !toastMsgEl) return;
        if (toastTimeout) clearTimeout(toastTimeout);

        toastMsgEl.textContent = message;
        if (type === 'success') {
          toastEl.className = 'fixed bottom-4 left-1/2 -translate-x-1/2 z-50 bg-emerald-600 text-white px-4 py-2.5 rounded-2xl shadow-xl text-xs font-bold flex items-center gap-2 animate-fadeIn';
          if (toastIconEl) toastIconEl.innerHTML = '<svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>';
        } else if (type === 'error') {
          toastEl.className = 'fixed bottom-4 left-1/2 -translate-x-1/2 z-50 bg-rose-600 text-white px-4 py-2.5 rounded-2xl shadow-xl text-xs font-bold flex items-center gap-2 animate-fadeIn';
          if (toastIconEl) toastIconEl.innerHTML = '<svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>';
        } else {
          toastEl.className = 'fixed bottom-4 left-1/2 -translate-x-1/2 z-50 bg-slate-900 text-white px-4 py-2.5 rounded-2xl shadow-xl text-xs font-bold flex items-center gap-2 animate-fadeIn';
          if (toastIconEl) toastIconEl.innerHTML = '<svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
        }

        toastEl.classList.remove('hidden');
        toastTimeout = setTimeout(function() {
          if (toastEl) toastEl.classList.add('hidden');
        }, 3500);
      }

      function formatPhoneForWhatsApp(phone) {
        if (!phone) return '';
        var cleaned = phone.replace(/[^0-9]/g, '');
        if (cleaned.startsWith('0')) {
          cleaned = '58' + cleaned.substring(1);
        } else if (cleaned.length === 10 && !cleaned.startsWith('58')) {
          cleaned = '58' + cleaned;
        }
        return cleaned;
      }

      // Compresión en Canvas HTML5
      function compressImage(file, maxWidth, maxHeight, quality) {
        if (!maxWidth) maxWidth = 1200;
        if (!maxHeight) maxHeight = 1600;
        if (!quality) quality = 0.75;

        return new Promise(function(resolve) {
          if (!file) {
            resolve({ blob: null, sizeKb: 0 });
            return;
          }

          var timer = setTimeout(function() {
            resolve({ blob: file, sizeKb: Math.round(file.size / 1024) });
          }, 3000);

          var objectUrl = '';
          try {
            objectUrl = URL.createObjectURL(file);
          } catch(e) {
            clearTimeout(timer);
            resolve({ blob: file, sizeKb: Math.round(file.size / 1024) });
            return;
          }

          var img = new Image();
          img.onload = function() {
            clearTimeout(timer);
            try {
              var width = img.naturalWidth || img.width;
              var height = img.naturalHeight || img.height;

              if (width > maxWidth || height > maxHeight) {
                if (width > height) {
                  height = Math.round((height * maxWidth) / width);
                  width = maxWidth;
                } else {
                  width = Math.round((width * maxHeight) / height);
                  height = maxHeight;
                }
              }

              var canvas = document.createElement('canvas');
              canvas.width = width;
              canvas.height = height;
              var ctx = canvas.getContext('2d');
              if (!ctx) {
                URL.revokeObjectURL(objectUrl);
                resolve({ blob: file, sizeKb: Math.round(file.size / 1024) });
                return;
              }
              ctx.drawImage(img, 0, 0, width, height);
              URL.revokeObjectURL(objectUrl);

              canvas.toBlob(function(blob) {
                if (blob) {
                  resolve({ blob: blob, sizeKb: Math.round(blob.size / 1024) });
                } else {
                  resolve({ blob: file, sizeKb: Math.round(file.size / 1024) });
                }
              }, 'image/jpeg', quality);
            } catch (err) {
              URL.revokeObjectURL(objectUrl);
              resolve({ blob: file, sizeKb: Math.round(file.size / 1024) });
            }
          };
          img.onerror = function() {
            clearTimeout(timer);
            URL.revokeObjectURL(objectUrl);
            resolve({ blob: file, sizeKb: Math.round(file.size / 1024) });
          };
          img.src = objectUrl;
        });
      }

      // Agrupador inteligente de paradas por cliente/dirección
      function normalizeClientName(name) {
        if (!name) return '';
        return name
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
      }

      function getClientStopKey(guia) {
        var normName = normalizeClientName(guia.destinatario);
        var normCity = normalizeClientName(guia.ciudad_destino);
        return normName + '|' + normCity;
      }

      function buildClientStops(guiasList) {
        var stopsMap = {};
        var stopsOrder = [];

        (guiasList || []).forEach(function(g) {
          var key = getClientStopKey(g);
          if (!stopsMap[key]) {
            stopsMap[key] = {
              key: key,
              destinatario: g.destinatario || 'Destinatario',
              ciudad_destino: g.ciudad_destino || '',
              telefono_principal: g.telefono_principal || '',
              telefono_secundario: g.telefono_secundario || null,
              recibe_persona: g.recibe_persona || null,
              recibe_telefono: g.recibe_telefono || null,
              direccion_referencia: g.direccion_referencia || '',
              hora_disponible: g.hora_disponible || '',
              gps_latitud: g.gps_latitud || null,
              gps_longitud: g.gps_longitud || null,
              gps_confirmado: g.gps_confirmado === true,
              orden_ruta: g.orden_ruta && g.orden_ruta > 0 ? g.orden_ruta : null,
              guias: [],
              totalPiezas: 0,
              totalPiesCubicos: 0,
              comprobante_url: null,
              comprobante_base64: null,
              recibido_por: null,
              estado: 'Por contactar'
            };
            stopsOrder.push(stopsMap[key]);
          }

          var stop = stopsMap[key];
          stop.guias.push(g);
          stop.totalPiezas += (parseInt(g.piezas, 10) || 1);
          if (g.pies_cubicos) {
            stop.totalPiesCubicos += parseFloat(g.pies_cubicos) || 0;
          }

          if (!stop.recibe_persona && g.recibe_persona) stop.recibe_persona = g.recibe_persona;
          if (!stop.recibe_telefono && g.recibe_telefono) stop.recibe_telefono = g.recibe_telefono;
          if (!stop.gps_latitud && g.gps_latitud) {
            stop.gps_latitud = g.gps_latitud;
            stop.gps_longitud = g.gps_longitud;
            stop.gps_confirmado = g.gps_confirmado === true;
          }
          if (!stop.direccion_referencia && g.direccion_referencia) stop.direccion_referencia = g.direccion_referencia;
          if (!stop.telefono_secundario && g.telefono_secundario) stop.telefono_secundario = g.telefono_secundario;
          if (!stop.ciudad_destino && g.ciudad_destino) stop.ciudad_destino = g.ciudad_destino;
          if (!stop.hora_disponible && g.hora_disponible) stop.hora_disponible = g.hora_disponible;
          if (g.orden_ruta && g.orden_ruta > 0) {
            if (!stop.orden_ruta || g.orden_ruta < stop.orden_ruta) stop.orden_ruta = g.orden_ruta;
          }
          if (g.comprobante_url) stop.comprobante_url = g.comprobante_url;
          if (g.comprobante_base64) stop.comprobante_base64 = g.comprobante_base64;
          if (g.recibido_por) stop.recibido_por = g.recibido_por;
        });

        // Determinar estado consolidado
        stopsOrder.forEach(function(stop) {
          stop.totalGuias = stop.guias.length;
          var allDelivered = stop.guias.length > 0 && stop.guias.every(function(g) { return g.estado === 'Entregado'; });
          var allIncidents = stop.guias.length > 0 && stop.guias.every(function(g) { return g.estado === 'No entregado'; });
          var anyDelivered = stop.guias.some(function(g) { return g.estado === 'Entregado'; });

          if (allDelivered) {
            stop.estado = 'Entregado';
          } else if (allIncidents) {
            stop.estado = 'No entregado';
          } else if (anyDelivered) {
            stop.estado = 'Parcial';
          } else {
            stop.estado = 'En ruta';
          }

          stop.guiasIds = stop.guias.map(function(g) { return g.id_guia; }).join(',');
          stop.guiasLabel = stop.guias.map(function(g) { return '#' + g.id_guia; }).join(', ');
        });

        return stopsOrder;
      }

      function getGuiaCoords(item) {
        if (!item) return null;
        var lat = parseFloat(item.gps_latitud);
        var lng = parseFloat(item.gps_longitud);
        if (isNaN(lat) || isNaN(lng) || lat === 0 || lng === 0) return null;
        if (lat < 0 && lng > 0) { var tmp = lat; lat = lng; lng = tmp; }
        if (lat >= 0.5 && lat <= 13.5 && lng >= -74.0 && lng <= -59.0) {
          return [lat, lng];
        }
        return null;
      }

      // Renderizador de Tarjeta de Parada
      function renderStopCard(stop, stopNum, isActiveStop) {
        var isDelivered = stop.estado === 'Entregado';
        var isIncident = stop.estado === 'No entregado';
        var isPending = !isDelivered && !isIncident;
        var coords = getGuiaCoords(stop);
        var hasGps = !!coords;

        var phoneDirect = (stop.telefono_principal || '').replace(/[^0-9+]/g, '');
        var phoneClean = formatPhoneForWhatsApp(stop.telefono_principal);
        var packageText = stop.totalGuias > 1 ? (stop.totalGuias + ' paquetes (Guías ' + stop.guiasLabel + ')') : ('tu paquete (Guía ' + stop.guiasLabel + ')');
        var msgWhatsApp = encodeURIComponent('Hola ' + stop.destinatario + ', soy tu chofer de Envías C.A. Voy en camino a entregarte ' + packageText + '.');
        var linkWhatsApp = 'https://wa.me/' + phoneClean + '?text=' + msgWhatsApp;

        var gmapsUrl = '';
        if (hasGps) {
          gmapsUrl = 'https://www.google.com/maps/search/?api=1&query=' + coords[0] + ',' + coords[1];
        } else {
          var addrQuery = (stop.direccion_referencia ? stop.direccion_referencia + ', ' : '') + (stop.ciudad_destino || 'Venezuela');
          gmapsUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(addrQuery);
        }

        var badgeStatusHtml = '';
        if (isDelivered) {
          badgeStatusHtml = '<span class="px-3 py-1 rounded-xl bg-emerald-50 text-emerald-800 text-xs font-bold border border-emerald-200">Entregado</span>';
        } else if (isIncident) {
          badgeStatusHtml = '<span class="px-3 py-1 rounded-xl bg-rose-50 text-rose-800 text-xs font-bold border border-rose-200">No entregó</span>';
        } else if (stop.estado === 'Parcial') {
          badgeStatusHtml = '<span class="px-3 py-1 rounded-xl bg-indigo-50 text-indigo-800 text-xs font-bold border border-indigo-200">Entrega Parcial</span>';
        } else {
          badgeStatusHtml = '<span class="px-3 py-1 rounded-xl bg-amber-50 text-amber-900 text-xs font-bold border border-amber-200">Pendiente</span>';
        }

        var destEscaped = (stop.destinatario || '').replace(/'/g, "\\'");
        var dirEscaped = (stop.direccion_referencia || '').replace(/'/g, "\\'");
        var firstGuiaId = stop.guias[0] ? stop.guias[0].id_guia : '';
        var totalVolTag = stop.totalPiesCubicos > 0 ? (' • ' + Number(stop.totalPiesCubicos).toFixed(2) + ' ft³') : '';
        var zonaNombre = stop.ciudad_destino || 'Destino';

        var recibePersonaBox = '';
        if (stop.recibe_persona || stop.recibe_telefono) {
          var recPhoneClean = stop.recibe_telefono ? formatPhoneForWhatsApp(stop.recibe_telefono) : '';
          var recPhoneDirect = (stop.recibe_telefono || '').replace(/[^0-9+]/g, '');
          var recMsgWhatsApp = encodeURIComponent('Hola ' + (stop.recibe_persona || 'estimado(a)') + ', soy el chofer de Envías C.A. Voy en camino a entregarte ' + packageText + ' de parte de ' + stop.destinatario + '.');
          var linkWhatsAppRecibe = 'https://wa.me/' + recPhoneClean + '?text=' + recMsgWhatsApp;

          recibePersonaBox = '<div class="p-3 rounded-2xl bg-amber-50/90 border border-amber-200/90 space-y-2 text-xs shadow-2xs">' +
            '<div class="flex items-center justify-between">' +
              '<div class="flex items-center gap-1.5 font-extrabold text-amber-950">' +
                '<svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>' +
                '<span>Recibe otra persona:</span>' +
              '</div>' +
              '<span class="text-[10px] font-extrabold bg-amber-200 text-amber-900 px-2 py-0.5 rounded-full">Autorizado</span>' +
            '</div>' +
            '<div class="flex items-center justify-between text-xs text-amber-900 flex-wrap gap-1">' +
              '<span class="font-black">' + (stop.recibe_persona || 'Persona autorizada') + '</span>' +
              (stop.recibe_telefono ? ('<span class="font-mono font-bold text-amber-800">' + stop.recibe_telefono + '</span>') : '') +
            '</div>' +
            (stop.recibe_telefono ? (
              '<div class="grid grid-cols-2 gap-2 pt-0.5">' +
                '<a href="tel:' + recPhoneDirect + '" class="tap-active py-2 px-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-extrabold text-xs flex items-center justify-center gap-1.5 text-center shadow-xs transition-colors">' +
                  '<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>' +
                  '<span>Llamar Recibe</span>' +
                '</a>' +
                '<a href="' + linkWhatsAppRecibe + '" target="_blank" class="tap-active py-2 px-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs flex items-center justify-center gap-1.5 text-center shadow-xs transition-colors">' +
                  '<svg class="w-3.5 h-3.5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>' +
                  '<span>WhatsApp Recibe</span>' +
                '</a>' +
              '</div>'
            ) : '') +
          '</div>';
        }

        var cardBorder = isActiveStop 
          ? 'border-2 border-indigo-600 shadow-md ring-4 ring-indigo-500/10' 
          : 'border border-slate-200/90 shadow-sm hover:border-slate-300';

        return '<div class="bg-white rounded-3xl ' + cardBorder + ' p-4 sm:p-5 space-y-3.5 transition-all ' + (isDelivered ? 'opacity-80 bg-slate-50/50' : '') + '">' +
          '<!-- Encabezado de la parada -->' +
          '<div class="flex items-start justify-between gap-2 border-b border-slate-100 pb-3">' +
            '<div class="flex items-start gap-2.5 min-w-0">' +
              '<div class="w-8 h-8 rounded-2xl ' + (isActiveStop ? 'bg-indigo-600' : isDelivered ? 'bg-emerald-600' : isIncident ? 'bg-rose-600' : 'bg-slate-950') + ' text-white flex items-center justify-center font-black text-xs shrink-0 shadow-xs mt-0.5">' +
                '#' + stopNum +
              '</div>' +
              '<div class="min-w-0 space-y-1">' +
                '<div class="flex items-center gap-1.5 flex-wrap">' +
                  '<h4 class="font-extrabold text-sm text-slate-950 uppercase tracking-tight leading-tight">' +
                    stop.destinatario +
                  '</h4>' +
                  '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-slate-900 text-white font-extrabold text-[10px] tracking-wide uppercase">' +
                    '<span>' + zonaNombre + '</span>' +
                  '</span>' +
                '</div>' +
                '<p class="text-[11px] text-slate-500 font-semibold">' +
                  stop.totalPiezas + ' pieza(s) totales' + totalVolTag +
                '</p>' +
              '</div>' +
            '</div>' +
            '<div class="shrink-0">' +
              badgeStatusHtml +
            '</div>' +
          '</div>' +

          '<!-- Detalle de Datos: Guías + Teléfonos + Dirección + Horario / GPS -->' +
          '<div class="space-y-2.5 text-xs">' +
            '<!-- Guías del cliente -->' +
            '<div class="flex flex-wrap gap-1.5">' +
              stop.guias.map(function(g) {
                var gVol = g.pies_cubicos ? ' • ' + Number(g.pies_cubicos).toFixed(2) + ' ft³' : '';
                var isGDeliv = g.estado === 'Entregado';
                return '<span class="inline-flex items-center gap-1 font-mono text-[11px] font-bold px-2.5 py-1 rounded-xl bg-slate-50 text-slate-700 border border-slate-200/80">' +
                  '#' + g.id_guia + ' (' + (g.piezas || 1) + ' pza' + gVol + ')' +
                  (isGDeliv ? ' <span class="text-emerald-600 font-black">✓</span>' : '') +
                '</span>';
              }).join('') +
            '</div>' +

            '<!-- Teléfono(s) de Contacto -->' +
            '<div class="flex items-center gap-1.5 text-slate-800 text-xs">' +
              '<svg class="w-3.5 h-3.5 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>' +
              '<span class="font-bold font-mono text-slate-900">' + (stop.telefono_principal || 'Sin teléfono') + '</span>' +
              (stop.telefono_secundario ? ('<span class="text-slate-400 font-mono">/ ' + stop.telefono_secundario + '</span>') : '') +
            '</div>' +

            recibePersonaBox +

            '<!-- Dirección de Entrega -->' +
            '<div class="flex items-start gap-1.5 text-slate-800 font-medium text-xs leading-relaxed">' +
              '<span class="font-bold text-slate-400 shrink-0">@</span>' +
              '<span>' + (stop.direccion_referencia || 'Ubicación confirmada') + '</span>' +
            '</div>' +

            '<!-- Badges de Especificaciones (Horario, Recibido por, GPS) -->' +
            '<div class="flex flex-wrap items-center gap-1.5 pt-0.5">' +
              (stop.hora_disponible ? '<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-xl bg-indigo-50 text-indigo-700 border border-indigo-100 text-[10px] font-bold"><svg class="w-3 h-3 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>Horario: Hasta las ' + stop.hora_disponible + '</span>' : '') +
              (stop.recibido_por ? '<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 text-[10px] font-bold"><svg class="w-3 h-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Recibido: ' + stop.recibido_por + '</span>' : '') +
              (hasGps ? '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-bold"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>GPS Satelital Listo</span>' : '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-xl bg-slate-100 text-slate-500 border border-slate-200 text-[10px] font-semibold">Sin GPS</span>') +
            '</div>' +
          '</div>' +

          '<!-- Botones de Acción (Llamar, WhatsApp, Navegar GPS, Confirmar) -->' +
          '<div class="space-y-2 pt-1 border-t border-slate-100">' +
            '<div class="grid grid-cols-3 gap-2">' +
              '<!-- 1. Llamar -->' +
              (phoneDirect ?
