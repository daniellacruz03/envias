---
import '../styles/global.css';
import { getUserFromCookies } from '../lib/auth';
import { query } from '../lib/db';

// 1. Verificación de Autenticación en SSR
const currentUser = getUserFromCookies(Astro.cookies);
if (!currentUser) {
  return Astro.redirect('/login');
}

if (currentUser.rol !== 'Chofer') {
  return Astro.redirect('/dashboard');
}

// Encabezados anti-caché
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

const targetChoferId = currentUser.id;
const targetChoferNombre = currentUser.nombre;

// 2. Consulta inicial SSR de guías asignadas
const guiasResult = await query(`
  SELECT 
    g.id_guia,
    g.destinatario,
    g.telefono_principal,
    g.telefono_secundario,
    g.ciudad_destino,
    g.piezas,
    g.direccion_referencia,
    g.hora_disponible,
    g.comprobante_url,
    g.recibido_por,
    g.orden_ruta,
    g.ruta_origen,
    g.ruta_destino,
    g.estado,
    g.gps_latitud,
    g.gps_longitud,
    g.gps_confirmado,
    g.chofer_asignado_id,
    g.created_at,
    u.nombre AS chofer_nombre,
    u.telefono AS chofer_telefono
  FROM guias g
  LEFT JOIN usuarios u ON g.chofer_asignado_id = u.id
  WHERE g.chofer_asignado_id = $1
  ORDER BY 
    CASE WHEN g.orden_ruta IS NOT NULL AND g.orden_ruta > 0 THEN g.orden_ruta ELSE 999999 END ASC,
    g.created_at DESC
`, [targetChoferId]);

const initialGuias = guiasResult.rows;

// Métricas iniciales
const totalInitial = initialGuias.length;
const entregadosInitial = initialGuias.filter(g => g.estado === 'Entregado').length;
const noEntregadosInitial = initialGuias.filter(g => g.estado === 'No entregado').length;
const pendientesInitial = initialGuias.filter(g => g.estado !== 'Entregado' && g.estado !== 'No entregado').length;
const porcentajeInitial = totalInitial > 0 ? Math.round((entregadosInitial / totalInitial) * 100) : 0;

const uniqueCiudades = Array.from(new Set(initialGuias.map(g => g.ciudad_destino).filter(Boolean))).sort();
---

<!doctype html>
<html lang="es" class="h-full bg-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Envías | Hoja de Ruta - {targetChoferNombre}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Leaflet CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>

    <!-- html2pdf.js para Exportación Directa de Listines PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" defer></script>

    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        -webkit-tap-highlight-color: transparent;
      }
      .tap-active:active {
        transform: scale(0.97);
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-fadeIn {
        animation: fadeIn 0.2s ease-out forwards;
      }

      /* Estilos de Impresión (@media print) para el Listín del Chofer */
      @media print {
        body {
          background: white !important;
          color: black !important;
        }
        body * {
          visibility: hidden !important;
        }
        #chofer-listin-print-wrapper, #chofer-listin-print-wrapper * {
          visibility: visible !important;
        }
        #chofer-listin-print-wrapper {
          position: absolute !important;
          left: 0 !important;
          top: 0 !important;
          width: 100% !important;
          margin: 0 !important;
          padding: 4mm 6mm !important;
          background: white !important;
          box-shadow: none !important;
          border: none !important;
          color: black !important;
          z-index: 9999999 !important;
        }
        @page {
          size: letter portrait;
          margin: 6mm 6mm 6mm 6mm;
        }
      }
    </style>
  </head>
  <body class="min-h-full flex flex-col text-slate-800 antialiased selection:bg-slate-900 selection:text-white pb-12">

    <!-- ========================================== -->
    <!-- 1. ENCABEZADO MÓVIL PRINCIPAL               -->
    <!-- ========================================== -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/90 px-4 py-2.5 shadow-2xs">
      <div class="max-w-2xl mx-auto flex items-center justify-between gap-2">
        
        <!-- Logo y Chofer -->
        <div class="flex items-center gap-2.5 min-w-0">
          <img 
            src="/logo.png" 
            alt="Envías C.A." 
            class="h-7 w-auto object-contain mix-blend-multiply shrink-0" 
          />
          <div class="min-w-0">
            <div class="flex items-center gap-1.5">
              <h1 class="text-xs font-extrabold text-slate-900 truncate leading-tight">{targetChoferNombre}</h1>
              <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded-md bg-emerald-50 text-emerald-700 text-[10px] font-bold shrink-0 border border-emerald-200/60">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>En ruta</span>
              </span>
            </div>
            <p class="text-[10px] text-slate-400 font-medium truncate">Hoja de Ruta Digital • Envías</p>
          </div>
        </div>

        <!-- Acciones rápidas -->
        <div class="flex items-center gap-1.5 shrink-0">
          <!-- Botón Imprimir Listín Oficial de Carga -->
          <button
            type="button"
            id="btn-chofer-print-listin"
            onclick="window.openChoferListinModal()"
            class="px-2.5 py-1.5 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-bold transition-all tap-active flex items-center gap-1.5 shadow-sm cursor-pointer"
            title="Ver e imprimir listín de despacho de hoy"
          >
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            <span class="hidden sm:inline">Imprimir Listín</span>
            <span class="sm:hidden">Listín</span>
          </button>

          <!-- Botón Escanear Guías (Abre Modal de Escaneo) -->
          <button
            type="button"
            id="btn-header-scan"
            class="p-2 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200/80 transition-all tap-active cursor-pointer"
            title="Escanear fotos de guías"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </button>

          <!-- Botón Refrescar Ruta -->
          <button 
            type="button"
            id="refresh-btn"
            class="p-2 rounded-xl bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 transition-all tap-active cursor-pointer"
            title="Sincronizar ruta"
          >
            <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </button>

          <!-- Botón Cerrar Sesión -->
          <a
            href="/api/auth/logout"
            class="p-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200/60 transition-colors tap-active"
            title="Cerrar sesión"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
          </a>
        </div>

      </div>
    </header>

    <!-- ========================================== -->
    <!-- 2. CONTENIDO PRINCIPAL                      -->
    <!-- ========================================== -->
    <main class="max-w-2xl mx-auto px-4 pt-3.5 space-y-3.5 w-full">

      <!-- ========================================== -->
      <!-- VISTA A: SIN RUTAS ASIGNADAS (BIENVENIDA)   -->
      <!-- ========================================== -->
      <div id="no-routes-container" class={`bg-white rounded-3xl border border-slate-200/90 p-5 sm:p-7 shadow-sm text-center space-y-5 animate-fadeIn ${totalInitial === 0 ? '' : 'hidden'}`}>
        <!-- Icono -->
        <div class="w-16 h-16 rounded-3xl bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center mx-auto shadow-xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>

        <div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">¡Hola, {targetChoferNombre}!</h2>
          <p class="text-sm font-bold text-slate-800 mt-1">Escanear y Cargar Guías Físicas</p>
          <p class="text-xs text-slate-500 max-w-md mx-auto mt-1.5 leading-relaxed">
            Puedes tomar fotos con tu cámara o seleccionar de tu galería las guías recibidas en el almacén para tu despacho.
          </p>
        </div>

        <!-- Botones de Captura Directa con Input Nativo Superpuesto -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          <div class="relative w-full bg-slate-900 hover:bg-black text-white rounded-2xl p-4 flex flex-col items-center justify-center gap-2.5 shadow-sm transition-all text-center select-none overflow-hidden cursor-pointer">
            <input
              type="file"
              id="hero-camera-input"
              accept="image/*"
              capture="environment"
              class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20"
            />
            <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center text-emerald-400 pointer-events-none">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div class="pointer-events-none">
              <p class="text-xs font-bold">Tomar Foto con Cámara</p>
              <p class="text-[10px] text-slate-300">Disparo 1 a 1</p>
            </div>
          </div>

          <div class="relative w-full bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 rounded-2xl p-4 flex flex-col items-center justify-center gap-2.5 transition-all text-center select-none overflow-hidden cursor-pointer">
            <input
              type="file"
              id="hero-gallery-input"
              accept="image/*"
              multiple
              class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20"
            />
            <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center pointer-events-none">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <div class="pointer-events-none">
              <p class="text-xs font-bold">Elegir de Galería</p>
              <p class="text-[10px] text-slate-500">Seleccionar varias fotos</p>
            </div>
          </div>
        </div>

        <!-- Barra de Progreso y Miniaturas de Subida en Vivo (Hero) -->
        <div id="hero-scan-live-section" class="hidden space-y-3 pt-2 text-left">
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-3.5 space-y-2">
            <div class="flex items-center justify-between text-xs">
              <span id="hero-progress-label" class="font-bold text-slate-800">Comprimiendo y subiendo...</span>
              <span id="hero-progress-count" class="font-mono font-bold text-indigo-600">0 / 0</span>
            </div>
            <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
              <div id="hero-progress-bar" class="bg-indigo-600 h-full rounded-full transition-all duration-200" style="width: 0%"></div>
            </div>
          </div>

          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <p class="text-xs font-bold text-slate-700">Guías cargadas en esta sesión</p>
              <span id="hero-gallery-count" class="text-[11px] font-bold text-indigo-600"></span>
            </div>
            <div id="hero-gallery-grid" class="grid grid-cols-4 sm:grid-cols-6 gap-2"></div>
          </div>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- VISTA B: CON RUTAS ASIGNADAS (MAPA, CARDS) -->
      <!-- ========================================== -->
      <div id="active-routes-container" class={`space-y-3.5 ${totalInitial > 0 ? '' : 'hidden'}`}>

        <!-- Tarjeta de Progreso de Ruta -->
        <section class="bg-white rounded-2xl border border-slate-200/80 p-3.5 shadow-sm">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded-lg bg-slate-900 text-white flex items-center justify-center text-[10px] font-bold">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                </svg>
              </div>
              <span class="text-xs font-bold uppercase tracking-wider text-slate-800">Progreso de la Ruta</span>
            </div>
            <span class="text-xs font-extrabold text-slate-900" id="progress-text">
              {entregadosInitial} de {totalInitial} paradas ({porcentajeInitial}%)
            </span>
          </div>

          <!-- Barra de Progreso -->
          <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden mb-2.5 border border-slate-200/60">
            <div 
              id="progress-bar-fill"
              class="bg-gradient-to-r from-slate-900 to-emerald-600 h-full rounded-full transition-all duration-500 ease-out"
              style={`width: ${porcentajeInitial}%`}
            ></div>
          </div>

          <!-- Badges de Conteo -->
          <div class="grid grid-cols-4 gap-1 text-center text-[11px] pt-1.5 border-t border-slate-100 text-slate-600">
            <div class="p-1 rounded-lg bg-amber-50/80 border border-amber-200/60">
              <span class="block text-[10px] text-amber-700 font-bold uppercase">Pendientes</span>
              <b class="text-amber-900 text-xs" id="stat-pendientes">{pendientesInitial}</b>
            </div>
            <div class="p-1 rounded-lg bg-emerald-50/80 border border-emerald-200/60">
              <span class="block text-[10px] text-emerald-700 font-bold uppercase">Entregadas</span>
              <b class="text-emerald-900 text-xs" id="stat-entregados">{entregadosInitial}</b>
            </div>
            <div class="p-1 rounded-lg bg-rose-50/80 border border-rose-200/60">
              <span class="block text-[10px] text-rose-700 font-bold uppercase">No entregó</span>
              <b class="text-rose-900 text-xs" id="stat-no-entregados">{noEntregadosInitial}</b>
            </div>
            <div class="p-1 rounded-lg bg-slate-100 border border-slate-200/60">
              <span class="block text-[10px] text-slate-500 font-bold uppercase">Total</span>
              <b class="text-slate-900 text-xs" id="stat-total">{totalInitial}</b>
            </div>
          </div>

          <!-- Banner de Itinerario Spoke -->
          <div id="route-itinerary-banner" class="mt-2 bg-slate-900 text-white rounded-xl p-3 shadow-sm space-y-1.5 border border-slate-800">
            <div class="flex items-center justify-between text-xs">
              <span class="text-[10px] uppercase tracking-wider font-extrabold text-indigo-400 flex items-center gap-1">
                <svg class="w-3 h-3 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
                <span>Itinerario Despachado</span>
              </span>
              <span class="text-[10px] font-mono font-bold text-slate-300" id="route-stops-count-text">{totalInitial} paradas</span>
            </div>
            <div class="flex items-center gap-2 text-xs font-semibold">
              <div class="flex items-center gap-1 text-slate-200 truncate flex-1">
                <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 shrink-0"></span>
                <span id="route-start-text" class="truncate font-bold">Sede Principal Barquisimeto</span>
              </div>
              <svg class="w-3.5 h-3.5 text-slate-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              <div class="flex items-center gap-1 text-slate-200 truncate flex-1 justify-end">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
                <span id="route-end-text" class="truncate font-bold">Retorno a Sede Principal Barquisimeto</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Mapa Interactivo de Paradas -->
        <section class="space-y-2">
          <div class="flex items-center justify-between px-1">
            <div class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">Mapa de Paradas GPS</h2>
            </div>
            
            <button 
              type="button"
              id="toggle-map-btn" 
              class="text-[11px] font-semibold text-indigo-600 hover:text-indigo-800 flex items-center gap-1 cursor-pointer"
            >
              <span id="toggle-map-text">Ocultar Mapa</span>
              <svg id="toggle-map-icon" xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
              </svg>
            </button>
          </div>

          <div id="map-wrapper" class="relative rounded-2xl overflow-hidden border border-slate-200/90 shadow-sm bg-slate-100 transition-all duration-300">
            <div id="route-map" class="h-64 sm:h-80 w-full z-10"></div>
            
            <button 
              type="button"
              id="recenter-map-btn"
              class="absolute bottom-3 right-3 z-20 p-2.5 rounded-xl bg-white/95 text-slate-800 border border-slate-200 shadow-md hover:bg-white transition-all tap-active cursor-pointer"
              title="Ajustar vista"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
              </svg>
            </button>
          </div>
        </section>

        <!-- Filtros y Pestañas -->
        <section class="space-y-2 pt-1">
          <div class="flex items-center gap-2">
            <div class="relative flex-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input 
                type="text" 
                id="search-input"
                placeholder="Buscar por guía, cliente o dirección..."
                class="w-full bg-white border border-slate-200 rounded-xl pl-9 pr-3 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 shadow-2xs transition-all"
              />
            </div>

            {uniqueCiudades.length > 1 && (
              <select 
                id="city-filter"
                class="bg-white border border-slate-200 rounded-xl px-2.5 py-2 text-xs text-slate-700 font-semibold focus:outline-none focus:ring-2 focus:ring-slate-900/10 cursor-pointer shadow-2xs shrink-0"
              >
                <option value="">Todas las ciudades</option>
                {uniqueCiudades.map(city => (
                  <option value={city}>{city}</option>
                ))}
              </select>
            )}
          </div>

          <!-- Tabs Segmentadas -->
          <div class="grid grid-cols-4 p-1 bg-slate-200/70 rounded-xl border border-slate-200/80 text-xs gap-0.5">
            <button 
              type="button"
              id="tab-pendientes"
              class="py-2 text-[11px] font-bold rounded-lg transition-all flex items-center justify-center gap-1 bg-white text-slate-900 shadow-xs cursor-pointer"
            >
              <span>Pendientes</span>
              <span class="px-1.5 py-0.2 rounded-full bg-slate-900 text-white text-[9px]" id="badge-tab-pendientes">
                {pendientesInitial}
              </span>
            </button>

            <button 
              type="button"
              id="tab-entregados"
              class="py-2 text-[11px] font-semibold rounded-lg transition-all flex items-center justify-center gap-1 text-slate-600 hover:text-slate-900 cursor-pointer"
            >
              <span>Entregados</span>
              <span class="px-1.5 py-0.2 rounded-full bg-slate-300 text-slate-700 text-[9px]" id="badge-tab-entregados">
                {entregadosInitial}
              </span>
            </button>

            <button 
              type="button"
              id="tab-no-entregados"
              class="py-2 text-[11px] font-semibold rounded-lg transition-all flex items-center justify-center gap-1 text-slate-600 hover:text-slate-900 cursor-pointer"
            >
              <span>No entregó</span>
              <span class="px-1.5 py-0.2 rounded-full bg-rose-200 text-rose-800 text-[9px]" id="badge-tab-no-entregados">
                {noEntregadosInitial}
              </span>
            </button>

            <button 
              type="button"
              id="tab-todos"
              class="py-2 text-[11px] font-semibold rounded-lg transition-all flex items-center justify-center gap-1 text-slate-600 hover:text-slate-900 cursor-pointer"
            >
              <span>Todos</span>
              <span class="px-1.5 py-0.2 rounded-full bg-slate-300 text-slate-700 text-[9px]" id="badge-tab-todos">
                {totalInitial}
              </span>
            </button>
          </div>
        </section>

        <!-- Lista de Tarjetas de Paradas -->
        <section id="cards-container" class="space-y-3">
          <!-- Se llena dinámicamente por JavaScript -->
        </section>

        <!-- Estado Vacío en Filtros -->
        <div id="empty-state" class="hidden bg-white rounded-2xl border border-slate-200/80 p-8 text-center my-6 shadow-sm animate-fadeIn">
          <div class="w-12 h-12 rounded-2xl bg-slate-100 border border-slate-200 text-slate-700 flex items-center justify-center mx-auto mb-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900 mb-1" id="empty-title">¡Sin paradas en este filtro!</h3>
          <p class="text-xs text-slate-500 max-w-xs mx-auto leading-relaxed" id="empty-desc">
            No hay entregas que coincidan con la búsqueda o el estado seleccionado.
          </p>
        </div>

      </div>

    </main>

    <!-- ========================================== -->
    <!-- 3. MODAL DE ESCANEO (ACCESIBLE DESDE HEADER) -->
    <!-- ========================================== -->
    <div id="scan-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs hidden items-end sm:items-center justify-center p-0 sm:p-4">
      <div class="w-full sm:max-w-md bg-white border border-slate-200 rounded-t-3xl sm:rounded-3xl p-5 shadow-2xl space-y-4 animate-fadeIn">
        
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <div class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-indigo-50 border border-indigo-200 flex items-center justify-center text-indigo-600">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900">Escanear Guías Físicas</h3>
              <p class="text-[11px] text-slate-500 font-medium">Carga fotos para enviar a Logística</p>
            </div>
          </div>
          <button id="scan-modal-close-btn" type="button" class="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-xl transition-colors cursor-pointer">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <div class="grid grid-cols-2 gap-2.5">
          <div class="relative w-full bg-slate-900 hover:bg-black text-white rounded-2xl p-3.5 flex flex-col items-center justify-center gap-2 shadow-sm transition-all text-center select-none overflow-hidden cursor-pointer">
            <input
              type="file"
              id="modal-scan-camera-input"
              accept="image/*"
              capture="environment"
              class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20"
            />
            <div class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center text-emerald-400 pointer-events-none">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div class="pointer-events-none">
              <p class="text-xs font-bold">Usar Cámara</p>
              <p class="text-[9px] text-slate-300">Foto directa</p>
            </div>
          </div>

          <div class="relative w-full bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 rounded-2xl p-3.5 flex flex-col items-center justify-center gap-2 transition-all text-center select-none overflow-hidden cursor-pointer">
            <input
              type="file"
              id="modal-scan-gallery-input"
              accept="image/*"
              multiple
              class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20"
            />
            <div class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center pointer-events-none">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <div class="pointer-events-none">
              <p class="text-xs font-bold">Galería</p>
              <p class="text-[9px] text-slate-500">Múltiples fotos</p>
            </div>
          </div>
        </div>

        <!-- Progreso y Galería del Modal -->
        <div id="modal-scan-live-section" class="hidden space-y-3 pt-1 text-left">
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-3 space-y-2">
            <div class="flex items-center justify-between text-xs">
              <span id="modal-progress-label" class="font-bold text-slate-800">Subiendo guías...</span>
              <span id="modal-progress-count" class="font-mono font-bold text-indigo-600">0 / 0</span>
            </div>
            <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
              <div id="modal-progress-bar" class="bg-indigo-600 h-full rounded-full transition-all duration-200" style="width: 0%"></div>
            </div>
          </div>

          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <p class="text-xs font-bold text-slate-700">Fotos cargadas</p>
              <span id="modal-gallery-count" class="text-[11px] font-bold text-indigo-600"></span>
            </div>
            <div id="modal-gallery-grid" class="grid grid-cols-4 gap-2"></div>
          </div>
        </div>

      </div>
    </div>

    <!-- ========================================== -->
    <!-- 4. MODAL DE CONFIRMACIÓN DE ENTREGA         -->
    <!-- ========================================== -->
    <div id="delivery-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs hidden items-end sm:items-center justify-center p-0 sm:p-4">
      <div class="w-full sm:max-w-md bg-white border border-slate-200 rounded-t-3xl sm:rounded-3xl p-5 sm:p-6 shadow-2xl space-y-4 animate-fadeIn max-h-[92vh] overflow-y-auto">
        
        <!-- Header -->
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <div class="flex items-center gap-2.5">
            <div id="modal-header-icon-container" class="w-9 h-9 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600">
              <svg id="modal-header-icon-success" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <svg id="modal-header-icon-incident" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-rose-600 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900" id="modal-title-text">Confirmar Entrega Realizada</h3>
              <p class="text-[11px] text-slate-500 font-medium" id="modal-guia-code">Parada #--- • Guía #---</p>
            </div>
          </div>
          <button id="modal-close-btn" type="button" class="p-1.5 text-slate-400 hover:text-slate-600 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <!-- Selector de Modo -->
        <div class="grid grid-cols-2 p-1 bg-slate-100 rounded-2xl gap-1 border border-slate-200/60">
          <button
            type="button"
            id="modal-tab-success-btn"
            class="py-2 px-2 text-xs font-bold rounded-xl transition-all flex items-center justify-center gap-1.5 bg-white text-slate-900 shadow-xs cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Entrega Exitosa</span>
          </button>

          <button
            type="button"
            id="modal-tab-incident-btn"
            class="py-2 px-2 text-xs font-semibold rounded-xl transition-all flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 text-rose-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
            <span>No se pudo entregar</span>
          </button>
        </div>

        <!-- Info Destinatario -->
        <div class="bg-slate-50 rounded-2xl p-3 border border-slate-200/80 space-y-0.5 text-xs">
          <p class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Destinatario</p>
          <p class="font-bold text-slate-900 text-sm" id="modal-destinatario">---</p>
          <p class="text-slate-500 text-xs" id="modal-direccion">---</p>
        </div>

        <!-- PANEL A: ENTREGA EXITOSA -->
        <div id="modal-panel-success" class="space-y-3.5">
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label class="block text-xs font-bold text-slate-800 flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>Foto Comprobante <span class="text-rose-500">* (Obligatorio)</span></span>
              </label>
              <span id="photo-size-badge" class="hidden text-[10px] font-mono bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-bold">Optimizado</span>
            </div>

            <!-- Zona de Carga de Foto de Comprobante con Input Superpuesto -->
            <div id="dropzone-delivery-photo" class="relative border-2 border-dashed border-slate-300 hover:border-slate-400 rounded-2xl p-3 text-center cursor-pointer transition-all bg-slate-50 hover:bg-slate-100/70 block overflow-hidden">
              <input
                type="file"
                id="modal-delivery-photo-input"
                accept="image/*"
                capture="environment"
                class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20"
              />
              <div id="photo-placeholder" class="py-2 space-y-1 pointer-events-none">
                <div class="w-9 h-9 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mx-auto mb-1 shadow-2xs">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <p class="text-xs font-bold text-slate-800">Tomar foto o subir comprobante</p>
                <p class="text-[10px] text-slate-400">Toca aquí para abrir la cámara</p>
              </div>

              <div id="photo-preview-container" class="hidden space-y-2 pointer-events-none">
                <img id="photo-preview-img" class="w-full max-h-36 object-contain rounded-xl border border-slate-200 bg-white" alt="Comprobante" />
                <div class="flex items-center justify-between px-1 text-[11px]">
                  <span class="text-emerald-700 font-bold flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                    <span id="photo-status-text">Comprobante optimizado</span>
                  </span>
                  <span class="text-rose-600 font-bold underline text-xs">Cambiar foto</span>
                </div>
              </div>
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="modal-recibido-por" class="block text-xs font-semibold text-slate-700">
              ¿Quién recibió el paquete? <span class="text-slate-400 font-normal">(Opcional)</span>
            </label>
            <input 
              type="text" 
              id="modal-recibido-por" 
              placeholder="Ej: Titular / Vigilancia / Familiar (C.I. 12.345.678)"
              class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900"
            />
          </div>
        </div>

        <!-- PANEL B: INCIDENCIA -->
        <div id="modal-panel-incident" class="hidden space-y-3">
          <div class="bg-rose-50/60 border border-rose-200 rounded-2xl p-3 space-y-2 text-xs">
            <label class="block text-xs font-bold text-rose-900 flex items-center gap-1.5">
              <svg class="w-4 h-4 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              <span>Selecciona el motivo:</span>
            </label>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5" id="incident-reasons-grid">
              <button type="button" data-reason="Dirección incorrecta / Incompleta" class="incident-opt p-2 rounded-xl border border-slate-200 bg-white text-slate-700 text-left font-semibold text-[11px] hover:border-rose-300 hover:bg-rose-50/50 transition-all cursor-pointer">
                Dirección incorrecta / Incompleta
              </button>
              <button type="button" data-reason="Cliente no atiende llamadas" class="incident-opt p-2 rounded-xl border border-slate-200 bg-white text-slate-700 text-left font-semibold text-[11px] hover:border-rose-300 hover:bg-rose-50/50 transition-all cursor-pointer">
                Cliente no atiende llamadas
              </button>
              <button type="button" data-reason="Cliente ausente en domicilio" class="incident-opt p-2 rounded-xl border border-slate-200 bg-white text-slate-700 text-left font-semibold text-[11px] hover:border-rose-300 hover:bg-rose-50/50 transition-all cursor-pointer">
                Cliente ausente en domicilio
              </button>
              <button type="button" data-reason="Paquete rechazado por cliente" class="incident-opt p-2 rounded-xl border border-slate-200 bg-white text-slate-700 text-left font-semibold text-[11px] hover:border-rose-300 hover:bg-rose-50/50 transition-all cursor-pointer">
                Paquete rechazado por cliente
              </button>
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="modal-incident-note" class="block text-xs font-semibold text-slate-700">
              Observación detallada <span class="text-rose-500">*</span>
            </label>
            <textarea 
              id="modal-incident-note" 
              rows="2" 
              placeholder="Explica qué sucedió para que Logística tome acciones..."
              class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500/10 focus:border-rose-500"
            ></textarea>
          </div>
        </div>

        <!-- Botones de Acción -->
        <div class="flex items-center gap-2 pt-2 border-t border-slate-100">
          <button 
            type="button" 
            id="modal-cancel-btn" 
            class="flex-1 py-3 px-4 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-all cursor-pointer text-center"
          >
            Cancelar
          </button>
          
          <button 
            type="button" 
            id="modal-confirm-btn" 
            disabled
            class="flex-1 py-3 px-4 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-bold shadow-md hover:shadow-lg transition-all cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Confirmar Entrega</span>
          </button>

          <button 
            type="button" 
            id="modal-incident-submit-btn" 
            class="hidden flex-1 py-3 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold shadow-md transition-all cursor-pointer flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <span>Guardar Incidencia</span>
          </button>
        </div>

      </div>
    </div>

    <!-- ========================================== -->
