                      <span class="text-xs font-extrabold text-slate-900 font-mono">#${guia.id_guia}</span>
                      <span class="text-[10px] font-bold px-2 py-0.5 rounded-md ${
                        isEntregado 
                          ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' 
                          : 'bg-indigo-50 text-indigo-700 border border-indigo-200'
                      }">
                        ${isEntregado ? 'Entregado' : `Parada #${guia.orden_ruta || stopNumber}`}
                      </span>
                    </div>
                    <p class="text-[11px] text-slate-500 font-medium">${guia.piezas || 1} pieza(s) &bull; ${guia.ciudad_destino || 'Sin ciudad'}</p>
