                ` : `
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200/80 shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Esperando Ubicación
                  </span>
                `}
              </div>

              <!-- Destinatario & Ubicación -->
              <div class="space-y-1.5 text-xs">
                <div>
                  <p class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Destinatario</p>
                  <p class="text-sm font-bold text-slate-900">${guia.destinatario}</p>
                </div>

                ${isGpsConfirmed ? `
                  <div class="bg-emerald-50/40 rounded-xl p-3 border border-emerald-200/70 space-y-1">
                    <div class="flex items-start gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
