      // 5. Actualizar KPIs y Contadores
      function updateStats() {
        const total = guiasData.length;
        const noEntregados = guiasData.filter(g => g.estado === 'No entregado').length;
        const entregados = guiasData.filter(g => g.estado === 'Entregado').length;
        const pendientes = guiasData.filter(g => g.estado !== 'Entregado' && g.estado !== 'No entregado').length;
        const porcentaje = total > 0 ? Math.round((entregados / total) * 100) : 0;

        if (statPendientes) statPendientes.textContent = pendientes;
        if (statEntregados) statEntregados.textContent = entregados;
        if (statNoEntregados) statNoEntregados.textContent = noEntregados;
        if (statTotal) statTotal.textContent = total;
        
        if (badgeTabPendientes) badgeTabPendientes.textContent = pendientes;
        if (badgeTabEntregados) badgeTabEntregados.textContent = entregados;
        if (badgeTabNoEntregados) badgeTabNoEntregados.textContent = noEntregados;
        if (badgeTabTodos) badgeTabTodos.textContent = total;
        
        if (progressText) progressText.textContent = `${entregados} de ${total} paradas (${porcentaje}%)`;
        if (progressBarFill) progressBarFill.style.width = `${porcentaje}%`;

        const activeWithRoute = guiasData.find(g => g.ruta_origen || g.ruta_destino);
        const routeStartText = document.getElementById('route-start-text');
        const routeEndText = document.getElementById('route-end-text');
        const routeStopsCountText = document.getElementById('route-stops-count-text');
        if (routeStartText && activeWithRoute?.ruta_origen) {
          routeStartText.textContent = activeWithRoute.ruta_origen;
        }
        if (routeEndText && activeWithRoute?.ruta_destino) {
          routeEndText.textContent = activeWithRoute.ruta_destino;
        }
        if (routeStopsCountText) {
          routeStopsCountText.textContent = `${total} paradas programadas`;
        }
      }

      // ==========================================
      // OPTIMIZACIÓN Y COMPRESIÓN DE FOTO EN CANVAS
      // ==========================================
      function compressImage(file, maxWidth = 1280, maxHeight = 1280, quality = 0.75) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = (e) => {
            const img = new Image();
            img.onload = () => {
              let width = img.width;
              let height = img.height;

              if (width > height) {
                if (width > maxWidth) {
                  height = Math.round((height * maxWidth) / width);
                  width = maxWidth;
                }
              } else {
                if (height > maxHeight) {
                  width = Math.round((width * maxHeight) / height);
                  height = maxHeight;
                }
              }

              const canvas = document.createElement('canvas');
              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext('2d');
              ctx.drawImage(img, 0, 0, width, height);

              canvas.toBlob((blob) => {
                if (blob) {
                  const optimizedFile = new File([blob], file.name.replace(/\.[^/.]+$/, ".jpg"), {
                    type: 'image/jpeg',
                    lastModified: Date.now()
                  });
                  resolve({
                    file: optimizedFile,
                    dataUrl: canvas.toDataURL('image/jpeg', quality),
                    sizeKb: Math.round(blob.size / 1024)
                  });
                } else {
                  reject(new Error('No se pudo comprimir la imagen.'));
                }
              }, 'image/jpeg', quality);
            };
            img.onerror = reject;
            img.src = e.target.result;
          };
          reader.onerror = reject;
          reader.readAsDataURL(file);
        });
      }

      // Eventos de Dropzone de Foto
      dropzonePhoto?.addEventListener('click', (e) => {
        if (e.target !== btnRetakePhoto) {
          modalPhotoInput.click();
        }
      });

      btnRetakePhoto?.addEventListener('click', (e) => {
        e.stopPropagation();
        modalPhotoInput.value = '';
        modalPhotoInput.click();
      });

      modalPhotoInput?.addEventListener('change', async (e) => {
        const file = e.target.files?.[0];
        if (!file) return;

        photoPlaceholder.classList.add('hidden');
        photoPreviewContainer.classList.remove('hidden');
        photoStatusText.textContent = 'Optimizando foto...';
        modalConfirmBtn.disabled = true;

        try {
          const result = await compressImage(file);
          currentCompressedFile = result.file;
          photoPreviewImg.src = result.dataUrl;
          photoStatusText.textContent = `Foto lista (${result.sizeKb} KB optimizada)`;
          
          photoSizeBadge.textContent = `${result.sizeKb} KB`;
          photoSizeBadge.classList.remove('hidden');

          modalConfirmBtn.disabled = false;
        } catch (err) {
          console.error('Error al optimizar imagen:', err);
          showToast('Error al procesar la imagen seleccionada', 'error');
          resetPhotoState();
        }
      });

      function resetPhotoState() {
        currentCompressedFile = null;
        if (modalPhotoInput) modalPhotoInput.value = '';
        if (photoPreviewImg) photoPreviewImg.src = '';
        photoPlaceholder?.classList.remove('hidden');
        photoPreviewContainer?.classList.add('hidden');
        photoSizeBadge?.classList.add('hidden');
        if (modalConfirmBtn) modalConfirmBtn.disabled = true;
      }

      // Modal Mode Management (Success vs Incident)
      function setModalMode(mode) {
        modalDeliveryMode = mode;
        if (mode === 'success') {
          if (modalTabSuccessBtn) modalTabSuccessBtn.className = 'py-2 px-2 text-xs font-bold rounded-xl transition-all flex items-center justify-center gap-1.5 bg-white text-slate-900 shadow-xs cursor-pointer';
          if (modalTabIncidentBtn) modalTabIncidentBtn.className = 'py-2 px-2 text-xs font-semibold rounded-xl transition-all flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900 cursor-pointer';
          modalPanelSuccess?.classList.remove('hidden');
          modalPanelIncident?.classList.add('hidden');
          modalConfirmBtn?.classList.remove('hidden');
          modalIncidentSubmitBtn?.classList.add('hidden');
          if (modalTitleText) modalTitleText.textContent = 'Confirmar Entrega Realizada';
          modalHeaderIconSuccess?.classList.remove('hidden');
          modalHeaderIconIncident?.classList.add('hidden');
          if (modalHeaderIconContainer) modalHeaderIconContainer.className = 'w-9 h-9 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600 transition-colors';
        } else {
          if (modalTabIncidentBtn) modalTabIncidentBtn.className = 'py-2 px-2 text-xs font-bold rounded-xl transition-all flex items-center justify-center gap-1.5 bg-white text-rose-900 shadow-xs cursor-pointer';
          if (modalTabSuccessBtn) modalTabSuccessBtn.className = 'py-2 px-2 text-xs font-semibold rounded-xl transition-all flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900 cursor-pointer';
          modalPanelSuccess?.classList.add('hidden');
          modalPanelIncident?.classList.remove('hidden');
          modalConfirmBtn?.classList.add('hidden');
          modalIncidentSubmitBtn?.classList.remove('hidden');
          if (modalTitleText) modalTitleText.textContent = 'Reportar No Entregado';
          modalHeaderIconSuccess?.classList.add('hidden');
          modalHeaderIconIncident?.classList.remove('hidden');
          if (modalHeaderIconContainer) modalHeaderIconContainer.className = 'w-9 h-9 rounded-xl bg-rose-50 border border-rose-200 flex items-center justify-center text-rose-600 transition-colors';
        }
      }

      modalTabSuccessBtn?.addEventListener('click', () => setModalMode('success'));
      modalTabIncidentBtn?.addEventListener('click', () => setModalMode('incident'));

      // 6. Modal de Entrega (Bottom Sheet)
      window.openDeliveryModal = function(idGuia, destinatario, direccion, stopNumber) {
        activeModalGuiaId = idGuia;
        if (modalGuiaCode) modalGuiaCode.textContent = `Parada #${stopNumber} • Guía #${idGuia}`;
        if (modalDestinatario) modalDestinatario.textContent = destinatario;
        if (modalDireccion) modalDireccion.textContent = direccion || 'Ubicación confirmada';
        if (modalRecibidoPor) modalRecibidoPor.value = '';
        if (modalIncidentNote) modalIncidentNote.value = '';
        setModalMode('success');
        resetPhotoState();
        deliveryModal.classList.remove('hidden');
        deliveryModal.classList.add('flex');
      };

      function closeModal() {
        deliveryModal.classList.add('hidden');
        deliveryModal.classList.remove('flex');
        activeModalGuiaId = null;
        resetPhotoState();
      }

      modalCloseBtn?.addEventListener('click', closeModal);
      modalCancelBtn?.addEventListener('click', closeModal);

      // Lightbox para ver fotos
      window.openLightbox = function(imgUrl, title, info) {
        lightboxImg.src = imgUrl;
        lightboxTitle.textContent = title || 'Comprobante de Entrega';
        lightboxInfo.textContent = info || '';
        lightboxModal.classList.remove('hidden');
        lightboxModal.classList.add('flex');
      };

      lightboxCloseBtn?.addEventListener('click', () => {
        lightboxModal.classList.add('hidden');
        lightboxModal.classList.remove('flex');
        lightboxImg.src = '';
      });

      lightboxModal?.addEventListener('click', (e) => {
        if (e.target === lightboxModal) {
          lightboxModal.classList.add('hidden');
          lightboxModal.classList.remove('flex');
          lightboxImg.src = '';
        }
      });

      // Confirmar Entrega Exitosa
      modalConfirmBtn?.addEventListener('click', async () => {
        if (!activeModalGuiaId) return;

        if (!currentCompressedFile) {
          showToast('Debes tomar o subir una foto del comprobante sin excepción', 'error');
          return;
        }

        modalConfirmBtn.disabled = true;
        const originalBtnHtml = modalConfirmBtn.innerHTML;
        modalConfirmBtn.innerHTML = `
          <svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Guardando entrega y foto...</span>
        `;

        try {
          const formData = new FormData();
          formData.append('id_guia', activeModalGuiaId);
          formData.append('tipo_resultado', 'entregado');
          formData.append('recibido_por', modalRecibidoPor?.value?.trim() || '');
          formData.append('foto', currentCompressedFile);

          const res = await fetch('/api/chofer/entregar', {
            method: 'POST',
            body: formData
          });

          const data = await res.json();

          if (res.ok && data.success) {
            const index = guiasData.findIndex(g => g.id_guia === activeModalGuiaId);
            if (index !== -1) {
              guiasData[index].estado = 'Entregado';
              guiasData[index].comprobante_url = data.data.comprobante_url;
              guiasData[index].recibido_por = data.data.recibido_por;
            }
            closeModal();
            renderCards();
            updateMapMarkers();
            showToast('¡Entrega confirmada y comprobante guardado!', 'success');
          } else {
            showToast(data.message || 'Error al registrar entrega', 'error');
            modalConfirmBtn.disabled = false;
            modalConfirmBtn.innerHTML = originalBtnHtml;
          }
        } catch (err) {
          console.error('Error entregando:', err);
          showToast('Error de conexión al registrar entrega', 'error');
          modalConfirmBtn.disabled = false;
          modalConfirmBtn.innerHTML = originalBtnHtml;
        }
      });

      // Confirmar Reporte de Incidencia / No Entregado
      modalIncidentSubmitBtn?.addEventListener('click', async () => {
        if (!activeModalGuiaId) return;

        const selectedRadio = document.querySelector('input[name="incident-reason"]:checked');
        const reason = selectedRadio ? selectedRadio.value : 'No contesta llamadas / Teléfono apagado';
        const note = modalIncidentNote?.value?.trim() || '';

        modalIncidentSubmitBtn.disabled = true;
        const originalBtnHtml = modalIncidentSubmitBtn.innerHTML;
        modalIncidentSubmitBtn.innerHTML = `
          <svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Guardando reporte...</span>
        `;

        try {
          const formData = new FormData();
          formData.append('id_guia', activeModalGuiaId);
          formData.append('tipo_resultado', 'no_entregado');
          formData.append('motivo_no_entrega', reason);
          formData.append('nota_adicional', note);
          if (currentCompressedFile) {
            formData.append('foto', currentCompressedFile);
          }

          const res = await fetch('/api/chofer/entregar', {
            method: 'POST',
            body: formData
          });

          const data = await res.json();

          if (res.ok && data.success) {
            const index = guiasData.findIndex(g => g.id_guia === activeModalGuiaId);
            if (index !== -1) {
              guiasData[index].estado = 'No entregado';
              guiasData[index].recibido_por = data.data.recibido_por;
              if (data.data.comprobante_url) {
                guiasData[index].comprobante_url = data.data.comprobante_url;
              }
            }
            closeModal();
            renderCards();
            updateMapMarkers();
            showToast('¡Incidencia registrada correctamente!', 'info');
          } else {
            showToast(data.message || 'Error al registrar incidencia', 'error');
            modalIncidentSubmitBtn.disabled = false;
            modalIncidentSubmitBtn.innerHTML = originalBtnHtml;
          }
        } catch (err) {
          console.error('Error reportando no entrega:', err);
          showToast('Error de conexión al reportar incidencia', 'error');
          modalIncidentSubmitBtn.disabled = false;
          modalIncidentSubmitBtn.innerHTML = originalBtnHtml;
        }
      });

      // 7. Toast Notifications
      function showToast(msg, type = 'info') {
        toastMessage.textContent = msg;
        if (type === 'success') {
          toastIcon.innerHTML = `<svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`;
        } else if (type === 'error') {
          toastIcon.innerHTML = `<svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>`;
        } else {
          toastIcon.innerHTML = `<svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
        }

        toast.classList.remove('hidden');
        setTimeout(() => {
          toast.classList.add('hidden');
        }, 3500);
      }

      // 8. Control de Pestañas
      function resetTabStyles() {
        const inactiveClass = 'py-2 text-[11px] font-semibold rounded-lg transition-all flex items-center justify-center gap-1 text-slate-600 hover:text-slate-900 cursor-pointer';
        if (tabPendientes) tabPendientes.className = inactiveClass;
        if (tabEntregados) tabEntregados.className = inactiveClass;
        if (tabNoEntregados) tabNoEntregados.className = inactiveClass;
        if (tabTodos) tabTodos.className = inactiveClass;
      }

      tabPendientes?.addEventListener('click', () => {
        activeTab = 'pendientes';
        resetTabStyles();
        tabPendientes.className = 'py-2 text-[11px] font-bold rounded-lg transition-all flex items-center justify-center gap-1 bg-white text-slate-900 shadow-xs cursor-pointer';
        renderCards();
      });

      tabEntregados?.addEventListener('click', () => {
        activeTab = 'entregados';
        resetTabStyles();
        tabEntregados.className = 'py-2 text-[11px] font-bold rounded-lg transition-all flex items-center justify-center gap-1 bg-white text-slate-900 shadow-xs cursor-pointer';
        renderCards();
      });

      tabNoEntregados?.addEventListener('click', () => {
        activeTab = 'no_entregados';
        resetTabStyles();
        tabNoEntregados.className = 'py-2 text-[11px] font-bold rounded-lg transition-all flex items-center justify-center gap-1 bg-white text-rose-900 shadow-xs cursor-pointer';
        renderCards();
      });

      tabTodos?.addEventListener('click', () => {
        activeTab = 'todos';
        resetTabStyles();
        tabTodos.className = 'py-2 text-[11px] font-bold rounded-lg transition-all flex items-center justify-center gap-1 bg-white text-slate-900 shadow-xs cursor-pointer';
        renderCards();
      });

      // 9. Buscador y Filtro de Ciudad
      searchInput?.addEventListener('input', (e) => {
        searchQuery = e.target.value;
        renderCards();
      });

      cityFilter?.addEventListener('change', (e) => {
        selectedCity = e.target.value;
        renderCards();
      });

      // 10. Toggle y Re-centrado del Mapa
      toggleMapBtn?.addEventListener('click', () => {
        isMapVisible = !isMapVisible;
        if (isMapVisible) {
          mapWrapper.classList.remove('hidden');
          toggleMapText.textContent = 'Ocultar Mapa';
          toggleMapIcon.style.transform = 'rotate(0deg)';
          setTimeout(() => {
            if (map) map.invalidateSize();
          }, 200);
        } else {
          mapWrapper.classList.add('hidden');
          toggleMapText.textContent = 'Mostrar Mapa';
          toggleMapIcon.style.transform = 'rotate(180deg)';
        }
      });

      recenterMapBtn?.addEventListener('click', () => {
        userHasInteractedWithMap = false;
        updateMapMarkers(true);
        showToast('Vista ajustada a toda la ruta', 'info');
      });

      // 11. Live Sync en Segundo Plano (cada 4.5 segundos)
      async function fetchLatestGuias(isManual = false) {
        if (isManual && refreshIcon) {
          refreshIcon.classList.add('animate-spin');
        }

        try {
          const res = await fetch('/api/chofer/guias');
          if (res.status === 401 || res.status === 403) {
            window.location.href = '/login';
            return;
          }
          if (res.ok) {
            const data = await res.json();
            if (data.success && Array.isArray(data.data)) {
              guiasData = data.data;
              renderCards();
              updateMapMarkers(isManual);
              if (isManual) {
                showToast('Hoja de ruta actualizada', 'info');
              }
            }
          }
        } catch (err) {
          console.warn('[LiveSync Chofer Error]:', err);
        } finally {
          if (isManual && refreshIcon) {
            setTimeout(() => {
              refreshIcon.classList.remove('animate-spin');
            }, 600);
          }
        }
      }

      refreshBtn?.addEventListener('click', () => {
        fetchLatestGuias(true);
      });

      window.addEventListener('pageshow', (event) => {
        if (event.persisted) {
          window.location.reload();
        }
      });

      // ============================================
      // SISTEMA DE ESCANEO DIRECTO DE GUÍAS FÍSICAS
      // ============================================
      const scanCameraInput = document.getElementById('scan-camera-input') as HTMLInputElement;
      const scanGalleryInput = document.getElementById('scan-gallery-input') as HTMLInputElement;

      const btnNoRoutesCamera = document.getElementById('btn-no-routes-camera');
      const btnNoRoutesGallery = document.getElementById('btn-no-routes-gallery');
      const btnHeaderScan = document.getElementById('btn-header-scan');

      const scanModal = document.getElementById('scan-modal');
      const scanModalCloseBtn = document.getElementById('scan-modal-close-btn');
      const modalBtnCamera = document.getElementById('modal-btn-camera');
      const modalBtnGallery = document.getElementById('modal-btn-gallery');

      const choferScanLiveSection = document.getElementById('chofer-scan-live-section');
      const choferProgressBar = document.getElementById('chofer-progress-bar');
      const choferProgressLabel = document.getElementById('chofer-progress-label');
      const choferProgressCount = document.getElementById('chofer-progress-count');
      const choferGalleryGrid = document.getElementById('chofer-gallery-grid');
      const choferGalleryCount = document.getElementById('chofer-gallery-count');

      const modalScanLiveSection = document.getElementById('modal-scan-live-section');
      const modalProgressBar = document.getElementById('modal-progress-bar');
      const modalProgressLabel = document.getElementById('modal-progress-label');
      const modalProgressCount = document.getElementById('modal-progress-count');
      const modalGalleryGrid = document.getElementById('modal-gallery-grid');
      const modalGalleryCount = document.getElementById('modal-gallery-count');

      let currentScanTargetMode = 'hero'; // 'hero' | 'modal'
      let sessionScannedCount = 0;

      // Generar lote_id único para la sesión
      const nowScan = new Date();
      const pad2 = (n: number) => n.toString().padStart(2, '0');
      const scanLoteId = `chofer_${nowScan.getFullYear()}${pad2(nowScan.getMonth()+1)}${pad2(nowScan.getDate())}_${pad2(nowScan.getHours())}${pad2(nowScan.getMinutes())}`;

      function openScanModal() {
        scanModal?.classList.remove('hidden');
        scanModal?.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeScanModal() {
        scanModal?.classList.add('hidden');
        scanModal?.classList.remove('flex');
        document.body.style.overflow = '';
      }

      btnHeaderScan?.addEventListener('click', () => {
        openScanModal();
      });

      scanModalCloseBtn?.addEventListener('click', closeScanModal);
      scanModal?.addEventListener('click', (e) => {
        if (e.target === scanModal) closeScanModal();
      });

      scanCameraInput?.addEventListener('change', (e) => {
        const files = (e.target as HTMLInputElement).files;
        if (files && files.length > 0) {
          currentScanTargetMode = (scanModal && !scanModal.classList.contains('hidden')) ? 'modal' : 'hero';
          handleScanFiles(Array.from(files));
        }
        scanCameraInput.value = '';
      });

      scanGalleryInput?.addEventListener('change', (e) => {
        const files = (e.target as HTMLInputElement).files;
        if (files && files.length > 0) {
          currentScanTargetMode = (scanModal && !scanModal.classList.contains('hidden')) ? 'modal' : 'hero';
          handleScanFiles(Array.from(files));
        }
        scanGalleryInput.value = '';
      });

      async function handleScanFiles(files: File[]) {
        if (files.length === 0) return;

        const total = files.length;
        let processed = 0;
        let uploadedOk = 0;

        const liveSection = currentScanTargetMode === 'modal' ? modalScanLiveSection : choferScanLiveSection;
        const pBar = currentScanTargetMode === 'modal' ? modalProgressBar : choferProgressBar;
        const pLabel = currentScanTargetMode === 'modal' ? modalProgressLabel : choferProgressLabel;
        const pCount = currentScanTargetMode === 'modal' ? modalProgressCount : choferProgressCount;
        const grid = currentScanTargetMode === 'modal' ? modalGalleryGrid : choferGalleryGrid;
        const countLabel = currentScanTargetMode === 'modal' ? modalGalleryCount : choferGalleryCount;

        liveSection?.classList.remove('hidden');
        if (pBar) pBar.style.width = '0%';
        if (pLabel) pLabel.textContent = `Procesando y subiendo ${total} foto${total !== 1 ? 's' : ''}...`;
        if (pCount) pCount.textContent = `0 / ${total}`;

        for (let i = 0; i < files.length; i++) {
          const file = files[i];
          sessionScannedCount++;
          const itemIndex = sessionScannedCount;

          // Miniatura temporal
          const thumbDiv = document.createElement('div');
          thumbDiv.id = `scan-thumb-${itemIndex}`;
          thumbDiv.className = 'relative aspect-square rounded-xl overflow-hidden bg-slate-100 border-2 border-slate-200 transition-all';
          thumbDiv.innerHTML = `
            <div id="scan-thumb-overlay-${itemIndex}" class="absolute inset-0 bg-black/50 flex items-center justify-center">
              <svg class="w-5 h-5 text-white animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
            </div>
          `;
          if (grid) grid.prepend(thumbDiv);

          try {
            const comp = await compressImage(file, 1200, 1600, 0.75);
            
            // Colocar imagen en miniatura
            const imgEl = document.createElement('img');
            imgEl.src = comp.dataUrl;
            imgEl.className = 'w-full h-full object-cover';
            thumbDiv.prepend(imgEl);

            const formData = new FormData();
            formData.append('foto', comp.file);
            formData.append('foto_base64', comp.dataUrl);
            formData.append('lote_id', scanLoteId);

            const res = await fetch('/api/escaneos', {
              method: 'POST',
              body: formData
            });
            const data = await res.json();

            const overlay = document.getElementById(`scan-thumb-overlay-${itemIndex}`);
            if (res.ok && data.success) {
              uploadedOk++;
              thumbDiv.classList.replace('border-slate-200', 'border-emerald-400');
              if (overlay) {
                overlay.innerHTML = `<svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>`;
                setTimeout(() => overlay.classList.add('opacity-0'), 700);
              }
            } else {
              thumbDiv.classList.replace('border-slate-200', 'border-rose-400');
              if (overlay) {
                overlay.innerHTML = `<svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>`;
              }
            }
          } catch(err) {
            console.error('Error subiendo foto de guía:', err);
            const overlay = document.getElementById(`scan-thumb-overlay-${itemIndex}`);
            thumbDiv.classList.replace('border-slate-200', 'border-rose-400');
            if (overlay) {
              overlay.innerHTML = `<svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>`;
            }
          }

          processed++;
          const pct = Math.round((processed / total) * 100);
          if (pBar) pBar.style.width = `${pct}%`;
          if (pCount) pCount.textContent = `${processed} / ${total}`;
        }

        if (pLabel) pLabel.textContent = `¡${uploadedOk} de ${total} guías cargadas con éxito!`;
        if (countLabel) countLabel.textContent = `${grid?.children.length || 0} subidas`;
        showToast(`¡${uploadedOk} fotos de guías enviadas a Logística Central!`, 'success');
      }

      // Inicialización
      initMap();
      renderCards();

      setInterval(() => {
        fetchLatestGuias(false);
      }, 4500);
    </script>
  </body>
</html>
