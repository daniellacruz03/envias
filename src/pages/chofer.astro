      function normalizeGeoText(text) {
        if (!text) return '';
        return text
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .trim();
      }

      function getGuiaCoords(guia) {
        if (!guia) return [10.0808, -69.3756];
        if (guia.gps_latitud && guia.gps_longitud) {
          var lat = parseFloat(guia.gps_latitud);
          var lng = parseFloat(guia.gps_longitud);
          if (!isNaN(lat) && !isNaN(lng) && lat !== 0 && lng !== 0) {
            return [lat, lng];
          }
        }
        var searchTxt = (normalizeGeoText(guia.direccion_referencia) + ' ' + normalizeGeoText(guia.destinatario)).toLowerCase();
        for (var sec in BARQUISIMETO_SECTORS_MAP) {
          if (searchTxt.indexOf(sec) !== -1) {
            return BARQUISIMETO_SECTORS_MAP[sec];
          }
        }
        var normCity = normalizeGeoText(guia.ciudad_destino);
        if (normCity && VENEZUELA_COORDS_MAP[normCity]) {
          return VENEZUELA_COORDS_MAP[normCity];
        }
        for (var key in VENEZUELA_COORDS_MAP) {
          if (normCity && (normCity.indexOf(key) !== -1 || key.indexOf(normCity) !== -1)) {
            return VENEZUELA_COORDS_MAP[key];
          }
        }
        return [10.0808, -69.3756];
      }

      function haversineDistance(lat1, lon1, lat2, lon2) {
        var R = 6371;
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLon = (lon2 - lon1) * Math.PI / 180;
        var a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon/2) * Math.sin(dLon/2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      }

      // Algoritmo TSP 2-Opt con agrupamiento atómico de paradas colindantes
      function solveTSPWith2Opt(origin, stops) {
        if (!stops || stops.length <= 1) return stops;
        
        // 1. Agrupar puntos colindantes (< 150m) para no separarlos jamás
        var clusters = [];
        var visited = {};
        for (var i = 0; i < stops.length; i++) {
          if (visited[i]) continue;
          var group = [stops[i]];
          visited[i] = true;
          var cI = getGuiaCoords(stops[i]);
          for (var j = i + 1; j < stops.length; j++) {
            if (visited[j]) continue;
            var cJ = getGuiaCoords(stops[j]);
            var d = haversineDistance(cI[0], cI[1], cJ[0], cJ[1]);
            if (d < 0.18) { // Menos de 180 metros
              group.push(stops[j]);
              visited[j] = true;
            }
          }
          clusters.push({ coords: cI, items: group });
        }

        // 2. Nearest Neighbor en representantes de cluster
        var remaining = clusters.slice();
        var tour = [];
        var curr = origin;
        while (remaining.length > 0) {
          var bestIdx = 0;
          var bestDist = Infinity;
          for (var r = 0; r < remaining.length; r++) {
            var c = remaining[r].coords;
            var dist = haversineDistance(curr[0], curr[1], c[0], c[1]);
            if (dist < bestDist) { bestDist = dist; bestIdx = r; }
          }
          var next = remaining.splice(bestIdx, 1)[0];
          tour.push(next);
          curr = next.coords;
        }

        // 3. Refinamiento 2-Opt para garantizar cero cruces
        var improved = true;
        var iterations = 0;
        while (improved && iterations < 60) {
          improved = false;
          iterations++;
          for (var a = 0; a < tour.length - 1; a++) {
            for (var b = a + 1; b < tour.length; b++) {
              var pA = a === 0 ? origin : tour[a - 1].coords;
              var pB = tour[a].coords;
              var pC = tour[b].coords;
              var pD = b + 1 < tour.length ? tour[b + 1].coords : origin;
              var dCurrent = haversineDistance(pA[0], pA[1], pB[0], pB[1]) + haversineDistance(pC[0], pC[1], pD[0], pD[1]);
              var dNew = haversineDistance(pA[0], pA[1], pC[0], pC[1]) + haversineDistance(pB[0], pB[1], pD[0], pD[1]);
              if (dNew < dCurrent - 0.001) {
                var sub = tour.slice(a, b + 1).reverse();
                tour.splice(a, b - a + 1);
                for (var s = 0; s < sub.length; s++) { tour.splice(a + s, 0, sub[s]); }
                improved = true;
              }
            }
          }
        }

        // 4. Aplanar de vuelta a lista de guías ordenadas
        var finalStops = [];
        tour.forEach(function(cl) {
          cl.items.forEach(function(item) { finalStops.push(item); });
        });
        return finalStops;
      }


      // Consulta de geometría vial real vía OSRM
      async function fetchOSRMRouteGeometry(waypoints) {
        if (!waypoints || waypoints.length < 2) return waypoints;
        try {
          var pointsToRequest = waypoints.slice(0, 25);
          var url = 'https://router.project-osrm.org/route/v1/driving/' +
            pointsToRequest.map(function(p) { return p[1].toFixed(5) + ',' + p[0].toFixed(5); }).join(';') +
            '?overview=full&geometries=geojson';

          var controller = new AbortController();
          var timeoutId = setTimeout(function() { controller.abort(); }, 3500);
          var res = await fetch(url, { signal: controller.signal });
          clearTimeout(timeoutId);

          if (!res.ok) return waypoints;
          var data = await res.json();
          if (data.code === 'Ok' && data.routes && data.routes[0] && data.routes[0].geometry) {
            return data.routes[0].geometry.coordinates.map(function(c) {
              return [c[1], c[0]];
            });
          }
        } catch (e) {
          console.warn('[OSRM Routing Fallback to Direct Geometry]:', e);
        }
        return waypoints;
      }

      // Inicialización segura del mapa Leaflet
      function initMap() {
        try {
          if (typeof L === 'undefined') return;
          var mapContainer = document.getElementById('route-map');
          if (!mapContainer || map) return;

          map = L.map('route-map', { zoomControl: true, attributionControl: false }).setView([10.0808, -69.3756], 12);
          L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
            maxZoom: 19,
            subdomains: 'abcd'
          }).addTo(map);

          markersLayer = L.layerGroup().addTo(map);
          updateMapMarkers();
        } catch (err) {
          console.warn('[Map Init Warning]:', err);
        }
      }

      async function updateMapMarkers() {
        if (!map || !markersLayer || typeof L === 'undefined') return;
        markersLayer.clearLayers();
        markersByGuiaId = {};

        var startLabel = (guiasData[0] && guiasData[0].ruta_origen) ? guiasData[0].ruta_origen : 'Sede Principal Barquisimeto';
        var endLabel = (guiasData[0] && guiasData[0].ruta_destino) ? guiasData[0].ruta_destino : 'Retorno a Sede Principal Barquisimeto';
        var startCoords = VENEZUELA_COORDS_MAP[normalizeGeoText(startLabel)] || [10.0808, -69.3756];

        // Verificar si las guías necesitan ordenamiento 2-Opt
        var needsSorting = guiasData.some(function(g) { return !g.orden_ruta || g.orden_ruta <= 0; });
        var sortedGuias = guiasData.slice();
        if (needsSorting) {
          sortedGuias = solveTSPWith2Opt(startCoords, sortedGuias);
          sortedGuias.forEach(function(g, i) { g.orden_ruta = i + 1; });
        } else {
          sortedGuias.sort(function(a, b) { return (a.orden_ruta || 999) - (b.orden_ruta || 999); });
        }

        // Actualizar textos del banner de itinerario
        var routeStartText = document.getElementById('route-start-text');
        var routeEndText = document.getElementById('route-end-text');
        var routeStopsCountText = document.getElementById('route-stops-count-text');
        if (routeStartText) routeStartText.textContent = startLabel;
        if (routeEndText) routeEndText.textContent = endLabel;
        if (routeStopsCountText) routeStopsCountText.textContent = sortedGuias.length + ' parada(s)';

        // Buscar la siguiente parada pendiente
        var nextPendingGuia = sortedGuias.find(function(g) { return g.estado !== 'Entregado' && g.estado !== 'No entregado'; });

        var waypoints = [];

        // 1. Marcador de Salida / Almacén (Hub)
        var hubIcon = L.divIcon({
          html: '<div style="background:#4338ca;width:32px;height:32px;border-radius:10px;border:2.5px solid white;color:white;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:900;box-shadow:0 3px 10px rgba(67,56,202,0.4);">' +
                  '<svg style="width:17px;height:17px;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>' +
                '</div>',
          className: '',
          iconSize: [32, 32],
          iconAnchor: [16, 16]
        });
        var startMarker = L.marker(startCoords, { icon: hubIcon }).addTo(markersLayer);
        startMarker.bindPopup('<div style="font-family:inherit;font-size:12px;"><b style="color:#4338ca;">Punto de Salida</b><br/>' + startLabel + '</div>');
        waypoints.push(startCoords);

        // 2. Marcadores de las paradas en orden del circuito Spoke
        sortedGuias.forEach(function(g, idx) {
          var coords = getGuiaCoords(g);
          if (coords) {
            var stopNum = g.orden_ruta && g.orden_ruta > 0 ? g.orden_ruta : (idx + 1);
            var isDelivered = g.estado === 'Entregado';
            var isIncident = g.estado === 'No entregado';
            var isNextActive = nextPendingGuia && nextPendingGuia.id_guia === g.id_guia;

            var bgColor = isDelivered ? '#059669' : isIncident ? '#e11d48' : isNextActive ? '#4f46e5' : '#0f172a';
            var pulseClass = isNextActive ? 'active-stop-pulse' : '';
            var size = isNextActive ? 32 : 28;

            var iconHtml = '<div class="' + pulseClass + '" style="background:' + bgColor + ';width:' + size + 'px;height:' + size + 'px;border-radius:50%;border:2.5px solid white;color:white;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;box-shadow:0 3px 8px rgba(0,0,0,0.35);">' +
                stopNum +
              '</div>';
            var icon = L.divIcon({ html: iconHtml, className: '', iconSize: [size, size], iconAnchor: [size/2, size/2] });
            var marker = L.marker(coords, { icon: icon }).addTo(markersLayer);

            var popupContent = '<div style="font-family:inherit;font-size:12px;min-width:170px;">' +
              '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:3px;">' +
                '<span style="font-weight:900;color:#0f172a;font-size:12px;">Parada #' + stopNum + '</span>' +
                '<span style="font-family:monospace;font-weight:700;color:#64748b;font-size:10px;">#' + g.id_guia + '</span>' +
              '</div>' +
              '<div style="font-weight:800;color:#4338ca;font-size:12px;">' + (g.destinatario || 'Destinatario') + '</div>' +
              '<div style="font-size:11px;color:#64748b;margin-top:2px;">' + (g.ciudad_destino || '') + (g.direccion_referencia ? ' &bull; ' + g.direccion_referencia : '') + '</div>' +
              '<div style="margin-top:6px;"><span style="background:' + (isDelivered ? '#ecfdf5;color:#065f46;' : isIncident ? '#fff1f2;color:#9f1239;' : isNextActive ? '#eef2ff;color:#4338ca;' : '#f8fafc;color:#334155;') + 'padding:2px 7px;border-radius:6px;font-weight:800;font-size:10px;border:1px solid #cbd5e1;">' + (isDelivered ? 'Entregado' : isIncident ? 'No entregado' : isNextActive ? 'Siguiente Parada' : 'Pendiente') + '</span></div>' +
            '</div>';

            marker.bindPopup(popupContent);
            markersByGuiaId[g.id_guia] = { marker: marker, latLng: coords, stopNum: stopNum };
            waypoints.push(coords);
          }
        });

        // 3. Conexión de retorno
        var normEnd = normalizeGeoText(endLabel);
        if (normEnd.indexOf('retorno') !== -1 || normEnd.indexOf('sede') !== -1 || normEnd.indexOf('barquisimeto') !== -1) {
          waypoints.push(startCoords);
        }

        // 4. Trazado de Carretera Real con OSRM
        if (routePolyline) { map.removeLayer(routePolyline); routePolyline = null; }
        if (routeGlowPolyline) { map.removeLayer(routeGlowPolyline); routeGlowPolyline = null; }

        if (waypoints.length > 1) {
          // Primero dibujar polyline provisional rápido
          routePolyline = L.polyline(waypoints, { color: '#6366f1', weight: 4, opacity: 0.9 }).addTo(map);

          if (waypoints.length > 0) {
            map.fitBounds(L.latLngBounds(waypoints), { padding: [40, 40] });
          }

          // Luego consultar OSRM para reemplazar con la ruta real exacta
          fetchOSRMRouteGeometry(waypoints).then(function(roadCoords) {
            if (!roadCoords || roadCoords.length < 2 || !map) return;
            if (routePolyline) map.removeLayer(routePolyline);
            if (routeGlowPolyline) map.removeLayer(routeGlowPolyline);

            // Capa de resplandor / casing
            routeGlowPolyline = L.polyline(roadCoords, {
              color: '#312e81',
              weight: 7,
              opacity: 0.35,
              lineCap: 'round',
              lineJoin: 'round'
            }).addTo(map);

            // Capa principal carretera
            routePolyline = L.polyline(roadCoords, {
              color: '#4f46e5',
              weight: 4,
              opacity: 0.95,
              lineCap: 'round',
              lineJoin: 'round'
            }).addTo(map);
          });
        } else if (waypoints.length === 1) {
          map.setView(waypoints[0], 14);
        }
      }

      // Centrar y enfocar parada desde tarjeta
      window.focusStopOnMap = function(guiaId) {
        var item = markersByGuiaId[guiaId];
        var mapWrapper = document.getElementById('map-wrapper');
        var toggleMapText = document.getElementById('toggle-map-text');

        if (!isMapVisible && mapWrapper) {
          isMapVisible = true;
          mapWrapper.classList.remove('hidden');
          if (toggleMapText) toggleMapText.textContent = 'Ocultar Mapa';
          if (map) map.invalidateSize();
        }

        if (mapWrapper) {
          mapWrapper.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        if (map && item) {
          setTimeout(function() {
            map.setView(item.latLng, 16, { animate: true });
            item.marker.openPopup();
          }, 300);
        }
      };

      // Toggle Mapa
      var toggleMapBtn = document.getElementById('toggle-map-btn');
      var toggleMapText = document.getElementById('toggle-map-text');
      var mapWrapper = document.getElementById('map-wrapper');
      var recenterMapBtn = document.getElementById('recenter-map-btn');

      if (toggleMapBtn) {
        toggleMapBtn.addEventListener('click', function() {
          isMapVisible = !isMapVisible;
          if (isMapVisible) {
            if (mapWrapper) mapWrapper.classList.remove('hidden');
            if (toggleMapText) toggleMapText.textContent = 'Ocultar Mapa';
            setTimeout(function() { if (map) map.invalidateSize(); }, 150);
          } else {
            if (mapWrapper) mapWrapper.classList.add('hidden');
            if (toggleMapText) toggleMapText.textContent = 'Ver Mapa';
          }
        });
      }

      if (recenterMapBtn) {
        recenterMapBtn.addEventListener('click', function() {
          updateMapMarkers();
        });
      }



      // ====================================================
      // MÓDULO 4: LIGHTBOX
      // ====================================================
      var lightboxModal = document.getElementById('lightbox-modal');
      var lightboxImg = document.getElementById('lightbox-img');
      var lightboxTitle = document.getElementById('lightbox-title');
      var lightboxInfo = document.getElementById('lightbox-info');
      var lightboxCloseBtn = document.getElementById('lightbox-close-btn');
      var lightboxDeleteBtn = document.getElementById('lightbox-delete-btn');

      var currentChoferLightboxGuiaId = null;

      window.openLightbox = function(url, title, info, guiaId) {
        if (!lightboxModal || !lightboxImg) return;
        lightboxImg.src = url;
        if (lightboxTitle) lightboxTitle.textContent = title || 'Comprobante';
        if (lightboxInfo) lightboxInfo.textContent = info || '';

        currentChoferLightboxGuiaId = guiaId || null;
        if (lightboxDeleteBtn) {
          if (currentChoferLightboxGuiaId) {
            lightboxDeleteBtn.classList.remove('hidden');
            lightboxDeleteBtn.classList.add('flex');
          } else {
            lightboxDeleteBtn.classList.add('hidden');
            lightboxDeleteBtn.classList.remove('flex');
          }
        }

        lightboxModal.classList.remove('hidden');
        lightboxModal.classList.add('flex');
      };

      if (lightboxDeleteBtn) {
        lightboxDeleteBtn.addEventListener('click', async function() {
          if (!currentChoferLightboxGuiaId) return;

          if (!confirm('¿Estás seguro de eliminar la foto de comprobante de la guía #' + currentChoferLightboxGuiaId + '?')) {
            return;
          }

          var origText = lightboxDeleteBtn.innerHTML;
          lightboxDeleteBtn.disabled = true;
          lightboxDeleteBtn.innerHTML = '<span>Borrando...</span>';

          try {
            var res = await fetch('/api/guias/' + currentChoferLightboxGuiaId + '/foto', { method: 'DELETE' });
            var data = await res.json().catch(function() { return { success: false, message: 'Error de respuesta' }; });

            if (res.ok && data.success) {
              showToast('Foto eliminada correctamente', 'success');
              var targetId = currentChoferLightboxGuiaId;
              var item = guiasData.find(function(g) { return g.id_guia === targetId; });
              if (item) {
                item.comprobante_url = null;
                item.comprobante_base64 = null;
                item.recibido_por = null;
              }
              renderCards();
              closeLightbox();
            } else {
              showToast(data.message || 'Error al eliminar foto', 'error');
            }
          } catch(e) {
            showToast('Error de conexión', 'error');
          } finally {
            lightboxDeleteBtn.disabled = false;
            lightboxDeleteBtn.innerHTML = origText;
          }
        });
      }

      function closeLightbox() {
        if (lightboxModal) {
          lightboxModal.classList.add('hidden');
          lightboxModal.classList.remove('flex');
        }
        if (lightboxImg) lightboxImg.src = '';
        currentChoferLightboxGuiaId = null;
      }

      if (lightboxCloseBtn) lightboxCloseBtn.addEventListener('click', closeLightbox);
      if (lightboxModal) {
        lightboxModal.addEventListener('click', function(e) {
          if (e.target === lightboxModal) closeLightbox();
        });
      }

      // ====================================================
      // MÓDULO 5: LIVE SYNC SILENCIOSO (4.5s)
      // ====================================================
      var refreshBtn = document.getElementById('refresh-btn');
      var refreshIcon = document.getElementById('refresh-icon');

      async function syncGuias(showToastNotification) {
        if (isUploadingScans) return;
        if (refreshIcon) refreshIcon.classList.add('animate-spin');
        try {
          var res = await fetch('/api/chofer/guias');
          if (!res.ok) return;
          var json = await res.json();
          if (json.success && Array.isArray(json.data)) {
            guiasData = json.data;

            var noRoutesContainer = document.getElementById('no-routes-container');
            var activeRoutesContainer = document.getElementById('active-routes-container');

            if (guiasData.length === 0) {
              if (noRoutesContainer) noRoutesContainer.classList.remove('hidden');
              if (activeRoutesContainer) activeRoutesContainer.classList.add('hidden');
            } else {
              if (noRoutesContainer) noRoutesContainer.classList.add('hidden');
              if (activeRoutesContainer) activeRoutesContainer.classList.remove('hidden');
            }

            renderCards();
            updateMapMarkers();
            if (showToastNotification) {
              showToast('Ruta actualizada', 'success');
            }
          }
        } catch (err) {
          if (showToastNotification) {
            showToast('Error al sincronizar con el servidor', 'error');
          }
        } finally {
          if (refreshIcon) refreshIcon.classList.remove('animate-spin');
        }
      }

      // ----------------------------------------------------
      // LISTÍN DE DESPACHO OFICIAL PARA IMPRESIÓN DEL CHOFER
      // ----------------------------------------------------
      function renderChoferListinTable() {
        var tbody = document.getElementById('chofer-listin-tbody');
        var totalGuiasEl = document.getElementById('chofer-listin-total-guias');
        var totalPiezasEl = document.getElementById('chofer-listin-total-piezas');
        var totalDestinosEl = document.getElementById('chofer-listin-total-destinos');

        var activeGuias = (guiasData || []).slice().sort(function(a, b) {
          if (a.orden_ruta && b.orden_ruta) return a.orden_ruta - b.orden_ruta;
          if (a.orden_ruta) return -1;
          if (b.orden_ruta) return 1;
          return (a.ciudad_destino || '').localeCompare(b.ciudad_destino || '');
        });

        var uniqueCities = Array.from(new Set(activeGuias.map(function(g) { return (g.ciudad_destino || '').trim(); }).filter(Boolean)));
        var totalGuias = activeGuias.length;
        var totalPiezas = activeGuias.reduce(function(acc, g) { return acc + (g.piezas || 1); }, 0);

        if (totalGuiasEl) totalGuiasEl.textContent = totalGuias.toString();
        if (totalPiezasEl) totalPiezasEl.textContent = totalPiezas.toString();
        if (totalDestinosEl) totalDestinosEl.textContent = uniqueCities.length.toString();

        var rowCount = Math.max(Math.ceil(activeGuias.length / 2), 20);
        var leftGuias = activeGuias.slice(0, rowCount);
        var rightGuias = activeGuias.slice(rowCount, rowCount * 2);

        var html = '';
        for (var i = 0; i < rowCount; i++) {
          var left = leftGuias[i];
          var right = rightGuias[i];

          html += '<tr class="h-6 border-b border-black/30 text-black">' +
              '<!-- Bloque Izquierdo -->' +
              '<td class="py-1 px-1.5 border-r border-black font-mono font-bold text-center">' + (left ? left.id_guia : '') + '</td>' +
              '<td class="py-1 px-1 border-r border-black text-center font-bold">' + (left ? (left.piezas || 1) : '') + '</td>' +
              '<td class="py-1 px-2 border-r-2 border-black font-bold uppercase truncate max-w-[140px]">' + (left ? left.ciudad_destino : '') + '</td>' +
              '<!-- Bloque Derecho -->' +
              '<td class="py-1 px-1.5 border-r border-black font-mono font-bold text-center">' + (right ? right.id_guia : '') + '</td>' +
              '<td class="py-1 px-1 border-r border-black text-center font-bold">' + (right ? (right.piezas || 1) : '') + '</td>' +
              '<td class="py-1 px-2 font-bold uppercase truncate max-w-[140px]">' + (right ? right.ciudad_destino : '') + '</td>' +
            '</tr>';
        }

        if (tbody) {
          tbody.innerHTML = html;
        }
      }

      window.openChoferListinModal = function() {
        renderChoferListinTable();
        var modal = document.getElementById('chofer-listin-modal');
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      };

      window.closeChoferListinModal = function() {
        var modal = document.getElementById('chofer-listin-modal');
        if (modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      };

      if (refreshBtn) refreshBtn.addEventListener('click', function() { syncGuias(true); });

      // Polling de 4.5s
      setInterval(function() {
        syncGuias(false);
      }, 4500);

      // Inicialización en arranque
      document.addEventListener('DOMContentLoaded', function() {
        renderCards();
        initMap();
      });

      // Si DOMContentLoaded ya pasó (script diferido)
      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        renderCards();
        setTimeout(initMap, 200);
      }
    </script>
  </body>
</html>
