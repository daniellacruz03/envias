---
import '../styles/global.css';
import { getUserFromCookies } from '../lib/auth';
import { query } from '../lib/db';

// 1. Verificación de Autenticación en SSR
const currentUser = getUserFromCookies(Astro.cookies);
if (!currentUser) {
  return Astro.redirect('/login');
}

// Si el usuario NO es Chofer (ej. Logística o Admin), redirigir a su portal central
if (currentUser.rol !== 'Chofer') {
  return Astro.redirect('/dashboard');
}

// Encabezados anti-caché para impedir que al pulsar "Atrás" se vea la sesión cerrada
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

const targetChoferId = currentUser.id;
const targetChoferNombre = currentUser.nombre;

// 2. Consulta inicial SSR de guías asignadas
const guiasResult = await query(`
  SELECT 
    g.id_guia,
    g.destinatario,
    g.telefono_principal,
    g.telefono_secundario,
    g.ciudad_destino,
    g.piezas,
    g.direccion_referencia,
    g.hora_disponible,
    g.comprobante_url,
    g.recibido_por,
    g.orden_ruta,
    g.ruta_origen,
    g.ruta_destino,
    g.estado,
    g.gps_latitud,
    g.gps_longitud,
    g.gps_confirmado,
    g.chofer_asignado_id,
    g.created_at,
    u.nombre AS chofer_nombre,
    u.telefono AS chofer_telefono
  FROM guias g
  LEFT JOIN usuarios u ON g.chofer_asignado_id = u.id
  WHERE g.chofer_asignado_id = $1
  ORDER BY 
    CASE 
      WHEN g.estado = 'En ruta' THEN 1
      WHEN g.estado = 'Contactado' THEN 2
      WHEN g.estado = 'Por contactar' THEN 3
      WHEN g.estado = 'Entregado' THEN 4
      ELSE 5
    END,
    NULLIF(g.orden_ruta, 0) ASC NULLS LAST,
    g.created_at DESC
`, [targetChoferId]);

const initialGuias = guiasResult.rows;
const totalInitial = initialGuias.length;
const pendientesInitial = initialGuias.filter(g => g.estado !== 'Entregado').length;
const entregadosInitial = initialGuias.filter(g => g.estado === 'Entregado').length;
const porcentajeInitial = totalInitial > 0 ? Math.round((entregadosInitial / totalInitial) * 100) : 0;

// Extraer ciudades únicas para filtro
const uniqueCiudades = Array.from(new Set(initialGuias.map(g => g.ciudad_destino).filter(Boolean)));

const title = `Hoja de Ruta | ${targetChoferNombre} - Envías C.A.`;
---

<!doctype html>
<html lang="es" class="h-full bg-[#F8FAFC]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Leaflet.js CSS y JS -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
    <script
      is:inline
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""
    ></script>

    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        -webkit-tap-highlight-color: transparent;
      }
      .tap-active:active {
        transform: scale(0.98);
      }
      /* Custom map popup styling */
      .leaflet-popup-content-wrapper {
        border-radius: 1rem;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        padding: 0.25rem;
        border: 1px solid #e2e8f0;
      }
      .leaflet-popup-content {
        margin: 0.75rem 0.85rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
      .custom-stop-icon {
        background: transparent;
        border: none;
      }
    </style>
  </head>

  <body class="min-h-full bg-[#F8FAFC] text-slate-800 pb-24 antialiased selection:bg-slate-900 selection:text-white relative">

    <!-- ========================================== -->
    <!-- 1. CABECERA DE TURNO (STICKY COMPACTA)     -->
    <!-- ========================================== -->
    <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200/80 px-4 py-2.5 shadow-xs">
      <div class="max-w-2xl mx-auto flex items-center justify-between gap-3">
        
        <!-- Identidad Chofer -->
        <div class="flex items-center gap-2.5 min-w-0">
          <img 
            src="/logo.png" 
            alt="Envías C.A." 
            class="h-7 w-auto object-contain mix-blend-multiply filter contrast-[1.20] brightness-[0.96] shrink-0"
            loading="eager"
          />
          <div class="border-l border-slate-200 pl-2.5 min-w-0">
            <div class="flex items-center gap-1.5">
              <h1 class="text-xs sm:text-sm font-bold text-slate-900 leading-tight truncate" id="driver-name-display">
                {targetChoferNombre}
              </h1>
              <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded-md text-[9px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200/80 shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                En ruta
              </span>
            </div>
            <p class="text-[10px] text-slate-400 font-medium">Hoja de Ruta Digital &bull; Envías</p>
          </div>
        </div>

        <!-- Acciones Header -->
        <div class="flex items-center gap-1.5 shrink-0">
          {currentUser.rol !== 'Chofer' && (
            <a 
              href="/dashboard" 
              class="px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 text-xs font-semibold flex items-center gap-1 transition-colors"
              title="Volver a Logística Central"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              <span class="hidden sm:inline">Central</span>
            </a>
          )}

          <button 
            id="refresh-btn"
            class="p-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 border border-slate-200/80 transition-colors tap-active cursor-pointer"
            title="Sincronizar paradas"
          >
            <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </button>

          <a 
            href="/api/auth/logout"
            class="p-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200/60 transition-colors tap-active"
            title="Cerrar sesión"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
          </a>
        </div>

      </div>
    </header>

    <!-- ========================================== -->
    <!-- 2. CONTENEDOR PRINCIPAL MOBILE-FIRST       -->
    <!-- ========================================== -->
    <main class="max-w-2xl mx-auto px-4 pt-3.5 space-y-3.5">

      <!-- TARJETA COMPACTA DE PROGRESO DE RUTA -->
      <section class="bg-white rounded-2xl border border-slate-200/80 p-3.5 shadow-sm">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <div class="w-6 h-6 rounded-lg bg-slate-900 text-white flex items-center justify-center text-[10px] font-bold">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
            </div>
            <span class="text-xs font-bold uppercase tracking-wider text-slate-800">Progreso de la Ruta</span>
          </div>
          <span class="text-xs font-extrabold text-slate-900" id="progress-text">
            {entregadosInitial} de {totalInitial} paradas ({porcentajeInitial}%)
          </span>
        </div>

        <!-- Barra de Progreso -->
        <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden mb-2.5 border border-slate-200/60">
          <div 
            id="progress-bar-fill"
            class="bg-gradient-to-r from-slate-900 to-emerald-600 h-full rounded-full transition-all duration-500 ease-out"
            style={`width: ${porcentajeInitial}%`}
          ></div>
        </div>

        <!-- Mini Badges de Conteo -->
        <div class="flex items-center justify-between text-xs pt-1 border-t border-slate-100 text-slate-600">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            <span>Pendientes: <b class="text-slate-900" id="stat-pendientes">{pendientesInitial}</b></span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Entregadas: <b class="text-slate-900" id="stat-entregados">{entregadosInitial}</b></span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
            <span>Total: <b class="text-slate-900" id="stat-total">{totalInitial}</b></span>
          </div>
        </div>

        <!-- Banner de Itinerario de Ruta Planificada (Spoke Style) -->
        <div id="route-itinerary-banner" class="mt-2 bg-slate-900 text-white rounded-xl p-3 shadow-sm space-y-1.5 border border-slate-800">
          <div class="flex items-center justify-between text-xs">
            <span class="text-[10px] uppercase tracking-wider font-extrabold text-indigo-400 flex items-center gap-1">
              <svg class="w-3 h-3 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
              <span>Itinerario Despachado</span>
            </span>
            <span class="text-[10px] font-mono font-bold text-slate-300" id="route-stops-count-text">{totalInitial} paradas</span>
          </div>
          <div class="flex items-center gap-2 text-xs font-semibold">
            <div class="flex items-center gap-1 text-slate-200 truncate flex-1">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 shrink-0"></span>
              <span id="route-start-text" class="truncate font-bold">Sede Principal Barquisimeto</span>
            </div>
            <svg class="w-3.5 h-3.5 text-slate-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            <div class="flex items-center gap-1 text-slate-200 truncate flex-1 justify-end">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
              <span id="route-end-text" class="truncate font-bold">Retorno a Sede Principal Barquisimeto</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- 3. MAPA INTERACTIVO DE HOJA DE RUTA        -->
      <!-- ========================================== -->
      <section class="space-y-2">
        <div class="flex items-center justify-between px-1">
          <div class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">Mapa de Paradas GPS</h2>
          </div>
          
          <!-- Botón de Colapsar/Expandir Mapa -->
          <button 
            id="toggle-map-btn" 
            class="text-[11px] font-semibold text-indigo-600 hover:text-indigo-800 flex items-center gap-1 cursor-pointer"
          >
            <span id="toggle-map-text">Ocultar Mapa</span>
            <svg id="toggle-map-icon" xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
            </svg>
          </button>
        </div>

        <!-- Contenedor del Mapa Leaflet -->
        <div id="map-wrapper" class="relative rounded-2xl overflow-hidden border border-slate-200/90 shadow-sm bg-slate-100 transition-all duration-300">
          <div id="route-map" class="h-64 sm:h-80 w-full z-10"></div>
          
          <!-- Badge Flotante con Distancia y Tiempo Real en Carretera -->
          <div 
            id="route-info-pill" 
            class="hidden absolute top-3 left-3 z-20 bg-white/95 backdrop-blur-xs border border-slate-200/90 px-3 py-1.5 rounded-xl shadow-md text-[11px] font-bold text-slate-800 flex items-center gap-1.5 animate-fadeIn"
          >
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-600"></span>
            </span>
            <span id="route-distance-text">Calculando ruta por carretera...</span>
          </div>

          <!-- Botón Flotante para Re-centrar Paradas -->
          <button 
            id="recenter-map-btn"
            class="absolute bottom-3 right-3 z-20 p-2.5 rounded-xl bg-white/95 text-slate-800 border border-slate-200 shadow-md hover:bg-white transition-all tap-active cursor-pointer"
            title="Ajustar vista a todas las paradas"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
            </svg>
          </button>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- 4. BARRA DE FILTROS & BÚSQUEDA             -->
      <!-- ========================================== -->
      <section class="space-y-2 pt-1">
        
        <div class="flex items-center gap-2">
          <!-- Buscador en tiempo real -->
          <div class="relative flex-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input 
              type="text" 
              id="search-input"
              placeholder="Buscar por guía, cliente o dirección..."
              class="w-full bg-white border border-slate-200 rounded-xl pl-9 pr-3 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 shadow-2xs transition-all"
            />
          </div>

          <!-- Filtro por Ciudad (si aplica) -->
          {uniqueCiudades.length > 1 && (
            <select 
              id="city-filter"
              class="bg-white border border-slate-200 rounded-xl px-2.5 py-2 text-xs text-slate-700 font-semibold focus:outline-none focus:ring-2 focus:ring-slate-900/10 cursor-pointer shadow-2xs shrink-0"
            >
              <option value="">Todas las ciudades</option>
              {uniqueCiudades.map(city => (
                <option value={city}>{city}</option>
              ))}
            </select>
          )}
        </div>

        <!-- Segmented Control de Pestañas (En Ruta / Entregados / Todos) -->
        <div class="grid grid-cols-3 p-1 bg-slate-200/70 rounded-xl border border-slate-200/80 text-xs">
          <button 
            id="tab-pendientes"
            class="py-2 text-xs font-bold rounded-lg transition-all flex items-center justify-center gap-1 bg-white text-slate-900 shadow-xs cursor-pointer"
          >
            <span>Pendientes</span>
            <span class="px-1.5 py-0.2 rounded-full bg-slate-900 text-white text-[10px]" id="badge-tab-pendientes">
              {pendientesInitial}
            </span>
          </button>

          <button 
            id="tab-entregados"
            class="py-2 text-xs font-semibold rounded-lg transition-all flex items-center justify-center gap-1 text-slate-600 hover:text-slate-900 cursor-pointer"
          >
            <span>Entregados</span>
            <span class="px-1.5 py-0.2 rounded-full bg-slate-300 text-slate-700 text-[10px]" id="badge-tab-entregados">
              {entregadosInitial}
            </span>
          </button>

          <button 
            id="tab-todos"
            class="py-2 text-xs font-semibold rounded-lg transition-all flex items-center justify-center gap-1 text-slate-600 hover:text-slate-900 cursor-pointer"
          >
            <span>Todos</span>
            <span class="px-1.5 py-0.2 rounded-full bg-slate-300 text-slate-700 text-[10px]" id="badge-tab-todos">
              {totalInitial}
            </span>
          </button>
        </div>

      </section>

      <!-- ========================================== -->
      <!-- 5. LISTA DE PARADAS SECUENCIALES (CARDS)   -->
      <!-- ========================================== -->
      <section id="cards-container" class="space-y-3">
        <!-- Generado dinámicamente con JavaScript -->
      </section>

      <!-- ESTADO VACÍO (EMPTY STATE) -->
      <div id="empty-state" class="hidden bg-white rounded-2xl border border-slate-200/80 p-8 text-center my-6 shadow-sm animate-fadeIn">
        <div class="w-12 h-12 rounded-2xl bg-slate-100 border border-slate-200 text-slate-700 flex items-center justify-center mx-auto mb-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h3 class="text-sm font-bold text-slate-900 mb-1" id="empty-title">¡Sin paradas en este filtro!</h3>
        <p class="text-xs text-slate-500 max-w-xs mx-auto leading-relaxed" id="empty-desc">
          No hay entregas que coincidan con la búsqueda o el estado seleccionado.
        </p>
      </div>

    </main>

    <!-- ========================================== -->
    <!-- 6. MODAL / BOTTOM SHEET DE ENTREGA         -->
    <!-- ========================================== -->
    <div id="delivery-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs hidden items-end sm:items-center justify-center p-0 sm:p-4 transition-all">
      <div class="w-full sm:max-w-md bg-white border border-slate-200 rounded-t-3xl sm:rounded-3xl p-5 sm:p-6 shadow-2xl space-y-4 animate-fadeIn">
        
        <!-- Cabecera modal -->
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <div class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900">Confirmar Entrega Realizada</h3>
              <p class="text-[11px] text-slate-500" id="modal-guia-code">Parada #--- &bull; Guía #---</p>
            </div>
          </div>
          <button id="modal-close-btn" class="p-1.5 text-slate-400 hover:text-slate-600 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Info del Destinatario -->
        <div class="bg-slate-50 rounded-2xl p-3.5 border border-slate-200/80 space-y-1 text-xs">
          <p class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Destinatario</p>
          <p class="font-bold text-slate-900 text-sm" id="modal-destinatario">---</p>
          <p class="text-slate-500 text-xs" id="modal-direccion">---</p>
        </div>

        <!-- Campo Obligatorio: Foto Comprobante de Entrega -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-bold text-slate-800 flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
