            />
          </div>
        </div>

        <!-- PANEL B: REPORTE DE INCIDENCIA -->
        <div id="modal-panel-incident" class="hidden space-y-3.5">
          <div class="space-y-1.5">
            <label for="modal-incident-reason" class="block text-xs font-bold text-slate-800">
