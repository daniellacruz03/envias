                        type="button"
                        onclick="window.openLightbox('${guia.comprobante_url}', 'Guía #${guia.id_guia} - ${guia.destinatario.replace(/'/g, "\\'")}', '${guia.recibido_por ? `Recibido por: ${guia.recibido_por.replace(/'/g, "\\'")}` : 'Comprobante verificado'}')"
                        class="w-full py-2 px-3 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-bold flex items-center justify-center gap-1.5 transition-all shadow-xs cursor-pointer tap-active"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <span>Ver Foto Comprobante</span>
                      </button>
                    ` : ''}
                  </div>
                `}

              </div>
            `;

            cardsContainer.appendChild(card);
          });
        }

        updateStats();
      }

      // 5. Actualizar KPIs y Contadores
      function updateStats() {
        const total = guiasData.length;
        const pendientes = guiasData.filter(g => g.estado !== 'Entregado').length;
        const entregados = guiasData.filter(g => g.estado === 'Entregado').length;
        const porcentaje = total > 0 ? Math.round((entregados / total) * 100) : 0;

        statPendientes.textContent = pendientes;
        statEntregados.textContent = entregados;
        statTotal.textContent = total;
        
        badgeTabPendientes.textContent = pendientes;
        badgeTabEntregados.textContent = entregados;
        badgeTabTodos.textContent = total;
        
        progressText.textContent = `${entregados} de ${total} paradas (${porcentaje}%)`;
        progressBarFill.style.width = `${porcentaje}%`;

        // Actualizar banner de itinerario si hay origen y destino
        const activeWithRoute = guiasData.find(g => g.ruta_origen || g.ruta_destino);
        const routeStartText = document.getElementById('route-start-text');
        const routeEndText = document.getElementById('route-end-text');
        const routeStopsCountText = document.getElementById('route-stops-count-text');
        if (routeStartText && activeWithRoute?.ruta_origen) {
          routeStartText.textContent = activeWithRoute.ruta_origen;
        }
        if (routeEndText && activeWithRoute?.ruta_destino) {
          routeEndText.textContent = activeWithRoute.ruta_destino;
        }
        if (routeStopsCountText) {
          routeStopsCountText.textContent = `${total} paradas programadas`;
        }
      }

      // ==========================================
      // OPTIMIZACIÓN Y COMPRESIÓN DE FOTO EN CANVAS
      // ==========================================
      async function compressImage(file, maxWidth = 1200, maxHeight = 1200, quality = 0.75) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = (e) => {
            const img = new Image();
            img.onload = () => {
              let width = img.width;
              let height = img.height;

              if (width > height) {
                if (width > maxWidth) {
                  height = Math.round((height * maxWidth) / width);
                  width = maxWidth;
                }
              } else {
                if (height > maxHeight) {
                  width = Math.round((width * maxHeight) / height);
                  height = maxHeight;
                }
              }

              const canvas = document.createElement('canvas');
              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext('2d');
              ctx.drawImage(img, 0, 0, width, height);

              canvas.toBlob((blob) => {
                if (blob) {
                  const optimizedFile = new File([blob], `comprobante_${Date.now()}.jpg`, {
                    type: 'image/jpeg',
                    lastModified: Date.now()
                  });
                  resolve({
                    file: optimizedFile,
                    dataUrl: canvas.toDataURL('image/jpeg', quality),
                    sizeKb: Math.round(blob.size / 1024)
                  });
                } else {
                  reject(new Error('No se pudo comprimir la imagen.'));
                }
              }, 'image/jpeg', quality);
            };
            img.onerror = reject;
            img.src = e.target.result;
          };
          reader.onerror = reject;
          reader.readAsDataURL(file);
        });
      }

      // Eventos de Dropzone de Foto
      dropzonePhoto?.addEventListener('click', (e) => {
        if (e.target !== btnRetakePhoto) {
          modalPhotoInput.click();
        }
      });

      btnRetakePhoto?.addEventListener('click', (e) => {
        e.stopPropagation();
        modalPhotoInput.value = '';
        modalPhotoInput.click();
      });

      modalPhotoInput?.addEventListener('change', async (e) => {
        const file = e.target.files?.[0];
        if (!file) return;

        photoPlaceholder.classList.add('hidden');
        photoPreviewContainer.classList.remove('hidden');
        photoStatusText.textContent = 'Optimizando foto...';
        modalConfirmBtn.disabled = true;

        try {
          const result = await compressImage(file);
          currentCompressedFile = result.file;
          photoPreviewImg.src = result.dataUrl;
          photoStatusText.textContent = `Foto lista (${result.sizeKb} KB optimizada)`;
          
          photoSizeBadge.textContent = `${result.sizeKb} KB`;
          photoSizeBadge.classList.remove('hidden');

          // Habilitar confirmación de entrega
          modalConfirmBtn.disabled = false;
        } catch (err) {
          console.error('Error al optimizar imagen:', err);
          showToast('Error al procesar la imagen seleccionada', 'error');
          resetPhotoState();
        }
      });

      function resetPhotoState() {
        currentCompressedFile = null;
        if (modalPhotoInput) modalPhotoInput.value = '';
        if (photoPreviewImg) photoPreviewImg.src = '';
        photoPlaceholder?.classList.remove('hidden');
        photoPreviewContainer?.classList.add('hidden');
        photoSizeBadge?.classList.add('hidden');
        if (modalConfirmBtn) modalConfirmBtn.disabled = true;
      }

      // 6. Modal de Entrega (Bottom Sheet)
      window.openDeliveryModal = function(idGuia, destinatario, direccion, stopNumber) {
        activeModalGuiaId = idGuia;
        modalGuiaCode.textContent = `Parada #${stopNumber} &bull; Guía #${idGuia}`;
        modalDestinatario.textContent = destinatario;
        modalDireccion.textContent = direccion || 'Ubicación confirmada';
        modalRecibidoPor.value = '';
        resetPhotoState();
        deliveryModal.classList.remove('hidden');
        deliveryModal.classList.add('flex');
      };

      function closeModal() {
        deliveryModal.classList.add('hidden');
        deliveryModal.classList.remove('flex');
        activeModalGuiaId = null;
        resetPhotoState();
      }

      modalCloseBtn.addEventListener('click', closeModal);
      modalCancelBtn.addEventListener('click', closeModal);

      // Lightbox para ver fotos
      window.openLightbox = function(imgUrl, title, info) {
        lightboxImg.src = imgUrl;
        lightboxTitle.textContent = title || 'Comprobante de Entrega';
        lightboxInfo.textContent = info || '';
        lightboxModal.classList.remove('hidden');
        lightboxModal.classList.add('flex');
      };

      lightboxCloseBtn?.addEventListener('click', () => {
        lightboxModal.classList.add('hidden');
        lightboxModal.classList.remove('flex');
        lightboxImg.src = '';
      });

      lightboxModal?.addEventListener('click', (e) => {
        if (e.target === lightboxModal) {
          lightboxModal.classList.add('hidden');
          lightboxModal.classList.remove('flex');
          lightboxImg.src = '';
        }
      });

      // Confirmar Entrega (Envío con FormData a /api/chofer/entregar)
      modalConfirmBtn.addEventListener('click', async () => {
        if (!activeModalGuiaId) return;

        if (!currentCompressedFile) {
          showToast('Debes tomar o subir una foto del comprobante sin excepción', 'error');
          return;
        }

        modalConfirmBtn.disabled = true;
        const originalBtnHtml = modalConfirmBtn.innerHTML;
        modalConfirmBtn.innerHTML = `
          <svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Guardando entrega y foto...</span>
        `;

        try {
          const formData = new FormData();
          formData.append('id_guia', activeModalGuiaId);
          formData.append('recibido_por', modalRecibidoPor?.value?.trim() || '');
          formData.append('foto', currentCompressedFile);

          const res = await fetch('/api/chofer/entregar', {
            method: 'POST',
            body: formData
          });

          const data = await res.json();

          if (res.ok && data.success) {
            // Actualizar localmente
            const index = guiasData.findIndex(g => g.id_guia === activeModalGuiaId);
            if (index !== -1) {
              guiasData[index].estado = 'Entregado';
              guiasData[index].comprobante_url = data.data.comprobante_url;
              guiasData[index].recibido_por = data.data.recibido_por;
            }
            closeModal();
            renderCards();
            updateMapMarkers();
            showToast('¡Entrega confirmada y comprobante guardado!', 'success');
          } else {
            showToast(data.message || 'Error al registrar entrega', 'error');
            modalConfirmBtn.disabled = false;
            modalConfirmBtn.innerHTML = originalBtnHtml;
          }
        } catch (err) {
          console.error('Error entregando:', err);
          showToast('Error de conexión al registrar entrega', 'error');
          modalConfirmBtn.disabled = false;
          modalConfirmBtn.innerHTML = originalBtnHtml;
        }
      });

      // 7. Toast Notifications
      function showToast(msg, type = 'info') {
        toastMessage.textContent = msg;
        if (type === 'success') {
          toastIcon.innerHTML = `<svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`;
        } else if (type === 'error') {
          toastIcon.innerHTML = `<svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>`;
        } else {
          toastIcon.innerHTML = `<svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
        }

        toast.classList.remove('hidden');
        setTimeout(() => {
          toast.classList.add('hidden');
        }, 3500);
      }

      // 8. Control de Pestañas
      tabPendientes.addEventListener('click', () => {
        activeTab = 'pendientes';
        tabPendientes.className = 'py-2 text-xs font-bold rounded-lg transition-all flex items-center justify-center gap-1 bg-white text-slate-900 shadow-xs cursor-pointer';
        tabEntregados.className = 'py-2 text-xs font-semibold rounded-lg transition-all flex items-center justify-center gap-1 text-slate-600 hover:text-slate-900 cursor-pointer';
        tabTodos.className = 'py-2 text-xs font-semibold rounded-lg transition-all flex items-center justify-center gap-1 text-slate-600 hover:text-slate-900 cursor-pointer';
        renderCards();
      });

      tabEntregados.addEventListener('click', () => {
        activeTab = 'entregados';
        tabEntregados.className = 'py-2 text-xs font-bold rounded-lg transition-all flex items-center justify-center gap-1 bg-white text-slate-900 shadow-xs cursor-pointer';
        tabPendientes.className = 'py-2 text-xs font-semibold rounded-lg transition-all flex items-center justify-center gap-1 text-slate-600 hover:text-slate-900 cursor-pointer';
        tabTodos.className = 'py-2 text-xs font-semibold rounded-lg transition-all flex items-center justify-center gap-1 text-slate-600 hover:text-slate-900 cursor-pointer';
        renderCards();
      });

      tabTodos.addEventListener('click', () => {
        activeTab = 'todos';
        tabTodos.className = 'py-2 text-xs font-bold rounded-lg transition-all flex items-center justify-center gap-1 bg-white text-slate-900 shadow-xs cursor-pointer';
        tabPendientes.className = 'py-2 text-xs font-semibold rounded-lg transition-all flex items-center justify-center gap-1 text-slate-600 hover:text-slate-900 cursor-pointer';
        tabEntregados.className = 'py-2 text-xs font-semibold rounded-lg transition-all flex items-center justify-center gap-1 text-slate-600 hover:text-slate-900 cursor-pointer';
        renderCards();
      });

      // 9. Buscador y Filtro de Ciudad
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value;
        renderCards();
      });

      cityFilter?.addEventListener('change', (e) => {
        selectedCity = e.target.value;
        renderCards();
      });

      // 10. Toggle Colapsar / Expandir Mapa
      toggleMapBtn.addEventListener('click', () => {
        isMapVisible = !isMapVisible;
        if (isMapVisible) {
          mapWrapper.classList.remove('hidden');
          toggleMapText.textContent = 'Ocultar Mapa';
          toggleMapIcon.style.transform = 'rotate(0deg)';
          setTimeout(() => {
            if (map) map.invalidateSize();
          }, 200);
        } else {
          mapWrapper.classList.add('hidden');
          toggleMapText.textContent = 'Mostrar Mapa';
          toggleMapIcon.style.transform = 'rotate(180deg)';
        }
      });

      // Re-centrar mapa manualmente
      recenterMapBtn.addEventListener('click', () => {
        userHasInteractedWithMap = false;
        updateMapMarkers(true);
        showToast('Vista ajustada a toda la ruta', 'info');
      });

      // 11. Live Sync en Segundo Plano (cada 4.5 segundos)
      async function fetchLatestGuias(isManual = false) {
        if (isManual) {
          refreshIcon.classList.add('animate-spin');
        }

        try {
          const res = await fetch('/api/chofer/guias');
          if (res.status === 401 || res.status === 403) {
            window.location.href = '/login';
            return;
          }
          if (res.ok) {
            const data = await res.json();
            if (data.success && Array.isArray(data.data)) {
              guiasData = data.data;
              renderCards();
              // No forzar fitBounds en polling para no resetear el zoom manual del chofer
              updateMapMarkers(isManual);
              if (isManual) {
                showToast('Hoja de ruta actualizada', 'info');
              }
            }
          }
        } catch (err) {
          console.warn('[LiveSync Chofer Error]:', err);
        } finally {
          if (isManual) {
            setTimeout(() => {
              refreshIcon.classList.remove('animate-spin');
            }, 600);
          }
        }
      }

      refreshBtn?.addEventListener('click', () => {
        fetchLatestGuias(true);
      });

      // Protección contra bfcache (si el usuario cierra sesión y pulsa "Atrás" en el navegador)
      window.addEventListener('pageshow', (event) => {
        if (event.persisted) {
          window.location.reload();
        }
      });

      // Iniciar mapa y renders
      initMap();
      renderCards();

      // Intervalo de Live Sync
      setInterval(() => {
        fetchLatestGuias(false);
      }, 4500);
    </script>
  </body>
</html>
