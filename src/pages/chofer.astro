              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
        </div>

        <!-- Contenedor Imprimible -->
        <div id="chofer-listin-print-wrapper" class="bg-white p-2 text-black font-sans text-xs">
          <div class="border-b-2 border-black pb-2 mb-3 flex items-center justify-between">
            <div>
              <h2 class="text-base font-black tracking-wider uppercase">ENVÍAS C.A. • MANIFIESTO DE DESPACHO</h2>
              <p class="text-[11px] font-bold">Conductor: {targetChoferNombre}</p>
            </div>
            <div class="text-right text-[11px] font-mono font-bold">
              <p>Fecha: {new Date().toLocaleDateString('es-VE')}</p>
            </div>
          </div>

          <div class="grid grid-cols-4 gap-2 mb-3 p-2 bg-slate-100 border border-black/20 text-center font-bold">
            <div>Total Guías: <span id="chofer-listin-total-guias" class="font-mono">0</span></div>
            <div>Total Piezas: <span id="chofer-listin-total-piezas" class="font-mono">0</span></div>
            <div>Volumen: <span id="chofer-listin-total-volumen" class="font-mono">0 ft³</span></div>
            <div>Destinos: <span id="chofer-listin-total-destinos" class="font-mono">0</span></div>
          </div>

          <table class="w-full border-collapse border border-black text-[11px]">
            <thead>
              <tr class="bg-slate-200 border-b border-black">
                <th class="py-1 px-1 border-r border-black font-extrabold text-center">GUÍA</th>
                <th class="py-1 px-1 border-r border-black font-extrabold text-center">PZA</th>
                <th class="py-1 px-1 border-r border-black font-extrabold text-center">FT³</th>
                <th class="py-1 px-1.5 border-r-2 border-black font-extrabold text-left">DESTINO</th>
                <th class="py-1 px-1 border-r border-black font-extrabold text-center">GUÍA</th>
                <th class="py-1 px-1 border-r border-black font-extrabold text-center">PZA</th>
                <th class="py-1 px-1 border-r border-black font-extrabold text-center">FT³</th>
                <th class="py-1 px-1.5 font-extrabold text-left">DESTINO</th>
              </tr>
            </thead>
            <tbody id="chofer-listin-tbody">
