              <div class="relative w-full bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all text-center select-none overflow-hidden cursor-pointer">
                <input
                  type="file"
                  id="modal-delivery-photo-gallery"
                  accept="image/*"
                  multiple
                  class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20"
                />
                <svg class="w-5 h-5 text-indigo-600 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <div class="pointer-events-none">
                  <p class="text-xs font-bold">De Galería</p>
                  <p class="text-[9px] text-slate-500">Múltiples</p>
