    <!-- ========================================== -->
    <!-- 7. SCRIPT CLIENTE DESACOPLADO Y MODULAR    -->
    <!-- ========================================== -->
    <script define:vars={{ initialGuias, targetChoferId }}>
      // ----------------------------------------------------
      // ESTADO GLOBAL
      // ----------------------------------------------------
      let currentChoferId = targetChoferId;
      let guiasData = initialGuias || [];
      let activeTab = 'pendientes';
      let searchQuery = '';
      let selectedCity = '';
      let activeModalGuiaId = null;
      let modalDeliveryMode = 'success';
      let currentCompressedBlob = null;
      let sessionScannedCount = 0;

      // Elementos Toast
      const toastEl = document.getElementById('toast');
      const toastIconEl = document.getElementById('toast-icon');
      const toastMsgEl = document.getElementById('toast-message');
      let toastTimeout = null;

      function showToast(message, type = 'info') {
        if (!toastEl || !toastMsgEl) return;
        if (toastTimeout) clearTimeout(toastTimeout);

        toastMsgEl.textContent = message;
        if (type === 'success') {
          toastEl.className = 'fixed bottom-4 left-1/2 -translate-x-1/2 z-50 bg-emerald-600 text-white px-4 py-2.5 rounded-2xl shadow-xl text-xs font-bold flex items-center gap-2 animate-fadeIn';
          if (toastIconEl) toastIconEl.innerHTML = '<svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>';
        } else if (type === 'error') {
          toastEl.className = 'fixed bottom-4 left-1/2 -translate-x-1/2 z-50 bg-rose-600 text-white px-4 py-2.5 rounded-2xl shadow-xl text-xs font-bold flex items-center gap-2 animate-fadeIn';
          if (toastIconEl) toastIconEl.innerHTML = '<svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>';
        } else {
          toastEl.className = 'fixed bottom-4 left-1/2 -translate-x-1/2 z-50 bg-slate-900 text-white px-4 py-2.5 rounded-2xl shadow-xl text-xs font-bold flex items-center gap-2 animate-fadeIn';
          if (toastIconEl) toastIconEl.innerHTML = '<svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
        }

        toastEl.classList.remove('hidden');
        toastTimeout = setTimeout(() => {
          toastEl?.classList.add('hidden');
        }, 4000);
      }

      function formatPhoneForWhatsApp(phone) {
        if (!phone) return '';
        let cleaned = phone.replace(/[^0-9]/g, '');
        if (cleaned.startsWith('0')) {
          cleaned = '58' + cleaned.substring(1);
        } else if (cleaned.length === 10 && !cleaned.startsWith('58')) {
          cleaned = '58' + cleaned;
        }
        return cleaned;
      }

      // ====================================================
      // MOTOR DE COMPRESIÓN CANVAS HTML5 (ZERO-FAIL)
      // ====================================================
      function compressImage(file: File, maxWidth = 1280, maxHeight = 1600, quality = 0.8): Promise<{ blob: Blob | null, dataUrl: string, sizeKb: number }> {
        return new Promise((resolve) => {
          if (!file) {
            resolve({ blob: null, dataUrl: '', sizeKb: 0 });
            return;
          }

          // Safety timeout para nunca colgar la UI
          const timer = setTimeout(() => {
            console.warn('[Compress Timeout]: Usando archivo original directo.');
            resolve({ blob: file, dataUrl: '', sizeKb: Math.round(file.size / 1024) });
          }, 2500);

          const reader = new FileReader();
          reader.onload = (e) => {
            const rawDataUrl = (e.target?.result || '') as string;
            const img = new Image();
            img.onload = () => {
              clearTimeout(timer);
              try {
                let width = img.naturalWidth || img.width;
                let height = img.naturalHeight || img.height;

                if (width > maxWidth || height > maxHeight) {
                  if (width > height) {
                    height = Math.round((height * maxWidth) / width);
                    width = maxWidth;
                  } else {
                    width = Math.round((width * maxHeight) / height);
                    height = maxHeight;
                  }
                }

                const canvas = document.createElement('canvas');
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext('2d');
                if (!ctx) {
                  resolve({ blob: file, dataUrl: rawDataUrl, sizeKb: Math.round(file.size / 1024) });
                  return;
                }
                ctx.drawImage(img, 0, 0, width, height);

                const finalDataUrl = canvas.toDataURL('image/jpeg', quality);
                canvas.toBlob((blob) => {
                  if (blob) {
                    resolve({ blob: blob, dataUrl: finalDataUrl, sizeKb: Math.round(blob.size / 1024) });
                  } else {
                    resolve({ blob: file, dataUrl: finalDataUrl || rawDataUrl, sizeKb: Math.round(file.size / 1024) });
                  }
                }, 'image/jpeg', quality);
              } catch (canvasErr) {
                console.warn('[Canvas Compress Warning]:', canvasErr);
                resolve({ blob: file, dataUrl: rawDataUrl, sizeKb: Math.round(file.size / 1024) });
              }
            };
            img.onerror = () => {
              clearTimeout(timer);
              resolve({ blob: file, dataUrl: rawDataUrl, sizeKb: Math.round(file.size / 1024) });
            };
            img.src = rawDataUrl;
          };
          reader.onerror = () => {
            clearTimeout(timer);
            resolve({ blob: file, dataUrl: '', sizeKb: Math.round(file.size / 1024) });
          };
          reader.readAsDataURL(file);
        });
      }

      // ====================================================
      // MÓDULO 1: ESCÁNER Y SUBIDA DE GUÍAS FÍSICAS
      // ====================================================
      const heroCameraInput = document.getElementById('hero-camera-input') as HTMLInputElement;
      const heroGalleryInput = document.getElementById('hero-gallery-input') as HTMLInputElement;
      const modalScanCameraInput = document.getElementById('modal-scan-camera-input') as HTMLInputElement;
      const modalScanGalleryInput = document.getElementById('modal-scan-gallery-input') as HTMLInputElement;
      const scanModal = document.getElementById('scan-modal');
      const scanModalCloseBtn = document.getElementById('scan-modal-close-btn');
      const btnHeaderScan = document.getElementById('btn-header-scan');

      let currentScanTargetMode = 'hero';

      function openScanModal() {
        scanModal?.classList.remove('hidden');
        scanModal?.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
      function closeScanModal() {
        scanModal?.classList.add('hidden');
        scanModal?.classList.remove('flex');
        document.body.style.overflow = '';
      }

      scanModalCloseBtn?.addEventListener('click', closeScanModal);
      btnHeaderScan?.addEventListener('click', openScanModal);
      scanModal?.addEventListener('click', (e) => {
        if (e.target === scanModal) closeScanModal();
      });

      // Manejador centralizado de archivos seleccionados
      async function handleScanFiles(files: File[]) {
        if (!files || files.length === 0) return;

        const total = files.length;
        const nowScan = new Date();
        const pad2 = (n: number) => n.toString().padStart(2, '0');
        const scanLoteId = `chofer_${nowScan.getFullYear()}${pad2(nowScan.getMonth()+1)}${pad2(nowScan.getDate())}_${pad2(nowScan.getHours())}${pad2(nowScan.getMinutes())}`;

        const isModal = currentScanTargetMode === 'modal';
        const liveSection = document.getElementById(isModal ? 'modal-scan-live-section' : 'hero-scan-live-section');
        const progressBar = document.getElementById(isModal ? 'modal-progress-bar' : 'hero-progress-bar');
        const progressLabel = document.getElementById(isModal ? 'modal-progress-label' : 'hero-progress-label');
        const progressCount = document.getElementById(isModal ? 'modal-progress-count' : 'hero-progress-count');
        const galleryGrid = document.getElementById(isModal ? 'modal-gallery-grid' : 'hero-gallery-grid');
        const galleryCount = document.getElementById(isModal ? 'modal-gallery-count' : 'hero-gallery-count');

        liveSection?.classList.remove('hidden');
        if (progressBar) progressBar.style.width = '0%';
        if (progressLabel) progressLabel.textContent = `Procesando ${total} foto${total !== 1 ? 's' : ''}...`;
        if (progressCount) progressCount.textContent = `0 / ${total}`;
        showToast(`Procesando ${total} foto(s)...`, 'info');

        let uploadedOk = 0;
        let processed = 0;

        for (let i = 0; i < files.length; i++) {
          const file = files[i];
          sessionScannedCount++;
          const itemIndex = sessionScannedCount;

          // Crear miniatura temporal en el DOM
          const thumbDiv = document.createElement('div');
          thumbDiv.id = `scan-thumb-${itemIndex}`;
          thumbDiv.className = 'relative aspect-square rounded-xl overflow-hidden bg-slate-100 border-2 border-slate-200 transition-all';
          thumbDiv.innerHTML = `
            <div id="scan-thumb-overlay-${itemIndex}" class="absolute inset-0 bg-black/50 flex items-center justify-center">
              <svg class="w-5 h-5 text-white animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
            </div>
          `;
          if (galleryGrid) galleryGrid.prepend(thumbDiv);

          try {
            // Optimización con Canvas HTML5
            const comp = await compressImage(file, 1280, 1600, 0.8);

            if (comp.dataUrl) {
              const imgEl = document.createElement('img');
              imgEl.src = comp.dataUrl;
              imgEl.className = 'w-full h-full object-cover';
              thumbDiv.prepend(imgEl);
            }

            const formData = new FormData();
            if (comp.blob) {
              formData.append('foto', comp.blob, file.name || 'escaneo.jpg');
            } else {
              formData.append('foto', file, file.name || 'escaneo.jpg');
            }
            if (comp.dataUrl) {
              formData.append('foto_base64', comp.dataUrl);
            }
            formData.append('lote_id', scanLoteId);

            const res = await fetch('/api/escaneos', {
              method: 'POST',
              body: formData,
              credentials: 'include'
            });
            const data = await res.json().catch(() => ({ success: false, message: 'Error de respuesta del servidor' }));

            const overlay = document.getElementById(`scan-thumb-overlay-${itemIndex}`);
            if (res.ok && data.success) {
              uploadedOk++;
              thumbDiv.classList.replace('border-slate-200', 'border-emerald-400');
              if (overlay) {
                overlay.innerHTML = `<svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>`;
                setTimeout(() => overlay.classList.add('opacity-0'), 700);
              }
            } else {
              thumbDiv.classList.replace('border-slate-200', 'border-rose-400');
              if (overlay) {
                overlay.innerHTML = `<svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>`;
              }
              showToast(`Error: ${data.message || 'Error al guardar foto'}`, 'error');
            }
          } catch (err) {
            console.error('Error procesando escaneo:', err);
            const overlay = document.getElementById(`scan-thumb-overlay-${itemIndex}`);
            thumbDiv.classList.replace('border-slate-200', 'border-rose-400');
            if (overlay) {
              overlay.innerHTML = `<svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>`;
            }
            showToast('Error de red al subir la foto', 'error');
          }

          processed++;
          const pct = Math.round((processed / total) * 100);
          if (progressBar) progressBar.style.width = `${pct}%`;
          if (progressCount) progressCount.textContent = `${processed} / ${total}`;
        }

        if (progressLabel) progressLabel.textContent = `¡${uploadedOk} de ${total} guías cargadas con éxito!`;
        if (galleryCount) galleryCount.textContent = `${galleryGrid?.children.length || 0} subidas`;
        if (uploadedOk > 0) {
          showToast(`¡${uploadedOk} foto(s) enviada(s) a Logística!`, 'success');
        }
      }

      // Event listeners seguros y asíncronos para los inputs de escaneo
      async function onFileInputChange(e: Event, mode: string) {
        const input = e.target as HTMLInputElement;
        const files = input.files ? Array.from(input.files) : [];
        if (files.length === 0) return;
        currentScanTargetMode = mode;
        try {
          await handleScanFiles(files);
        } catch (err) {
          console.error('Error en onFileInputChange:', err);
        } finally {
          input.value = '';
        }
      }

      heroCameraInput?.addEventListener('change', (e) => onFileInputChange(e, 'hero'));
      heroGalleryInput?.addEventListener('change', (e) => onFileInputChange(e, 'hero'));
      modalScanCameraInput?.addEventListener('change', (e) => onFileInputChange(e, 'modal'));
      modalScanGalleryInput?.addEventListener('change', (e) => onFileInputChange(e, 'modal'));

      // ====================================================
      // MÓDULO 2: CONFIRMACIÓN DE ENTREGA E INCIDENCIA
      // ====================================================
      const deliveryModal = document.getElementById('delivery-modal');
      const modalCloseBtn = document.getElementById('modal-close-btn');
      const modalCancelBtn = document.getElementById('modal-cancel-btn');
      const modalConfirmBtn = document.getElementById('modal-confirm-btn');
      const modalIncidentSubmitBtn = document.getElementById('modal-incident-submit-btn');
      const modalTabSuccessBtn = document.getElementById('modal-tab-success-btn');
      const modalTabIncidentBtn = document.getElementById('modal-tab-incident-btn');
      const modalPanelSuccess = document.getElementById('modal-panel-success');
      const modalPanelIncident = document.getElementById('modal-panel-incident');
      const modalTitleText = document.getElementById('modal-title-text');
      const modalGuiaCode = document.getElementById('modal-guia-code');
      const modalDestinatario = document.getElementById('modal-destinatario');
      const modalDireccion = document.getElementById('modal-direccion');
      const modalRecibidoPor = document.getElementById('modal-recibido-por');
      const modalIncidentNote = document.getElementById('modal-incident-note');
      const modalDeliveryPhotoInput = document.getElementById('modal-delivery-photo-input');
      const photoPlaceholder = document.getElementById('photo-placeholder');
      const photoPreviewContainer = document.getElementById('photo-preview-container');
      const photoPreviewImg = document.getElementById('photo-preview-img');
      const photoSizeBadge = document.getElementById('photo-size-badge');
      const photoStatusText = document.getElementById('photo-status-text');

      function setDeliveryModalMode(mode) {
        modalDeliveryMode = mode;
        if (mode === 'success') {
          if (modalTabSuccessBtn) modalTabSuccessBtn.className = 'py-2 px-2 text-xs font-bold rounded-xl transition-all flex items-center justify-center gap-1.5 bg-white text-slate-900 shadow-xs cursor-pointer';
          if (modalTabIncidentBtn) modalTabIncidentBtn.className = 'py-2 px-2 text-xs font-semibold rounded-xl transition-all flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900 cursor-pointer';
          modalPanelSuccess?.classList.remove('hidden');
          modalPanelIncident?.classList.add('hidden');
          modalConfirmBtn?.classList.remove('hidden');
          modalIncidentSubmitBtn?.classList.add('hidden');
          if (modalTitleText) modalTitleText.textContent = 'Confirmar Entrega Realizada';
        } else {
          if (modalTabIncidentBtn) modalTabIncidentBtn.className = 'py-2 px-2 text-xs font-bold rounded-xl transition-all flex items-center justify-center gap-1.5 bg-white text-rose-900 shadow-xs cursor-pointer';
          if (modalTabSuccessBtn) modalTabSuccessBtn.className = 'py-2 px-2 text-xs font-semibold rounded-xl transition-all flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900 cursor-pointer';
          modalPanelSuccess?.classList.add('hidden');
          modalPanelIncident?.classList.remove('hidden');
          modalConfirmBtn?.classList.add('hidden');
          modalIncidentSubmitBtn?.classList.remove('hidden');
          if (modalTitleText) modalTitleText.textContent = 'Reportar Incidencia de Entrega';
        }
      }

      modalTabSuccessBtn?.addEventListener('click', () => setDeliveryModalMode('success'));
      modalTabIncidentBtn?.addEventListener('click', () => setDeliveryModalMode('incident'));

      function resetDeliveryPhotoState() {
        currentCompressedBlob = null;
        if (modalDeliveryPhotoInput) modalDeliveryPhotoInput.value = '';
        if (photoPreviewImg) photoPreviewImg.src = '';
        photoPlaceholder?.classList.remove('hidden');
        photoPreviewContainer?.classList.add('hidden');
        photoSizeBadge?.classList.add('hidden');
        if (modalConfirmBtn) modalConfirmBtn.disabled = true;
      }

      window.openDeliveryModal = function(idGuia, destinatario, direccion, stopNumber) {
        activeModalGuiaId = idGuia;
        if (modalGuiaCode) modalGuiaCode.textContent = `Parada #${stopNumber} • Guía #${idGuia}`;
        if (modalDestinatario) modalDestinatario.textContent = destinatario;
        if (modalDireccion) modalDireccion.textContent = direccion || 'Ubicación confirmada';
        if (modalRecibidoPor) modalRecibidoPor.value = '';
        if (modalIncidentNote) modalIncidentNote.value = '';
        setDeliveryModalMode('success');
        resetDeliveryPhotoState();
        deliveryModal?.classList.remove('hidden');
        deliveryModal?.classList.add('flex');
      };

      function closeDeliveryModal() {
        deliveryModal?.classList.add('hidden');
        deliveryModal?.classList.remove('flex');
        activeModalGuiaId = null;
        resetDeliveryPhotoState();
      }

      modalCloseBtn?.addEventListener('click', closeDeliveryModal);
      modalCancelBtn?.addEventListener('click', closeDeliveryModal);

      // Manejo de la foto de entrega
      modalDeliveryPhotoInput?.addEventListener('change', async (e) => {
        const file = e.target.files?.[0];
        if (!file) return;

        photoPlaceholder?.classList.add('hidden');
        photoPreviewContainer?.classList.remove('hidden');
        if (photoStatusText) photoStatusText.textContent = 'Optimizando foto...';
        if (modalConfirmBtn) modalConfirmBtn.disabled = true;

        try {
          const result = await compressImage(file, 1200, 1600, 0.75);
          currentCompressedBlob = result.blob;
          if (photoPreviewImg) photoPreviewImg.src = result.dataUrl;
          if (photoStatusText) photoStatusText.textContent = `Foto lista (${result.sizeKb} KB optimizada)`;
          if (photoSizeBadge) {
            photoSizeBadge.textContent = `${result.sizeKb} KB`;
            photoSizeBadge.classList.remove('hidden');
          }
          if (modalConfirmBtn) modalConfirmBtn.disabled = false;
        } catch (err) {
          console.error('Error optimizando foto de entrega:', err);
          showToast('Error al procesar la foto', 'error');
          resetDeliveryPhotoState();
        }
      });

      // Submit Confirmar Entrega
      modalConfirmBtn?.addEventListener('click', async () => {
        if (!activeModalGuiaId) return;
        if (!currentCompressedBlob) {
          showToast('Debes tomar o subir una foto del comprobante sin excepción', 'error');
          return;
        }

        modalConfirmBtn.disabled = true;
        const originalHtml = modalConfirmBtn.innerHTML;
        modalConfirmBtn.innerHTML = `
          <svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          <span>Guardando...</span>
        `;

        try {
          const formData = new FormData();
          formData.append('id_guia', activeModalGuiaId);
          formData.append('tipo_resultado', 'entregado');
          formData.append('recibido_por', modalRecibidoPor?.value?.trim() || '');
          formData.append('foto', currentCompressedBlob, 'comprobante.jpg');

          const res = await fetch('/api/chofer/entregar', {
            method: 'POST',
            body: formData
          });
          const data = await res.json();

          if (res.ok && data.success) {
            const idx = guiasData.findIndex(g => g.id_guia === activeModalGuiaId);
            if (idx !== -1) {
              guiasData[idx].estado = 'Entregado';
              guiasData[idx].comprobante_url = data.data.comprobante_url;
              guiasData[idx].recibido_por = data.data.recibido_por;
            }
            closeDeliveryModal();
            renderCards();
            updateMapMarkers();
            showToast('&iexcl;Entrega confirmada y comprobante guardado!', 'success');
          } else {
            showToast(data.message || 'Error al registrar entrega', 'error');
            modalConfirmBtn.disabled = false;
            modalConfirmBtn.innerHTML = originalHtml;
          }
        } catch (err) {
          console.error('Error confirmando entrega:', err);
          showToast('Error de red al guardar entrega', 'error');
          modalConfirmBtn.disabled = false;
          modalConfirmBtn.innerHTML = originalHtml;
        }
      });

      // Submit Incidencia
      modalIncidentSubmitBtn?.addEventListener('click', async () => {
        if (!activeModalGuiaId) return;
        const note = modalIncidentNote?.value?.trim();
        if (!note) {
          showToast('Debes ingresar el motivo de la incidencia', 'error');
          return;
        }

        modalIncidentSubmitBtn.disabled = true;
        try {
          const formData = new FormData();
          formData.append('id_guia', activeModalGuiaId);
          formData.append('tipo_resultado', 'no_entregado');
          formData.append('nota_incidencia', note);

          const res = await fetch('/api/chofer/entregar', {
            method: 'POST',
            body: formData
          });
          const data = await res.json();

          if (res.ok && data.success) {
            const idx = guiasData.findIndex(g => g.id_guia === activeModalGuiaId);
            if (idx !== -1) {
              guiasData[idx].estado = 'No entregado';
              guiasData[idx].recibido_por = note;
            }
            closeDeliveryModal();
            renderCards();
            updateMapMarkers();
            showToast('Incidencia registrada correctamente', 'info');
          } else {
            showToast(data.message || 'Error al registrar incidencia', 'error');
          }
        } catch (err) {
          showToast('Error de red al guardar incidencia', 'error');
        } finally {
          modalIncidentSubmitBtn.disabled = false;
        }
      });

      // Selección rápida de motivo de incidencia
      document.querySelectorAll('#incident-reasons-grid .incident-opt').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const reason = (e.currentTarget).getAttribute('data-reason');
          if (modalIncidentNote && reason) {
            modalIncidentNote.value = reason;
          }
        });
      });

      // ====================================================
      // MÓDULO 3: HOJA DE RUTA, PARADAS Y MAPA LEAFLET
      // ====================================================
      const cardsContainer = document.getElementById('cards-container');
      const emptyState = document.getElementById('empty-state');
      const searchInput = document.getElementById('search-input');
      const cityFilter = document.getElementById('city-filter');
      const tabPendientes = document.getElementById('tab-pendientes');
      const tabEntregados = document.getElementById('tab-entregados');
      const tabNoEntregados = document.getElementById('tab-no-entregados');
      const tabTodos = document.getElementById('tab-todos');
      const badgeTabPendientes = document.getElementById('badge-tab-pendientes');
      const badgeTabEntregados = document.getElementById('badge-tab-entregados');
      const badgeTabNoEntregados = document.getElementById('badge-tab-no-entregados');
      const badgeTabTodos = document.getElementById('badge-tab-todos');
      const statPendientes = document.getElementById('stat-pendientes');
      const statEntregados = document.getElementById('stat-entregados');
      const statNoEntregados = document.getElementById('stat-no-entregados');
      const statTotal = document.getElementById('stat-total');
      const progressText = document.getElementById('progress-text');
      const progressBarFill = document.getElementById('progress-bar-fill');

      let map = null;
      let markersLayer = null;
      let routePolyline = null;
      let isMapVisible = true;

      function updateStats() {
        const total = guiasData.length;
        const entregados = guiasData.filter(g => g.estado === 'Entregado').length;
        const noEntregados = guiasData.filter(g => g.estado === 'No entregado').length;
        const pendientes = guiasData.filter(g => g.estado !== 'Entregado' && g.estado !== 'No entregado').length;
        const pct = total > 0 ? Math.round((entregados / total) * 100) : 0;

        if (statPendientes) statPendientes.textContent = pendientes;
        if (statEntregados) statEntregados.textContent = entregados;
        if (statNoEntregados) statNoEntregados.textContent = noEntregados;
        if (statTotal) statTotal.textContent = total;

        if (badgeTabPendientes) badgeTabPendientes.textContent = pendientes;
        if (badgeTabEntregados) badgeTabEntregados.textContent = entregados;
        if (badgeTabNoEntregados) badgeTabNoEntregados.textContent = noEntregados;
        if (badgeTabTodos) badgeTabTodos.textContent = total;

        if (progressText) progressText.textContent = `${entregados} de ${total} paradas (${pct}%)`;
        if (progressBarFill) progressBarFill.style.width = `${pct}%`;
      }

      function getFilteredGuias() {
        const q = searchQuery.toLowerCase().trim();
        return guiasData.filter(g => {
          const matchTab = 
            activeTab === 'todos' ? true :
            activeTab === 'entregados' ? g.estado === 'Entregado' :
            activeTab === 'no_entregados' ? g.estado === 'No entregado' :
            (g.estado !== 'Entregado' && g.estado !== 'No entregado');

          const matchCity = !selectedCity || g.ciudad_destino === selectedCity;
          const matchQuery = !q || 
            (g.id_guia && g.id_guia.toLowerCase().includes(q)) ||
            (g.destinatario && g.destinatario.toLowerCase().includes(q)) ||
            (g.direccion_referencia && g.direccion_referencia.toLowerCase().includes(q)) ||
            (g.telefono_principal && g.telefono_principal.includes(q));

          return matchTab && matchCity && matchQuery;
        });
      }

      function renderCards() {
        updateStats();
        if (!cardsContainer) return;

        const filtered = getFilteredGuias();
        if (filtered.length === 0) {
          cardsContainer.innerHTML = '';
          emptyState?.classList.remove('hidden');
          return;
        }

        emptyState?.classList.add('hidden');

        cardsContainer.innerHTML = filtered.map((guia, index) => {
          const stopNum = guia.orden_ruta && guia.orden_ruta > 0 ? guia.orden_ruta : (index + 1);
          const isDelivered = guia.estado === 'Entregado';
          const isIncident = guia.estado === 'No entregado';
          const isPending = !isDelivered && !isIncident;

          const phoneClean = formatPhoneForWhatsApp(guia.telefono_principal);
          const msgWhatsApp = encodeURIComponent(`Hola ${guia.destinatario}, soy tu chofer de Envías C.A. Voy en camino a entregarte tu paquete (Guía #${guia.id_guia}).`);
          const linkWhatsApp = `https://wa.me/${phoneClean}?text=${msgWhatsApp}`;

          let gmapsUrl = '';
          let wazeUrl = '';
          if (guia.gps_confirmado && guia.gps_latitud && guia.gps_longitud) {
            gmapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${guia.gps_latitud},${guia.gps_longitud}`;
            wazeUrl = `https://waze.com/ul?ll=${guia.gps_latitud},${guia.gps_longitud}&navigate=yes`;
          } else {
            const destQuery = encodeURIComponent(`${guia.direccion_referencia || ''} ${guia.ciudad_destino || ''} Venezuela`);
            gmapsUrl = `https://www.google.com/maps/search/?api=1&query=${destQuery}`;
            wazeUrl = `https://waze.com/ul?q=${destQuery}&navigate=yes`;
          }

          let badgeStatusHtml = '';
          if (isDelivered) {
            badgeStatusHtml = `<span class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 text-[10px] font-bold border border-emerald-200">Entregado</span>`;
          } else if (isIncident) {
            badgeStatusHtml = `<span class="px-2 py-0.5 rounded-md bg-rose-50 text-rose-800 text-[10px] font-bold border border-rose-200">No entregó</span>`;
          } else {
            badgeStatusHtml = `<span class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 text-[10px] font-bold border border-amber-200">Pendiente</span>`;
          }

          return `
            <div class="bg-white rounded-2xl border border-slate-200/90 p-4 shadow-sm space-y-3 transition-all ${isDelivered ? 'opacity-75 bg-slate-50/50' : ''}">
              <!-- Fila Superior: Parada, Guía y Estado -->
              <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-xl ${isDelivered ? 'bg-emerald-600' : isIncident ? 'bg-rose-600' : 'bg-slate-900'} text-white flex items-center justify-center font-extrabold text-xs shrink-0 shadow-xs">
                    #${stopNum}
                  </div>
                  <div>
                    <span class="font-mono font-bold text-xs text-slate-900">Guía #${guia.id_guia}</span>
                    <span class="text-[10px] text-slate-400 font-medium ml-1">&bull; ${guia.piezas || 1} pza(s)</span>
                  </div>
                </div>
                ${badgeStatusHtml}
              </div>

              <!-- Info Destinatario -->
              <div class="space-y-1 text-xs">
                <p class="font-bold text-slate-900 text-sm leading-snug">${guia.destinatario}</p>
                <div class="flex items-center gap-1.5 text-slate-500 font-medium">
                  <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  <span class="truncate">${guia.ciudad_destino}${guia.direccion_referencia ? ' &bull; ' + guia.direccion_referencia : ''}</span>
                </div>
                ${guia.hora_disponible ? `
                  <p class="text-[10px] text-indigo-700 font-bold bg-indigo-50 px-2 py-0.5 rounded-md inline-block">
                    Horario: Hasta las ${guia.hora_disponible}
                  </p>
                ` : ''}
              </div>

              <!-- Botones de Acción (Navegación, WhatsApp y Confirmación) -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 pt-1 border-t border-slate-100">
                <!-- WhatsApp -->
                <a 
                  href="${linkWhatsApp}" 
                  target="_blank" 
                  class="tap-active p-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 text-center font-bold text-[11px] flex items-center justify-center gap-1 transition-colors"
                >
                  <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.585 1.961.947 3.224.947 3.182 0 5.768-2.586 5.768-5.766 0-3.18-2.586-5.766-5.766-5.766zm9.969 5.828c0 5.518-4.482 10-10 10-1.748 0-3.385-.45-4.818-1.237l-5.182 1.409 1.433-5.068c-.89-1.488-1.433-3.232-1.433-5.104 0-5.518 4.482-10 10-10s10 4.482 10 10z"/></svg>
                  <span>WhatsApp</span>
                </a>

                <!-- Google Maps -->
                <a 
                  href="${gmapsUrl}" 
                  target="_blank" 
                  class="tap-active p-2 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-800 border border-indigo-200 text-center font-bold text-[11px] flex items-center justify-center gap-1 transition-colors"
                >
                  <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                  <span>Google Maps</span>
                </a>

                <!-- Waze -->
                <a 
                  href="${wazeUrl}" 
                  target="_blank" 
                  class="tap-active p-2 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-800 border border-sky-200 text-center font-bold text-[11px] flex items-center justify-center gap-1 transition-colors"
                >
                  <svg class="w-3.5 h-3.5 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                  <span>Waze</span>
                </a>

                <!-- Botón de Estado / Entrega -->
                ${isPending ? `
                  <button 
                    type="button" 
                    onclick="window.openDeliveryModal('${guia.id_guia}', '${guia.destinatario.replace(/'/g, "\\'")}', '${(guia.direccion_referencia || '').replace(/'/g, "\\'")}', ${stopNum})" 
                    class="tap-active p-2 rounded-xl bg-slate-900 hover:bg-black text-white text-center font-bold text-[11px] flex items-center justify-center gap-1 transition-all cursor-pointer shadow-xs"
                  >
                    <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                    <span>Entregar</span>
                  </button>
                ` : isDelivered && guia.comprobante_url ? `
                  <button 
                    type="button" 
                    onclick="window.openLightbox('${guia.comprobante_url}', 'Guía #${guia.id_guia}', '${guia.destinatario.replace(/'/g, "\\'")}', '${guia.id_guia}')" 
                    class="tap-active p-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-center font-bold text-[11px] flex items-center justify-center gap-1 cursor-pointer"
                  >
                    <svg class="w-3.5 h-3.5 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    <span>Comprobante</span>
                  </button>
                ` : `
                  <button 
                    type="button" 
                    onclick="window.openDeliveryModal('${guia.id_guia}', '${guia.destinatario.replace(/'/g, "\\'")}', '${(guia.direccion_referencia || '').replace(/'/g, "\\'")}', ${stopNum})" 
                    class="tap-active p-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-center font-bold text-[11px] flex items-center justify-center gap-1 cursor-pointer"
                  >
                    <span>Actualizar</span>
                  </button>
                `}
              </div>
            </div>
          `;
        }).join('');
      }

      function updateTabsUI() {
        const tabs = [
          { id: 'tab-pendientes', key: 'pendientes' },
          { id: 'tab-entregados', key: 'entregados' },
          { id: 'tab-no-entregados', key: 'no_entregados' },
          { id: 'tab-todos', key: 'todos' }
        ];

        tabs.forEach(t => {
          const btn = document.getElementById(t.id);
          if (!btn) return;
          if (activeTab === t.key) {
            btn.className = 'py-2 text-[11px] font-bold rounded-lg transition-all flex items-center justify-center gap-1 bg-white text-slate-900 shadow-xs cursor-pointer';
          } else {
            btn.className = 'py-2 text-[11px] font-semibold rounded-lg transition-all flex items-center justify-center gap-1 text-slate-600 hover:text-slate-900 cursor-pointer';
          }
        });
      }

      tabPendientes?.addEventListener('click', () => { activeTab = 'pendientes'; updateTabsUI(); renderCards(); });
      tabEntregados?.addEventListener('click', () => { activeTab = 'entregados'; updateTabsUI(); renderCards(); });
      tabNoEntregados?.addEventListener('click', () => { activeTab = 'no_entregados'; updateTabsUI(); renderCards(); });
      tabTodos?.addEventListener('click', () => { activeTab = 'todos'; updateTabsUI(); renderCards(); });

      searchInput?.addEventListener('input', (e) => {
        searchQuery = (e.target).value;
        renderCards();
      });

      cityFilter?.addEventListener('change', (e) => {
        selectedCity = (e.target).value;
        renderCards();
      });

      // Inicialización segura del mapa Leaflet
      function initMap() {
        try {
          if (typeof L === 'undefined') return;
          const mapContainer = document.getElementById('route-map');
          if (!mapContainer || map) return;

          map = L.map('route-map', { zoomControl: true, attributionControl: false }).setView([10.0808, -69.3756], 12);
          L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
            maxZoom: 19,
            subdomains: 'abcd'
          }).addTo(map);

          markersLayer = L.layerGroup().addTo(map);
          updateMapMarkers();
        } catch (err) {
          console.warn('[Map Init Warning]:', err);
        }
      }

      function updateMapMarkers() {
        if (!map || !markersLayer || typeof L === 'undefined') return;
        markersLayer.clearLayers();

        const latLngs = [];
        guiasData.forEach((g, idx) => {
          if (g.gps_confirmado && g.gps_latitud && g.gps_longitud) {
            const lat = parseFloat(g.gps_latitud);
            const lng = parseFloat(g.gps_longitud);
            if (!isNaN(lat) && !isNaN(lng)) {
              const stopNum = g.orden_ruta && g.orden_ruta > 0 ? g.orden_ruta : (idx + 1);
              const isDelivered = g.estado === 'Entregado';
              const isIncident = g.estado === 'No entregado';
              const bgColor = isDelivered ? '#059669' : isIncident ? '#e11d48' : '#0f172a';

              const iconHtml = `
                <div style="background:${bgColor};width:28px;height:28px;border-radius:50%;border:2px solid white;color:white;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;box-shadow:0 2px 6px rgba(0,0,0,0.3);">
                  ${stopNum}
                </div>
              `;
              const icon = L.divIcon({ html: iconHtml, className: '', iconSize: [28, 28], iconAnchor: [14, 14] });
              const marker = L.marker([lat, lng], { icon }).addTo(markersLayer);
              marker.bindPopup(`<b>Parada #${stopNum}</b><br/>Guía #${g.id_guia}<br/>${g.destinatario}`);
              latLngs.push([lat, lng]);
            }
          }
        });

        if (routePolyline) {
          map.removeLayer(routePolyline);
          routePolyline = null;
        }

        if (latLngs.length > 1) {
          routePolyline = L.polyline(latLngs, { color: '#4f46e5', weight: 3, opacity: 0.8, dashArray: '6, 6' }).addTo(map);
        }

        if (latLngs.length > 0) {
          map.fitBounds(L.latLngBounds(latLngs), { padding: [30, 30] });
        }
      }

      // Toggle Mapa
      const toggleMapBtn = document.getElementById('toggle-map-btn');
      const toggleMapText = document.getElementById('toggle-map-text');
      const mapWrapper = document.getElementById('map-wrapper');
      const recenterMapBtn = document.getElementById('recenter-map-btn');

      toggleMapBtn?.addEventListener('click', () => {
        isMapVisible = !isMapVisible;
        if (isMapVisible) {
          mapWrapper?.classList.remove('hidden');
          if (toggleMapText) toggleMapText.textContent = 'Ocultar Mapa';
          setTimeout(() => { if (map) map.invalidateSize(); }, 150);
        } else {
          mapWrapper?.classList.add('hidden');
          if (toggleMapText) toggleMapText.textContent = 'Ver Mapa';
        }
      });

      recenterMapBtn?.addEventListener('click', () => {
        updateMapMarkers();
      });

      // ====================================================
      // MÓDULO 4: LIGHTBOX
      // ====================================================
      const lightboxModal = document.getElementById('lightbox-modal');
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
      const lightboxTitle = document.getElementById('lightbox-title');
      const lightboxInfo = document.getElementById('lightbox-info');
      const lightboxCloseBtn = document.getElementById('lightbox-close-btn');
      const lightboxDeleteBtn = document.getElementById('lightbox-delete-btn') as HTMLButtonElement;

      let currentChoferLightboxGuiaId: string | null = null;

      window.openLightbox = function(url, title, info, guiaId) {
        if (!lightboxModal || !lightboxImg) return;
        lightboxImg.src = url;
        if (lightboxTitle) lightboxTitle.textContent = title || 'Comprobante';
        if (lightboxInfo) lightboxInfo.textContent = info || '';

        currentChoferLightboxGuiaId = guiaId || null;
        if (lightboxDeleteBtn) {
          if (currentChoferLightboxGuiaId) {
            lightboxDeleteBtn.classList.remove('hidden');
            lightboxDeleteBtn.classList.add('flex');
          } else {
            lightboxDeleteBtn.classList.add('hidden');
            lightboxDeleteBtn.classList.remove('flex');
          }
        }

        lightboxModal.classList.remove('hidden');
        lightboxModal.classList.add('flex');
      };

      lightboxDeleteBtn?.addEventListener('click', async () => {
        if (!currentChoferLightboxGuiaId) return;

        if (!confirm(`¿Estás seguro de eliminar la foto de comprobante de la guía #${currentChoferLightboxGuiaId}?`)) {
          return;
        }

        const origText = lightboxDeleteBtn.innerHTML;
        lightboxDeleteBtn.disabled = true;
        lightboxDeleteBtn.innerHTML = `<span>Borrando...</span>`;

        try {
          const res = await fetch(`/api/guias/${currentChoferLightboxGuiaId}/foto`, { method: 'DELETE' });
          const data = await res.json();

          if (res.ok && data.success) {
            showToast('Foto eliminada correctamente', 'success');
            const targetId = currentChoferLightboxGuiaId;
            const item = guiasData.find((g: any) => g.id_guia === targetId);
            if (item) {
              item.comprobante_url = null;
              item.comprobante_base64 = null;
              item.recibido_por = null;
            }
            renderGuias();
            closeLightbox();
          } else {
            showToast(data.message || 'Error al eliminar foto', 'error');
          }
        } catch(e) {
          showToast('Error de conexión', 'error');
        } finally {
          lightboxDeleteBtn.disabled = false;
          lightboxDeleteBtn.innerHTML = origText;
        }
      });

      function closeLightbox() {
        lightboxModal?.classList.add('hidden');
        lightboxModal?.classList.remove('flex');
        if (lightboxImg) lightboxImg.src = '';
        currentChoferLightboxGuiaId = null;
      }

      lightboxCloseBtn?.addEventListener('click', closeLightbox);
      lightboxModal?.addEventListener('click', (e) => {
        if (e.target === lightboxModal) closeLightbox();
      });

      // ====================================================
      // MÓDULO 5: LIVE SYNC SILENCIOSO (4.5s)
      // ====================================================
      const refreshBtn = document.getElementById('refresh-btn');
      const refreshIcon = document.getElementById('refresh-icon');

      async function syncGuias(showToastNotification = false) {
        if (refreshIcon) refreshIcon.classList.add('animate-spin');
        try {
          const res = await fetch('/api/chofer/guias');
          if (!res.ok) return;
          const json = await res.json();
          if (json.success && Array.isArray(json.data)) {
            guiasData = json.data;

            const noRoutesContainer = document.getElementById('no-routes-container');
            const activeRoutesContainer = document.getElementById('active-routes-container');

            if (guiasData.length === 0) {
              noRoutesContainer?.classList.remove('hidden');
              activeRoutesContainer?.classList.add('hidden');
            } else {
              noRoutesContainer?.classList.add('hidden');
              activeRoutesContainer?.classList.remove('hidden');
            }

            renderCards();
            updateMapMarkers();
            if (showToastNotification) {
              showToast('Ruta actualizada', 'success');
            }
          }
        } catch (err) {
          if (showToastNotification) {
            showToast('Error al sincronizar con el servidor', 'error');
          }
        } finally {
          if (refreshIcon) refreshIcon.classList.remove('animate-spin');
        }
      }

      // ----------------------------------------------------
      // LISTÍN DE DESPACHO OFICIAL PARA IMPRESIÓN DEL CHOFER
      // ----------------------------------------------------
      function renderChoferListinTable() {
        const tbody = document.getElementById('chofer-listin-tbody');
        const totalGuiasEl = document.getElementById('chofer-listin-total-guias');
        const totalPiezasEl = document.getElementById('chofer-listin-total-piezas');
        const totalDestinosEl = document.getElementById('chofer-listin-total-destinos');

        const activeGuias = (guiasData || []).slice().sort((a, b) => {
          if (a.orden_ruta && b.orden_ruta) return a.orden_ruta - b.orden_ruta;
          if (a.orden_ruta) return -1;
          if (b.orden_ruta) return 1;
          return (a.ciudad_destino || '').localeCompare(b.ciudad_destino || '');
        });

        const uniqueCities = Array.from(new Set(activeGuias.map(g => (g.ciudad_destino || '').trim()).filter(Boolean)));
        const totalGuias = activeGuias.length;
        const totalPiezas = activeGuias.reduce((acc, g) => acc + (g.piezas || 1), 0);

        if (totalGuiasEl) totalGuiasEl.textContent = totalGuias.toString();
        if (totalPiezasEl) totalPiezasEl.textContent = totalPiezas.toString();
        if (totalDestinosEl) totalDestinosEl.textContent = uniqueCities.length.toString();

        const rowCount = Math.max(Math.ceil(activeGuias.length / 2), 20);
        const leftGuias = activeGuias.slice(0, rowCount);
        const rightGuias = activeGuias.slice(rowCount, rowCount * 2);

        let html = '';
        for (let i = 0; i < rowCount; i++) {
          const left = leftGuias[i];
          const right = rightGuias[i];

          html += `
            <tr class="h-6 border-b border-black/30 text-black">
              <!-- Bloque Izquierdo -->
              <td class="py-1 px-1.5 border-r border-black font-mono font-bold text-center">${left ? left.id_guia : ''}</td>
              <td class="py-1 px-1 border-r border-black text-center font-bold">${left ? (left.piezas || 1) : ''}</td>
              <td class="py-1 px-2 border-r-2 border-black font-bold uppercase truncate max-w-[140px]">${left ? left.ciudad_destino : ''}</td>
              <!-- Bloque Derecho -->
              <td class="py-1 px-1.5 border-r border-black font-mono font-bold text-center">${right ? right.id_guia : ''}</td>
              <td class="py-1 px-1 border-r border-black text-center font-bold">${right ? (right.piezas || 1) : ''}</td>
              <td class="py-1 px-2 font-bold uppercase truncate max-w-[140px]">${right ? right.ciudad_destino : ''}</td>
            </tr>
          `;
        }

        if (tbody) {
          tbody.innerHTML = html;
        }
      }

      window.openChoferListinModal = () => {
        renderChoferListinTable();
        const modal = document.getElementById('chofer-listin-modal');
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      };

      window.closeChoferListinModal = () => {
        const modal = document.getElementById('chofer-listin-modal');
        if (modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      };

      refreshBtn?.addEventListener('click', () => syncGuias(true));

      // Polling de 4.5s
      setInterval(() => {
        syncGuias(false);
      }, 4500);

      // Inicialización en arranque
      document.addEventListener('DOMContentLoaded', () => {
        renderCards();
        initMap();
      });

      // Si DOMContentLoaded ya pasó (script diferido)
      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        renderCards();
        setTimeout(initMap, 200);
      }
    </script>
  </body>
</html>
