            '</div>' +

            '<!-- Botón Principal: Confirmar Entrega -->' +
            (isPending ?
              '<button type="button" onclick="window.openDeliveryModal(\'' + stop.guiasIds + '\', \'' + destEscaped + '\', \'' + dirEscaped + '\', ' + stopNum + ', \'' + stop.guiasLabel + '\', ' + stop.totalPiezas + ', ' + stop.totalPiesCubicos + ')" class="w-full tap-active py-3.5 px-4 rounded-2xl bg-slate-950 hover:bg-black text-white font-black text-xs sm:text-sm flex items-center justify-center gap-2 transition-all shadow-sm cursor-pointer text-center">' +
                '<svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>' +
                '<span>Confirmar Entrega</span>' +
              '</button>' : (isDelivered && stop.comprobante_url ?
              (function() {
                var pCount = stop.comprobante_url.split(',').filter(Boolean).length;
                var pText = pCount > 1 ? ('Ver Comprobantes (' + pCount + ' fotos)') : 'Ver Comprobante de Entrega';
                return '<button type="button" onclick="window.openLightbox(\'' + stop.comprobante_url + '\', \'Parada #' + stopNum + ' - ' + stop.destinatario + '\', \'Guías: ' + stop.guiasLabel + '\', \'' + firstGuiaId + '\')" class="w-full tap-active py-3 px-4 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs flex items-center justify-center gap-2 transition-colors cursor-pointer text-center">' +
                  '<svg class="w-4 h-4 text-slate-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>' +
                  '<span>' + pText + '</span>' +
                '</button>';
              })() :
              '<button type="button" onclick="window.openDeliveryModal(\'' + stop.guiasIds + '\', \'' + destEscaped + '\', \'' + dirEscaped + '\', ' + stopNum + ', \'' + stop.guiasLabel + '\', ' + stop.totalPiezas + ', ' + stop.totalPiesCubicos + ')" class="w-full tap-active py-3 px-4 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center justify-center gap-2 cursor-pointer text-center">' +
                '<span>Actualizar Estado de Entrega</span>' +
              '</button>'
            )) +
          '</div>' +
        '</div>';
      }

      function updateStats() {
        var stops = buildClientStops(guiasData);
        var total = stops.length;
        var entregados = stops.filter(function(s) { return s.estado === 'Entregado'; }).length;
        var noEntregados = stops.filter(function(s) { return s.estado === 'No entregado'; }).length;
        var pendientes = stops.filter(function(s) { return s.estado !== 'Entregado' && s.estado !== 'No entregado'; }).length;
        var pct = total > 0 ? Math.round((entregados / total) * 100) : 0;
        var totalGuiasCount = guiasData.length;

        var statPendientes = document.getElementById('stat-pendientes');
        var statEntregados = document.getElementById('stat-entregados');
        var statNoEntregados = document.getElementById('stat-no-entregados');
        var statTotal = document.getElementById('stat-total');

        var badgeTabPendientes = document.getElementById('badge-tab-pendientes');
        var badgeTabEntregados = document.getElementById('badge-tab-entregados');
        var badgeTabNoEntregados = document.getElementById('badge-tab-no-entregados');
        var badgeTabTodos = document.getElementById('badge-tab-todos');

        var progressText = document.getElementById('progress-text');
        var progressBarFill = document.getElementById('progress-bar-fill');

        if (statPendientes) statPendientes.textContent = pendientes;
        if (statEntregados) statEntregados.textContent = entregados;
        if (statNoEntregados) statNoEntregados.textContent = noEntregados;
        if (statTotal) statTotal.textContent = total;

        if (badgeTabPendientes) badgeTabPendientes.textContent = pendientes;
        if (badgeTabEntregados) badgeTabEntregados.textContent = entregados;
        if (badgeTabNoEntregados) badgeTabNoEntregados.textContent = noEntregados;
        if (badgeTabTodos) badgeTabTodos.textContent = total;

        if (progressText) progressText.textContent = entregados + ' / ' + total + ' (' + totalGuiasCount + ' guías • ' + pct + '%)';
        if (progressBarFill) progressBarFill.style.width = pct + '%';
      }

      function getFilteredClientStops() {
        var q = (searchQuery || '').toLowerCase().trim();
        var allStops = buildClientStops(guiasData);

        return allStops.filter(function(stop) {
          var matchTab = 
            activeTab === 'todos' ? true :
            activeTab === 'entregados' ? stop.estado === 'Entregado' :
            activeTab === 'no_entregados' ? stop.estado === 'No entregado' :
            (stop.estado !== 'Entregado' && stop.estado !== 'No entregado');

          var matchCity = !selectedCity || stop.ciudad_destino === selectedCity;
          
          var matchQuery = !q || 
            (stop.destinatario && stop.destinatario.toLowerCase().includes(q)) ||
            (stop.direccion_referencia && stop.direccion_referencia.toLowerCase().includes(q)) ||
            (stop.telefono_principal && stop.telefono_principal.includes(q)) ||
            stop.guias.some(function(g) { return g.id_guia && g.id_guia.toLowerCase().includes(q); });

          return matchTab && matchCity && matchQuery;
        });
      }

      function renderCards() {
        updateStats();
        var cardsContainer = document.getElementById('cards-container');
        var emptyState = document.getElementById('empty-state');
        if (!cardsContainer) return;

        var allStops = buildClientStops(guiasData);
        var filteredStops = getFilteredClientStops();
        var activeStopContainer = document.getElementById('active-stop-card-container');

        // Buscar siguiente parada cliente pendiente
        var nextPendingStop = (allStops || []).find(function(s) {
          return s.estado !== 'Entregado' && s.estado !== 'No entregado';
        });

        if (activeStopContainer) {
          if (nextPendingStop && (activeTab === 'pendientes' || activeTab === 'todos')) {
            var nextStopNum = nextPendingStop.orden_ruta && nextPendingStop.orden_ruta > 0 ? nextPendingStop.orden_ruta : 1;
            activeStopContainer.innerHTML =
              '<div class="space-y-2 animate-fadeIn">' +
                '<div class="flex items-center justify-between px-1">' +
                  '<div class="flex items-center gap-2">' +
                    '<span class="w-6 h-6 rounded-xl bg-indigo-600 text-white font-black text-[11px] flex items-center justify-center shadow-xs">#' + nextStopNum + '</span>' +
                    '<h3 class="text-xs font-black text-slate-900 uppercase tracking-wide">Siguiente Parada Activa</h3>' +
                  '</div>' +
                  '<span class="text-[10px] font-extrabold px-2.5 py-0.5 rounded-full bg-indigo-100 text-indigo-900 uppercase">Prioridad</span>' +
                '</div>' +
                renderStopCard(nextPendingStop, nextStopNum, true) +
              '</div>';
          } else {
            activeStopContainer.innerHTML = '';
          }
        }

        if (filteredStops.length === 0) {
          cardsContainer.innerHTML = '';
          if (emptyState) emptyState.classList.remove('hidden');
          return;
        }

        if (emptyState) emptyState.classList.add('hidden');

        cardsContainer.innerHTML = filteredStops.map(function(stop, index) {
          var stopNum = stop.orden_ruta && stop.orden_ruta > 0 ? stop.orden_ruta : (index + 1);
          return renderStopCard(stop, stopNum, false);
        }).join('');
      }

      function updateTabsUI() {
        var tabs = [
          { id: 'tab-pendientes', key: 'pendientes' },
          { id: 'tab-entregados', key: 'entregados' },
          { id: 'tab-no-entregados', key: 'no_entregados' },
          { id: 'tab-todos', key: 'todos' }
        ];

        tabs.forEach(function(t) {
          var btn = document.getElementById(t.id);
          if (!btn) return;
          if (t.key === activeTab) {
            btn.className = 'py-2 text-[11px] font-bold rounded-xl transition-all flex items-center justify-center gap-1 bg-white text-slate-900 shadow-xs cursor-pointer';
          } else {
            btn.className = 'py-2 text-[11px] font-semibold rounded-xl transition-all flex items-center justify-center gap-1 text-slate-600 hover:text-slate-900 cursor-pointer';
          }
        });
      }

      // Event Listeners de Tabs y Filtros
      ['tab-pendientes', 'tab-entregados', 'tab-no-entregados', 'tab-todos'].forEach(function(id) {
        var btn = document.getElementById(id);
        if (btn) {
          btn.addEventListener('click', function() {
            activeTab = id.replace('tab-', '').replace('-', '_');
            updateTabsUI();
            renderCards();
          });
        }
      });

      var searchInput = document.getElementById('search-input');
      if (searchInput) {
        searchInput.addEventListener('input', function(e) {
          searchQuery = e.target.value;
          renderCards();
        });
      }

      var cityFilter = document.getElementById('city-filter');
      if (cityFilter) {
        cityFilter.addEventListener('change', function(e) {
          selectedCity = e.target.value;
          renderCards();
        });
      }

      // ====================================================
      // MÓDULO DE ESCANEO DE GUÍAS (CÁMARA / GALERÍA)
      // ====================================================
      var heroCameraInput = document.getElementById('hero-camera-input');
      var heroGalleryInput = document.getElementById('hero-gallery-input');
      var modalScanCameraInput = document.getElementById('modal-scan-camera-input');
      var modalScanGalleryInput = document.getElementById('modal-scan-gallery-input');
      var scanModal = document.getElementById('scan-modal');
      var scanModalCloseBtn = document.getElementById('scan-modal-close-btn');
      var btnHeaderScan = document.getElementById('btn-header-scan');

      var currentScanTargetMode = 'hero';

      function openScanModal() {
        if (scanModal) {
          scanModal.classList.remove('hidden');
          scanModal.classList.add('flex');
        }
      }
      function closeScanModal() {
        if (scanModal) {
          scanModal.classList.add('hidden');
          scanModal.classList.remove('flex');
        }
      }

      if (scanModalCloseBtn) scanModalCloseBtn.addEventListener('click', closeScanModal);
      if (btnHeaderScan) btnHeaderScan.addEventListener('click', openScanModal);
      if (scanModal) {
        scanModal.addEventListener('click', function(e) {
          if (e.target === scanModal) closeScanModal();
        });
      }

      async function handleScanFiles(files) {
        if (!files || files.length === 0) return;
        isUploadingScans = true;

        var total = files.length;
        var nowScan = new Date();
        var pad2 = function(n) { return n.toString().padStart(2, '0'); };
        var scanLoteId = 'chofer_' + nowScan.getFullYear() + pad2(nowScan.getMonth()+1) + pad2(nowScan.getDate()) + '_' + pad2(nowScan.getHours()) + pad2(nowScan.getMinutes());

        var isModal = currentScanTargetMode === 'modal';
        var liveSection = document.getElementById(isModal ? 'modal-scan-live-section' : 'hero-scan-live-section');
        var progressBar = document.getElementById(isModal ? 'modal-progress-bar' : 'hero-progress-bar');
        var progressLabel = document.getElementById(isModal ? 'modal-progress-label' : 'hero-progress-label');
        var progressCount = document.getElementById(isModal ? 'modal-progress-count' : 'hero-progress-count');
        var galleryGrid = document.getElementById(isModal ? 'modal-gallery-grid' : 'hero-gallery-grid');
        var galleryCount = document.getElementById(isModal ? 'modal-gallery-count' : 'hero-gallery-count');

        if (liveSection) liveSection.classList.remove('hidden');
        if (progressBar) progressBar.style.width = '0%';
        if (progressLabel) progressLabel.textContent = 'Procesando ' + total + ' foto(s)...';
        if (progressCount) progressCount.textContent = '0 / ' + total;
        showToast('Procesando ' + total + ' foto(s)...', 'info');

        var uploadedOk = 0;
        var processed = 0;

        try {
          for (var i = 0; i < files.length; i++) {
            var file = files[i];
            sessionScannedCount++;
            var itemIndex = sessionScannedCount;

            var previewUrl = '';
            try { previewUrl = URL.createObjectURL(file); } catch(e) {}

            var thumbDiv = document.createElement('div');
            thumbDiv.className = 'relative aspect-square rounded-xl overflow-hidden bg-slate-100 border-2 border-slate-200';
            thumbDiv.innerHTML = (previewUrl ? '<img src="' + previewUrl + '" class="w-full h-full object-cover" />' : '') +
              '<div id="scan-overlay-' + itemIndex + '" class="absolute inset-0 bg-black/50 flex items-center justify-center">' +
                '<svg class="w-5 h-5 text-white animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>' +
              '</div>';

            if (galleryGrid) galleryGrid.prepend(thumbDiv);

            try {
              var comp = await compressImage(file, 1200, 1600, 0.75);

              var formData = new FormData();
              formData.append('foto', comp.blob || file, file.name || 'escaneo.jpg');
              formData.append('lote_id', scanLoteId);

              var res = await fetch('/api/escaneos', {
                method: 'POST',
                body: formData,
                credentials: 'include'
              });
              var data = await res.json().catch(function() { return { success: false }; });

              var overlay = document.getElementById('scan-overlay-' + itemIndex);
              if (res.ok && data.success) {
                uploadedOk++;
                thumbDiv.classList.replace('border-slate-200', 'border-emerald-400');
                if (overlay) {
                  overlay.innerHTML = '<svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>';
                  setTimeout(function(ov) { if (ov) ov.classList.add('opacity-0'); }, 700, overlay);
                }
              } else {
                thumbDiv.classList.replace('border-slate-200', 'border-rose-400');
                if (overlay) {
                  overlay.innerHTML = '<svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>';
                }
              }
            } catch (err) {
              console.error('Error subiendo escaneo:', err);
            }

            processed++;
            var pct = Math.round((processed / total) * 100);
            if (progressBar) progressBar.style.width = pct + '%';
            if (progressCount) progressCount.textContent = processed + ' / ' + total;
          }
        } finally {
          isUploadingScans = false;
        }

        if (progressLabel) progressLabel.textContent = '¡' + uploadedOk + ' de ' + total + ' guías cargadas!';
        if (galleryCount && galleryGrid) galleryCount.textContent = galleryGrid.children.length + ' subidas';
        if (uploadedOk > 0) {
          showToast('¡' + uploadedOk + ' foto(s) enviada(s) a Logística!', 'success');
        }
      }

      async function onFileInputChange(e, mode) {
        var input = e.target;
        var files = input.files ? Array.from(input.files) : [];
        if (files.length === 0) return;
        currentScanTargetMode = mode;
        try {
          await handleScanFiles(files);
        } finally {
          input.value = '';
        }
      }

      if (heroCameraInput) heroCameraInput.addEventListener('change', function(e) { onFileInputChange(e, 'hero'); });
      if (heroGalleryInput) heroGalleryInput.addEventListener('change', function(e) { onFileInputChange(e, 'hero'); });
      if (modalScanCameraInput) modalScanCameraInput.addEventListener('change', function(e) { onFileInputChange(e, 'modal'); });
      if (modalScanGalleryInput) modalScanGalleryInput.addEventListener('change', function(e) { onFileInputChange(e, 'modal'); });

      // ====================================================
      // MÓDULO DE CONFIRMACIÓN DE ENTREGA E INCIDENCIA
      // ====================================================
      var deliveryModal = document.getElementById('delivery-modal');
      var modalCloseBtn = document.getElementById('modal-close-btn');
      var modalCancelBtn = document.getElementById('modal-cancel-btn');
      var modalConfirmBtn = document.getElementById('modal-confirm-btn');
      var modalIncidentSubmitBtn = document.getElementById('modal-incident-submit-btn');
      var modalTabSuccessBtn = document.getElementById('modal-tab-success-btn');
      var modalTabIncidentBtn = document.getElementById('modal-tab-incident-btn');
      var modalPanelSuccess = document.getElementById('modal-panel-success');
      var modalPanelIncident = document.getElementById('modal-panel-incident');
      var modalTitleText = document.getElementById('modal-title-text');
      var modalGuiaCode = document.getElementById('modal-guia-code');
      var modalDestinatario = document.getElementById('modal-destinatario');
      var modalDireccion = document.getElementById('modal-direccion');
      var modalRecibidoPor = document.getElementById('modal-recibido-por');
      var modalIncidentReason = document.getElementById('modal-incident-reason');
      var modalIncidentNote = document.getElementById('modal-incident-note');

      var modalDeliveryPhotoCamera = document.getElementById('modal-delivery-photo-camera');
      var modalDeliveryPhotoGallery = document.getElementById('modal-delivery-photo-gallery');
      var modalDeliveryCaptureBox = document.getElementById('modal-delivery-capture-box');
      var modalDeliveryPhotosGrid = document.getElementById('modal-delivery-photos-grid');
      var modalDeliveryPhotoBadge = document.getElementById('modal-delivery-photo-badge');

      var activeModalGuiaId = null;
      var currentDeliveryPhotos = [];
      var modalDeliveryMode = 'success';

      function renderDeliveryPhotosGrid() {
        if (!modalDeliveryPhotosGrid) return;
        if (currentDeliveryPhotos.length === 0) {
          modalDeliveryPhotosGrid.classList.add('hidden');
          modalDeliveryPhotosGrid.innerHTML = '';
          if (modalDeliveryPhotoBadge) {
            modalDeliveryPhotoBadge.textContent = 'Requerido';
            modalDeliveryPhotoBadge.className = 'text-[10px] font-extrabold text-rose-600 bg-rose-50 border border-rose-200 px-2 py-0.5 rounded-full';
          }
          return;
        }

        modalDeliveryPhotosGrid.classList.remove('hidden');
        if (modalDeliveryPhotoBadge) {
          modalDeliveryPhotoBadge.textContent = currentDeliveryPhotos.length + ' foto(s) lista(s)';
          modalDeliveryPhotoBadge.className = 'text-[10px] font-extrabold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full';
        }

        modalDeliveryPhotosGrid.innerHTML = currentDeliveryPhotos.map(function(item, idx) {
          return '<div class="relative aspect-square rounded-2xl overflow-hidden bg-slate-100 border border-slate-200 shadow-2xs group">' +
            '<img src="' + item.previewUrl + '" class="w-full h-full object-cover" />' +
            '<button type="button" onclick="window.removeDeliveryPhoto(' + idx + ')" class="absolute top-1 right-1 w-6 h-6 rounded-full bg-black/70 hover:bg-rose-600 text-white flex items-center justify-center transition-colors cursor-pointer" title="Eliminar foto">' +
              '<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>' +
            '</button>' +
            '<span class="absolute bottom-1 left-1 px-1.5 py-0.2 rounded bg-black/60 text-white font-mono text-[9px] font-bold">' + (item.sizeKb || 0) + 'KB</span>' +
          '</div>';
        }).join('');
      }

      window.removeDeliveryPhoto = function(idx) {
        if (idx >= 0 && idx < currentDeliveryPhotos.length) {
          currentDeliveryPhotos.splice(idx, 1);
          renderDeliveryPhotosGrid();
        }
      };

      function resetDeliveryPhotoState() {
        currentDeliveryPhotos = [];
        renderDeliveryPhotosGrid();
      }

      async function handleDeliveryFilesSelected(files) {
        if (!files || files.length === 0) return;
        showToast('Comprimiendo ' + files.length + ' foto(s)...', 'info');

        for (var i = 0; i < files.length; i++) {
          var file = files[i];
          try {
            var comp = await compressImage(file, 1200, 1600, 0.75);
            var prevUrl = '';
            try { prevUrl = URL.createObjectURL(comp.blob || file); } catch(e) {}
            currentDeliveryPhotos.push({
              file: file,
              blob: comp.blob || file,
              previewUrl: prevUrl,
              sizeKb: comp.sizeKb || Math.round(file.size / 1024)
            });
          } catch(e) {
            console.error('Error procesando foto:', e);
          }
        }
        renderDeliveryPhotosGrid();
      }

      if (modalDeliveryPhotoCamera) {
        modalDeliveryPhotoCamera.addEventListener('change', function(e) {
          var files = e.target.files ? Array.from(e.target.files) : [];
          handleDeliveryFilesSelected(files);
          e.target.value = '';
        });
      }
      if (modalDeliveryPhotoGallery) {
        modalDeliveryPhotoGallery.addEventListener('change', function(e) {
          var files = e.target.files ? Array.from(e.target.files) : [];
          handleDeliveryFilesSelected(files);
          e.target.value = '';
        });
      }

      function setDeliveryModalMode(mode) {
        modalDeliveryMode = mode;
        if (mode === 'success') {
          if (modalTabSuccessBtn) modalTabSuccessBtn.className = 'py-2 px-2 text-xs font-bold rounded-xl transition-all flex items-center justify-center gap-1.5 bg-white text-slate-900 shadow-xs cursor-pointer';
          if (modalTabIncidentBtn) modalTabIncidentBtn.className = 'py-2 px-2 text-xs font-semibold rounded-xl transition-all flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900 cursor-pointer';
          if (modalPanelSuccess) modalPanelSuccess.classList.remove('hidden');
          if (modalPanelIncident) modalPanelIncident.classList.add('hidden');
          if (modalConfirmBtn) modalConfirmBtn.classList.remove('hidden');
          if (modalIncidentSubmitBtn) modalIncidentSubmitBtn.classList.add('hidden');
          if (modalTitleText) modalTitleText.textContent = 'Confirmar Entrega Realizada';
        } else {
          if (modalTabIncidentBtn) modalTabIncidentBtn.className = 'py-2 px-2 text-xs font-bold rounded-xl transition-all flex items-center justify-center gap-1.5 bg-white text-rose-900 shadow-xs cursor-pointer';
          if (modalTabSuccessBtn) modalTabSuccessBtn.className = 'py-2 px-2 text-xs font-semibold rounded-xl transition-all flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900 cursor-pointer';
          if (modalPanelSuccess) modalPanelSuccess.classList.add('hidden');
          if (modalPanelIncident) modalPanelIncident.classList.remove('hidden');
          if (modalConfirmBtn) modalConfirmBtn.classList.add('hidden');
          if (modalIncidentSubmitBtn) modalIncidentSubmitBtn.classList.remove('hidden');
          if (modalTitleText) modalTitleText.textContent = 'Reportar No Entrega';
        }
      }

      if (modalTabSuccessBtn) modalTabSuccessBtn.addEventListener('click', function() { setDeliveryModalMode('success'); });
      if (modalTabIncidentBtn) modalTabIncidentBtn.addEventListener('click', function() { setDeliveryModalMode('incident'); });

      window.openDeliveryModal = function(idGuia, destinatario, direccion, stopNumber, guiasLabel, totalPiezas, totalVolumen) {
        activeModalGuiaId = idGuia;
        var label = guiasLabel || ('#' + idGuia);
        var piezasStr = totalPiezas ? ' • ' + totalPiezas + ' pza(s)' : '';
        var volStr = totalVolumen ? ' • ' + Number(totalVolumen).toFixed(2) + ' ft³' : '';
        if (modalGuiaCode) modalGuiaCode.textContent = 'Parada #' + stopNumber + ' • ' + label + piezasStr + volStr;
        if (modalDestinatario) modalDestinatario.textContent = destinatario;
        if (modalDireccion) modalDireccion.textContent = direccion || 'Ubicación confirmada';
        if (modalRecibidoPor) modalRecibidoPor.value = '';
        if (modalIncidentNote) modalIncidentNote.value = '';
        setDeliveryModalMode('success');
        resetDeliveryPhotoState();
        if (deliveryModal) {
          deliveryModal.classList.remove('hidden');
          deliveryModal.classList.add('flex');
        }
      };

      function closeDeliveryModal() {
        if (deliveryModal) {
          deliveryModal.classList.add('hidden');
          deliveryModal.classList.remove('flex');
        }
        activeModalGuiaId = null;
        resetDeliveryPhotoState();
      }

      if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeDeliveryModal);
      if (modalCancelBtn) modalCancelBtn.addEventListener('click', closeDeliveryModal);

      // Submit Confirmar Entrega
      if (modalConfirmBtn) {
        modalConfirmBtn.addEventListener('click', async function() {
          if (!activeModalGuiaId) return;
          if (!currentDeliveryPhotos || currentDeliveryPhotos.length === 0) {
            showToast('Debes tomar o subir al menos una foto del comprobante', 'error');
            return;
          }

          modalConfirmBtn.disabled = true;
          var originalHtml = modalConfirmBtn.innerHTML;
          modalConfirmBtn.innerHTML = '<svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg><span>Subiendo ' + currentDeliveryPhotos.length + ' foto(s)...</span>';

          try {
            var formData = new FormData();
            formData.append('id_guia', activeModalGuiaId);
            formData.append('tipo_resultado', 'entregado');
            formData.append('recibido_por', modalRecibidoPor ? modalRecibidoPor.value.trim() : '');

            currentDeliveryPhotos.forEach(function(item, idx) {
              formData.append('fotos', item.blob, item.file.name || ('comprobante_' + idx + '.jpg'));
            });
            formData.append('foto', currentDeliveryPhotos[0].blob, 'comprobante_0.jpg');

            var res = await fetch('/api/chofer/entregar', {
              method: 'POST',
              body: formData
            });
            var data = await res.json().catch(function() { return { success: false, message: 'Error de respuesta del servidor' }; });

            if (res.ok && data.success) {
              var deliveredIds = activeModalGuiaId.split(',').map(function(s) { return s.trim(); });
              deliveredIds.forEach(function(gId) {
                var idx = guiasData.findIndex(function(g) { return g.id_guia === gId; });
                if (idx !== -1) {
                  guiasData[idx].estado = 'Entregado';
                  guiasData[idx].comprobante_url = data.data ? data.data.comprobante_url : null;
                  guiasData[idx].recibido_por = data.data ? data.data.recibido_por : null;
                }
              });

              closeDeliveryModal();
              renderCards();
              showToast(data.message || '¡Entrega confirmada y fotos guardadas!', 'success');
            } else {
              showToast(data.message || 'Error al registrar entrega', 'error');
              modalConfirmBtn.disabled = false;
              modalConfirmBtn.innerHTML = originalHtml;
            }
          } catch (err) {
            console.error('Error confirmando entrega:', err);
            showToast('Error de red al guardar entrega', 'error');
            modalConfirmBtn.disabled = false;
            modalConfirmBtn.innerHTML = originalHtml;
          }
        });
      }

      // Submit Incidencia / No entregó
      if (modalIncidentSubmitBtn) {
        modalIncidentSubmitBtn.addEventListener('click', async function() {
          if (!activeModalGuiaId) return;
          var motivo = modalIncidentReason ? modalIncidentReason.value : 'No entregado';
          var nota = modalIncidentNote ? modalIncidentNote.value.trim() : '';
          var motivoCompleto = nota ? (motivo + ': ' + nota) : motivo;

          modalIncidentSubmitBtn.disabled = true;
          var originalHtml = modalIncidentSubmitBtn.innerHTML;
          modalIncidentSubmitBtn.innerHTML = '<svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg><span>Registrando...</span>';

          try {
            var formData = new FormData();
            formData.append('id_guia', activeModalGuiaId);
            formData.append('tipo_resultado', 'no_entregado');
            formData.append('motivo_no_entrega', motivoCompleto);

            var res = await fetch('/api/chofer/entregar', {
              method: 'POST',
              body: formData
            });
            var data = await res.json().catch(function() { return { success: false, message: 'Error del servidor' }; });

            if (res.ok && data.success) {
              var incidentIds = activeModalGuiaId.split(',').map(function(s) { return s.trim(); });
              incidentIds.forEach(function(gId) {
                var idx = guiasData.findIndex(function(g) { return g.id_guia === gId; });
                if (idx !== -1) {
                  guiasData[idx].estado = 'No entregado';
                }
              });

              closeDeliveryModal();
              renderCards();
              showToast('Incidencia registrada como No entregada', 'info');
            } else {
              showToast(data.message || 'Error al registrar incidencia', 'error');
              modalIncidentSubmitBtn.disabled = false;
              modalIncidentSubmitBtn.innerHTML = originalHtml;
            }
          } catch (err) {
            console.error('Error registrando incidencia:', err);
            showToast('Error de conexión', 'error');
            modalIncidentSubmitBtn.disabled = false;
            modalIncidentSubmitBtn.innerHTML = originalHtml;
          }
        });
      }

      // ====================================================
      // LIGHTBOX DE COMPROBANTES
      // ====================================================
      var lightboxModal = document.getElementById('lightbox-modal');
      var lightboxImg = document.getElementById('lightbox-img');
      var lightboxTitle = document.getElementById('lightbox-title');
      var lightboxInfo = document.getElementById('lightbox-info');
      var lightboxCloseBtn = document.getElementById('lightbox-close-btn');
      var lightboxPrevBtn = document.getElementById('lightbox-prev-btn');
      var lightboxNextBtn = document.getElementById('lightbox-next-btn');
      var lightboxCounter = document.getElementById('lightbox-counter');

      var currentLightboxUrls = [];
      var currentLightboxIndex = 0;

      function renderLightboxPhoto() {
        if (!lightboxImg || currentLightboxUrls.length === 0) return;
        var url = currentLightboxUrls[currentLightboxIndex];
        lightboxImg.src = url;
        if (lightboxCounter) {
          lightboxCounter.textContent = (currentLightboxIndex + 1) + ' / ' + currentLightboxUrls.length;
        }
      }

      window.openLightbox = function(rawUrls, title, subtitle) {
        if (!rawUrls) return;
        currentLightboxUrls = rawUrls.split(',').map(function(s) { return s.trim(); }).filter(Boolean);
        if (currentLightboxUrls.length === 0) return;
        currentLightboxIndex = 0;

        if (lightboxTitle) lightboxTitle.textContent = title || 'Comprobante de Entrega';
        if (lightboxInfo) lightboxInfo.textContent = subtitle || '';
        renderLightboxPhoto();

        if (lightboxModal) {
          lightboxModal.classList.remove('hidden');
          lightboxModal.classList.add('flex');
        }
      };

      function closeLightbox() {
        if (lightboxModal) {
          lightboxModal.classList.add('hidden');
          lightboxModal.classList.remove('flex');
        }
        if (lightboxImg) lightboxImg.src = '';
        currentLightboxUrls = [];
        currentLightboxIndex = 0;
      }

      if (lightboxCloseBtn) lightboxCloseBtn.addEventListener('click', closeLightbox);
      if (lightboxModal) {
        lightboxModal.addEventListener('click', function(e) {
          if (e.target === lightboxModal) closeLightbox();
        });
      }
      if (lightboxPrevBtn) {
        lightboxPrevBtn.addEventListener('click', function() {
          if (currentLightboxUrls.length > 1) {
            currentLightboxIndex = (currentLightboxIndex - 1 + currentLightboxUrls.length) % currentLightboxUrls.length;
            renderLightboxPhoto();
          }
        });
      }
      if (lightboxNextBtn) {
        lightboxNextBtn.addEventListener('click', function() {
          if (currentLightboxUrls.length > 1) {
            currentLightboxIndex = (currentLightboxIndex + 1) % currentLightboxUrls.length;
            renderLightboxPhoto();
          }
        });
      }

      // ====================================================
      // LISTÍN DE DESPACHO PARA IMPRESIÓN DEL CHOFER
      // ====================================================
      function renderChoferListinTable() {
        var tbody = document.getElementById('chofer-listin-tbody');
        var totalGuiasEl = document.getElementById('chofer-listin-total-guias');
        var totalPiezasEl = document.getElementById('chofer-listin-total-piezas');
        var totalVolumenEl = document.getElementById('chofer-listin-total-volumen');
        var totalDestinosEl = document.getElementById('chofer-listin-total-destinos');

        var activeGuias = (guiasData || []).slice().sort(function(a, b) {
          if (a.orden_ruta && b.orden_ruta) return a.orden_ruta - b.orden_ruta;
          if (a.orden_ruta) return -1;
          if (b.orden_ruta) return 1;
          return (a.ciudad_destino || '').localeCompare(b.ciudad_destino || '');
        });

        var uniqueCities = Array.from(new Set(activeGuias.map(function(g) { return (g.ciudad_destino || '').trim(); }).filter(Boolean)));
        var totalGuias = activeGuias.length;
        var totalPiezas = activeGuias.reduce(function(acc, g) { return acc + (g.piezas || 1); }, 0);
        var totalVolumen = activeGuias.reduce(function(acc, g) { return acc + (Number(g.pies_cubicos) || 0); }, 0);

        if (totalGuiasEl) totalGuiasEl.textContent = totalGuias.toString();
        if (totalPiezasEl) totalPiezasEl.textContent = totalPiezas.toString();
        if (totalVolumenEl) totalVolumenEl.textContent = totalVolumen.toFixed(2) + ' ft³';
        if (totalDestinosEl) totalDestinosEl.textContent = uniqueCities.length.toString();

        var rowCount = Math.max(Math.ceil(activeGuias.length / 2), 20);
        var leftGuias = activeGuias.slice(0, rowCount);
        var rightGuias = activeGuias.slice(rowCount, rowCount * 2);

        var html = '';
        for (var i = 0; i < rowCount; i++) {
          var left = leftGuias[i];
          var right = rightGuias[i];

          var leftVol = left && left.pies_cubicos ? Number(left.pies_cubicos).toFixed(2) : (left ? '-' : '');
          var rightVol = right && right.pies_cubicos ? Number(right.pies_cubicos).toFixed(2) : (right ? '-' : '');

          html += '<tr class="h-6 border-b border-black/30 text-black">' +
              '<td class="py-1 px-1 border-r border-black font-mono font-bold text-center">' + (left ? left.id_guia : '') + '</td>' +
              '<td class="py-1 px-0.5 border-r border-black text-center font-bold">' + (left ? (left.piezas || 1) : '') + '</td>' +
              '<td class="py-1 px-0.5 border-r border-black text-center font-mono font-bold text-slate-700">' + leftVol + '</td>' +
              '<td class="py-1 px-1.5 border-r-2 border-black font-bold uppercase truncate max-w-[120px]">' + (left ? left.ciudad_destino : '') + '</td>' +
              '<td class="py-1 px-1 border-r border-black font-mono font-bold text-center">' + (right ? right.id_guia : '') + '</td>' +
              '<td class="py-1 px-0.5 border-r border-black text-center font-bold">' + (right ? (right.piezas || 1) : '') + '</td>' +
              '<td class="py-1 px-0.5 border-r border-black text-center font-mono font-bold text-slate-700">' + rightVol + '</td>' +
              '<td class="py-1 px-1.5 font-bold uppercase truncate max-w-[120px]">' + (right ? right.ciudad_destino : '') + '</td>' +
            '</tr>';
        }

        if (tbody) tbody.innerHTML = html;
      }

      window.openChoferListinModal = function() {
        renderChoferListinTable();
        var modal = document.getElementById('chofer-listin-modal');
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      };

      window.closeChoferListinModal = function() {
        var modal = document.getElementById('chofer-listin-modal');
        if (modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      };

      // ====================================================
      // LIVE SYNC SILENCIOSO (4.5s)
      // ====================================================
      var refreshBtn = document.getElementById('refresh-btn');
      var refreshIcon = document.getElementById('refresh-icon');

      async function syncGuias(showToastNotification) {
        if (isUploadingScans) return;
        if (refreshIcon) refreshIcon.classList.add('animate-spin');
        try {
          var res = await fetch('/api/chofer/guias');
          if (!res.ok) return;
          var json = await res.json();
          if (json.success && Array.isArray(json.data)) {
            guiasData = json.data;

            var noRoutesContainer = document.getElementById('no-routes-container');
            var activeRoutesContainer = document.getElementById('active-routes-container');

            if (guiasData.length === 0) {
              if (noRoutesContainer) noRoutesContainer.classList.remove('hidden');
              if (activeRoutesContainer) activeRoutesContainer.classList.add('hidden');
            } else {
              if (noRoutesContainer) noRoutesContainer.classList.add('hidden');
              if (activeRoutesContainer) activeRoutesContainer.classList.remove('hidden');
            }

            renderCards();
            if (showToastNotification) {
              showToast('Entregas actualizadas', 'success');
            }
          }
        } catch (err) {
          if (showToastNotification) {
            showToast('Error al conectar con el servidor', 'error');
          }
        } finally {
          if (refreshIcon) refreshIcon.classList.remove('animate-spin');
        }
      }

      if (refreshBtn) refreshBtn.addEventListener('click', function() { syncGuias(true); });

      // Polling de 4.5s
      setInterval(function() {
        syncGuias(false);
      }, 4500);

      // Inicialización en arranque
      document.addEventListener('DOMContentLoaded', function() {
        renderCards();
      });

      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        renderCards();
      }
    </script>
  </body>
</html>
