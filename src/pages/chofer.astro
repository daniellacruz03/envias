    <!-- ========================================== -->
    <!-- 7. SCRIPT CLIENTE DESACOPLADO Y MODULAR    -->
    <!-- ========================================== -->
    <script define:vars={{ initialGuias, targetChoferId }}>
      // ----------------------------------------------------
      // ESTADO GLOBAL
      // ----------------------------------------------------
      var currentChoferId = targetChoferId;
      var guiasData = initialGuias || [];
      var activeTab = 'pendientes';
      var searchQuery = '';
      var selectedCity = '';
      var activeModalGuiaId = null;
      var modalDeliveryMode = 'success';
      var currentCompressedBlob = null;
      var sessionScannedCount = 0;
      var isUploadingScans = false;

      // Elementos Toast
      var toastEl = document.getElementById('toast');
      var toastIconEl = document.getElementById('toast-icon');
      var toastMsgEl = document.getElementById('toast-message');
      var toastTimeout = null;

      function showToast(message, type) {
        if (!type) type = 'info';
        if (!toastEl || !toastMsgEl) return;
        if (toastTimeout) clearTimeout(toastTimeout);

        toastMsgEl.textContent = message;
        if (type === 'success') {
          toastEl.className = 'fixed bottom-4 left-1/2 -translate-x-1/2 z-50 bg-emerald-600 text-white px-4 py-2.5 rounded-2xl shadow-xl text-xs font-bold flex items-center gap-2 animate-fadeIn';
          if (toastIconEl) toastIconEl.innerHTML = '<svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>';
        } else if (type === 'error') {
          toastEl.className = 'fixed bottom-4 left-1/2 -translate-x-1/2 z-50 bg-rose-600 text-white px-4 py-2.5 rounded-2xl shadow-xl text-xs font-bold flex items-center gap-2 animate-fadeIn';
          if (toastIconEl) toastIconEl.innerHTML = '<svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>';
        } else {
          toastEl.className = 'fixed bottom-4 left-1/2 -translate-x-1/2 z-50 bg-slate-900 text-white px-4 py-2.5 rounded-2xl shadow-xl text-xs font-bold flex items-center gap-2 animate-fadeIn';
          if (toastIconEl) toastIconEl.innerHTML = '<svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
        }

        toastEl.classList.remove('hidden');
        toastTimeout = setTimeout(function() {
          if (toastEl) toastEl.classList.add('hidden');
        }, 4000);
      }

      function formatPhoneForWhatsApp(phone) {
        if (!phone) return '';
        var cleaned = phone.replace(/[^0-9]/g, '');
        if (cleaned.startsWith('0')) {
          cleaned = '58' + cleaned.substring(1);
        } else if (cleaned.length === 10 && !cleaned.startsWith('58')) {
          cleaned = '58' + cleaned;
        }
        return cleaned;
      }

      // ====================================================
      // MOTOR DE COMPRESIÓN CANVAS HTML5 (ZERO MEMORY LEAK)
      // ====================================================
      function compressImage(file, maxWidth, maxHeight, quality) {
        if (!maxWidth) maxWidth = 1280;
        if (!maxHeight) maxHeight = 1600;
        if (!quality) quality = 0.8;

        return new Promise(function(resolve) {
          if (!file) {
            resolve({ blob: null, dataUrl: '', sizeKb: 0 });
            return;
          }

          // Safety timeout: 3 segundos máximo para nunca bloquear el proceso
          var timer = setTimeout(function() {
            console.warn('[Compress Timeout]: Subiendo archivo directo');
            resolve({ blob: file, dataUrl: '', sizeKb: Math.round(file.size / 1024) });
          }, 3000);

          var objectUrl = '';
          try {
            objectUrl = URL.createObjectURL(file);
          } catch(e) {
            clearTimeout(timer);
            resolve({ blob: file, dataUrl: '', sizeKb: Math.round(file.size / 1024) });
            return;
          }

          var img = new Image();
          img.onload = function() {
            clearTimeout(timer);
            try {
              var width = img.naturalWidth || img.width;
              var height = img.naturalHeight || img.height;

              if (width > maxWidth || height > maxHeight) {
                if (width > height) {
                  height = Math.round((height * maxWidth) / width);
                  width = maxWidth;
                } else {
                  width = Math.round((width * maxHeight) / height);
                  height = maxHeight;
                }
              }

              var canvas = document.createElement('canvas');
              canvas.width = width;
              canvas.height = height;
              var ctx = canvas.getContext('2d');
              if (!ctx) {
                URL.revokeObjectURL(objectUrl);
                resolve({ blob: file, dataUrl: '', sizeKb: Math.round(file.size / 1024) });
                return;
              }
              ctx.drawImage(img, 0, 0, width, height);
              URL.revokeObjectURL(objectUrl);

              canvas.toBlob(function(blob) {
                if (blob) {
                  resolve({ blob: blob, dataUrl: '', sizeKb: Math.round(blob.size / 1024) });
                } else {
                  resolve({ blob: file, dataUrl: '', sizeKb: Math.round(file.size / 1024) });
                }
              }, 'image/jpeg', quality);
            } catch (canvasErr) {
              console.warn('[Canvas Compress Warning]:', canvasErr);
              URL.revokeObjectURL(objectUrl);
              resolve({ blob: file, dataUrl: '', sizeKb: Math.round(file.size / 1024) });
            }
          };
          img.onerror = function() {
            clearTimeout(timer);
            URL.revokeObjectURL(objectUrl);
            resolve({ blob: file, dataUrl: '', sizeKb: Math.round(file.size / 1024) });
          };
          img.src = objectUrl;
        });
      }

      // ====================================================
      // MÓDULO 1: ESCÁNER Y SUBIDA DE GUÍAS FÍSICAS
      // ====================================================
      var heroCameraInput = document.getElementById('hero-camera-input');
      var heroGalleryInput = document.getElementById('hero-gallery-input');
      var modalScanCameraInput = document.getElementById('modal-scan-camera-input');
      var modalScanGalleryInput = document.getElementById('modal-scan-gallery-input');
      var scanModal = document.getElementById('scan-modal');
      var scanModalCloseBtn = document.getElementById('scan-modal-close-btn');
      var btnHeaderScan = document.getElementById('btn-header-scan');

      var currentScanTargetMode = 'hero';

      function openScanModal() {
        if (scanModal) {
          scanModal.classList.remove('hidden');
          scanModal.classList.add('flex');
        }
        document.body.style.overflow = 'hidden';
      }
      function closeScanModal() {
        if (scanModal) {
          scanModal.classList.add('hidden');
          scanModal.classList.remove('flex');
        }
        document.body.style.overflow = '';
      }

      if (scanModalCloseBtn) scanModalCloseBtn.addEventListener('click', closeScanModal);
      if (btnHeaderScan) btnHeaderScan.addEventListener('click', openScanModal);
      if (scanModal) {
        scanModal.addEventListener('click', function(e) {
          if (e.target === scanModal) closeScanModal();
        });
      }

      // Manejador centralizado de archivos seleccionados
      async function handleScanFiles(files) {
        if (!files || files.length === 0) return;
        isUploadingScans = true;

        var total = files.length;
        var nowScan = new Date();
        var pad2 = function(n) { return n.toString().padStart(2, '0'); };
        var scanLoteId = 'chofer_' + nowScan.getFullYear() + pad2(nowScan.getMonth()+1) + pad2(nowScan.getDate()) + '_' + pad2(nowScan.getHours()) + pad2(nowScan.getMinutes());

        var isModal = currentScanTargetMode === 'modal';
        var liveSection = document.getElementById(isModal ? 'modal-scan-live-section' : 'hero-scan-live-section');
        var progressBar = document.getElementById(isModal ? 'modal-progress-bar' : 'hero-progress-bar');
        var progressLabel = document.getElementById(isModal ? 'modal-progress-label' : 'hero-progress-label');
        var progressCount = document.getElementById(isModal ? 'modal-progress-count' : 'hero-progress-count');
        var galleryGrid = document.getElementById(isModal ? 'modal-gallery-grid' : 'hero-gallery-grid');
        var galleryCount = document.getElementById(isModal ? 'modal-gallery-count' : 'hero-gallery-count');

        if (liveSection) liveSection.classList.remove('hidden');
        if (progressBar) progressBar.style.width = '0%';
        if (progressLabel) progressLabel.textContent = 'Procesando ' + total + ' foto' + (total !== 1 ? 's' : '') + '...';
        if (progressCount) progressCount.textContent = '0 / ' + total;
        showToast('Procesando ' + total + ' foto(s)...', 'info');

        var uploadedOk = 0;
        var processed = 0;

        try {
          for (var i = 0; i < files.length; i++) {
            var file = files[i];
            sessionScannedCount++;
            var itemIndex = sessionScannedCount;

            // Miniatura instantánea en el DOM con URL.createObjectURL
            var previewUrl = '';
            try {
              previewUrl = URL.createObjectURL(file);
            } catch(e) {}

            var thumbDiv = document.createElement('div');
            thumbDiv.id = 'scan-thumb-' + itemIndex;
            thumbDiv.className = 'relative aspect-square rounded-xl overflow-hidden bg-slate-100 border-2 border-slate-200 transition-all';
            thumbDiv.innerHTML = (previewUrl ? '<img src="' + previewUrl + '" class="w-full h-full object-cover" />' : '') +
              '<div id="scan-thumb-overlay-' + itemIndex + '" class="absolute inset-0 bg-black/50 flex items-center justify-center transition-opacity">' +
                '<svg class="w-5 h-5 text-white animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">' +
                  '<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>' +
                  '<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>' +
                '</svg>' +
              '</div>';

            if (galleryGrid) galleryGrid.prepend(thumbDiv);

            try {
              // Optimización con Canvas HTML5 (rápida y a prueba de fallos)
              var comp = await compressImage(file, 1280, 1600, 0.8);

              var formData = new FormData();
              formData.append('foto', comp.blob || file, file.name || 'escaneo.jpg');
              formData.append('lote_id', scanLoteId);

              var res = await fetch('/api/escaneos', {
                method: 'POST',
                body: formData,
                credentials: 'include'
              });
              var data = await res.json().catch(function() { return { success: false, message: 'Error de respuesta del servidor' }; });

              var overlay = document.getElementById('scan-thumb-overlay-' + itemIndex);
              if (res.ok && data.success) {
                uploadedOk++;
                thumbDiv.classList.replace('border-slate-200', 'border-emerald-400');
                if (overlay) {
                  overlay.innerHTML = '<svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>';
                  setTimeout(function(ov) { if (ov) ov.classList.add('opacity-0'); }, 700, overlay);
                }
              } else {
                thumbDiv.classList.replace('border-slate-200', 'border-rose-400');
                if (overlay) {
                  overlay.innerHTML = '<svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>';
                }
                showToast('Error: ' + (data.message || 'Error al guardar foto'), 'error');
              }
            } catch (err) {
              console.error('Error procesando escaneo:', err);
              var overlayErr = document.getElementById('scan-thumb-overlay-' + itemIndex);
              thumbDiv.classList.replace('border-slate-200', 'border-rose-400');
              if (overlayErr) {
                overlayErr.innerHTML = '<svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>';
              }
              showToast('Error de red al subir la foto', 'error');
            }

            processed++;
            var pct = Math.round((processed / total) * 100);
            if (progressBar) progressBar.style.width = pct + '%';
            if (progressCount) progressCount.textContent = processed + ' / ' + total;
          }
        } finally {
          isUploadingScans = false;
        }

        if (progressLabel) progressLabel.textContent = '¡' + uploadedOk + ' de ' + total + ' guías cargadas con éxito!';
        if (galleryCount && galleryGrid) galleryCount.textContent = galleryGrid.children.length + ' subidas';
        if (uploadedOk > 0) {
          showToast('¡' + uploadedOk + ' foto(s) enviada(s) a Logística!', 'success');
        }
      }

      // Event listeners seguros y asíncronos para los inputs de escaneo
      async function onFileInputChange(e, mode) {
        var input = e.target;
        var files = input.files ? Array.from(input.files) : [];
        if (files.length === 0) return;
        currentScanTargetMode = mode;
        try {
          await handleScanFiles(files);
        } catch (err) {
          console.error('Error en onFileInputChange:', err);
        } finally {
          input.value = '';
        }
      }

      if (heroCameraInput) heroCameraInput.addEventListener('change', function(e) { onFileInputChange(e, 'hero'); });
      if (heroGalleryInput) heroGalleryInput.addEventListener('change', function(e) { onFileInputChange(e, 'hero'); });
      if (modalScanCameraInput) modalScanCameraInput.addEventListener('change', function(e) { onFileInputChange(e, 'modal'); });
      if (modalScanGalleryInput) modalScanGalleryInput.addEventListener('change', function(e) { onFileInputChange(e, 'modal'); });

      // ====================================================
      // MÓDULO 2: CONFIRMACIÓN DE ENTREGA E INCIDENCIA
      // ====================================================
      var deliveryModal = document.getElementById('delivery-modal');
      var modalCloseBtn = document.getElementById('modal-close-btn');
      var modalCancelBtn = document.getElementById('modal-cancel-btn');
      var modalConfirmBtn = document.getElementById('modal-confirm-btn');
      var modalIncidentSubmitBtn = document.getElementById('modal-incident-submit-btn');
      var modalTabSuccessBtn = document.getElementById('modal-tab-success-btn');
      var modalTabIncidentBtn = document.getElementById('modal-tab-incident-btn');
      var modalPanelSuccess = document.getElementById('modal-panel-success');
      var modalPanelIncident = document.getElementById('modal-panel-incident');
      var modalTitleText = document.getElementById('modal-title-text');
      var modalGuiaCode = document.getElementById('modal-guia-code');
      var modalDestinatario = document.getElementById('modal-destinatario');
      var modalDireccion = document.getElementById('modal-direccion');
      var modalRecibidoPor = document.getElementById('modal-recibido-por');
      var modalIncidentNote = document.getElementById('modal-incident-note');
      var modalDeliveryPhotoCamera = document.getElementById('modal-delivery-photo-camera');
      var modalDeliveryPhotoGallery = document.getElementById('modal-delivery-photo-gallery');
      var modalDeliveryAddCamera = document.getElementById('modal-delivery-add-camera');
      var modalDeliveryAddGallery = document.getElementById('modal-delivery-add-gallery');
      var photoPlaceholder = document.getElementById('photo-placeholder');
      var photoPreviewContainer = document.getElementById('photo-preview-container');
      var deliveryPhotosGrid = document.getElementById('delivery-photos-grid');
      var photoCountBadge = document.getElementById('photo-count-badge');
      var photoSizeBadge = document.getElementById('photo-size-badge');

      var currentDeliveryPhotos = []; // array de { blob: Blob, file: File, sizeKb: number, previewUrl: string }

      function renderDeliveryPhotosGrid() {
        if (!deliveryPhotosGrid) return;
        var count = currentDeliveryPhotos.length;

        if (count === 0) {
          if (photoPlaceholder) photoPlaceholder.classList.remove('hidden');
          if (photoPreviewContainer) photoPreviewContainer.classList.add('hidden');
          if (modalConfirmBtn) modalConfirmBtn.disabled = true;
          return;
        }

        if (photoPlaceholder) photoPlaceholder.classList.add('hidden');
        if (photoPreviewContainer) photoPreviewContainer.classList.remove('hidden');
        if (modalConfirmBtn) modalConfirmBtn.disabled = false;

        var totalKb = currentDeliveryPhotos.reduce(function(acc, p) { return acc + (p.sizeKb || 0); }, 0);
        if (photoCountBadge) {
          photoCountBadge.textContent = count + ' foto' + (count !== 1 ? 's' : '') + ' seleccionada' + (count !== 1 ? 's' : '');
        }
        if (photoSizeBadge) {
          photoSizeBadge.textContent = '~' + totalKb + ' KB total';
          photoSizeBadge.classList.remove('hidden');
        }

        var html = '';
        currentDeliveryPhotos.forEach(function(item, idx) {
          html += '<div class="relative group rounded-xl overflow-hidden border border-slate-300 bg-white aspect-square flex items-center justify-center shadow-2xs">' +
              '<img src="' + item.previewUrl + '" alt="Foto ' + (idx + 1) + '" class="w-full h-full object-cover" />' +
              '<span class="absolute top-1 left-1 bg-slate-900/80 text-white font-mono text-[9px] font-bold px-1.5 py-0.2 rounded-md shadow-xs">#' + (idx + 1) + '</span>' +
              '<button type="button" onclick="window.removeDeliveryPhoto(' + idx + ')" class="absolute top-1 right-1 w-5 h-5 bg-rose-600 hover:bg-rose-700 text-white rounded-full flex items-center justify-center shadow-xs cursor-pointer transition-all" title="Eliminar esta foto">' +
                '<svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>' +
              '</button>' +
              '<span class="absolute bottom-1 right-1 bg-black/70 text-white font-mono text-[8px] px-1 rounded">' + item.sizeKb + 'KB</span>' +
            '</div>';
        });

        deliveryPhotosGrid.innerHTML = html;
      }

      window.removeDeliveryPhoto = function(idx) {
        if (idx >= 0 && idx < currentDeliveryPhotos.length) {
          var removed = currentDeliveryPhotos.splice(idx, 1)[0];
          if (removed && removed.previewUrl) {
            try { URL.revokeObjectURL(removed.previewUrl); } catch(e) {}
          }
          renderDeliveryPhotosGrid();
        }
      };

      function resetDeliveryPhotoState() {
        currentDeliveryPhotos.forEach(function(p) {
          if (p.previewUrl) {
            try { URL.revokeObjectURL(p.previewUrl); } catch(e) {}
          }
        });
        currentDeliveryPhotos = [];
        if (modalDeliveryPhotoCamera) modalDeliveryPhotoCamera.value = '';
        if (modalDeliveryPhotoGallery) modalDeliveryPhotoGallery.value = '';
        if (modalDeliveryAddCamera) modalDeliveryAddCamera.value = '';
        if (modalDeliveryAddGallery) modalDeliveryAddGallery.value = '';
        renderDeliveryPhotosGrid();
      }
      window.resetDeliveryPhotoState = resetDeliveryPhotoState;

      async function handleDeliveryFilesSelected(files) {
        if (!files || files.length === 0) return;

        if (photoCountBadge) photoCountBadge.textContent = 'Comprimiendo ' + files.length + ' foto(s)...';
        if (modalConfirmBtn) modalConfirmBtn.disabled = true;

        for (var i = 0; i < files.length; i++) {
          var file = files[i];
          try {
            var result = await compressImage(file, 1200, 1600, 0.75);
            var blob = result.blob || file;
            var previewUrl = URL.createObjectURL(blob);
            currentDeliveryPhotos.push({
              file: file,
              blob: blob,
              sizeKb: result.sizeKb,
              previewUrl: previewUrl
            });
          } catch (err) {
            console.error('Error optimizando foto:', err);
          }
        }

        renderDeliveryPhotosGrid();
      }

      if (modalDeliveryPhotoCamera) {
        modalDeliveryPhotoCamera.addEventListener('change', function(e) {
          var files = e.target.files ? Array.from(e.target.files) : [];
          handleDeliveryFilesSelected(files);
          e.target.value = '';
        });
      }
      if (modalDeliveryPhotoGallery) {
        modalDeliveryPhotoGallery.addEventListener('change', function(e) {
          var files = e.target.files ? Array.from(e.target.files) : [];
          handleDeliveryFilesSelected(files);
          e.target.value = '';
        });
      }
      if (modalDeliveryAddCamera) {
        modalDeliveryAddCamera.addEventListener('change', function(e) {
          var files = e.target.files ? Array.from(e.target.files) : [];
          handleDeliveryFilesSelected(files);
          e.target.value = '';
        });
      }
      if (modalDeliveryAddGallery) {
        modalDeliveryAddGallery.addEventListener('change', function(e) {
          var files = e.target.files ? Array.from(e.target.files) : [];
          handleDeliveryFilesSelected(files);
          e.target.value = '';
        });
      }

      function setDeliveryModalMode(mode) {
        modalDeliveryMode = mode;
        if (mode === 'success') {
          if (modalTabSuccessBtn) modalTabSuccessBtn.className = 'py-2 px-2 text-xs font-bold rounded-xl transition-all flex items-center justify-center gap-1.5 bg-white text-slate-900 shadow-xs cursor-pointer';
          if (modalTabIncidentBtn) modalTabIncidentBtn.className = 'py-2 px-2 text-xs font-semibold rounded-xl transition-all flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900 cursor-pointer';
          if (modalPanelSuccess) modalPanelSuccess.classList.remove('hidden');
          if (modalPanelIncident) modalPanelIncident.classList.add('hidden');
          if (modalConfirmBtn) modalConfirmBtn.classList.remove('hidden');
          if (modalIncidentSubmitBtn) modalIncidentSubmitBtn.classList.add('hidden');
          if (modalTitleText) modalTitleText.textContent = 'Confirmar Entrega Realizada';
        } else {
          if (modalTabIncidentBtn) modalTabIncidentBtn.className = 'py-2 px-2 text-xs font-bold rounded-xl transition-all flex items-center justify-center gap-1.5 bg-white text-rose-900 shadow-xs cursor-pointer';
          if (modalTabSuccessBtn) modalTabSuccessBtn.className = 'py-2 px-2 text-xs font-semibold rounded-xl transition-all flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900 cursor-pointer';
          if (modalPanelSuccess) modalPanelSuccess.classList.add('hidden');
          if (modalPanelIncident) modalPanelIncident.classList.remove('hidden');
          if (modalConfirmBtn) modalConfirmBtn.classList.add('hidden');
          if (modalIncidentSubmitBtn) modalIncidentSubmitBtn.classList.remove('hidden');
          if (modalTitleText) modalTitleText.textContent = 'Reportar Incidencia de Entrega';
        }
      }

      if (modalTabSuccessBtn) modalTabSuccessBtn.addEventListener('click', function() { setDeliveryModalMode('success'); });
      if (modalTabIncidentBtn) modalTabIncidentBtn.addEventListener('click', function() { setDeliveryModalMode('incident'); });

      window.openDeliveryModal = function(idGuia, destinatario, direccion, stopNumber, guiasLabel, totalPiezas, totalVolumen) {
        activeModalGuiaId = idGuia;
        var label = guiasLabel || ('#' + idGuia);
        var piezasStr = totalPiezas ? ' • ' + totalPiezas + ' pza(s)' : '';
        var volStr = totalVolumen ? ' • ' + Number(totalVolumen).toFixed(2) + ' ft³' : '';
        if (modalGuiaCode) modalGuiaCode.textContent = 'Parada #' + stopNumber + ' • ' + label + piezasStr + volStr;
        if (modalDestinatario) modalDestinatario.textContent = destinatario;
        if (modalDireccion) modalDireccion.textContent = direccion || 'Ubicación confirmada';
        if (modalRecibidoPor) modalRecibidoPor.value = '';
        if (modalIncidentNote) modalIncidentNote.value = '';
        setDeliveryModalMode('success');
        resetDeliveryPhotoState();
        if (deliveryModal) {
          deliveryModal.classList.remove('hidden');
          deliveryModal.classList.add('flex');
        }
      };

      function closeDeliveryModal() {
        if (deliveryModal) {
          deliveryModal.classList.add('hidden');
          deliveryModal.classList.remove('flex');
        }
        activeModalGuiaId = null;
        resetDeliveryPhotoState();
      }

      if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeDeliveryModal);
      if (modalCancelBtn) modalCancelBtn.addEventListener('click', closeDeliveryModal);

      // Submit Confirmar Entrega (Múltiples Fotos)
      if (modalConfirmBtn) {
        modalConfirmBtn.addEventListener('click', async function() {
          if (!activeModalGuiaId) return;
          if (!currentDeliveryPhotos || currentDeliveryPhotos.length === 0) {
            showToast('Debes tomar o subir al menos una foto del comprobante', 'error');
            return;
          }

          modalConfirmBtn.disabled = true;
          var originalHtml = modalConfirmBtn.innerHTML;
          modalConfirmBtn.innerHTML = '<svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg><span>Subiendo ' + currentDeliveryPhotos.length + ' foto(s)...</span>';

          try {
            var formData = new FormData();
            formData.append('id_guia', activeModalGuiaId);
            formData.append('tipo_resultado', 'entregado');
            formData.append('recibido_por', modalRecibidoPor ? modalRecibidoPor.value.trim() : '');

            // Añadir todas las fotos comprimidas
            currentDeliveryPhotos.forEach(function(item, idx) {
              formData.append('fotos', item.blob, item.file.name || ('comprobante_' + idx + '.jpg'));
            });
            // Compatibilidad retroactiva con endpoint antiguo
            formData.append('foto', currentDeliveryPhotos[0].blob, 'comprobante_0.jpg');

            var res = await fetch('/api/chofer/entregar', {
              method: 'POST',
              body: formData
            });
            var data = await res.json().catch(function() { return { success: false, message: 'Error de respuesta del servidor' }; });

            if (res.ok && data.success) {
              var deliveredIds = activeModalGuiaId.split(',').map(function(s) { return s.trim(); });
              deliveredIds.forEach(function(gId) {
                var idx = guiasData.findIndex(function(g) { return g.id_guia === gId; });
                if (idx !== -1) {
                  guiasData[idx].estado = 'Entregado';
                  guiasData[idx].comprobante_url = data.data ? data.data.comprobante_url : null;
                  guiasData[idx].recibido_por = data.data ? data.data.recibido_por : null;
                }
              });

              closeDeliveryModal();
              renderCards();
              updateMapMarkers();
              showToast(data.message || '¡Entrega confirmada y fotos guardadas!', 'success');
            } else {
              showToast(data.message || 'Error al registrar entrega', 'error');
              modalConfirmBtn.disabled = false;
              modalConfirmBtn.innerHTML = originalHtml;
            }
          } catch (err) {
            console.error('Error confirmando entrega:', err);
            showToast('Error de red al guardar entrega', 'error');
            modalConfirmBtn.disabled = false;
            modalConfirmBtn.innerHTML = originalHtml;
          }
        });
      }

      // Submit Incidencia
      if (modalIncidentSubmitBtn) {
        modalIncidentSubmitBtn.addEventListener('click', async function() {
          if (!activeModalGuiaId) return;
          var note = modalIncidentNote ? modalIncidentNote.value.trim() : '';
          if (!note) {
            showToast('Debes ingresar el motivo de la incidencia', 'error');
            return;
          }

          modalIncidentSubmitBtn.disabled = true;
          try {
            var formData = new FormData();
            formData.append('id_guia', activeModalGuiaId);
            formData.append('tipo_resultado', 'no_entregado');
            formData.append('nota_incidencia', note);

            var res = await fetch('/api/chofer/entregar', {
              method: 'POST',
              body: formData
            });
            var data = await res.json().catch(function() { return { success: false, message: 'Error de respuesta' }; });

            if (res.ok && data.success) {
              var deliveredIds = activeModalGuiaId.split(',').map(function(s) { return s.trim(); });
              deliveredIds.forEach(function(gId) {
                var idx = guiasData.findIndex(function(g) { return g.id_guia === gId; });
                if (idx !== -1) {
                  guiasData[idx].estado = 'No entregado';
                }
              });

              closeDeliveryModal();
              renderCards();
              updateMapMarkers();
              showToast('Incidencia registrada', 'info');
            } else {
              showToast(data.message || 'Error al registrar incidencia', 'error');
            }
          } catch (err) {
            showToast('Error de red', 'error');
          } finally {
            modalIncidentSubmitBtn.disabled = false;
          }
        });
      }

      // Selección rápida de motivo de incidencia
      document.querySelectorAll('#incident-reasons-grid .incident-opt').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          var reason = e.currentTarget.getAttribute('data-reason');
          if (modalIncidentNote && reason) {
            modalIncidentNote.value = reason;
          }
        });
      });

      // ====================================================
      // MÓDULO 3: HOJA DE RUTA, PARADAS Y MAPA LEAFLET
      // ====================================================
      var cardsContainer = document.getElementById('cards-container');
      var emptyState = document.getElementById('empty-state');
      var searchInput = document.getElementById('search-input');
      var cityFilter = document.getElementById('city-filter');
      var tabPendientes = document.getElementById('tab-pendientes');
      var tabEntregados = document.getElementById('tab-entregados');
      var tabNoEntregados = document.getElementById('tab-no-entregados');
      var tabTodos = document.getElementById('tab-todos');
      var badgeTabPendientes = document.getElementById('badge-tab-pendientes');
      var badgeTabEntregados = document.getElementById('badge-tab-entregados');
      var badgeTabNoEntregados = document.getElementById('badge-tab-no-entregados');
      var badgeTabTodos = document.getElementById('badge-tab-todos');
      var statPendientes = document.getElementById('stat-pendientes');
      var statEntregados = document.getElementById('stat-entregados');
      var statNoEntregados = document.getElementById('stat-no-entregados');
      var statTotal = document.getElementById('stat-total');
      var progressText = document.getElementById('progress-text');
      var progressBarFill = document.getElementById('progress-bar-fill');

      function normalizeClientName(name) {
        if (!name) return '';
        return name
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
      }

      function getClientStopKey(guia) {
        var normName = normalizeClientName(guia.destinatario);
        var normCity = normalizeClientName(guia.ciudad_destino);
        return normName + '|' + normCity;
      }

      function buildClientStops(guiasList) {
        var stopsMap = {};
        var stopsOrder = [];

        (guiasList || []).forEach(function(g) {
          var key = getClientStopKey(g);
          if (!stopsMap[key]) {
            stopsMap[key] = {
              key: key,
              destinatario: g.destinatario || 'Destinatario',
              ciudad_destino: g.ciudad_destino || '',
              telefono_principal: g.telefono_principal || '',
              telefono_secundario: g.telefono_secundario || null,
              direccion_referencia: g.direccion_referencia || '',
              hora_disponible: g.hora_disponible || '',
              gps_latitud: g.gps_latitud || null,
              gps_longitud: g.gps_longitud || null,
              gps_confirmado: g.gps_confirmado === true,
              orden_ruta: g.orden_ruta && g.orden_ruta > 0 ? g.orden_ruta : null,
              guias: [],
              totalPiezas: 0,
              totalPiesCubicos: 0,
              comprobante_url: null,
              comprobante_base64: null,
              recibido_por: null,
              estado: 'Por contactar'
            };
            stopsOrder.push(stopsMap[key]);
          }

          var stop = stopsMap[key];
          stop.guias.push(g);
          stop.totalPiezas += (parseInt(g.piezas, 10) || 1);
          if (g.pies_cubicos) {
            stop.totalPiesCubicos += parseFloat(g.pies_cubicos) || 0;
          }

          if (!stop.gps_latitud && g.gps_latitud) {
            stop.gps_latitud = g.gps_latitud;
            stop.gps_longitud = g.gps_longitud;
            stop.gps_confirmado = g.gps_confirmado === true;
          }
          if (!stop.direccion_referencia && g.direccion_referencia) {
            stop.direccion_referencia = g.direccion_referencia;
          }
          if (!stop.telefono_secundario && g.telefono_secundario) {
            stop.telefono_secundario = g.telefono_secundario;
          }
          if (!stop.ciudad_destino && g.ciudad_destino) {
            stop.ciudad_destino = g.ciudad_destino;
          }
          if (!stop.hora_disponible && g.hora_disponible) {
            stop.hora_disponible = g.hora_disponible;
          }
          if (g.orden_ruta && g.orden_ruta > 0) {
            if (!stop.orden_ruta || g.orden_ruta < stop.orden_ruta) {
              stop.orden_ruta = g.orden_ruta;
            }
          }
          if (g.comprobante_url) stop.comprobante_url = g.comprobante_url;
          if (g.comprobante_base64) stop.comprobante_base64 = g.comprobante_base64;
          if (g.recibido_por) stop.recibido_por = g.recibido_por;
        });

        // Determinar estado consolidado y metadatos
        stopsOrder.forEach(function(stop) {
          stop.totalGuias = stop.guias.length;
          var allDelivered = stop.guias.length > 0 && stop.guias.every(function(g) { return g.estado === 'Entregado'; });
          var allIncidents = stop.guias.length > 0 && stop.guias.every(function(g) { return g.estado === 'No entregado'; });
          var anyDelivered = stop.guias.some(function(g) { return g.estado === 'Entregado'; });

          if (allDelivered) {
            stop.estado = 'Entregado';
          } else if (allIncidents) {
            stop.estado = 'No entregado';
          } else if (anyDelivered) {
            stop.estado = 'Parcial';
          } else {
            stop.estado = 'En ruta';
          }

          stop.guiasIds = stop.guias.map(function(g) { return g.id_guia; }).join(',');
          stop.guiasLabel = stop.guias.map(function(g) { return '#' + g.id_guia; }).join(', ');
        });

        return stopsOrder;
      }

      function updateStats() {
        var stops = buildClientStops(guiasData);
        var total = stops.length;
        var entregados = stops.filter(function(s) { return s.estado === 'Entregado'; }).length;
        var noEntregados = stops.filter(function(s) { return s.estado === 'No entregado'; }).length;
        var pendientes = stops.filter(function(s) { return s.estado !== 'Entregado' && s.estado !== 'No entregado'; }).length;
        var pct = total > 0 ? Math.round((entregados / total) * 100) : 0;
        var totalGuiasCount = guiasData.length;

        if (statPendientes) statPendientes.textContent = pendientes;
        if (statEntregados) statEntregados.textContent = entregados;
        if (statNoEntregados) statNoEntregados.textContent = noEntregados;
        if (statTotal) statTotal.textContent = total;

        if (badgeTabPendientes) badgeTabPendientes.textContent = pendientes;
        if (badgeTabEntregados) badgeTabEntregados.textContent = entregados;
        if (badgeTabNoEntregados) badgeTabNoEntregados.textContent = noEntregados;
        if (badgeTabTodos) badgeTabTodos.textContent = total;

        if (progressText) progressText.textContent = entregados + ' de ' + total + ' paradas (' + totalGuiasCount + ' guías totales • ' + pct + '%)';
        if (progressBarFill) progressBarFill.style.width = pct + '%';
      }

      function getFilteredClientStops() {
        var q = (searchQuery || '').toLowerCase().trim();
        var allStops = buildClientStops(guiasData);

        return allStops.filter(function(stop) {
          var matchTab = 
            activeTab === 'todos' ? true :
            activeTab === 'entregados' ? stop.estado === 'Entregado' :
            activeTab === 'no_entregados' ? stop.estado === 'No entregado' :
            (stop.estado !== 'Entregado' && stop.estado !== 'No entregado');

          var matchCity = !selectedCity || stop.ciudad_destino === selectedCity;
          
          var matchQuery = !q || 
            (stop.destinatario && stop.destinatario.toLowerCase().includes(q)) ||
            (stop.direccion_referencia && stop.direccion_referencia.toLowerCase().includes(q)) ||
            (stop.telefono_principal && stop.telefono_principal.includes(q)) ||
            stop.guias.some(function(g) { return g.id_guia && g.id_guia.toLowerCase().includes(q); });

          return matchTab && matchCity && matchQuery;
        });
      }

      window.scrollToCards = function() {
        var el = document.getElementById('search-input') || document.getElementById('cards-container');
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
