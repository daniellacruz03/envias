            </label>
            <textarea id="modal-incident-note" rows="2" placeholder="Escribe detalles del intento de entrega..." class="w-full bg-white border border-slate-200 rounded-2xl p-3 text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 resize-none"></textarea>
          </div>
        </div>

        <!-- Botones del Modal -->
        <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-100">
          <button type="button" id="modal-cancel-btn" class="py-3 px-4 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition-colors cursor-pointer text-center">
            Cancelar
          </button>
          
          <button type="button" id="modal-confirm-btn" class="py-3 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs transition-all shadow-md shadow-emerald-600/20 cursor-pointer text-center flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
