      function updateLoteControls() {
        let currentWeekCount = 0;
        let pastPendingCount = 0;
        let deliveredReadyCount = 0;
        const loteMap: Record<string, number> = {};

        shipments.forEach(g => {
          const info = getGuiaWeekInfo(g);
          if (g.estado === 'No entregado') {
            pastPendingCount++;
          } else if (info.isCurrentWeek) {
            currentWeekCount++;
          }
          if (g.estado === 'Entregado') deliveredReadyCount++;

          const code = g.lote_despacho || info.loteCode;
          loteMap[code] = (loteMap[code] || 0) + 1;
        });

        if (badgeCountCurrentWeek) badgeCountCurrentWeek.textContent = currentWeekCount.toString();
        if (badgeCountPastPending) badgeCountPastPending.textContent = pastPendingCount.toString();
        if (badgeCountDeliveredReady) badgeCountDeliveredReady.textContent = deliveredReadyCount.toString();

        if (filterLoteSelect) {
          const prevVal = filterLoteSelect.value;
          let opts = `
            <option value="ALL">Todos los Lotes (${shipments.length} guías)</option>
            <option value="CURRENT_WEEK">Carga Semana Actual (${currentWeekCount} guías)</option>
            <option value="PENDING_PAST">No Entregadas / Rezagadas (${pastPendingCount} guías)</option>
          `;
          const sortedLotes = Object.keys(loteMap).sort().reverse();
          if (sortedLotes.length > 0) {
            opts += `<optgroup label="Lotes / Manifiestos Detectados">`;
            sortedLotes.forEach(lote => {
              opts += `<option value="${lote}">${lote} (${loteMap[lote]} guías)</option>`;
            });
            opts += `</optgroup>`;
          }
          filterLoteSelect.innerHTML = opts;
          if (prevVal && (prevVal === 'ALL' || prevVal === 'CURRENT_WEEK' || prevVal === 'PENDING_PAST' || loteMap[prevVal])) {
            filterLoteSelect.value = prevVal;
          } else {
            filterLoteSelect.value = currentLoteFilter;
          }
        }

        const lotesDatalist = document.getElementById('lotes-datalist');
        if (lotesDatalist) {
          lotesDatalist.innerHTML = Object.keys(loteMap).sort().reverse().map(l => `<option value="${l}">`).join('');
        }

        // Sincronizar selector de lote en el módulo de Listín de Despacho
        const listinLoteSelect = document.getElementById('listin-lote-select') as HTMLSelectElement;
        const listinLoteCountBadge = document.getElementById('listin-lote-count-badge');
        if (listinLoteSelect) {
