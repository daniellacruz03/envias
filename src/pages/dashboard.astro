                      </span>

                      ${gpsCount > 0 ? `
                        <span class="text-xs font-bold px-2.5 py-1 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200 inline-flex items-center gap-1">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                          <span>${gpsCount} con GPS</span>
                        </span>
                      ` : ''}
                    </div>

                    <!-- Píldoras de estado -->
                    <div class="flex items-center gap-1.5 flex-wrap mt-1.5 text-[11px]">
                      ${porContactarCount > 0 ? `<span class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-700 border border-amber-200 font-semibold">${porContactarCount} Por contactar</span>` : ''}
                      ${contactadoCount > 0 ? `<span class="px-2 py-0.5 rounded-md bg-sky-50 text-sky-700 border border-sky-200 font-semibold">${contactadoCount} Contactado</span>` : ''}
                      ${enRutaCount > 0 ? `<span class="px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700 border border-indigo-200 font-semibold">${enRutaCount} En ruta</span>` : ''}
                      ${entregadoCount > 0 ? `<span class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200 font-semibold">${entregadoCount} Entregado</span>` : ''}
                      ${cityGuias.filter(g => g.estado === 'No entregado').length > 0 ? `<span class="px-2 py-0.5 rounded-md bg-rose-50 text-rose-700 border border-rose-200 font-semibold">${cityGuias.filter(g => g.estado === 'No entregado').length} No entregado</span>` : ''}
