      // Función: renderizar chips de lotes de carga
      function renderLoteChips() {
        const chipsContainer = document.getElementById('planner-lote-chips');
        if (!chipsContainer) return;

        const activeShipments = getActivePlannerShipments();
        if (activeShipments.length === 0) {
          chipsContainer.innerHTML = '<span class="text-[11px] text-slate-400 italic">No hay guías activas para agrupar por lote.</span>';
          return;
        }

        const loteCounts: Record<string, { total: number; conGps: number; isCurrentWeek?: boolean; isPastPending?: boolean }> = {};
        let currentWeekTotal = 0;
        let currentWeekGps = 0;
        let pastPendingTotal = 0;
        let pastPendingGps = 0;

        activeShipments.forEach(g => {
          const info = getGuiaWeekInfo(g);
          const code = getGuiaLoteCode(g);
          const hasGps = Boolean(
            g.gps_confirmado && g.gps_latitud != null && g.gps_longitud != null &&
            !isNaN(Number(g.gps_latitud)) && !isNaN(Number(g.gps_longitud))
          );

          if (g.estado === 'No entregado') {
            pastPendingTotal++;
            if (hasGps) pastPendingGps++;
          } else if (info.isCurrentWeek) {
            currentWeekTotal++;
            if (hasGps) currentWeekGps++;
          }

          if (!loteCounts[code]) {
            loteCounts[code] = { total: 0, conGps: 0, isCurrentWeek: info.isCurrentWeek, isPastPending: g.estado === 'No entregado' };
          }
          loteCounts[code].total++;
          if (hasGps) loteCounts[code].conGps++;
        });

        const isAllSelected = selectedLotes.size === 0 || selectedLotes.has('ALL');
        const isCurrentWeekSelected = selectedLotes.has('CURRENT_WEEK');
        const isPastPendingSelected = selectedLotes.has('PENDING_PAST');

        let html = `
          <!-- Todos los lotes -->
          <button
            type="button"
            onclick="window.toggleLoteChip('ALL')"
            class="lote-chip inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-[11px] font-bold border transition-all cursor-pointer ${
              isAllSelected
                ? 'bg-purple-700 border-purple-800 text-white shadow-xs'
                : 'bg-white border-slate-200 text-slate-700 hover:border-purple-400 hover:text-purple-700 hover:bg-purple-50'
            }"
          >
            <span>Todos los Lotes</span>
            <span class="text-[10px] font-black ${isAllSelected ? 'text-purple-200' : 'text-slate-400'}">${activeShipments.length}g</span>
          </button>

          <!-- Semana Actual -->
          <button
            type="button"
            onclick="window.toggleLoteChip('CURRENT_WEEK')"
            class="lote-chip inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-[11px] font-bold border transition-all cursor-pointer ${
              isCurrentWeekSelected
                ? 'bg-blue-600 border-blue-700 text-white shadow-xs'
                : 'bg-white border-slate-200 text-slate-700 hover:border-blue-400 hover:text-blue-700 hover:bg-blue-50'
            }"
          >
            <span>Semana Actual</span>
            <span class="text-[10px] font-black ${isCurrentWeekSelected ? 'text-blue-200' : 'text-slate-400'}">${currentWeekTotal}g/${currentWeekGps}GPS</span>
          </button>
        `;

        if (pastPendingTotal > 0) {
          html += `
            <!-- Rezagadas -->
            <button
              type="button"
              onclick="window.toggleLoteChip('PENDING_PAST')"
              class="lote-chip inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-[11px] font-bold border transition-all cursor-pointer ${
                isPastPendingSelected
                  ? 'bg-amber-600 border-amber-700 text-white shadow-xs'
                  : 'bg-white border-slate-200 text-slate-700 hover:border-amber-400 hover:text-amber-700 hover:bg-amber-50'
              }"
            >
              <span>Rezagadas</span>
              <span class="text-[10px] font-black ${isPastPendingSelected ? 'text-amber-200' : 'text-slate-400'}">${pastPendingTotal}g/${pastPendingGps}GPS</span>
            </button>
          `;
        }

        const sortedLotes = Object.keys(loteCounts).sort();
        sortedLotes.forEach(loteCode => {
          const data = loteCounts[loteCode];
          const isSelected = selectedLotes.has(loteCode);

          html += `
            <button
              type="button"
              data-lote="${loteCode}"
              onclick="window.toggleLoteChip('${loteCode.replace(/'/g, "\\'")}')"
              class="lote-chip inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-[11px] font-bold border transition-all cursor-pointer ${
                isSelected
                  ? 'bg-purple-600 border-purple-700 text-white shadow-xs'
                  : 'bg-white border-slate-200 text-slate-700 hover:border-purple-400 hover:text-purple-700 hover:bg-purple-50'
              }"
            >
              <span class="font-mono">${loteCode}</span>
              <span class="text-[10px] font-black ${isSelected ? 'text-purple-200' : 'text-slate-400'}">${data.total}g/${data.conGps}GPS</span>
            </button>
          `;
        });

        chipsContainer.innerHTML = html;

        // Sincronizar selector desplegable de lote
        const plannerLoteSelect = document.getElementById('planner-lote-select') as HTMLSelectElement;
        if (plannerLoteSelect) {
          const currentSingle = selectedLotes.size === 1 ? [...selectedLotes][0] : (selectedLotes.size === 0 || selectedLotes.has('ALL') ? 'ALL' : '');
          if (currentSingle && Array.from(plannerLoteSelect.options).some(o => o.value === currentSingle)) {
            plannerLoteSelect.value = currentSingle;
          }
        }

        // Actualizar visibilidad de botones y label de lotes seleccionados
        const clearBtn = document.getElementById('planner-lote-clear-btn');
        const selectAllBtn = document.getElementById('planner-lote-select-all-btn');
        const displayEl = document.getElementById('planner-selected-lotes-display');
        const labelsEl = document.getElementById('planner-selected-lotes-labels');

        if (!isAllSelected && selectedLotes.size > 0) {
          if (clearBtn) clearBtn.classList.remove('hidden');
          if (selectAllBtn) selectAllBtn.classList.remove('hidden');
          if (displayEl) displayEl.classList.remove('hidden');
          if (labelsEl) {
            const labels = [...selectedLotes].map(l => {
              if (l === 'CURRENT_WEEK') return 'Semana Actual';
              if (l === 'PENDING_PAST') return 'Rezagadas';
              return l;
            });
            labelsEl.textContent = labels.join(' + ');
          }
        } else {
          if (clearBtn) clearBtn.classList.add('hidden');
          if (selectAllBtn) selectAllBtn.classList.add('hidden');
          if (displayEl) displayEl.classList.add('hidden');
        }
      }

      // Función: Poblar opciones del selector desplegable de lote del planificador
      function populatePlannerLoteSelect(selectedVal?: string | null) {
        const select = document.getElementById('planner-lote-select') as HTMLSelectElement;
        if (!select) return;

        const activeShipments = getActivePlannerShipments();
        const loteCounts: Record<string, number> = {};
        let currentWeekTotal = 0;
        let pastPendingTotal = 0;

        activeShipments.forEach(g => {
          const info = getGuiaWeekInfo(g);
          const code = getGuiaLoteCode(g);
          if (g.estado === 'No entregado') {
            pastPendingTotal++;
          } else if (info.isCurrentWeek) {
            currentWeekTotal++;
          }
          loteCounts[code] = (loteCounts[code] || 0) + 1;
        });

        let opts = `
          <option value="ALL">Todos los Lotes (${activeShipments.length} guías)</option>
          <option value="CURRENT_WEEK">Carga Semana Actual (${currentWeekTotal} guías)</option>
        `;
        if (pastPendingTotal > 0) {
          opts += `<option value="PENDING_PAST">Rezagadas / No Entregadas (${pastPendingTotal} guías)</option>`;
        }

        const sortedLotes = Object.keys(loteCounts).sort();
        if (sortedLotes.length > 0) {
          opts += `<optgroup label="Lotes de Despacho Específicos">`;
          sortedLotes.forEach(lote => {
            opts += `<option value="${lote}">${lote} (${loteCounts[lote]} guías)</option>`;
          });
          opts += `</optgroup>`;
        }

        select.innerHTML = opts;
        const targetVal = selectedVal || 'ALL';
        if (Array.from(select.options).some(o => o.value === targetVal)) {
          select.value = targetVal;
        } else {
          select.value = 'ALL';
        }
      }

      // Función: Evento de cambio en el selector desplegable de lote del planificador
      window.onPlannerLoteSelectChange = function(loteKey: string) {
        selectedLotes.clear();
        selectedLotes.add(loteKey || 'ALL');

        // Si se selecciona un lote específico, semana actual o rezagadas, pre-seleccionar automáticamente sus ciudades
        if (loteKey && loteKey !== 'ALL') {
          const activeShipments = getActivePlannerShipments();
          const filteredByLote = filterShipmentsBySelectedLotes(activeShipments);
          const loteZones = [...new Set(filteredByLote.map(g => (g.ciudad_destino || '').trim()).filter(Boolean))];
          selectedZones.clear();
          loteZones.forEach(z => selectedZones.add(z));
        }

        renderLoteChips();
        renderZoneChips();
        actualizarCircuitoDesdeZonas();
      };

      // Función: toggle de chip de lote
      window.toggleLoteChip = function(loteKey: string) {
        if (loteKey === 'ALL') {
          selectedLotes.clear();
          selectedLotes.add('ALL');
        } else {
          selectedLotes.delete('ALL');
          if (selectedLotes.has(loteKey)) {
            selectedLotes.delete(loteKey);
            if (selectedLotes.size === 0) {
              selectedLotes.add('ALL');
            }
          } else {
            selectedLotes.add(loteKey);
          }
        }
        renderLoteChips();
        renderZoneChips();
        actualizarCircuitoDesdeZonas();
      };

      // Función: limpiar selección de lotes
      window.clearLoteSelection = function() {
        selectedLotes.clear();
        selectedLotes.add('ALL');
        renderLoteChips();
        renderZoneChips();
        actualizarCircuitoDesdeZonas();
      };

      // Función: seleccionar todas las zonas del lote activo
      window.selectAllLoteZones = function() {
        const activeShipments = getActivePlannerShipments();
        const filteredByLote = filterShipmentsBySelectedLotes(activeShipments);
        const loteZones = [...new Set(filteredByLote.map(g => (g.ciudad_destino || '').trim()).filter(Boolean))];
        
        selectedZones.clear();
        loteZones.forEach(z => selectedZones.add(z));
        renderZoneChips();
        actualizarCircuitoDesdeZonas();
      };

      // Función: renderizar los chips de zonas disponibles (filtradas según lote seleccionado)
      function renderZoneChips() {
        const chipsContainer = document.getElementById('planner-zone-chips');
        if (!chipsContainer) return;

        const activeShipments = getActivePlannerShipments();
        const filteredByLote = filterShipmentsBySelectedLotes(activeShipments);

        const ciudadesUnicas = [...new Set(
          filteredByLote.map(g => (g.ciudad_destino || '').trim()).filter(Boolean)
        )].sort();

        if (ciudadesUnicas.length === 0) {
          chipsContainer.innerHTML = '<span class="text-[11px] text-slate-400 italic">No hay guías activas para los lotes seleccionados.</span>';
          return;
        }

        const currentDriverId = plannerDriverSelect?.value ? parseInt(plannerDriverSelect.value, 10) : null;

        chipsContainer.innerHTML = ciudadesUnicas.map(ciudad => {
          const isSelected = selectedZones.has(ciudad);
          const guiasZona = filteredByLote.filter(g =>
            (g.ciudad_destino || '').trim().toLowerCase() === ciudad.toLowerCase()
          );
          const conGps = guiasZona.filter(g =>
            g.gps_confirmado && g.gps_latitud != null && g.gps_longitud != null &&
            !isNaN(Number(g.gps_latitud)) && !isNaN(Number(g.gps_longitud))
          ).length;

          const hasDriverAssigned = currentDriverId && guiasZona.some(g => g.chofer_asignado_id === currentDriverId);

          return `<button
            type="button"
            data-zone="${ciudad}"
            onclick="window.toggleZoneChip('${ciudad.replace(/'/g, "\\'")}')"
            class="zone-chip inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-[11px] font-bold border transition-all cursor-pointer ${
              isSelected
                ? 'bg-indigo-600 border-indigo-700 text-white shadow-xs'
                : hasDriverAssigned
                  ? 'bg-indigo-50 border-indigo-300 text-indigo-900 hover:bg-indigo-100'
                  : 'bg-white border-slate-200 text-slate-700 hover:border-indigo-400 hover:text-indigo-700 hover:bg-indigo-50'
            }"
          >
            ${ciudad}
            <span class="text-[10px] font-black ${isSelected ? 'text-indigo-200' : 'text-slate-400'}">${guiasZona.length}g/${conGps}GPS</span>
          </button>`;
        }).join('');
      }

      // Función: toggle de zona chip
      window.toggleZoneChip = function(ciudad: string) {
        if (selectedZones.has(ciudad)) {
          selectedZones.delete(ciudad);
        } else {
          selectedZones.add(ciudad);
        }
        renderZoneChips();
        actualizarCircuitoDesdeZonas();
      };

