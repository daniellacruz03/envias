        // ============================================
        // MÓDULO DE REVISIÓN DE GUÍAS ESCANEADAS
        // ============================================
        async function loadAndRenderEscaneos() {
          const loadingEl = document.getElementById('escaneos-loading') as HTMLElement;
          const listEl = document.getElementById('escaneos-list') as HTMLElement;
          const emptyEl = document.getElementById('escaneos-empty') as HTMLElement;

          loadingEl?.classList.remove('hidden');
          listEl?.classList.add('hidden');
          emptyEl?.classList.add('hidden');

          try {
            const res = await fetch('/api/escaneos');
            loadingEl?.classList.add('hidden');

            if (!res.ok) {
              emptyEl?.classList.remove('hidden');
              return;
            }
            const data = await res.json();
            escaneosData = data.data || [];

            // Actualizar badge de la pestaña
            const totalPend = data.totalPendientes || 0;
            if (escaneosCountPill) {
              if (totalPend > 0) {
                escaneosCountPill.textContent = totalPend.toString();
                escaneosCountPill.classList.remove('hidden');
                escaneosCountPill.className = 'text-[10px] bg-amber-400 text-white px-1.5 py-0.2 rounded-full font-bold';
              } else {
                escaneosCountPill.classList.add('hidden');
              }
            }

            if (escaneosData.length === 0) {
              listEl?.classList.add('hidden');
              emptyEl?.classList.remove('hidden');
              return;
            }

            emptyEl?.classList.add('hidden');
            if (listEl) {
              listEl.innerHTML = escaneosData.map((lote: any) => renderEscaneoLote(lote)).join('');
              listEl.classList.remove('hidden');
            }

            // Construir lista plana de fotos pendientes para navegación del drawer
            drawerFotosFlat = escaneosData.flatMap((lote: any) =>
              (lote.fotos || []).filter((f: any) => f.estado === 'pendiente').map((f: any) => ({
                ...f,
                chofer_nombre: lote.chofer_nombre,
                lote_id: lote.lote_id
              }))
            );

          } catch (e) {
            loadingEl?.classList.add('hidden');
            emptyEl?.classList.remove('hidden');
          }
        }

        (window as any).loadAndRenderEscaneos = loadAndRenderEscaneos;

        (window as any).deleteEscaneoLote = async (loteId: string) => {
          if (!confirm(`¿Estás seguro de eliminar este lote y todas sus fotos asociadas?`)) return;
          try {
            const res = await fetch(`/api/escaneos?lote_id=${encodeURIComponent(loteId)}`, { method: 'DELETE' });
            const data = await res.json();
            if (res.ok && data.success) {
              showToast('Lote de escaneos eliminado correctamente', 'success');
              loadAndRenderEscaneos();
            } else {
              showToast(data.message || 'Error al eliminar lote', 'error');
            }
          } catch (e) {
            showToast('Error de conexión al eliminar lote', 'error');
          }
        };

        (window as any).deleteIndividualEscaneo = async (fotoId: number) => {
          if (!confirm('¿Estás seguro de eliminar esta foto de escaneo?')) return;
          try {
            const res = await fetch(`/api/escaneos/${fotoId}`, { method: 'DELETE' });
            const data = await res.json();
            if (res.ok && data.success) {
              showToast('Foto eliminada correctamente', 'success');
              loadAndRenderEscaneos();
            } else {
              showToast(data.message || 'Error al eliminar foto', 'error');
            }
          } catch (e) {
            showToast('Error de conexión al eliminar foto', 'error');
          }
        };

        function renderEscaneoLote(lote: any): string {
          const fecha = new Date(lote.created_at).toLocaleDateString('es-VE', {
            day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit'
          });
          const fotosPendientes = (lote.fotos || []).filter((f: any) => f.estado === 'pendiente');

          return `
            <div class="bg-white border border-slate-200/90 rounded-2xl shadow-sm overflow-hidden">
              <!-- Cabecera del lote -->
              <div class="p-4 border-b border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-xl bg-slate-900 text-white flex items-center justify-center font-extrabold text-xs shrink-0">
                    ${(lote.chofer_nombre || 'CH').split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase()}
                  </div>
                  <div>
                    <p class="text-sm font-bold text-slate-900">${lote.chofer_nombre || 'Chofer'}</p>
                    <p class="text-[11px] text-slate-500 mt-0.5">${fecha} &bull; ${lote.total} foto${lote.total !== 1 ? 's' : ''}</p>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  ${lote.pendientes > 0 ? `<span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200">${lote.pendientes} pendientes</span>` : ''}
                  ${lote.procesadas > 0 ? `<span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">${lote.procesadas} procesadas</span>` : ''}
                  ${lote.rechazadas > 0 ? `<span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-rose-50 text-rose-800 border border-rose-200">${lote.rechazadas} rechazadas</span>` : ''}
                  <button
                    type="button"
                    onclick="window.deleteEscaneoLote('${lote.lote_id}')"
                    class="p-1.5 rounded-xl border border-slate-200 bg-white hover:bg-rose-50 hover:border-rose-200 text-slate-400 hover:text-rose-600 transition-colors cursor-pointer"
                    title="Eliminar este lote y todas sus fotos"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </div>
              </div>
              <!-- Barra de progreso del lote -->
              <div class="px-4 pt-3 pb-1">
                <div class="flex items-center justify-between text-[10px] text-slate-500 font-semibold mb-1.5">
                  <span>Progreso de revisión</span>
                  <span>${lote.procesadas} / ${lote.total}</span>
                </div>
                <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
                  <div class="h-full rounded-full bg-emerald-500" style="width: ${lote.total > 0 ? Math.round(lote.procesadas/lote.total*100) : 0}%"></div>
                </div>
              </div>
              <!-- Grid de miniaturas -->
              <div class="p-3 grid grid-cols-4 sm:grid-cols-6 gap-2">
                ${(lote.fotos || []).map((foto: any) => `
                  <div
                    class="group relative aspect-square rounded-xl overflow-hidden border-2 cursor-pointer transition-all hover:scale-105 ${foto.estado === 'pendiente' ? 'border-amber-300 hover:border-amber-500 shadow-sm' : foto.estado === 'procesado' ? 'border-emerald-400' : 'border-rose-300 opacity-75 hover:opacity-100'}"
                    onclick="${foto.estado === 'pendiente' ? `window.openEscaneoDrawer(${foto.id})` : `window.openLightbox('${foto.foto_url}', 'Escaneo #${foto.id}', 'Estado: ${foto.estado} • Chofer: ${(lote.chofer_nombre || 'Chofer').replace(/'/g, "\\'")}', '${foto.id}', 'escaneo')`}"
                    title="${foto.estado === 'pendiente' ? 'Clic para revisar' : 'Clic para ampliar o eliminar'}"
                  >
                    <img src="${foto.foto_url}" class="w-full h-full object-cover" loading="lazy" />
                    <div class="absolute bottom-0 inset-x-0 py-0.5 text-center text-[8px] font-bold ${foto.estado === 'pendiente' ? 'bg-amber-400/80 text-white' : foto.estado === 'procesado' ? 'bg-emerald-500/80 text-white' : 'bg-rose-400/80 text-white'}">
                      ${foto.estado === 'pendiente' ? 'REV.' : foto.estado === 'procesado' ? 'OK' : 'NO'}
                    </div>
                    <button
                      type="button"
                      onclick="event.stopPropagation(); window.deleteIndividualEscaneo(${foto.id});"
                      class="absolute top-1 right-1 z-10 w-5 h-5 rounded-md bg-slate-900/80 hover:bg-rose-600 text-white flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 shadow-sm cursor-pointer"
                      title="Eliminar esta foto"
                    >
                      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                `).join('')}
              </div>
              ${fotosPendientes.length > 0 ? `
                <div class="px-4 pb-4">
                  <button
                    onclick="window.openEscaneoDrawer(${fotosPendientes[0].id})"
                    class="w-full py-2.5 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-bold flex items-center justify-center gap-2 transition-all active:scale-[0.98] cursor-pointer"
                  >
                    <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                    Revisar ${fotosPendientes.length} guia${fotosPendientes.length !== 1 ? 's' : ''} pendiente${fotosPendientes.length !== 1 ? 's' : ''}
                  </button>
                </div>
              ` : ''}
            </div>
          `;
        }

        (window as any).renderEscaneoLote = renderEscaneoLote;

        // Modal de revisión de escaneos
        const escaneoDrawer = document.getElementById('escaneo-drawer') as HTMLElement;
        const drawerOverlay = document.getElementById('escaneo-drawer-overlay') as HTMLElement;
        const drawerFoto = document.getElementById('drawer-foto') as HTMLImageElement;
        const drawerZoomViewport = document.getElementById('drawer-zoom-viewport') as HTMLElement;
        const btnZoomIn = document.getElementById('btn-zoom-in') as HTMLButtonElement;
        const btnZoomOut = document.getElementById('btn-zoom-out') as HTMLButtonElement;
        const btnZoomRotate = document.getElementById('btn-zoom-rotate') as HTMLButtonElement;
        const btnZoomReset = document.getElementById('btn-zoom-reset') as HTMLButtonElement;
        const zoomLevelText = document.getElementById('zoom-level-text') as HTMLElement;
        const drawerLoteBadge = document.getElementById('drawer-lote-badge') as HTMLElement;

        const drawerIdGuia = document.getElementById('drawer-id-guia') as HTMLInputElement;
        const drawerPiezas = document.getElementById('drawer-piezas') as HTMLInputElement;
        const drawerPiesCubicos = document.getElementById('drawer-pies-cubicos') as HTMLInputElement;
        const drawerDestinatario = document.getElementById('drawer-destinatario') as HTMLInputElement;
        const drawerTelefono = document.getElementById('drawer-telefono') as HTMLInputElement;
        const drawerCiudad = document.getElementById('drawer-ciudad') as HTMLInputElement;
        const drawerEmpresa = document.getElementById('drawer-empresa') as HTMLSelectElement;
        const drawerDireccion = document.getElementById('drawer-direccion') as HTMLInputElement;
        const drawerError = document.getElementById('drawer-error') as HTMLElement;
        const drawerCloseBtn = document.getElementById('drawer-close-btn') as HTMLButtonElement;
        const drawerApproveBtn = document.getElementById('drawer-approve-btn') as HTMLButtonElement;
        const drawerRejectBtn = document.getElementById('drawer-reject-btn') as HTMLButtonElement;
        const drawerPrevBtn = document.getElementById('drawer-prev-btn') as HTMLButtonElement;
        const drawerNextBtn = document.getElementById('drawer-next-btn') as HTMLButtonElement;
        const drawerNavCounter = document.getElementById('drawer-nav-counter') as HTMLElement;
        const drawerSubtitle = document.getElementById('drawer-subtitle') as HTMLElement;

        // Estado del visor de zoom interactivo
        let modalZoom = 1;
        let modalPanX = 0;
        let modalPanY = 0;
        let modalRotate = 0;
        let isPanning = false;
        let startPanX = 0;
        let startPanY = 0;

        function applyModalZoomTransform() {
          if (!drawerFoto) return;
          drawerFoto.style.transform = `translate(${modalPanX}px, ${modalPanY}px) scale(${modalZoom}) rotate(${modalRotate}deg)`;
          if (zoomLevelText) {
            zoomLevelText.textContent = `${Math.round(modalZoom * 100)}%`;
          }
        }

        function resetModalZoom() {
          modalZoom = 1;
          modalPanX = 0;
          modalPanY = 0;
          modalRotate = 0;
          applyModalZoomTransform();
        }

        // Eventos de Zoom con Rueda del Ratón
        drawerZoomViewport?.addEventListener('wheel', (e: WheelEvent) => {
          e.preventDefault();
          const delta = e.deltaY < 0 ? 1.15 : 0.87;
          modalZoom = Math.min(Math.max(modalZoom * delta, 0.4), 6.0);
          applyModalZoomTransform();
        }, { passive: false });

        // Eventos de Arrastre (Pan) con Mouse
        drawerZoomViewport?.addEventListener('mousedown', (e: MouseEvent) => {
          if (e.button !== 0) return;
          isPanning = true;
          startPanX = e.clientX - modalPanX;
          startPanY = e.clientY - modalPanY;
          if (drawerZoomViewport) drawerZoomViewport.style.cursor = 'grabbing';
        });

        window.addEventListener('mousemove', (e: MouseEvent) => {
          if (!isPanning) return;
          modalPanX = e.clientX - startPanX;
          modalPanY = e.clientY - startPanY;
          applyModalZoomTransform();
        });

        window.addEventListener('mouseup', () => {
          if (isPanning) {
            isPanning = false;
            if (drawerZoomViewport) drawerZoomViewport.style.cursor = 'grab';
          }
        });

        // Botones de control de zoom
        btnZoomIn?.addEventListener('click', () => {
          modalZoom = Math.min(modalZoom * 1.25, 6.0);
          applyModalZoomTransform();
        });

        btnZoomOut?.addEventListener('click', () => {
          modalZoom = Math.max(modalZoom * 0.8, 0.4);
          applyModalZoomTransform();
        });

        btnZoomRotate?.addEventListener('click', () => {
          modalRotate = (modalRotate + 90) % 360;
          applyModalZoomTransform();
        });

        btnZoomReset?.addEventListener('click', () => {
          resetModalZoom();
        });

        window.openEscaneoDrawer = function(escaneoId: number) {
          const idx = drawerFotosFlat.findIndex((f: any) => f.id === escaneoId);
          drawerCurrentIndex = idx >= 0 ? idx : 0;
          loadDrawerByIndex(drawerCurrentIndex);
          escaneoDrawer.classList.remove('hidden');
          escaneoDrawer.classList.add('flex');
          document.body.style.overflow = 'hidden';
        };

        function loadDrawerByIndex(idx: number) {
          if (drawerFotosFlat.length === 0) return;
          const foto = drawerFotosFlat[idx];
          activeEscaneoId = foto.id;
          drawerFoto.src = foto.foto_url;
          resetModalZoom();
          drawerIdGuia.value = '';
          drawerPiezas.value = '1';
          if (drawerPiesCubicos) drawerPiesCubicos.value = '';
          drawerDestinatario.value = '';
          drawerTelefono.value = '';
          drawerCiudad.value = '';
          if (drawerEmpresa) drawerEmpresa.value = foto.empresa || '';
          drawerDireccion.value = '';
          drawerError.classList.add('hidden');
          drawerSubtitle.textContent = `Chofer: ${foto.chofer_nombre}`;
          if (drawerLoteBadge) drawerLoteBadge.textContent = foto.lote_id || 'Lote';
          drawerNavCounter.textContent = `${idx + 1} / ${drawerFotosFlat.length}`;
          drawerPrevBtn.disabled = idx === 0;
          drawerNextBtn.disabled = idx === drawerFotosFlat.length - 1;
          setTimeout(() => {
            drawerIdGuia?.focus();
          }, 120);
        }

        function closeDrawer() {
          escaneoDrawer.classList.add('hidden');
          escaneoDrawer.classList.remove('flex');
          document.body.style.overflow = '';
          activeEscaneoId = null;
          resetModalZoom();
        }

        drawerCloseBtn?.addEventListener('click', closeDrawer);
        drawerOverlay?.addEventListener('click', closeDrawer);

        drawerPrevBtn?.addEventListener('click', () => {
          if (drawerCurrentIndex > 0) {
            drawerCurrentIndex--;
            loadDrawerByIndex(drawerCurrentIndex);
          }
        });
        drawerNextBtn?.addEventListener('click', () => {
          if (drawerCurrentIndex < drawerFotosFlat.length - 1) {
            drawerCurrentIndex++;
            loadDrawerByIndex(drawerCurrentIndex);
          }
        });

        // Atajos de teclado cuando el modal está abierto
        window.addEventListener('keydown', (e: KeyboardEvent) => {
          if (escaneoDrawer && !escaneoDrawer.classList.contains('hidden')) {
            if (e.key === 'Escape') {
              closeDrawer();
            } else if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
              drawerApproveBtn?.click();
            }
          }
        });

        const drawerDeleteBtn = document.getElementById('drawer-delete-btn') as HTMLButtonElement;

        drawerDeleteBtn?.addEventListener('click', async () => {
          if (!activeEscaneoId) return;

          if (!confirm('¿Estás seguro de que deseas eliminar permanentemente este escaneo y su foto?')) {
            return;
          }

          const originalHtml = drawerDeleteBtn.innerHTML;
          drawerDeleteBtn.disabled = true;
          drawerDeleteBtn.innerHTML = `
            <svg class="animate-spin w-4 h-4 text-rose-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
          `;

          try {
            const res = await fetch(`/api/escaneos/${activeEscaneoId}`, { method: 'DELETE' });
            const data = await res.json();

            if (res.ok && data.success) {
              showToast('Escaneo eliminado permanentemente', 'success');
              drawerFotosFlat.splice(drawerCurrentIndex, 1);
              if (drawerFotosFlat.length === 0) {
                closeDrawer();
                loadAndRenderEscaneos();
                return;
              }
              if (drawerCurrentIndex >= drawerFotosFlat.length) {
                drawerCurrentIndex = drawerFotosFlat.length - 1;
              }
              loadDrawerByIndex(drawerCurrentIndex);
