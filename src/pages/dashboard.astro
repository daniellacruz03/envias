              </div>
              <span class="text-[11px] text-slate-400 font-medium">${item.piezas || 1} ${item.piezas === 1 ? 'pieza' : 'piezas'}${item.pies_cubicos ? ` &bull; <strong class="text-slate-600 font-mono font-bold">${Number(item.pies_cubicos).toFixed(2)} ft³</strong>` : ''}</span>
            </td>

            <!-- Destinatario -->
            <td class="py-3.5 px-4">
              <div class="flex items-center gap-1.5 flex-wrap">
                <p class="font-bold text-slate-900 leading-snug">${item.destinatario}</p>
                ${isMultiGuia ? `
                  <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded-md bg-indigo-50 text-indigo-700 border border-indigo-200 text-[10px] font-extrabold" title="Este cliente tiene ${clientGuias.length} guías para la misma ubicación (${clientGuias.map(g => '#' + g.id_guia).join(', ')})">
