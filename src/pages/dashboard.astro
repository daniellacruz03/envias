                                title="Ver foto comprobante"
                                class="inline-flex items-center gap-1 bg-slate-900 hover:bg-black text-white font-semibold text-[10px] px-2 py-1 rounded-lg transition-all shadow-xs cursor-pointer"
                              >
                                <svg class="w-3 h-3 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                <span>Foto</span>
                              </button>
                            ` : ''}
                            <button
                              type="button"
                              onclick="window.sendWhatsApp('${item.id_guia}')"
                              title="Enviar WhatsApp"
                              class="inline-flex items-center gap-1 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-[10px] px-2 py-1 rounded-lg transition-all shadow-xs cursor-pointer"
                            >
                              <span>WhatsApp</span>
                            </button>
                          </div>
                        </td>
                      </tr>
                    `).join('')}
                  </tbody>
                </table>
              </div>

            </div>
          `;
        }).join('');
      }

      // Toggle colapsar ciudad
      (window as any).toggleCityExpand = (cityName: string) => {
        expandedCities[cityName] = expandedCities[cityName] === false ? true : false;
        renderViews();
      };

      // ==========================================
      // RENDER VISTA 3: ESTADO Y MONITOREO DE CHOFERES (3 FASES & FOTOS)
      // ==========================================
      function renderDriversView(filtered: GuiaRow[]) {
        if (!viewContainerDrivers) return;

        if (driversCountPill) {
          driversCountPill.textContent = drivers.length.toString();
        }

        if (drivers.length === 0) {
          viewContainerDrivers.innerHTML = `
            <div class="p-12 text-center bg-white rounded-3xl border border-slate-200 text-slate-400">
              No hay choferes registrados en la flota.
            </div>
          `;
          return;
        }

        viewContainerDrivers.innerHTML = drivers.map(driver => {
          const allDriverGuias = shipments.filter(g => g.chofer_asignado_id === driver.id);
          const visibleDriverGuias = filtered.filter(g => g.chofer_asignado_id === driver.id);
          
          // Si hay filtro activo y este chofer no tiene guías que coincidan, ocultar
          const isFilterActive = searchInput.value.trim() !== '' || filterCiudad.value !== 'ALL' || filterEstado.value !== 'ALL';
          if (isFilterActive && visibleDriverGuias.length === 0 && allDriverGuias.length > 0) {
            return '';
          }

          // Separación exacta en las Fases solicitadas:
          // Fase 1: Almacén / Preparación (Por contactar / Contactado)
          const faseAlmacen = visibleDriverGuias.filter(g => g.estado === 'Por contactar' || g.estado === 'Contactado');
          // Fase 2: En Ruta (En ruta)
          const faseEnRuta = visibleDriverGuias.filter(g => g.estado === 'En ruta')
            .sort((a, b) => (a.orden_ruta || 999) - (b.orden_ruta || 999));
          // Fase 3: Entregado / Incidencias (Entregado / No entregado con foto/comprobante)
          const faseEntregado = visibleDriverGuias.filter(g => g.estado === 'Entregado' || g.estado === 'No entregado');

          const totalAssigned = allDriverGuias.length;
          const totalDelivered = allDriverGuias.filter(g => g.estado === 'Entregado').length;
          const totalNoDelivered = allDriverGuias.filter(g => g.estado === 'No entregado').length;
          const totalEnRuta = allDriverGuias.filter(g => g.estado === 'En ruta').length;
          const totalAlmacen = allDriverGuias.filter(g => g.estado === 'Por contactar' || g.estado === 'Contactado').length;
          const pctCompleted = totalAssigned > 0 ? Math.round((totalDelivered / totalAssigned) * 100) : 0;

          // Datos de ruta activa
          const sampleWithRoute = allDriverGuias.find(g => g.ruta_origen || g.ruta_destino);
          const routeOrigin = sampleWithRoute?.ruta_origen || 'Sede Principal Barquisimeto';
          const routeDest = sampleWithRoute?.ruta_destino || 'En Destino';

          const driverInitials = driver.nombre.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
          const phoneFormatted = formatPhoneForWhatsApp(driver.telefono || '04120000000');

          return `
            <div class="bg-white border border-slate-200/90 rounded-3xl shadow-sm overflow-hidden transition-all duration-200">
              
              <!-- Cabecera del Chofer -->
              <div class="p-4 sm:p-6 border-b border-slate-100 bg-gradient-to-r from-slate-50 via-white to-slate-50/50 flex flex-col xl:flex-row xl:items-center justify-between gap-4">
                
                <!-- Identidad del Chofer -->
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 rounded-2xl bg-slate-900 text-white flex items-center justify-center font-extrabold text-sm shadow-md shrink-0">
                    ${driverInitials}
                  </div>
                  <div>
                    <div class="flex items-center gap-2.5 flex-wrap">
                      <h4 class="text-base font-extrabold text-slate-900 tracking-tight">${driver.nombre}</h4>
                      <span class="text-xs font-bold px-2.5 py-0.5 rounded-full ${totalEnRuta > 0 ? 'bg-sky-50 text-sky-700 border border-sky-200 animate-pulse' : totalAssigned > 0 ? 'bg-slate-100 text-slate-700' : 'bg-slate-50 text-slate-400'}">
                        ${totalEnRuta > 0 ? 'En Ruta Activa' : totalAssigned > 0 ? 'Asignado' : 'Disponible'}
                      </span>
                    </div>

                    <div class="flex items-center gap-3 text-xs text-slate-500 font-medium mt-1 flex-wrap">
                      <span class="font-mono">${driver.telefono || 'Sin teléfono'}</span>
                      <span class="text-slate-300">•</span>
                      <span class="text-slate-700 font-bold">${totalAssigned} ${totalAssigned === 1 ? 'guía asignada' : 'guías asignadas'}</span>
                      ${totalAssigned > 0 ? `
                        <span class="text-slate-300">•</span>
                        <span class="text-indigo-600 font-semibold truncate max-w-[280px]" title="${routeOrigin} ➔ ${routeDest}">
                          ${routeOrigin} ➔ ${routeDest}
                        </span>
                      ` : ''}
                    </div>
                  </div>
                </div>

                <!-- Barra de Progreso y Acciones Rápidas -->
                <div class="flex flex-wrap items-center gap-3 xl:gap-4">
                  <!-- Barra de Progreso de Entregas -->
                  <div class="bg-white px-3.5 py-2 rounded-2xl border border-slate-200/80 shadow-2xs min-w-[200px] flex-1 sm:flex-none">
                    <div class="flex items-center justify-between text-[11px] font-bold text-slate-700 mb-1.5">
                      <span>Progreso de Jornada</span>
                      <span class="${pctCompleted === 100 ? 'text-emerald-600' : 'text-slate-900'}">${totalDelivered} / ${totalAssigned} (${pctCompleted}%)</span>
                    </div>
                    <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                      <div class="h-full rounded-full transition-all duration-500 ${pctCompleted === 100 ? 'bg-emerald-500' : 'bg-indigo-600'}" style="width: ${pctCompleted}%"></div>
                    </div>
                  </div>

                  <!-- Botones de Acción con el Chofer -->
                  <div class="flex items-center gap-1.5 flex-wrap">
                    ${totalAlmacen > 0 ? `
                      <button
                        type="button"
                        onclick="window.dispatchDriverToRoute(${driver.id})"
                        class="px-3 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 cursor-pointer active:scale-95"
                        title="Despachar las ${totalAlmacen} guías de ${driver.nombre} que están en almacén para pasar a En Ruta"
                      >
                        <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                        <span>Despachar a Ruta (${totalAlmacen})</span>
                      </button>
                    ` : ''}

                    ${driver.telefono ? `
                      <a
                        href="https://wa.me/${phoneFormatted}?text=${encodeURIComponent(`Hola ${driver.nombre}, te contactamos desde Logística Central de Envías C.A.`)}"
                        target="_blank"
                        class="p-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 transition-colors shadow-2xs"
                        title="Contactar al chofer por WhatsApp"
                      >
                        <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                        </svg>
                      </a>
                    ` : ''}

                    <button
                      type="button"
                      onclick="window.openRoutePlannerModal(${driver.id})"
                      class="px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 cursor-pointer active:scale-95"
                      title="Abrir planificador de ruta para este chofer"
                    >
                      <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                      </svg>
                      <span>Organizar Ruta</span>
                    </button>
                  </div>
                </div>

              </div>

              <!-- TABLERO KANBAN DE LAS 3 FASES DEL CHOFER -->
              <div class="p-4 sm:p-6 bg-slate-50/40">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-5">
                  
                  <!-- ======================================= -->
                  <!-- FASE 1: ALMACÉN / EN PREPARACIÓN        -->
                  <!-- ======================================= -->
                  <div class="bg-white rounded-2xl border border-slate-200/90 p-3.5 space-y-3 shadow-2xs flex flex-col">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
                      <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                        <h5 class="text-xs font-extrabold text-slate-900 uppercase tracking-wider">1. En Almacén</h5>
                      </div>
                      <span class="text-[11px] font-extrabold px-2 py-0.2 rounded-full bg-amber-50 text-amber-800 border border-amber-200">
                        ${faseAlmacen.length}
                      </span>
                    </div>

                    <div class="space-y-2 flex-1 overflow-y-auto max-h-96 pr-0.5 custom-scrollbar">
                      ${faseAlmacen.length === 0 ? `
                        <div class="p-5 text-center text-slate-400 text-xs italic bg-slate-50/60 rounded-xl border border-dashed border-slate-200">
                          Sin guías pendientes en almacén
                        </div>
                      ` : faseAlmacen.map(g => `
                        <div class="p-3 bg-slate-50/70 hover:bg-slate-50 border border-slate-200/80 rounded-xl space-y-1.5 transition-all">
                          <div class="flex items-center justify-between gap-1">
                            <div class="flex items-center gap-1.5 flex-wrap">
                              <a href="/confirmar?guia=${encodeURIComponent(g.id_guia)}" target="_blank" class="font-mono font-bold text-xs text-slate-900 hover:text-indigo-600">
                                #${g.id_guia}
                              </a>
                              ${g.empresa ? `
                                <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-purple-50 text-purple-700 border border-purple-200">
                                  ${g.empresa}
                                </span>
                              ` : ''}
                            </div>
                            <span class="text-[10px] font-bold px-2 py-0.2 rounded-md ${g.estado === 'Contactado' ? 'bg-indigo-50 text-indigo-700 border border-indigo-200' : 'bg-amber-50 text-amber-700 border border-amber-200'}">
                              ${g.estado}
                            </span>
                          </div>
                          <p class="text-xs font-bold text-slate-800 truncate">${g.destinatario}</p>
                          <div class="flex items-center justify-between text-[11px] text-slate-500">
                            <span class="font-semibold text-slate-700">${g.ciudad_destino}</span>
                            <span class="text-slate-400 font-mono">${g.piezas || 1} pz</span>
                          </div>
                        </div>
                      `).join('')}
                    </div>
                  </div>

                  <!-- ======================================= -->
                  <!-- FASE 2: EN RUTA / EN CAMINO             -->
                  <!-- ======================================= -->
                  <div class="bg-white rounded-2xl border border-slate-200/90 p-3.5 space-y-3 shadow-2xs flex flex-col">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
                      <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-sky-500 animate-ping"></span>
                        <h5 class="text-xs font-extrabold text-slate-900 uppercase tracking-wider">2. En Ruta</h5>
                      </div>
                      <span class="text-[11px] font-extrabold px-2 py-0.2 rounded-full bg-sky-50 text-sky-800 border border-sky-200">
                        ${faseEnRuta.length}
                      </span>
                    </div>

                    <div class="space-y-2 flex-1 overflow-y-auto max-h-96 pr-0.5 custom-scrollbar">
                      ${faseEnRuta.length === 0 ? `
                        <div class="p-5 text-center text-slate-400 text-xs italic bg-slate-50/60 rounded-xl border border-dashed border-slate-200">
                          Sin guías en tránsito actualmente
                        </div>
                      ` : faseEnRuta.map((g, idx) => `
                        <div class="p-3 bg-sky-50/40 hover:bg-sky-50/70 border border-sky-100 rounded-xl space-y-1.5 transition-all">
                          <div class="flex items-center justify-between gap-1">
                            <div class="flex items-center gap-1.5 flex-wrap">
                              <span class="w-5 h-5 rounded-md bg-slate-900 text-white font-mono font-bold text-[10px] flex items-center justify-center">
                                ${g.orden_ruta || idx + 1}
                              </span>
                              <a href="/confirmar?guia=${encodeURIComponent(g.id_guia)}" target="_blank" class="font-mono font-bold text-xs text-slate-900 hover:text-indigo-600">
                                #${g.id_guia}
                              </a>
                              ${g.empresa ? `
                                <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-purple-50 text-purple-700 border border-purple-200">
                                  ${g.empresa}
                                </span>
                              ` : ''}
                            </div>
                            ${g.gps_confirmado && g.gps_latitud && g.gps_longitud ? `
                              <a
                                href="https://www.google.com/maps/search/?api=1&query=${g.gps_latitud},${g.gps_longitud}"
                                target="_blank"
                                class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded flex items-center gap-0.5"
                                title="Ver punto satelital en Maps"
                              >
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                <span>GPS</span>
                              </a>
                            ` : `
                              <span class="text-[10px] text-slate-400 font-semibold">Ref. Escrita</span>
                            `}
                          </div>

                          <p class="text-xs font-bold text-slate-800 truncate">${g.destinatario}</p>
                          <div class="text-[11px] text-slate-500 truncate" title="${g.direccion_referencia || g.ciudad_destino}">
                            ${g.direccion_referencia || g.ciudad_destino}
                          </div>
                        </div>
                      `).join('')}
                    </div>
                  </div>

                  <!-- ======================================= -->
                  <!-- FASE 3: ENTREGADO & INCIDENCIAS DE FOTO -->
                  <!-- ======================================= -->
                  <div class="bg-white rounded-2xl border border-slate-200/90 p-3.5 space-y-3 shadow-2xs flex flex-col">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
                      <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                        <h5 class="text-xs font-extrabold text-slate-900 uppercase tracking-wider">3. Entregado / Finalizado</h5>
                      </div>
                      <div class="flex items-center gap-1">
                        <span class="text-[11px] font-extrabold px-2 py-0.2 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200" title="Entregas completadas">
                          ${visibleDriverGuias.filter(g => g.estado === 'Entregado').length}
                        </span>
                        ${visibleDriverGuias.filter(g => g.estado === 'No entregado').length > 0 ? `
                          <span class="text-[11px] font-extrabold px-2 py-0.2 rounded-full bg-rose-50 text-rose-800 border border-rose-200" title="No entregadas / Incidencias">
                            ${visibleDriverGuias.filter(g => g.estado === 'No entregado').length}
                          </span>
                        ` : ''}
                      </div>
                    </div>

                    <div class="space-y-2.5 flex-1 overflow-y-auto max-h-96 pr-0.5 custom-scrollbar">
                      ${faseEntregado.length === 0 ? `
                        <div class="p-5 text-center text-slate-400 text-xs italic bg-slate-50/60 rounded-xl border border-dashed border-slate-200">
                          Aún no hay entregas confirmadas en esta jornada
                        </div>
                      ` : faseEntregado.map(g => {
                        const isNoEntregado = g.estado === 'No entregado';
                        return `
                        <div class="p-3 ${isNoEntregado ? 'bg-rose-50/30 hover:bg-rose-50/60 border-rose-100' : 'bg-emerald-50/30 hover:bg-emerald-50/60 border-emerald-100'} border rounded-xl space-y-2 transition-all">
                          <div class="flex items-center justify-between gap-1">
                            <div class="flex items-center gap-1.5 flex-wrap">
                              <a href="/confirmar?guia=${encodeURIComponent(g.id_guia)}" target="_blank" class="font-mono font-bold text-xs ${isNoEntregado ? 'text-rose-900 hover:text-rose-700' : 'text-slate-900 hover:text-emerald-700'}">
                                #${g.id_guia}
                              </a>
                              ${g.empresa ? `
                                <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-purple-50 text-purple-700 border border-purple-200">
                                  ${g.empresa}
                                </span>
                              ` : ''}
                            </div>
                            <span class="text-[10px] font-bold px-2 py-0.2 rounded-md ${isNoEntregado ? 'bg-rose-100 text-rose-800' : 'bg-emerald-100 text-emerald-800'} flex items-center gap-1">
                              ${isNoEntregado ? `
                                <svg class="w-3 h-3 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                                <span>No entregado</span>
                              ` : `
                                <svg class="w-3 h-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                <span>Entregado</span>
                              `}
                            </span>
                          </div>

                          <div>
                            <p class="text-xs font-bold text-slate-800 truncate">${g.destinatario}</p>
                            <p class="text-[11px] text-slate-500 truncate mt-0.5">
                              <span class="font-semibold ${isNoEntregado ? 'text-rose-700' : 'text-slate-700'}">${isNoEntregado ? 'Motivo:' : 'Recibió:'}</span> ${g.recibido_por || (isNoEntregado ? 'Cliente ausente / No contesta' : 'Titular')}
                            </p>
                          </div>

                          <!-- VISOR DE COMPROBANTE DE FOTO O EVIDENCIA -->
                          ${g.comprobante_url ? `
                            <div
                              class="relative rounded-xl overflow-hidden border ${isNoEntregado ? 'border-rose-200' : 'border-emerald-200'} bg-slate-100 group/thumb cursor-pointer aspect-video"
                              onclick="window.openLightbox('${g.comprobante_url}', '${isNoEntregado ? 'Evidencia de Intento Fallido' : 'Comprobante de Entrega'} - Guía #${g.id_guia}', '${g.recibido_por ? `${isNoEntregado ? 'Motivo:' : 'Recibido por:'} ${g.recibido_por.replace(/'/g, "\\'")}` : ''} • Chofer: ${driver.nombre}', '${g.id_guia}', 'guia')"
                              title="Haz clic para ampliar la foto"
                            >
                              <img src="${g.comprobante_url}" alt="Comprobante #${g.id_guia}" class="w-full h-full object-cover group-hover/thumb:scale-105 transition-transform duration-200" />
                              <div class="absolute inset-0 bg-slate-900/50 opacity-0 group-hover/thumb:opacity-100 transition-opacity flex items-center justify-center gap-1.5 text-white text-[11px] font-bold">
                                <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                                <span>Ver ${isNoEntregado ? 'Evidencia' : 'Comprobante'}</span>
                              </div>
                              <span class="absolute bottom-1 right-1 bg-black/75 text-white text-[9px] font-bold px-1.5 py-0.2 rounded backdrop-blur-2xs flex items-center gap-0.5">
                                <svg class="w-2.5 h-2.5 ${isNoEntregado ? 'text-rose-400' : 'text-emerald-400'}" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                <span>Foto</span>
                              </span>
                            </div>
                          ` : `
                            <div class="py-1.5 px-2 rounded-lg bg-slate-50 border border-dashed border-slate-200 text-[10px] text-slate-400 flex items-center justify-center gap-1">
                              <svg class="w-3 h-3 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                              <span>Sin foto adjunta</span>
                            </div>
                          `}
                        </div>
                      `;
                      }).join('')}
                    </div>
                  </div>

                </div>
              </div>

            </div>
          `;
        }).join('');
      }

      // Asignar Chofer a toda la ciudad
      (window as any).assignDriverToCity = async (cityName: string) => {
        const cityKey = encodeURIComponent(cityName);
        const driverSelect = document.getElementById(`bulk-driver-${cityKey}`) as HTMLSelectElement;
        if (!driverSelect) return;

        const driverIdStr = driverSelect.value;
        const chofer_id = driverIdStr ? parseInt(driverIdStr, 10) : null;
        const driverObj = drivers.find(d => d.id === chofer_id);
        const driverName = driverObj ? driverObj.nombre : 'Sin Asignar';

        try {
          const res = await fetch('/api/guias/lote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ciudad_destino: cityName,
              chofer_id: chofer_id,
              cambiar_estado: chofer_id ? 'En ruta' : undefined // Al asignar chofer masivo pasa a 'En ruta'
            })
          });

          const json = await res.json();

          if (res.ok && json.success) {
            // Actualizar estado local
            shipments.forEach(s => {
              if (s.ciudad_destino.trim().toLowerCase() === cityName.trim().toLowerCase()) {
                s.chofer_asignado_id = chofer_id;
                s.chofer_nombre = driverObj ? driverObj.nombre : null;
                if (chofer_id && s.estado !== 'Entregado') {
                  s.estado = 'En ruta';
                }
              }
            });

            renderViews();
            showToast(`Se asignaron ${json.count || 'las'} guías de ${cityName} a ${driverName} (En ruta)`, 'success');
          } else {
            showToast(json.message || 'Error al asignar chofer en lote', 'error');
          }
        } catch (err) {
          console.error('Error al asignar por lote:', err);
          showToast('Error de red al procesar asignación por lote', 'error');
        }
      };

      // Eventos del Formulario y Filtros
      let eventsAttached = false;
      let isSubmitting = false;

      function attachEvents() {
        if (eventsAttached) return;
        eventsAttached = true;

        // Switcher de Modos de Vista
        function updateTabStyles() {
          btnViewTable.classList.remove('tab-btn-active', 'text-slate-600');
          btnViewCities.classList.remove('tab-btn-active', 'text-slate-600');
          btnViewDrivers.classList.remove('tab-btn-active', 'text-slate-600');
          btnViewEscaneos?.classList.remove('tab-btn-active', 'text-slate-600');
          
          viewContainerTable.classList.add('hidden');
          viewContainerCities.classList.add('hidden');
          viewContainerDrivers.classList.add('hidden');
          viewContainerEscaneos?.classList.add('hidden');

          if (currentViewMode === 'table') {
            btnViewTable.classList.add('tab-btn-active');
            btnViewCities.classList.add('text-slate-600');
            btnViewDrivers.classList.add('text-slate-600');
            btnViewEscaneos?.classList.add('text-slate-600');
            viewContainerTable.classList.remove('hidden');
          } else if (currentViewMode === 'cities') {
            btnViewCities.classList.add('tab-btn-active');
            btnViewTable.classList.add('text-slate-600');
            btnViewDrivers.classList.add('text-slate-600');
            btnViewEscaneos?.classList.add('text-slate-600');
            viewContainerCities.classList.remove('hidden');
          } else if (currentViewMode === 'drivers') {
            btnViewDrivers.classList.add('tab-btn-active');
            btnViewTable.classList.add('text-slate-600');
            btnViewCities.classList.add('text-slate-600');
            btnViewEscaneos?.classList.add('text-slate-600');
            viewContainerDrivers.classList.remove('hidden');
          } else if (currentViewMode === 'escaneos') {
            btnViewEscaneos?.classList.add('tab-btn-active');
            btnViewTable.classList.add('text-slate-600');
            btnViewCities.classList.add('text-slate-600');
            btnViewDrivers.classList.add('text-slate-600');
            viewContainerEscaneos?.classList.remove('hidden');
          }
        }

        btnViewTable.addEventListener('click', () => {
          currentViewMode = 'table';
          updateTabStyles();
          renderViews();
        });

        btnViewCities.addEventListener('click', () => {
          currentViewMode = 'cities';
          updateTabStyles();
          renderViews();
        });

        btnViewDrivers.addEventListener('click', () => {
          currentViewMode = 'drivers';
          updateTabStyles();
          renderViews();
        });

        btnViewEscaneos?.addEventListener('click', () => {
          currentViewMode = 'escaneos';
          updateTabStyles();
          loadAndRenderEscaneos();
        });

        // ============================================
        // MÓDULO DE REVISIÓN DE GUÍAS ESCANEADAS
        // ============================================
        async function loadAndRenderEscaneos() {
          const loadingEl = document.getElementById('escaneos-loading') as HTMLElement;
          const listEl = document.getElementById('escaneos-list') as HTMLElement;
          const emptyEl = document.getElementById('escaneos-empty') as HTMLElement;

          loadingEl?.classList.remove('hidden');
          listEl?.classList.add('hidden');
          emptyEl?.classList.add('hidden');

          try {
            const res = await fetch('/api/escaneos');
            if (!res.ok) { loadingEl?.classList.add('hidden'); return; }
            const data = await res.json();
            escaneosData = data.data || [];

            // Actualizar badge de la pestaña
            const totalPend = data.totalPendientes || 0;
            if (escaneosCountPill) {
              if (totalPend > 0) {
                escaneosCountPill.textContent = totalPend.toString();
                escaneosCountPill.classList.remove('hidden');
                escaneosCountPill.className = 'text-[10px] bg-amber-400 text-white px-1.5 py-0.2 rounded-full font-bold';
              } else {
                escaneosCountPill.classList.add('hidden');
              }
            }

            loadingEl?.classList.add('hidden');

            if (escaneosData.length === 0) {
              emptyEl?.classList.remove('hidden');
              return;
            }

            listEl!.innerHTML = escaneosData.map((lote: any) => renderEscaneoLote(lote)).join('');
            listEl?.classList.remove('hidden');

            // Construir lista plana de fotos pendientes para navegación del drawer
            drawerFotosFlat = escaneosData.flatMap((lote: any) =>
              (lote.fotos || []).filter((f: any) => f.estado === 'pendiente').map((f: any) => ({
                ...f,
                chofer_nombre: lote.chofer_nombre,
                lote_id: lote.lote_id
              }))
            );

          } catch (e) {
            loadingEl?.classList.add('hidden');
            emptyEl?.classList.remove('hidden');
          }
        }

        function renderEscaneoLote(lote: any): string {
          const fecha = new Date(lote.created_at).toLocaleDateString('es-VE', {
            day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit'
          });
          const fotosPendientes = (lote.fotos || []).filter((f: any) => f.estado === 'pendiente');

          return `
            <div class="bg-white border border-slate-200/90 rounded-2xl shadow-sm overflow-hidden">
              <!-- Cabecera del lote -->
              <div class="p-4 border-b border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-xl bg-slate-900 text-white flex items-center justify-center font-extrabold text-xs shrink-0">
                    ${(lote.chofer_nombre || 'CH').split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase()}
                  </div>
                  <div>
                    <p class="text-sm font-bold text-slate-900">${lote.chofer_nombre || 'Chofer'}</p>
                    <p class="text-[11px] text-slate-500 mt-0.5">${fecha} &bull; ${lote.total} foto${lote.total !== 1 ? 's' : ''}</p>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  ${lote.pendientes > 0 ? `<span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200">${lote.pendientes} pendientes</span>` : ''}
                  ${lote.procesadas > 0 ? `<span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">${lote.procesadas} procesadas</span>` : ''}
                </div>
              </div>
              <!-- Barra de progreso del lote -->
              <div class="px-4 pt-3 pb-1">
                <div class="flex items-center justify-between text-[10px] text-slate-500 font-semibold mb-1.5">
                  <span>Progreso de revisión</span>
                  <span>${lote.procesadas} / ${lote.total}</span>
                </div>
                <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
                  <div class="h-full rounded-full bg-emerald-500" style="width: ${lote.total > 0 ? Math.round(lote.procesadas/lote.total*100) : 0}%"></div>
                </div>
              </div>
              <!-- Grid de miniaturas -->
              <div class="p-3 grid grid-cols-4 sm:grid-cols-6 gap-2">
                ${(lote.fotos || []).map((foto: any) => `
                  <div
                    class="relative aspect-square rounded-xl overflow-hidden border-2 cursor-pointer transition-all hover:scale-105 ${foto.estado === 'pendiente' ? 'border-amber-300 hover:border-amber-500' : foto.estado === 'procesado' ? 'border-emerald-400' : 'border-rose-300 opacity-60'}"
                    ${foto.estado === 'pendiente' ? `onclick="window.openEscaneoDrawer(${foto.id})"` : ''}
                    title="${foto.estado === 'pendiente' ? 'Clic para revisar' : foto.estado === 'procesado' ? 'Ya procesada' : 'Rechazada'}"
                  >
                    <img src="${foto.foto_url}" class="w-full h-full object-cover" loading="lazy" />
                    <div class="absolute bottom-0 inset-x-0 py-0.5 text-center text-[8px] font-bold ${foto.estado === 'pendiente' ? 'bg-amber-400/80 text-white' : foto.estado === 'procesado' ? 'bg-emerald-500/80 text-white' : 'bg-rose-400/80 text-white'}">
                      ${foto.estado === 'pendiente' ? 'REV.' : foto.estado === 'procesado' ? 'OK' : 'NO'}
                    </div>
                  </div>
                `).join('')}
              </div>
              ${fotosPendientes.length > 0 ? `
                <div class="px-4 pb-4">
                  <button
                    onclick="window.openEscaneoDrawer(${fotosPendientes[0].id})"
                    class="w-full py-2.5 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-bold flex items-center justify-center gap-2 transition-all active:scale-[0.98] cursor-pointer"
                  >
                    <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                    Revisar ${fotosPendientes.length} guia${fotosPendientes.length !== 1 ? 's' : ''} pendiente${fotosPendientes.length !== 1 ? 's' : ''}
                  </button>
                </div>
              ` : ''}
            </div>
          `;
        }

        // Modal de revisión de escaneos
        const escaneoDrawer = document.getElementById('escaneo-drawer') as HTMLElement;
        const drawerOverlay = document.getElementById('escaneo-drawer-overlay') as HTMLElement;
        const drawerFoto = document.getElementById('drawer-foto') as HTMLImageElement;
        const drawerZoomViewport = document.getElementById('drawer-zoom-viewport') as HTMLElement;
        const btnZoomIn = document.getElementById('btn-zoom-in') as HTMLButtonElement;
        const btnZoomOut = document.getElementById('btn-zoom-out') as HTMLButtonElement;
        const btnZoomRotate = document.getElementById('btn-zoom-rotate') as HTMLButtonElement;
        const btnZoomReset = document.getElementById('btn-zoom-reset') as HTMLButtonElement;
        const zoomLevelText = document.getElementById('zoom-level-text') as HTMLElement;
        const drawerLoteBadge = document.getElementById('drawer-lote-badge') as HTMLElement;

        const drawerIdGuia = document.getElementById('drawer-id-guia') as HTMLInputElement;
        const drawerPiezas = document.getElementById('drawer-piezas') as HTMLInputElement;
        const drawerDestinatario = document.getElementById('drawer-destinatario') as HTMLInputElement;
        const drawerTelefono = document.getElementById('drawer-telefono') as HTMLInputElement;
        const drawerCiudad = document.getElementById('drawer-ciudad') as HTMLInputElement;
        const drawerEmpresa = document.getElementById('drawer-empresa') as HTMLSelectElement;
        const drawerDireccion = document.getElementById('drawer-direccion') as HTMLInputElement;
        const drawerError = document.getElementById('drawer-error') as HTMLElement;
        const drawerCloseBtn = document.getElementById('drawer-close-btn') as HTMLButtonElement;
        const drawerApproveBtn = document.getElementById('drawer-approve-btn') as HTMLButtonElement;
        const drawerRejectBtn = document.getElementById('drawer-reject-btn') as HTMLButtonElement;
        const drawerPrevBtn = document.getElementById('drawer-prev-btn') as HTMLButtonElement;
        const drawerNextBtn = document.getElementById('drawer-next-btn') as HTMLButtonElement;
        const drawerNavCounter = document.getElementById('drawer-nav-counter') as HTMLElement;
        const drawerSubtitle = document.getElementById('drawer-subtitle') as HTMLElement;

        // Estado del visor de zoom interactivo
        let modalZoom = 1;
        let modalPanX = 0;
        let modalPanY = 0;
        let modalRotate = 0;
        let isPanning = false;
        let startPanX = 0;
        let startPanY = 0;

        function applyModalZoomTransform() {
          if (!drawerFoto) return;
          drawerFoto.style.transform = `translate(${modalPanX}px, ${modalPanY}px) scale(${modalZoom}) rotate(${modalRotate}deg)`;
          if (zoomLevelText) {
            zoomLevelText.textContent = `${Math.round(modalZoom * 100)}%`;
          }
        }

        function resetModalZoom() {
          modalZoom = 1;
          modalPanX = 0;
          modalPanY = 0;
          modalRotate = 0;
          applyModalZoomTransform();
        }

        // Eventos de Zoom con Rueda del Ratón
        drawerZoomViewport?.addEventListener('wheel', (e: WheelEvent) => {
          e.preventDefault();
          const delta = e.deltaY < 0 ? 1.15 : 0.87;
          modalZoom = Math.min(Math.max(modalZoom * delta, 0.4), 6.0);
          applyModalZoomTransform();
        }, { passive: false });

        // Eventos de Arrastre (Pan) con Mouse
        drawerZoomViewport?.addEventListener('mousedown', (e: MouseEvent) => {
          if (e.button !== 0) return;
          isPanning = true;
          startPanX = e.clientX - modalPanX;
          startPanY = e.clientY - modalPanY;
          if (drawerZoomViewport) drawerZoomViewport.style.cursor = 'grabbing';
        });

        window.addEventListener('mousemove', (e: MouseEvent) => {
          if (!isPanning) return;
          modalPanX = e.clientX - startPanX;
          modalPanY = e.clientY - startPanY;
          applyModalZoomTransform();
        });

        window.addEventListener('mouseup', () => {
          if (isPanning) {
            isPanning = false;
            if (drawerZoomViewport) drawerZoomViewport.style.cursor = 'grab';
          }
        });

        // Botones de control de zoom
        btnZoomIn?.addEventListener('click', () => {
          modalZoom = Math.min(modalZoom * 1.25, 6.0);
          applyModalZoomTransform();
        });

        btnZoomOut?.addEventListener('click', () => {
          modalZoom = Math.max(modalZoom * 0.8, 0.4);
          applyModalZoomTransform();
        });

        btnZoomRotate?.addEventListener('click', () => {
          modalRotate = (modalRotate + 90) % 360;
          applyModalZoomTransform();
        });

        btnZoomReset?.addEventListener('click', () => {
          resetModalZoom();
        });

        window.openEscaneoDrawer = function(escaneoId: number) {
          const idx = drawerFotosFlat.findIndex((f: any) => f.id === escaneoId);
          drawerCurrentIndex = idx >= 0 ? idx : 0;
          loadDrawerByIndex(drawerCurrentIndex);
          escaneoDrawer.classList.remove('hidden');
          escaneoDrawer.classList.add('flex');
          document.body.style.overflow = 'hidden';
        };

        function loadDrawerByIndex(idx: number) {
          if (drawerFotosFlat.length === 0) return;
          const foto = drawerFotosFlat[idx];
          activeEscaneoId = foto.id;
          drawerFoto.src = foto.foto_url;
          resetModalZoom();
          drawerIdGuia.value = '';
          drawerPiezas.value = '1';
          drawerDestinatario.value = '';
          drawerTelefono.value = '';
          drawerCiudad.value = '';
          if (drawerEmpresa) drawerEmpresa.value = foto.empresa || '';
          drawerDireccion.value = '';
          drawerError.classList.add('hidden');
          drawerSubtitle.textContent = `Chofer: ${foto.chofer_nombre}`;
          if (drawerLoteBadge) drawerLoteBadge.textContent = foto.lote_id || 'Lote';
          drawerNavCounter.textContent = `${idx + 1} / ${drawerFotosFlat.length}`;
          drawerPrevBtn.disabled = idx === 0;
          drawerNextBtn.disabled = idx === drawerFotosFlat.length - 1;
          setTimeout(() => {
            drawerIdGuia?.focus();
          }, 120);
        }

        function closeDrawer() {
          escaneoDrawer.classList.add('hidden');
          escaneoDrawer.classList.remove('flex');
          document.body.style.overflow = '';
          activeEscaneoId = null;
          resetModalZoom();
        }

        drawerCloseBtn?.addEventListener('click', closeDrawer);
        drawerOverlay?.addEventListener('click', closeDrawer);

        drawerPrevBtn?.addEventListener('click', () => {
          if (drawerCurrentIndex > 0) {
            drawerCurrentIndex--;
            loadDrawerByIndex(drawerCurrentIndex);
          }
        });
        drawerNextBtn?.addEventListener('click', () => {
          if (drawerCurrentIndex < drawerFotosFlat.length - 1) {
            drawerCurrentIndex++;
            loadDrawerByIndex(drawerCurrentIndex);
          }
        });

        // Atajos de teclado cuando el modal está abierto
        window.addEventListener('keydown', (e: KeyboardEvent) => {
          if (escaneoDrawer && !escaneoDrawer.classList.contains('hidden')) {
            if (e.key === 'Escape') {
              closeDrawer();
            } else if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
              drawerApproveBtn?.click();
            }
          }
        });

        const drawerDeleteBtn = document.getElementById('drawer-delete-btn') as HTMLButtonElement;

        drawerDeleteBtn?.addEventListener('click', async () => {
          if (!activeEscaneoId) return;

          if (!confirm('¿Estás seguro de que deseas eliminar permanentemente este escaneo y su foto?')) {
            return;
          }

          const originalHtml = drawerDeleteBtn.innerHTML;
          drawerDeleteBtn.disabled = true;
          drawerDeleteBtn.innerHTML = `
            <svg class="animate-spin w-4 h-4 text-rose-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
          `;

          try {
            const res = await fetch(`/api/escaneos/${activeEscaneoId}`, { method: 'DELETE' });
            const data = await res.json();

            if (res.ok && data.success) {
              showToast('Escaneo eliminado permanentemente', 'success');
              drawerFotosFlat.splice(drawerCurrentIndex, 1);
              if (drawerFotosFlat.length === 0) {
                closeDrawer();
                loadAndRenderEscaneos();
                return;
              }
              if (drawerCurrentIndex >= drawerFotosFlat.length) {
                drawerCurrentIndex = drawerFotosFlat.length - 1;
              }
              loadDrawerByIndex(drawerCurrentIndex);
              loadAndRenderEscaneos();
            } else {
              showToast(data.message || 'Error al eliminar escaneo', 'error');
            }
          } catch (e) {
            showToast('Error de conexión al eliminar escaneo', 'error');
          } finally {
            drawerDeleteBtn.disabled = false;
            drawerDeleteBtn.innerHTML = originalHtml;
          }
        });

        drawerRejectBtn?.addEventListener('click', async () => {
          if (!activeEscaneoId) return;
          drawerRejectBtn.disabled = true;
          try {
            await fetch(`/api/escaneos/${activeEscaneoId}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ accion: 'rechazar' })
            });
            // Remover de la lista plana y avanzar
            drawerFotosFlat.splice(drawerCurrentIndex, 1);
            if (drawerFotosFlat.length === 0) { closeDrawer(); loadAndRenderEscaneos(); return; }
            if (drawerCurrentIndex >= drawerFotosFlat.length) drawerCurrentIndex = drawerFotosFlat.length - 1;
            loadDrawerByIndex(drawerCurrentIndex);
            loadAndRenderEscaneos();
          } catch(e) { drawerRejectBtn.disabled = false; }
        });

        drawerApproveBtn?.addEventListener('click', async () => {
          if (!activeEscaneoId) return;

          const id_guia = drawerIdGuia.value.trim();
          const destinatario = drawerDestinatario.value.trim();
          const telefono = drawerTelefono.value.trim();
          const ciudad = drawerCiudad.value.trim();
          const piezas = drawerPiezas.value;
          const empresa = drawerEmpresa ? drawerEmpresa.value.trim() : '';
          const direccion = drawerDireccion.value.trim();

          if (!id_guia || !destinatario || !telefono || !ciudad) {
            drawerError.textContent = 'Completa los campos obligatorios: N° Guía, Destinatario, Teléfono y Ciudad.';
            drawerError.classList.remove('hidden');
            return;
          }
          drawerError.classList.add('hidden');

          const originalHtml = drawerApproveBtn.innerHTML;
          drawerApproveBtn.disabled = true;
          drawerApproveBtn.innerHTML = `<svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg><span>Creando guía...</span>`;

          try {
            const res = await fetch(`/api/escaneos/${activeEscaneoId}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                accion: 'procesar',
                datos_guia: {
                  id_guia,
                  destinatario,
                  telefono_principal: telefono,
                  ciudad_destino: ciudad,
                  piezas,
                  direccion_referencia: direccion,
                  empresa: empresa || undefined
                }
              })
            });
            const data = await res.json();

            if (res.ok && data.success) {
              // Remover foto procesada y avanzar
              drawerFotosFlat.splice(drawerCurrentIndex, 1);
              if (drawerFotosFlat.length === 0) { closeDrawer(); loadAndRenderEscaneos(); silentRefresh(); return; }
              if (drawerCurrentIndex >= drawerFotosFlat.length) drawerCurrentIndex = drawerFotosFlat.length - 1;
              loadDrawerByIndex(drawerCurrentIndex);
              loadAndRenderEscaneos();
              silentRefresh();
            } else {
              drawerError.textContent = data.message || 'Error al crear la guía.';
              drawerError.classList.remove('hidden');
              drawerApproveBtn.disabled = false;
              drawerApproveBtn.innerHTML = originalHtml;
            }
          } catch(e) {
            drawerError.textContent = 'Error de conexión. Intenta de nuevo.';
            drawerError.classList.remove('hidden');
            drawerApproveBtn.disabled = false;
            drawerApproveBtn.innerHTML = originalHtml;
          }
        });

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (isSubmitting) return;

          const guiaInput = document.getElementById('input-guia') as HTMLInputElement;
          const destInput = document.getElementById('input-destinatario') as HTMLInputElement;
          const telInput = document.getElementById('input-telefono') as HTMLInputElement;
          const tel2Input = document.getElementById('input-telefono-2') as HTMLInputElement;
          const ciudadInput = document.getElementById('input-ciudad') as HTMLInputElement;
          const piezasInput = document.getElementById('input-piezas') as HTMLInputElement;
          const empresaInput = document.getElementById('input-empresa') as HTMLSelectElement;
          const dirInput = document.getElementById('input-direccion') as HTMLInputElement;
          const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

          const id_guia = guiaInput.value.trim().toUpperCase();

          // Bloqueo de envío múltiple
          isSubmitting = true;
          submitBtn.disabled = true;
          const originalBtnContent = submitBtn.innerHTML;
          submitBtn.innerHTML = `
            <svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>Guardando en BD...</span>
          `;

          // Payload para PostgreSQL
          const payload = {
            id_guia,
            destinatario: destInput.value.trim(),
            telefono_principal: telInput.value.trim(),
            telefono_secundario: tel2Input.value.trim() || undefined,
            ciudad_destino: ciudadInput.value.trim(),
            piezas: parseInt(piezasInput.value, 10) || 1,
            empresa: empresaInput ? empresaInput.value.trim() || undefined : undefined,
            direccion_referencia: dirInput.value.trim() || undefined
          };

          try {
            const res = await fetch('/api/guias', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            const json = await res.json();

            if (res.ok && json.success) {
              // Agregar al estado local
              shipments.unshift(json.data);

              form.reset();
              piezasInput.value = '1';
              if (empresaInput) empresaInput.value = '';
              guiaInput.focus();

              populateCityFilter();
              renderViews();
              showToast(`Guía #${id_guia} guardada en PostgreSQL`, 'success');
            } else {
              showToast(json.message || 'Error al guardar la guía', 'error');
            }
          } catch (err: any) {
            console.error('Error al registrar guía:', err);
            showToast('Error de conexión con el servidor', 'error');
          } finally {
            isSubmitting = false;
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnContent;
          }
        });

        searchInput.addEventListener('input', renderViews);
        filterCiudad.addEventListener('change', renderViews);
        filterEmpresa?.addEventListener('change', renderViews);
        filterEstado.addEventListener('change', renderViews);
      }

      // Métodos globales para interactividad en tabla (window)
      (window as any).updateShipmentStatus = async (id_guia: string, newStatus: GuiaRow['estado']) => {
        try {
          const res = await fetch(`/api/guias/${encodeURIComponent(id_guia)}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ estado: newStatus })
          });

          const json = await res.json();
          if (res.ok && json.success) {
            const item = shipments.find(s => s.id_guia === id_guia);
            if (item) {
              item.estado = newStatus;
              renderViews();
              showToast(`Estado de guía #${id_guia} actualizado a: ${newStatus}`, 'info');
            }
          } else {
            showToast(json.message || 'Error al actualizar el estado', 'error');
          }
        } catch (err) {
          showToast('Error de red al actualizar estado', 'error');
        }
      };

      (window as any).updateShipmentDriver = async (id_guia: string, driverIdStr: string) => {
        try {
          const chofer_id = driverIdStr ? parseInt(driverIdStr, 10) : null;
          const res = await fetch(`/api/guias/${encodeURIComponent(id_guia)}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              chofer_asignado_id: chofer_id,
              estado: chofer_id ? 'En ruta' : undefined // si se le asigna chofer individual, pasa a En ruta
            })
          });

          const json = await res.json();
          if (res.ok && json.success) {
            const item = shipments.find(s => s.id_guia === id_guia);
            if (item) {
              item.chofer_asignado_id = chofer_id;
              const assignedDriver = drivers.find(d => d.id === chofer_id);
              item.chofer_nombre = assignedDriver ? assignedDriver.nombre : null;
              if (chofer_id && item.estado !== 'Entregado') {
                item.estado = 'En ruta';
              }
              renderViews();
              showToast(`Chofer asignado para #${id_guia}: ${assignedDriver ? assignedDriver.nombre : 'Sin Asignar'}`, 'info');
            }
          } else {
            showToast(json.message || 'Error al asignar chofer', 'error');
          }
