            return { lat: Number(last.gps_latitud), lon: Number(last.gps_longitud), label: 'Última Parada de Entrega' };
          }
        }
        const parsed = parseUniversalLocation(val);
        if (parsed) return parsed;
        return { lat: 10.0808, lon: -69.3756, label: 'Retorno a Sede Principal Barquisimeto' };
      }

