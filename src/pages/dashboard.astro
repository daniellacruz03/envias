            <option value="PENDING_PAST">No Entregadas / Rezagadas (${pastPendingCount} guías)</option>
          `;
          const sortedLotes = Object.keys(loteMap).sort().reverse();
          if (sortedLotes.length > 0) {
            listinOpts += `<optgroup label="Lotes / Manifiestos Detectados">`;
            sortedLotes.forEach(lote => {
              listinOpts += `<option value="${lote}">${lote} (${loteMap[lote]} guías)</option>`;
            });
            listinOpts += `</optgroup>`;
          }
          listinLoteSelect.innerHTML = listinOpts;

          if (prevListinVal && (prevListinVal === 'ALL' || prevListinVal === 'CURRENT_WEEK' || prevListinVal === 'PENDING_PAST' || loteMap[prevListinVal])) {
            listinLoteSelect.value = prevListinVal;
