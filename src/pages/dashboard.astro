                            </td>

                            <!-- Columna Ubicación GPS -->
                            <td class="py-3 px-4">
                              ${hasGps ? `
                                <div class="inline-flex items-center gap-1">
                                  <a href="https://www.google.com/maps?q=${gpsLat},${gpsLon}" target="_blank" class="text-[10px] font-bold text-emerald-700 hover:underline flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                    <span>GPS Listo</span>
                                  </a>
                                  <button
                                    type="button"
                                    onclick="window.openGpsAssignModal('${primary.id_guia}')"
                                    class="p-0.5 rounded text-slate-400 hover:text-slate-700 cursor-pointer"
                                    title="Editar coordenadas GPS"
                                  >
                                    <svg class="w-3 h-3 fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                    </svg>
                                  </button>
                                </div>
                              ` : isGpsConfirmed ? `
                                <div class="inline-flex items-center gap-1">
                                  <span class="text-[10px] font-bold text-emerald-600">Dirección OK</span>
                                  <button
                                    type="button"
                                    onclick="window.openGpsAssignModal('${primary.id_guia}')"
                                    class="p-0.5 rounded text-slate-400 hover:text-slate-700 cursor-pointer"
                                    title="Fijar coordenadas GPS exactas"
                                  >
                                    <svg class="w-3 h-3 fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    </svg>
                                  </button>
                                </div>
                              ` : `
                                <button
                                  type="button"
                                  onclick="window.openGpsAssignModal('${primary.id_guia}')"
                                  class="text-[10px] font-bold text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-200 px-2 py-0.5 rounded-lg flex items-center gap-1 transition-colors cursor-pointer"
                                  title="Fijar coordenadas para este cliente"
                                >
                                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                  <span>+ Fijar GPS</span>
                                </button>
                              `}
                            </td>

                            <!-- Columna Chofer Actual (Asigna a todas las guías del cliente) -->
                            <td class="py-3 px-4">
                              <select
                                onchange="window.updateMultiGuiaDriver('${guiaIdsJoined}', this.value)"
                                class="text-[11px] bg-slate-50 border border-slate-200 rounded-lg px-2 py-1 text-slate-700 focus:outline-none focus:bg-white cursor-pointer max-w-[130px] truncate"
                                title="Asignar chofer a todas las guías de este cliente"
                              >
                                <option value="">Sin Asignar</option>
                                ${drivers.map(driver => `
                                  <option value="${driver.id}" ${commonDriverId === driver.id ? 'selected' : ''}>
                                    ${driver.nombre}
                                  </option>
                                `).join('')}
                              </select>
                            </td>

                            <!-- Columna Acciones -->
                            <td class="py-3 px-4 text-right">
                              <div class="flex items-center justify-end gap-1 flex-wrap">
                                ${comprobanteUrl ? `
                                  <button
                                    type="button"
                                    onclick="window.openLightbox('${comprobanteUrl}', 'Comprobante Guía #${primary.id_guia} - ${primary.destinatario.replace(/'/g, "\\'")}', '${recibidoPor ? `Recibido por: ${recibidoPor.replace(/'/g, "\\'")}` : 'Entrega verificada'}', '${primary.id_guia}', 'guia')"
                                    title="Ver foto comprobante"
                                    class="inline-flex items-center gap-1 bg-slate-900 hover:bg-black text-white font-semibold text-[10px] px-2 py-1 rounded-lg transition-all shadow-xs cursor-pointer"
                                  >
                                    <svg class="w-3 h-3 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                    <span>Foto</span>
                                  </button>
                                ` : ''}
                                ${commonStatus === 'Entregado' ? `
                                  <button
                                    type="button"
                                    onclick="window.archivarGuia('${primary.id_guia}')"
                                    title="Archivar entrega al histórico"
                                    class="inline-flex items-center gap-1 bg-slate-100 hover:bg-slate-200 text-slate-700 hover:text-slate-900 font-bold text-[10px] px-2 py-1 rounded-lg border border-slate-200 transition-all cursor-pointer shadow-2xs"
                                  >
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                                    </svg>
                                    <span>Archivar</span>
                                  </button>
                                ` : ''}
                                <button
                                  type="button"
                                  onclick="window.openEditGuiaModal('${primary.id_guia}')"
                                  title="Editar datos del cliente"
                                  class="p-1 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors cursor-pointer"
                                >
                                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                  </svg>
                                </button>
                                <button
                                  type="button"
                                  onclick="window.sendGroupedWhatsApp('${guiaIdsJoined}')"
                                  title="Enviar WhatsApp con todas las guías de este cliente"
                                  class="inline-flex items-center gap-1 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-[10px] px-2 py-1 rounded-lg transition-all shadow-xs cursor-pointer"
                                >
                                  <span>WhatsApp</span>
                                </button>
                              </div>
                            </td>
                          </tr>
                        `;
                      }).join('');
                    })()}
                  </tbody>
                </table>
              </div>

            </div>
          `;
        }).join('');

        viewContainerCities.innerHTML = summaryHeaderHtml + cardsHtml;
      }

      // Toggle colapsar ciudad
      (window as any).toggleCityExpand = (cityName: string) => {
        expandedCities[cityName] = expandedCities[cityName] === false ? true : false;
        renderViews();
      };

      // Operaciones en Lote Multi-Guía
      (window as any).updateMultiGuiaStatus = async function(guiaIdsCsv: string, newStatus: string) {
        const ids = guiaIdsCsv.split(',').map(s => s.trim()).filter(Boolean);
        if (ids.length === 0) return;

        try {
          const res = await fetch('/api/guias/lote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'bulk_assign',
              ids_guias: ids,
              cambiar_estado: newStatus
            })
          });

          const json = await res.json();
          if (res.ok && json.success) {
            shipments.forEach(s => {
              if (ids.includes(s.id_guia)) {
                s.estado = newStatus;
              }
            });
            renderViews();
            updateKPIs();
            showToast(`Estado actualizado a "${newStatus}" para ${ids.length} guía${ids.length > 1 ? 's' : ''}`, 'info');
          } else {
            showToast(json.message || 'Error al actualizar estado', 'error');
          }
        } catch (err) {
          showToast('Error de red al actualizar estado', 'error');
        }
      };

      (window as any).updateMultiGuiaDriver = async function(guiaIdsCsv: string, driverIdVal: string) {
        const ids = guiaIdsCsv.split(',').map(s => s.trim()).filter(Boolean);
        if (ids.length === 0) return;
        const chofer_id = driverIdVal ? parseInt(driverIdVal, 10) : null;
        const driverObj = drivers.find(d => d.id === chofer_id);
        const driverName = driverObj ? driverObj.nombre : 'Sin Asignar';

        try {
          const res = await fetch('/api/guias/lote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'bulk_assign',
              ids_guias: ids,
              chofer_id: chofer_id,
              cambiar_estado: chofer_id ? 'En ruta' : undefined
            })
          });

          const json = await res.json();
          if (res.ok && json.success) {
            shipments.forEach(s => {
              if (ids.includes(s.id_guia)) {
                s.chofer_asignado_id = chofer_id;
                s.chofer_nombre = driverObj ? driverObj.nombre : null;
                if (chofer_id && s.estado !== 'Entregado') {
                  s.estado = 'En ruta';
                }
              }
            });
            renderViews();
            showToast(`Chofer ${driverName} asignado para ${ids.map(i => '#' + i).join(', ')}`, 'info');
          } else {
            showToast(json.message || 'Error al asignar chofer', 'error');
          }
        } catch (err) {
          showToast('Error de red al asignar chofer', 'error');
        }
      };

      (window as any).sendGroupedWhatsApp = function(guiaIdsCsv: string) {
        const ids = guiaIdsCsv.split(',').map(s => s.trim()).filter(Boolean);
        const clientShipments = shipments.filter(s => ids.includes(s.id_guia));
        if (clientShipments.length === 0) return;

        const first = clientShipments[0];
        const rawPhone = first.telefono_principal || '';
        let cleanPhone = rawPhone.replace(/\D/g, '');
        if (cleanPhone.startsWith('0')) {
          cleanPhone = '58' + cleanPhone.substring(1);
        } else if (!cleanPhone.startsWith('58') && cleanPhone.length === 10) {
          cleanPhone = '58' + cleanPhone;
        }

        const totalPzas = clientShipments.reduce((sum, g) => sum + (g.piezas || 1), 0);
        const confirmUrl = `${window.location.origin}/confirmar?guia=${encodeURIComponent(first.id_guia)}`;

        let text = '';
        if (clientShipments.length === 1) {
          text = `Hola ${first.destinatario}, le saludamos de *Envías C.A.* Le notificamos que su paquete (Guía #${first.id_guia}, ${first.piezas || 1} pieza${(first.piezas || 1) > 1 ? 's' : ''}) con destino a *${first.ciudad_destino}* está programado para entrega.\n\nPor favor confirme su ubicación exacta aquí:\n${confirmUrl}`;
        } else {
          const guiasList = clientShipments.map(g => `• Guía #${g.id_guia} (${g.piezas || 1} pza${g.empresa ? ` - ${g.empresa}` : ''})`).join('\n');
          text = `Hola ${first.destinatario}, le saludamos de *Envías C.A.* Le notificamos que tiene *${clientShipments.length} paquetes* (${totalPzas} piezas en total) con destino a *${first.ciudad_destino}* programados para entrega:\n\n${guiasList}\n\nPor favor confirme su ubicación exacta para todas sus entregas aquí:\n${confirmUrl}`;
        }

        // Marcar todas como contactadas
        ids.forEach(id => {
          (window as any).updateShipmentStatus(id, 'Contactado');
        });

        window.open(`https://wa.me/${cleanPhone}?text=${encodeURIComponent(text)}`, '_blank');
      };

      // ==========================================
      // RENDER VISTA 3: ESTADO Y MONITOREO DE CHOFERES (3 FASES & FOTOS)
      // ==========================================
      function renderDriversView(filtered: GuiaRow[]) {
        if (!viewContainerDrivers) return;

        if (driversCountPill) {
          driversCountPill.textContent = drivers.length.toString();
        }

        if (drivers.length === 0) {
          viewContainerDrivers.innerHTML = `
            <div class="p-12 text-center bg-white rounded-3xl border border-slate-200 text-slate-400">
              No hay choferes registrados en la flota.
            </div>
          `;
          return;
        }

        viewContainerDrivers.innerHTML = drivers.map(driver => {
          const allDriverGuias = shipments.filter(g => g.chofer_asignado_id === driver.id);
          const visibleDriverGuias = filtered.filter(g => g.chofer_asignado_id === driver.id);
          
          // Si hay filtro activo y este chofer no tiene guías que coincidan, ocultar
          const isFilterActive = searchInput.value.trim() !== '' || filterCiudad.value !== 'ALL' || filterEstado.value !== 'ALL';
          if (isFilterActive && visibleDriverGuias.length === 0 && allDriverGuias.length > 0) {
            return '';
          }

          // Separación exacta en las Fases solicitadas:
          // Fase 1: Almacén / Preparación (Por contactar / Contactado)
          const faseAlmacen = visibleDriverGuias.filter(g => g.estado === 'Por contactar' || g.estado === 'Contactado');
          // Fase 2: En Ruta (En ruta)
          const faseEnRuta = visibleDriverGuias.filter(g => g.estado === 'En ruta')
            .sort((a, b) => (a.orden_ruta || 999) - (b.orden_ruta || 999));
          // Fase 3: Entregado / Incidencias (Entregado / No entregado con foto/comprobante)
          const faseEntregado = visibleDriverGuias.filter(g => g.estado === 'Entregado' || g.estado === 'No entregado');

          const totalAssigned = allDriverGuias.length;
          const totalDelivered = allDriverGuias.filter(g => g.estado === 'Entregado').length;
          const totalNoDelivered = allDriverGuias.filter(g => g.estado === 'No entregado').length;
          const totalEnRuta = allDriverGuias.filter(g => g.estado === 'En ruta').length;
          const totalAlmacen = allDriverGuias.filter(g => g.estado === 'Por contactar' || g.estado === 'Contactado').length;
          const pctCompleted = totalAssigned > 0 ? Math.round((totalDelivered / totalAssigned) * 100) : 0;

          // Datos de ruta activa
          const sampleWithRoute = allDriverGuias.find(g => g.ruta_origen || g.ruta_destino);
          const routeOrigin = sampleWithRoute?.ruta_origen || 'Sede Principal Barquisimeto';
          const routeDest = sampleWithRoute?.ruta_destino || 'En Destino';

          const driverInitials = driver.nombre.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
          const phoneFormatted = formatPhoneForWhatsApp(driver.telefono || '04120000000');

          return `
            <div class="bg-white border border-slate-200/90 rounded-3xl shadow-sm overflow-hidden transition-all duration-200">
              
              <!-- Cabecera del Chofer -->
              <div class="p-4 sm:p-6 border-b border-slate-100 bg-gradient-to-r from-slate-50 via-white to-slate-50/50 flex flex-col xl:flex-row xl:items-center justify-between gap-4">
                
                <!-- Identidad del Chofer -->
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 rounded-2xl bg-slate-900 text-white flex items-center justify-center font-extrabold text-sm shadow-md shrink-0">
                    ${driverInitials}
                  </div>
                  <div>
                    <div class="flex items-center gap-2.5 flex-wrap">
                      <h4 class="text-base font-extrabold text-slate-900 tracking-tight">${driver.nombre}</h4>
                      <span class="text-xs font-bold px-2.5 py-0.5 rounded-full ${totalEnRuta > 0 ? 'bg-sky-50 text-sky-700 border border-sky-200 animate-pulse' : totalAssigned > 0 ? 'bg-slate-100 text-slate-700' : 'bg-slate-50 text-slate-400'}">
                        ${totalEnRuta > 0 ? 'En Ruta Activa' : totalAssigned > 0 ? 'Asignado' : 'Disponible'}
                      </span>
                    </div>

                    <div class="flex items-center gap-3 text-xs text-slate-500 font-medium mt-1 flex-wrap">
                      <span class="font-mono">${driver.telefono || 'Sin teléfono'}</span>
                      <span class="text-slate-300">•</span>
                      <span class="text-slate-700 font-bold">${totalAssigned} ${totalAssigned === 1 ? 'guía asignada' : 'guías asignadas'}</span>
                      ${totalAssigned > 0 ? `
                        <span class="text-slate-300">•</span>
                        <span class="text-indigo-600 font-semibold truncate max-w-[280px]" title="${routeOrigin} ➔ ${routeDest}">
                          ${routeOrigin} ➔ ${routeDest}
                        </span>
                      ` : ''}
                    </div>
                  </div>
                </div>

                <!-- Barra de Progreso y Acciones Rápidas -->
                <div class="flex flex-wrap items-center gap-3 xl:gap-4">
                  <!-- Barra de Progreso de Entregas -->
                  <div class="bg-white px-3.5 py-2 rounded-2xl border border-slate-200/80 shadow-2xs min-w-[200px] flex-1 sm:flex-none">
                    <div class="flex items-center justify-between text-[11px] font-bold text-slate-700 mb-1.5">
                      <span>Progreso de Jornada</span>
                      <span class="${pctCompleted === 100 ? 'text-emerald-600' : 'text-slate-900'}">${totalDelivered} / ${totalAssigned} (${pctCompleted}%)</span>
                    </div>
                    <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                      <div class="h-full rounded-full transition-all duration-500 ${pctCompleted === 100 ? 'bg-emerald-500' : 'bg-indigo-600'}" style="width: ${pctCompleted}%"></div>
                    </div>
                  </div>

                  <!-- Botones de Acción con el Chofer -->
                  <div class="flex items-center gap-1.5 flex-wrap">
                    ${totalAlmacen > 0 ? `
                      <button
                        type="button"
                        onclick="window.dispatchDriverToRoute(${driver.id})"
                        class="px-3 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 cursor-pointer active:scale-95"
                        title="Despachar las ${totalAlmacen} guías de ${driver.nombre} que están en almacén para pasar a En Ruta"
                      >
                        <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                        <span>Despachar a Ruta (${totalAlmacen})</span>
                      </button>
                    ` : ''}

                    ${driver.telefono ? `
                      <a
                        href="https://wa.me/${phoneFormatted}?text=${encodeURIComponent(`Hola ${driver.nombre}, te contactamos desde Logística Central de Envías C.A.`)}"
                        target="_blank"
                        class="p-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 transition-colors shadow-2xs"
                        title="Contactar al chofer por WhatsApp"
                      >
                        <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                        </svg>
                      </a>
                    ` : ''}

                    <button
                      type="button"
                      onclick="window.openRoutePlannerModal(${driver.id})"
                      class="px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 cursor-pointer active:scale-95"
                      title="Abrir planificador de ruta para este chofer"
                    >
                      <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                      </svg>
                      <span>Organizar Ruta</span>
                    </button>

                    ${totalAssigned > 0 ? `
                      <button
                        type="button"
                        onclick="window.openFinalizarRutaModal(${driver.id})"
                        class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-900 text-white text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 cursor-pointer active:scale-95 border border-slate-700"
                        title="Finalizar y archivar ruta de ${driver.nombre}"
                      >
                        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>Finalizar Ruta</span>
                      </button>
                    ` : ''}
                  </div>
                </div>

              </div>

              <!-- TABLERO KANBAN DE LAS 3 FASES DEL CHOFER -->
              <div class="p-4 sm:p-6 bg-slate-50/40">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-5">
                  
                  <!-- ======================================= -->
                  <!-- FASE 1: ALMACÉN / EN PREPARACIÓN        -->
                  <!-- ======================================= -->
                  <div class="bg-white rounded-2xl border border-slate-200/90 p-3.5 space-y-3 shadow-2xs flex flex-col">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
                      <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                        <h5 class="text-xs font-extrabold text-slate-900 uppercase tracking-wider">1. En Almacén</h5>
                      </div>
                      <span class="text-[11px] font-extrabold px-2 py-0.2 rounded-full bg-amber-50 text-amber-800 border border-amber-200">
                        ${faseAlmacen.length}
                      </span>
                    </div>

                    <div class="space-y-2 flex-1 overflow-y-auto max-h-96 pr-0.5 custom-scrollbar">
                      ${faseAlmacen.length === 0 ? `
                        <div class="p-5 text-center text-slate-400 text-xs italic bg-slate-50/60 rounded-xl border border-dashed border-slate-200">
                          Sin guías pendientes en almacén
                        </div>
                      ` : faseAlmacen.map(g => `
                        <div class="p-3 bg-slate-50/70 hover:bg-slate-50 border border-slate-200/80 rounded-xl space-y-1.5 transition-all">
                          <div class="flex items-center justify-between gap-1">
                            <div class="flex items-center gap-1.5 flex-wrap">
                              <a href="/confirmar?guia=${encodeURIComponent(g.id_guia)}" target="_blank" class="font-mono font-bold text-xs text-slate-900 hover:text-indigo-600">
                                #${g.id_guia}
                              </a>
                              ${g.empresa ? `
                                <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-purple-50 text-purple-700 border border-purple-200">
                                  ${g.empresa}
                                </span>
                              ` : ''}
                            </div>
                            <div class="flex items-center gap-1">
                              <button
                                type="button"
                                onclick="window.openEditGuiaModal('${g.id_guia}')"
                                title="Editar datos de la guía #${g.id_guia}"
                                class="p-1 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded transition-colors cursor-pointer"
                              >
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                              </button>
                              <span class="text-[10px] font-bold px-2 py-0.2 rounded-md ${g.estado === 'Contactado' ? 'bg-indigo-50 text-indigo-700 border border-indigo-200' : 'bg-amber-50 text-amber-700 border border-amber-200'}">
                                ${g.estado}
                              </span>
                            </div>
                          </div>
                          <p class="text-xs font-bold text-slate-800 truncate">${g.destinatario}</p>
                          <div class="flex items-center justify-between text-[11px] text-slate-500">
                            <span class="font-semibold text-slate-700">${g.ciudad_destino}</span>
                            <span class="text-slate-400 font-mono text-[10px] font-bold">${g.piezas || 1} pz${g.pies_cubicos ? ' · ' + Number(g.pies_cubicos).toFixed(2) + ' ft³' : ''}</span>
                          </div>
                        </div>
                      `).join('')}
                    </div>
                  </div>

                  <!-- ======================================= -->
                  <!-- FASE 2: EN RUTA / EN CAMINO             -->
                  <!-- ======================================= -->
                  <div class="bg-white rounded-2xl border border-slate-200/90 p-3.5 space-y-3 shadow-2xs flex flex-col">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
                      <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-sky-500 animate-ping"></span>
                        <h5 class="text-xs font-extrabold text-slate-900 uppercase tracking-wider">2. En Ruta</h5>
                      </div>
                      <span class="text-[11px] font-extrabold px-2 py-0.2 rounded-full bg-sky-50 text-sky-800 border border-sky-200">
                        ${faseEnRuta.length}
                      </span>
                    </div>

                    <div class="space-y-2 flex-1 overflow-y-auto max-h-96 pr-0.5 custom-scrollbar">
                      ${faseEnRuta.length === 0 ? `
                        <div class="p-5 text-center text-slate-400 text-xs italic bg-slate-50/60 rounded-xl border border-dashed border-slate-200">
                          Sin guías en tránsito actualmente
                        </div>
                      ` : faseEnRuta.map((g, idx) => `
                        <div class="p-3 bg-sky-50/40 hover:bg-sky-50/70 border border-sky-100 rounded-xl space-y-1.5 transition-all">
                          <div class="flex items-center justify-between gap-1">
                            <div class="flex items-center gap-1.5 flex-wrap">
                              <span class="w-5 h-5 rounded-md bg-slate-900 text-white font-mono font-bold text-[10px] flex items-center justify-center">
                                ${g.orden_ruta || idx + 1}
                              </span>
                              <a href="/confirmar?guia=${encodeURIComponent(g.id_guia)}" target="_blank" class="font-mono font-bold text-xs text-slate-900 hover:text-indigo-600">
                                #${g.id_guia}
                              </a>
                              ${g.empresa ? `
                                <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-purple-50 text-purple-700 border border-purple-200">
                                  ${g.empresa}
                                </span>
                              ` : ''}
                            </div>
                            <div class="flex items-center gap-1">
                              <button
                                type="button"
                                onclick="window.openEditGuiaModal('${g.id_guia}')"
                                title="Editar datos de la guía #${g.id_guia}"
                                class="p-1 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded transition-colors cursor-pointer"
                              >
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                              </button>
                              ${g.gps_confirmado && g.gps_latitud && g.gps_longitud ? `
                                <a
                                  href="https://www.google.com/maps/search/?api=1&query=${g.gps_latitud},${g.gps_longitud}"
                                  target="_blank"
                                  class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded flex items-center gap-0.5"
                                  title="Ver punto satelital en Maps"
                                >
                                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                  <span>GPS</span>
                                </a>
                              ` : `
                                <span class="text-[10px] text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded font-semibold">Pendiente GPS</span>
                              `}
                            </div>
                          </div>

                          <p class="text-xs font-bold text-slate-800 truncate">${g.destinatario}</p>
                          <div class="flex items-center justify-between text-[11px] text-slate-500">
                            <span class="truncate">${g.direccion_referencia || g.ciudad_destino}</span>
                            <span class="text-slate-400 font-mono text-[10px] font-bold shrink-0 ml-1">${g.piezas || 1} pz${g.pies_cubicos ? ' · ' + Number(g.pies_cubicos).toFixed(2) + ' ft³' : ''}</span>
                          </div>
                        </div>
                      `).join('')}
                    </div>
                  </div>

                  <!-- ======================================= -->
                  <!-- FASE 3: ENTREGADO & INCIDENCIAS DE FOTO -->
                  <!-- ======================================= -->
                  <div class="bg-white rounded-2xl border border-slate-200/90 p-3.5 space-y-3 shadow-2xs flex flex-col">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
                      <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                        <h5 class="text-xs font-extrabold text-slate-900 uppercase tracking-wider">3. Entregado / Finalizado</h5>
                      </div>
                      <div class="flex items-center gap-1">
                        <span class="text-[11px] font-extrabold px-2 py-0.2 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200" title="Entregas completadas">
                          ${visibleDriverGuias.filter(g => g.estado === 'Entregado').length}
                        </span>
                        ${visibleDriverGuias.filter(g => g.estado === 'No entregado').length > 0 ? `
                          <span class="text-[11px] font-extrabold px-2 py-0.2 rounded-full bg-rose-50 text-rose-800 border border-rose-200" title="No entregadas / Incidencias">
                            ${visibleDriverGuias.filter(g => g.estado === 'No entregado').length}
                          </span>
                        ` : ''}
                      </div>
                    </div>

                    <div class="space-y-2.5 flex-1 overflow-y-auto max-h-96 pr-0.5 custom-scrollbar">
                      ${faseEntregado.length === 0 ? `
                        <div class="p-5 text-center text-slate-400 text-xs italic bg-slate-50/60 rounded-xl border border-dashed border-slate-200">
                          Aún no hay entregas confirmadas en esta jornada
                        </div>
                      ` : faseEntregado.map(g => {
                        const isNoEntregado = g.estado === 'No entregado';
                        return `
                        <div class="p-3 ${isNoEntregado ? 'bg-rose-50/30 hover:bg-rose-50/60 border-rose-100' : 'bg-emerald-50/30 hover:bg-emerald-50/60 border-emerald-100'} border rounded-xl space-y-2 transition-all">
                          <div class="flex items-center justify-between gap-1">
                            <div class="flex items-center gap-1.5 flex-wrap">
                              <a href="/confirmar?guia=${encodeURIComponent(g.id_guia)}" target="_blank" class="font-mono font-bold text-xs ${isNoEntregado ? 'text-rose-900 hover:text-rose-700' : 'text-slate-900 hover:text-emerald-700'}">
                                #${g.id_guia}
                              </a>
                              ${g.empresa ? `
                                <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-purple-50 text-purple-700 border border-purple-200">
                                  ${g.empresa}
                                </span>
                              ` : ''}
                            </div>
                            <div class="flex items-center gap-1 flex-wrap">
                              ${!isNoEntregado ? `
                                <button
                                  type="button"
                                  onclick="window.archivarGuia('${g.id_guia}')"
                                  title="Archivar entrega al histórico"
                                  class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 transition-all cursor-pointer shadow-2xs"
                                >
                                  Archivar
                                </button>
                              ` : ''}
                              <button
                                type="button"
                                onclick="window.openEditGuiaModal('${g.id_guia}')"
                                title="Editar datos de la guía #${g.id_guia}"
                                class="p-1 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded transition-colors cursor-pointer"
                              >
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                              </button>
                              <span class="text-[10px] font-bold px-2 py-0.2 rounded-md ${isNoEntregado ? 'bg-rose-100 text-rose-800' : 'bg-emerald-100 text-emerald-800'} flex items-center gap-1">
                                ${isNoEntregado ? `
                                  <svg class="w-3 h-3 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                                  <span>No entregado</span>
                                ` : `
                                  <svg class="w-3 h-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                  <span>Entregado</span>
                                `}
                              </span>
                            </div>
                          </div>

                          <div>
                            <div class="flex items-center justify-between">
                              <p class="text-xs font-bold text-slate-800 truncate">${g.destinatario}</p>
                              <span class="text-slate-400 font-mono text-[10px] font-bold shrink-0 ml-1">${g.piezas || 1} pz${g.pies_cubicos ? ' · ' + Number(g.pies_cubicos).toFixed(2) + ' ft³' : ''}</span>
                            </div>
                            <p class="text-[11px] text-slate-500 truncate mt-0.5">
                              <span class="font-semibold ${isNoEntregado ? 'text-rose-700' : 'text-slate-700'}">${isNoEntregado ? 'Motivo:' : 'Recibió:'}</span> ${g.recibido_por || (isNoEntregado ? 'Cliente ausente / No contesta' : 'Titular')}
                            </p>
                          </div>

                          <!-- VISOR DE COMPROBANTE DE FOTO O EVIDENCIA -->
                          ${g.comprobante_url ? `
                            <div
                              class="relative rounded-xl overflow-hidden border ${isNoEntregado ? 'border-rose-200' : 'border-emerald-200'} bg-slate-100 group/thumb cursor-pointer aspect-video"
                              onclick="window.openLightbox('${g.comprobante_url}', '${isNoEntregado ? 'Evidencia de Intento Fallido' : 'Comprobante de Entrega'} - Guía #${g.id_guia}', '${g.recibido_por ? `${isNoEntregado ? 'Motivo:' : 'Recibido por:'} ${g.recibido_por.replace(/'/g, "\\'")}` : ''} • Chofer: ${driver.nombre}', '${g.id_guia}', 'guia')"
                              title="Haz clic para ampliar la foto"
                            >
                              <img src="${getComprobanteImgSrc(g)}" alt="Comprobante #${g.id_guia}" class="w-full h-full object-cover group-hover/thumb:scale-105 transition-transform duration-200" />
                              <div class="absolute inset-0 bg-slate-900/50 opacity-0 group-hover/thumb:opacity-100 transition-opacity flex items-center justify-center gap-1.5 text-white text-[11px] font-bold">
                                <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                                <span>Ver ${isNoEntregado ? 'Evidencia' : 'Comprobante'}</span>
                              </div>
                              <span class="absolute bottom-1 right-1 bg-black/75 text-white text-[9px] font-bold px-1.5 py-0.2 rounded backdrop-blur-2xs flex items-center gap-0.5">
                                <svg class="w-2.5 h-2.5 ${isNoEntregado ? 'text-rose-400' : 'text-emerald-400'}" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                <span>${getComprobanteAllSrcs(g).split(',').filter(Boolean).length > 1 ? `${getComprobanteAllSrcs(g).split(',').filter(Boolean).length} fotos` : 'Foto'}</span>
                              </span>
                            </div>
                          ` : `
                            <div class="py-1.5 px-2 rounded-lg bg-slate-50 border border-dashed border-slate-200 text-[10px] text-slate-400 flex items-center justify-center gap-1">
                              <svg class="w-3 h-3 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                              <span>Sin foto adjunta</span>
                            </div>
                          `}
                        </div>
                      `;
                      }).join('')}
                    </div>
                  </div>

                </div>
              </div>

            </div>
          `;
        }).join('');
      }

      // ==========================================
      // RENDER VISTA 4: UBICACIONES DE CLIENTES Y MAPA GPS
      // ==========================================
      let clientLocationsMap: any = null;
      let clientLocationsMarkerGroup: any = null;
      let clientMarkersMap: Record<string, any> = {};

      function renderClientLocationsSection() {
        const gpsCount = shipments.filter(s => s.gps_confirmado && s.gps_latitud && s.gps_longitud).length;
        const pendCount = shipments.filter(s => !s.gps_confirmado || !s.gps_latitud).length;

        if (mapaKpiGps) mapaKpiGps.textContent = gpsCount.toString();
        if (mapaKpiPend) mapaKpiPend.textContent = pendCount.toString();
        if (mapaCountPill) {
          mapaCountPill.textContent = gpsCount.toString();
          mapaCountPill.className = gpsCount > 0
            ? 'text-[10px] bg-emerald-100 text-emerald-800 px-1.5 py-0.2 rounded-full font-bold'
            : 'text-[10px] bg-slate-200 text-slate-600 px-1.5 py-0.2 rounded-full font-bold';
        }

        renderClientLocationsMap();
        renderClientLocationsCards();
      }

      function initClientLocationsMap() {
        const mapEl = document.getElementById('clientes-main-map');
        if (!mapEl || clientLocationsMap) return;

        if (typeof (window as any).L === 'undefined') {
          setTimeout(initClientLocationsMap, 100);
          return;
        }

        const L = (window as any).L;
        clientLocationsMap = L.map('clientes-main-map', {
          zoomControl: true,
          attributionControl: false
        }).setView([10.0808, -69.3756], 7);

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '© OpenStreetMap'
        }).addTo(clientLocationsMap);

        clientLocationsMarkerGroup = L.layerGroup().addTo(clientLocationsMap);
      }

      (window as any).renderClientLocationsMap = () => {
        renderClientLocationsMap();
      };

      function renderClientLocationsMap() {
        if (!clientLocationsMap) {
          initClientLocationsMap();
        }

        if (!clientLocationsMap || !clientLocationsMarkerGroup) return;

        const L = (window as any).L;
        if (!L) return;

        setTimeout(() => {
          if (clientLocationsMap) clientLocationsMap.invalidateSize();
        }, 120);

        clientLocationsMarkerGroup.clearLayers();
        clientMarkersMap = {};

        const filterType = mapaFilterType ? mapaFilterType.value : 'ALL';
        const filtered = getFilteredShipments();
        const latlngs: [number, number][] = [];

        filtered.forEach(g => {
          let lat: number | null = null;
          let lon: number | null = null;
          let isExactGps = false;

          if (g.gps_confirmado && g.gps_latitud && g.gps_longitud) {
            lat = Number(g.gps_latitud);
            lon = Number(g.gps_longitud);
            isExactGps = true;
          } else if (filterType !== 'GPS_CONFIRMED') {
            const parsed = parseUniversalLocation(g.ciudad_destino || '');
            if (parsed) {
              lat = parsed.lat;
              lon = parsed.lon;
              isExactGps = false;
            }
          }

          if (filterType === 'GPS_CONFIRMED' && !isExactGps) return;
          if (filterType === 'PENDING' && isExactGps) return;

          if (lat !== null && lon !== null && !isNaN(lat) && !isNaN(lon)) {
            latlngs.push([lat, lon]);

            const driver = drivers.find(d => d.id === g.chofer_asignado_id);
            const driverName = driver ? driver.nombre : 'Sin Asignar';
            const phoneFormatted = formatPhoneForWhatsApp(g.telefono_principal || '');

            const pinHtml = isExactGps ? `
              <div class="relative flex items-center justify-center w-8 h-8 rounded-full bg-emerald-600 border-2 border-white shadow-lg text-white font-extrabold text-[10px] cursor-pointer transform hover:scale-110 transition-transform">
                <span class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-emerald-400 rounded-full animate-ping"></span>
                <span>${g.id_guia.slice(-3)}</span>
              </div>
            ` : `
              <div class="relative flex items-center justify-center w-7 h-7 rounded-full bg-slate-800 border-2 border-indigo-300 shadow-md text-indigo-200 font-extrabold text-[9px] cursor-pointer transform hover:scale-110 transition-transform">
                <span>${g.id_guia.slice(-3)}</span>
              </div>
            `;

            const icon = L.divIcon({
              html: pinHtml,
              className: 'client-map-pin',
              iconSize: [32, 32],
              iconAnchor: [16, 16],
              popupAnchor: [0, -16]
            });

            const popupContent = `
              <div class="p-1 min-w-[220px] text-slate-800 font-sans text-left">
                <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-1.5 mb-1.5">
                  <div class="flex items-center gap-1">
                    <span class="font-mono font-extrabold text-xs text-slate-900">#${g.id_guia}</span>
                    ${g.empresa ? `<span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-purple-50 text-purple-700 border border-purple-200">${g.empresa}</span>` : ''}
                  </div>
                  <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full ${isExactGps ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-slate-100 text-slate-600'}">
                    ${isExactGps ? 'GPS Confirmado' : 'Ref. Ciudad'}
                  </span>
                </div>

                <p class="font-extrabold text-xs text-slate-900 leading-tight">${g.destinatario}</p>
                <p class="text-[11px] text-slate-500 font-mono mt-0.5">${g.telefono_principal}</p>

                <div class="mt-2 p-2 rounded-xl bg-slate-50 border border-slate-200/80 text-[11px] space-y-1">
                  <div><span class="font-bold text-slate-600">Ciudad:</span> <span class="font-semibold text-slate-900">${g.ciudad_destino}</span></div>
                  ${g.direccion_referencia ? `<div><span class="font-bold text-slate-600">Referencia:</span> <span class="text-slate-800 font-medium">${g.direccion_referencia}</span></div>` : ''}
                  ${g.hora_disponible ? `<div><span class="font-bold text-indigo-600">Horario:</span> <span class="font-semibold text-indigo-800">${g.hora_disponible}</span></div>` : ''}
                  <div><span class="font-bold text-slate-600">Chofer:</span> <span class="font-bold ${driver ? 'text-emerald-700' : 'text-slate-400'}">${driverName}</span></div>
                </div>

                <div class="mt-2.5 flex items-center justify-between gap-1.5">
                  <a
                    href="https://wa.me/${phoneFormatted}?text=${encodeURIComponent(`Hola ${g.destinatario}, te contactamos de Envías C.A. sobre tu guía #${g.id_guia}`)}"
                    target="_blank"
                    class="px-2 py-1 bg-emerald-600 hover:bg-emerald-700 text-white text-[10px] font-bold rounded-lg transition-colors inline-flex items-center gap-1 cursor-pointer"
                  >
                    WhatsApp
                  </a>
                  ${isExactGps ? `
                    <a
                      href="https://www.google.com/maps?q=${lat},${lon}"
                      target="_blank"
                      class="px-2 py-1 bg-slate-900 hover:bg-black text-white text-[10px] font-bold rounded-lg transition-colors"
                    >
                      Google Maps
                    </a>
                  ` : ''}
                  <button
                    type="button"
                    onclick="window.openEditGuiaModal('${g.id_guia}')"
                    class="px-2 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 text-[10px] font-bold rounded-lg transition-colors cursor-pointer"
                  >
                    Editar
                  </button>
                </div>
              </div>
            `;

            const marker = L.marker([lat, lon], { icon }).addTo(clientLocationsMarkerGroup)
              .bindPopup(popupContent);

            clientMarkersMap[g.id_guia] = marker;
          }
        });

        if (latlngs.length >= 2) {
          try {
            const bounds = L.latLngBounds(latlngs);
            clientLocationsMap.fitBounds(bounds, { padding: [50, 50], maxZoom: 14 });
          } catch(e) {}
        } else if (latlngs.length === 1) {
          clientLocationsMap.setView(latlngs[0], 13);
        }
      }

