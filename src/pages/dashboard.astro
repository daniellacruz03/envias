---
import '../styles/global.css';
import { getUserFromCookies } from '../lib/auth';

// Protección de Ruta: Validar sesión activa en SSR
const currentUser = getUserFromCookies(Astro.cookies);
if (!currentUser) {
  return Astro.redirect('/login');
}

// Si el usuario es Chofer, redirigir a su portal correspondiente
if (currentUser.rol === 'Chofer') {
  return Astro.redirect('/chofer');
}

// Encabezados anti-caché para impedir que al pulsar "Atrás" se vea la sesión cerrada
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

const title = "Envías | Logística Central - Panel Operativo";

// Iniciales del usuario para el avatar
const userInitials = currentUser.nombre
  ? currentUser.nombre.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase()
  : 'US';
---

<!doctype html>
<html lang="es" class="h-full bg-slate-50/50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Leaflet CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>
    
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
      /* Custom scrollbar para la tabla */
      .custom-scrollbar::-webkit-scrollbar {
        height: 6px;
      }
      .custom-scrollbar::-webkit-scrollbar-track {
        background: #f8fafc;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 9999px;
      }
      .tab-btn-active {
        background-color: #0f172a !important;
        color: #ffffff !important;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.15);
      }
    </style>
  </head>
  <body class="min-h-full flex flex-col text-slate-800 bg-[#F8FAFC] antialiased selection:bg-slate-900 selection:text-white">
    
    <!-- ========================================== -->
    <!-- 1. BARRA SUPERIOR (HEADER CORPORATIVO)     -->
    <!-- ========================================== -->
    <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200/80 px-4 sm:px-8 py-3.5 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <!-- Logo & Marca -->
        <div class="flex items-center gap-3">
          <img 
            src="/logo.png" 
            alt="Envías C.A." 
            class="h-8 sm:h-9 w-auto object-contain mix-blend-multiply filter contrast-[1.20] brightness-[0.96]"
            loading="eager"
          />
          <div class="border-l border-slate-200 pl-3">
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-slate-900 text-white tracking-wider uppercase">Central</span>
              <span class="text-xs font-semibold text-slate-700 hidden sm:inline">Logística</span>
            </div>
            <p class="text-[11px] text-slate-400 font-medium">Panel de Despacho y Envíos</p>
          </div>
        </div>
      </div>

        <!-- Estado Operativo y Perfil -->
      <div class="flex items-center gap-3 sm:gap-6">
        <div class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50/80 border border-emerald-200/60 text-xs font-semibold text-emerald-700">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          Panel Operativo Activo
        </div>

        <!-- Usuario Conectado y Cerrar Sesión -->
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center text-xs font-bold shadow-xs">
              {userInitials}
            </div>
            <div class="hidden sm:block text-left">
              <p class="text-xs font-bold text-slate-900 leading-tight">{currentUser.nombre}</p>
              <p class="text-[10px] text-slate-400 font-medium">{currentUser.rol === 'Logistica' ? 'Logística Central' : currentUser.rol}</p>
            </div>
          </div>

          <a
            href="/api/auth/logout"
            title="Cerrar Sesión"
            class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-xl transition-colors cursor-pointer flex items-center gap-1.5 text-xs font-semibold"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span class="hidden md:inline">Salir</span>
          </a>
        </div>
      </div>
    </header>

    <!-- ========================================== -->
    <!-- CONTENIDO PRINCIPAL                        -->
    <!-- ========================================== -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-6">
      
      <!-- Métricas Rápidas (KPIs) -->
      <section class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        <div class="bg-white border border-slate-200/80 rounded-2xl p-4 shadow-sm">
          <p class="text-xs font-medium text-slate-500">Total de Guías</p>
          <p id="kpi-total" class="text-2xl font-extrabold text-slate-900 mt-1">0</p>
        </div>
        <div class="bg-white border border-slate-200/80 rounded-2xl p-4 shadow-sm">
          <p class="text-xs font-medium text-slate-500">Por Contactar</p>
          <p id="kpi-contactar" class="text-2xl font-extrabold text-amber-600 mt-1">0</p>
        </div>
        <div class="bg-white border border-slate-200/80 rounded-2xl p-4 shadow-sm">
          <p class="text-xs font-medium text-slate-500">En Ruta / Tránsito</p>
          <p id="kpi-ruta" class="text-2xl font-extrabold text-indigo-600 mt-1">0</p>
        </div>
        <div class="bg-white border border-slate-200/80 rounded-2xl p-4 shadow-sm">
          <p class="text-xs font-medium text-slate-500">GPS Confirmado</p>
          <p id="kpi-gps" class="text-2xl font-extrabold text-emerald-600 mt-1">0</p>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- 2. FORMULARIO DE CARGA RÁPIDA DE GUÍAS     -->
      <!-- ========================================== -->
      <section class="bg-white border border-slate-200/80 rounded-2xl p-5 sm:p-6 shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
          <div>
            <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Carga Rápida de Envíos
            </h2>
            <p class="text-xs text-slate-500">Ingresa los datos para generar la orden y habilitar el enlace de WhatsApp</p>
          </div>
          <span class="text-[11px] font-medium text-slate-400 hidden sm:inline">Entrada ágil por teclado</span>
        </div>

        <form id="new-shipment-form" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3.5" autocomplete="off">
          
          <!-- Número de Guía -->
          <div class="lg:col-span-1 space-y-1">
            <label for="input-guia" class="block text-xs font-semibold text-slate-700">
              N° Guía <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="input-guia"
              required
              placeholder="Ej: 98215"
              class="w-full font-mono text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all uppercase"
            />
          </div>

          <!-- Nombre y Apellido -->
          <div class="lg:col-span-2 space-y-1">
            <label for="input-destinatario" class="block text-xs font-semibold text-slate-700">
              Destinatario <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="input-destinatario"
              required
              placeholder="Nombre y Apellido completo"
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
            />
          </div>

          <!-- Teléfono / WhatsApp Principal -->
          <div class="lg:col-span-1 space-y-1">
            <label for="input-telefono" class="block text-xs font-semibold text-slate-700">
              Teléfono (WhatsApp) <span class="text-rose-500">*</span>
            </label>
            <input
              type="tel"
              id="input-telefono"
              required
              placeholder="Ej: 04141234567"
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
            />
          </div>

          <!-- Teléfono Secundario / Alternativo (Opcional) -->
          <div class="lg:col-span-1 space-y-1">
            <label for="input-telefono-2" class="block text-xs font-semibold text-slate-700">
              Teléfono 2 <span class="text-slate-400 font-normal">(Opcional)</span>
            </label>
            <input
              type="tel"
              id="input-telefono-2"
              placeholder="Ej: 04129876543"
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
            />
          </div>

          <!-- Ciudad Destino -->
          <div class="lg:col-span-1 space-y-1">
            <label for="input-ciudad" class="block text-xs font-semibold text-slate-700">
              Ciudad Destino <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="input-ciudad"
              required
              placeholder="Ej: Mérida"
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
            />
          </div>

          <!-- N° Piezas -->
          <div class="lg:col-span-1 space-y-1">
            <label for="input-piezas" class="block text-xs font-semibold text-slate-700">
              Piezas <span class="text-rose-500">*</span>
            </label>
            <input
              type="number"
              id="input-piezas"
              required
              min="1"
              value="1"
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
            />
          </div>

          <!-- Empresa / Courier Aliado -->
          <div class="lg:col-span-1 space-y-1">
            <label for="input-empresa" class="block text-xs font-semibold text-slate-700">
              Empresa / Courier
            </label>
            <select
              id="input-empresa"
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all cursor-pointer"
            >
              <option value="">Seleccionar Empresa...</option>
              <option value="Troop">Troop</option>
              <option value="Crazy cargo">Crazy cargo</option>
              <option value="Cargo King">Cargo King</option>
              <option value="JJ">JJ</option>
              <option value="Greymar">Greymar</option>
              <option value="Ajbp">Ajbp</option>
              <option value="Global jats">Global jats</option>
              <option value="Su descarga">Su descarga</option>
              <option value="Rima cargo">Rima cargo</option>
              <option value="Dina cargo">Dina cargo</option>
              <option value="Send logístics">Send logístics</option>
              <option value="Alas cargo">Alas cargo</option>
              <option value="Aexpress">Aexpress</option>
              <option value="Priority">Priority</option>
              <option value="Alpi">Alpi</option>
              <option value="Venexcargo">Venexcargo</option>
              <option value="DBL">DBL</option>
              <option value="2BC">2BC</option>
            </select>
          </div>

          <!-- Dirección / Referencias -->
          <div class="sm:col-span-2 lg:col-span-2 space-y-1">
            <label for="input-direccion" class="block text-xs font-semibold text-slate-700">
              Dirección Inicial / Referencias <span class="text-slate-400 font-normal">(Opcional)</span>
            </label>
            <input
              type="text"
              id="input-direccion"
              placeholder="Ej: Av. Las Américas, frente al C.C. Plaza Mayor"
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
            />
          </div>

          <!-- Botón de Envío -->
          <div class="sm:col-span-2 lg:col-span-2 flex items-end">
            <button
              type="submit"
              class="w-full bg-slate-900 hover:bg-black text-white font-semibold text-xs py-2.5 px-4 rounded-xl transition-all duration-200 active:scale-[0.98] shadow-sm flex items-center justify-center gap-2 h-[41px] cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
              </svg>
              <span>Registrar Guía</span>
            </button>
          </div>
        </form>
      </section>

      <!-- ========================================== -->
      <!-- 3. TABLERO DE CONTROL Y MODOS DE VISTA     -->
      <!-- ========================================== -->
      <section class="bg-white border border-slate-200/80 rounded-2xl shadow-sm overflow-hidden flex flex-col">
        
        <!-- Barra Superior de Control y Switcher de Modos -->
        <div class="p-4 sm:p-5 border-b border-slate-200/80 flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-slate-50/40">
          
          <div class="flex flex-wrap items-center gap-3">
            <div>
              <h3 class="text-sm font-bold text-slate-900">Envíos Registrados</h3>
              <span id="filtered-count-badge" class="text-[11px] font-semibold text-slate-500">
                0 guías
              </span>
            </div>

            <div class="h-4 w-px bg-slate-200 hidden sm:block"></div>

            <!-- Selector de Modo de Vista (Tabs) -->
            <div class="flex items-center p-1 bg-slate-200/70 rounded-xl text-xs font-semibold gap-1">
              <button
                type="button"
                id="btn-view-table"
                class="tab-btn-active px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer text-slate-600 hover:text-slate-900"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                </svg>
                <span>Lista General</span>
              </button>

              <button
                type="button"
                id="btn-view-cities"
                class="px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer text-slate-600 hover:text-slate-900"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                <span>Agrupado por Ciudad</span>
                <span id="cities-count-pill" class="text-[10px] bg-slate-300/80 px-1.5 py-0.2 rounded-full font-bold">0</span>
              </button>

              <button
                type="button"
                id="btn-view-drivers"
                class="px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer text-slate-600 hover:text-slate-900"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span>Estado de Choferes</span>
                <span id="drivers-count-pill" class="text-[10px] bg-slate-300/80 px-1.5 py-0.2 rounded-full font-bold">0</span>
            </div>

            <!-- 4ta Pestaña: Revisar Guías Escaneadas -->
            <button
              type="button"
              id="btn-view-escaneos"
              class="px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer text-slate-600 hover:text-slate-900"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Revisar Guias</span>
              <span id="escaneos-count-pill" class="text-[10px] bg-slate-300/80 px-1.5 py-0.2 rounded-full font-bold hidden">0</span>
            </button>
          </div>

            <!-- Botón Principal: Abrir Planificador de Rutas (Spoke Style) -->
            <button
              type="button"
              onclick="window.openRoutePlannerModal()"
              class="px-3.5 py-1.5 rounded-xl bg-slate-900 hover:bg-black active:scale-95 text-white font-bold text-xs flex items-center gap-1.5 shadow-sm transition-all cursor-pointer"
              title="Planificar secuencia de paradas de chofer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
              <span>Planificar Ruta Spoke</span>
            </button>
          </div>

          <!-- Filtros y Buscador -->
          <div class="flex flex-wrap items-center gap-2.5">
            <!-- Buscador -->
            <div class="relative min-w-[180px] flex-1 sm:flex-none">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input
                type="text"
                id="search-input"
                placeholder="Buscar por guía o nombre..."
                class="w-full text-xs bg-white border border-slate-200 rounded-xl pl-8 pr-3 py-2 text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
              />
            </div>

            <!-- Filtro por Ciudad -->
            <select
              id="filter-ciudad"
              aria-label="Filtrar por ciudad"
              class="text-xs bg-white border border-slate-200 rounded-xl px-3 py-2 text-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all cursor-pointer"
            >
              <option value="ALL">Todas las Ciudades</option>
            </select>

            <!-- Filtro por Empresa -->
            <select
              id="filter-empresa"
              aria-label="Filtrar por empresa"
              class="text-xs bg-white border border-slate-200 rounded-xl px-3 py-2 text-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all cursor-pointer font-medium"
            >
              <option value="ALL">Todas las Empresas</option>
              <option value="Troop">Troop</option>
              <option value="Crazy cargo">Crazy cargo</option>
              <option value="Cargo King">Cargo King</option>
              <option value="JJ">JJ</option>
              <option value="Greymar">Greymar</option>
              <option value="Ajbp">Ajbp</option>
              <option value="Global jats">Global jats</option>
              <option value="Su descarga">Su descarga</option>
              <option value="Rima cargo">Rima cargo</option>
              <option value="Dina cargo">Dina cargo</option>
              <option value="Send logístics">Send logístics</option>
              <option value="Alas cargo">Alas cargo</option>
              <option value="Aexpress">Aexpress</option>
              <option value="Priority">Priority</option>
              <option value="Alpi">Alpi</option>
              <option value="Venexcargo">Venexcargo</option>
              <option value="DBL">DBL</option>
              <option value="2BC">2BC</option>
            </select>

            <!-- Filtro por Estado -->
            <select
              id="filter-estado"
