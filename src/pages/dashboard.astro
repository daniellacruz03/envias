    <!-- ========================================== -->
    <!-- 4. LÓGICA DEL CLIENTE (SINCRONIZADA CON DB)-->
    <!-- ========================================== -->
    <script>
      import { downloadListinPdf, downloadAllZonesListinesPdf } from '../lib/listinPdf';

      interface Driver {
        id: number;
        nombre: string;
        telefono: string;
        rol: string;
      }

      interface GuiaRow {
        id_guia: string;
        destinatario: string;
        telefono_principal: string;
        telefono_secundario?: string | null;
        ciudad_destino: string;
        piezas: number;
        pies_cubicos?: number | string | null;
        direccion_referencia?: string | null;
        hora_disponible?: string | null;
        empresa?: string | null;
        comprobante_url?: string | null;
        comprobante_base64?: string | null;
        recibido_por?: string | null;
        orden_ruta?: number | null;
        ruta_origen?: string | null;
        ruta_destino?: string | null;
        estado: 'Por contactar' | 'Contactado' | 'En ruta' | 'Entregado' | 'No entregado';
        gps_latitud?: number | null;
        gps_longitud?: number | null;
        gps_confirmado: boolean;
        chofer_asignado_id?: number | null;
        created_at: string;
        lote_despacho?: string | null;
        archivada?: boolean;
        ruta_archivada_id?: number | null;
        chofer_nombre?: string | null;
        chofer_telefono?: string | null;
      }

      // Estado en cliente sincronizado con PostgreSQL
      let shipments: GuiaRow[] = [];
      let drivers: Driver[] = [];

      // Helper: devuelve el src correcto para mostrar comprobantes.
      // Prioriza base64 (persiste en Railway), con fallback a la URL del archivo.
      function getComprobanteImgSrc(guia: GuiaRow, idx: number = 0): string {
        const b64Raw = guia.comprobante_base64;
        if (b64Raw) {
          if (typeof b64Raw === 'string' && b64Raw.trim().startsWith('[')) {
            try {
              const arr = JSON.parse(b64Raw);
              if (Array.isArray(arr) && arr[idx]) return arr[idx];
              if (Array.isArray(arr) && arr[0]) return arr[0];
            } catch {}
          }
          if (typeof b64Raw === 'string' && b64Raw.startsWith('data:')) return b64Raw;
        }
        // Fallback: URL de archivo (handler /uploads/[...path] intenta leer de DB)
        const urls = (guia.comprobante_url || '').split(',').map(s => s.trim()).filter(Boolean);
        return urls[idx] || urls[0] || '';
      }

