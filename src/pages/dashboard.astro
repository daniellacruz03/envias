                </svg>
              </div>
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <h3 class="text-base font-extrabold text-slate-900">Envíos Agrupados por Ciudad</h3>
                  <span class="text-xs font-black px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">
                    ${totalCiudades} ${totalCiudades === 1 ? 'Ciudad' : 'Ciudades'} &bull; ${totalGuias} ${totalGuias === 1 ? 'Guía' : 'Guías'}
                  </span>
                  <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
                    ${totalPiezas} ${totalPiezas === 1 ? 'Pieza' : 'Piezas'}
                  </span>
                </div>
                <p class="text-xs text-slate-500 font-medium mt-0.5">
                  Resumen de distribución de guías por cada destino. Haz clic en una ciudad para ubicar sus envíos.
                </p>
              </div>
            </div>

            <!-- Chips de acceso rápido y conteo de guías por ciudad -->
            <div class="flex items-center gap-1.5 flex-wrap">
              ${cityNames.map(cityName => {
                const count = cityMap[cityName].length;
                const theme = getCityColorTheme(cityName);
                const cityKey = encodeURIComponent(cityName);
                return `
                  <button
                    type="button"
                    onclick="document.getElementById('city-card-${cityKey}')?.scrollIntoView({ behavior: 'smooth', block: 'start' })"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold ${theme.badgeBg} hover:opacity-90 active:scale-95 transition-all cursor-pointer shadow-2xs"
                    title="Ver ${cityName} (${count} ${count === 1 ? 'guía' : 'guías'})"
                  >
                    <span>${cityName}:</span>
                    <span class="px-1.5 py-0.2 rounded-md bg-white/90 text-slate-900 font-black text-[11px] border border-slate-200/60">${count} ${count === 1 ? 'guía' : 'guías'}</span>
                  </button>
                `;
              }).join('')}
            </div>
          </div>
        `;

        // 2. Tarjetas de cada ciudad
        const cardsHtml = cityNames.map(cityName => {
          const cityGuias = cityMap[cityName];
          const theme = getCityColorTheme(cityName);
          const totalPieces = cityGuias.reduce((acc, curr) => acc + (curr.piezas || 1), 0);
          const totalVol = cityGuias.reduce((acc, curr) => acc + (Number(curr.pies_cubicos) || 0), 0);
          const gpsCount = cityGuias.filter(g => g.gps_confirmado).length;
          const uniqueClientsCount = new Set(cityGuias.map(g => (g.destinatario || '') + (g.ciudad_destino || ''))).size;
          
          const porContactarCount = cityGuias.filter(g => g.estado === 'Por contactar').length;
          const contactadoCount = cityGuias.filter(g => g.estado === 'Contactado').length;
          const enRutaCount = cityGuias.filter(g => g.estado === 'En ruta').length;
          const entregadoCount = cityGuias.filter(g => g.estado === 'Entregado').length;

          // Chofer común
          const driverIds = Array.from(new Set(cityGuias.map(g => g.chofer_asignado_id).filter(Boolean)));
          let commonDriverLabel = 'Sin Asignar';
          let commonDriverId: number | null = null;
          if (driverIds.length === 1) {
            const drv = drivers.find(d => d.id === driverIds[0]);
            if (drv) {
              commonDriverLabel = drv.nombre;
              commonDriverId = drv.id;
            }
          } else if (driverIds.length > 1) {
            commonDriverLabel = 'Varios Choferes';
          }

          const cityKey = encodeURIComponent(cityName);
          const isExpanded = expandedCities[cityName] !== false; // Abierto por defecto

          const driverOptions = `
            <option value="">Seleccionar Chofer para toda la ciudad...</option>
            ${drivers.map(driver => `
