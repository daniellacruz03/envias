                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    </button>

                    <button
                      type="button"
                      onclick="window.sendWhatsApp('${g.id_guia}')"
                      class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs flex items-center gap-1 shadow-xs transition-colors cursor-pointer"
                      title="Contactar al cliente por WhatsApp"
                    >
                      <span>WhatsApp</span>
                    </button>
                  </div>

                </div>

              </div>

            </div>
          `;
        }).join('');
      }

      (window as any).flyMapToCoords = (lat: number, lon: number, zoom: number = 12, label?: string) => {
        if (!clientLocationsMap) initClientLocationsMap();
        if (clientLocationsMap) {
          clientLocationsMap.flyTo([lat, lon], zoom, { duration: 1.2 });
          if (label) showToast(`Centrando mapa en ${label}`, 'info');
        }
      };

      (window as any).fitMapToAllPins = () => {
        renderClientLocationsMap();
      };

      (window as any).flyToClientMarker = (id_guia: string) => {
        const marker = clientMarkersMap[id_guia];
        if (marker && clientLocationsMap) {
          const latLng = marker.getLatLng();
          clientLocationsMap.flyTo(latLng, 15, { duration: 1.0 });
          marker.openPopup();
          const mapEl = document.getElementById('clientes-main-map');
          mapEl?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          showToast(`Ubicación de guía #${id_guia} no encontrada en mapa`, 'info');
        }
      };

      const assigningCities = new Set<string>();

      // Asignar Chofer a toda la ciudad
      (window as any).assignDriverToCity = async (cityName: string) => {
        if (assigningCities.has(cityName)) return;

        const cityKey = encodeURIComponent(cityName);
        const driverSelect = document.getElementById(`bulk-driver-${cityKey}`) as HTMLSelectElement;
        if (!driverSelect) return;

        const driverIdStr = (driverSelect.value || '').trim();
        if (!driverIdStr) {
          showToast(`Seleccione un chofer de la lista antes de presionar "Asignar a todas" para ${cityName}`, 'warning');
          driverSelect.focus();
          return;
        }

        const isUnassign = driverIdStr === 'unassign' || driverIdStr === 'none';
        const chofer_id = isUnassign ? null : parseInt(driverIdStr, 10);
        const driverObj = !isUnassign ? drivers.find(d => d.id === chofer_id) : null;
        const driverName = driverObj ? driverObj.nombre : 'Sin Asignar';

        assigningCities.add(cityName);

        try {
          const res = await fetch('/api/guias/lote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'bulk_assign',
              ciudad_destino: cityName,
              chofer_id: chofer_id,
              cambiar_estado: chofer_id ? 'En ruta' : undefined // Al asignar chofer masivo pasa a 'En ruta'
            })
          });

          const json = await res.json();

          if (res.ok && json.success) {
            // Actualizar estado local
            shipments.forEach(s => {
              if (s.ciudad_destino.trim().toLowerCase() === cityName.trim().toLowerCase()) {
                s.chofer_asignado_id = chofer_id;
                s.chofer_nombre = driverObj ? driverObj.nombre : null;
                if (chofer_id && s.estado !== 'Entregado') {
                  s.estado = 'En ruta';
                }
              }
            });

            renderViews();
            showToast(
              chofer_id
                ? `Se asignaron ${json.count || 'las'} guías de ${cityName} a ${driverName} (En ruta)`
                : `Se removió la asignación de chofer para las guías de ${cityName}`,
              'success'
            );
          } else {
            showToast(json.message || 'Error al asignar chofer en lote', 'error');
          }
        } catch (err) {
          console.error('Error al asignar por lote:', err);
          showToast('Error de red al procesar asignación por lote', 'error');
        } finally {
          assigningCities.delete(cityName);
        }
      };

      // Eventos del Formulario y Filtros
      let eventsAttached = false;
      let isSubmitting = false;

      function attachEvents() {
        if (eventsAttached) return;
        eventsAttached = true;

        // Switcher de Modos de Vista (8 Tabs Unificadas)
        function updateTabStyles() {
          btnViewTable.classList.remove('tab-btn-active', 'text-slate-600');
          btnViewCities.classList.remove('tab-btn-active', 'text-slate-600');
          btnViewDrivers.classList.remove('tab-btn-active', 'text-slate-600');
          btnViewMapa?.classList.remove('tab-btn-active', 'text-slate-600');
          btnViewDirectorio?.classList.remove('tab-btn-active', 'text-slate-600');
          btnViewEscaneos?.classList.remove('tab-btn-active', 'text-slate-600');
          btnViewListin?.classList.remove('tab-btn-active', 'text-slate-600');
          btnViewHistorial?.classList.remove('tab-btn-active', 'text-slate-600');
          
          viewContainerTable.classList.add('hidden');
          viewContainerCities.classList.add('hidden');
          viewContainerDrivers.classList.add('hidden');
          viewContainerMapa?.classList.add('hidden');
          viewContainerDirectorio?.classList.add('hidden');
          viewContainerEscaneos?.classList.add('hidden');
          viewContainerListin?.classList.add('hidden');
          viewContainerHistorial?.classList.add('hidden');

