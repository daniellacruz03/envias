                                title="Cambiar estado para todas las guías de este cliente"
                              >
                                <option value="Por contactar" ${commonStatus === 'Por contactar' ? 'selected' : ''}>Por contactar</option>
                                <option value="Contactado" ${commonStatus === 'Contactado' ? 'selected' : ''}>Contactado</option>
                                <option value="En ruta" ${commonStatus === 'En ruta' ? 'selected' : ''}>En ruta</option>
                                <option value="Entregado" ${commonStatus === 'Entregado' ? 'selected' : ''}>Entregado</option>
                                <option value="No entregado" ${commonStatus === 'No entregado' ? 'selected' : ''}>No entregado</option>
