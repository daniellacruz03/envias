              <!-- Chips de zonas disponibles -->
              <div id="planner-zone-chips" class="flex flex-wrap gap-1.5 max-h-28 overflow-y-auto custom-scrollbar rounded-xl bg-white border border-slate-200 p-2.5">
                <span class="text-[11px] text-slate-400 font-medium italic">Abre el planificador para ver las zonas disponibles...</span>
              </div>
              <!-- Zonas seleccionadas (resumen) -->
              <div id="planner-selected-zones-display" class="hidden flex flex-wrap items-center gap-1.5">
