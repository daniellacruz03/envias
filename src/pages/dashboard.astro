      editGuiaForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id_guia = editIdGuiaInput.value.trim().toUpperCase();
        if (!id_guia) return;

        const origHtml = editGuiaSaveBtn.innerHTML;
        editGuiaSaveBtn.disabled = true;
        editGuiaSaveBtn.innerHTML = `
          <svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          <span>Guardando...</span>
        `;

        const choferVal = editChofer.value ? parseInt(editChofer.value, 10) : null;
        const latVal = editGpsLat.value ? parseFloat(editGpsLat.value) : null;
        const lonVal = editGpsLon.value ? parseFloat(editGpsLon.value) : null;
        const loteVal = editLote ? editLote.value.trim().toUpperCase() || null : null;
        const fechaVal = editFecha ? editFecha.value.trim() : null;

        const payload: Record<string, any> = {
          destinatario: editDestinatario.value.trim(),
          telefono_principal: editTelPrincipal.value.trim(),
          telefono_secundario: editTelSecundario.value.trim() || null,
          ciudad_destino: editCiudad.value.trim(),
          piezas: parseInt(editPiezas.value, 10) || 1,
          pies_cubicos: editPiesCubicos && editPiesCubicos.value ? parseFloat(editPiesCubicos.value) : null,
          empresa: editEmpresa.value.trim() || null,
          estado: editEstado.value,
          chofer_asignado_id: choferVal,
          hora_disponible: editHora.value.trim() || null,
          direccion_referencia: editDireccion.value.trim() || null,
          gps_latitud: latVal,
          gps_longitud: lonVal,
          gps_confirmado: editGpsConfirmado.checked,
          lote_despacho: loteVal,
          created_at: fechaVal ? new Date(fechaVal + 'T12:00:00Z').toISOString() : undefined
        };

        try {
          const res = await fetch(`/api/guias/${encodeURIComponent(id_guia)}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          const json = await res.json();
          if (res.ok && json.success) {
            const idx = shipments.findIndex(s => s.id_guia === id_guia);
            if (idx !== -1) {
              const choferObj = drivers.find(d => d.id === choferVal);
              shipments[idx] = {
                ...shipments[idx],
                ...payload,
                created_at: payload.created_at || shipments[idx].created_at,
                chofer_nombre: choferObj ? choferObj.nombre : null,
                chofer_telefono: choferObj ? choferObj.telefono : null
              };
            }

