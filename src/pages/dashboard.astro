      form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (isSubmitting) return;

          const guiaInput = document.getElementById('input-guia') as HTMLInputElement;
          const destInput = document.getElementById('input-destinatario') as HTMLInputElement;
          const telInput = document.getElementById('input-telefono') as HTMLInputElement;
          const tel2Input = document.getElementById('input-telefono-2') as HTMLInputElement;
          const ciudadInput = document.getElementById('input-ciudad') as HTMLInputElement;
          const piezasInput = document.getElementById('input-piezas') as HTMLInputElement;
          const piesCubicosInput = document.getElementById('input-pies-cubicos') as HTMLInputElement;
          const empresaInput = document.getElementById('input-empresa') as HTMLSelectElement;
          const dirInput = document.getElementById('input-direccion') as HTMLInputElement;
          const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

          const id_guia = guiaInput.value.trim().toUpperCase();
          const loteInput = document.getElementById('input-lote') as HTMLInputElement;
          const fechaRegistroInput = document.getElementById('input-fecha-registro') as HTMLInputElement;

          // Bloqueo de envío múltiple
          isSubmitting = true;
          submitBtn.disabled = true;
          const originalBtnContent = submitBtn.innerHTML;
          submitBtn.innerHTML = `
            <svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>Guardando en BD...</span>
          `;

          // Payload para PostgreSQL con Lote Activo automático
          const loteVal = (loteInput && loteInput.value.trim().toUpperCase()) || activeCargaLote || undefined;
          const fechaVal = (fechaRegistroInput && fechaRegistroInput.value.trim()) || activeCargaFecha || undefined;

          const payload = {
            id_guia,
            destinatario: destInput.value.trim(),
            telefono_principal: telInput.value.trim(),
            telefono_secundario: tel2Input.value.trim() || undefined,
            ciudad_destino: ciudadInput.value.trim(),
            piezas: parseInt(piezasInput.value, 10) || 1,
            pies_cubicos: piesCubicosInput && piesCubicosInput.value.trim() ? parseFloat(piesCubicosInput.value.trim()) : undefined,
            empresa: empresaInput ? empresaInput.value.trim() || undefined : undefined,
            direccion_referencia: dirInput.value.trim() || undefined,
            lote_despacho: loteVal,
            created_at: fechaVal
          };

          try {
            const res = await fetch('/api/guias', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            const json = await res.json();

            if (res.ok && json.success) {
              // Agregar al estado local
              shipments.unshift(json.data);

              form.reset();
              piezasInput.value = '1';
              if (piesCubicosInput) piesCubicosInput.value = '';
              if (empresaInput) empresaInput.value = '';
              if (loteInput) loteInput.value = activeCargaLote || '';
              if (fechaRegistroInput) fechaRegistroInput.value = activeCargaFecha || '';
              guiaInput.focus();

              populateCityFilter();
              updateLoteControls();
              updateActiveLoteUI();
              renderViews();
              loadFrequentClients();
              (window as any).clearFrequentClientSelection();
              showToast(`Guía #${id_guia} guardada en lote ${loteVal || 'actual'}`, 'success');
            } else {
              showToast(json.message || 'Error al guardar la guía', 'error');
            }
          } catch (err: any) {
            console.error('Error al registrar guía:', err);
            showToast('Error de conexión con el servidor', 'error');
          } finally {
            isSubmitting = false;
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnContent;
          }
        });

        searchInput.addEventListener('input', renderViews);
        filterCiudad.addEventListener('change', renderViews);
        filterEmpresa?.addEventListener('change', renderViews);
        filterEstado.addEventListener('change', renderViews);
        filterListin?.addEventListener('change', renderViews);

        // Inicializar UI de Lote Activo
        updateActiveLoteUI();
      }

      // Métodos globales para interactividad en tabla (window)
      (window as any).updateShipmentStatus = async (id_guia: string, newStatus: GuiaRow['estado']) => {
        try {
          const res = await fetch(`/api/guias/${encodeURIComponent(id_guia)}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ estado: newStatus })
          });

          const json = await res.json();
          if (res.ok && json.success) {
            const item = shipments.find(s => s.id_guia === id_guia);
            if (item) {
              item.estado = newStatus;
              renderViews();
              showToast(`Estado de guía #${id_guia} actualizado a: ${newStatus}`, 'info');
            }
          } else {
            showToast(json.message || 'Error al actualizar el estado', 'error');
          }
        } catch (err) {
          showToast('Error de red al actualizar estado', 'error');
        }
      };

      (window as any).updateShipmentDriver = async (id_guia: string, driverIdStr: string) => {
        try {
          const chofer_id = driverIdStr ? parseInt(driverIdStr, 10) : null;
          const res = await fetch(`/api/guias/${encodeURIComponent(id_guia)}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              chofer_asignado_id: chofer_id,
              estado: chofer_id ? 'En ruta' : undefined // si se le asigna chofer individual, pasa a En ruta
            })
          });

          const json = await res.json();
          if (res.ok && json.success) {
            const item = shipments.find(s => s.id_guia === id_guia);
            if (item) {
              item.chofer_asignado_id = chofer_id;
              const assignedDriver = drivers.find(d => d.id === chofer_id);
              item.chofer_nombre = assignedDriver ? assignedDriver.nombre : null;
              if (chofer_id && item.estado !== 'Entregado') {
                item.estado = 'En ruta';
              }
              renderViews();
              showToast(`Chofer asignado para #${id_guia}: ${assignedDriver ? assignedDriver.nombre : 'Sin Asignar'}`, 'info');
            }
          } else {
            showToast(json.message || 'Error al asignar chofer', 'error');
          }
        } catch (err) {
          showToast('Error de red al asignar chofer', 'error');
        }
      };

      (window as any).deleteShipment = async (id_guia: string) => {
        if (!confirm(`¿Estás seguro de eliminar la guía #${id_guia} de PostgreSQL?`)) return;

        try {
          const res = await fetch(`/api/guias/${encodeURIComponent(id_guia)}`, {
            method: 'DELETE'
          });

          const json = await res.json();
          if (res.ok && json.success) {
            shipments = shipments.filter(s => s.id_guia !== id_guia);
            populateCityFilter();
            renderViews();
            showToast(`Guía #${id_guia} eliminada de la base de datos`, 'info');
          } else {
            showToast(json.message || 'Error al eliminar la guía', 'error');
          }
        } catch (err) {
          showToast('Error de red al eliminar la guía', 'error');
        }
      };

      // Formatear nombres a Title Case
      function toTitleCase(str: string): string {
        if (!str) return '';
        return str
          .toLowerCase()
          .split(' ')
          .map(word => word.charAt(0).toUpperCase() + word.slice(1))
          .join(' ');
      }

      // Acción de WhatsApp con plantilla oficial y cambio automático a "Contactado"
      (window as any).sendWhatsApp = async (id_guia: string) => {
        const item = shipments.find(s => s.id_guia === id_guia);
        if (!item) return;

        const phoneFormatted = formatPhoneForWhatsApp(item.telefono_principal);
        const host = window.location.origin;
        const customerUrl = `${host}/confirmar?guia=${encodeURIComponent(item.id_guia)}`;
        const customerName = toTitleCase(item.destinatario);
        const city = item.ciudad_destino || 'su localidad';
        const piecesText = (item.piezas || 1) === 1 ? '1 pieza' : `${item.piezas} piezas`;

        const message = 
`*ENVÍAS C.A. | Notificación de Despacho*

Estimado(a) *${customerName}*,

Le informamos que su paquete con *Guía #${item.id_guia}* (${piecesText}) se encuentra en proceso de entrega hacia *${city}*.

Para asegurar una entrega puntual y sin contratiempos, por favor confirme su punto de entrega en nuestro portal oficial:
${customerUrl}

_Envías C.A. • Transporte y Logística Nacional_`;

        const whatsappUrl = `https://wa.me/${phoneFormatted}?text=${encodeURIComponent(message)}`;

        window.open(whatsappUrl, '_blank');
        showToast(`Abriendo WhatsApp para guía #${item.id_guia}...`, 'success');

        // Si estaba "Por contactar", pasar automáticamente a "Contactado"
        if (item.estado === 'Por contactar') {
          await (window as any).updateShipmentStatus(item.id_guia, 'Contactado');
        }
      };

      // Helper para Toasts visuales sin emojis
      function showToast(message: string, type: 'success' | 'info' | 'error' = 'info') {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `px-4 py-3 rounded-2xl shadow-xl text-xs font-semibold flex items-center gap-2.5 border transition-all duration-300 transform translate-y-2 opacity-0 pointer-events-auto ${
          type === 'success' ? 'bg-slate-900 text-white border-slate-800' :
          type === 'error' ? 'bg-rose-600 text-white border-rose-700' :
          'bg-white text-slate-800 border-slate-200 shadow-slate-900/10'
        }`;

        let iconSvg = `
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sky-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        `;
        if (type === 'success') {
          iconSvg = `
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          `;
        }
        if (type === 'error') {
          iconSvg = `
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          `;
        }

        toast.innerHTML = `${iconSvg} <span>${message}</span>`;
        container.appendChild(toast);

        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-2', 'opacity-0');
        });

        setTimeout(() => {
          toast.classList.add('translate-y-2', 'opacity-0');
          setTimeout(() => toast.remove(), 300);
        }, 3500);
      }

