      // Helper: Obtener código de lote normalizado de una guía
      function getGuiaLoteCode(g: GuiaRow): string {
        if (g.lote_despacho && g.lote_despacho.trim()) {
          return g.lote_despacho.trim();
        }
        const info = getGuiaWeekInfo(g);
        return (info.loteCode || 'LOTE-GENERAL').trim();
      }

      // Helper: Obtener universo de guías activas para el planificador
      function getActivePlannerShipments(): GuiaRow[] {
        return shipments.filter(g => g.estado !== 'Entregado');
      }

      // Helper: Filtrar guías según la selección activa de lotes
      function filterShipmentsBySelectedLotes(shipmentList: GuiaRow[]): GuiaRow[] {
        if (selectedLotes.size === 0 || selectedLotes.has('ALL')) {
          return shipmentList;
        }
        return shipmentList.filter(g => {
          const info = getGuiaWeekInfo(g);
          const code = getGuiaLoteCode(g);
          if (selectedLotes.has('CURRENT_WEEK') && info.isCurrentWeek && g.estado !== 'No entregado') return true;
          if (selectedLotes.has('PENDING_PAST') && g.estado === 'No entregado') return true;
          if (selectedLotes.has(code)) return true;
          return false;
        });
      }

