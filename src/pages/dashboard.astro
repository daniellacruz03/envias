          for (let i = 0; i < ROWS_PER_PAGE; i++) {
            const left = leftGuias[i];
            const right = rightGuias[i];

            const leftVol = left && left.pies_cubicos ? Number(left.pies_cubicos).toFixed(2) : (left ? '-' : '');
            const rightVol = right && right.pies_cubicos ? Number(right.pies_cubicos).toFixed(2) : (right ? '-' : '');

            tableRows += `
