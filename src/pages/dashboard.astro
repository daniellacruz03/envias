        activeFinChoferId = driverId;
        const driver = drivers.find(d => d.id === driverId);
        if (!driver) return;

        const driverGuias = shipments.filter(g => g.chofer_asignado_id === driverId);
        const total = driverGuias.length;
        const entregadas = driverGuias.filter(g => g.estado === 'Entregado').length;
        const noEntregadas = driverGuias.filter(g => g.estado === 'No entregado').length;
        const pendientes = driverGuias.filter(g => g.estado !== 'Entregado' && g.estado !== 'No entregado').length;

        if (modalFinChoferNombre) modalFinChoferNombre.textContent = driver.nombre;
        if (modalFinTotalGuias) modalFinTotalGuias.textContent = total.toString();
        if (modalFinEntregadas) modalFinEntregadas.textContent = entregadas.toString();
        if (modalFinNoEntregadas) modalFinNoEntregadas.textContent = noEntregadas.toString();

        if (pendientes > 0) {
          if (modalFinPendientesRow) modalFinPendientesRow.classList.remove('hidden');
          if (modalFinPendientes) modalFinPendientes.textContent = pendientes.toString();
          if (modalFinWarning) modalFinWarning.classList.remove('hidden');
        } else {
          if (modalFinPendientesRow) modalFinPendientesRow.classList.add('hidden');
          if (modalFinWarning) modalFinWarning.classList.add('hidden');
        }

        if (modalFinalizarRutaLogistica) {
          modalFinalizarRutaLogistica.classList.remove('hidden');
          modalFinalizarRutaLogistica.classList.add('flex');
        }
      };

      (window as any).closeFinalizarRutaModal = function() {
        activeFinChoferId = null;
        if (modalFinalizarRutaLogistica) {
          modalFinalizarRutaLogistica.classList.add('hidden');
          modalFinalizarRutaLogistica.classList.remove('flex');
        }
      };

      (window as any).confirmFinalizarRuta = async function() {
        if (!activeFinChoferId) return;
        const btn = btnConfirmFinalizarRutaLogistica;
        const origHtml = btn?.innerHTML || '';
        if (btn) {
          btn.innerHTML = '<span class="opacity-70">Finalizando...</span>';
          btn.disabled = true;
        }

        try {
          const res = await fetch('/api/rutas/finalizar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ chofer_id: activeFinChoferId })
          });
          const data = await res.json();

          if (res.ok && data.success) {
            (window as any).closeFinalizarRutaModal();
            showToast(data.message || 'Ruta finalizada y archivada exitosamente', 'success');
            await silentRefresh();
            await (window as any).loadHistorialData();
            renderViews();
          } else {
            showToast(data.message || 'Error al finalizar la ruta', 'error');
          }
        } catch (err) {
          showToast('Error de conexión al finalizar la ruta', 'error');
        } finally {
          if (btn) {
            btn.innerHTML = origHtml;
            btn.disabled = false;
          }
        }
      };

      // ==========================================
      // SELECTOR DE MAPA GPS (ORIGEN Y DESTINO)
      // ==========================================
      const mapPickerModal = document.getElementById('map-picker-modal') as HTMLElement;
      const mapPickerTitle = document.getElementById('map-picker-title') as HTMLElement;
      const mapPickerCloseBtn = document.getElementById('map-picker-close-btn') as HTMLElement;
      const mapPickerCancelBtn = document.getElementById('map-picker-cancel-btn') as HTMLElement;
      const mapPickerConfirmBtn = document.getElementById('map-picker-confirm-btn') as HTMLElement;
      const btnOpenStartMapPicker = document.getElementById('btn-open-start-map-picker') as HTMLButtonElement;
      const btnOpenEndMapPicker = document.getElementById('btn-open-end-map-picker') as HTMLButtonElement;
      const pickerCoordsText = document.getElementById('picker-coords-text') as HTMLElement;
      const pickerZoneName = document.getElementById('picker-zone-name') as HTMLElement;
      const pickerOlcBadge = document.getElementById('picker-olc-badge') as HTMLElement;
      const pickerOlcInput = document.getElementById('picker-olc-input') as HTMLInputElement;
      const pickerSearchInput = document.getElementById('picker-search-input') as HTMLInputElement;
      const pickerGmapsLink = document.getElementById('picker-gmaps-link') as HTMLAnchorElement;

      let pickerMap: any = null;
      let pickerMarker: any = null;
      let currentPickerMode: 'start' | 'end' = 'start';
      let selectedPickerCoords = [10.0808, -69.3756]; // Default Barquisimeto
      let selectedPickerLabel = 'Sede Principal Barquisimeto';

      function initPickerMap() {
        if (pickerMap || typeof (window as any).L === 'undefined') return;

        const L = (window as any).L;

        pickerMap = L.map('picker-map', {
          zoomControl: true,
          attributionControl: false
        }).setView(selectedPickerCoords, 13);

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '© OpenStreetMap'
        }).addTo(pickerMap);

        const customPinHtml = `
          <div class="relative flex items-center justify-center w-9 h-9 rounded-full bg-slate-900 border-2 border-white shadow-xl text-white text-xs font-black">
            <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
        `;

        const customPinIcon = L.divIcon({
          html: customPinHtml,
          className: 'picker-pin-icon',
          iconSize: [36, 36],
          iconAnchor: [18, 18]
        });

        pickerMarker = L.marker(selectedPickerCoords, {
          draggable: true,
          icon: customPinIcon
        }).addTo(pickerMap);

        pickerMarker.on('dragend', (e: any) => {
          const latlng = e.target.getLatLng();
          updatePickerCoords(latlng.lat, latlng.lng);
        });

        pickerMap.on('click', (e: any) => {
          pickerMarker.setLatLng(e.latlng);
          updatePickerCoords(e.latlng.lat, e.latlng.lng);
        });
      }

      function updatePickerCoords(lat: number, lon: number) {
        selectedPickerCoords = [lat, lon];
        const label = findClosestCity(lat, lon);
        selectedPickerLabel = label;
        const olcCode = encodeOLC(lat, lon, 10);

        if (pickerCoordsText) pickerCoordsText.textContent = `${lat.toFixed(4)}, ${lon.toFixed(4)}`;
        if (pickerOlcBadge) pickerOlcBadge.textContent = olcCode;
        if (pickerZoneName) pickerZoneName.textContent = label;
        if (pickerGmapsLink) {
          pickerGmapsLink.href = `https://www.google.com/maps/search/?api=1&query=${lat.toFixed(6)},${lon.toFixed(6)}`;
        }
      }

      (window as any).flyPickerToCoords = (lat: number, lon: number, label: string) => {
        selectedPickerCoords = [lat, lon];
        selectedPickerLabel = label;
        if (pickerMap) {
          pickerMap.setView([lat, lon], 14);
          if (pickerMarker) pickerMarker.setLatLng([lat, lon]);
        }
        updatePickerCoords(lat, lon);
      };

      (window as any).setOlcExample = (exampleText: string) => {
        if (pickerOlcInput) {
          pickerOlcInput.value = exampleText;
          (window as any).decodeAndApplyOlcInput();
        }
      };

      (window as any).decodeAndApplyOlcInput = () => {
        const raw = pickerOlcInput?.value?.trim();
        if (!raw) {
          showToast('Ingresa o pega coordenadas u OLC', 'info');
          return;
        }

        const parsed = parseUniversalLocation(raw);
        if (parsed) {
          (window as any).flyPickerToCoords(parsed.lat, parsed.lon, parsed.label);
          showToast(`¡Ubicación decodificada: ${parsed.label}!`, 'success');
        } else {
          showToast('No se pudieron decodificar las coordenadas u OLC ingresadas', 'error');
        }
      };

      pickerOlcInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          (window as any).decodeAndApplyOlcInput();
        }
      });

      pickerSearchInput?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value.trim();
        if (!val) return;
        const parsed = parseUniversalLocation(val);
        if (parsed) {
          (window as any).flyPickerToCoords(parsed.lat, parsed.lon, parsed.label);
        }
      });

      function openMapPicker(mode: 'start' | 'end') {
        currentPickerMode = mode;
        if (mapPickerTitle) {
          mapPickerTitle.textContent = mode === 'start' 
            ? 'Marcar Punto de Salida / Origen en el Mapa' 
            : 'Marcar Punto Final / Destino de Cierre en el Mapa';
        }

        const currentValue = mode === 'start' ? plannerStartInput.value.trim() : plannerEndInput.value.trim();
        
        // Intentar parsear el valor actual con el motor universal
        const parsedCurrent = parseUniversalLocation(currentValue);
        let initialCoords = [10.0808, -69.3756]; // Default Barquisimeto
        if (parsedCurrent) {
          initialCoords = [parsedCurrent.lat, parsedCurrent.lon];
        }

        selectedPickerCoords = initialCoords;
        selectedPickerLabel = currentValue || (mode === 'start' ? 'Sede Principal Barquisimeto' : 'Retorno a Sede Principal Barquisimeto');

        if (pickerOlcInput) {
          pickerOlcInput.value = '';
        }

        mapPickerModal?.classList.remove('hidden');
        mapPickerModal?.classList.add('flex');

        setTimeout(() => {
          initPickerMap();
          if (pickerMap) {
            pickerMap.invalidateSize();
            pickerMap.setView(selectedPickerCoords, 13);
            if (pickerMarker) pickerMarker.setLatLng(selectedPickerCoords);
          }
          updatePickerCoords(selectedPickerCoords[0], selectedPickerCoords[1]);
        }, 150);
      }

      (window as any).openMapPicker = openMapPicker;

      btnOpenStartMapPicker?.addEventListener('click', () => openMapPicker('start'));
      btnOpenEndMapPicker?.addEventListener('click', () => openMapPicker('end'));

      function closeMapPicker() {
        mapPickerModal?.classList.add('hidden');
        mapPickerModal?.classList.remove('flex');
      }

      mapPickerCloseBtn?.addEventListener('click', closeMapPicker);
      mapPickerCancelBtn?.addEventListener('click', closeMapPicker);

      mapPickerConfirmBtn?.addEventListener('click', () => {
        if (currentPickerMode === 'start') {
          plannerStartInput.value = selectedPickerLabel;
          onOriginLocationChanged(true);
        } else {
          plannerEndInput.value = selectedPickerLabel;
          onDestinationLocationChanged();
        }
        closeMapPicker();
        showToast(`Ubicación seleccionada en el mapa: ${selectedPickerLabel}`, 'success');
      });

      // =========================================================
      // MÓDULO: ASIGNAR UBICACIÓN GPS POR COORDENADAS (LOGÍSTICA)
      // =========================================================
      const gpsAssignModal = document.getElementById('gps-assign-modal') as HTMLElement;
      const gpsAssignCloseBtn = document.getElementById('gps-assign-close-btn') as HTMLElement;
      const gpsAssignCancelBtn = document.getElementById('gps-assign-cancel-btn') as HTMLElement;
      const gpsAssignSearchInput = document.getElementById('gps-assign-search-input') as HTMLInputElement;
      const btnClearGpsAssignSearch = document.getElementById('btn-clear-gps-assign-search') as HTMLElement;
      const gpsAssignSearchDropdown = document.getElementById('gps-assign-search-dropdown') as HTMLElement;
      const gpsAssignClientCard = document.getElementById('gps-assign-client-card') as HTMLElement;
      const gpsAssignClientBadge = document.getElementById('gps-assign-client-badge') as HTMLElement;
      const gpsAssignClientName = document.getElementById('gps-assign-client-name') as HTMLElement;
      const gpsAssignClientDetails = document.getElementById('gps-assign-client-details') as HTMLElement;
      const gpsAssignCurrentStatus = document.getElementById('gps-assign-current-status') as HTMLElement;
      const gpsAssignCoordsInput = document.getElementById('gps-assign-coords-input') as HTMLInputElement;
      const btnClearGpsAssignCoords = document.getElementById('btn-clear-gps-assign-coords') as HTMLElement;
      const gpsAssignDecodedFeedback = document.getElementById('gps-assign-decoded-feedback') as HTMLElement;
      const gpsAssignDecodedText = document.getElementById('gps-assign-decoded-text') as HTMLElement;
      const gpsAssignDecodedCoords = document.getElementById('gps-assign-decoded-coords') as HTMLElement;
      const gpsAssignGmapsLink = document.getElementById('gps-assign-gmaps-link') as HTMLAnchorElement;
      const gpsAssignReferenceInput = document.getElementById('gps-assign-reference-input') as HTMLInputElement;
      const gpsAssignHoraInput = document.getElementById('gps-assign-hora-input') as HTMLInputElement;
      const gpsAssignPropagateCheckbox = document.getElementById('gps-assign-propagate-checkbox') as HTMLInputElement;
      const gpsAssignSaveBtn = document.getElementById('gps-assign-save-btn') as HTMLButtonElement;

      let gpsAssignSelectedGuia: GuiaRow | null = null;
      let gpsAssignMapInstance: any = null;
      let gpsAssignMarkerInstance: any = null;
      let gpsAssignCurrentCoords: [number, number] = [10.0808, -69.3756];

      function initGpsAssignMap() {
        if (gpsAssignMapInstance || typeof (window as any).L === 'undefined') return;
        const L = (window as any).L;
        const mapContainer = document.getElementById('gps-assign-map');
        if (!mapContainer) return;

        gpsAssignMapInstance = L.map('gps-assign-map', {
          zoomControl: true,
          attributionControl: false
        }).setView(gpsAssignCurrentCoords, 13);

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '© OpenStreetMap'
        }).addTo(gpsAssignMapInstance);

        const pinHtml = `
          <div class="relative flex items-center justify-center w-8 h-8 rounded-full bg-emerald-600 border-2 border-white shadow-xl text-white">
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
        `;

        const pinIcon = L.divIcon({
          html: pinHtml,
          className: 'gps-assign-pin-icon',
          iconSize: [32, 32],
          iconAnchor: [16, 16]
        });

        gpsAssignMarkerInstance = L.marker(gpsAssignCurrentCoords, {
          draggable: true,
          icon: pinIcon
        }).addTo(gpsAssignMapInstance);

        gpsAssignMarkerInstance.on('dragend', (e: any) => {
          const pos = e.target.getLatLng();
          onGpsAssignMarkerMoved(pos.lat, pos.lng);
        });

        gpsAssignMapInstance.on('click', (e: any) => {
          if (gpsAssignMarkerInstance) {
            gpsAssignMarkerInstance.setLatLng(e.latlng);
          }
          onGpsAssignMarkerMoved(e.latlng.lat, e.latlng.lng);
        });
      }

      function onGpsAssignMarkerMoved(lat: number, lon: number) {
        gpsAssignCurrentCoords = [lat, lon];
        if (gpsAssignCoordsInput) {
          gpsAssignCoordsInput.value = `${lat.toFixed(6)}, ${lon.toFixed(6)}`;
          btnClearGpsAssignCoords?.classList.remove('hidden');
        }
        updateGpsAssignDecodedFeedback(lat, lon, findClosestCity(lat, lon));
      }

      function updateGpsAssignDecodedFeedback(lat: number, lon: number, label: string) {
        if (!gpsAssignDecodedFeedback) return;
        gpsAssignDecodedFeedback.className = 'text-xs p-2.5 rounded-xl border bg-emerald-50 border-emerald-200 text-emerald-800 flex items-center justify-between gap-2 shadow-2xs';
        if (gpsAssignDecodedText) {
          gpsAssignDecodedText.innerHTML = `<strong class="font-bold text-emerald-900">Ubicación detectada:</strong> ${label}`;
        }
        if (gpsAssignDecodedCoords) {
          gpsAssignDecodedCoords.textContent = `${lat.toFixed(4)}, ${lon.toFixed(4)}`;
        }
        if (gpsAssignGmapsLink) {
          gpsAssignGmapsLink.href = `https://www.google.com/maps/search/?api=1&query=${lat.toFixed(6)},${lon.toFixed(6)}`;
        }
      }

      function resetGpsAssignDecodedFeedback() {
        if (!gpsAssignDecodedFeedback) return;
        gpsAssignDecodedFeedback.className = 'text-xs p-2.5 rounded-xl border bg-slate-100 border-slate-200 text-slate-600 flex items-center justify-between gap-2';
        if (gpsAssignDecodedText) {
          gpsAssignDecodedText.textContent = 'Ingresa o pega las coordenadas satelitales del cliente';
        }
        if (gpsAssignDecodedCoords) {
          gpsAssignDecodedCoords.textContent = '--';
        }
      }

      (window as any).setGpsAssignCity = (cityName: string, lat: number, lon: number) => {
        gpsAssignCurrentCoords = [lat, lon];
        if (gpsAssignCoordsInput) {
          gpsAssignCoordsInput.value = `${lat.toFixed(6)}, ${lon.toFixed(6)}`;
          btnClearGpsAssignCoords?.classList.remove('hidden');
        }
        if (gpsAssignMapInstance) {
          gpsAssignMapInstance.setView([lat, lon], 14);
          if (gpsAssignMarkerInstance) gpsAssignMarkerInstance.setLatLng([lat, lon]);
        }
        updateGpsAssignDecodedFeedback(lat, lon, cityName);
      };

      (window as any).openGpsAssignModal = function(guiaId?: string) {
        if (!gpsAssignModal) return;

        gpsAssignSearchDropdown?.classList.add('hidden');

        let targetGuia: GuiaRow | undefined;
        if (guiaId) {
          targetGuia = shipments.find(s => s.id_guia === guiaId);
        }

        if (targetGuia) {
          selectGuiaForGpsAssign(targetGuia);
        } else {
          gpsAssignSelectedGuia = null;
          if (gpsAssignSearchInput) gpsAssignSearchInput.value = '';
          btnClearGpsAssignSearch?.classList.add('hidden');
          if (gpsAssignClientCard) gpsAssignClientCard.classList.add('hidden');
          if (gpsAssignCoordsInput) gpsAssignCoordsInput.value = '';
          btnClearGpsAssignCoords?.classList.add('hidden');
          if (gpsAssignReferenceInput) gpsAssignReferenceInput.value = '';
          if (gpsAssignHoraInput) gpsAssignHoraInput.value = '';
          resetGpsAssignDecodedFeedback();
          gpsAssignCurrentCoords = [10.0808, -69.3756]; // Sede Barquisimeto por defecto
          renderGpsAssignDropdown('');
        }

        gpsAssignModal.classList.remove('hidden');
        gpsAssignModal.classList.add('flex');
        document.body.style.overflow = 'hidden';

        setTimeout(() => {
          initGpsAssignMap();
          if (gpsAssignMapInstance) {
            gpsAssignMapInstance.invalidateSize();
            gpsAssignMapInstance.setView(gpsAssignCurrentCoords, 13);
            if (gpsAssignMarkerInstance) gpsAssignMarkerInstance.setLatLng(gpsAssignCurrentCoords);
          }
          if (!targetGuia && gpsAssignSearchInput) {
            gpsAssignSearchInput.focus();
          }
        }, 150);
      };

      function selectGuiaForGpsAssign(guia: GuiaRow) {
        gpsAssignSelectedGuia = guia;
        if (gpsAssignSearchInput) gpsAssignSearchInput.value = `${guia.id_guia} - ${guia.destinatario}`;
        btnClearGpsAssignSearch?.classList.remove('hidden');
        gpsAssignSearchDropdown?.classList.add('hidden');

        // Llenar tarjeta de cliente
        if (gpsAssignClientCard) gpsAssignClientCard.classList.remove('hidden');
        if (gpsAssignClientBadge) gpsAssignClientBadge.textContent = `#${guia.id_guia}`;
        if (gpsAssignClientName) gpsAssignClientName.textContent = guia.destinatario || 'Sin nombre';
        
        const piecesText = (guia.piezas || 1) === 1 ? '1 pieza' : `${guia.piezas} piezas`;
        const volText = guia.pies_cubicos ? ` • ${Number(guia.pies_cubicos).toFixed(2)} ft³` : '';
        const phone = guia.telefono_principal || 'Sin teléfono';
        const city = guia.ciudad_destino || 'Sin ciudad';
        if (gpsAssignClientDetails) {
          gpsAssignClientDetails.textContent = `${city} • Tel: ${phone} • ${piecesText}${volText}`;
        }

        const isGpsOk = Boolean(guia.gps_confirmado && guia.gps_latitud && guia.gps_longitud);
        if (gpsAssignCurrentStatus) {
          gpsAssignCurrentStatus.innerHTML = isGpsOk
            ? `<span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full inline-flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> GPS Listo</span>`
            : `<span class="text-[10px] font-bold text-amber-800 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full inline-flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Pendiente</span>`;
        }

        // Llenar campos
        if (gpsAssignReferenceInput) gpsAssignReferenceInput.value = guia.direccion_referencia || '';
        if (gpsAssignHoraInput) gpsAssignHoraInput.value = guia.hora_disponible || '';

        // Coordenadas iniciales
        let initialLat = 10.0808;
        let initialLon = -69.3756;
        let label = 'Sede Principal Barquisimeto';

        if (guia.gps_latitud && guia.gps_longitud) {
          initialLat = Number(guia.gps_latitud);
          initialLon = Number(guia.gps_longitud);
          label = findClosestCity(initialLat, initialLon);
          if (gpsAssignCoordsInput) {
            gpsAssignCoordsInput.value = `${initialLat.toFixed(6)}, ${initialLon.toFixed(6)}`;
            btnClearGpsAssignCoords?.classList.remove('hidden');
          }
          updateGpsAssignDecodedFeedback(initialLat, initialLon, label);
        } else {
          // Intentar geocodificar la ciudad
          const parsed = parseUniversalLocation(guia.ciudad_destino || '');
          if (parsed) {
            initialLat = parsed.lat;
            initialLon = parsed.lon;
            label = parsed.label;
          }
          if (gpsAssignCoordsInput) {
            gpsAssignCoordsInput.value = '';
            btnClearGpsAssignCoords?.classList.add('hidden');
          }
          resetGpsAssignDecodedFeedback();
        }

        gpsAssignCurrentCoords = [initialLat, initialLon];
        if (gpsAssignMapInstance) {
          gpsAssignMapInstance.setView([initialLat, initialLon], 13);
          if (gpsAssignMarkerInstance) gpsAssignMarkerInstance.setLatLng([initialLat, initialLon]);
        }
      }

      function renderGpsAssignDropdown(query: string) {
        if (!gpsAssignSearchDropdown) return;
        const q = (query || '').toLowerCase().trim();

        const matches = shipments.filter(s => {
          if (!q) return !s.gps_confirmado || !s.gps_latitud;
          return (s.id_guia && s.id_guia.toLowerCase().includes(q)) ||
                 (s.destinatario && s.destinatario.toLowerCase().includes(q)) ||
                 (s.telefono_principal && s.telefono_principal.includes(q)) ||
                 (s.ciudad_destino && s.ciudad_destino.toLowerCase().includes(q));
        }).slice(0, 15);

        if (matches.length === 0) {
          gpsAssignSearchDropdown.innerHTML = `
            <div class="px-3 py-2 text-center text-xs text-slate-400">
              No se encontraron guías que coincidan
            </div>
          `;
          gpsAssignSearchDropdown.classList.remove('hidden');
          return;
        }

        gpsAssignSearchDropdown.innerHTML = matches.map(s => {
          const isPending = !s.gps_confirmado || !s.gps_latitud;
          return `
            <div
              onclick="window.selectGpsAssignGuiaById('${s.id_guia}')"
              class="flex items-center justify-between p-2 rounded-xl hover:bg-slate-100 cursor-pointer transition-colors"
            >
              <div class="min-w-0 pr-2">
                <div class="flex items-center gap-1.5">
                  <span class="font-mono font-bold text-xs text-slate-900">#${s.id_guia}</span>
                  <span class="font-semibold text-xs text-slate-800 truncate">${s.destinatario}</span>
                </div>
                <div class="text-[11px] text-slate-500 flex items-center gap-2 mt-0.5">
                  <span>${s.ciudad_destino || 'Sin ciudad'}</span>
                  <span>•</span>
                  <span class="font-mono">${s.telefono_principal || ''}</span>
                </div>
              </div>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full shrink-0 ${isPending ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'}">
                ${isPending ? 'Pendiente' : 'GPS Listo'}
              </span>
            </div>
          `;
        }).join('');

        gpsAssignSearchDropdown.classList.remove('hidden');
      }

      (window as any).selectGpsAssignGuiaById = (guiaId: string) => {
        const found = shipments.find(s => s.id_guia === guiaId);
        if (found) selectGuiaForGpsAssign(found);
      };

      // Event Listeners del buscador de guías
      gpsAssignSearchInput?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        if (val.trim()) {
          btnClearGpsAssignSearch?.classList.remove('hidden');
        } else {
          btnClearGpsAssignSearch?.classList.add('hidden');
        }
        renderGpsAssignDropdown(val);
      });

      gpsAssignSearchInput?.addEventListener('focus', () => {
        renderGpsAssignDropdown(gpsAssignSearchInput.value);
      });

      btnClearGpsAssignSearch?.addEventListener('click', () => {
        if (gpsAssignSearchInput) gpsAssignSearchInput.value = '';
        btnClearGpsAssignSearch.classList.add('hidden');
        renderGpsAssignDropdown('');
      });

      // Event Listeners del input universal de coordenadas
      gpsAssignCoordsInput?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        if (val.trim()) {
          btnClearGpsAssignCoords?.classList.remove('hidden');
        } else {
          btnClearGpsAssignCoords?.classList.add('hidden');
        }

        const parsed = parseUniversalLocation(val);
        if (parsed) {
          gpsAssignCurrentCoords = [parsed.lat, parsed.lon];
          if (gpsAssignMapInstance) {
            gpsAssignMapInstance.setView([parsed.lat, parsed.lon], 14);
            if (gpsAssignMarkerInstance) gpsAssignMarkerInstance.setLatLng([parsed.lat, parsed.lon]);
          }
          updateGpsAssignDecodedFeedback(parsed.lat, parsed.lon, parsed.label);
        } else {
          resetGpsAssignDecodedFeedback();
        }
      });

      btnClearGpsAssignCoords?.addEventListener('click', () => {
        if (gpsAssignCoordsInput) gpsAssignCoordsInput.value = '';
        btnClearGpsAssignCoords.classList.add('hidden');
        resetGpsAssignDecodedFeedback();
      });

      function closeGpsAssignModal() {
        if (!gpsAssignModal) return;
        gpsAssignModal.classList.add('hidden');
        gpsAssignModal.classList.remove('flex');
        document.body.style.overflow = '';
      }

      gpsAssignCloseBtn?.addEventListener('click', closeGpsAssignModal);
      gpsAssignCancelBtn?.addEventListener('click', closeGpsAssignModal);
      gpsAssignModal?.addEventListener('click', (e) => {
        if (e.target === gpsAssignModal) closeGpsAssignModal();
      });

      // Cerrar dropdown al hacer clic fuera
      document.addEventListener('click', (e) => {
        if (gpsAssignSearchDropdown && !gpsAssignSearchDropdown.contains(e.target as Node) && e.target !== gpsAssignSearchInput) {
          gpsAssignSearchDropdown.classList.add('hidden');
        }
      });

      // Guardar Coordenadas GPS en PostgreSQL (/api/confirmar)
      (window as any).saveGpsAssignModal = async function() {
        if (!gpsAssignSelectedGuia) {
          showToast('Debes seleccionar primero una guía o cliente', 'error');
          gpsAssignSearchInput?.focus();
          return;
        }

        const coordsRaw = gpsAssignCoordsInput ? gpsAssignCoordsInput.value.trim() : '';
        let lat: number | null = null;
        let lon: number | null = null;

        if (coordsRaw) {
          const parsed = parseUniversalLocation(coordsRaw);
          if (parsed) {
            lat = parsed.lat;
            lon = parsed.lon;
          }
        }

        // Si no se parseó del input pero el usuario movió el mapa
        if (lat === null && gpsAssignCurrentCoords) {
          lat = gpsAssignCurrentCoords[0];
          lon = gpsAssignCurrentCoords[1];
        }

        if (lat === null || lon === null || isNaN(lat) || isNaN(lon)) {
          showToast('Ingresa coordenadas válidas o selecciona el punto en el mapa', 'error');
          gpsAssignCoordsInput?.focus();
          return;
        }

        const refText = gpsAssignReferenceInput ? gpsAssignReferenceInput.value.trim() : '';
        const horaText = gpsAssignHoraInput ? gpsAssignHoraInput.value.trim() : '';

        const origHtml = gpsAssignSaveBtn?.innerHTML || '';
        if (gpsAssignSaveBtn) {
          gpsAssignSaveBtn.disabled = true;
          gpsAssignSaveBtn.innerHTML = `
            <svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span>Guardando...</span>
          `;
        }

        try {
          const payload = {
            id_guia: gpsAssignSelectedGuia.id_guia,
            latitud: lat,
            longitud: lon,
            direccion_referencia: refText || undefined,
            hora_disponible: horaText || undefined
          };

          const res = await fetch('/api/confirmar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          const data = await res.json();

          if (res.ok && data.success) {
            showToast(`¡Ubicación GPS guardada para ${gpsAssignSelectedGuia.destinatario} (Guía #${gpsAssignSelectedGuia.id_guia})!`, 'success');
            closeGpsAssignModal();
            await silentRefresh();
            renderViews();
          } else {
            showToast(data.message || 'Error al guardar la ubicación GPS', 'error');
          }
        } catch (err) {
          console.error('Error guardando GPS:', err);
          showToast('Error de red al guardar la ubicación GPS', 'error');
        } finally {
          if (gpsAssignSaveBtn) {
            gpsAssignSaveBtn.disabled = false;
            gpsAssignSaveBtn.innerHTML = origHtml;
          }
        }
      };

      // =========================================================
      // MÓDULO 6: CREAR LISTÍN DE CARGA / DESPACHO & EXPORTACIÓN PDF
      // =========================================================
      let listinFilterType: 'routes' | 'zones' = 'routes';
      let listinActiveRoute: string = 'ALL';
      let listinRoutesOrder: string[] = [];
      let listinRouteGuiasOrder: Record<string, string[]> = {};
      let listinExcludedRoutes: Set<string> = new Set();
      let listinCollapsedRoutes: Set<string> = new Set();

      let listinSelectedZones: Set<string> = new Set();
      let listinActiveZone: string = 'ALL';
      let listinCitiesOrder: string[] = [];
      let listinCityGuiasOrder: Record<string, string[]> = {};
      let listinFlatGuiasOrder: string[] = [];
      let listinExcludedGuiaIds: Set<string> = new Set();
      let listinExcludedCities: Set<string> = new Set();
      let listinCollapsedCities: Set<string> = new Set();
      let listinViewSubMode: 'routes' | 'zones' | 'flat' = 'routes';
      let listinSearchQuery: string = '';

      // Drag and drop tracking
      let draggedGuiaId: string | null = null;
      let draggedCityName: string | null = null;
      let draggedRouteKey: string | null = null;
      let draggedZoneName: string | null = null;

      // Pre-cargar fecha actual en el input de fecha
      if (listinFechaInput && !listinFechaInput.value) {
        listinFechaInput.value = new Date().toISOString().split('T')[0];
      }

      interface ListinRouteGroup {
        key: string;
        driverId: number | null;
        driverName: string;
        driverPlaca: string;
        cities: string[];
        guias: GuiaRow[];
        totalPiezas: number;
        totalVolumen: number;
      }

      function populateListinDriverSelect() {
        if (!listinDriverSelect) return;
        const currentVal = listinDriverSelect.value || 'ALL';
        listinDriverSelect.innerHTML = '<option value="ALL">Todos los Choferes / Flota Central</option>';
        drivers.forEach(d => {
          const opt = document.createElement('option');
          opt.value = d.id.toString();
          opt.textContent = `${d.nombre} (ID: ${d.id})`;
          listinDriverSelect.appendChild(opt);
        });
        if (Array.from(listinDriverSelect.options).some(o => o.value === currentVal)) {
          listinDriverSelect.value = currentVal;
        }
      }

      function getListinSourceShipments(): GuiaRow[] {
        const driverFilter = listinDriverSelect ? listinDriverSelect.value : 'ALL';
        const listinLoteSelect = document.getElementById('listin-lote-select') as HTMLSelectElement;
        const loteFilter = listinLoteSelect ? listinLoteSelect.value : 'ALL';

        return shipments.filter(g => {
          // Filtro por Chofer
          if (driverFilter !== 'ALL') {
            if (String(g.chofer_asignado_id) !== driverFilter) return false;
          }

          // Filtro por Lote de Despacho / Relación
          if (loteFilter === 'CURRENT_WEEK') {
            const info = getGuiaWeekInfo(g);
            if (!info.isCurrentWeek || g.estado === 'No entregado') return false;
          } else if (loteFilter === 'PENDING_PAST') {
            if (g.estado !== 'No entregado') return false;
          } else if (loteFilter !== 'ALL') {
            const info = getGuiaWeekInfo(g);
            const gCode = g.lote_despacho || info.loteCode;
            if (gCode !== loteFilter && g.lote_despacho !== loteFilter) return false;
          }

          return true;
        });
      }

      function getListinRoutes(srcShipments: GuiaRow[]): ListinRouteGroup[] {
        const routeGroupsMap = new Map<string, ListinRouteGroup>();

        srcShipments.forEach(g => {
          const dId = g.chofer_asignado_id != null ? Number(g.chofer_asignado_id) : null;
          const driverObj = dId != null ? drivers.find(d => d.id === dId) : null;
          const key = dId != null ? `driver-${dId}` : 'unassigned';
          const driverName = driverObj ? driverObj.nombre : (dId != null ? `Chofer #${dId}` : 'Sin Asignar / Almacén');
          const driverPlaca = (driverObj as any)?.placa || 'NO ASIGNADA';

          if (!routeGroupsMap.has(key)) {
            routeGroupsMap.set(key, {
              key,
              driverId: dId,
              driverName,
              driverPlaca,
              cities: [],
              guias: [],
              totalPiezas: 0,
              totalVolumen: 0
            });
          }

          const group = routeGroupsMap.get(key)!;
          group.guias.push(g);
          group.totalPiezas += (g.piezas || 1);
          group.totalVolumen += (Number(g.pies_cubicos) || 0);
          const city = (g.ciudad_destino || 'Sin Ciudad').trim();
          if (city && !group.cities.includes(city)) {
            group.cities.push(city);
          }
        });

        const groups = Array.from(routeGroupsMap.values());

        // Ordenar rutas: choferes asignados primero, sin asignar al final
        groups.sort((a, b) => {
          if (a.driverId !== null && b.driverId === null) return -1;
          if (a.driverId === null && b.driverId !== null) return 1;
          return a.driverName.localeCompare(b.driverName);
        });

        // Asegurar que las guías de cada ruta respeten el orden secuencial
        groups.forEach(group => {
          const existingOrder = listinRouteGuiasOrder[group.key] || [];
          if (existingOrder.length > 0) {
            const mapG = new Map(group.guias.map(g => [g.id_guia, g]));
            const sorted: GuiaRow[] = [];
            existingOrder.forEach(id => {
              const g = mapG.get(id);
              if (g) sorted.push(g);
            });
            group.guias.forEach(g => {
              if (!existingOrder.includes(g.id_guia)) sorted.push(g);
            });
            group.guias = sorted;
          } else {
            group.guias.sort((a, b) => {
              const ordA = (a.orden_ruta && a.orden_ruta > 0) ? a.orden_ruta : 9999;
              const ordB = (b.orden_ruta && b.orden_ruta > 0) ? b.orden_ruta : 9999;
              if (ordA !== ordB) return ordA - ordB;
              return a.id_guia.localeCompare(b.id_guia, undefined, { numeric: true });
            });
          }
          listinRouteGuiasOrder[group.key] = group.guias.map(g => g.id_guia);
        });

        return groups;
      }

      function syncListinCitiesOrder(availableCities: string[]) {
        const kept = listinCitiesOrder.filter(c => availableCities.includes(c));
        availableCities.forEach(c => {
          if (!kept.includes(c)) kept.push(c);
        });
        listinCitiesOrder = kept;
      }

      function syncListinState(srcShipments: GuiaRow[]) {
        // 1. Sincronizar Rutas
        const routes = getListinRoutes(srcShipments);
        const availableRouteKeys = routes.map(r => r.key);
        const keptRoutes = listinRoutesOrder.filter(k => availableRouteKeys.includes(k));
        availableRouteKeys.forEach(k => {
          if (!keptRoutes.includes(k)) keptRoutes.push(k);
        });
        listinRoutesOrder = keptRoutes;

        if (listinActiveRoute !== 'ALL' && !availableRouteKeys.includes(listinActiveRoute)) {
          listinActiveRoute = 'ALL';
        }

        // 2. Sincronizar Ciudades
        const uniqueCities = Array.from(new Set(srcShipments.map(g => (g.ciudad_destino || 'Sin Ciudad').trim()))).filter(Boolean);
        if (listinCitiesOrder.length === 0 || !listinCitiesOrder.some(c => uniqueCities.includes(c))) {
          uniqueCities.sort((a, b) => a.localeCompare(b));
        }
        syncListinCitiesOrder(uniqueCities);

        // Limpiar zonas seleccionadas que ya no existen
        Array.from(listinSelectedZones).forEach(z => {
          if (!listinCitiesOrder.includes(z)) listinSelectedZones.delete(z);
        });

        // Sincronizar orden de guías por cada ciudad
        uniqueCities.forEach(cityName => {
          const cityShipments = srcShipments.filter(g => (g.ciudad_destino || 'Sin Ciudad').trim() === cityName);
          const existingOrder = listinCityGuiasOrder[cityName] || [];
          const kept = existingOrder.filter(id => cityShipments.some(g => g.id_guia === id));
          cityShipments.forEach(g => {
            if (!kept.includes(g.id_guia)) kept.push(g.id_guia);
          });
          listinCityGuiasOrder[cityName] = kept;
        });

        // Sincronizar orden plano de guías
        const allSrcIds = srcShipments.map(g => g.id_guia);
        if (listinFlatGuiasOrder.length === 0) {
          const flat: string[] = [];
          if (listinViewSubMode === 'routes') {
            listinRoutesOrder.forEach(rKey => {
              const rGuias = listinRouteGuiasOrder[rKey] || [];
              flat.push(...rGuias);
            });
          } else {
            listinCitiesOrder.forEach(cityName => {
              const gIds = listinCityGuiasOrder[cityName] || [];
              flat.push(...gIds);
            });
          }
          listinFlatGuiasOrder = flat;
        } else {
          const kept = listinFlatGuiasOrder.filter(id => allSrcIds.includes(id));
          allSrcIds.forEach(id => {
            if (!kept.includes(id)) kept.push(id);
          });
          listinFlatGuiasOrder = kept;
        }
      }

      function syncFlatFromRoutesOrZones() {
        const flat: string[] = [];
        if (listinViewSubMode === 'routes') {
          listinRoutesOrder.forEach(rKey => {
            const gIds = listinRouteGuiasOrder[rKey] || [];
            flat.push(...gIds);
          });
        } else {
          listinCitiesOrder.forEach(cityName => {
            const gIds = listinCityGuiasOrder[cityName] || [];
            flat.push(...gIds);
          });
        }
        listinFlatGuiasOrder = flat;
      }

      function getOrderedActiveGuias(srcShipments: GuiaRow[], specificZone?: string): GuiaRow[] {
        const mapById = new Map(srcShipments.map(g => [g.id_guia, g]));
        const ordered: GuiaRow[] = [];

        // Si se seleccionó una ruta específica
        if (listinActiveRoute !== 'ALL') {
          const rGuias = listinRouteGuiasOrder[listinActiveRoute] || [];
          rGuias.forEach(id => {
            if (listinExcludedGuiaIds.has(id)) return;
            const g = mapById.get(id);
            if (g) ordered.push(g);
          });
          return ordered;
        }

        // Si se especificó una zona concreta
        if (specificZone !== undefined) {
          if (specificZone !== 'ALL') {
            const guiaIds = listinCityGuiasOrder[specificZone] || [];
            guiaIds.forEach(id => {
              if (listinExcludedGuiaIds.has(id)) return;
              const g = mapById.get(id);
              if (g) ordered.push(g);
            });
            return ordered;
          }
        } else if (listinSelectedZones.size > 0) {
          if (listinViewSubMode === 'flat') {
            listinFlatGuiasOrder.forEach(id => {
              if (listinExcludedGuiaIds.has(id)) return;
              const g = mapById.get(id);
              if (g) {
                const city = (g.ciudad_destino || 'Sin Ciudad').trim();
                if (listinSelectedZones.has(city) && !listinExcludedCities.has(city)) {
                  ordered.push(g);
                }
              }
            });
          } else {
            listinCitiesOrder.forEach(cityName => {
              if (!listinSelectedZones.has(cityName)) return;
              if (listinExcludedCities.has(cityName)) return;
              const guiaIds = listinCityGuiasOrder[cityName] || [];
              guiaIds.forEach(id => {
                if (listinExcludedGuiaIds.has(id)) return;
                const g = mapById.get(id);
                if (g) ordered.push(g);
              });
            });
          }
          return ordered;
        }

        if (listinViewSubMode === 'routes') {
          listinRoutesOrder.forEach(rKey => {
            if (listinExcludedRoutes.has(rKey)) return;
            const guiaIds = listinRouteGuiasOrder[rKey] || [];
            guiaIds.forEach(id => {
              if (listinExcludedGuiaIds.has(id)) return;
              const g = mapById.get(id);
              if (g) ordered.push(g);
            });
          });
        } else if (listinViewSubMode === 'flat') {
          listinFlatGuiasOrder.forEach(id => {
            if (listinExcludedGuiaIds.has(id)) return;
            const g = mapById.get(id);
            if (g) {
              const city = (g.ciudad_destino || 'Sin Ciudad').trim();
              if (!listinExcludedCities.has(city)) {
                ordered.push(g);
              }
            }
          });
        } else {
          listinCitiesOrder.forEach(cityName => {
            if (listinExcludedCities.has(cityName)) return;
            const guiaIds = listinCityGuiasOrder[cityName] || [];
            guiaIds.forEach(id => {
              if (listinExcludedGuiaIds.has(id)) return;
              const g = mapById.get(id);
              if (g) ordered.push(g);
            });
          });
        }

        return ordered;
      }

