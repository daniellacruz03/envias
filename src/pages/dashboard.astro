      }

      editGuiaCloseBtn?.addEventListener('click', closeEditGuiaModal);
      editGuiaCancelBtn?.addEventListener('click', closeEditGuiaModal);
      editGuiaModal?.addEventListener('click', (e) => {
        if (e.target === editGuiaModal) closeEditGuiaModal();
      });

      (window as any).openEditGuiaModal = (id_guia: string) => {
        const item = shipments.find(s => s.id_guia === id_guia);
        if (!item || !editGuiaModal) return;

        // Cargar choferes en el select de edición
        if (editChofer) {
          editChofer.innerHTML = `
            <option value="">Sin Asignar</option>
            ${drivers.map(d => `
              <option value="${d.id}" ${item.chofer_asignado_id === d.id ? 'selected' : ''}>
                ${d.nombre}
              </option>
            `).join('')}
          `;
        }

        if (editGuiaBadge) editGuiaBadge.textContent = `#${item.id_guia}`;
        if (editIdGuiaInput) editIdGuiaInput.value = item.id_guia;
        if (editDestinatario) editDestinatario.value = item.destinatario || '';
        if (editTelPrincipal) editTelPrincipal.value = item.telefono_principal || '';
        if (editTelSecundario) editTelSecundario.value = item.telefono_secundario || '';
        if (editCiudad) editCiudad.value = item.ciudad_destino || '';
        if (editPiezas) editPiezas.value = (item.piezas || 1).toString();
        if (editEmpresa) editEmpresa.value = item.empresa || '';
        if (editEstado) editEstado.value = item.estado || 'Por contactar';
        if (editHora) editHora.value = item.hora_disponible || '';
        if (editDireccion) editDireccion.value = item.direccion_referencia || '';
        if (editGpsLat) editGpsLat.value = item.gps_latitud ? item.gps_latitud.toString() : '';
        if (editGpsLon) editGpsLon.value = item.gps_longitud ? item.gps_longitud.toString() : '';
        if (editGpsConfirmado) editGpsConfirmado.checked = item.gps_confirmado === true;

        editGuiaModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
