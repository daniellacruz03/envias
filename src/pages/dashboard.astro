    <!-- ========================================== -->
    <!-- 4. LÓGICA DEL CLIENTE (SINCRONIZADA CON DB)-->
    <!-- ========================================== -->
    <script>
      interface Driver {
        id: number;
        nombre: string;
        telefono: string;
        rol: string;
      }

      interface GuiaRow {
        id_guia: string;
        destinatario: string;
        telefono_principal: string;
        telefono_secundario?: string | null;
        ciudad_destino: string;
        piezas: number;
        direccion_referencia?: string | null;
        hora_disponible?: string | null;
        empresa?: string | null;
        comprobante_url?: string | null;
        recibido_por?: string | null;
        orden_ruta?: number | null;
        ruta_origen?: string | null;
        ruta_destino?: string | null;
        estado: 'Por contactar' | 'Contactado' | 'En ruta' | 'Entregado' | 'No entregado';
        gps_latitud?: number | null;
        gps_longitud?: number | null;
        gps_confirmado: boolean;
        chofer_asignado_id?: number | null;
        created_at: string;
        chofer_nombre?: string | null;
        chofer_telefono?: string | null;
      }

      // Estado en cliente sincronizado con PostgreSQL
      let shipments: GuiaRow[] = [];
      let drivers: Driver[] = [];
      let isLoading = true;
      let currentViewMode: 'table' | 'cities' | 'drivers' | 'escaneos' = 'table';
      let expandedCities: Record<string, boolean> = {};
      let escaneosData: any[] = [];
      let drawerFotosFlat: any[] = []; // lista plana de fotos para navegar
      let drawerCurrentIndex = 0;
      let activeEscaneoId: number | null = null;

      // ==========================================
      // MOTOR GEOESPACIAL Y COORDENADAS DE VENEZUELA (HOISTED GLOBAL)
      // ==========================================
      function normalizeText(str: string): string {
        return (str || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .trim();
      }

      function calculateDistance(lat1: number, lon1: number, lat2: number, lon2: number): number {
        const R = 6371; // Radio de la Tierra en km
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = 
          Math.sin(dLat / 2) * Math.sin(dLat / 2) +
          Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
          Math.sin(dLon / 2) * Math.sin(dLon / 2);
        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        return R * c;
      }

      const VENEZUELA_COORDS_MAP: Record<string, [number, number]> = {
        'barquisimeto': [10.0808, -69.3756],
        'sede principal barquisimeto': [10.0808, -69.3756],
        'sede barquisimeto': [10.0808, -69.3756],
        'principal barquisimeto': [10.0808, -69.3756],
        'retorno barquisimeto': [10.0808, -69.3756],
        'retorno a sede principal barquisimeto': [10.0808, -69.3756],
        'caracas': [10.4934, -66.9299],
        'sede caracas': [10.4934, -66.9299],
        'retorno caracas': [10.4934, -66.9299],
        'retorno a sede caracas': [10.4934, -66.9299],
        'merida': [8.5738, -71.1851],
        'sede merida': [8.5738, -71.1851],
        'retorno merida': [8.5738, -71.1851],
        'retorno a sede merida': [8.5738, -71.1851],
        'timotes': [8.9833, -70.7333],
        'apartaderos': [8.8000, -70.8500],
        'paramo': [8.8000, -70.8500],
        'el paramo': [8.8000, -70.8500],
        'mucuchies': [8.7500, -70.9167],
        'tabay': [8.6350, -71.0720],
        'el vigia': [8.6250, -71.6500],
        'cabudare': [10.0333, -69.2667],
        'carora': [10.1755, -70.0827],
        'valencia': [10.1620, -68.0077],
        'maracaibo': [10.6544, -71.6385],
        'maracay': [10.2469, -67.5958],
        'barinas': [8.6226, -70.2075],
        'san cristobal': [7.7669, -72.2250],
        'valera': [9.3178, -70.6036],
        'trujillo': [9.3664, -70.4356],
        'acarigua': [9.5545, -69.2006],
        'guanare': [9.0439, -69.7421],
        'san felipe': [10.3397, -68.7425],
        'coro': [11.4045, -69.6734],
        'punto fijo': [11.6956, -70.1996],
        'puerto la cruz': [10.2138, -64.6320],
        'maturin': [9.7469, -63.1832],
        'cumana': [10.4536, -64.1750]
      };

      const OLC_ALPHABET = '23456789CFGHJMPQRVWX';

      function encodeOLC(lat: number, lng: number, codeLength: number = 10): string {
        let adjustedLat = Math.min(Math.max(lat, -90), 90) + 90;
        let adjustedLng = Math.min(Math.max(lng, -180), 180) + 180;
        let code = '';
        let latVal = 20;
        let lngVal = 20;

        for (let i = 0; i < codeLength / 2; i++) {
          const latDigit = Math.floor(adjustedLat / latVal);
          const lngDigit = Math.floor(adjustedLng / lngVal);
          adjustedLat -= latDigit * latVal;
          adjustedLng -= lngDigit * lngVal;
          latVal /= 20;
          lngVal /= 20;
          code += OLC_ALPHABET.charAt(latDigit) + OLC_ALPHABET.charAt(lngDigit);
          if (i === 3) code += '+';
        }
        return code;
      }

      function decodeFullOLC(code: string): { lat: number, lng: number } | null {
        const clean = code.toUpperCase().replace('+', '').replace(/\s+/g, '');
        if (clean.length < 8) return null;
        let lat = -90;
        let lng = -180;
        let latRes = 20;
        let lngRes = 20;

        for (let i = 0; i < Math.min(clean.length, 10); i += 2) {
          const latDigit = OLC_ALPHABET.indexOf(clean[i]);
          const lngDigit = OLC_ALPHABET.indexOf(clean[i + 1]);
          if (latDigit === -1 || lngDigit === -1) return null;
          latRes /= 20;
          lngRes /= 20;
          lat += latDigit * latRes * 20;
          lng += lngDigit * lngRes * 20;
        }
        lat += latRes / 2;
        lng += lngRes / 2;
        return { lat, lng };
      }

      function decodeShortOLC(shortCode: string, refLat: number = 10.0, refLng: number = -69.0): { lat: number, lng: number } | null {
        const clean = shortCode.toUpperCase().replace('+', '').replace(/\s+/g, '');
        let bestCoords: { lat: number, lng: number } | null = null;
        let minDiff = Infinity;

        for (let c1 of '78') {
          for (let c2 of '67') {
            for (let c3 of OLC_ALPHABET) {
              for (let c4 of OLC_ALPHABET) {
                const full = `${c1}${c2}${c3}${c4}${clean}`;
                const decoded = decodeFullOLC(full);
                if (decoded) {
                  const diff = Math.abs(decoded.lat - refLat) + Math.abs(decoded.lng - refLng);
                  if (diff < minDiff) {
                    minDiff = diff;
                    bestCoords = decoded;
                  }
                }
              }
            }
          }
        }
        return bestCoords;
      }

      function findClosestCity(lat: number, lon: number): string {
        let closestName = 'Ubicación Personalizada';
        let minDistance = Infinity;

        for (const [name, coords] of Object.entries(VENEZUELA_COORDS_MAP)) {
          const dist = calculateDistance(lat, lon, coords[0], coords[1]);
          if (dist < minDistance) {
            minDistance = dist;
            closestName = name.charAt(0).toUpperCase() + name.slice(1);
          }
        }

        if (minDistance < 25) {
          return `${closestName} (${lat.toFixed(4)}, ${lon.toFixed(4)})`;
        }
        return `GPS (${lat.toFixed(4)}, ${lon.toFixed(4)})`;
      }

      function parseUniversalLocation(input: string): { lat: number, lon: number, label: string } | null {
        if (!input) return null;
        const trimmed = input.trim();
        const normalized = normalizeText(trimmed);

        // 1. Coordenadas directas: "10.0808, -69.3756"
        const coordMatch = trimmed.match(/(-?\d{1,2}\.\d{3,})[,\s;]+(-?\d{2,3}\.\d{3,})/);
        if (coordMatch) {
          const lat = parseFloat(coordMatch[1]);
          const lon = parseFloat(coordMatch[2]);
          return { lat, lon, label: findClosestCity(lat, lon) };
        }

        // 2. Enlace de Google Maps con @ o /place/
        const urlCoordMatch = trimmed.match(/[@/](-?\d{1,2}\.\d{3,}),(-?\d{2,3}\.\d{3,})/);
        if (urlCoordMatch) {
          const lat = parseFloat(urlCoordMatch[1]);
          const lon = parseFloat(urlCoordMatch[2]);
          return { lat, lon, label: findClosestCity(lat, lon) };
        }

        // 3. Código OLC Completo
        const fullOlcMatch = trimmed.match(/([23456789CFGHJMPQRVWX]{8}\+[23456789CFGHJMPQRVWX]{2,3})/i);
        if (fullOlcMatch) {
          const decoded = decodeFullOLC(fullOlcMatch[1]);
          if (decoded) {
            return { lat: decoded.lat, lon: decoded.lng, label: findClosestCity(decoded.lat, decoded.lng) };
          }
        }

        // 4. Código OLC Corto
        const shortOlcMatch = trimmed.match(/([23456789CFGHJMPQRVWX]{4,7}\+[23456789CFGHJMPQRVWX]{2,3})/i);
        if (shortOlcMatch) {
          const shortCode = shortOlcMatch[1];
          let refLat = 10.0808;
          let refLon = -69.3756;

          for (const [key, coords] of Object.entries(VENEZUELA_COORDS_MAP)) {
            if (normalized.includes(key)) {
              refLat = coords[0];
              refLon = coords[1];
              break;
            }
          }

          const decoded = decodeShortOLC(shortCode, refLat, refLon);
          if (decoded) {
            return { lat: decoded.lat, lon: decoded.lng, label: findClosestCity(decoded.lat, decoded.lng) };
          }
        }

        // 5. Sedes oficiales reconocidas de forma prioritaria
        if (normalized.includes('barquisimeto') || normalized.includes('lara') || normalized.includes('principal')) {
          return { lat: 10.0808, lon: -69.3756, label: 'Sede Principal Barquisimeto' };
        }
        if (normalized.includes('caracas') || normalized.includes('capital')) {
          return { lat: 10.4934, lon: -66.9299, label: 'Sede Caracas' };
        }
        if (normalized.includes('merida')) {
          return { lat: 8.5738, lon: -71.1851, label: 'Sede Mérida' };
        }

        // 6. Otras ciudades en diccionario
        for (const [key, coords] of Object.entries(VENEZUELA_COORDS_MAP)) {
          if (key.includes(normalized) || normalized.includes(key)) {
            return { lat: coords[0], lon: coords[1], label: key.charAt(0).toUpperCase() + key.slice(1) };
          }
        }

        return null;
      }

      function getStartCoordinates(): { lat: number, lon: number, label: string } {
        const val = plannerStartInput?.value?.trim() || '';
        const parsed = parseUniversalLocation(val);
        if (parsed) return parsed;
        return { lat: 10.0808, lon: -69.3756, label: 'Sede Principal Barquisimeto' };
      }

      function getEndCoordinates(): { lat: number, lon: number, label: string } {
        const val = plannerEndInput?.value?.trim() || '';
        const norm = normalizeText(val);
        if (norm.includes('ultima parada') || norm.includes('sin retorno') || norm.includes('en destino')) {
          const gpsStops = plannedStops.filter(g => g.gps_confirmado && g.gps_latitud && g.gps_longitud);
          if (gpsStops.length > 0) {
            const last = gpsStops[gpsStops.length - 1];
            return { lat: Number(last.gps_latitud), lon: Number(last.gps_longitud), label: 'Última Parada de Entrega' };
          }
        }
        const parsed = parseUniversalLocation(val);
        if (parsed) return parsed;
        return { lat: 10.0808, lon: -69.3756, label: 'Retorno a Sede Principal Barquisimeto' };
      }

      // Elementos del DOM
      const form = document.getElementById('new-shipment-form') as HTMLFormElement;
      const tableBody = document.getElementById('shipments-table-body') as HTMLElement;
      const viewContainerTable = document.getElementById('view-container-table') as HTMLElement;
      const viewContainerCities = document.getElementById('view-container-cities') as HTMLElement;
      const viewContainerDrivers = document.getElementById('view-container-drivers') as HTMLElement;
      const viewContainerEscaneos = document.getElementById('view-container-escaneos') as HTMLElement;
      const btnViewTable = document.getElementById('btn-view-table') as HTMLButtonElement;
      const btnViewCities = document.getElementById('btn-view-cities') as HTMLButtonElement;
      const btnViewDrivers = document.getElementById('btn-view-drivers') as HTMLButtonElement;
      const btnViewEscaneos = document.getElementById('btn-view-escaneos') as HTMLButtonElement;
      const citiesCountPill = document.getElementById('cities-count-pill') as HTMLElement;
      const driversCountPill = document.getElementById('drivers-count-pill') as HTMLElement;
      const escaneosCountPill = document.getElementById('escaneos-count-pill') as HTMLElement;

      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      const filterCiudad = document.getElementById('filter-ciudad') as HTMLSelectElement;
      const filterEmpresa = document.getElementById('filter-empresa') as HTMLSelectElement;
      const filterEstado = document.getElementById('filter-estado') as HTMLSelectElement;
      const filteredCountBadge = document.getElementById('filtered-count-badge') as HTMLElement;
      const emptyState = document.getElementById('empty-state') as HTMLElement;

      // KPIs
      const kpiTotal = document.getElementById('kpi-total') as HTMLElement;
      const kpiContactar = document.getElementById('kpi-contactar') as HTMLElement;
      const kpiRuta = document.getElementById('kpi-ruta') as HTMLElement;
      const kpiGps = document.getElementById('kpi-gps') as HTMLElement;

      // Carga Inicial desde PostgreSQL y sincronización en vivo
      async function init() {
        attachEvents();
        renderLoading();
        await loadData();

        // Polling automático cada 3.5 segundos en segundo plano para Live Sync
        setInterval(() => {
          silentRefresh();
        }, 3500);
      }

      function renderLoading() {
        tableBody.innerHTML = `
          <tr>
            <td colspan="7" class="py-12 text-center text-slate-400">
              <div class="flex items-center justify-center gap-2.5">
                <svg class="animate-spin w-4 h-4 text-slate-700" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span class="text-xs font-medium">Conectando con PostgreSQL en Railway...</span>
              </div>
            </td>
          </tr>
        `;
      }

      async function loadData() {
        try {
          const [guiasRes, choferesRes, escaneosRes] = await Promise.all([
            fetch('/api/guias'),
            fetch('/api/choferes'),
            fetch('/api/escaneos')
          ]);

          const guiasJson = await guiasRes.json();
          const choferesJson = await choferesRes.json();
          try {
            const escaneosJson = await escaneosRes.json();
            const totalPend = escaneosJson.totalPendientes || 0;
            if (escaneosCountPill) {
              if (totalPend > 0) {
                escaneosCountPill.textContent = totalPend.toString();
                escaneosCountPill.classList.remove('hidden');
                escaneosCountPill.className = 'text-[10px] bg-amber-400 text-white px-1.5 py-0.2 rounded-full font-bold';
              } else {
                escaneosCountPill.classList.add('hidden');
              }
            }
          } catch(e) {}

          if (guiasJson.success) {
            shipments = guiasJson.data || [];
          } else {
            showToast('Error al cargar guías desde la base de datos', 'error');
          }

          if (choferesJson.success) {
            drivers = choferesJson.data || [];
          }

          isLoading = false;
          populateCityFilter();
          renderViews();
        } catch (err: any) {
          isLoading = false;
          console.error('Error al conectar con la API:', err);
          showToast('Error de red al consultar la base de datos', 'error');
          tableBody.innerHTML = `
            <tr>
              <td colspan="7" class="py-8 text-center text-rose-500 text-xs">
                No se pudo conectar con la base de datos. Verifica tu conexión a internet o la variable DATABASE_URL.
              </td>
            </tr>
          `;
        }
      }

      // Sincronización automática silenciosa en tiempo real
      async function silentRefresh() {
        if (isSubmitting || isLoading) return;
        try {
          // 1. Sincronizar guías
          const res = await fetch('/api/guias');
          const json = await res.json();
          if (res.ok && json.success && Array.isArray(json.data)) {
            const newShipments: GuiaRow[] = json.data;
            
            // Detectar cambios en guías, estados o confirmaciones de GPS
            let hasChanges = false;
            if (newShipments.length !== shipments.length) {
              hasChanges = true;
            } else {
              for (let i = 0; i < newShipments.length; i++) {
                const current = shipments.find(s => s.id_guia === newShipments[i].id_guia);
                if (!current) {
                  hasChanges = true;
                  break;
                }
                // Si el cliente acaba de confirmar su ubicación GPS
                if (!current.gps_confirmado && newShipments[i].gps_confirmado) {
                  showToast(`Ubicación confirmada por el cliente para la guía #${newShipments[i].id_guia}`, 'success');
                  hasChanges = true;
                  break;
                }
                if (
                  current.estado !== newShipments[i].estado ||
                  current.chofer_asignado_id !== newShipments[i].chofer_asignado_id ||
                  current.direccion_referencia !== newShipments[i].direccion_referencia ||
                  current.hora_disponible !== newShipments[i].hora_disponible ||
                  current.empresa !== newShipments[i].empresa
                ) {
                  hasChanges = true;
                  break;
                }
              }
            }

            if (hasChanges) {
              shipments = newShipments;
              populateCityFilter();
              renderViews();
            }
          }

          // 2. Sincronizar badge de escaneos y lista en tiempo real si está activa la vista
          try {
            const escRes = await fetch('/api/escaneos');
            if (escRes.ok) {
              const escData = await escRes.json();
              const totalPend = escData.totalPendientes || 0;
              const newLotes = escData.data || [];

              // Actualizar badge numérico en la pestaña
              if (escaneosCountPill) {
                if (totalPend > 0) {
                  escaneosCountPill.textContent = totalPend.toString();
                  escaneosCountPill.classList.remove('hidden');
                  escaneosCountPill.className = 'text-[10px] bg-amber-400 text-white px-1.5 py-0.2 rounded-full font-bold';
                } else {
                  escaneosCountPill.classList.add('hidden');
                }
              }

              // Si el usuario está viendo la pestaña de escaneos y el drawer NO está abierto
              const escaneoDrawerEl = document.getElementById('escaneo-drawer');
              const isDrawerClosed = !escaneoDrawerEl || escaneoDrawerEl.classList.contains('hidden');

              if (currentViewMode === 'escaneos' && isDrawerClosed) {
                const prevSummary = JSON.stringify(escaneosData.map((l: any) => ({ id: l.lote_id, total: l.total, pend: l.pendientes, proc: l.procesadas })));
                const newSummary = JSON.stringify(newLotes.map((l: any) => ({ id: l.lote_id, total: l.total, pend: l.pendientes, proc: l.procesadas })));

                if (prevSummary !== newSummary || escaneosData.length === 0) {
                  escaneosData = newLotes;
                  const listEl = document.getElementById('escaneos-list');
                  const emptyEl = document.getElementById('escaneos-empty');
                  const loadingEl = document.getElementById('escaneos-loading');
                  loadingEl?.classList.add('hidden');

                  if (escaneosData.length === 0) {
                    listEl?.classList.add('hidden');
                    emptyEl?.classList.remove('hidden');
                  } else {
                    emptyEl?.classList.add('hidden');
                    if (listEl) {
                      listEl.innerHTML = escaneosData.map((lote: any) => renderEscaneoLote(lote)).join('');
                      listEl.classList.remove('hidden');
                    }
                    drawerFotosFlat = escaneosData.flatMap((lote: any) =>
                      (lote.fotos || []).filter((f: any) => f.estado === 'pendiente').map((f: any) => ({
                        ...f,
                        chofer_nombre: lote.chofer_nombre,
                        lote_id: lote.lote_id
                      }))
                    );
                  }
                }
              }
            }
          } catch(e) {}

        } catch (err) {
          // Error silencioso de red sin interrumpir al usuario
        }
      }

      // Llenar filtro de ciudades
      function populateCityFilter() {
        const currentVal = filterCiudad.value;
        const uniqueCities = Array.from(new Set(shipments.map(s => s.ciudad_destino).filter(Boolean))).sort();
        
        filterCiudad.innerHTML = '<option value="ALL">Todas las Ciudades</option>';
        uniqueCities.forEach(city => {
          const opt = document.createElement('option');
          opt.value = city;
          opt.textContent = city;
          filterCiudad.appendChild(opt);
        });

        if (uniqueCities.includes(currentVal)) {
          filterCiudad.value = currentVal;
        }

        if (citiesCountPill) {
          citiesCountPill.textContent = uniqueCities.length.toString();
        }
      }

      // Actualizar contadores KPI
      function updateKPIs() {
        if (!kpiTotal) return;
        kpiTotal.textContent = shipments.length.toString();
        kpiContactar.textContent = shipments.filter(s => s.estado === 'Por contactar').length.toString();
        kpiRuta.textContent = shipments.filter(s => s.estado === 'En ruta').length.toString();
        kpiGps.textContent = shipments.filter(s => s.gps_confirmado === true).length.toString();
      }

      // Filtrar guías según búsqueda y selects
      function getFilteredShipments(): GuiaRow[] {
        const query = searchInput.value.toLowerCase().trim();
        const cityFilter = filterCiudad.value;
        const statusFilter = filterEstado.value;
        const empresaFilter = filterEmpresa ? filterEmpresa.value : 'ALL';

        return shipments.filter(item => {
          const matchQuery = (item.id_guia && item.id_guia.toLowerCase().includes(query)) || 
                             (item.destinatario && item.destinatario.toLowerCase().includes(query)) ||
                             (item.telefono_principal && item.telefono_principal.includes(query)) ||
                             (item.telefono_secundario && item.telefono_secundario.includes(query)) ||
                             (item.ciudad_destino && item.ciudad_destino.toLowerCase().includes(query)) ||
                             (item.empresa && item.empresa.toLowerCase().includes(query));
          const matchCity = cityFilter === 'ALL' || item.ciudad_destino === cityFilter;
          const matchStatus = statusFilter === 'ALL' || item.estado === statusFilter;
          const matchEmpresa = empresaFilter === 'ALL' || (item.empresa && item.empresa.trim().toLowerCase() === empresaFilter.trim().toLowerCase());

          return matchQuery && matchCity && matchStatus && matchEmpresa;
        });
      }

      // Render Principal de Vistas
      function renderViews() {
        if (isLoading) return;

        const filtered = getFilteredShipments();
        filteredCountBadge.textContent = `${filtered.length} de ${shipments.length} guías`;
        updateKPIs();

        if (filtered.length === 0) {
          tableBody.innerHTML = '';
          viewContainerCities.innerHTML = '';
          if (viewContainerDrivers) viewContainerDrivers.innerHTML = '';
          emptyState.classList.remove('hidden');
          return;
        }

        emptyState.classList.add('hidden');

        if (currentViewMode === 'table') {
          renderTable(filtered);
        } else if (currentViewMode === 'cities') {
          renderCitiesGrouped(filtered);
        } else if (currentViewMode === 'drivers') {
          renderDriversView(filtered);
        }
      }

