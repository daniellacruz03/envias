                <!-- Badge de Lote / Semana Operativa -->
                ${weekInfo.isPastPending ? `
                  <button type="button" onclick="window.openGestionLotesModal('${item.lote_despacho || weekInfo.loteCode}')" class="inline-flex items-center gap-1 text-[10px] font-bold px-1.5 py-0.5 rounded-md bg-amber-100 text-amber-900 border border-amber-300 shadow-2xs hover:bg-amber-200 transition-all cursor-pointer" title="Guía rezagada (${item.lote_despacho || weekInfo.loteCode}) - Clic para gestionar lote y fecha">
                    <svg class="w-3 h-3 text-amber-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    <span>Rezagada • ${item.lote_despacho || weekInfo.label}</span>
                  </button>
                ` : `
                  <button type="button" onclick="window.openGestionLotesModal('${item.lote_despacho || weekInfo.loteCode}')" class="inline-flex items-center gap-1 text-[10px] font-mono font-semibold px-1.5 py-0.5 rounded-md bg-slate-100 text-slate-600 border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700 transition-all cursor-pointer" title="Lote: ${item.lote_despacho || weekInfo.loteCode} - Clic para gestionar lote o editar fecha">
                    <span>${item.lote_despacho || weekInfo.loteCode}</span>
                  </button>
