            activeLoteBadge.className = 'text-[10px] font-mono font-bold bg-blue-500 text-white border border-blue-400 px-2.5 py-0.5 rounded-full shadow-2xs';
          } else if (currentLoteFilter === 'PENDING_PAST') {
