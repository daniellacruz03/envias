                  >
                    <img src="${foto.foto_url}" class="w-full h-full object-cover" loading="lazy" />
                    <div class="absolute bottom-0 inset-x-0 py-0.5 text-center text-[8px] font-bold ${foto.estado === 'pendiente' ? 'bg-amber-400/80 text-white' : foto.estado === 'procesado' ? 'bg-emerald-500/80 text-white' : 'bg-rose-400/80 text-white'}">
                      ${foto.estado === 'pendiente' ? 'REV.' : foto.estado === 'procesado' ? 'OK' : 'NO'}
                    </div>
                    <button
                      type="button"
                      onclick="event.stopPropagation(); window.deleteIndividualEscaneo(${foto.id});"
                      class="absolute top-1 right-1 z-10 w-5 h-5 rounded-md bg-slate-900/80 hover:bg-rose-600 text-white flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 shadow-sm cursor-pointer"
                      title="Eliminar esta foto"
                    >
                      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                `).join('')}
              </div>
              ${fotosPendientes.length > 0 ? `
                <div class="px-4 pb-4">
                  <button
                    onclick="window.openEscaneoDrawer(${fotosPendientes[0].id})"
                    class="w-full py-2.5 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-bold flex items-center justify-center gap-2 transition-all active:scale-[0.98] cursor-pointer"
                  >
                    <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                    Revisar ${fotosPendientes.length} guia${fotosPendientes.length !== 1 ? 's' : ''} pendiente${fotosPendientes.length !== 1 ? 's' : ''}
                  </button>
                </div>
              ` : ''}
            </div>
          `;
        }

        // Modal de revisión de escaneos
        const escaneoDrawer = document.getElementById('escaneo-drawer') as HTMLElement;
        const drawerOverlay = document.getElementById('escaneo-drawer-overlay') as HTMLElement;
        const drawerFoto = document.getElementById('drawer-foto') as HTMLImageElement;
        const drawerZoomViewport = document.getElementById('drawer-zoom-viewport') as HTMLElement;
        const btnZoomIn = document.getElementById('btn-zoom-in') as HTMLButtonElement;
        const btnZoomOut = document.getElementById('btn-zoom-out') as HTMLButtonElement;
        const btnZoomRotate = document.getElementById('btn-zoom-rotate') as HTMLButtonElement;
        const btnZoomReset = document.getElementById('btn-zoom-reset') as HTMLButtonElement;
        const zoomLevelText = document.getElementById('zoom-level-text') as HTMLElement;
        const drawerLoteBadge = document.getElementById('drawer-lote-badge') as HTMLElement;

        const drawerIdGuia = document.getElementById('drawer-id-guia') as HTMLInputElement;
        const drawerPiezas = document.getElementById('drawer-piezas') as HTMLInputElement;
        const drawerDestinatario = document.getElementById('drawer-destinatario') as HTMLInputElement;
        const drawerTelefono = document.getElementById('drawer-telefono') as HTMLInputElement;
        const drawerCiudad = document.getElementById('drawer-ciudad') as HTMLInputElement;
        const drawerEmpresa = document.getElementById('drawer-empresa') as HTMLSelectElement;
        const drawerDireccion = document.getElementById('drawer-direccion') as HTMLInputElement;
        const drawerError = document.getElementById('drawer-error') as HTMLElement;
        const drawerCloseBtn = document.getElementById('drawer-close-btn') as HTMLButtonElement;
        const drawerApproveBtn = document.getElementById('drawer-approve-btn') as HTMLButtonElement;
        const drawerRejectBtn = document.getElementById('drawer-reject-btn') as HTMLButtonElement;
        const drawerPrevBtn = document.getElementById('drawer-prev-btn') as HTMLButtonElement;
        const drawerNextBtn = document.getElementById('drawer-next-btn') as HTMLButtonElement;
        const drawerNavCounter = document.getElementById('drawer-nav-counter') as HTMLElement;
        const drawerSubtitle = document.getElementById('drawer-subtitle') as HTMLElement;

        // Estado del visor de zoom interactivo
        let modalZoom = 1;
        let modalPanX = 0;
        let modalPanY = 0;
        let modalRotate = 0;
        let isPanning = false;
        let startPanX = 0;
        let startPanY = 0;

        function applyModalZoomTransform() {
          if (!drawerFoto) return;
          drawerFoto.style.transform = `translate(${modalPanX}px, ${modalPanY}px) scale(${modalZoom}) rotate(${modalRotate}deg)`;
          if (zoomLevelText) {
            zoomLevelText.textContent = `${Math.round(modalZoom * 100)}%`;
          }
        }

        function resetModalZoom() {
          modalZoom = 1;
          modalPanX = 0;
          modalPanY = 0;
          modalRotate = 0;
          applyModalZoomTransform();
        }

        // Eventos de Zoom con Rueda del Ratón
        drawerZoomViewport?.addEventListener('wheel', (e: WheelEvent) => {
          e.preventDefault();
          const delta = e.deltaY < 0 ? 1.15 : 0.87;
          modalZoom = Math.min(Math.max(modalZoom * delta, 0.4), 6.0);
          applyModalZoomTransform();
        }, { passive: false });

        // Eventos de Arrastre (Pan) con Mouse
        drawerZoomViewport?.addEventListener('mousedown', (e: MouseEvent) => {
          if (e.button !== 0) return;
          isPanning = true;
          startPanX = e.clientX - modalPanX;
          startPanY = e.clientY - modalPanY;
          if (drawerZoomViewport) drawerZoomViewport.style.cursor = 'grabbing';
        });

        window.addEventListener('mousemove', (e: MouseEvent) => {
          if (!isPanning) return;
          modalPanX = e.clientX - startPanX;
          modalPanY = e.clientY - startPanY;
          applyModalZoomTransform();
        });

        window.addEventListener('mouseup', () => {
          if (isPanning) {
            isPanning = false;
            if (drawerZoomViewport) drawerZoomViewport.style.cursor = 'grab';
          }
        });

        // Botones de control de zoom
        btnZoomIn?.addEventListener('click', () => {
          modalZoom = Math.min(modalZoom * 1.25, 6.0);
          applyModalZoomTransform();
        });

        btnZoomOut?.addEventListener('click', () => {
          modalZoom = Math.max(modalZoom * 0.8, 0.4);
          applyModalZoomTransform();
        });

        btnZoomRotate?.addEventListener('click', () => {
          modalRotate = (modalRotate + 90) % 360;
          applyModalZoomTransform();
        });

        btnZoomReset?.addEventListener('click', () => {
          resetModalZoom();
        });

        window.openEscaneoDrawer = function(escaneoId: number) {
          const idx = drawerFotosFlat.findIndex((f: any) => f.id === escaneoId);
          drawerCurrentIndex = idx >= 0 ? idx : 0;
          loadDrawerByIndex(drawerCurrentIndex);
          escaneoDrawer.classList.remove('hidden');
          escaneoDrawer.classList.add('flex');
          document.body.style.overflow = 'hidden';
        };

        function loadDrawerByIndex(idx: number) {
          if (drawerFotosFlat.length === 0) return;
          const foto = drawerFotosFlat[idx];
          activeEscaneoId = foto.id;
          drawerFoto.src = foto.foto_url;
          resetModalZoom();
          drawerIdGuia.value = '';
          drawerPiezas.value = '1';
          drawerDestinatario.value = '';
          drawerTelefono.value = '';
          drawerCiudad.value = '';
          if (drawerEmpresa) drawerEmpresa.value = foto.empresa || '';
          drawerDireccion.value = '';
          drawerError.classList.add('hidden');
          drawerSubtitle.textContent = `Chofer: ${foto.chofer_nombre}`;
          if (drawerLoteBadge) drawerLoteBadge.textContent = foto.lote_id || 'Lote';
          drawerNavCounter.textContent = `${idx + 1} / ${drawerFotosFlat.length}`;
          drawerPrevBtn.disabled = idx === 0;
          drawerNextBtn.disabled = idx === drawerFotosFlat.length - 1;
          setTimeout(() => {
            drawerIdGuia?.focus();
          }, 120);
        }

        function closeDrawer() {
          escaneoDrawer.classList.add('hidden');
          escaneoDrawer.classList.remove('flex');
          document.body.style.overflow = '';
          activeEscaneoId = null;
          resetModalZoom();
        }

        drawerCloseBtn?.addEventListener('click', closeDrawer);
        drawerOverlay?.addEventListener('click', closeDrawer);

        drawerPrevBtn?.addEventListener('click', () => {
          if (drawerCurrentIndex > 0) {
            drawerCurrentIndex--;
            loadDrawerByIndex(drawerCurrentIndex);
          }
        });
        drawerNextBtn?.addEventListener('click', () => {
          if (drawerCurrentIndex < drawerFotosFlat.length - 1) {
            drawerCurrentIndex++;
            loadDrawerByIndex(drawerCurrentIndex);
          }
        });

        // Atajos de teclado cuando el modal está abierto
        window.addEventListener('keydown', (e: KeyboardEvent) => {
          if (escaneoDrawer && !escaneoDrawer.classList.contains('hidden')) {
            if (e.key === 'Escape') {
              closeDrawer();
            } else if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
              drawerApproveBtn?.click();
            }
          }
        });

        const drawerDeleteBtn = document.getElementById('drawer-delete-btn') as HTMLButtonElement;

        drawerDeleteBtn?.addEventListener('click', async () => {
          if (!activeEscaneoId) return;

          if (!confirm('¿Estás seguro de que deseas eliminar permanentemente este escaneo y su foto?')) {
            return;
          }

          const originalHtml = drawerDeleteBtn.innerHTML;
          drawerDeleteBtn.disabled = true;
          drawerDeleteBtn.innerHTML = `
            <svg class="animate-spin w-4 h-4 text-rose-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
          `;

          try {
            const res = await fetch(`/api/escaneos/${activeEscaneoId}`, { method: 'DELETE' });
            const data = await res.json();

            if (res.ok && data.success) {
              showToast('Escaneo eliminado permanentemente', 'success');
              drawerFotosFlat.splice(drawerCurrentIndex, 1);
              if (drawerFotosFlat.length === 0) {
                closeDrawer();
                loadAndRenderEscaneos();
                return;
              }
              if (drawerCurrentIndex >= drawerFotosFlat.length) {
                drawerCurrentIndex = drawerFotosFlat.length - 1;
              }
              loadDrawerByIndex(drawerCurrentIndex);
              loadAndRenderEscaneos();
            } else {
              showToast(data.message || 'Error al eliminar escaneo', 'error');
            }
          } catch (e) {
            showToast('Error de conexión al eliminar escaneo', 'error');
          } finally {
            drawerDeleteBtn.disabled = false;
            drawerDeleteBtn.innerHTML = originalHtml;
          }
        });

        drawerRejectBtn?.addEventListener('click', async () => {
          if (!activeEscaneoId) return;
          drawerRejectBtn.disabled = true;
          try {
            await fetch(`/api/escaneos/${activeEscaneoId}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ accion: 'rechazar' })
            });
            // Remover de la lista plana y avanzar
            drawerFotosFlat.splice(drawerCurrentIndex, 1);
            if (drawerFotosFlat.length === 0) { closeDrawer(); loadAndRenderEscaneos(); return; }
            if (drawerCurrentIndex >= drawerFotosFlat.length) drawerCurrentIndex = drawerFotosFlat.length - 1;
            loadDrawerByIndex(drawerCurrentIndex);
            loadAndRenderEscaneos();
          } catch(e) { drawerRejectBtn.disabled = false; }
        });

        drawerApproveBtn?.addEventListener('click', async () => {
          if (!activeEscaneoId) return;

          const id_guia = drawerIdGuia.value.trim();
          const destinatario = drawerDestinatario.value.trim();
          const telefono = drawerTelefono.value.trim();
          const ciudad = drawerCiudad.value.trim();
          const piezas = drawerPiezas.value;
          const empresa = drawerEmpresa ? drawerEmpresa.value.trim() : '';
          const direccion = drawerDireccion.value.trim();

          if (!id_guia || !destinatario || !telefono || !ciudad) {
            drawerError.textContent = 'Completa los campos obligatorios: N° Guía, Destinatario, Teléfono y Ciudad.';
            drawerError.classList.remove('hidden');
            return;
          }
          drawerError.classList.add('hidden');

          const originalHtml = drawerApproveBtn.innerHTML;
          drawerApproveBtn.disabled = true;
          drawerApproveBtn.innerHTML = `<svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg><span>Creando guía...</span>`;

          try {
            const res = await fetch(`/api/escaneos/${activeEscaneoId}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                accion: 'procesar',
                datos_guia: {
                  id_guia,
                  destinatario,
                  telefono_principal: telefono,
                  ciudad_destino: ciudad,
                  piezas,
                  direccion_referencia: direccion,
                  empresa: empresa || undefined
                }
              })
            });
            const data = await res.json();

            if (res.ok && data.success) {
              // Remover foto procesada y avanzar
              drawerFotosFlat.splice(drawerCurrentIndex, 1);
              if (drawerFotosFlat.length === 0) { closeDrawer(); loadAndRenderEscaneos(); silentRefresh(); return; }
              if (drawerCurrentIndex >= drawerFotosFlat.length) drawerCurrentIndex = drawerFotosFlat.length - 1;
              loadDrawerByIndex(drawerCurrentIndex);
              loadAndRenderEscaneos();
              silentRefresh();
            } else {
              drawerError.textContent = data.message || 'Error al crear la guía.';
              drawerError.classList.remove('hidden');
              drawerApproveBtn.disabled = false;
              drawerApproveBtn.innerHTML = originalHtml;
            }
          } catch(e) {
            drawerError.textContent = 'Error de conexión. Intenta de nuevo.';
            drawerError.classList.remove('hidden');
            drawerApproveBtn.disabled = false;
            drawerApproveBtn.innerHTML = originalHtml;
          }
        });

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (isSubmitting) return;

          const guiaInput = document.getElementById('input-guia') as HTMLInputElement;
          const destInput = document.getElementById('input-destinatario') as HTMLInputElement;
          const telInput = document.getElementById('input-telefono') as HTMLInputElement;
          const tel2Input = document.getElementById('input-telefono-2') as HTMLInputElement;
          const ciudadInput = document.getElementById('input-ciudad') as HTMLInputElement;
          const piezasInput = document.getElementById('input-piezas') as HTMLInputElement;
          const empresaInput = document.getElementById('input-empresa') as HTMLSelectElement;
          const dirInput = document.getElementById('input-direccion') as HTMLInputElement;
          const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

          const id_guia = guiaInput.value.trim().toUpperCase();

          // Bloqueo de envío múltiple
          isSubmitting = true;
          submitBtn.disabled = true;
          const originalBtnContent = submitBtn.innerHTML;
          submitBtn.innerHTML = `
            <svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>Guardando en BD...</span>
          `;

          // Payload para PostgreSQL
          const payload = {
            id_guia,
            destinatario: destInput.value.trim(),
            telefono_principal: telInput.value.trim(),
            telefono_secundario: tel2Input.value.trim() || undefined,
            ciudad_destino: ciudadInput.value.trim(),
            piezas: parseInt(piezasInput.value, 10) || 1,
            empresa: empresaInput ? empresaInput.value.trim() || undefined : undefined,
            direccion_referencia: dirInput.value.trim() || undefined
          };

          try {
            const res = await fetch('/api/guias', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            const json = await res.json();

            if (res.ok && json.success) {
              // Agregar al estado local
              shipments.unshift(json.data);

              form.reset();
              piezasInput.value = '1';
              if (empresaInput) empresaInput.value = '';
              guiaInput.focus();

              populateCityFilter();
              renderViews();
              showToast(`Guía #${id_guia} guardada en PostgreSQL`, 'success');
            } else {
              showToast(json.message || 'Error al guardar la guía', 'error');
            }
          } catch (err: any) {
            console.error('Error al registrar guía:', err);
            showToast('Error de conexión con el servidor', 'error');
          } finally {
            isSubmitting = false;
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnContent;
          }
        });

        searchInput.addEventListener('input', renderViews);
        filterCiudad.addEventListener('change', renderViews);
        filterEmpresa?.addEventListener('change', renderViews);
        filterEstado.addEventListener('change', renderViews);
      }

      // Métodos globales para interactividad en tabla (window)
      (window as any).updateShipmentStatus = async (id_guia: string, newStatus: GuiaRow['estado']) => {
        try {
          const res = await fetch(`/api/guias/${encodeURIComponent(id_guia)}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ estado: newStatus })
          });

          const json = await res.json();
          if (res.ok && json.success) {
            const item = shipments.find(s => s.id_guia === id_guia);
            if (item) {
              item.estado = newStatus;
              renderViews();
              showToast(`Estado de guía #${id_guia} actualizado a: ${newStatus}`, 'info');
            }
          } else {
            showToast(json.message || 'Error al actualizar el estado', 'error');
          }
        } catch (err) {
          showToast('Error de red al actualizar estado', 'error');
        }
      };

      (window as any).updateShipmentDriver = async (id_guia: string, driverIdStr: string) => {
        try {
          const chofer_id = driverIdStr ? parseInt(driverIdStr, 10) : null;
          const res = await fetch(`/api/guias/${encodeURIComponent(id_guia)}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              chofer_asignado_id: chofer_id,
              estado: chofer_id ? 'En ruta' : undefined // si se le asigna chofer individual, pasa a En ruta
            })
          });

          const json = await res.json();
          if (res.ok && json.success) {
            const item = shipments.find(s => s.id_guia === id_guia);
            if (item) {
              item.chofer_asignado_id = chofer_id;
              const assignedDriver = drivers.find(d => d.id === chofer_id);
              item.chofer_nombre = assignedDriver ? assignedDriver.nombre : null;
              if (chofer_id && item.estado !== 'Entregado') {
                item.estado = 'En ruta';
              }
              renderViews();
              showToast(`Chofer asignado para #${id_guia}: ${assignedDriver ? assignedDriver.nombre : 'Sin Asignar'}`, 'info');
            }
          } else {
            showToast(json.message || 'Error al asignar chofer', 'error');
          }
        } catch (err) {
          showToast('Error de red al asignar chofer', 'error');
        }
      };

      (window as any).deleteShipment = async (id_guia: string) => {
        if (!confirm(`¿Estás seguro de eliminar la guía #${id_guia} de PostgreSQL?`)) return;

        try {
          const res = await fetch(`/api/guias/${encodeURIComponent(id_guia)}`, {
            method: 'DELETE'
          });

          const json = await res.json();
          if (res.ok && json.success) {
            shipments = shipments.filter(s => s.id_guia !== id_guia);
            populateCityFilter();
            renderViews();
            showToast(`Guía #${id_guia} eliminada de la base de datos`, 'info');
          } else {
            showToast(json.message || 'Error al eliminar la guía', 'error');
          }
        } catch (err) {
          showToast('Error de red al eliminar la guía', 'error');
        }
      };

      // Formatear nombres a Title Case
      function toTitleCase(str: string): string {
        if (!str) return '';
        return str
          .toLowerCase()
          .split(' ')
          .map(word => word.charAt(0).toUpperCase() + word.slice(1))
          .join(' ');
      }

      // Acción de WhatsApp con plantilla oficial y cambio automático a "Contactado"
      (window as any).sendWhatsApp = async (id_guia: string) => {
        const item = shipments.find(s => s.id_guia === id_guia);
        if (!item) return;

        const phoneFormatted = formatPhoneForWhatsApp(item.telefono_principal);
        const host = window.location.origin;
        const customerUrl = `${host}/confirmar?guia=${encodeURIComponent(item.id_guia)}`;
        const customerName = toTitleCase(item.destinatario);
        const city = item.ciudad_destino || 'su localidad';
        const piecesText = (item.piezas || 1) === 1 ? '1 pieza' : `${item.piezas} piezas`;

        const message = 
`*ENVÍAS C.A. | Notificación de Despacho*

Estimado(a) *${customerName}*,

Le informamos que su paquete con *Guía #${item.id_guia}* (${piecesText}) se encuentra en proceso de entrega hacia *${city}*.

Para asegurar una entrega puntual y sin contratiempos, por favor confirme su punto de entrega en nuestro portal oficial:
${customerUrl}

_Envías C.A. • Transporte y Logística Nacional_`;

        const whatsappUrl = `https://wa.me/${phoneFormatted}?text=${encodeURIComponent(message)}`;

        window.open(whatsappUrl, '_blank');
        showToast(`Abriendo WhatsApp para guía #${item.id_guia}...`, 'success');

        // Si estaba "Por contactar", pasar automáticamente a "Contactado"
        if (item.estado === 'Por contactar') {
          await (window as any).updateShipmentStatus(item.id_guia, 'Contactado');
        }
      };

      // Helper para Toasts visuales sin emojis
      function showToast(message: string, type: 'success' | 'info' | 'error' = 'info') {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `px-4 py-3 rounded-2xl shadow-xl text-xs font-semibold flex items-center gap-2.5 border transition-all duration-300 transform translate-y-2 opacity-0 pointer-events-auto ${
          type === 'success' ? 'bg-slate-900 text-white border-slate-800' :
          type === 'error' ? 'bg-rose-600 text-white border-rose-700' :
          'bg-white text-slate-800 border-slate-200 shadow-slate-900/10'
        }`;

        let iconSvg = `
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sky-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        `;
        if (type === 'success') {
          iconSvg = `
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          `;
        }
        if (type === 'error') {
          iconSvg = `
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          `;
        }

        toast.innerHTML = `${iconSvg} <span>${message}</span>`;
        container.appendChild(toast);

        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-2', 'opacity-0');
        });

        setTimeout(() => {
          toast.classList.add('translate-y-2', 'opacity-0');
          setTimeout(() => toast.remove(), 300);
        }, 3500);
      }

      // ==========================================
      // MODAL EDITAR GUÍA
