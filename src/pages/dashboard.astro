        const modalClientsFilterCiudad = document.getElementById('modal-clients-filter-ciudad') as HTMLSelectElement;

        if (!modalFrequentClients) return;
        modalFrequentClients.classList.remove('hidden');
        modalFrequentClients.classList.add('flex');
        document.body.style.overflow = 'hidden';

        if (modalClientsFilterCiudad) {
          const uniqueCities = Array.from(new Set(frequentClients.map(c => c.ciudad_destino).filter(Boolean))).sort();
          const currentCity = modalClientsFilterCiudad.value;
          modalClientsFilterCiudad.innerHTML = `
            <option value="">Todas las Ciudades (${uniqueCities.length})</option>
            ${uniqueCities.map(city => `<option value="${city}" ${currentCity === city ? 'selected' : ''}>${city}</option>`).join('')}
          `;
        }

        renderModalClientsList();
        if (modalClientsSearch) {
          modalClientsSearch.focus();
        }
      };

      (window as any).closeFrequentClientsModal = () => {
        const modalFrequentClients = document.getElementById('modal-frequent-clients') as HTMLElement;
