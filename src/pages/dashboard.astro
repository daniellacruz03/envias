                ${(item.orden_ruta && item.orden_ruta > 0) || item.estado === 'En ruta' || item.estado === 'Entregado' ? `
                  <span class="inline-flex items-center gap-1 text-[10px] font-mono font-extrabold px-1.5 py-0.5 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200 shadow-2xs" title="Guía en listín / despachada (${item.orden_ruta ? `Parada #${item.orden_ruta}` : 'En ruta'})">
                    <svg class="w-3 h-3 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>En listín${item.orden_ruta ? ` #${item.orden_ruta}` : ''}</span>
                  </span>
                ` : `
                  <span class="inline-flex items-center gap-1 text-[10px] font-bold px-1.5 py-0.5 rounded-md bg-slate-100 text-slate-500 border border-slate-200" title="Guía pendiente por incluir en listín de despacho">
                    <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>Sin listín</span>
