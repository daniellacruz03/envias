  // Carga Inicial desde PostgreSQL y sincronización en vivo
      async function init() {
        attachEvents();
        renderLoading();
        await loadData();

        // Polling automático cada 3.5 segundos en segundo plano para Live Sync
        setInterval(() => {
          silentRefresh();
        }, 3500);
      }

      function renderLoading() {
        tableBody.innerHTML = `
          <tr>
            <td colspan="7" class="py-12 text-center text-slate-400">
              <div class="flex items-center justify-center gap-2.5">
                <svg class="animate-spin w-4 h-4 text-slate-700" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span class="text-xs font-medium">Conectando con PostgreSQL en Railway...</span>
              </div>
            </td>
          </tr>
        `;
      }

      async function loadData() {
        try {
          // Consultas principales de guías y choferes
          const guiasPromise = fetch('/api/guias').then(r => r.ok ? r.json() : null).catch(() => null);
          const choferesPromise = fetch('/api/choferes').then(r => r.ok ? r.json() : null).catch(() => null);
          
          const [guiasJson, choferesJson] = await Promise.all([guiasPromise, choferesPromise]);

          if (guiasJson && guiasJson.success && Array.isArray(guiasJson.data)) {
            shipments = guiasJson.data;
          }

          if (choferesJson && choferesJson.success && Array.isArray(choferesJson.data)) {
            drivers = choferesJson.data;
          }

          // Consultas secundarias no bloqueantes para badges
          fetch('/api/escaneos')
            .then(r => r.ok ? r.json() : null)
            .then(escData => {
              if (escData && escData.totalPendientes && escaneosCountPill) {
                escaneosCountPill.textContent = escData.totalPendientes.toString();
                escaneosCountPill.classList.remove('hidden');
                escaneosCountPill.className = 'text-[10px] bg-amber-400 text-white px-1.5 py-0.2 rounded-full font-bold';
              }
            }).catch(() => {});

          fetch('/api/rutas/historial')
            .then(r => r.ok ? r.json() : null)
            .then(histData => {
              if (histData && histData.success && Array.isArray(histData.data)) {
                historialRoutes = histData.data;
                filteredHistorialRoutes = [...historialRoutes];
                if (historialCountPill) {
                  historialCountPill.textContent = historialRoutes.length.toString();
                }
                if (historialBadgeCount) {
                  historialBadgeCount.textContent = `${historialRoutes.length} ruta${historialRoutes.length !== 1 ? 's' : ''} archivada${historialRoutes.length !== 1 ? 's' : ''}`;
                }
              }
            }).catch(() => {});

          isLoading = false;
          populateCityFilter();
          loadFrequentClients();
          renderViews();

          // Si por alguna razón no se cargaron guías pero el servidor respondió vacío por reinicio, reintentar en 1.5s
          if (shipments.length === 0 && !guiasJson) {
            setTimeout(loadData, 1500);
          }
        } catch (err: any) {
          isLoading = false;
          console.warn('Conexión en espera del servidor, reintentando...', err);
          setTimeout(loadData, 2000);
        }
      }

      // Sincronización automática silenciosa en tiempo real
      async function silentRefresh() {
        if (isSubmitting || isLoading) return;
        try {
          // 1. Sincronizar guías
          const res = await fetch('/api/guias');
          const json = await res.json();
          if (res.ok && json.success && Array.isArray(json.data)) {
            const newShipments: GuiaRow[] = json.data;
            
            // Detectar cambios en guías, estados o confirmaciones de GPS
            let hasChanges = false;
            if (newShipments.length !== shipments.length) {
              hasChanges = true;
            } else {
              for (let i = 0; i < newShipments.length; i++) {
                const current = shipments.find(s => s.id_guia === newShipments[i].id_guia);
                if (!current) {
                  hasChanges = true;
                  break;
                }
                // Si el cliente acaba de confirmar su ubicación GPS
                if (!current.gps_confirmado && newShipments[i].gps_confirmado) {
                  showToast(`Ubicación confirmada por el cliente para la guía #${newShipments[i].id_guia}`, 'success');
                  hasChanges = true;
                  break;
                }
                if (
                  current.estado !== newShipments[i].estado ||
                  current.chofer_asignado_id !== newShipments[i].chofer_asignado_id ||
                  current.direccion_referencia !== newShipments[i].direccion_referencia ||
                  current.hora_disponible !== newShipments[i].hora_disponible ||
                  current.empresa !== newShipments[i].empresa
                ) {
                  hasChanges = true;
                  break;
                }
              }
            }

            if (hasChanges) {
              shipments = newShipments;
              populateCityFilter();
              loadFrequentClients();
              renderViews();
            }
          }

          // 2. Sincronizar badge de escaneos y lista en tiempo real si está activa la vista
          try {
            const escRes = await fetch('/api/escaneos');
            if (escRes.ok) {
              const escData = await escRes.json();
              const totalPend = escData.totalPendientes || 0;
              const newLotes = escData.data || [];

              // Actualizar badge numérico en la pestaña
              if (escaneosCountPill) {
                if (totalPend > 0) {
                  escaneosCountPill.textContent = totalPend.toString();
                  escaneosCountPill.classList.remove('hidden');
                  escaneosCountPill.className = 'text-[10px] bg-amber-400 text-white px-1.5 py-0.2 rounded-full font-bold';
                } else {
                  escaneosCountPill.classList.add('hidden');
                }
              }

              // Si el usuario está viendo la pestaña de escaneos y el drawer NO está abierto
              const escaneoDrawerEl = document.getElementById('escaneo-drawer');
              const isDrawerClosed = !escaneoDrawerEl || escaneoDrawerEl.classList.contains('hidden');

              if (currentViewMode === 'escaneos' && isDrawerClosed) {
                const prevSummary = JSON.stringify(escaneosData.map((l: any) => ({ id: l.lote_id, total: l.total, pend: l.pendientes, proc: l.procesadas })));
                const newSummary = JSON.stringify(newLotes.map((l: any) => ({ id: l.lote_id, total: l.total, pend: l.pendientes, proc: l.procesadas })));

                if (prevSummary !== newSummary || escaneosData.length === 0) {
                  escaneosData = newLotes;
                  const listEl = document.getElementById('escaneos-list');
                  const emptyEl = document.getElementById('escaneos-empty');
                  const loadingEl = document.getElementById('escaneos-loading');
                  loadingEl?.classList.add('hidden');

                  if (escaneosData.length === 0) {
                    listEl?.classList.add('hidden');
                    emptyEl?.classList.remove('hidden');
                  } else {
                    emptyEl?.classList.add('hidden');
                    if (listEl) {
                      const renderer = typeof renderEscaneoLote === 'function' ? renderEscaneoLote : (window as any).renderEscaneoLote;
                      if (renderer) {
                        listEl.innerHTML = escaneosData.map((lote: any) => renderer(lote)).join('');
                        listEl.classList.remove('hidden');
                      }
                    }
                    drawerFotosFlat = escaneosData.flatMap((lote: any) =>
                      (lote.fotos || []).filter((f: any) => f.estado === 'pendiente').map((f: any) => ({
                        ...f,
                        chofer_nombre: lote.chofer_nombre,
                        lote_id: lote.lote_id
                      }))
                    );
                  }
                }
              }
            }
          } catch(e) {}

          // 3. Sincronizar historial de rutas
          try {
            const histRes = await fetch('/api/rutas/historial');
            if (histRes.ok) {
              const histData = await histRes.json();
              if (histData.success && Array.isArray(histData.data)) {
                if (histData.data.length !== historialRoutes.length) {
                  historialRoutes = histData.data;
                  if (historialCountPill) {
                    historialCountPill.textContent = historialRoutes.length.toString();
                  }
                  if (historialBadgeCount) {
                    historialBadgeCount.textContent = `${historialRoutes.length} ruta${historialRoutes.length !== 1 ? 's' : ''} archivada${historialRoutes.length !== 1 ? 's' : ''}`;
                  }
                  if (currentViewMode === 'historial') {
                    (window as any).filterHistorialData();
                  }
                }
              }
            }
          } catch(e) {}

        } catch (err) {
          // Error silencioso de red sin interrumpir al usuario
        }
      }

      // Llenar filtro de ciudades
      function populateCityFilter() {
        const currentVal = filterCiudad.value;
        const uniqueCities = Array.from(new Set(shipments.map(s => s.ciudad_destino).filter(Boolean))).sort();
        
        filterCiudad.innerHTML = `<option value="ALL">Todas las Ciudades (${shipments.length} ${shipments.length === 1 ? 'guía' : 'guías'})</option>`;
        uniqueCities.forEach(city => {
          const cityGuiasCount = shipments.filter(s => s.ciudad_destino === city).length;
          const opt = document.createElement('option');
          opt.value = city;
          opt.textContent = `${city} (${cityGuiasCount} ${cityGuiasCount === 1 ? 'guía' : 'guías'})`;
          filterCiudad.appendChild(opt);
        });

        if (uniqueCities.includes(currentVal)) {
          filterCiudad.value = currentVal;
        }

        if (citiesCountPill) {
          citiesCountPill.textContent = uniqueCities.length.toString();
          citiesCountPill.title = `${uniqueCities.length} ciudades (${shipments.length} guías registradas)`;
        }
      }

      // Helper para calcular semana ISO e información de lote
      function getGuiaWeekInfo(g: GuiaRow): { week: number; year: number; isCurrentWeek: boolean; isPastPending: boolean; loteCode: string; label: string } {
        const date = g.created_at ? new Date(g.created_at) : new Date();
        const d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
        const dayNum = d.getUTCDay() || 7;
        d.setUTCDate(d.getUTCDate() + 4 - dayNum);
        const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
        const weekNo = Math.ceil((((d.getTime() - yearStart.getTime()) / 86400000) + 1) / 7);
        const year = d.getUTCFullYear();

        const now = new Date();
        const nowD = new Date(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()));
        const nowDay = nowD.getUTCDay() || 7;
        nowD.setUTCDate(nowD.getUTCDate() + 4 - nowDay);
        const nowYearStart = new Date(Date.UTC(nowD.getUTCFullYear(), 0, 1));
        const nowWeek = Math.ceil((((nowD.getTime() - nowYearStart.getTime()) / 86400000) + 1) / 7);
        const nowYear = nowD.getUTCFullYear();

        const isCurrentWeek = (year === nowYear && weekNo === nowWeek);
        
        // Rezagadas: Encomiendas marcadas estrictamente como "No entregado"
        const isPastPending = (g.estado === 'No entregado');

        const weekFormatted = weekNo < 10 ? '0' + weekNo : weekNo.toString();
        const originSlug = (g.ruta_origen || 'BRM').replace(/[^A-Z0-9]/gi, '').slice(0, 3).toUpperCase() || 'BRM';
        const loteCode = g.lote_despacho || `REL-${year}-W${weekFormatted}-${originSlug}`;
        const label = `Semana ${weekFormatted} (${year})`;

        return {
          week: weekNo,
          year: year,
          isCurrentWeek: isCurrentWeek,
          isPastPending: isPastPending,
          loteCode: loteCode,
          label: label
        };
      }

