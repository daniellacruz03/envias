                <!-- 2. Título del Documento -->
                <div style="text-align: center; margin-bottom: 6px;">
                  <div style="font-size: 10.5px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.04em; border: 2px solid #000; padding: 3px 8px; background-color: #f1f5f9; display: flex; align-items: center; justify-content: center; gap: 8px;">
