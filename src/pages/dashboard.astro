                type="button"
                onclick="window.toggleListinZone('${cityName.replace(/'/g, "\\'")}')"
                class="px-2.5 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5 ${isSelected ? 'bg-indigo-600 text-white shadow-xs ring-2 ring-indigo-300' : 'bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200'}"
              >
                ${isSelected ? '<svg class="w-3 h-3 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>' : ''}
                <span>${cityName}</span>
                <span class="text-[10px] px-1.5 py-0.2 rounded-full ${isSelected ? 'bg-white/20 text-white' : 'bg-slate-200 text-slate-800'} font-mono">${count}</span>
              </button>
            `;
          });

          listinZonePills.innerHTML = pillsHtml;
        }
      }

      function renderListinView() {
        populateListinDriverSelect();
        const srcShipments = getListinSourceShipments();

        syncListinState(srcShipments);
        renderListinZoneControls(srcShipments);

        if (listinCitiesCount) {
          if (listinActiveRoute !== 'ALL') {
            const routes = getListinRoutes(srcShipments);
            const rObj = routes.find(r => r.key === listinActiveRoute);
            const rCount = rObj ? rObj.guias.length : 0;
            listinCitiesCount.textContent = `Ruta: ${rObj?.driverName || listinActiveRoute} (${rCount} guías)`;
          } else if (listinSelectedZones.size === 1) {
            const zName = Array.from(listinSelectedZones)[0];
            const zoneGuiasCount = getOrderedActiveGuias(srcShipments, zName).length;
            listinCitiesCount.textContent = `Zona: ${zName} (${zoneGuiasCount} guías)`;
          } else if (listinSelectedZones.size > 1) {
            const combinedCount = getOrderedActiveGuias(srcShipments).length;
            listinCitiesCount.textContent = `${listinSelectedZones.size} zonas combinadas (${combinedCount} guías)`;
          } else if (listinViewSubMode === 'routes') {
            const routes = getListinRoutes(srcShipments);
            listinCitiesCount.textContent = `${routes.length} rutas planificadas`;
          } else if (listinViewSubMode === 'zones') {
            listinCitiesCount.textContent = `${listinCitiesOrder.length} zonas consolidado`;
          } else {
            const activeCount = getOrderedActiveGuias(srcShipments).length;
            listinCitiesCount.textContent = `${activeCount} guía${activeCount !== 1 ? 's' : ''}`;
          }
        }

        // Actualizar botones de submodo en UI (Por Rutas, Por Zonas, Lista 1..N)
        if (btnListinModeRoutes && btnListinModeZones && btnListinModeFlat) {
          if (listinViewSubMode === 'routes') {
            btnListinModeRoutes.className = 'px-2.5 py-1 rounded-lg font-bold transition-all bg-white text-slate-900 shadow-xs cursor-pointer';
            btnListinModeZones.className = 'px-2.5 py-1 rounded-lg font-bold text-slate-500 hover:text-slate-900 transition-all cursor-pointer';
            btnListinModeFlat.className = 'px-2.5 py-1 rounded-lg font-bold text-slate-500 hover:text-slate-900 transition-all cursor-pointer';
            if (listinPanelTitle) {
              listinPanelTitle.textContent = listinActiveRoute !== 'ALL' 
                ? `Ruta: ${listinActiveRoute.replace('driver-', 'Chofer #')}` 
                : 'Organizar Listín por Rutas';
            }
            if (listinInstructionsText) listinInstructionsText.innerHTML = 'Organizado por rutas de chofer. Usa <span class="font-bold text-slate-700">▲</span> <span class="font-bold text-slate-700">▼</span> o arrastra <span class="font-bold text-slate-700">⠿</span> para secuenciar paradas.';
          } else if (listinViewSubMode === 'zones') {
            btnListinModeZones.className = 'px-2.5 py-1 rounded-lg font-bold transition-all bg-white text-slate-900 shadow-xs cursor-pointer';
            btnListinModeRoutes.className = 'px-2.5 py-1 rounded-lg font-bold text-slate-500 hover:text-slate-900 transition-all cursor-pointer';
            btnListinModeFlat.className = 'px-2.5 py-1 rounded-lg font-bold text-slate-500 hover:text-slate-900 transition-all cursor-pointer';
            if (listinPanelTitle) {
              listinPanelTitle.textContent = listinSelectedZones.size === 1 
                ? `Organizar Zona: ${Array.from(listinSelectedZones)[0]}` 
                : listinSelectedZones.size > 1 
                  ? `Organizar ${listinSelectedZones.size} Zonas Combinadas` 
                  : 'Organizar por Zonas / Ciudades';
            }
            if (listinInstructionsText) listinInstructionsText.innerHTML = 'Usa las flechas <span class="font-bold text-slate-700">▲</span> <span class="font-bold text-slate-700">▼</span> o arrastra <span class="font-bold text-slate-700">⠿</span> las zonas y guías para cambiar el orden.';
          } else {
            btnListinModeFlat.className = 'px-2.5 py-1 rounded-lg font-bold transition-all bg-white text-slate-900 shadow-xs cursor-pointer';
            btnListinModeRoutes.className = 'px-2.5 py-1 rounded-lg font-bold text-slate-500 hover:text-slate-900 transition-all cursor-pointer';
            btnListinModeZones.className = 'px-2.5 py-1 rounded-lg font-bold text-slate-500 hover:text-slate-900 transition-all cursor-pointer';
            if (listinPanelTitle) listinPanelTitle.textContent = 'Lista Continua de Guías (1..N)';
            if (listinInstructionsText) listinInstructionsText.innerHTML = 'Orden libre continuo del 1 al N. Usa <span class="font-bold text-slate-700">▲</span> <span class="font-bold text-slate-700">▼</span> o arrastra <span class="font-bold text-slate-700">⠿</span> para ubicar cada guía.';
          }
        }

        // 1. Renderizar Editor de Jerarquía y Guías (Izquierda)
        renderListinHierarchy(srcShipments);

        // 2. Renderizar Hoja del Listín en Vivo (Derecha)
        renderListinPrintPreview(srcShipments);
      }

      function renderListinHierarchy(srcShipments: GuiaRow[]) {
        if (!listinHierarchyList) return;

        if (srcShipments.length === 0) {
          listinHierarchyList.innerHTML = `
            <div class="p-8 text-center bg-slate-50 rounded-xl border border-dashed border-slate-200 text-slate-400 text-xs">
              No hay guías registradas para los filtros seleccionados.
            </div>
          `;
          return;
        }

        const query = listinSearchQuery.trim().toLowerCase();
        const mapById = new Map(srcShipments.map(g => [g.id_guia, g]));

        // ==========================================
        // MODO 1: AGRUPADO POR RUTAS DE CHOFER
        // ==========================================
        if (listinViewSubMode === 'routes') {
          const allRoutes = getListinRoutes(srcShipments);
          const displayRoutes = listinActiveRoute !== 'ALL'
            ? allRoutes.filter(r => r.key === listinActiveRoute)
            : allRoutes;

          listinHierarchyList.innerHTML = displayRoutes.map((route, routeIdx) => {
            const rawGuiaIds = listinRouteGuiasOrder[route.key] || [];
            let routeGuias = rawGuiaIds.map(id => mapById.get(id)).filter(Boolean) as GuiaRow[];

            // Filtro de búsqueda
            if (query) {
              const matchesRoute = route.driverName.toLowerCase().includes(query) || route.cities.some(c => c.toLowerCase().includes(query));
              if (!matchesRoute) {
                routeGuias = routeGuias.filter(g => 
                  g.id_guia.toLowerCase().includes(query) || 
                  (g.destinatario || '').toLowerCase().includes(query) ||
                  (g.ciudad_destino || '').toLowerCase().includes(query)
                );
                if (routeGuias.length === 0) return '';
              }
            }

            const totalPiezas = routeGuias.reduce((acc, g) => acc + (g.piezas || 1), 0);
            const totalVol = routeGuias.reduce((acc, g) => acc + (Number(g.pies_cubicos) || 0), 0);
            const isExcluded = listinExcludedRoutes.has(route.key);
            const isCollapsed = listinCollapsedRoutes.has(route.key) && listinActiveRoute === 'ALL';
            const isFocused = listinActiveRoute === route.key;
            const citiesTrail = route.cities.slice(0, 3).join(' ➔ ') + (route.cities.length > 3 ? ` +${route.cities.length - 3}` : '');

            return `
              <div
                class="bg-slate-50 border ${isFocused ? 'border-indigo-400 ring-2 ring-indigo-500/20 bg-indigo-50/10' : (isExcluded ? 'border-slate-200 opacity-60' : 'border-slate-200/90')} rounded-xl p-3 space-y-2.5 transition-all"
                ondragover="window.onListinRouteDragOver(event)"
                ondrop="window.onListinRouteDrop(event, '${route.key}')"
              >
                <!-- Encabezado de la Ruta -->
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2 min-w-0">
                    <!-- Grip de Arrastre de Ruta -->
                    <div
                      draggable="true"
                      ondragstart="window.onListinRouteDragStart(event, '${route.key}')"
                      class="text-slate-400 hover:text-slate-700 cursor-grab active:cursor-grabbing p-0.5"
                      title="Arrastrar para mover ruta completa"
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"/></svg>
                    </div>

                    <input
                      type="checkbox"
                      ${!isExcluded ? 'checked' : ''}
                      onchange="window.toggleListinRoute('${route.key}', this.checked)"
                      class="w-4 h-4 rounded text-slate-900 focus:ring-slate-900 cursor-pointer"
                      title="Incluir / excluir ruta completa del listín"
                    />
                    <span class="w-6 h-6 rounded-md ${isFocused ? 'bg-indigo-600' : 'bg-slate-900'} text-white text-[10px] font-bold flex items-center justify-center shrink-0">
                      R${routeIdx + 1}
                    </span>
                    <div class="min-w-0">
                      <div class="flex items-center gap-1.5 flex-wrap">
                        <p class="text-xs font-black text-slate-900 truncate">${route.driverName}</p>
                        ${route.driverPlaca && route.driverPlaca !== 'NO ASIGNADA' ? `<span class="text-[9px] font-mono font-bold px-1.5 py-0.2 rounded bg-slate-200 text-slate-700">${route.driverPlaca}</span>` : ''}
                      </div>
                      <p class="text-[10px] text-slate-500 font-medium truncate">
                        <span class="font-bold text-indigo-700">${citiesTrail || 'Sin Ciudad'}</span>
                        <span>&bull;</span>
                        <span>${routeGuias.length} guías · ${totalPiezas} pzas${totalVol > 0 ? ` · ${totalVol.toFixed(2)} ft³` : ''}</span>
                      </p>
                    </div>
                  </div>

                  <div class="flex items-center gap-1 shrink-0">
                    <!-- Botón de Enfocar Esta Ruta -->
                    <button
                      type="button"
                      onclick="window.selectListinRoute('${route.key}')"
                      class="px-2 py-1 rounded-lg ${isFocused ? 'bg-indigo-600 text-white shadow-xs' : 'bg-white hover:bg-slate-200 text-slate-700 border border-slate-200'} text-[10px] font-bold transition-all cursor-pointer"
                      title="Ver y generar exclusivamente la hoja de esta ruta"
                    >
                      ${isFocused ? 'Hoja de Ruta Activa' : 'Ver Hoja de Ruta'}
                    </button>

                    <!-- Subir Prioridad de Ruta -->
                    <button
                      type="button"
                      onclick="window.moveListinRoute('${route.key}', -1)"
                      ${routeIdx === 0 ? 'disabled' : ''}
                      class="p-1 rounded-lg bg-white hover:bg-slate-200 border border-slate-200 text-slate-700 disabled:opacity-30 disabled:cursor-not-allowed transition-colors cursor-pointer"
                      title="Subir prioridad de ruta"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg>
                    </button>

                    <!-- Bajar Prioridad de Ruta -->
                    <button
                      type="button"
                      onclick="window.moveListinRoute('${route.key}', 1)"
                      ${routeIdx === allRoutes.length - 1 ? 'disabled' : ''}
                      class="p-1 rounded-lg bg-white hover:bg-slate-200 border border-slate-200 text-slate-700 disabled:opacity-30 disabled:cursor-not-allowed transition-colors cursor-pointer"
                      title="Bajar prioridad de ruta"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                    </button>

                    <!-- Expandir / Colapsar -->
                    <button
                      type="button"
                      onclick="window.toggleListinRouteCollapse('${route.key}')"
                      class="p-1 rounded-lg bg-white hover:bg-slate-200 border border-slate-200 text-slate-500 transition-colors cursor-pointer ml-0.5"
                      title="${isCollapsed ? 'Ver paradas' : 'Ocultar paradas'}"
                    >
                      <svg class="w-3.5 h-3.5 ${isCollapsed ? '' : 'rotate-180'} transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </button>
                  </div>
                </div>

                <!-- Lista secuencial de paradas de la ruta -->
                ${!isCollapsed ? `
                  <div class="space-y-1.5 pl-6 border-l-2 border-indigo-200 pt-1">
                    ${routeGuias.map((g, gIdx) => {
                      const isGuiaExcluded = listinExcludedGuiaIds.has(g.id_guia) || isExcluded;
                      const hasGps = Boolean(g.latitud && g.longitud);
                      const stopNumber = g.orden_ruta && g.orden_ruta > 0 ? g.orden_ruta : (gIdx + 1);

                      return `
                        <div
                          draggable="true"
                          ondragstart="window.onListinGuiaDragStart(event, '${g.id_guia}', '${route.key}')"
                          ondragend="window.onListinGuiaDragEnd(event)"
                          ondragover="window.onListinGuiaDragOver(event)"
                          ondrop="window.onListinGuiaDrop(event, '${g.id_guia}', '${route.key}')"
                          class="flex items-center justify-between py-1.5 px-2 rounded-lg bg-white border border-slate-200/80 shadow-2xs hover:border-slate-300 text-xs gap-2 transition-all"
                        >
                          <!-- Grip, Checkbox, Número de Parada, Guía, Destinatario y Ciudad -->
                          <div class="flex items-center gap-1.5 min-w-0">
                            <span class="text-slate-300 hover:text-slate-600 cursor-grab active:cursor-grabbing shrink-0" title="Arrastrar para secuenciar parada">
                              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9h8M8 15h8"/></svg>
                            </span>
                            <input
                              type="checkbox"
                              ${!isGuiaExcluded ? 'checked' : ''}
                              onchange="window.toggleListinGuia('${g.id_guia}', this.checked)"
                              class="w-3.5 h-3.5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer shrink-0"
                              title="Incluir / excluir parada del listín"
                            />
                            <span class="w-5 h-5 rounded-md bg-indigo-50 border border-indigo-200 text-indigo-700 font-mono font-black text-[10px] flex items-center justify-center shrink-0" title="Parada #${stopNumber}">
                              ${stopNumber}
                            </span>
                            <span class="font-mono font-bold text-slate-900 shrink-0">#${g.id_guia}</span>
                            <span class="text-[9px] font-bold uppercase px-1.5 py-0.2 rounded bg-slate-100 text-slate-700 border border-slate-200 shrink-0 truncate max-w-[80px]">${g.ciudad_destino || 'Sin Ciudad'}</span>
                            <span class="text-slate-600 truncate max-w-[100px] sm:max-w-[120px] font-medium" title="${g.destinatario}">${g.destinatario}</span>
                            ${hasGps ? '<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0" title="GPS Confirmado"></span>' : ''}
                          </div>

                          <!-- Piezas y Botones ▲ ▼ de Parada -->
                          <div class="flex items-center gap-1 shrink-0">
                            <span class="bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded font-mono font-bold text-[9px]">${g.piezas || 1} pz${(g.piezas || 1) !== 1 ? 's' : ''}${g.pies_cubicos ? ' · ' + Number(g.pies_cubicos).toFixed(2) + ' ft³' : ''}</span>
                            
                            <!-- Subir Parada -->
                            <button
                              type="button"
                              onclick="window.moveListinRouteGuia('${route.key}', '${g.id_guia}', -1)"
                              ${gIdx === 0 ? 'disabled' : ''}
                              class="p-1 rounded-md bg-slate-50 hover:bg-slate-200 text-slate-700 border border-slate-200 disabled:opacity-25 disabled:cursor-not-allowed transition-all cursor-pointer"
                              title="Subir esta parada en la ruta"
                            >
                              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg>
                            </button>

                            <!-- Bajar Parada -->
                            <button
                              type="button"
                              onclick="window.moveListinRouteGuia('${route.key}', '${g.id_guia}', 1)"
                              ${gIdx === routeGuias.length - 1 ? 'disabled' : ''}
                              class="p-1 rounded-md bg-slate-50 hover:bg-slate-200 text-slate-700 border border-slate-200 disabled:opacity-25 disabled:cursor-not-allowed transition-all cursor-pointer"
                              title="Bajar esta parada en la ruta"
                            >
                              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                            </button>
                          </div>
                        </div>
                      `;
                    }).join('')}
                  </div>
                ` : ''}
              </div>
            `;
          }).join('');

        // ==========================================
        // MODO 2: AGRUPADO POR ZONAS (Jerárquico)
        // ==========================================
        } else if (listinViewSubMode === 'zones') {
          const displayCities = listinSelectedZones.size > 0 
            ? listinCitiesOrder.filter(c => listinSelectedZones.has(c)) 
            : listinCitiesOrder;

          listinHierarchyList.innerHTML = displayCities.map((cityName, cityIdx) => {
            const rawGuiaIds = listinCityGuiasOrder[cityName] || [];
            let cityGuias = rawGuiaIds.map(id => mapById.get(id)).filter(Boolean) as GuiaRow[];

            // Filtro de búsqueda
            if (query) {
              const matchesCity = cityName.toLowerCase().includes(query);
              if (!matchesCity) {
                cityGuias = cityGuias.filter(g => 
                  g.id_guia.toLowerCase().includes(query) || 
                  (g.destinatario || '').toLowerCase().includes(query)
                );
                if (cityGuias.length === 0) return '';
              }
            }

            const totalPiezas = cityGuias.reduce((acc, g) => acc + (g.piezas || 1), 0);
            const totalVol = cityGuias.reduce((acc, g) => acc + (Number(g.pies_cubicos) || 0), 0);
            const isExcluded = listinExcludedCities.has(cityName);
            const isCollapsed = listinCollapsedCities.has(cityName) && listinActiveZone === 'ALL';
            const isFocused = listinActiveZone === cityName;

            return `
              <div
                class="bg-slate-50 border ${isFocused ? 'border-indigo-400 ring-2 ring-indigo-500/20 bg-indigo-50/10' : (isExcluded ? 'border-slate-200 opacity-60' : 'border-slate-200/90')} rounded-xl p-3 space-y-2.5 transition-all"
                ondragover="window.onListinZoneDragOver(event)"
                ondrop="window.onListinZoneDrop(event, '${cityName.replace(/'/g, "\\'")}')"
              >
                <!-- Encabezado de la Zona -->
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2 min-w-0">
                    <!-- Grip de Arrastre de Zona -->
                    <div
                      draggable="true"
                      ondragstart="window.onListinZoneDragStart(event, '${cityName.replace(/'/g, "\\'")}')"
                      class="text-slate-400 hover:text-slate-700 cursor-grab active:cursor-grabbing p-0.5"
                      title="Arrastrar para mover zona completa"
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"/></svg>
                    </div>

                    <input
                      type="checkbox"
                      ${!isExcluded ? 'checked' : ''}
                      onchange="window.toggleListinCity('${cityName.replace(/'/g, "\\'")}', this.checked)"
                      class="w-4 h-4 rounded text-slate-900 focus:ring-slate-900 cursor-pointer"
                      title="Incluir / excluir zona completa del listín"
                    />
                    <span class="w-5 h-5 rounded-md ${isFocused ? 'bg-indigo-600' : 'bg-slate-900'} text-white text-[10px] font-bold flex items-center justify-center shrink-0">
                      ${cityIdx + 1}
                    </span>
                    <div class="min-w-0">
                      <p class="text-xs font-bold text-slate-900 truncate">${cityName}</p>
                      <p class="text-[10px] text-slate-500 font-medium">${cityGuias.length} guía${cityGuias.length !== 1 ? 's' : ''} &bull; ${totalPiezas} pieza${totalPiezas !== 1 ? 's' : ''}${totalVol > 0 ? ' &bull; ' + totalVol.toFixed(2) + ' ft³' : ''}</p>
                    </div>
                  </div>

                  <div class="flex items-center gap-1 shrink-0">
                    <!-- Botón de Enfocar Esta Zona -->
                    <button
                      type="button"
                      onclick="window.selectListinZone('${cityName.replace(/'/g, "\\'")}')"
                      class="px-2 py-1 rounded-lg ${isFocused ? 'bg-indigo-600 text-white' : 'bg-white hover:bg-slate-200 text-slate-700 border border-slate-200'} text-[10px] font-bold transition-all cursor-pointer"
                      title="Ver y editar exclusivamente la hoja de esta zona"
                    >
                      ${isFocused ? 'Hoja Activa' : 'Ver Hoja'}
                    </button>

                    <!-- Subir Prioridad de Zona -->
                    <button
                      type="button"
                      onclick="window.moveListinCity('${cityName.replace(/'/g, "\\'")}', -1)"
                      ${cityIdx === 0 ? 'disabled' : ''}
                      class="p-1 rounded-lg bg-white hover:bg-slate-200 border border-slate-200 text-slate-700 disabled:opacity-30 disabled:cursor-not-allowed transition-colors cursor-pointer"
                      title="Subir prioridad de zona"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg>
                    </button>

                    <!-- Bajar Prioridad de Zona -->
                    <button
                      type="button"
                      onclick="window.moveListinCity('${cityName.replace(/'/g, "\\'")}', 1)"
                      ${cityIdx === listinCitiesOrder.length - 1 ? 'disabled' : ''}
                      class="p-1 rounded-lg bg-white hover:bg-slate-200 border border-slate-200 text-slate-700 disabled:opacity-30 disabled:cursor-not-allowed transition-colors cursor-pointer"
                      title="Bajar prioridad de zona"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                    </button>

                    <!-- Expandir / Colapsar -->
                    <button
                      type="button"
                      onclick="window.toggleListinCollapse('${cityName.replace(/'/g, "\\'")}')"
                      class="p-1 rounded-lg bg-white hover:bg-slate-200 border border-slate-200 text-slate-500 transition-colors cursor-pointer ml-0.5"
                      title="${isCollapsed ? 'Ver guías' : 'Ocultar guías'}"
                    >
                      <svg class="w-3.5 h-3.5 ${isCollapsed ? '' : 'rotate-180'} transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </button>
                  </div>
                </div>

                <!-- Lista interna de guías con controles de reordenación individual -->
                ${!isCollapsed ? `
                  <div class="space-y-1.5 pl-6 border-l-2 border-slate-200 pt-1">
                    ${cityGuias.map((g, gIdx) => {
                      const isGuiaExcluded = listinExcludedGuiaIds.has(g.id_guia) || isExcluded;
                      return `
                        <div
                          draggable="true"
                          ondragstart="window.onListinGuiaDragStart(event, '${g.id_guia}', '${cityName.replace(/'/g, "\\'")}')"
                          ondragend="window.onListinGuiaDragEnd(event)"
                          ondragover="window.onListinGuiaDragOver(event)"
                          ondrop="window.onListinGuiaDrop(event, '${g.id_guia}', '${cityName.replace(/'/g, "\\'")}')"
                          class="flex items-center justify-between py-1.5 px-2 rounded-lg bg-white border border-slate-200/80 shadow-2xs hover:border-slate-300 text-xs gap-2 transition-all"
                        >
                          <!-- Grip, Checkbox, Posición, Guía y Destinatario -->
                          <div class="flex items-center gap-1.5 min-w-0">
                            <span class="text-slate-300 hover:text-slate-600 cursor-grab active:cursor-grabbing shrink-0" title="Arrastrar para reordenar guía">
                              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9h8M8 15h8"/></svg>
                            </span>
                            <input
                              type="checkbox"
                              ${!isGuiaExcluded ? 'checked' : ''}
                              onchange="window.toggleListinGuia('${g.id_guia}', this.checked)"
                              class="w-3.5 h-3.5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer shrink-0"
                              title="Incluir / excluir guía del listín"
                            />
                            <span class="w-4 h-4 rounded bg-slate-100 text-slate-600 font-mono font-bold text-[9px] flex items-center justify-center shrink-0">
                              ${gIdx + 1}
                            </span>
                            <span class="font-mono font-bold text-slate-900 shrink-0">#${g.id_guia}</span>
                            <span class="text-slate-600 truncate max-w-[110px] sm:max-w-[130px] font-medium" title="${g.destinatario}">${g.destinatario}</span>
                          </div>

                          <!-- Piezas y Botones ▲ ▼ de Guía -->
                          <div class="flex items-center gap-1 shrink-0">
                            <span class="bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded font-mono font-bold text-[9px]">${g.piezas || 1} pza${(g.piezas || 1) !== 1 ? 's' : ''}${g.pies_cubicos ? ' · ' + Number(g.pies_cubicos).toFixed(2) + ' ft³' : ''}</span>
                            
                            <!-- Subir Guía -->
                            <button
                              type="button"
                              onclick="window.moveListinGuia('${cityName.replace(/'/g, "\\'")}', '${g.id_guia}', -1)"
                              ${gIdx === 0 ? 'disabled' : ''}
                              class="p-1 rounded-md bg-slate-50 hover:bg-slate-200 text-slate-700 border border-slate-200 disabled:opacity-25 disabled:cursor-not-allowed transition-all cursor-pointer"
                              title="Subir esta guía en el orden de entrega"
                            >
                              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg>
                            </button>

                            <!-- Bajar Guía -->
                            <button
                              type="button"
                              onclick="window.moveListinGuia('${cityName.replace(/'/g, "\\'")}', '${g.id_guia}', 1)"
                              ${gIdx === cityGuias.length - 1 ? 'disabled' : ''}
                              class="p-1 rounded-md bg-slate-50 hover:bg-slate-200 text-slate-700 border border-slate-200 disabled:opacity-25 disabled:cursor-not-allowed transition-all cursor-pointer"
                              title="Bajar esta guía en el orden de entrega"
                            >
                              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                            </button>
                          </div>
                        </div>
                      `;
                    }).join('')}
                  </div>
                ` : ''}
              </div>
            `;
          }).join('');

        // ==========================================
        // MODO 3: LISTA CONTINUA (1..N)
        // ==========================================
        } else {
          let flatGuias = listinFlatGuiasOrder.map(id => mapById.get(id)).filter(Boolean) as GuiaRow[];

          if (query) {
            flatGuias = flatGuias.filter(g => 
              g.id_guia.toLowerCase().includes(query) || 
              (g.destinatario || '').toLowerCase().includes(query) ||
              (g.ciudad_destino || '').toLowerCase().includes(query)
            );
          }

          listinHierarchyList.innerHTML = `
            <div class="space-y-1.5">
              ${flatGuias.map((g, idx) => {
                const isGuiaExcluded = listinExcludedGuiaIds.has(g.id_guia) || listinExcludedCities.has((g.ciudad_destino || '').trim());
                return `
                  <div
                    draggable="true"
                    ondragstart="window.onListinGuiaDragStart(event, '${g.id_guia}', '')"
                    ondragend="window.onListinGuiaDragEnd(event)"
                    ondragover="window.onListinGuiaDragOver(event)"
                    ondrop="window.onListinGuiaDrop(event, '${g.id_guia}', '')"
                    class="flex items-center justify-between py-2 px-2.5 rounded-xl bg-white border border-slate-200/90 shadow-2xs hover:border-slate-300 text-xs gap-2 transition-all"
                  >
                    <div class="flex items-center gap-2 min-w-0">
                      <span class="text-slate-300 hover:text-slate-600 cursor-grab active:cursor-grabbing shrink-0" title="Arrastrar para mover posición">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9h8M8 15h8"/></svg>
                      </span>
                      <input
                        type="checkbox"
                        ${!isGuiaExcluded ? 'checked' : ''}
                        onchange="window.toggleListinGuia('${g.id_guia}', this.checked)"
                        class="w-3.5 h-3.5 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer shrink-0"
                      />
                      <span class="w-5 h-5 rounded-md bg-slate-900 text-white font-mono font-bold text-[10px] flex items-center justify-center shrink-0">
                        ${idx + 1}
                      </span>
                      <div class="min-w-0">
                        <div class="flex items-center gap-1.5">
                          <span class="font-mono font-bold text-slate-900">#${g.id_guia}</span>
                          <span class="text-[10px] font-bold px-1.5 py-0.2 rounded bg-slate-100 text-slate-700 border border-slate-200 uppercase">${g.ciudad_destino || 'Sin Ciudad'}</span>
                        </div>
                        <p class="text-[11px] text-slate-500 truncate max-w-[150px] sm:max-w-[200px]">${g.destinatario}</p>
                      </div>
                    </div>

                    <div class="flex items-center gap-1 shrink-0">
                      <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded font-mono font-bold text-[10px]">${g.piezas || 1} pza${(g.piezas || 1) !== 1 ? 's' : ''}${g.pies_cubicos ? ' · ' + Number(g.pies_cubicos).toFixed(2) + ' ft³' : ''}</span>
                      
                      <!-- Subir Guía Plana -->
                      <button
                        type="button"
                        onclick="window.moveListinFlatGuia('${g.id_guia}', -1)"
                        ${idx === 0 ? 'disabled' : ''}
                        class="p-1 rounded-lg bg-slate-50 hover:bg-slate-200 text-slate-700 border border-slate-200 disabled:opacity-25 disabled:cursor-not-allowed transition-all cursor-pointer"
                        title="Subir esta guía"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg>
                      </button>

                      <!-- Bajar Guía Plana -->
                      <button
                        type="button"
                        onclick="window.moveListinFlatGuia('${g.id_guia}', 1)"
                        ${idx === flatGuias.length - 1 ? 'disabled' : ''}
                        class="p-1 rounded-lg bg-slate-50 hover:bg-slate-200 text-slate-700 border border-slate-200 disabled:opacity-25 disabled:cursor-not-allowed transition-all cursor-pointer"
                        title="Bajar esta guía"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                      </button>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          `;
        }
      }

      function renderListinPrintPreview(srcShipments: GuiaRow[]) {
        // Metadatos
        const selectedDriverOption = listinDriverSelect?.options[listinDriverSelect.selectedIndex];
        let driverName = selectedDriverOption && listinDriverSelect.value !== 'ALL' 
          ? selectedDriverOption.text.replace(/\s*\(ID:.*?\)\s*/g, '') 
          : 'FLOTA CENTRAL / DESPACHO GENERAL';
        let placa = listinPlacaInput?.value?.trim()?.toUpperCase() || 'NO ASIGNADA';
        const fecha = listinFechaInput?.value || new Date().toISOString().split('T')[0];

        // Si hay una ruta activa específica seleccionada, auto-asignar su chofer y placa si aplica
        if (listinActiveRoute !== 'ALL') {
          const routes = getListinRoutes(srcShipments);
          const activeRouteObj = routes.find(r => r.key === listinActiveRoute);
          if (activeRouteObj) {
            driverName = activeRouteObj.driverName;
            if (activeRouteObj.driverPlaca && activeRouteObj.driverPlaca !== 'NO ASIGNADA') {
              placa = activeRouteObj.driverPlaca;
            }
          }
        }

        if (previewListinFecha) previewListinFecha.textContent = fecha;
        if (previewListinPlaca) previewListinPlaca.textContent = placa;
        if (previewListinChofer) previewListinChofer.textContent = driverName;

        // Construir array de guías respetando la ruta o zona activa y el orden exacto configurado
        const orderedActiveGuias = getOrderedActiveGuias(srcShipments);

        const totalGuias = orderedActiveGuias.length;
        const totalPiezas = orderedActiveGuias.reduce((acc, g) => acc + (g.piezas || 1), 0);
        const totalVolumen = orderedActiveGuias.reduce((acc, g) => acc + (Number(g.pies_cubicos) || 0), 0);
        const uniqueActiveCities = new Set(orderedActiveGuias.map(g => (g.ciudad_destino || '').trim())).size;

        if (previewTotalGuias) previewTotalGuias.textContent = totalGuias.toString();
        if (previewTotalPiezas) previewTotalPiezas.textContent = totalPiezas.toString();
        if (previewTotalVolumen) previewTotalVolumen.textContent = totalVolumen.toFixed(2) + ' ft³';
        if (previewTotalCiudades) previewTotalCiudades.textContent = uniqueActiveCities.toString();

        const volTagBanner = totalVolumen > 0 ? `, ${totalVolumen.toFixed(2)} FT³` : '';

        // Actualizar Encabezado de Destino en la Hoja Física Oficial
        if (listinActiveRoute !== 'ALL') {
          const routes = getListinRoutes(srcShipments);
          const activeRouteObj = routes.find(r => r.key === listinActiveRoute);
          const rCities = activeRouteObj ? activeRouteObj.cities.join(' · ').toUpperCase() : 'RUTA ESPECÍFICA';
          if (previewListinDestino) previewListinDestino.textContent = rCities;
          if (previewListinTitleZona) previewListinTitleZona.textContent = `RUTA: ${driverName.toUpperCase()} • ${rCities} (${totalGuias} GUÍAS, ${totalPiezas} PZAS${volTagBanner})`;
          if (previewListinCurrentBadge) previewListinCurrentBadge.textContent = `RUTA: ${driverName.toUpperCase()}`;
        } else if (listinSelectedZones.size === 0) {
          if (previewListinDestino) previewListinDestino.textContent = 'TODAS (CONSOLIDADO)';
          if (previewListinTitleZona) previewListinTitleZona.textContent = `DESTINO: TODAS LAS RUTAS / ZONAS (${totalGuias} GUÍAS, ${totalPiezas} PZAS${volTagBanner})`;
          if (previewListinCurrentBadge) previewListinCurrentBadge.textContent = `CONSOLIDADO (${uniqueActiveCities} CIUDADES)`;
        } else if (listinSelectedZones.size === 1) {
          const zName = Array.from(listinSelectedZones)[0];
          if (previewListinDestino) previewListinDestino.textContent = zName;
          if (previewListinTitleZona) previewListinTitleZona.textContent = `DESTINO: ${zName.toUpperCase()} (${totalGuias} GUÍAS, ${totalPiezas} PZAS${volTagBanner})`;
          if (previewListinCurrentBadge) previewListinCurrentBadge.textContent = `ZONA: ${zName}`;
        } else {
          const combinedNames = listinCitiesOrder.filter(c => listinSelectedZones.has(c)).join(' · ').toUpperCase();
          if (previewListinDestino) previewListinDestino.textContent = combinedNames;
          if (previewListinTitleZona) previewListinTitleZona.textContent = `DESTINO: ${combinedNames} (${totalGuias} GUÍAS, ${totalPiezas} PZAS${volTagBanner})`;
          if (previewListinCurrentBadge) previewListinCurrentBadge.textContent = `ZONAS COMBINADAS (${listinSelectedZones.size})`;
        }

        // Calcular filas del formato dual: distribuir equitativamente entre columna izquierda y derecha
        const half = Math.ceil(orderedActiveGuias.length / 2);
        const leftGuias = orderedActiveGuias.slice(0, half);
        const rightGuias = orderedActiveGuias.slice(half);
        const rowCount = Math.max(half, 20);

        let tableHtml = '';
        for (let i = 0; i < rowCount; i++) {
          const left = leftGuias[i];
          const right = rightGuias[i];

          const leftVol = left && left.pies_cubicos ? Number(left.pies_cubicos).toFixed(2) : (left ? '-' : '');
          const rightVol = right && right.pies_cubicos ? Number(right.pies_cubicos).toFixed(2) : (right ? '-' : '');

          tableHtml += `
            <tr style="height: 25px;" class="border-b border-black text-black">
              <!-- Bloque Izquierdo -->
              <td class="py-0.5 px-1 border-r border-black font-mono font-bold text-center text-[11px]">${left ? left.id_guia : '&nbsp;'}</td>
              <td class="py-0.5 px-0.5 border-r border-black text-center font-bold text-[11px]">${left ? (left.piezas || 1) : '&nbsp;'}</td>
              <td class="py-0.5 px-0.5 border-r border-black text-center font-mono font-bold text-[10px] text-slate-800">${left ? leftVol : '&nbsp;'}</td>
              <td class="py-0.5 px-1.5 border-r-2 border-black font-bold uppercase truncate max-w-[130px] text-[11px]">${left ? left.ciudad_destino : '&nbsp;'}</td>
              <!-- Bloque Derecho -->
              <td class="py-0.5 px-1 border-r border-black font-mono font-bold text-center text-[11px]">${right ? right.id_guia : '&nbsp;'}</td>
              <td class="py-0.5 px-0.5 border-r border-black text-center font-bold text-[11px]">${right ? (right.piezas || 1) : '&nbsp;'}</td>
              <td class="py-0.5 px-0.5 border-r border-black text-center font-mono font-bold text-[10px] text-slate-800">${right ? rightVol : '&nbsp;'}</td>
              <td class="py-0.5 px-1.5 font-bold uppercase truncate max-w-[130px] text-[11px]">${right ? right.ciudad_destino : '&nbsp;'}</td>
            </tr>
          `;
        }

        if (previewListinTbody) {
          previewListinTbody.innerHTML = tableHtml;
        }
      }

      // ==========================================
      // FUNCIONES GLOBALES DE REORDENACIÓN Y RUTAS
      // ==========================================

      // 0. Toggle de tipo de filtro: Rutas vs Zonas
      (window as any).setListinFilterType = (type: 'routes' | 'zones') => {
        listinFilterType = type;
        listinViewSubMode = type === 'routes' ? 'routes' : 'zones';
        renderListinView();
      };

      // 0.1 Selección de Ruta
      (window as any).selectListinRoute = (routeKey: string) => {
        listinActiveRoute = routeKey;
        if (routeKey !== 'ALL') {
          listinSelectedZones.clear();
          const srcShipments = getListinSourceShipments();
          const routes = getListinRoutes(srcShipments);
          const rObj = routes.find(r => r.key === routeKey);
          if (rObj && rObj.driverId !== null && listinDriverSelect) {
            listinDriverSelect.value = String(rObj.driverId);
          }
        }
        renderListinView();
      };

      // 0.2 Excluir / Incluir Ruta
      (window as any).toggleListinRoute = (routeKey: string, isIncluded: boolean) => {
        if (isIncluded) {
          listinExcludedRoutes.delete(routeKey);
        } else {
          listinExcludedRoutes.add(routeKey);
        }
        renderListinView();
      };

      // 0.3 Colapsar / Expandir Ruta
      (window as any).toggleListinRouteCollapse = (routeKey: string) => {
        if (listinCollapsedRoutes.has(routeKey)) {
          listinCollapsedRoutes.delete(routeKey);
        } else {
          listinCollapsedRoutes.add(routeKey);
        }
        renderListinView();
      };

      // 0.4 Mover Ruta Completa
      (window as any).moveListinRoute = (routeKey: string, direction: number) => {
        const idx = listinRoutesOrder.indexOf(routeKey);
        if (idx === -1) return;
        const newIdx = idx + direction;
        if (newIdx < 0 || newIdx >= listinRoutesOrder.length) return;
        const temp = listinRoutesOrder[idx];
        listinRoutesOrder[idx] = listinRoutesOrder[newIdx];
        listinRoutesOrder[newIdx] = temp;
        syncFlatFromRoutesOrZones();
        renderListinView();
      };

      // 0.5 Mover Guía dentro de una Ruta
      (window as any).moveListinRouteGuia = (routeKey: string, guiaId: string, direction: number) => {
        const arr = listinRouteGuiasOrder[routeKey];
        if (!arr) return;
        const idx = arr.indexOf(guiaId);
        if (idx === -1) return;
        const newIdx = idx + direction;
        if (newIdx < 0 || newIdx >= arr.length) return;
        const temp = arr[idx];
        arr[idx] = arr[newIdx];
        arr[newIdx] = temp;
        syncFlatFromRoutesOrZones();
        renderListinView();
      };

      // 0.6 Drag & Drop de Rutas
      (window as any).onListinRouteDragStart = (e: DragEvent, routeKey: string) => {
        draggedRouteKey = routeKey;
        if (e.dataTransfer) {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', routeKey);
        }
      };

      (window as any).onListinRouteDragOver = (e: DragEvent) => {
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
      };

      (window as any).onListinRouteDrop = (e: DragEvent, targetRouteKey: string) => {
        e.preventDefault();
        e.stopPropagation();
        if (!draggedRouteKey || draggedRouteKey === targetRouteKey) return;
        const fromIdx = listinRoutesOrder.indexOf(draggedRouteKey);
        const toIdx = listinRoutesOrder.indexOf(targetRouteKey);
        if (fromIdx !== -1 && toIdx !== -1) {
          listinRoutesOrder.splice(fromIdx, 1);
          listinRoutesOrder.splice(toIdx, 0, draggedRouteKey);
        }
        syncFlatFromRoutesOrZones();
        draggedRouteKey = null;
        renderListinView();
      };

      // 0.7 Toggle y Selección de Zonas
      (window as any).toggleListinZone = (zoneName: string) => {
        listinActiveRoute = 'ALL';
        if (zoneName === 'ALL') {
          listinSelectedZones.clear();
          listinActiveZone = 'ALL';
        } else {
          if (listinSelectedZones.has(zoneName)) {
            listinSelectedZones.delete(zoneName);
          } else {
            listinSelectedZones.add(zoneName);
          }
          if (listinSelectedZones.size === 0) listinActiveZone = 'ALL';
          else if (listinSelectedZones.size === 1) listinActiveZone = Array.from(listinSelectedZones)[0];
          else listinActiveZone = 'COMBINED';
        }
        renderListinView();
      };

      (window as any).clearListinZones = () => {
        listinActiveRoute = 'ALL';
        listinSelectedZones.clear();
        listinActiveZone = 'ALL';
        renderListinView();
      };

      (window as any).selectListinZone = (zoneName: string) => {
        listinActiveRoute = 'ALL';
        if (zoneName === 'ALL') {
          listinSelectedZones.clear();
          listinActiveZone = 'ALL';
        } else if (zoneName !== 'COMBINED') {
          listinSelectedZones.clear();
          listinSelectedZones.add(zoneName);
          listinActiveZone = zoneName;
        }
        renderListinView();
      };

      // 1. Mover Guía dentro de una Zona
      (window as any).moveListinGuia = (cityName: string, guiaId: string, direction: number) => {
        const arr = listinCityGuiasOrder[cityName];
        if (!arr) return;
        const idx = arr.indexOf(guiaId);
        if (idx === -1) return;
        const newIdx = idx + direction;
        if (newIdx < 0 || newIdx >= arr.length) return;
        const temp = arr[idx];
        arr[idx] = arr[newIdx];
        arr[newIdx] = temp;
        syncFlatFromRoutesOrZones();
        renderListinView();
      };

      // 2. Mover Guía en Vista Plana Continua (1..N)
      (window as any).moveListinFlatGuia = (guiaId: string, direction: number) => {
        const idx = listinFlatGuiasOrder.indexOf(guiaId);
        if (idx === -1) return;
        const newIdx = idx + direction;
        if (newIdx < 0 || newIdx >= listinFlatGuiasOrder.length) return;
        const temp = listinFlatGuiasOrder[idx];
        listinFlatGuiasOrder[idx] = listinFlatGuiasOrder[newIdx];
        listinFlatGuiasOrder[newIdx] = temp;
        renderListinView();
      };

      // 3. Mover Zona Completa
      (window as any).moveListinCity = (cityName: string, direction: number) => {
        const idx = listinCitiesOrder.indexOf(cityName);
        if (idx === -1) return;
        const newIdx = idx + direction;
        if (newIdx < 0 || newIdx >= listinCitiesOrder.length) return;
        const temp = listinCitiesOrder[idx];
        listinCitiesOrder[idx] = listinCitiesOrder[newIdx];
        listinCitiesOrder[newIdx] = temp;
        syncFlatFromRoutesOrZones();
        renderListinView();
      };

      // 4. Drag & Drop de Guías
      (window as any).onListinGuiaDragStart = (e: DragEvent, guiaId: string, parentKey: string) => {
        draggedGuiaId = guiaId;
        draggedCityName = parentKey;
        if (e.dataTransfer) {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', guiaId);
        }
        const el = (e.currentTarget || e.target) as HTMLElement;
        el?.classList.add('opacity-40');
      };

      (window as any).onListinGuiaDragEnd = (e: DragEvent) => {
        const el = (e.currentTarget || e.target) as HTMLElement;
        el?.classList.remove('opacity-40');
      };

      (window as any).onListinGuiaDragOver = (e: DragEvent) => {
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
      };

      (window as any).onListinGuiaDrop = (e: DragEvent, targetGuiaId: string, targetParentKey: string) => {
        e.preventDefault();
        e.stopPropagation();
        if (!draggedGuiaId || draggedGuiaId === targetGuiaId) return;

        if (listinViewSubMode === 'routes') {
          if (draggedCityName === targetParentKey) {
            const arr = listinRouteGuiasOrder[targetParentKey];
            if (arr) {
              const fromIdx = arr.indexOf(draggedGuiaId);
              const toIdx = arr.indexOf(targetGuiaId);
              if (fromIdx !== -1 && toIdx !== -1) {
                arr.splice(fromIdx, 1);
                arr.splice(toIdx, 0, draggedGuiaId);
              }
            }
          }
          syncFlatFromRoutesOrZones();
        } else if (listinViewSubMode === 'zones') {
          if (draggedCityName === targetParentKey) {
            const arr = listinCityGuiasOrder[targetParentKey];
            if (arr) {
              const fromIdx = arr.indexOf(draggedGuiaId);
              const toIdx = arr.indexOf(targetGuiaId);
              if (fromIdx !== -1 && toIdx !== -1) {
                arr.splice(fromIdx, 1);
                arr.splice(toIdx, 0, draggedGuiaId);
              }
            }
          } else if (draggedCityName) {
            const srcArr = listinCityGuiasOrder[draggedCityName];
            const destArr = listinCityGuiasOrder[targetParentKey];
            if (srcArr && destArr) {
              const fromIdx = srcArr.indexOf(draggedGuiaId);
              if (fromIdx !== -1) srcArr.splice(fromIdx, 1);
              const toIdx = destArr.indexOf(targetGuiaId);
              if (toIdx !== -1) destArr.splice(toIdx, 0, draggedGuiaId);
              else destArr.push(draggedGuiaId);
            }
          }
          syncFlatFromRoutesOrZones();
        } else {
          const fromIdx = listinFlatGuiasOrder.indexOf(draggedGuiaId);
          const toIdx = listinFlatGuiasOrder.indexOf(targetGuiaId);
          if (fromIdx !== -1 && toIdx !== -1) {
            listinFlatGuiasOrder.splice(fromIdx, 1);
            listinFlatGuiasOrder.splice(toIdx, 0, draggedGuiaId);
          }
        }

        draggedGuiaId = null;
        draggedCityName = null;
        renderListinView();
      };

      // 5. Drag & Drop de Zonas
      (window as any).onListinZoneDragStart = (e: DragEvent, cityName: string) => {
        draggedZoneName = cityName;
        if (e.dataTransfer) {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', cityName);
        }
      };

      (window as any).onListinZoneDragOver = (e: DragEvent) => {
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
      };

      (window as any).onListinZoneDrop = (e: DragEvent, targetCityName: string) => {
        e.preventDefault();
        e.stopPropagation();
        if (!draggedZoneName || draggedZoneName === targetCityName) return;
        const fromIdx = listinCitiesOrder.indexOf(draggedZoneName);
        const toIdx = listinCitiesOrder.indexOf(targetCityName);
        if (fromIdx !== -1 && toIdx !== -1) {
          listinCitiesOrder.splice(fromIdx, 1);
          listinCitiesOrder.splice(toIdx, 0, draggedZoneName);
        }
        syncFlatFromRoutesOrZones();
        draggedZoneName = null;
        renderListinView();
      };

      // 6. Excluir / Incluir y Colapsar
      (window as any).toggleListinCity = (cityName: string, isIncluded: boolean) => {
        if (isIncluded) {
          listinExcludedCities.delete(cityName);
        } else {
          listinExcludedCities.add(cityName);
        }
        renderListinView();
      };

      (window as any).toggleListinGuia = (guiaId: string, isIncluded: boolean) => {
        if (isIncluded) {
          listinExcludedGuiaIds.delete(guiaId);
        } else {
          listinExcludedGuiaIds.add(guiaId);
        }
        renderListinView();
      };

      (window as any).toggleListinCollapse = (cityName: string) => {
        if (listinCollapsedCities.has(cityName)) {
          listinCollapsedCities.delete(cityName);
        } else {
          listinCollapsedCities.add(cityName);
        }
        renderListinView();
      };

      // 7. Ordenar por Ruta Satelital (TSP / orden_ruta)
      (window as any).orderListinByTSP = () => {
        const srcShipments = getListinSourceShipments();
        const hubCoords = { lat: 10.0808, lon: -69.3756 }; // Hub Central Barquisimeto

        // Ordenar internamente cada ruta
        Object.keys(listinRouteGuiasOrder).forEach(rKey => {
          const gIds = listinRouteGuiasOrder[rKey] || [];
          const gObjs = gIds.map(id => srcShipments.find(g => g.id_guia === id)).filter(Boolean) as GuiaRow[];

          // Si tienen orden_ruta > 0, ordenar por orden_ruta; de lo contrario por cercanía GPS al Hub
          gObjs.sort((a, b) => {
            const ordA = (a.orden_ruta && a.orden_ruta > 0) ? a.orden_ruta : 9999;
            const ordB = (b.orden_ruta && b.orden_ruta > 0) ? b.orden_ruta : 9999;
            if (ordA !== 9999 || ordB !== 9999) return ordA - ordB;

            const latA = a.latitud ? Number(a.latitud) : hubCoords.lat;
            const lonA = a.longitud ? Number(a.longitud) : hubCoords.lon;
            const latB = b.latitud ? Number(b.latitud) : hubCoords.lat;
            const lonB = b.longitud ? Number(b.longitud) : hubCoords.lon;
            const distA = calculateDistance(hubCoords.lat, hubCoords.lon, latA, lonA);
            const distB = calculateDistance(hubCoords.lat, hubCoords.lon, latB, lonB);
            return distA - distB;
          });

          listinRouteGuiasOrder[rKey] = gObjs.map(g => g.id_guia);
        });

        // Ordenar también internamente cada ciudad por cercanía o orden_ruta
        Object.keys(listinCityGuiasOrder).forEach(city => {
          const gIds = listinCityGuiasOrder[city] || [];
          const gObjs = gIds.map(id => srcShipments.find(g => g.id_guia === id)).filter(Boolean) as GuiaRow[];
          gObjs.sort((a, b) => {
            const ordA = (a.orden_ruta && a.orden_ruta > 0) ? a.orden_ruta : 9999;
            const ordB = (b.orden_ruta && b.orden_ruta > 0) ? b.orden_ruta : 9999;
            if (ordA !== 9999 || ordB !== 9999) return ordA - ordB;
            return a.id_guia.localeCompare(b.id_guia, undefined, { numeric: true });
          });
          listinCityGuiasOrder[city] = gObjs.map(g => g.id_guia);
        });

        syncFlatFromRoutesOrZones();
        showToast('Listín organizado según la secuencia de ruta satelital (TSP)', 'success');
        renderListinView();
      };

      // Listeners de Cambios de Filtros y Configuración
      const listinLoteSelect = document.getElementById('listin-lote-select') as HTMLSelectElement;
      listinLoteSelect?.addEventListener('change', () => {
        const listinLoteCountBadge = document.getElementById('listin-lote-count-badge');
        if (listinLoteCountBadge) {
          const srcShipments = getListinSourceShipments();
          listinLoteCountBadge.textContent = `${srcShipments.length} guías`;
        }
        renderListinView();
      });

      listinDriverSelect?.addEventListener('change', () => {
        const val = listinDriverSelect.value;
        if (val !== 'ALL') {
          listinActiveRoute = `driver-${val}`;
        } else {
          listinActiveRoute = 'ALL';
        }
        renderListinView();
      });
      listinPlacaInput?.addEventListener('input', () => {
        if (previewListinPlaca) {
          previewListinPlaca.textContent = listinPlacaInput.value.trim().toUpperCase() || 'NO ASIGNADA';
        }
      });
      listinFechaInput?.addEventListener('change', () => {
        if (previewListinFecha) {
          previewListinFecha.textContent = listinFechaInput.value || '';
        }
      });

      // Selector de Zona o Ruta por Dropdown
      listinZoneSelect?.addEventListener('change', () => {
        const val = listinZoneSelect.value || 'ALL';
        if (listinFilterType === 'routes') {
          listinActiveRoute = val;
        } else {
          listinActiveRoute = 'ALL';
          if (val === 'ALL') {
            listinSelectedZones.clear();
          } else if (val !== 'COMBINED') {
            listinSelectedZones.clear();
            listinSelectedZones.add(val);
          }
        }
        renderListinView();
      });

      // Navegación Anterior / Siguiente Zona
      btnListinPrevZone?.addEventListener('click', () => {
        if (listinCitiesOrder.length === 0) return;
        if (listinActiveZone === 'ALL') {
          listinActiveZone = listinCitiesOrder[listinCitiesOrder.length - 1];
        } else {
          const currIdx = listinCitiesOrder.indexOf(listinActiveZone);
          if (currIdx <= 0) {
            listinActiveZone = 'ALL';
          } else {
            listinActiveZone = listinCitiesOrder[currIdx - 1];
          }
        }
        renderListinView();
      });

      btnListinNextZone?.addEventListener('click', () => {
        if (listinCitiesOrder.length === 0) return;
        if (listinActiveZone === 'ALL') {
          listinActiveZone = listinCitiesOrder[0];
        } else {
          const currIdx = listinCitiesOrder.indexOf(listinActiveZone);
          if (currIdx >= listinCitiesOrder.length - 1) {
            listinActiveZone = 'ALL';
          } else {
            listinActiveZone = listinCitiesOrder[currIdx + 1];
          }
        }
        renderListinView();
      });

      // Selector de Submodo (Por Rutas vs Por Zonas vs Lista Plana)
      btnListinModeRoutes?.addEventListener('click', () => {
        listinViewSubMode = 'routes';
        listinFilterType = 'routes';
        renderListinView();
      });
      btnListinModeZones?.addEventListener('click', () => {
        listinViewSubMode = 'zones';
        listinFilterType = 'zones';
        renderListinView();
      });
      btnListinModeFlat?.addEventListener('click', () => {
        listinViewSubMode = 'flat';
        renderListinView();
      });

      // Buscador Rápido de Guías en el Listín
      listinSearchInput?.addEventListener('input', () => {
        listinSearchQuery = listinSearchInput.value || '';
        const srcShipments = getListinSourceShipments();
        renderListinHierarchy(srcShipments);
      });

      // Botón Expandir / Colapsar Todas las Zonas / Rutas
      btnListinToggleAllCollapse?.addEventListener('click', () => {
        if (listinViewSubMode === 'routes') {
          if (listinCollapsedRoutes.size >= listinRoutesOrder.length) {
            listinCollapsedRoutes.clear();
          } else {
            listinRoutesOrder.forEach(r => listinCollapsedRoutes.add(r));
          }
        } else {
          if (listinCollapsedCities.size >= listinCitiesOrder.length) {
            listinCollapsedCities.clear();
          } else {
            listinCitiesOrder.forEach(c => listinCollapsedCities.add(c));
          }
        }
        const srcShipments = getListinSourceShipments();
        renderListinHierarchy(srcShipments);
      });

      // Enviar Listín Oficial al Chofer (Guarda la asignación y orden de paradas directamente en su portal)
      btnListinSend?.addEventListener('click', async () => {
        const selectedDriverOption = listinDriverSelect?.options[listinDriverSelect.selectedIndex];
        const driverId = listinDriverSelect?.value;

        if (!driverId || driverId === 'ALL') {
          showToast('Por favor selecciona un Chofer específico para despachar y enviarle su listín', 'info');
          listinDriverSelect?.focus();
          return;
        }

        const driverObj = drivers.find(d => String(d.id) === String(driverId));
        const driverName = driverObj ? driverObj.nombre : (selectedDriverOption?.text || 'Chofer');

        const srcShipments = getListinSourceShipments();
        const orderedActiveGuias = getOrderedActiveGuias(srcShipments);

        const totalGuias = orderedActiveGuias.length;
        const totalPiezas = orderedActiveGuias.reduce((acc, g) => acc + (g.piezas || 1), 0);

        if (totalGuias === 0) {
          showToast('No hay guías activas incluidas para este chofer', 'error');
          return;
        }

        const origHtml = btnListinSend.innerHTML;
        btnListinSend.disabled = true;
        btnListinSend.innerHTML = `
          <svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          <span>Despachando al portal...</span>
        `;

        try {
          // Guardar asignación y orden de ruta en base de datos para este chofer
          const updatePromises = orderedActiveGuias.map((g, idx) => 
            fetch(`/api/guias/${g.id_guia}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ orden_ruta: idx + 1, chofer_asignado_id: Number(driverId) })
            })
          );

          await Promise.all(updatePromises);

          showToast(`¡Listín enviado al portal de ${driverName}! Ya puede imprimir su hoja de carga.`, 'success');
          silentRefresh();
        } catch (e) {
          console.error('Error al despachar listín:', e);
          showToast('Error al enviar el listín al chofer. Intenta nuevamente.', 'error');
        } finally {
          btnListinSend.disabled = false;
          btnListinSend.innerHTML = origHtml;
        }
      });

      // Helper unificado para generar la hoja oficial de Listín a tamaño completo (Carta 100%)
