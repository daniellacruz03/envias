      // Carga Inicial desde PostgreSQL y sincronización en vivo
      async function init() {
        attachEvents();
        renderLoading();
        await loadData();

        // Polling automático cada 3.5 segundos en segundo plano para Live Sync
        setInterval(() => {
          silentRefresh();
        }, 3500);
      }

      function renderLoading() {
        tableBody.innerHTML = `
          <tr>
            <td colspan="7" class="py-12 text-center text-slate-400">
              <div class="flex items-center justify-center gap-2.5">
                <svg class="animate-spin w-4 h-4 text-slate-700" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span class="text-xs font-medium">Conectando con PostgreSQL en Railway...</span>
              </div>
            </td>
          </tr>
        `;
      }

      async function loadData() {
        try {
          const [guiasRes, choferesRes, escaneosRes, histRes] = await Promise.all([
            fetch('/api/guias'),
            fetch('/api/choferes'),
            fetch('/api/escaneos'),
            fetch('/api/rutas/historial')
          ]);

          const guiasJson = await guiasRes.json();
          const choferesJson = await choferesRes.json();
          try {
            const escaneosJson = await escaneosRes.json();
            const totalPend = escaneosJson.totalPendientes || 0;
            if (escaneosCountPill) {
              if (totalPend > 0) {
                escaneosCountPill.textContent = totalPend.toString();
                escaneosCountPill.classList.remove('hidden');
                escaneosCountPill.className = 'text-[10px] bg-amber-400 text-white px-1.5 py-0.2 rounded-full font-bold';
              } else {
                escaneosCountPill.classList.add('hidden');
              }
            }
          } catch(e) {}

          try {
            const histJson = await histRes.json();
            if (histJson.success && Array.isArray(histJson.data)) {
              historialRoutes = histJson.data;
              filteredHistorialRoutes = [...historialRoutes];
              if (historialCountPill) {
                historialCountPill.textContent = historialRoutes.length.toString();
              }
              if (historialBadgeCount) {
                historialBadgeCount.textContent = `${historialRoutes.length} ruta${historialRoutes.length !== 1 ? 's' : ''} archivada${historialRoutes.length !== 1 ? 's' : ''}`;
              }
            }
          } catch(e) {}

          if (guiasJson.success) {
            shipments = guiasJson.data || [];
          } else {
            showToast('Error al cargar guías desde la base de datos', 'error');
          }

          if (choferesJson.success) {
            drivers = choferesJson.data || [];
          }

          isLoading = false;
          populateCityFilter();
          renderViews();
        } catch (err: any) {
          isLoading = false;
          console.error('Error al conectar con la API:', err);
          showToast('Error de red al consultar la base de datos', 'error');
          tableBody.innerHTML = `
            <tr>
              <td colspan="7" class="py-8 text-center text-rose-500 text-xs">
                No se pudo conectar con la base de datos. Verifica tu conexión a internet o la variable DATABASE_URL.
              </td>
            </tr>
          `;
        }
      }

      // Sincronización automática silenciosa en tiempo real
      async function silentRefresh() {
        if (isSubmitting || isLoading) return;
        try {
          // 1. Sincronizar guías
          const res = await fetch('/api/guias');
          const json = await res.json();
          if (res.ok && json.success && Array.isArray(json.data)) {
            const newShipments: GuiaRow[] = json.data;
            
            // Detectar cambios en guías, estados o confirmaciones de GPS
            let hasChanges = false;
            if (newShipments.length !== shipments.length) {
              hasChanges = true;
            } else {
              for (let i = 0; i < newShipments.length; i++) {
                const current = shipments.find(s => s.id_guia === newShipments[i].id_guia);
                if (!current) {
                  hasChanges = true;
                  break;
                }
                // Si el cliente acaba de confirmar su ubicación GPS
                if (!current.gps_confirmado && newShipments[i].gps_confirmado) {
                  showToast(`Ubicación confirmada por el cliente para la guía #${newShipments[i].id_guia}`, 'success');
                  hasChanges = true;
                  break;
                }
                if (
                  current.estado !== newShipments[i].estado ||
                  current.chofer_asignado_id !== newShipments[i].chofer_asignado_id ||
                  current.direccion_referencia !== newShipments[i].direccion_referencia ||
                  current.hora_disponible !== newShipments[i].hora_disponible ||
                  current.empresa !== newShipments[i].empresa
                ) {
                  hasChanges = true;
                  break;
                }
              }
            }

            if (hasChanges) {
              shipments = newShipments;
              populateCityFilter();
              renderViews();
            }
          }

          // 2. Sincronizar badge de escaneos y lista en tiempo real si está activa la vista
          try {
            const escRes = await fetch('/api/escaneos');
            if (escRes.ok) {
              const escData = await escRes.json();
              const totalPend = escData.totalPendientes || 0;
              const newLotes = escData.data || [];

              // Actualizar badge numérico en la pestaña
              if (escaneosCountPill) {
                if (totalPend > 0) {
                  escaneosCountPill.textContent = totalPend.toString();
                  escaneosCountPill.classList.remove('hidden');
                  escaneosCountPill.className = 'text-[10px] bg-amber-400 text-white px-1.5 py-0.2 rounded-full font-bold';
                } else {
                  escaneosCountPill.classList.add('hidden');
                }
              }

              // Si el usuario está viendo la pestaña de escaneos y el drawer NO está abierto
              const escaneoDrawerEl = document.getElementById('escaneo-drawer');
              const isDrawerClosed = !escaneoDrawerEl || escaneoDrawerEl.classList.contains('hidden');

              if (currentViewMode === 'escaneos' && isDrawerClosed) {
                const prevSummary = JSON.stringify(escaneosData.map((l: any) => ({ id: l.lote_id, total: l.total, pend: l.pendientes, proc: l.procesadas })));
                const newSummary = JSON.stringify(newLotes.map((l: any) => ({ id: l.lote_id, total: l.total, pend: l.pendientes, proc: l.procesadas })));

                if (prevSummary !== newSummary || escaneosData.length === 0) {
                  escaneosData = newLotes;
                  const listEl = document.getElementById('escaneos-list');
                  const emptyEl = document.getElementById('escaneos-empty');
                  const loadingEl = document.getElementById('escaneos-loading');
                  loadingEl?.classList.add('hidden');

                  if (escaneosData.length === 0) {
                    listEl?.classList.add('hidden');
                    emptyEl?.classList.remove('hidden');
                  } else {
                    emptyEl?.classList.add('hidden');
                    if (listEl) {
                      listEl.innerHTML = escaneosData.map((lote: any) => renderEscaneoLote(lote)).join('');
                      listEl.classList.remove('hidden');
                    }
                    drawerFotosFlat = escaneosData.flatMap((lote: any) =>
                      (lote.fotos || []).filter((f: any) => f.estado === 'pendiente').map((f: any) => ({
                        ...f,
                        chofer_nombre: lote.chofer_nombre,
                        lote_id: lote.lote_id
                      }))
                    );
                  }
                }
              }
            }
          } catch(e) {}

          // 3. Sincronizar historial de rutas
          try {
            const histRes = await fetch('/api/rutas/historial');
            if (histRes.ok) {
              const histData = await histRes.json();
              if (histData.success && Array.isArray(histData.data)) {
                if (histData.data.length !== historialRoutes.length) {
                  historialRoutes = histData.data;
                  if (historialCountPill) {
                    historialCountPill.textContent = historialRoutes.length.toString();
                  }
                  if (historialBadgeCount) {
                    historialBadgeCount.textContent = `${historialRoutes.length} ruta${historialRoutes.length !== 1 ? 's' : ''} archivada${historialRoutes.length !== 1 ? 's' : ''}`;
                  }
                  if (currentViewMode === 'historial') {
                    (window as any).filterHistorialData();
                  }
                }
              }
            }
          } catch(e) {}

        } catch (err) {
          // Error silencioso de red sin interrumpir al usuario
        }
      }

      // Llenar filtro de ciudades
      function populateCityFilter() {
        const currentVal = filterCiudad.value;
        const uniqueCities = Array.from(new Set(shipments.map(s => s.ciudad_destino).filter(Boolean))).sort();
        
        filterCiudad.innerHTML = '<option value="ALL">Todas las Ciudades</option>';
        uniqueCities.forEach(city => {
          const opt = document.createElement('option');
          opt.value = city;
          opt.textContent = city;
          filterCiudad.appendChild(opt);
        });

        if (uniqueCities.includes(currentVal)) {
          filterCiudad.value = currentVal;
        }

        if (citiesCountPill) {
          citiesCountPill.textContent = uniqueCities.length.toString();
        }
      }

      // Actualizar contadores KPI
      function updateKPIs() {
        if (!kpiTotal) return;
        kpiTotal.textContent = shipments.length.toString();
        kpiContactar.textContent = shipments.filter(s => s.estado === 'Por contactar').length.toString();
        kpiRuta.textContent = shipments.filter(s => s.estado === 'En ruta').length.toString();
        kpiGps.textContent = shipments.filter(s => s.gps_confirmado === true).length.toString();

        const gpsCount = shipments.filter(s => s.gps_confirmado && s.gps_latitud && s.gps_longitud).length;
        if (mapaCountPill) {
          mapaCountPill.textContent = gpsCount.toString();
          mapaCountPill.className = gpsCount > 0
            ? 'text-[10px] bg-emerald-100 text-emerald-800 px-1.5 py-0.2 rounded-full font-bold'
            : 'text-[10px] bg-slate-300/80 text-slate-700 px-1.5 py-0.2 rounded-full font-bold';
        }
      }

      // Filtrar guías según búsqueda y selects
      function getFilteredShipments(): GuiaRow[] {
        const query = searchInput.value.toLowerCase().trim();
        const cityFilter = filterCiudad.value;
        const statusFilter = filterEstado.value;
        const empresaFilter = filterEmpresa ? filterEmpresa.value : 'ALL';

        return shipments.filter(item => {
          const matchQuery = (item.id_guia && item.id_guia.toLowerCase().includes(query)) || 
                             (item.destinatario && item.destinatario.toLowerCase().includes(query)) ||
                             (item.telefono_principal && item.telefono_principal.includes(query)) ||
                             (item.telefono_secundario && item.telefono_secundario.includes(query)) ||
                             (item.ciudad_destino && item.ciudad_destino.toLowerCase().includes(query)) ||
                             (item.empresa && item.empresa.toLowerCase().includes(query));
          const matchCity = cityFilter === 'ALL' || item.ciudad_destino === cityFilter;
          const matchStatus = statusFilter === 'ALL' || item.estado === statusFilter;
          const matchEmpresa = empresaFilter === 'ALL' || (item.empresa && item.empresa.trim().toLowerCase() === empresaFilter.trim().toLowerCase());

          return matchQuery && matchCity && matchStatus && matchEmpresa;
        });
      }

      // Render Principal de Vistas
      function renderViews() {
        if (isLoading) return;

        const filtered = getFilteredShipments();
        filteredCountBadge.textContent = `${filtered.length} de ${shipments.length} guías`;
        updateKPIs();

        if (filtered.length === 0 && currentViewMode !== 'historial') {
          tableBody.innerHTML = '';
          viewContainerCities.innerHTML = '';
          if (viewContainerDrivers) viewContainerDrivers.innerHTML = '';
          emptyState.classList.remove('hidden');
          return;
        }

        emptyState.classList.add('hidden');

        if (currentViewMode === 'table') {
          renderTable(filtered);
        } else if (currentViewMode === 'cities') {
          renderCitiesGrouped(filtered);
        } else if (currentViewMode === 'drivers') {
          renderDriversView(filtered);
        } else if (currentViewMode === 'mapa') {
          renderClientLocationsSection();
        } else if (currentViewMode === 'listin') {
          renderListinView();
        } else if (currentViewMode === 'historial') {
          renderHistorialView();
        }
      }

      // ==========================================
      // RENDER VISTA 1: TABLA
      // ==========================================
      function renderTable(filtered: GuiaRow[]) {
        tableBody.innerHTML = filtered.map(item => createRowHTML(item)).join('');
      }

      function createRowHTML(item: GuiaRow): string {
        let badgeColor = 'bg-slate-100 text-slate-700 border-slate-200';
        if (item.estado === 'Por contactar') badgeColor = 'bg-amber-50 text-amber-700 border-amber-200/80';
        if (item.estado === 'Contactado') badgeColor = 'bg-sky-50 text-sky-700 border-sky-200/80';
        if (item.estado === 'En ruta') badgeColor = 'bg-indigo-50 text-indigo-700 border-indigo-200/80';
        if (item.estado === 'Entregado') badgeColor = 'bg-emerald-50 text-emerald-700 border-emerald-200/80';
        if (item.estado === 'No entregado') badgeColor = 'bg-rose-50 text-rose-700 border-rose-200/80';

        const isGpsConfirmed = item.gps_confirmado === true;
        let gpsCellHtml = '';
        if (isGpsConfirmed && item.gps_latitud && item.gps_longitud) {
          gpsCellHtml = `
            <a
              href="https://www.google.com/maps?q=${item.gps_latitud},${item.gps_longitud}"
              target="_blank"
              title="Abrir coordenadas en Google Maps (${item.gps_latitud}, ${item.gps_longitud})"
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold border bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100 hover:border-emerald-300 transition-colors group cursor-pointer"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
