        dropdownEl: HTMLElement,
        clearBtnEl: HTMLButtonElement | null,
        onSelectCallback: (name: string) => void
      ) {
        if (!inputEl || !dropdownEl) return;

        function updateDropdown(query: string) {
          const cleanQuery = normalizeText(query);
          let filtered = VENEZUELA_LOCATIONS;

          // Verificar si el texto ingresado es un código OLC o Coordenadas
          const parsedOlc = typeof parseUniversalLocation === 'function' ? parseUniversalLocation(query) : null;

          if (cleanQuery) {
            filtered = VENEZUELA_LOCATIONS.filter(item => 
              normalizeText(item.name).includes(cleanQuery) || 
              normalizeText(item.state).includes(cleanQuery) ||
              normalizeText(item.category).includes(cleanQuery)
            );
          }

          let htmlItems = '';

          // Si es OLC o coordenadas válidas, mostrarlo de primero
          if (parsedOlc) {
            htmlItems += `
              <div
                class="autocomplete-item p-2.5 rounded-xl bg-indigo-50/80 hover:bg-indigo-100 cursor-pointer flex items-center justify-between gap-2.5 transition-colors border border-indigo-200"
                data-name="${parsedOlc.label}"
              >
                <div class="flex items-center gap-2.5 min-w-0">
                  <div class="w-7 h-7 rounded-lg bg-indigo-600 text-white flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                  </div>
                  <div class="min-w-0">
                    <p class="text-xs font-extrabold text-indigo-950 truncate">${parsedOlc.label}</p>
                    <p class="text-[10px] text-indigo-700 font-mono font-semibold truncate">GPS: ${parsedOlc.lat.toFixed(4)}, ${parsedOlc.lon.toFixed(4)} &bull; OLC Decodificado</p>
                  </div>
                </div>
                <span class="text-[10px] font-bold text-indigo-700 bg-white px-2 py-0.5 rounded-md border border-indigo-200 shrink-0">Fijar GPS</span>
              </div>
            `;
          }

          if (filtered.length === 0 && !parsedOlc) {
            dropdownEl.innerHTML = `
              <div class="p-3 text-center text-[11px] text-slate-400">
                <span>No se encontró coincidencia directa. Puedes presionar Enter o usar: <b>"${query}"</b></span>
              </div>
            `;
            dropdownEl.classList.remove('hidden');
            return;
          }

          dropdownEl.innerHTML = htmlItems + filtered.slice(0, 8).map(loc => {
            const iconSvg = loc.isSpecial
              ? `<svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
              : loc.isHub
              ? `<svg class="w-4 h-4 text-indigo-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`
              : `<svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`;

            return `
              <div
                class="autocomplete-item p-2.5 rounded-xl hover:bg-slate-50 cursor-pointer flex items-center justify-between gap-2.5 transition-colors group"
                data-name="${loc.name}"
              >
                <div class="flex items-center gap-2.5 min-w-0">
                  <div class="w-7 h-7 rounded-lg ${loc.isHub ? 'bg-indigo-50 text-indigo-600' : loc.isSpecial ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-500'} flex items-center justify-center shrink-0">
                    ${iconSvg}
                  </div>
                  <div class="min-w-0">
                    <p class="text-xs font-bold text-slate-900 group-hover:text-indigo-600 transition-colors truncate">${loc.name}</p>
                    <p class="text-[10px] text-slate-400 font-medium truncate">${loc.state} &bull; ${loc.category}</p>
                  </div>
                </div>
                <span class="text-[10px] font-bold text-slate-400 opacity-0 group-hover:opacity-100 transition-opacity">Seleccionar</span>
              </div>
            `;
          }).join('');

          // Click listeners en cada item
          dropdownEl.querySelectorAll('.autocomplete-item').forEach(item => {
            item.addEventListener('click', (e) => {
              e.stopPropagation();
              const name = (item as HTMLElement).dataset.name || '';
              inputEl.value = name;
              dropdownEl.classList.add('hidden');
              updateClearBtn();
              onSelectCallback(name);
            });
          });

          dropdownEl.classList.remove('hidden');
        }

        function updateClearBtn() {
          if (clearBtnEl) {
            if (inputEl.value.trim().length > 0) {
              clearBtnEl.classList.remove('hidden');
            } else {
              clearBtnEl.classList.add('hidden');
            }
          }
        }

        inputEl.addEventListener('input', (e) => {
          updateClearBtn();
          updateDropdown((e.target as HTMLInputElement).value);
        });

        inputEl.addEventListener('focus', () => {
          updateClearBtn();
          updateDropdown(inputEl.value);
        });

        clearBtnEl?.addEventListener('click', (e) => {
          e.stopPropagation();
          inputEl.value = '';
          updateClearBtn();
          inputEl.focus();
          updateDropdown('');
          onSelectCallback('');
        });
      }

      // Reaccionar inmediatamente cuando cambia el Punto de Origen / Salida
      function onOriginLocationChanged(autoOptimize: boolean = true) {
        const start = getStartCoordinates();
        if (autoOptimize && plannedStops.length > 1) {
          const withGPS = plannedStops.filter(g => g.gps_confirmado && g.gps_latitud && g.gps_longitud);
          if (withGPS.length >= 2) {
            (window as any).optimizeRouteStopsByGPS(true);
            return;
          }
        }
        renderRoutePlannerStops();
        if (isPlannerRouteMapVisible) {
          drawPlannerRouteMap();
        }
        showToast(`Sede de salida establecida: ${start.label}`, 'info');
      }

      // Reaccionar inmediatamente cuando cambia el Punto de Destino / Cierre
      function onDestinationLocationChanged() {
        renderRoutePlannerStops();
        if (isPlannerRouteMapVisible) {
          drawPlannerRouteMap();
        }
        const end = getEndCoordinates();
        showToast(`Destino establecido: ${end.label}`, 'info');
      }

      // Inicializar Autocompletado para Inicio y Cierre con reactividad total
      setupAutocomplete(plannerStartInput, startAutocompleteDropdown, btnClearStartInput, (val) => {
        onOriginLocationChanged(true);
      });

      setupAutocomplete(plannerEndInput, endAutocompleteDropdown, btnClearEndInput, (val) => {
        onDestinationLocationChanged();
      });

      // Escuchar cambios directos o tipeo en los campos de entrada
      plannerStartInput?.addEventListener('input', () => {
        const val = plannerStartInput.value.trim();
        const parsed = parseUniversalLocation(val);
        if (parsed) onOriginLocationChanged(true);
      });

      plannerStartInput?.addEventListener('change', () => {
        onOriginLocationChanged(true);
      });

      plannerEndInput?.addEventListener('input', () => {
        const val = plannerEndInput.value.trim();
        const parsed = parseUniversalLocation(val);
        if (parsed) onDestinationLocationChanged();
      });

      plannerEndInput?.addEventListener('change', () => {
        onDestinationLocationChanged();
      });

      // Cerrar dropdowns si se hace clic afuera
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!plannerStartInput?.contains(target) && !startAutocompleteDropdown?.contains(target)) {
          startAutocompleteDropdown?.classList.add('hidden');
        }
        if (!plannerEndInput?.contains(target) && !endAutocompleteDropdown?.contains(target)) {
          endAutocompleteDropdown?.classList.add('hidden');
        }
      });

      (window as any).selectStartLocation = (locationName: string) => {
        if (plannerStartInput) {
          plannerStartInput.value = locationName;
          if (btnClearStartInput) btnClearStartInput.classList.remove('hidden');
          startAutocompleteDropdown?.classList.add('hidden');
          onOriginLocationChanged(true);
        }
      };

      (window as any).selectEndLocation = (locationName: string) => {
        if (plannerEndInput) {
          plannerEndInput.value = locationName;
          if (btnClearEndInput) btnClearEndInput.classList.remove('hidden');
          endAutocompleteDropdown?.classList.add('hidden');
          onDestinationLocationChanged();
        }
      };

      // Abrir Modal de Planificación
      (window as any).openRoutePlannerModal = (presetDriverId?: number | null, presetCity?: string | null) => {
        if (!routePlannerModal) return;

        // 1. Poblar choferes en el select
        plannerDriverSelect.innerHTML = `
          <option value="">Selecciona el chofer que realizará la ruta...</option>
          ${drivers.map(d => `<option value="${d.id}">${d.nombre} (${d.telefono || 'Sin telf'})</option>`).join('')}
        `;

        // Si se especificó un chofer o hay alguno por defecto
        if (presetDriverId) {
          plannerDriverSelect.value = String(presetDriverId);
        } else if (drivers.length > 0) {
          plannerDriverSelect.value = String(drivers[0].id);
        }

        // Si se abrió desde una ciudad, seleccionar las guías de esa ciudad
        if (presetCity) {
          plannerStartInput.value = `Sede ${presetCity}`;
          plannerEndInput.value = `Retorno a Sede ${presetCity}`;
          plannedStops = shipments.filter(g => 
            g.ciudad_destino?.toLowerCase() === presetCity.toLowerCase() && 
            g.estado !== 'Entregado'
          );
        } else {
          const currentDriverId = parseInt(plannerDriverSelect.value, 10);
          const driverGuias = shipments.filter(g => 
            g.chofer_asignado_id === currentDriverId && 
            g.estado !== 'Entregado'
          );

          if (driverGuias.length > 0) {
            plannedStops = driverGuias;
          } else {
            plannedStops = shipments.filter(g => g.estado !== 'Entregado').slice(0, 12);
          }
        }

        // Ordenar por orden_ruta existente si lo tienen
        plannedStops.sort((a, b) => (a.orden_ruta || 999) - (b.orden_ruta || 999));

        renderRoutePlannerStops();
        routePlannerModal.classList.remove('hidden');
        routePlannerModal.classList.add('flex');
      };

      // Cambiar chofer en el modal
      plannerDriverSelect?.addEventListener('change', () => {
        const selectedId = parseInt(plannerDriverSelect.value, 10);
        if (!selectedId) return;

        const driverGuias = shipments.filter(g => 
          g.chofer_asignado_id === selectedId && 
          g.estado !== 'Entregado'
        );

        if (driverGuias.length > 0) {
          plannedStops = driverGuias;
          plannedStops.sort((a, b) => (a.orden_ruta || 999) - (b.orden_ruta || 999));
          renderRoutePlannerStops();
        }
      });

      function closeRoutePlannerModal() {
        routePlannerModal?.classList.add('hidden');
        routePlannerModal?.classList.remove('flex');
        plannedStops = [];
      }

      plannerCloseBtn?.addEventListener('click', closeRoutePlannerModal);
      plannerCancelBtn?.addEventListener('click', closeRoutePlannerModal);

      function updateRouteMetrics(totalKm: number) {
        const kmEl = document.getElementById('planner-total-km');
        const timeEl = document.getElementById('planner-total-time');
        if (kmEl) kmEl.textContent = `~${totalKm.toFixed(1)} km totales`;
        if (timeEl) {
          // Estimado: velocidad promedio 28 km/h en ciudad + 4 min por entrega
          const driveMinutes = (totalKm / 28) * 60;
          const stopMinutes = plannedStops.length * 4;
          const totalMinutes = Math.round(driveMinutes + stopMinutes);
          const hours = Math.floor(totalMinutes / 60);
          const mins = totalMinutes % 60;
          timeEl.textContent = hours > 0 ? `~${hours}h ${mins}m estimado` : `~${mins} min estimado`;
        }
      }

      // Desglose de enlaces de Google Maps por tramos (superando límite de 10 destinos)
      function renderGoogleMapsBatches() {
        const container = document.getElementById('planner-gmaps-batch-buttons');
        if (!container) return;

        const gpsStops = plannedStops.filter(g => g.gps_confirmado && g.gps_latitud && g.gps_longitud);
        if (gpsStops.length === 0) {
          container.innerHTML = `<span class="text-[11px] text-slate-400 italic">No hay paradas con GPS confirmado para trazar en Google Maps.</span>`;
          return;
        }

        const start = getStartCoordinates();
        const end = getEndCoordinates();

        const CHUNK_SIZE = 8; // Máximo 8 paradas por enlace para que Google Maps nunca trunque
        const chunks: { label: string, url: string }[] = [];

        for (let i = 0; i < gpsStops.length; i += CHUNK_SIZE) {
          const slice = gpsStops.slice(i, i + CHUNK_SIZE);
          const fromNum = i + 1;
          const toNum = i + slice.length;

          let originCoord = i === 0 ? `${start.lat.toFixed(6)},${start.lon.toFixed(6)}` : `${Number(gpsStops[i - 1].gps_latitud).toFixed(6)},${Number(gpsStops[i - 1].gps_longitud).toFixed(6)}`;
          let path = [originCoord];

          slice.forEach(g => {
            path.push(`${Number(g.gps_latitud).toFixed(6)},${Number(g.gps_longitud).toFixed(6)}`);
          });

          if (toNum === gpsStops.length) {
            const isToMerida = (end.label || '').toLowerCase().includes('merida') || (end.lat === 8.5738);
            if (isToMerida) {
              // Asegurar paso por el Páramo (Apartaderos / Troncal 7) para evitar desvío por El Vigía
              path.push('8.800000,-70.850000');
            }
            path.push(`${end.lat.toFixed(6)},${end.lon.toFixed(6)}`);
          }

          const gmapsUrl = `https://www.google.com/maps/dir/${path.join('/')}`;
          chunks.push({
            label: `Tramo ${chunks.length + 1}: Paradas #${fromNum} a #${toNum}`,
            url: gmapsUrl
          });
        }

        container.innerHTML = chunks.map(chunk => `
          <a
            href="${chunk.url}"
            target="_blank"
            class="px-2.5 py-1 rounded-xl bg-white border border-indigo-200 hover:border-indigo-300 text-indigo-800 hover:bg-indigo-50 text-[11px] font-bold flex items-center gap-1.5 shadow-2xs transition-colors cursor-pointer"
          >
            <span>${chunk.label}</span>
            <svg class="w-3 h-3 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        `).join('');
      }

      // Renderizar paradas en el modal con cálculo de distancias por tramo
      function renderRoutePlannerStops() {
        if (!plannerStopsList || !plannerStopsCountBadge) return;

        plannerStopsCountBadge.textContent = `${plannedStops.length} ${plannedStops.length === 1 ? 'parada' : 'paradas'}`;

        if (plannedStops.length === 0) {
          plannerStopsList.innerHTML = `
            <div class="p-6 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-200 text-slate-400 text-xs">
              No hay paradas seleccionadas en esta ruta.
            </div>
          `;
          updateRouteMetrics(0);
          return;
        }

        const start = getStartCoordinates();
        let prevLat = start.lat;
        let prevLon = start.lon;
        let totalKm = 0;

        plannerStopsList.innerHTML = plannedStops.map((item, index) => {
          const stopNumber = index + 1;
          const isFirst = index === 0;
          const isLast = index === plannedStops.length - 1;
          const hasGPS = item.gps_confirmado && item.gps_latitud && item.gps_longitud;

          let legDistanceKm = 0;
          if (hasGPS) {
            legDistanceKm = calculateDistance(prevLat, prevLon, Number(item.gps_latitud), Number(item.gps_longitud));
            totalKm += legDistanceKm;
            prevLat = Number(item.gps_latitud);
            prevLon = Number(item.gps_longitud);
          }

          return `
            <div class="p-3 bg-white border border-slate-200/90 rounded-2xl shadow-2xs hover:border-slate-300 transition-all flex items-center justify-between gap-3">
              <!-- Número de Parada & Info -->
              <div class="flex items-center gap-3 min-w-0 flex-1">
                <!-- Badge de Número -->
                <div class="w-8 h-8 rounded-xl bg-slate-900 text-white flex items-center justify-center font-extrabold text-xs shrink-0 shadow-xs">
                  ${stopNumber}
                </div>

                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-bold text-slate-900 text-xs truncate max-w-[200px]">${item.destinatario}</span>
                    <span class="font-mono text-[10px] text-slate-500 font-bold bg-slate-100 px-1.5 py-0.2 rounded border border-slate-200">#${item.id_guia}</span>
                    <span class="text-[10px] font-bold text-slate-600 bg-slate-100 px-1.5 py-0.2 rounded">${item.ciudad_destino}</span>
                    ${item.piezas ? `<span class="text-[10px] text-slate-400 font-semibold">${item.piezas} pz</span>` : ''}
                  </div>

                  <div class="flex items-center gap-2 text-[10px] mt-1 flex-wrap">
                    ${hasGPS ? `
                      <span class="text-emerald-700 font-bold flex items-center gap-1 bg-emerald-50 border border-emerald-200/80 px-2 py-0.2 rounded-md">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>+${legDistanceKm.toFixed(1)} km</span>
                        <span class="text-emerald-600 font-normal">(${isFirst ? 'desde Salida' : 'desde anterior'})</span>
                      </span>
                    ` : `
                      <span class="text-slate-400 font-medium">${item.direccion_referencia || 'Dirección de referencia'}</span>
                    `}
                    ${item.hora_disponible ? `
                      <span class="text-indigo-600 font-bold flex items-center gap-0.5 bg-indigo-50 px-2 py-0.2 rounded-md border border-indigo-100">
                        <svg class="w-3 h-3 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <span>Hasta ${item.hora_disponible}</span>
                      </span>
                    ` : ''}
                  </div>
                </div>
              </div>

              <!-- Controles de Reordenamiento (Subir / Bajar / Eliminar) -->
              <div class="flex items-center gap-1 shrink-0">
                <!-- Botón Subir -->
                <button
                  type="button"
                  onclick="window.moveRouteStopUp(${index})"
                  ${isFirst ? 'disabled class="p-1.5 text-slate-300 rounded-lg cursor-not-allowed"' : 'class="p-1.5 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg cursor-pointer transition-colors"'}
                  title="Mover antes en la ruta"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg>
                </button>

                <!-- Botón Bajar -->
                <button
                  type="button"
                  onclick="window.moveRouteStopDown(${index})"
                  ${isLast ? 'disabled class="p-1.5 text-slate-300 rounded-lg cursor-not-allowed"' : 'class="p-1.5 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg cursor-pointer transition-colors"'}
                  title="Mover después en la ruta"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>

                <!-- Botón Quitar de Ruta -->
                <button
                  type="button"
                  onclick="window.removeRouteStop(${index})"
                  class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg cursor-pointer transition-colors"
                  title="Quitar de esta ruta"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
              </div>
            </div>
          `;
        }).join('');

        updateRouteMetrics(totalKm);
        renderGoogleMapsBatches();
        if (isPlannerRouteMapVisible) {
          drawPlannerRouteMap();
        }
      }

      // Mover parada hacia arriba
      (window as any).moveRouteStopUp = (index: number) => {
        if (index <= 0 || index >= plannedStops.length) return;
        const temp = plannedStops[index];
        plannedStops[index] = plannedStops[index - 1];
        plannedStops[index - 1] = temp;
        renderRoutePlannerStops();
      };

      // Mover parada hacia abajo
      (window as any).moveRouteStopDown = (index: number) => {
        if (index < 0 || index >= plannedStops.length - 1) return;
        const temp = plannedStops[index];
        plannedStops[index] = plannedStops[index + 1];
        plannedStops[index + 1] = temp;
        renderRoutePlannerStops();
      };

      // Quitar parada de la ruta
      (window as any).removeRouteStop = (index: number) => {
        if (index < 0 || index >= plannedStops.length) return;
        plannedStops.splice(index, 1);
        renderRoutePlannerStops();
      };

      // ==========================================
      // VISOR SATELITAL DE TODAS LAS 25 PARADAS (LEAFLET)
      // ==========================================
      let plannerRouteMap: any = null;
      let plannerRouteLayerGroup: any = null;
      let isPlannerRouteMapVisible = false;

      (window as any).togglePlannerRouteMap = () => {
        const wrapper = document.getElementById('planner-route-map-wrapper');
        const btnText = document.getElementById('btn-toggle-map-text');
        if (!wrapper) return;

        isPlannerRouteMapVisible = !isPlannerRouteMapVisible;
        if (isPlannerRouteMapVisible) {
          wrapper.classList.remove('hidden');
          if (btnText) btnText.textContent = 'Ocultar Mapa';
          setTimeout(() => {
            drawPlannerRouteMap();
          }, 100);
        } else {
          wrapper.classList.add('hidden');
          if (btnText) btnText.textContent = 'Ver Mapa de Ruta';
        }
      };

      function drawPlannerRouteMap() {
        if (typeof (window as any).L === 'undefined') return;
        const L = (window as any).L;

        if (!plannerRouteMap) {
          plannerRouteMap = L.map('planner-full-route-map', {
            zoomControl: true,
            attributionControl: false
          }).setView([10.0808, -69.3756], 12);

          L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
            maxZoom: 19,
            subdomains: 'abcd'
          }).addTo(plannerRouteMap);

          plannerRouteLayerGroup = L.layerGroup().addTo(plannerRouteMap);
        }

        plannerRouteMap.invalidateSize();
        plannerRouteLayerGroup.clearLayers();

        const start = getStartCoordinates();
        const end = getEndCoordinates();
        const latlngs: [number, number][] = [];

        // 1. Origen / Salida (Pin Azul)
        const startHtml = `
          <div class="relative flex items-center justify-center w-8 h-8 rounded-full bg-indigo-600 border-2 border-white shadow-lg text-white text-[11px] font-black">
            S
          </div>
        `;
        const startIcon = L.divIcon({ html: startHtml, className: 'start-pin', iconSize: [32, 32], iconAnchor: [16, 16] });
        L.marker([start.lat, start.lon], { icon: startIcon }).addTo(plannerRouteLayerGroup)
          .bindPopup(`<b>Punto de Salida / Origen:</b><br>${start.label}`);
        latlngs.push([start.lat, start.lon]);

        // 2. Paradas Secuenciales Numeradas (1 a 25)
        plannedStops.forEach((g, idx) => {
          if (g.gps_confirmado && g.gps_latitud && g.gps_longitud) {
            const lat = Number(g.gps_latitud);
            const lon = Number(g.gps_longitud);
            latlngs.push([lat, lon]);

            const pinHtml = `
              <div class="relative flex items-center justify-center w-7 h-7 rounded-full bg-slate-900 border-2 border-emerald-400 shadow-md text-emerald-300 text-[10px] font-extrabold">
                ${idx + 1}
              </div>
            `;
            const icon = L.divIcon({ html: pinHtml, className: 'stop-pin', iconSize: [28, 28], iconAnchor: [14, 14] });
            L.marker([lat, lon], { icon }).addTo(plannerRouteLayerGroup)
              .bindPopup(`<b>Parada #${idx + 1} (Guía #${g.id_guia}):</b><br>${g.destinatario}<br><span class="text-xs text-slate-500">${g.ciudad_destino}</span>`);
          }
        });

        // 3. Destino / Cierre (Pin Dorado)
        if (end.lat && end.lon) {
          latlngs.push([end.lat, end.lon]);
          const endHtml = `
            <div class="relative flex items-center justify-center w-8 h-8 rounded-full bg-amber-500 border-2 border-white shadow-lg text-white text-[11px] font-black">
              🏁
            </div>
          `;
          const endIcon = L.divIcon({ html: endHtml, className: 'end-pin', iconSize: [32, 32], iconAnchor: [16, 16] });
          L.marker([end.lat, end.lon], { icon: endIcon }).addTo(plannerRouteLayerGroup)
            .bindPopup(`<b>Punto Final / Cierre:</b><br>${end.label}`);
        }

        // 4. Polilínea conectando la trayectoria completa
        if (latlngs.length >= 2) {
          L.polyline(latlngs, {
            color: '#4f46e5',
            weight: 4,
            opacity: 0.85,
            dashArray: '6, 8',
            lineJoin: 'round'
          }).addTo(plannerRouteLayerGroup);

          const bounds = L.latLngBounds(latlngs);
          plannerRouteMap.fitBounds(bounds, { padding: [40, 40] });
        }
      }

      // Optimizar Secuencia de Paradas por Jerarquía de Cercanía desde el Punto de Salida (TSP)
      (window as any).optimizeRouteStopsByGPS = (showNotification: boolean = true) => {
        if (plannedStops.length <= 1) {
          if (showNotification) showToast('Agrega más paradas para calcular la jerarquía de la ruta', 'info');
          return;
        }

        const withGPS = plannedStops.filter(g => g.gps_confirmado && g.gps_latitud && g.gps_longitud);
        const withoutGPS = plannedStops.filter(g => !g.gps_confirmado || !g.gps_latitud || !g.gps_longitud);

        if (withGPS.length < 2) {
          if (showNotification) showToast('Se necesitan al menos 2 paradas con GPS confirmado para auto-optimizar', 'info');
          renderRoutePlannerStops();
          return;
        }

        const start = getStartCoordinates();
        let currentLat = start.lat;
        let currentLon = start.lon;

        // Algoritmo Vecino Más Cercano arrancando desde el Punto de Salida
        const optimized: GuiaRow[] = [];
        const unvisited = [...withGPS];

        while (unvisited.length > 0) {
          let nearestIdx = 0;
          let minDistance = Infinity;

          for (let i = 0; i < unvisited.length; i++) {
            const dist = calculateDistance(
              currentLat,
              currentLon,
              Number(unvisited[i].gps_latitud),
              Number(unvisited[i].gps_longitud)
            );
            if (dist < minDistance) {
              minDistance = dist;
              nearestIdx = i;
            }
          }

          const nextStop = unvisited.splice(nearestIdx, 1)[0];
          optimized.push(nextStop);
          currentLat = Number(nextStop.gps_latitud);
          currentLon = Number(nextStop.gps_longitud);
        }

        // Unir paradas optimizadas + paradas sin GPS al final
        plannedStops = [...optimized, ...withoutGPS];
        renderRoutePlannerStops();
        if (showNotification) {
          showToast(`¡Secuencia ordenada por cercanía partiendo desde ${start.label}!`, 'success');
        }
      };

      // Guardar y Despachar Ruta al Chofer
      (window as any).savePlannedRoute = async (despacharEnRuta: boolean = false) => {
        const driverId = parseInt(plannerDriverSelect.value, 10);
        if (!driverId) {
          showToast('Debes seleccionar un chofer para asignar la ruta', 'error');
          return;
        }

        if (plannedStops.length === 0) {
          showToast('Debes agregar al menos una parada en la ruta', 'error');
          return;
        }

        const startPoint = plannerStartInput.value.trim() || 'Sede Principal Barquisimeto';
        const endPoint = plannerEndInput.value.trim() || 'Retorno a Sede Principal Barquisimeto';

        const actionBtn = despacharEnRuta ? plannerSaveBtn : (document.getElementById('planner-save-almacen-btn') as HTMLButtonElement) || plannerSaveBtn;
        actionBtn.disabled = true;
        const originalHtml = actionBtn.innerHTML;
        actionBtn.innerHTML = `
          <svg class="animate-spin w-4 h-4 text-slate-700" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Guardando...</span>
        `;

        try {
          const payload = {
            chofer_id: driverId,
            ruta_origen: startPoint,
            ruta_destino: endPoint,
            paradas: plannedStops.map((g, idx) => ({
              id_guia: g.id_guia,
              orden: idx + 1
            })),
            despachar_en_ruta: despacharEnRuta
          };

          const res = await fetch('/api/guias/ruta', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          const data = await res.json();

          if (res.ok && data.success) {
            // Actualizar localmente
            const driverObj = drivers.find(d => d.id === driverId);
            plannedStops.forEach((p, idx) => {
              const target = shipments.find(s => s.id_guia === p.id_guia);
              if (target) {
                target.chofer_asignado_id = driverId;
                target.chofer_nombre = driverObj?.nombre || 'Chofer Asignado';
                target.orden_ruta = idx + 1;
                target.ruta_origen = startPoint;
                target.ruta_destino = endPoint;
                if (despacharEnRuta && target.estado !== 'Entregado') {
                  target.estado = 'En ruta';
                }
              }
            });

            closeRoutePlannerModal();
            renderViews();
            updateKPIs();
            populateCityFilter();
            
            if (despacharEnRuta) {
              showToast(`¡Ruta de ${plannedStops.length} paradas despachada En Ruta con éxito!`, 'success');
            } else {
              showToast(`¡Secuencia de ${plannedStops.length} paradas guardada en Almacén!`, 'info');
            }
          } else {
            showToast(data.message || 'Error al guardar la ruta', 'error');
          }
        } catch (err) {
          console.error('Error guardando ruta:', err);
          showToast('Error al procesar la ruta. Verifica los datos.', 'error');
        } finally {
          actionBtn.disabled = false;
          actionBtn.innerHTML = originalHtml;
        }
      };

      // Despachar a Ruta directamente desde la vista de choferes
      (window as any).dispatchDriverToRoute = async (driverId: number) => {
        const driverObj = drivers.find(d => d.id === driverId);
        const driverName = driverObj ? driverObj.nombre : 'Chofer';
        
        try {
          const res = await fetch('/api/guias/lote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              chofer_id: driverId,
              cambiar_estado: 'En ruta'
            })
          });

          const json = await res.json();
          if (res.ok && json.success) {
            shipments.forEach(s => {
              if (s.chofer_asignado_id === driverId && s.estado !== 'Entregado') {
                s.estado = 'En ruta';
              }
            });
            renderViews();
            updateKPIs();
            showToast(`¡Ruta despachada a ${driverName}! Las guías pasaron a En Ruta.`, 'success');
          } else {
            showToast(json.message || 'Error al despachar ruta', 'error');
          }
        } catch (err) {
          showToast('Error de red al despachar la ruta', 'error');
        }
      };

      // ==========================================
      // SELECTOR DE MAPA GPS (ORIGEN Y DESTINO)
      // ==========================================
      const mapPickerModal = document.getElementById('map-picker-modal') as HTMLElement;
      const mapPickerTitle = document.getElementById('map-picker-title') as HTMLElement;
      const mapPickerCloseBtn = document.getElementById('map-picker-close-btn') as HTMLElement;
      const mapPickerCancelBtn = document.getElementById('map-picker-cancel-btn') as HTMLElement;
      const mapPickerConfirmBtn = document.getElementById('map-picker-confirm-btn') as HTMLElement;
      const btnOpenStartMapPicker = document.getElementById('btn-open-start-map-picker') as HTMLButtonElement;
      const btnOpenEndMapPicker = document.getElementById('btn-open-end-map-picker') as HTMLButtonElement;
      const pickerCoordsText = document.getElementById('picker-coords-text') as HTMLElement;
      const pickerZoneName = document.getElementById('picker-zone-name') as HTMLElement;
      const pickerOlcBadge = document.getElementById('picker-olc-badge') as HTMLElement;
      const pickerOlcInput = document.getElementById('picker-olc-input') as HTMLInputElement;
      const pickerSearchInput = document.getElementById('picker-search-input') as HTMLInputElement;
      const pickerGmapsLink = document.getElementById('picker-gmaps-link') as HTMLAnchorElement;

      let pickerMap: any = null;
      let pickerMarker: any = null;
      let currentPickerMode: 'start' | 'end' = 'start';
      let selectedPickerCoords = [10.0808, -69.3756]; // Default Barquisimeto
      let selectedPickerLabel = 'Sede Principal Barquisimeto';

      function initPickerMap() {
        if (pickerMap || typeof (window as any).L === 'undefined') return;

        const L = (window as any).L;

        pickerMap = L.map('picker-map', {
          zoomControl: true,
          attributionControl: false
        }).setView(selectedPickerCoords, 13);

        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
          maxZoom: 19,
          subdomains: 'abcd'
        }).addTo(pickerMap);

        const customPinHtml = `
          <div class="relative flex items-center justify-center w-9 h-9 rounded-full bg-slate-900 border-2 border-white shadow-xl text-white text-xs font-black">
            <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
        `;

        const customPinIcon = L.divIcon({
          html: customPinHtml,
          className: 'picker-pin-icon',
          iconSize: [36, 36],
          iconAnchor: [18, 18]
        });

        pickerMarker = L.marker(selectedPickerCoords, {
          draggable: true,
          icon: customPinIcon
        }).addTo(pickerMap);

        pickerMarker.on('dragend', (e: any) => {
          const latlng = e.target.getLatLng();
          updatePickerCoords(latlng.lat, latlng.lng);
        });

        pickerMap.on('click', (e: any) => {
          pickerMarker.setLatLng(e.latlng);
          updatePickerCoords(e.latlng.lat, e.latlng.lng);
        });
      }

      function updatePickerCoords(lat: number, lon: number) {
        selectedPickerCoords = [lat, lon];
        const label = findClosestCity(lat, lon);
        selectedPickerLabel = label;
        const olcCode = encodeOLC(lat, lon, 10);

        if (pickerCoordsText) pickerCoordsText.textContent = `${lat.toFixed(4)}, ${lon.toFixed(4)}`;
        if (pickerOlcBadge) pickerOlcBadge.textContent = olcCode;
        if (pickerZoneName) pickerZoneName.textContent = label;
        if (pickerGmapsLink) {
          pickerGmapsLink.href = `https://www.google.com/maps/search/?api=1&query=${lat.toFixed(6)},${lon.toFixed(6)}`;
        }
      }

      (window as any).flyPickerToCoords = (lat: number, lon: number, label: string) => {
        selectedPickerCoords = [lat, lon];
        selectedPickerLabel = label;
        if (pickerMap) {
          pickerMap.setView([lat, lon], 14);
          if (pickerMarker) pickerMarker.setLatLng([lat, lon]);
        }
        updatePickerCoords(lat, lon);
      };

      (window as any).setOlcExample = (exampleText: string) => {
        if (pickerOlcInput) {
          pickerOlcInput.value = exampleText;
          (window as any).decodeAndApplyOlcInput();
        }
      };

      (window as any).decodeAndApplyOlcInput = () => {
        const raw = pickerOlcInput?.value?.trim();
        if (!raw) {
          showToast('Ingresa o pega coordenadas u OLC', 'info');
          return;
        }

        const parsed = parseUniversalLocation(raw);
        if (parsed) {
          (window as any).flyPickerToCoords(parsed.lat, parsed.lon, parsed.label);
          showToast(`¡Ubicación decodificada: ${parsed.label}!`, 'success');
        } else {
          showToast('No se pudieron decodificar las coordenadas u OLC ingresadas', 'error');
        }
      };

      pickerOlcInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          (window as any).decodeAndApplyOlcInput();
        }
      });

      pickerSearchInput?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value.trim();
        if (!val) return;
        const parsed = parseUniversalLocation(val);
        if (parsed) {
          (window as any).flyPickerToCoords(parsed.lat, parsed.lon, parsed.label);
        }
      });

      function openMapPicker(mode: 'start' | 'end') {
        currentPickerMode = mode;
        if (mapPickerTitle) {
          mapPickerTitle.textContent = mode === 'start' 
            ? 'Marcar Punto de Salida / Origen en el Mapa' 
            : 'Marcar Punto Final / Destino de Cierre en el Mapa';
        }

        const currentValue = mode === 'start' ? plannerStartInput.value.trim() : plannerEndInput.value.trim();
        
        // Intentar parsear el valor actual con el motor universal
        const parsedCurrent = parseUniversalLocation(currentValue);
        let initialCoords = [10.0808, -69.3756]; // Default Barquisimeto
        if (parsedCurrent) {
          initialCoords = [parsedCurrent.lat, parsedCurrent.lon];
        }

        selectedPickerCoords = initialCoords;
        selectedPickerLabel = currentValue || (mode === 'start' ? 'Sede Principal Barquisimeto' : 'Retorno a Sede Principal Barquisimeto');

        if (pickerOlcInput) {
          pickerOlcInput.value = '';
        }

        mapPickerModal?.classList.remove('hidden');
        mapPickerModal?.classList.add('flex');

        setTimeout(() => {
          initPickerMap();
          if (pickerMap) {
            pickerMap.invalidateSize();
            pickerMap.setView(selectedPickerCoords, 13);
            if (pickerMarker) pickerMarker.setLatLng(selectedPickerCoords);
          }
          updatePickerCoords(selectedPickerCoords[0], selectedPickerCoords[1]);
        }, 150);
      }

      (window as any).openMapPicker = openMapPicker;

      btnOpenStartMapPicker?.addEventListener('click', () => openMapPicker('start'));
      btnOpenEndMapPicker?.addEventListener('click', () => openMapPicker('end'));

      function closeMapPicker() {
        mapPickerModal?.classList.add('hidden');
        mapPickerModal?.classList.remove('flex');
      }

      mapPickerCloseBtn?.addEventListener('click', closeMapPicker);
      mapPickerCancelBtn?.addEventListener('click', closeMapPicker);

      mapPickerConfirmBtn?.addEventListener('click', () => {
        if (currentPickerMode === 'start') {
          plannerStartInput.value = selectedPickerLabel;
          onOriginLocationChanged(true);
        } else {
          plannerEndInput.value = selectedPickerLabel;
          onDestinationLocationChanged();
        }
        closeMapPicker();
        showToast(`Ubicación seleccionada en el mapa: ${selectedPickerLabel}`, 'success');
      });

      // Protección contra bfcache (si el usuario cierra sesión y pulsa "Atrás" en el navegador)
      window.addEventListener('pageshow', (event) => {
        if (event.persisted) {
          window.location.reload();
        }
      });

      init();
    </script>
  </body>
</html>
