                              <div class="flex items-center gap-1.5 flex-wrap">
                                <p class="font-bold text-slate-900">${primary.destinatario}</p>
                                ${isMulti ? `
                                  <span class="text-[9px] font-extrabold px-1.5 py-0.5 rounded-md bg-indigo-100 text-indigo-800 border border-indigo-200 shadow-2xs" title="${clientGuias.length} guías para este cliente">
