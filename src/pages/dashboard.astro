              <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
              <span>+ Fijar GPS</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-amber-700 opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </button>
          `;
        }

        const driverOptions = `
          <option value="">Sin Asignar</option>
          ${drivers.map(driver => `
            <option value="${driver.id}" ${item.chofer_asignado_id === driver.id ? 'selected' : ''}>
              ${driver.nombre}
            </option>
          `).join('')}
        `;

        const clientKey = normalizeClientKey(item.destinatario, item.ciudad_destino);
        const clientGuias = shipments.filter(s => normalizeClientKey(s.destinatario, s.ciudad_destino) === clientKey);
        const isMultiGuia = clientGuias.length > 1;

        return `
          <tr class="hover:bg-slate-50/70 transition-colors group">
            <!-- Guía & Piezas & Empresa & Lote -->
            <td class="py-3.5 px-4">
              <div class="flex items-center gap-1.5 flex-wrap">
                <a href="/confirmar?guia=${encodeURIComponent(item.id_guia)}" target="_blank" title="Abrir portal del cliente" class="font-mono font-bold text-slate-900 hover:text-indigo-600 underline-offset-2 hover:underline">
                  #${item.id_guia}
