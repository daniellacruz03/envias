      }
      (window as any).updateActiveLoteUI = updateActiveLoteUI;

      function setActiveCargaLote(loteCode: string, fechaVal?: string) {
        if (!loteCode) return;
        activeCargaLote = loteCode.trim().toUpperCase();
        activeCargaFecha = (fechaVal || new Date().toISOString().split('T')[0]).trim();

        if (typeof localStorage !== 'undefined') {
          localStorage.setItem('envias_active_carga_lote', activeCargaLote);
          localStorage.setItem('envias_active_carga_fecha', activeCargaFecha);
        }

        const loteInput = document.getElementById('input-lote') as HTMLInputElement;
        const fechaRegistroInput = document.getElementById('input-fecha-registro') as HTMLInputElement;
        if (loteInput) loteInput.value = activeCargaLote;
        if (fechaRegistroInput) fechaRegistroInput.value = activeCargaFecha;

        updateActiveLoteUI();
        showToast(`Lote "${activeCargaLote}" activo. Cada nueva guía se asignará automáticamente aquí.`, 'success');
      }
      (window as any).setActiveCargaLote = setActiveCargaLote;

      function clearActiveCargaLote() {
        activeCargaLote = '';
        activeCargaFecha = '';
        if (typeof localStorage !== 'undefined') {
          localStorage.removeItem('envias_active_carga_lote');
          localStorage.removeItem('envias_active_carga_fecha');
        }

        const loteInput = document.getElementById('input-lote') as HTMLInputElement;
        const fechaRegistroInput = document.getElementById('input-fecha-registro') as HTMLInputElement;
        if (loteInput) loteInput.value = '';
        if (fechaRegistroInput) fechaRegistroInput.value = '';

        updateActiveLoteUI();
        showToast('Asignación automática de lote desactivada.', 'info');
      }
      (window as any).clearActiveCargaLote = clearActiveCargaLote;

      function setActiveCargaLoteFromModal() {
        const codigo = (modalLoteCodigo?.value || '').trim().toUpperCase();
        const fecha = (modalLoteFecha?.value || '').trim() || new Date().toISOString().split('T')[0];

        if (!codigo) {
          showToast('Debe indicar un código de lote válido.', 'error');
          modalLoteCodigo?.focus();
          return;
        }

        setActiveCargaLote(codigo, fecha);
        closeGestionLotesModal();

        const guiaInput = document.getElementById('input-guia') as HTMLInputElement;
        guiaInput?.focus();
      }
      (window as any).setActiveCargaLoteFromModal = setActiveCargaLoteFromModal;

      let selectedLoteGuiaIds = new Set<string>();
      let isLoteCodigoCustomized = false;

      function openGestionLotesModal(preselectedLote?: string) {
        if (!modalGestionLotes) return;

        const todayStr = activeCargaFecha || new Date().toISOString().split('T')[0];
        if (modalLoteFecha) modalLoteFecha.value = todayStr;
        if (modalLoteOrigen) modalLoteOrigen.value = 'BRM';
        isLoteCodigoCustomized = false;
        
        if (activeCargaLote && !preselectedLote) {
          if (modalLoteCodigo) modalLoteCodigo.value = activeCargaLote;
          isLoteCodigoCustomized = true;
        } else {
          regenerateLoteCodeSuggestion();
        }

        selectedLoteGuiaIds.clear();
        if (modalLoteGuiasSearch) modalLoteGuiasSearch.value = '';
        renderModalLoteGuias();

        populateModalEditLoteSelect(preselectedLote);

        if (preselectedLote) {
          switchGestionLotesTab('editar');
        } else {
          switchGestionLotesTab('crear');
        }

        modalGestionLotes.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
      (window as any).openGestionLotesModal = openGestionLotesModal;

      function closeGestionLotesModal() {
        if (modalGestionLotes) {
          modalGestionLotes.classList.add('hidden');
        }
        document.body.style.overflow = '';
      }
      (window as any).closeGestionLotesModal = closeGestionLotesModal;

      modalGestionLotes?.addEventListener('click', (e) => {
        if (e.target === modalGestionLotes) closeGestionLotesModal();
      });

      function switchGestionLotesTab(tab: 'crear' | 'editar') {
        const tabCrearBtn = document.getElementById('tab-btn-lote-crear');
        const tabEditarBtn = document.getElementById('tab-btn-lote-editar');
        const contentCrear = document.getElementById('tab-content-lote-crear');
        const contentEditar = document.getElementById('tab-content-lote-editar');

        if (tab === 'crear') {
          if (tabCrearBtn) tabCrearBtn.className = 'px-4 py-2.5 rounded-t-xl text-xs font-bold transition-all border-b-2 border-indigo-600 text-indigo-600 bg-white shadow-2xs flex items-center gap-1.5 cursor-pointer shrink-0';
          if (tabEditarBtn) tabEditarBtn.className = 'px-4 py-2.5 rounded-t-xl text-xs font-bold transition-all border-b-2 border-transparent text-slate-500 hover:text-slate-800 hover:bg-slate-100 flex items-center gap-1.5 cursor-pointer shrink-0';
          contentCrear?.classList.remove('hidden');
          contentEditar?.classList.add('hidden');
        } else {
          if (tabEditarBtn) tabEditarBtn.className = 'px-4 py-2.5 rounded-t-xl text-xs font-bold transition-all border-b-2 border-indigo-600 text-indigo-600 bg-white shadow-2xs flex items-center gap-1.5 cursor-pointer shrink-0';
          if (tabCrearBtn) tabCrearBtn.className = 'px-4 py-2.5 rounded-t-xl text-xs font-bold transition-all border-b-2 border-transparent text-slate-500 hover:text-slate-800 hover:bg-slate-100 flex items-center gap-1.5 cursor-pointer shrink-0';
          contentEditar?.classList.remove('hidden');
          contentCrear?.classList.add('hidden');
        }
      }
      (window as any).switchGestionLotesTab = switchGestionLotesTab;

      function onLoteFormDateChange(dateVal: string) {
        if (!dateVal) return;
        const d = new Date(dateVal + 'T12:00:00Z');
        if (isNaN(d.getTime())) return;

        const dayNum = d.getUTCDay() || 7;
        d.setUTCDate(d.getUTCDate() + 4 - dayNum);
        const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
        const weekNo = Math.ceil((((d.getTime() - yearStart.getTime()) / 86400000) + 1) / 7);
        const year = d.getUTCFullYear();
        const weekFormatted = weekNo < 10 ? '0' + weekNo : weekNo.toString();

        if (modalLoteWeekTag) {
          modalLoteWeekTag.textContent = `Semana ${weekFormatted} (${year})`;
        }

        if (!isLoteCodigoCustomized && modalLoteCodigo) {
          const origin = modalLoteOrigen ? modalLoteOrigen.value : 'BRM';
          modalLoteCodigo.value = `REL-${year}-W${weekFormatted}-${origin}`;
        }
      }
      (window as any).onLoteFormDateChange = onLoteFormDateChange;

      function onLoteFormOrigenChange(originVal: string) {
        if (!isLoteCodigoCustomized) {
          regenerateLoteCodeSuggestion();
        }
      }
      (window as any).onLoteFormOrigenChange = onLoteFormOrigenChange;

      function regenerateLoteCodeSuggestion() {
        isLoteCodigoCustomized = false;
        const dateVal = modalLoteFecha?.value || new Date().toISOString().split('T')[0];
        const originVal = modalLoteOrigen?.value || 'BRM';

        const d = new Date(dateVal + 'T12:00:00Z');
        const dayNum = d.getUTCDay() || 7;
        d.setUTCDate(d.getUTCDate() + 4 - dayNum);
        const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
        const weekNo = Math.ceil((((d.getTime() - yearStart.getTime()) / 86400000) + 1) / 7);
        const year = d.getUTCFullYear();
        const weekFormatted = weekNo < 10 ? '0' + weekNo : weekNo.toString();

        if (modalLoteCodigo) {
          modalLoteCodigo.value = `REL-${year}-W${weekFormatted}-${originVal}`;
        }
        if (modalLoteWeekTag) {
          modalLoteWeekTag.textContent = `Semana ${weekFormatted} (${year})`;
        }
      }
      (window as any).regenerateLoteCodeSuggestion = regenerateLoteCodeSuggestion;

      modalLoteCodigo?.addEventListener('input', () => {
        isLoteCodigoCustomized = true;
      });

      function renderModalLoteGuias() {
        if (!modalLoteGuiasList) return;

        const query = (modalLoteGuiasSearch?.value || '').toLowerCase().trim();
        const filtered = shipments.filter(g => {
          if (!query) return true;
          return g.id_guia.toLowerCase().includes(query) ||
                 (g.destinatario || '').toLowerCase().includes(query) ||
                 (g.ciudad_destino || '').toLowerCase().includes(query) ||
                 (g.lote_despacho || '').toLowerCase().includes(query);
        });

        if (filtered.length === 0) {
          modalLoteGuiasList.innerHTML = `
            <div class="p-6 text-center text-slate-400 text-xs font-medium">
              No se encontraron guías que coincidan con la búsqueda.
            </div>
          `;
          updateModalLoteSummary();
          return;
        }

        modalLoteGuiasList.innerHTML = filtered.map(g => {
          const isSelected = selectedLoteGuiaIds.has(g.id_guia);
          const weekInfo = getGuiaWeekInfo(g);
          const currentLote = g.lote_despacho || weekInfo.loteCode;

          return `
            <label class="flex items-center justify-between p-3 hover:bg-slate-50 transition-colors cursor-pointer text-xs gap-3">
              <div class="flex items-center gap-3 min-w-0">
                <input
                  type="checkbox"
                  value="${g.id_guia}"
                  ${isSelected ? 'checked' : ''}
                  onchange="window.toggleModalLoteGuia('${g.id_guia}', this.checked)"
                  class="w-4 h-4 text-indigo-600 rounded focus:ring-indigo-500 border-slate-300 cursor-pointer shrink-0"
                />
                <div class="min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-mono font-bold text-slate-900">#${g.id_guia}</span>
                    <span class="text-[10px] font-bold px-1.5 py-0.2 rounded bg-slate-100 text-slate-700 border border-slate-200 uppercase">${g.ciudad_destino || 'Sin Ciudad'}</span>
                    <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-indigo-50 text-indigo-700 border border-indigo-200" title="Lote actual">${currentLote}</span>
                  </div>
                  <p class="text-slate-600 font-medium truncate max-w-xs mt-0.5">${g.destinatario || '—'}</p>
                </div>
              </div>

              <div class="flex items-center gap-2 text-right shrink-0">
                <span class="font-mono font-bold text-[11px] text-slate-700 bg-slate-100 px-2 py-0.5 rounded-lg border border-slate-200">
                  ${g.piezas || 1} pza${(g.piezas || 1) !== 1 ? 's' : ''}${g.pies_cubicos ? ' · ' + Number(g.pies_cubicos).toFixed(2) + ' ft³' : ''}
                </span>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${g.estado === 'Entregado' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-amber-50 text-amber-800 border border-amber-200'}">
                  ${g.estado}
                </span>
              </div>
            </label>
          `;
        }).join('');

        updateModalLoteSummary();
      }

      function updateModalLoteSummary() {
        if (!modalLoteSelectedSummary) return;
        const selectedGuias = shipments.filter(g => selectedLoteGuiaIds.has(g.id_guia));
        const totalPzas = selectedGuias.reduce((acc, g) => acc + (g.piezas || 1), 0);
        const totalVol = selectedGuias.reduce((acc, g) => acc + (Number(g.pies_cubicos) || 0), 0);
        modalLoteSelectedSummary.textContent = `${selectedLoteGuiaIds.size} guías (${totalPzas} pzas${totalVol > 0 ? ' · ' + totalVol.toFixed(2) + ' ft³' : ''})`;
      }

      (window as any).toggleModalLoteGuia = (idGuia: string, checked: boolean) => {
        if (checked) {
          selectedLoteGuiaIds.add(idGuia);
        } else {
          selectedLoteGuiaIds.delete(idGuia);
        }
        updateModalLoteSummary();
      };

      (window as any).toggleSelectAllLoteGuias = (selectAll: boolean) => {
        const query = (modalLoteGuiasSearch?.value || '').toLowerCase().trim();
        const filtered = shipments.filter(g => {
          if (!query) return true;
          return g.id_guia.toLowerCase().includes(query) ||
                 (g.destinatario || '').toLowerCase().includes(query) ||
                 (g.ciudad_destino || '').toLowerCase().includes(query) ||
                 (g.lote_despacho || '').toLowerCase().includes(query);
        });

        if (selectAll) {
          filtered.forEach(g => selectedLoteGuiaIds.add(g.id_guia));
        } else {
          filtered.forEach(g => selectedLoteGuiaIds.delete(g.id_guia));
        }
        renderModalLoteGuias();
      };

      (window as any).filterModalLoteGuiasList = () => {
        renderModalLoteGuias();
      };

      function populateModalEditLoteSelect(preselectedLote?: string) {
        if (!modalEditLoteSelect) return;
        const loteMap: Record<string, { count: number; guias: GuiaRow[] }> = {};

        shipments.forEach(g => {
          const info = getGuiaWeekInfo(g);
          const code = g.lote_despacho || info.loteCode;
          if (!loteMap[code]) loteMap[code] = { count: 0, guias: [] };
          loteMap[code].count++;
          loteMap[code].guias.push(g);
        });

        let opts = `<option value="">Seleccione un lote para editar...</option>`;
        const sorted = Object.keys(loteMap).sort().reverse();
        sorted.forEach(lote => {
          opts += `<option value="${lote}">${lote} (${loteMap[lote].count} guías)</option>`;
        });
        modalEditLoteSelect.innerHTML = opts;

        if (preselectedLote && loteMap[preselectedLote]) {
          modalEditLoteSelect.value = preselectedLote;
          onEditLoteSelectChange(preselectedLote);
        } else if (sorted.length > 0) {
          modalEditLoteSelect.value = sorted[0];
          onEditLoteSelectChange(sorted[0]);
        }
      }

      function onEditLoteSelectChange(loteCode: string) {
        if (!loteCode) {
          if (modalEditLoteStats) modalEditLoteStats.classList.add('hidden');
          return;
        }

        const lotGuias = shipments.filter(g => (g.lote_despacho === loteCode) || (getGuiaWeekInfo(g).loteCode === loteCode));
        const totalPzas = lotGuias.reduce((acc, g) => acc + (g.piezas || 1), 0);
        const totalVol = lotGuias.reduce((acc, g) => acc + (Number(g.pies_cubicos) || 0), 0);
        
        let estimatedDate = '—';
        if (lotGuias.length > 0 && lotGuias[0].created_at) {
          estimatedDate = new Date(lotGuias[0].created_at).toISOString().split('T')[0];
        }

        if (modalEditLoteNewname) modalEditLoteNewname.value = loteCode;
        if (modalEditLoteNewdate && estimatedDate !== '—') modalEditLoteNewdate.value = estimatedDate;

        const statGuias = document.getElementById('edit-lote-stat-guias');
        const statPiezas = document.getElementById('edit-lote-stat-piezas');
        const statVolumen = document.getElementById('edit-lote-stat-volumen');
        const statFecha = document.getElementById('edit-lote-stat-fecha');

        if (statGuias) statGuias.textContent = lotGuias.length.toString();
        if (statPiezas) statPiezas.textContent = totalPzas.toString();
        if (statVolumen) statVolumen.textContent = `${totalVol.toFixed(2)} ft³`;
        if (statFecha) statFecha.textContent = estimatedDate;

        if (modalEditLoteStats) modalEditLoteStats.classList.remove('hidden');
      }
      (window as any).onEditLoteSelectChange = onEditLoteSelectChange;

      // Submit: Crear / Asignar Lote
      (window as any).submitCreateLoteForm = async () => {
        const codigo = (modalLoteCodigo?.value || '').trim().toUpperCase();
        const fecha = (modalLoteFecha?.value || '').trim();

        if (!codigo) {
          showToast('Debe ingresar un código para el lote de despacho', 'error');
          modalLoteCodigo?.focus();
          return;
        }

        const idsArray = Array.from(selectedLoteGuiaIds);

        const origHtml = btnSubmitCreateLote.innerHTML;
        btnSubmitCreateLote.disabled = true;
        btnSubmitCreateLote.innerHTML = `<span>Guardando...</span>`;

        try {
          const res = await fetch('/api/guias/lote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'assign',
              lote_despacho: codigo,
              fecha: fecha || undefined,
              guia_ids: idsArray
            })
          });

          const json = await res.json();
          if (res.ok && json.success) {
            showToast(json.message || `Lote ${codigo} guardado exitosamente`, 'success');

            if (idsArray.length > 0) {
              const isoDate = fecha ? new Date(fecha + 'T12:00:00Z').toISOString() : undefined;
              shipments = shipments.map(g => {
                if (selectedLoteGuiaIds.has(g.id_guia)) {
                  return {
                    ...g,
                    lote_despacho: codigo,
                    created_at: isoDate || g.created_at
                  };
                }
                return g;
              });
            }

            closeGestionLotesModal();
            updateLoteControls();
            populateCityFilter();
            renderViews();
          } else {
            showToast(json.message || 'Error al guardar el lote', 'error');
          }
        } catch (e) {
          showToast('Error de conexión al procesar lote', 'error');
        } finally {
          btnSubmitCreateLote.disabled = false;
          btnSubmitCreateLote.innerHTML = origHtml;
        }
      };

      // Submit: Editar Lote Existente / Fecha
      (window as any).submitEditLoteForm = async () => {
        const oldLote = (modalEditLoteSelect?.value || '').trim();
        const newLote = (modalEditLoteNewname?.value || '').trim().toUpperCase();
        const newDate = (modalEditLoteNewdate?.value || '').trim();
        const updateDateAll = modalEditLoteUpdateDateAll?.checked;

        if (!oldLote) {
          showToast('Seleccione el lote que desea editar', 'error');
          return;
        }

        if (!newLote) {
          showToast('El código del lote no puede quedar vacío', 'error');
          return;
        }

        const origHtml = btnSubmitEditLote.innerHTML;
        btnSubmitEditLote.disabled = true;
        btnSubmitEditLote.innerHTML = `<span>Actualizando...</span>`;

        try {
          const res = await fetch('/api/guias/lote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'edit_lote',
              old_lote: oldLote,
              new_lote: newLote,
              fecha: updateDateAll && newDate ? newDate : undefined
            })
          });

          const json = await res.json();
          if (res.ok && json.success) {
            showToast(json.message || `Lote ${newLote} actualizado exitosamente`, 'success');

            const isoDate = (updateDateAll && newDate) ? new Date(newDate + 'T12:00:00Z').toISOString() : undefined;
            shipments = shipments.map(g => {
              const info = getGuiaWeekInfo(g);
              const gCode = g.lote_despacho || info.loteCode;
              if (gCode === oldLote || g.lote_despacho === oldLote) {
                return {
                  ...g,
                  lote_despacho: newLote,
                  created_at: isoDate || g.created_at
                };
              }
              return g;
            });

            closeGestionLotesModal();
            updateLoteControls();
            populateCityFilter();
            renderViews();
          } else {
            showToast(json.message || 'Error al actualizar lote', 'error');
          }
        } catch (e) {
          showToast('Error de conexión al actualizar lote', 'error');
        } finally {
          btnSubmitEditLote.disabled = false;
          btnSubmitEditLote.innerHTML = origHtml;
        }
      };

      // Archivar guía individual
      (window as any).archivarGuia = async (idGuia: string) => {
        if (!idGuia) return;
        if (!confirm(`¿Deseas archivar la guía #${idGuia} hacia el histórico?`)) return;

        try {
          const res = await fetch('/api/guias/archivar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id_guia: idGuia })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            showToast(data.message || `Guía #${idGuia} archivada al histórico exitosamente`, 'success');
            shipments = shipments.filter(g => g.id_guia !== idGuia);
            populateCityFilter();
            updateLoteControls();
            renderViews();
          } else {
            showToast(data.message || 'Error al archivar la guía', 'error');
          }
        } catch (e) {
          showToast('Error de conexión al archivar guía', 'error');
        }
      };

      // Archivar en lote todas las guías entregadas
      (window as any).archivarEntregadas = async () => {
        const entregadas = shipments.filter(g => g.estado === 'Entregado');
        if (entregadas.length === 0) {
          showToast('No hay guías entregadas activas para archivar en este momento.', 'info');
          return;
        }

        const confirmMsg = currentLoteFilter !== 'ALL'
          ? `¿Deseas archivar las ${entregadas.length} guías entregadas activas al histórico?`
          : `¿Deseas archivar las ${entregadas.length} guías entregadas al histórico para liberar la lista activa?`;

        if (!confirm(confirmMsg)) return;

        const btn = document.getElementById('btn-archive-delivered-batch') as HTMLButtonElement;
        const originalHtml = btn ? btn.innerHTML : '';
        if (btn) {
          btn.disabled = true;
          btn.innerHTML = `<span>Archivando...</span>`;
        }

        try {
          const res = await fetch('/api/guias/archivar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              all_entregadas: true,
              lote_despacho: currentLoteFilter === 'ALL' ? undefined : currentLoteFilter 
            })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            showToast(data.message || `${entregadas.length} guías archivadas al histórico exitosamente`, 'success');
            const archivedIds = new Set(data.data?.ids || entregadas.map(g => g.id_guia));
            shipments = shipments.filter(g => !archivedIds.has(g.id_guia));
            populateCityFilter();
            updateLoteControls();
            renderViews();
          } else {
            showToast(data.message || 'Error al archivar guías', 'error');
          }
        } catch (e) {
          showToast('Error de conexión al archivar guías entregadas', 'error');
        } finally {
          if (btn) {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
          }
        }
      };

      // Desarchivar / Restaurar guía desde el Historial
      (window as any).desarchivarGuia = async (idGuia: string) => {
        if (!idGuia) return;
        if (!confirm(`¿Deseas restaurar la guía #${idGuia} a la lista de envíos activos?`)) return;

        try {
          const res = await fetch('/api/guias/desarchivar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id_guia: idGuia })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            showToast(data.message || `Guía #${idGuia} restaurada a envíos activos`, 'success');
            const gRes = await fetch('/api/guias');
            if (gRes.ok) {
              const gData = await gRes.json();
              if (gData.success && Array.isArray(gData.data)) {
                shipments = gData.data;
                populateCityFilter();
                updateLoteControls();
              }
            }
            if (currentViewMode === 'historial') {
              (window as any).filterHistorialData();
            }
            renderViews();
          } else {
            showToast(data.message || 'Error al restaurar guía', 'error');
          }
        } catch (e) {
          showToast('Error de conexión al restaurar guía', 'error');
        }
      };

      // Actualizar contadores KPI
      function updateKPIs() {
        if (!kpiTotal) return;
        kpiTotal.textContent = shipments.length.toString();
        kpiContactar.textContent = shipments.filter(s => s.estado === 'Por contactar').length.toString();
        kpiRuta.textContent = shipments.filter(s => s.estado === 'En ruta').length.toString();
        kpiGps.textContent = shipments.filter(s => s.gps_confirmado === true).length.toString();

        const gpsCount = shipments.filter(s => s.gps_confirmado && s.gps_latitud && s.gps_longitud).length;
        const pendGpsCount = shipments.filter(s => !s.gps_confirmado || !s.gps_latitud).length;

        if (mapaCountPill) {
          mapaCountPill.textContent = gpsCount.toString();
          mapaCountPill.className = gpsCount > 0
            ? 'text-[10px] bg-emerald-100 text-emerald-800 px-1.5 py-0.2 rounded-full font-bold'
            : 'text-[10px] bg-slate-300/80 text-slate-700 px-1.5 py-0.2 rounded-full font-bold';
        }

        const pendingGpsCountPill = document.getElementById('pending-gps-count-pill');
        if (pendingGpsCountPill) {
          pendingGpsCountPill.textContent = pendGpsCount.toString();
          pendingGpsCountPill.className = pendGpsCount > 0
            ? 'text-[10px] bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full font-bold'
            : 'text-[10px] bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-bold';
        }
      }

      // Filtrar guías según búsqueda, selects y Lotes / Semanas Operativas
      function getFilteredShipments(): GuiaRow[] {
        const query = searchInput.value.toLowerCase().trim();
        const cityFilter = filterCiudad.value;
        const statusFilter = filterEstado.value;
        const empresaFilter = filterEmpresa ? filterEmpresa.value : 'ALL';
        const listinFilter = filterListin ? filterListin.value : 'ALL';

        return shipments.filter(item => {
          const weekInfo = getGuiaWeekInfo(item);

          // Filtro por Lote / Semana Operativa
          let matchLote = true;
          if (currentLoteFilter === 'CURRENT_WEEK') {
            matchLote = weekInfo.isCurrentWeek;
          } else if (currentLoteFilter === 'PENDING_PAST') {
            matchLote = weekInfo.isPastPending;
          } else if (currentLoteFilter !== 'ALL') {
            matchLote = (item.lote_despacho === currentLoteFilter) || (weekInfo.loteCode === currentLoteFilter);
          }

          const matchQuery = (item.id_guia && item.id_guia.toLowerCase().includes(query)) || 
                             (item.destinatario && item.destinatario.toLowerCase().includes(query)) ||
                             (item.telefono_principal && item.telefono_principal.includes(query)) ||
                             (item.telefono_secundario && item.telefono_secundario.includes(query)) ||
                             (item.ciudad_destino && item.ciudad_destino.toLowerCase().includes(query)) ||
                             (item.empresa && item.empresa.toLowerCase().includes(query)) ||
                             (item.lote_despacho && item.lote_despacho.toLowerCase().includes(query));
          const matchCity = cityFilter === 'ALL' || item.ciudad_destino === cityFilter;
          const matchStatus = statusFilter === 'ALL' || item.estado === statusFilter;
          const matchEmpresa = empresaFilter === 'ALL' || (item.empresa && item.empresa.trim().toLowerCase() === empresaFilter.trim().toLowerCase());
          const isInListin = Boolean((item.orden_ruta && item.orden_ruta > 0) || item.estado === 'En ruta' || item.estado === 'Entregado');
          const matchListin = listinFilter === 'ALL' || (listinFilter === 'EN_LISTIN' ? isInListin : !isInListin);

          return matchLote && matchQuery && matchCity && matchStatus && matchEmpresa && matchListin;
        });
      }

      // Render Principal de Vistas
      function renderViews() {
        if (isLoading) return;

        updateLoteControls();
        const filtered = getFilteredShipments();
        filteredCountBadge.textContent = `${filtered.length} de ${shipments.length} guías`;
        updateKPIs();

        if (filtered.length === 0 && currentViewMode !== 'historial' && currentViewMode !== 'escaneos' && currentViewMode !== 'listin' && currentViewMode !== 'directorio') {
          tableBody.innerHTML = '';
          viewContainerCities.innerHTML = '';
          if (viewContainerDrivers) viewContainerDrivers.innerHTML = '';
          emptyState.classList.remove('hidden');
          return;
        }

        emptyState.classList.add('hidden');

        if (currentViewMode === 'table') {
          renderTable(filtered);
        } else if (currentViewMode === 'cities') {
          renderCitiesGrouped(filtered);
        } else if (currentViewMode === 'drivers') {
          renderDriversView(filtered);
        } else if (currentViewMode === 'mapa') {
          renderClientLocationsSection();
        } else if (currentViewMode === 'directorio') {
          renderDirectorioView();
        } else if (currentViewMode === 'escaneos') {
          const _loadEscaneos = typeof loadAndRenderEscaneos !== 'undefined' ? loadAndRenderEscaneos : (window as any).loadAndRenderEscaneos;
          if (typeof _loadEscaneos === 'function') _loadEscaneos();
        } else if (currentViewMode === 'listin') {
          renderListinView();
        } else if (currentViewMode === 'historial') {
          renderHistorialView();
        }
      }

      // ==========================================
      // RENDER VISTA 1: TABLA
      // ==========================================
      function normalizeClientKey(name?: string, city?: string): string {
        const normName = (name || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
        const normCity = (city || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
        return normName + '|' + normCity;
      }

      function renderTable(filtered: GuiaRow[]) {
        tableBody.innerHTML = filtered.map(item => createRowHTML(item)).join('');
      }

      function createRowHTML(item: GuiaRow): string {
        const weekInfo = getGuiaWeekInfo(item);
        let badgeColor = 'bg-slate-100 text-slate-700 border-slate-200';
        if (item.estado === 'Por contactar') badgeColor = 'bg-amber-50 text-amber-700 border-amber-200/80';
        if (item.estado === 'Contactado') badgeColor = 'bg-sky-50 text-sky-700 border-sky-200/80';
        if (item.estado === 'En ruta') badgeColor = 'bg-indigo-50 text-indigo-700 border-indigo-200/80';
        if (item.estado === 'Entregado') badgeColor = 'bg-emerald-50 text-emerald-700 border-emerald-200/80';
        if (item.estado === 'No entregado') badgeColor = 'bg-rose-50 text-rose-700 border-rose-200/80';

        const isGpsConfirmed = item.gps_confirmado === true;
        let gpsCellHtml = '';
        if (isGpsConfirmed && item.gps_latitud && item.gps_longitud) {
          gpsCellHtml = `
            <div class="inline-flex items-center gap-1">
              <a
                href="https://www.google.com/maps?q=${item.gps_latitud},${item.gps_longitud}"
                target="_blank"
                title="Abrir coordenadas en Google Maps (${item.gps_latitud}, ${item.gps_longitud})"
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold border bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100 hover:border-emerald-300 transition-colors group cursor-pointer"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>Confirmada</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-emerald-600 opacity-70 group-hover:opacity-100 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
              <button
                type="button"
                onclick="window.openGpsAssignModal('${item.id_guia}')"
                class="p-1 rounded-lg hover:bg-slate-200/80 text-slate-400 hover:text-slate-700 transition-colors cursor-pointer"
                title="Editar o fijar coordenadas GPS"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
              </button>
            </div>
          `;
        } else if (isGpsConfirmed) {
          gpsCellHtml = `
            <div class="inline-flex items-center gap-1">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold border bg-emerald-50 text-emerald-700 border-emerald-200">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>Confirmada</span>
              </span>
              <button
                type="button"
                onclick="window.openGpsAssignModal('${item.id_guia}')"
                class="p-1 rounded-lg hover:bg-slate-200/80 text-slate-400 hover:text-slate-700 transition-colors cursor-pointer"
                title="Fijar coordenadas exactas"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </button>
            </div>
          `;
        } else {
          gpsCellHtml = `
            <button
              type="button"
