            await fetch(`/api/escaneos/${activeEscaneoId}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ accion: 'rechazar' })
            });
            // Remover de la lista plana y avanzar
            drawerFotosFlat.splice(drawerCurrentIndex, 1);
            if (drawerFotosFlat.length === 0) { closeDrawer(); loadAndRenderEscaneos(); return; }
            if (drawerCurrentIndex >= drawerFotosFlat.length) drawerCurrentIndex = drawerFotosFlat.length - 1;
