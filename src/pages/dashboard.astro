      // 0. Imprimir Directamente o Guardar como PDF Vectorial Nativo
      function printListinDirect(isAllZones: boolean = false) {
        const srcShipments = getListinSourceShipments();
        if (srcShipments.length === 0) {
          showToast('No hay guías activas para imprimir el listín', 'error');
          return;
        }

        const selectedDriverOption = listinDriverSelect?.options[listinDriverSelect.selectedIndex];
        let driverName = selectedDriverOption && listinDriverSelect.value !== 'ALL' 
          ? selectedDriverOption.text.replace(/\s*\(ID:.*?\)\s*/g, '') 
          : 'FLOTA CENTRAL / DESPACHO GENERAL';
        let placa = listinPlacaInput?.value?.trim()?.toUpperCase() || 'NO ASIGNADA';
        const fecha = listinFechaInput?.value || new Date().toISOString().split('T')[0];

        let htmlToPrint = '';

        if (isAllZones) {
          if (listinViewSubMode === 'routes') {
            const routes = getListinRoutes(srcShipments).filter(r => !listinExcludedRoutes.has(r.key));
            routes.forEach(route => {
              const rGuias = route.guias.filter(g => !listinExcludedGuiaIds.has(g.id_guia));
              if (rGuias.length === 0) return;
              const totalGuias = rGuias.length;
              const totalPiezas = rGuias.reduce((acc, g) => acc + (g.piezas || 1), 0);
              const totalVolumen = rGuias.reduce((acc, g) => acc + (Number(g.pies_cubicos) || 0), 0);
              const rCities = route.cities.join(' · ');
              htmlToPrint += createListinHtmlPage({
                cityName: `RUTA: ${route.driverName} • ${rCities}`,
                zoneGuias: rGuias,
                driverName: route.driverName,
                placa: route.driverPlaca || placa,
                fecha,
                totalGuias,
                totalPiezas,
                totalVolumen,
                totalZonas: route.cities.length,
                isMultiPage: true
              });
            });
          } else {
            const activeCities = listinCitiesOrder.filter(c => !listinExcludedCities.has(c));
