            populateCityFilter();
            renderViews();
            closeEditGuiaModal();
            showToast(`Guía #${id_guia} actualizada correctamente`, 'success');
          } else {
            showToast(json.message || 'Error al actualizar la guía', 'error');
          }
        } catch (err) {
          console.error('Error al actualizar guía:', err);
          showToast('Error de conexión al actualizar la guía', 'error');
        } finally {
          editGuiaSaveBtn.disabled = false;
          editGuiaSaveBtn.innerHTML = origHtml;
        }
      });

      // Lightbox para ver fotos de comprobantes y guías con ZOOM y PAN
      const lightboxModal = document.getElementById('lightbox-modal') as HTMLElement;
      const lightboxCloseBtn = document.getElementById('lightbox-close-btn') as HTMLElement;
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
      const lightboxTitle = document.getElementById('lightbox-title') as HTMLElement;
      const lightboxInfo = document.getElementById('lightbox-info') as HTMLElement;
      const lightboxExternalLink = document.getElementById('lightbox-external-link') as HTMLAnchorElement;
      const lightboxDeleteBtn = document.getElementById('lightbox-delete-btn') as HTMLButtonElement;
      const lightboxViewport = document.getElementById('lightbox-viewport') as HTMLElement;
      const lightboxZoomIn = document.getElementById('lightbox-zoom-in') as HTMLButtonElement;
      const lightboxZoomOut = document.getElementById('lightbox-zoom-out') as HTMLButtonElement;
      const lightboxZoomReset = document.getElementById('lightbox-zoom-reset') as HTMLButtonElement;
      const lightboxZoomLevel = document.getElementById('lightbox-zoom-level') as HTMLElement;
      const lightboxRotate = document.getElementById('lightbox-rotate') as HTMLButtonElement;

      let zoomScale = 1;
      let panX = 0;
      let panY = 0;
      let rotation = 0;
      let isPanning = false;
      let startX = 0;
      let startY = 0;

      let currentLightboxTargetId: string | number | null = null;
      let currentLightboxTargetType: 'guia' | 'escaneo' | null = null;

      function applyTransform() {
        if (!lightboxImg) return;
        lightboxImg.style.transform = `translate(${panX}px, ${panY}px) scale(${zoomScale}) rotate(${rotation}deg)`;
        if (lightboxZoomLevel) {
          lightboxZoomLevel.textContent = `${Math.round(zoomScale * 100)}%`;
        }
      }

      function resetZoom() {
        zoomScale = 1;
        panX = 0;
        panY = 0;
        rotation = 0;
        applyTransform();
      }

      function setZoom(newScale: number) {
        zoomScale = Math.min(Math.max(0.5, newScale), 5.0);
        if (zoomScale === 1) {
          panX = 0;
          panY = 0;
        }
        applyTransform();
      }

      (window as any).openLightbox = (imgUrl: string, title?: string, info?: string, targetId?: string | number, targetType?: 'guia' | 'escaneo') => {
        if (!lightboxModal || !lightboxImg) return;
        resetZoom();
        lightboxImg.src = imgUrl;
        if (lightboxTitle) lightboxTitle.textContent = title || 'Visualizador de Imagen';
        if (lightboxInfo) lightboxInfo.textContent = info || '';
        if (lightboxExternalLink) lightboxExternalLink.href = imgUrl;

        currentLightboxTargetId = targetId || null;
        currentLightboxTargetType = targetType || (targetId ? 'guia' : null);

        if (lightboxDeleteBtn) {
          if (currentLightboxTargetId) {
            lightboxDeleteBtn.classList.remove('hidden');
          } else {
            lightboxDeleteBtn.classList.add('hidden');
          }
        }

        lightboxModal.classList.remove('hidden');
        lightboxModal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      };

      // Handler para eliminar foto desde el Lightbox
      lightboxDeleteBtn?.addEventListener('click', async () => {
        if (!currentLightboxTargetId) return;

        const isGuia = currentLightboxTargetType === 'guia' || !currentLightboxTargetType;
        const confirmMsg = isGuia
          ? `¿Estás seguro de que deseas eliminar la foto de la guía #${currentLightboxTargetId}?`
          : `¿Estás seguro de que deseas eliminar esta foto de escaneo?`;

        if (!confirm(confirmMsg)) return;

        const originalHtml = lightboxDeleteBtn.innerHTML;
        lightboxDeleteBtn.disabled = true;
        lightboxDeleteBtn.innerHTML = `
          <svg class="animate-spin w-3.5 h-3.5 text-rose-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          <span>Eliminando...</span>
        `;

        try {
          const endpoint = isGuia
            ? `/api/guias/${currentLightboxTargetId}/foto`
            : `/api/escaneos/${currentLightboxTargetId}`;

          const res = await fetch(endpoint, { method: 'DELETE' });
          const data = await res.json();

          if (res.ok && data.success) {
            showToast(data.message || 'Foto eliminada correctamente', 'success');

            if (isGuia) {
              // Actualizar en el estado local de guías en memoria
              const targetIdStr = currentLightboxTargetId.toString().toUpperCase();
              const guiaFound = shipments.find(g => g.id_guia && g.id_guia.toUpperCase() === targetIdStr);
              if (guiaFound) {
                guiaFound.comprobante_url = null;
                guiaFound.comprobante_base64 = null;
                guiaFound.recibido_por = null;
              }
              // Re-renderizar las vistas activas
              renderViews();
            } else {
              loadAndRenderEscaneos();
            }

            closeLightboxModal();
          } else {
            showToast(data.message || 'Error al eliminar la foto', 'error');
          }
        } catch (error: any) {
          showToast('Error de conexión al eliminar la foto', 'error');
        } finally {
          lightboxDeleteBtn.disabled = false;
          lightboxDeleteBtn.innerHTML = originalHtml;
        }
      });

      function closeLightboxModal() {
        lightboxModal?.classList.add('hidden');
        lightboxModal?.classList.remove('flex');
        if (lightboxImg) lightboxImg.src = '';
        resetZoom();
        const escaneoDrawerEl = document.getElementById('escaneo-drawer');
        if (!escaneoDrawerEl || escaneoDrawerEl.classList.contains('hidden')) {
          document.body.style.overflow = '';
        }
      }

      // Eventos de Zoom
      lightboxZoomIn?.addEventListener('click', () => setZoom(zoomScale + 0.3));
      lightboxZoomOut?.addEventListener('click', () => setZoom(zoomScale - 0.3));
      lightboxZoomReset?.addEventListener('click', () => resetZoom());
      lightboxRotate?.addEventListener('click', () => {
        rotation = (rotation + 90) % 360;
        applyTransform();
      });

      // Zoom con rueda del ratón
      lightboxViewport?.addEventListener('wheel', (e) => {
        e.preventDefault();
        const delta = e.deltaY > 0 ? -0.2 : 0.2;
        setZoom(zoomScale + delta);
      }, { passive: false });

      // Arrastre (Pan) con ratón
      lightboxViewport?.addEventListener('mousedown', (e) => {
        if (e.target === lightboxCloseBtn || (e.target as HTMLElement).closest('button') || (e.target as HTMLElement).closest('a')) return;
        isPanning = true;
        startX = e.clientX - panX;
        startY = e.clientY - panY;
        lightboxViewport.classList.add('cursor-grabbing');
      });

      window.addEventListener('mousemove', (e) => {
        if (!isPanning) return;
        panX = e.clientX - startX;
        panY = e.clientY - startY;
        applyTransform();
      });

      window.addEventListener('mouseup', () => {
        if (isPanning) {
          isPanning = false;
          lightboxViewport?.classList.remove('cursor-grabbing');
        }
      });

      // Soporte para gestos táctiles (Touch)
      let touchStartX = 0;
      let touchStartY = 0;
      let initialPinchDistance = 0;
      let initialPinchScale = 1;

      lightboxViewport?.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          isPanning = true;
          touchStartX = e.touches[0].clientX - panX;
          touchStartY = e.touches[0].clientY - panY;
        } else if (e.touches.length === 2) {
          isPanning = false;
          initialPinchDistance = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
          initialPinchScale = zoomScale;
        }
      }, { passive: true });

      lightboxViewport?.addEventListener('touchmove', (e) => {
        if (isPanning && e.touches.length === 1) {
          panX = e.touches[0].clientX - touchStartX;
          panY = e.touches[0].clientY - touchStartY;
          applyTransform();
        } else if (e.touches.length === 2 && initialPinchDistance > 0) {
          const currentDistance = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
          const factor = currentDistance / initialPinchDistance;
          setZoom(initialPinchScale * factor);
        }
      }, { passive: true });

      lightboxViewport?.addEventListener('touchend', () => {
        isPanning = false;
        initialPinchDistance = 0;
      });

      lightboxCloseBtn?.addEventListener('click', closeLightboxModal);
      lightboxModal?.addEventListener('click', (e) => {
        if (e.target === lightboxModal) {
          closeLightboxModal();
        }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lightboxModal && !lightboxModal.classList.contains('hidden')) {
          closeLightboxModal();
        }
      });


      // Despachar a Ruta directamente desde la vista de choferes
      (window as any).dispatchDriverToRoute = async (driverId: number) => {
        const driverObj = drivers.find(d => d.id === driverId);
        const driverName = driverObj ? driverObj.nombre : 'Chofer';
        
        try {
          const res = await fetch('/api/guias/lote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              chofer_id: driverId,
              cambiar_estado: 'En ruta'
            })
          });

          const json = await res.json();
          if (res.ok && json.success) {
            shipments.forEach(s => {
              if (s.chofer_asignado_id === driverId && s.estado !== 'Entregado') {
                s.estado = 'En ruta';
              }
            });
            renderViews();
            updateKPIs();
            showToast(`¡Ruta despachada a ${driverName}! Las guías pasaron a En Ruta.`, 'success');
          } else {
            showToast(json.message || 'Error al despachar ruta', 'error');
          }
        } catch (err) {
          showToast('Error de red al despachar la ruta', 'error');
        }
      };

      // ============================================
      // MÓDULO DE HISTORIAL Y ARCHIVO DE RUTAS
      // ============================================

      function populateHistorialDriverFilter() {
        if (!historialFilterDriver) return;
        const curr = historialFilterDriver.value;
        historialFilterDriver.innerHTML = '<option value="ALL">Todos los Choferes</option>';
        drivers.forEach(d => {
          const opt = document.createElement('option');
          opt.value = d.id.toString();
          opt.textContent = d.nombre;
          historialFilterDriver.appendChild(opt);
        });
        if (curr) historialFilterDriver.value = curr;
      }

      (window as any).handleHistorialPeriodChange = function() {
        if (!historialFilterPeriodo) return;
        const val = historialFilterPeriodo.value;
        if (historialCustomDateContainer) {
          if (val === 'CUSTOM') {
            historialCustomDateContainer.classList.remove('hidden');
            historialCustomDateContainer.classList.add('flex');
          } else {
            historialCustomDateContainer.classList.add('hidden');
            historialCustomDateContainer.classList.remove('flex');
          }
        }
        (window as any).loadHistorialData();
      };

      (window as any).loadHistorialData = async function(isManualRefresh?: boolean) {
        populateHistorialDriverFilter();
        const refreshIcon = document.getElementById('historial-refresh-icon');
        if (isManualRefresh && refreshIcon) refreshIcon.classList.add('animate-spin');
        if (historialLoading && historialRoutes.length === 0) historialLoading.classList.remove('hidden');

        try {
          const params = new URLSearchParams();
          const driverVal = historialFilterDriver?.value;
          if (driverVal && driverVal !== 'ALL') {
            params.set('chofer_id', driverVal);
          }

          const periodVal = historialFilterPeriodo?.value || 'ALL';
          const now = new Date();

          if (periodVal === 'TODAY') {
            const todayStr = now.toISOString().slice(0, 10);
            params.set('fecha_desde', todayStr);
            params.set('fecha_hasta', todayStr);
          } else if (periodVal === '7DAYS') {
            const d7 = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
            params.set('fecha_desde', d7.toISOString().slice(0, 10));
            params.set('fecha_hasta', now.toISOString().slice(0, 10));
          } else if (periodVal === '30DAYS') {
            const d30 = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
            params.set('fecha_desde', d30.toISOString().slice(0, 10));
            params.set('fecha_hasta', now.toISOString().slice(0, 10));
          } else if (periodVal === 'CUSTOM' && historialDateFrom?.value) {
            params.set('fecha_desde', historialDateFrom.value);
            params.set('fecha_hasta', historialDateFrom.value);
          }

          const q = historialSearchInput?.value?.trim() || '';
          if (q) params.set('q', q);

          const res = await fetch(`/api/rutas/historial?${params.toString()}`);
          if (res.ok) {
            const json = await res.json();
            if (json.success && Array.isArray(json.data)) {
              historialRoutes = json.data;
              if (historialCountPill) {
                historialCountPill.textContent = historialRoutes.length.toString();
              }
              if (historialBadgeCount) {
                historialBadgeCount.textContent = `${historialRoutes.length} ruta${historialRoutes.length !== 1 ? 's' : ''} archivada${historialRoutes.length !== 1 ? 's' : ''}`;
              }
              (window as any).filterHistorialData();
              if (isManualRefresh) {
                showToast('Historial de rutas actualizado', 'success');
              }
            }
          }
        } catch (err) {
          console.error('Error cargando historial de rutas:', err);
          if (isManualRefresh) showToast('Error al consultar historial de rutas', 'error');
        } finally {
          if (historialLoading) historialLoading.classList.add('hidden');
          if (isManualRefresh && refreshIcon) refreshIcon.classList.remove('animate-spin');
        }
      };

      (window as any).filterHistorialData = function() {
        const query = (historialSearchInput?.value || '').toLowerCase().trim();
        if (!query) {
          filteredHistorialRoutes = [...historialRoutes];
        } else {
          filteredHistorialRoutes = historialRoutes.filter((r: any) => {
            const matchCode = (r.codigo_ruta || '').toLowerCase().includes(query);
            const matchDriver = (r.chofer_nombre || '').toLowerCase().includes(query);
            const matchOrig = (r.ruta_origen || '').toLowerCase().includes(query);
            const matchDest = (r.ruta_destino || '').toLowerCase().includes(query);
            const matchSnapshot = JSON.stringify(r.guias_snapshot || []).toLowerCase().includes(query);
            return matchCode || matchDriver || matchOrig || matchDest || matchSnapshot;
          });
        }
        renderHistorialView();
      };

      function renderHistorialView() {
        if (!historialRoutesList || !historialEmpty) return;

        if (filteredHistorialRoutes.length === 0) {
          historialRoutesList.innerHTML = '';
          historialEmpty.classList.remove('hidden');
          return;
        }

        historialEmpty.classList.add('hidden');

        historialRoutesList.innerHTML = filteredHistorialRoutes.map((r: any) => {
          const isExpanded = expandedHistorialRouteIds.has(r.id);
          const guias: any[] = Array.isArray(r.guias_snapshot) ? r.guias_snapshot : [];
          const fechaObj = new Date(r.fecha_finalizacion);
          const fechaFormatted = isNaN(fechaObj.getTime())
            ? r.fecha_finalizacion
            : fechaObj.toLocaleDateString('es-VE', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true });

          const driverInitials = (r.chofer_nombre || 'CH').split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
          const efectividad = r.porcentaje_efectividad ?? (r.total_guias > 0 ? Math.round((r.total_entregadas / r.total_guias) * 100) : 0);

          return `
            <div class="bg-white border border-slate-200/90 rounded-3xl shadow-sm overflow-hidden transition-all duration-200">
              
              <!-- Cabecera de la Ruta Archivada -->
              <div class="p-4 sm:p-5 border-b border-slate-100 bg-gradient-to-r from-slate-50 via-white to-slate-50/50 flex flex-col xl:flex-row xl:items-center justify-between gap-4">
                
                <!-- Identidad del Chofer y Código -->
                <div class="flex items-center gap-3.5">
                  <div class="w-12 h-12 rounded-2xl bg-slate-900 text-white flex items-center justify-center font-extrabold text-sm shadow-md shrink-0">
                    ${driverInitials}
                  </div>
                  <div>
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="font-mono font-extrabold text-xs px-2.5 py-0.5 rounded-lg bg-slate-900 text-white shadow-2xs">
                        ${r.codigo_ruta}
                      </span>
                      <h4 class="text-sm sm:text-base font-extrabold text-slate-900">${r.chofer_nombre}</h4>
                      <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
                        ${r.finalizada_por || 'Finalizada'}
                      </span>
                    </div>

                    <div class="flex items-center gap-2 text-xs text-slate-500 font-medium mt-1 flex-wrap">
                      <span class="flex items-center gap-1">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <span class="font-semibold text-slate-700">${fechaFormatted}</span>
                      </span>
                      <span class="text-slate-300">•</span>
                      <span class="text-indigo-600 font-semibold truncate max-w-[280px]" title="${r.ruta_origen || 'Sede'} ➔ ${r.ruta_destino || 'Destino'}">
                        ${r.ruta_origen || 'Sede Barquisimeto'} ➔ ${r.ruta_destino || 'Destino'}
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Métricas Rápidas y Acciones -->
                <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
                  <!-- Píldoras de Balance -->
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="px-2.5 py-1 rounded-xl bg-slate-100 text-slate-800 text-xs font-bold border border-slate-200" title="Total guías">
                      ${r.total_guias} guías (${r.total_piezas || r.total_guias} pz)
                    </span>
                    <span class="px-2.5 py-1 rounded-xl bg-emerald-50 text-emerald-800 text-xs font-bold border border-emerald-200 flex items-center gap-1" title="Entregadas exitosamente">
                      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                      <span>${r.total_entregadas} entregadas</span>
                    </span>
                    ${r.total_no_entregadas > 0 ? `
                      <span class="px-2.5 py-1 rounded-xl bg-rose-50 text-rose-800 text-xs font-bold border border-rose-200 flex items-center gap-1" title="No entregadas / Incidencias">
                        <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                        <span>${r.total_no_entregadas} no entregadas</span>
                      </span>
                    ` : ''}
                    <span class="px-2.5 py-1 rounded-xl ${efectividad >= 90 ? 'bg-emerald-100 text-emerald-900' : 'bg-amber-100 text-amber-900'} text-xs font-extrabold border border-emerald-200">
                      ${efectividad}% efectividad
                    </span>
                  </div>

                  <!-- Botón Ver Desglose Guías -->
                  <button
                    type="button"
                    onclick="window.toggleHistorialRouteAccordion(${r.id})"
                    class="px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 cursor-pointer active:scale-95"
                  >
                    <span>${isExpanded ? 'Ocultar Guías' : `Ver Guías (${guias.length})`}</span>
                    <svg class="w-3.5 h-3.5 transition-transform ${isExpanded ? 'rotate-180' : ''}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                </div>

              </div>

              <!-- Sección Desplegable: Tabla Completa de Guías de la Ruta -->
              <div id="historial-accordion-${r.id}" class="${isExpanded ? '' : 'hidden'} p-4 sm:p-5 bg-slate-50/70 border-t border-slate-100 space-y-3">
                <div class="flex items-center justify-between">
                  <h5 class="text-xs font-extrabold text-slate-800 uppercase tracking-wider flex items-center gap-2">
                    <svg class="w-4 h-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                    <span>Detalle de Guías de la Ruta #${r.codigo_ruta}</span>
                  </h5>
                  <span class="text-xs font-semibold text-slate-500">${guias.length} paradas registradas</span>
                </div>

                <div class="overflow-x-auto custom-scrollbar bg-white rounded-2xl border border-slate-200/80 shadow-2xs">
                  <table class="w-full text-left text-xs border-collapse">
                    <thead>
                      <tr class="bg-slate-50 border-b border-slate-200 text-[10px] font-extrabold text-slate-500 uppercase tracking-wider">
                        <th class="py-2.5 px-3">#</th>
                        <th class="py-2.5 px-3">Guía & Empresa</th>
                        <th class="py-2.5 px-3">Destinatario & Teléfono</th>
                        <th class="py-2.5 px-3">Ciudad & Piezas</th>
                        <th class="py-2.5 px-3">Estado Final</th>
                        <th class="py-2.5 px-3">Recibido por / Detalle</th>
                        <th class="py-2.5 px-3 text-center">Comprobante</th>
                        <th class="py-2.5 px-3 text-right">Ubicación GPS</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                      ${guias.map((g: any, idx: number) => {
                        const isNoEnt = g.estado === 'No entregado';
                        const isEnt = g.estado === 'Entregado';
                        const phoneFormatted = formatPhoneForWhatsApp(g.telefono_principal || '');
                        const gmapsUrl = (g.gps_latitud && g.gps_longitud) 
                          ? `https://www.google.com/maps/search/?api=1&query=${g.gps_latitud},${g.gps_longitud}`
                          : null;

                        return `
                          <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="py-2.5 px-3 font-mono font-extrabold text-slate-400 text-[11px]">
                              ${g.orden_ruta || idx + 1}
                            </td>
                            <td class="py-2.5 px-3">
                              <div class="flex items-center gap-1.5 flex-wrap">
                                <a href="/confirmar?guia=${encodeURIComponent(g.id_guia)}" target="_blank" class="font-mono font-bold text-slate-900 hover:text-indigo-600">
                                  #${g.id_guia}
                                </a>
                                ${g.empresa ? `
                                  <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-purple-50 text-purple-700 border border-purple-200">
                                    ${g.empresa}
                                  </span>
                                ` : ''}
                              </div>
                            </td>
                            <td class="py-2.5 px-3">
                              <p class="font-bold text-slate-900 truncate max-w-[180px]">${g.destinatario || '—'}</p>
                              ${g.telefono_principal ? `
                                <a href="https://wa.me/${phoneFormatted}" target="_blank" class="text-[10px] text-slate-500 hover:text-emerald-700 flex items-center gap-1 font-mono">
                                  ${g.telefono_principal}
                                </a>
                              ` : ''}
                            </td>
                            <td class="py-2.5 px-3">
                              <p class="font-semibold text-slate-800">${g.ciudad_destino || '—'}</p>
                              <span class="text-[10px] text-slate-400 font-mono font-bold">${g.piezas || 1} pz</span>
                            </td>
                            <td class="py-2.5 px-3">
                              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold ${
                                isEnt ? 'bg-emerald-100 text-emerald-800' :
                                isNoEnt ? 'bg-rose-100 text-rose-800' :
                                'bg-slate-100 text-slate-700'
                              }">
                                ${isEnt ? `
                                  <svg class="w-3 h-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                  <span>Entregado</span>
                                ` : isNoEnt ? `
                                  <svg class="w-3 h-3 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                                  <span>No entregado</span>
                                ` : `
                                  <span>${g.estado}</span>
                                `}
                              </span>
                            </td>
                            <td class="py-2.5 px-3">
                              <p class="text-[11px] text-slate-700 font-medium truncate max-w-[200px]" title="${g.recibido_por || '—'}">
                                ${g.recibido_por || '<span class="text-slate-400 italic">Sin registro</span>'}
                              </p>
                            </td>
                            <td class="py-2.5 px-3 text-center">
                              ${g.comprobante_url ? `
                                <button
                                  type="button"
                                  onclick="window.openLightbox('${g.comprobante_url}', 'Comprobante Guía #${g.id_guia}', '${g.recibido_por ? `Recibido por: ${g.recibido_por.replace(/'/g, "\\'")}` : 'Comprobante de entrega'}', '${g.id_guia}', 'guia')"
                                  class="p-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 transition-all cursor-pointer inline-flex items-center gap-1 text-[10px] font-bold"
                                  title="Ver foto de comprobante"
                                >
                                  <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                  </svg>
                                  <span>Foto</span>
                                </button>
                              ` : `
                                <span class="text-[10px] text-slate-300 italic">—</span>
                              `}
                            </td>
                            <td class="py-2.5 px-3 text-right">
                              ${gmapsUrl ? `
                                <a
                                  href="${gmapsUrl}"
                                  target="_blank"
                                  class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 text-[10px] font-bold"
                                  title="Ver ubicación en Google Maps"
                                >
                                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                  <span>GPS</span>
                                </a>
                              ` : `
                                <span class="text-[10px] text-slate-300">—</span>
                              `}
                            </td>
                          </tr>
                        `;
                      }).join('')}
                    </tbody>
                  </table>
                </div>
              </div>

            </div>
          `;
        }).join('');
      }

      (window as any).toggleHistorialRouteAccordion = function(routeId: number) {
        if (expandedHistorialRouteIds.has(routeId)) {
          expandedHistorialRouteIds.delete(routeId);
        } else {
          expandedHistorialRouteIds.add(routeId);
        }
        renderHistorialView();
      };

      // Modal de Finalizar Ruta Logística
      (window as any).openFinalizarRutaModal = function(driverId: number) {
        activeFinChoferId = driverId;
        const driver = drivers.find(d => d.id === driverId);
        if (!driver) return;

        const driverGuias = shipments.filter(g => g.chofer_asignado_id === driverId);
        const total = driverGuias.length;
        const entregadas = driverGuias.filter(g => g.estado === 'Entregado').length;
        const noEntregadas = driverGuias.filter(g => g.estado === 'No entregado').length;
        const pendientes = driverGuias.filter(g => g.estado !== 'Entregado' && g.estado !== 'No entregado').length;

        if (modalFinChoferNombre) modalFinChoferNombre.textContent = driver.nombre;
        if (modalFinTotalGuias) modalFinTotalGuias.textContent = total.toString();
        if (modalFinEntregadas) modalFinEntregadas.textContent = entregadas.toString();
        if (modalFinNoEntregadas) modalFinNoEntregadas.textContent = noEntregadas.toString();

        if (pendientes > 0) {
          if (modalFinPendientesRow) modalFinPendientesRow.classList.remove('hidden');
          if (modalFinPendientes) modalFinPendientes.textContent = pendientes.toString();
          if (modalFinWarning) modalFinWarning.classList.remove('hidden');
        } else {
          if (modalFinPendientesRow) modalFinPendientesRow.classList.add('hidden');
          if (modalFinWarning) modalFinWarning.classList.add('hidden');
        }

        if (modalFinalizarRutaLogistica) {
          modalFinalizarRutaLogistica.classList.remove('hidden');
          modalFinalizarRutaLogistica.classList.add('flex');
        }
      };

      (window as any).closeFinalizarRutaModal = function() {
        activeFinChoferId = null;
        if (modalFinalizarRutaLogistica) {
          modalFinalizarRutaLogistica.classList.add('hidden');
          modalFinalizarRutaLogistica.classList.remove('flex');
        }
      };

      (window as any).confirmFinalizarRuta = async function() {
        if (!activeFinChoferId) return;
        const btn = btnConfirmFinalizarRutaLogistica;
        const origHtml = btn?.innerHTML || '';
        if (btn) {
          btn.innerHTML = '<span class="opacity-70">Finalizando...</span>';
          btn.disabled = true;
        }

        try {
          const res = await fetch('/api/rutas/finalizar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ chofer_id: activeFinChoferId })
          });
          const data = await res.json();

          if (res.ok && data.success) {
            (window as any).closeFinalizarRutaModal();
            showToast(data.message || 'Ruta finalizada y archivada exitosamente', 'success');
            await silentRefresh();
            await (window as any).loadHistorialData();
            renderViews();
          } else {
            showToast(data.message || 'Error al finalizar la ruta', 'error');
          }
        } catch (err) {
          showToast('Error de conexión al finalizar la ruta', 'error');
        } finally {
          if (btn) {
            btn.innerHTML = origHtml;
            btn.disabled = false;
          }
        }
      };

      // ==========================================
      // SELECTOR DE MAPA GPS (ORIGEN Y DESTINO)
      // ==========================================
      const mapPickerModal = document.getElementById('map-picker-modal') as HTMLElement;
      const mapPickerTitle = document.getElementById('map-picker-title') as HTMLElement;
      const mapPickerCloseBtn = document.getElementById('map-picker-close-btn') as HTMLElement;
      const mapPickerCancelBtn = document.getElementById('map-picker-cancel-btn') as HTMLElement;
      const mapPickerConfirmBtn = document.getElementById('map-picker-confirm-btn') as HTMLElement;
      const btnOpenStartMapPicker = document.getElementById('btn-open-start-map-picker') as HTMLButtonElement;
      const btnOpenEndMapPicker = document.getElementById('btn-open-end-map-picker') as HTMLButtonElement;
      const pickerCoordsText = document.getElementById('picker-coords-text') as HTMLElement;
      const pickerZoneName = document.getElementById('picker-zone-name') as HTMLElement;
      const pickerOlcBadge = document.getElementById('picker-olc-badge') as HTMLElement;
      const pickerOlcInput = document.getElementById('picker-olc-input') as HTMLInputElement;
      const pickerSearchInput = document.getElementById('picker-search-input') as HTMLInputElement;
      const pickerGmapsLink = document.getElementById('picker-gmaps-link') as HTMLAnchorElement;

      let pickerMap: any = null;
      let pickerMarker: any = null;
      let currentPickerMode: 'start' | 'end' = 'start';
      let selectedPickerCoords = [10.0808, -69.3756]; // Default Barquisimeto
      let selectedPickerLabel = 'Sede Principal Barquisimeto';

      function initPickerMap() {
        if (pickerMap || typeof (window as any).L === 'undefined') return;

        const L = (window as any).L;

        pickerMap = L.map('picker-map', {
          zoomControl: true,
          attributionControl: false
        }).setView(selectedPickerCoords, 13);

        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
          maxZoom: 19,
          subdomains: 'abcd'
        }).addTo(pickerMap);

        const customPinHtml = `
          <div class="relative flex items-center justify-center w-9 h-9 rounded-full bg-slate-900 border-2 border-white shadow-xl text-white text-xs font-black">
            <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
        `;

        const customPinIcon = L.divIcon({
          html: customPinHtml,
          className: 'picker-pin-icon',
          iconSize: [36, 36],
          iconAnchor: [18, 18]
        });

        pickerMarker = L.marker(selectedPickerCoords, {
          draggable: true,
          icon: customPinIcon
        }).addTo(pickerMap);

        pickerMarker.on('dragend', (e: any) => {
          const latlng = e.target.getLatLng();
          updatePickerCoords(latlng.lat, latlng.lng);
        });

        pickerMap.on('click', (e: any) => {
          pickerMarker.setLatLng(e.latlng);
          updatePickerCoords(e.latlng.lat, e.latlng.lng);
        });
      }

      function updatePickerCoords(lat: number, lon: number) {
        selectedPickerCoords = [lat, lon];
        const label = findClosestCity(lat, lon);
        selectedPickerLabel = label;
        const olcCode = encodeOLC(lat, lon, 10);

        if (pickerCoordsText) pickerCoordsText.textContent = `${lat.toFixed(4)}, ${lon.toFixed(4)}`;
        if (pickerOlcBadge) pickerOlcBadge.textContent = olcCode;
        if (pickerZoneName) pickerZoneName.textContent = label;
        if (pickerGmapsLink) {
          pickerGmapsLink.href = `https://www.google.com/maps/search/?api=1&query=${lat.toFixed(6)},${lon.toFixed(6)}`;
        }
      }

      (window as any).flyPickerToCoords = (lat: number, lon: number, label: string) => {
        selectedPickerCoords = [lat, lon];
        selectedPickerLabel = label;
        if (pickerMap) {
          pickerMap.setView([lat, lon], 14);
          if (pickerMarker) pickerMarker.setLatLng([lat, lon]);
        }
        updatePickerCoords(lat, lon);
      };

      (window as any).setOlcExample = (exampleText: string) => {
        if (pickerOlcInput) {
          pickerOlcInput.value = exampleText;
          (window as any).decodeAndApplyOlcInput();
        }
      };

      (window as any).decodeAndApplyOlcInput = () => {
        const raw = pickerOlcInput?.value?.trim();
        if (!raw) {
          showToast('Ingresa o pega coordenadas u OLC', 'info');
          return;
        }

        const parsed = parseUniversalLocation(raw);
        if (parsed) {
          (window as any).flyPickerToCoords(parsed.lat, parsed.lon, parsed.label);
          showToast(`¡Ubicación decodificada: ${parsed.label}!`, 'success');
        } else {
          showToast('No se pudieron decodificar las coordenadas u OLC ingresadas', 'error');
        }
      };

      pickerOlcInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          (window as any).decodeAndApplyOlcInput();
        }
      });

      pickerSearchInput?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value.trim();
        if (!val) return;
        const parsed = parseUniversalLocation(val);
        if (parsed) {
          (window as any).flyPickerToCoords(parsed.lat, parsed.lon, parsed.label);
        }
      });

      function openMapPicker(mode: 'start' | 'end') {
        currentPickerMode = mode;
        if (mapPickerTitle) {
          mapPickerTitle.textContent = mode === 'start' 
            ? 'Marcar Punto de Salida / Origen en el Mapa' 
            : 'Marcar Punto Final / Destino de Cierre en el Mapa';
        }

        const currentValue = mode === 'start' ? plannerStartInput.value.trim() : plannerEndInput.value.trim();
        
        // Intentar parsear el valor actual con el motor universal
        const parsedCurrent = parseUniversalLocation(currentValue);
        let initialCoords = [10.0808, -69.3756]; // Default Barquisimeto
        if (parsedCurrent) {
          initialCoords = [parsedCurrent.lat, parsedCurrent.lon];
        }

        selectedPickerCoords = initialCoords;
        selectedPickerLabel = currentValue || (mode === 'start' ? 'Sede Principal Barquisimeto' : 'Retorno a Sede Principal Barquisimeto');

        if (pickerOlcInput) {
          pickerOlcInput.value = '';
        }

        mapPickerModal?.classList.remove('hidden');
        mapPickerModal?.classList.add('flex');

        setTimeout(() => {
          initPickerMap();
          if (pickerMap) {
            pickerMap.invalidateSize();
            pickerMap.setView(selectedPickerCoords, 13);
            if (pickerMarker) pickerMarker.setLatLng(selectedPickerCoords);
          }
          updatePickerCoords(selectedPickerCoords[0], selectedPickerCoords[1]);
        }, 150);
      }

      (window as any).openMapPicker = openMapPicker;

      btnOpenStartMapPicker?.addEventListener('click', () => openMapPicker('start'));
      btnOpenEndMapPicker?.addEventListener('click', () => openMapPicker('end'));

      function closeMapPicker() {
        mapPickerModal?.classList.add('hidden');
        mapPickerModal?.classList.remove('flex');
      }

      mapPickerCloseBtn?.addEventListener('click', closeMapPicker);
      mapPickerCancelBtn?.addEventListener('click', closeMapPicker);

      mapPickerConfirmBtn?.addEventListener('click', () => {
        if (currentPickerMode === 'start') {
          plannerStartInput.value = selectedPickerLabel;
          onOriginLocationChanged(true);
        } else {
          plannerEndInput.value = selectedPickerLabel;
          onDestinationLocationChanged();
        }
        closeMapPicker();
        showToast(`Ubicación seleccionada en el mapa: ${selectedPickerLabel}`, 'success');
      });

      // =========================================================
      // MÓDULO 6: CREAR LISTÍN DE CARGA / DESPACHO & EXPORTACIÓN PDF
      // =========================================================
      let listinSelectedZones: Set<string> = new Set();
      let listinCitiesOrder: string[] = [];
      let listinCityGuiasOrder: Record<string, string[]> = {};
      let listinFlatGuiasOrder: string[] = [];
      let listinExcludedGuiaIds: Set<string> = new Set();
      let listinExcludedCities: Set<string> = new Set();
      let listinCollapsedCities: Set<string> = new Set();
      let listinViewSubMode: 'zones' | 'flat' = 'zones';
      let listinSearchQuery: string = '';

      // Drag and drop tracking
      let draggedGuiaId: string | null = null;
      let draggedCityName: string | null = null;
      let draggedZoneName: string | null = null;

      // Pre-cargar fecha actual en el input de fecha
      if (listinFechaInput && !listinFechaInput.value) {
        listinFechaInput.value = new Date().toISOString().split('T')[0];
      }

      function populateListinDriverSelect() {
        if (!listinDriverSelect) return;
        const currentVal = listinDriverSelect.value || 'ALL';
        listinDriverSelect.innerHTML = '<option value="ALL">Todos los Choferes / Flota Central</option>';
        drivers.forEach(d => {
          const opt = document.createElement('option');
          opt.value = d.id.toString();
          opt.textContent = `${d.nombre} (ID: ${d.id})`;
          listinDriverSelect.appendChild(opt);
        });
        if (Array.from(listinDriverSelect.options).some(o => o.value === currentVal)) {
          listinDriverSelect.value = currentVal;
        }
      }

      function getListinSourceShipments(): GuiaRow[] {
        const driverFilter = listinDriverSelect ? listinDriverSelect.value : 'ALL';
        return shipments.filter(g => {
          if (driverFilter !== 'ALL') {
            if (String(g.chofer_asignado_id) !== driverFilter) return false;
          }
          return true;
        });
      }

      function syncListinCitiesOrder(availableCities: string[]) {
        const kept = listinCitiesOrder.filter(c => availableCities.includes(c));
        availableCities.forEach(c => {
          if (!kept.includes(c)) kept.push(c);
        });
        listinCitiesOrder = kept;
      }

      function syncListinState(srcShipments: GuiaRow[]) {
        const uniqueCities = Array.from(new Set(srcShipments.map(g => (g.ciudad_destino || 'Sin Ciudad').trim()))).filter(Boolean);
        if (listinCitiesOrder.length === 0 || !listinCitiesOrder.some(c => uniqueCities.includes(c))) {
          uniqueCities.sort((a, b) => a.localeCompare(b));
        }
        syncListinCitiesOrder(uniqueCities);

        // Limpiar zonas seleccionadas que ya no existen
        Array.from(listinSelectedZones).forEach(z => {
          if (!listinCitiesOrder.includes(z)) listinSelectedZones.delete(z);
        });

        // Sincronizar orden de guías por cada ciudad
        uniqueCities.forEach(cityName => {
          const cityShipments = srcShipments.filter(g => (g.ciudad_destino || 'Sin Ciudad').trim() === cityName);
          const existingOrder = listinCityGuiasOrder[cityName] || [];
          const kept = existingOrder.filter(id => cityShipments.some(g => g.id_guia === id));
          cityShipments.forEach(g => {
            if (!kept.includes(g.id_guia)) kept.push(g.id_guia);
          });
          listinCityGuiasOrder[cityName] = kept;
        });

        // Sincronizar orden plano de guías
        const allSrcIds = srcShipments.map(g => g.id_guia);
        if (listinFlatGuiasOrder.length === 0) {
          const flat: string[] = [];
          listinCitiesOrder.forEach(cityName => {
            const gIds = listinCityGuiasOrder[cityName] || [];
            flat.push(...gIds);
          });
          listinFlatGuiasOrder = flat;
        } else {
          const kept = listinFlatGuiasOrder.filter(id => allSrcIds.includes(id));
          allSrcIds.forEach(id => {
            if (!kept.includes(id)) kept.push(id);
          });
          listinFlatGuiasOrder = kept;
        }
      }

      function syncFlatFromZones() {
        const flat: string[] = [];
        listinCitiesOrder.forEach(cityName => {
          const gIds = listinCityGuiasOrder[cityName] || [];
          flat.push(...gIds);
        });
        listinFlatGuiasOrder = flat;
      }

      function getOrderedActiveGuias(srcShipments: GuiaRow[], specificZone?: string): GuiaRow[] {
        const mapById = new Map(srcShipments.map(g => [g.id_guia, g]));
        const ordered: GuiaRow[] = [];

        if (specificZone !== undefined) {
          if (specificZone !== 'ALL') {
            const guiaIds = listinCityGuiasOrder[specificZone] || [];
            guiaIds.forEach(id => {
              if (listinExcludedGuiaIds.has(id)) return;
              const g = mapById.get(id);
              if (g) ordered.push(g);
            });
            return ordered;
          }
        } else if (listinSelectedZones.size > 0) {
          if (listinViewSubMode === 'flat') {
            listinFlatGuiasOrder.forEach(id => {
              if (listinExcludedGuiaIds.has(id)) return;
              const g = mapById.get(id);
              if (g) {
                const city = (g.ciudad_destino || 'Sin Ciudad').trim();
                if (listinSelectedZones.has(city) && !listinExcludedCities.has(city)) {
                  ordered.push(g);
                }
              }
            });
          } else {
            listinCitiesOrder.forEach(cityName => {
              if (!listinSelectedZones.has(cityName)) return;
              if (listinExcludedCities.has(cityName)) return;
              const guiaIds = listinCityGuiasOrder[cityName] || [];
              guiaIds.forEach(id => {
                if (listinExcludedGuiaIds.has(id)) return;
                const g = mapById.get(id);
                if (g) ordered.push(g);
              });
            });
          }
          return ordered;
        }

        if (listinViewSubMode === 'flat') {
          listinFlatGuiasOrder.forEach(id => {
            if (listinExcludedGuiaIds.has(id)) return;
            const g = mapById.get(id);
            if (g) {
              const city = (g.ciudad_destino || 'Sin Ciudad').trim();
              if (!listinExcludedCities.has(city)) {
                ordered.push(g);
              }
            }
          });
        } else {
          listinCitiesOrder.forEach(cityName => {
            if (listinExcludedCities.has(cityName)) return;
            const guiaIds = listinCityGuiasOrder[cityName] || [];
            guiaIds.forEach(id => {
              if (listinExcludedGuiaIds.has(id)) return;
              const g = mapById.get(id);
              if (g) ordered.push(g);
            });
          });
        }

        return ordered;
      }

      function renderListinZoneControls(srcShipments: GuiaRow[]) {
        if (!listinZoneSelect || !listinZonePills) return;

        // Actualizar Select de Zonas
        let selectHtml = `<option value="ALL" ${listinSelectedZones.size === 0 ? 'selected' : ''}>Todas las Zonas (Lote Consolidado - ${srcShipments.length} guías)</option>`;
        listinCitiesOrder.forEach(cityName => {
          const count = srcShipments.filter(g => (g.ciudad_destino || 'Sin Ciudad').trim() === cityName).length;
          const isSelected = listinSelectedZones.size === 1 && listinSelectedZones.has(cityName) ? 'selected' : '';
          selectHtml += `<option value="${cityName}" ${isSelected}>📍 ${cityName} (${count} guías)</option>`;
        });
        if (listinSelectedZones.size > 1) {
          selectHtml += `<option value="COMBINED" selected>✓ ${listinSelectedZones.size} Zonas Combinadas</option>`;
        }
        listinZoneSelect.innerHTML = selectHtml;

        // Actualizar Píldoras de Zonas Rápidas Multi-Selección
        let pillsHtml = `
          <button
            type="button"
            onclick="window.toggleListinZone('ALL')"
            class="px-2.5 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5 ${listinSelectedZones.size === 0 ? 'bg-slate-900 text-white shadow-xs' : 'bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200'}"
          >
            <span>Todas las Zonas</span>
            <span class="text-[10px] px-1.5 py-0.2 rounded-full ${listinSelectedZones.size === 0 ? 'bg-white/20 text-white' : 'bg-slate-200 text-slate-800'} font-mono">${srcShipments.length}</span>
          </button>
        `;

        listinCitiesOrder.forEach(cityName => {
          const count = srcShipments.filter(g => (g.ciudad_destino || 'Sin Ciudad').trim() === cityName).length;
          const isSelected = listinSelectedZones.has(cityName);
          pillsHtml += `
            <button
              type="button"
              onclick="window.toggleListinZone('${cityName.replace(/'/g, "\\'")}')"
              class="px-2.5 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5 ${isSelected ? 'bg-indigo-600 text-white shadow-xs ring-2 ring-indigo-300' : 'bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200'}"
            >
              ${isSelected ? '<svg class="w-3 h-3 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>' : ''}
              <span>${cityName}</span>
              <span class="text-[10px] px-1.5 py-0.2 rounded-full ${isSelected ? 'bg-white/20 text-white' : 'bg-slate-200 text-slate-800'} font-mono">${count}</span>
            </button>
          `;
        });

        listinZonePills.innerHTML = pillsHtml;
      }

      function renderListinView() {
        populateListinDriverSelect();
        const srcShipments = getListinSourceShipments();

        syncListinState(srcShipments);
        renderListinZoneControls(srcShipments);

        if (listinCitiesCount) {
          if (listinSelectedZones.size === 1) {
            const zName = Array.from(listinSelectedZones)[0];
            const zoneGuiasCount = getOrderedActiveGuias(srcShipments, zName).length;
            listinCitiesCount.textContent = `Zona: ${zName} (${zoneGuiasCount} guías)`;
          } else if (listinSelectedZones.size > 1) {
            const combinedCount = getOrderedActiveGuias(srcShipments).length;
            listinCitiesCount.textContent = `${listinSelectedZones.size} zonas combinadas (${combinedCount} guías)`;
          } else if (listinViewSubMode === 'zones') {
            listinCitiesCount.textContent = `${listinCitiesOrder.length} zonas consolidado`;
          } else {
            const activeCount = getOrderedActiveGuias(srcShipments).length;
            listinCitiesCount.textContent = `${activeCount} guía${activeCount !== 1 ? 's' : ''}`;
          }
        }

        // Actualizar botones de submodo en UI
        if (btnListinModeZones && btnListinModeFlat) {
          if (listinViewSubMode === 'zones') {
            btnListinModeZones.className = 'px-2.5 py-1 rounded-lg font-bold transition-all bg-white text-slate-900 shadow-xs cursor-pointer';
            btnListinModeFlat.className = 'px-2.5 py-1 rounded-lg font-bold text-slate-500 hover:text-slate-900 transition-all cursor-pointer';
            if (listinPanelTitle) {
              listinPanelTitle.textContent = listinSelectedZones.size === 1 
                ? `Organizar Zona: ${Array.from(listinSelectedZones)[0]}` 
                : listinSelectedZones.size > 1 
                  ? `Organizar ${listinSelectedZones.size} Zonas Combinadas` 
                  : 'Orden Jerárquico de Zonas';
            }
            if (listinInstructionsText) listinInstructionsText.innerHTML = 'Usa las flechas <span class="font-bold text-slate-700">▲</span> <span class="font-bold text-slate-700">▼</span> o arrastra <span class="font-bold text-slate-700">⠿</span> las zonas y guías para cambiar el orden.';
          } else {
            btnListinModeFlat.className = 'px-2.5 py-1 rounded-lg font-bold transition-all bg-white text-slate-900 shadow-xs cursor-pointer';
            btnListinModeZones.className = 'px-2.5 py-1 rounded-lg font-bold text-slate-500 hover:text-slate-900 transition-all cursor-pointer';
            if (listinPanelTitle) listinPanelTitle.textContent = 'Lista Continua de Guías (1..N)';
            if (listinInstructionsText) listinInstructionsText.innerHTML = 'Orden libre continuo del 1 al N. Usa <span class="font-bold text-slate-700">▲</span> <span class="font-bold text-slate-700">▼</span> o arrastra <span class="font-bold text-slate-700">⠿</span> para ubicar cada guía.';
          }
        }

        // 1. Renderizar Editor de Jerarquía y Guías (Izquierda)
        renderListinHierarchy(srcShipments);

        // 2. Renderizar Hoja del Listín en Vivo (Derecha)
        renderListinPrintPreview(srcShipments);
      }

      function renderListinHierarchy(srcShipments: GuiaRow[]) {
