                <!-- 3. Tabla Dual (8 Columnas) -->
                <div style="width: 100%;">
                  <table style="width: 100%; border-collapse: collapse; border: 2px solid #000; font-size: 10.5px;">
                    <thead>
                      <tr style="background-color: #e2e8f0; color: #000; text-transform: uppercase; font-weight: 900; text-align: center; border-bottom: 2px solid #000; font-size: 9.5px;">
                        <th style="width: 15%; padding: 3px 2px; border-right: 1px solid #000;">NRO DE GUIA</th>
