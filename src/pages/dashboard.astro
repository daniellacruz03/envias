              <span class="bg-slate-100 border border-slate-200 text-slate-700 px-2.5 py-1 rounded-lg font-bold">
                <span id="planner-zone-total-count">0</span> guías total
              </span>
              <span id="planner-zone-count-badge" class="bg-indigo-100 border border-indigo-200 text-indigo-800 px-2.5 py-1 rounded-lg font-bold">
