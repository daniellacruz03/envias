      let frequentClients: FrequentClient[] = [];
      let frequentClientsLoading = false;

      async function loadFrequentClients() {
        if (frequentClientsLoading) return;
        frequentClientsLoading = true;
        try {
          const res = await fetch('/api/clientes');
          if (res.ok) {
            const data = await res.json();
            if (data.success && Array.isArray(data.data)) {
              frequentClients = data.data;
              updateFrequentClientsPills();
              if (currentViewMode === 'directorio') {
                renderDirectorioView();
              }
            }
          }
        } catch (e) {
          console.warn('[Directorio Clientes Error]:', e);
        } finally {
          frequentClientsLoading = false;
        }
      }

      function updateFrequentClientsPills() {
        const quickCount = document.getElementById('quick-frequent-clients-count');
        const modalCount = document.getElementById('modal-clients-count-badge');
        const viewPill = document.getElementById('directorio-count-pill');
        const totalBadge = document.getElementById('directorio-total-badge');

        const totalStr = frequentClients.length.toString();
        if (quickCount) quickCount.textContent = totalStr;
        if (modalCount) modalCount.textContent = `${totalStr} clientes`;
        if (viewPill) viewPill.textContent = totalStr;
        if (totalBadge) totalBadge.textContent = `${totalStr} clientes`;
      }

      function handleDestinatarioAutocomplete(val: string) {
        const destinatarioDropdownEl = document.getElementById('destinatario-autocomplete-dropdown') as HTMLElement;
        if (!destinatarioDropdownEl) return;
        const q = normalizeText(val || '');
        if (q.length < 2 || frequentClients.length === 0) {
          destinatarioDropdownEl.classList.add('hidden');
          destinatarioDropdownEl.innerHTML = '';
          return;
        }

        const matches = frequentClients.filter(c => 
          normalizeText(c.destinatario).includes(q) ||
          (c.telefono_principal && c.telefono_principal.replace(/\D/g, '').includes(val.replace(/\D/g, ''))) ||
          (c.telefono_secundario && c.telefono_secundario.replace(/\D/g, '').includes(val.replace(/\D/g, ''))) ||
          normalizeText(c.ciudad_destino).includes(q)
        ).slice(0, 5);

        if (matches.length === 0) {
