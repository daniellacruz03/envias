      (window as any).selectFrequentClientFromData = (encodedData: string) => {
        try {
          const client = JSON.parse(decodeURIComponent(encodedData));
          (window as any).selectFrequentClient(client);
        } catch (e) {
          console.error(e);
        }
      };

      (window as any).selectFrequentClient = (client: FrequentClient) => {
        if (!client) return;

        const inputDest = document.getElementById('input-destinatario') as HTMLInputElement;
        const inputTel = document.getElementById('input-telefono') as HTMLInputElement;
        const inputTel2 = document.getElementById('input-telefono-2') as HTMLInputElement;
        const inputCiu = document.getElementById('input-ciudad') as HTMLInputElement;
        const inputDir = document.getElementById('input-direccion') as HTMLInputElement;
        const inputGuia = document.getElementById('input-guia') as HTMLInputElement;
        const destinatarioDropdownEl = document.getElementById('destinatario-autocomplete-dropdown') as HTMLElement;

        if (inputDest) inputDest.value = client.destinatario;
        if (inputTel) inputTel.value = client.telefono_principal;
        if (inputTel2) inputTel2.value = client.telefono_secundario || '';
        if (inputCiu) inputCiu.value = client.ciudad_destino;
        if (inputDir) inputDir.value = client.direccion_referencia || '';

        destinatarioDropdownEl?.classList.add('hidden');

        const badge = document.getElementById('frequent-client-selected-badge');
        const badgeText = document.getElementById('frequent-client-selected-text');
        if (badge && badgeText) {
          badgeText.innerHTML = `Cliente frecuente: <strong class="text-slate-900">${client.destinatario}</strong> &bull; ${client.total_guias} envíos previos ${client.gps_confirmado ? '&bull; <span class="text-emerald-700 font-bold">GPS Listo</span>' : ''}`;
          badge.classList.remove('hidden');
        }

        (window as any).closeFrequentClientsModal();
        showToast(`Datos de ${client.destinatario} cargados con éxito`, 'info');

        const formSection = document.getElementById('new-shipment-form');
        formSection?.scrollIntoView({ behavior: 'smooth', block: 'center' });

        if (inputGuia && !inputGuia.value) {
          inputGuia.focus();
        }
      };

      (window as any).clearFrequentClientSelection = () => {
        const badge = document.getElementById('frequent-client-selected-badge');
