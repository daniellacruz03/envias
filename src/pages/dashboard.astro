                          <span class="text-[10px] font-bold px-1.5 py-0.2 rounded bg-slate-100 text-slate-700 border border-slate-200 uppercase">${g.ciudad_destino || 'Sin Ciudad'}</span>
                        </div>
                        <p class="text-[11px] text-slate-500 truncate max-w-[150px] sm:max-w-[200px]">${g.destinatario}</p>
                      </div>
                    </div>

                    <div class="flex items-center gap-1 shrink-0">
                      <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded font-mono font-bold text-[10px]">${g.piezas || 1} pza${(g.piezas || 1) !== 1 ? 's' : ''}</span>
                      
                      <!-- Subir Guía Plana -->
                      <button
                        type="button"
                        onclick="window.moveListinFlatGuia('${g.id_guia}', -1)"
                        ${idx === 0 ? 'disabled' : ''}
                        class="p-1 rounded-lg bg-slate-50 hover:bg-slate-200 text-slate-700 border border-slate-200 disabled:opacity-25 disabled:cursor-not-allowed transition-all cursor-pointer"
                        title="Subir esta guía"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg>
                      </button>

                      <!-- Bajar Guía Plana -->
                      <button
                        type="button"
                        onclick="window.moveListinFlatGuia('${g.id_guia}', 1)"
                        ${idx === flatGuias.length - 1 ? 'disabled' : ''}
                        class="p-1 rounded-lg bg-slate-50 hover:bg-slate-200 text-slate-700 border border-slate-200 disabled:opacity-25 disabled:cursor-not-allowed transition-all cursor-pointer"
                        title="Bajar esta guía"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                      </button>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          `;
        }
      }

      function renderListinPrintPreview(srcShipments: GuiaRow[]) {
        // Metadatos
        const selectedDriverOption = listinDriverSelect?.options[listinDriverSelect.selectedIndex];
        const driverName = selectedDriverOption && listinDriverSelect.value !== 'ALL' 
          ? selectedDriverOption.text.replace(/\s*\(ID:.*?\)\s*/g, '') 
          : 'FLOTA CENTRAL / DESPACHO GENERAL';
        const placa = listinPlacaInput?.value?.trim()?.toUpperCase() || 'NO ASIGNADA';
        const fecha = listinFechaInput?.value || new Date().toISOString().split('T')[0];

        if (previewListinFecha) previewListinFecha.textContent = fecha;
        if (previewListinPlaca) previewListinPlaca.textContent = placa;
        if (previewListinChofer) previewListinChofer.textContent = driverName;

        // Construir array de guías respetando la zona activa y el orden exacto configurado
        const orderedActiveGuias = getOrderedActiveGuias(srcShipments);

        const totalGuias = orderedActiveGuias.length;
        const totalPiezas = orderedActiveGuias.reduce((acc, g) => acc + (g.piezas || 1), 0);
        const uniqueActiveCities = new Set(orderedActiveGuias.map(g => (g.ciudad_destino || '').trim())).size;

        if (previewTotalGuias) previewTotalGuias.textContent = totalGuias.toString();
        if (previewTotalPiezas) previewTotalPiezas.textContent = totalPiezas.toString();
        if (previewTotalCiudades) previewTotalCiudades.textContent = uniqueActiveCities.toString();

        // Actualizar Encabezado de Destino en la Hoja Física Oficial
        if (listinSelectedZones.size === 0) {
          if (previewListinDestino) previewListinDestino.textContent = 'TODAS (CONSOLIDADO)';
          if (previewListinTitleZona) previewListinTitleZona.textContent = `DESTINO: TODAS LAS ZONAS (${totalGuias} GUÍAS, ${totalPiezas} PZAS)`;
          if (previewListinCurrentBadge) previewListinCurrentBadge.textContent = `ZONA: TODAS (${uniqueActiveCities} CIUDADES)`;
        } else if (listinSelectedZones.size === 1) {
          const zName = Array.from(listinSelectedZones)[0];
          if (previewListinDestino) previewListinDestino.textContent = zName;
          if (previewListinTitleZona) previewListinTitleZona.textContent = `DESTINO: ${zName.toUpperCase()} (${totalGuias} GUÍAS, ${totalPiezas} PZAS)`;
          if (previewListinCurrentBadge) previewListinCurrentBadge.textContent = `ZONA: ${zName}`;
        } else {
          const combinedNames = listinCitiesOrder.filter(c => listinSelectedZones.has(c)).join(' · ').toUpperCase();
          if (previewListinDestino) previewListinDestino.textContent = combinedNames;
          if (previewListinTitleZona) previewListinTitleZona.textContent = `DESTINO: ${combinedNames} (${totalGuias} GUÍAS, ${totalPiezas} PZAS)`;
          if (previewListinCurrentBadge) previewListinCurrentBadge.textContent = `ZONAS COMBINADAS (${listinSelectedZones.size})`;
        }

        // Calcular filas del formato dual: mínimo 22 filas para llenar la página vertical como el listín físico
        const rowCount = Math.max(Math.ceil(orderedActiveGuias.length / 2), 22);
        const leftGuias = orderedActiveGuias.slice(0, rowCount);
        const rightGuias = orderedActiveGuias.slice(rowCount, rowCount * 2);

        let tableHtml = '';
        for (let i = 0; i < rowCount; i++) {
          const left = leftGuias[i];
          const right = rightGuias[i];

          tableHtml += `
            <tr class="h-6 border-b border-black/30 text-black">
              <!-- Bloque Izquierdo -->
              <td class="py-1 px-1.5 border-r border-black font-mono font-bold text-center">${left ? left.id_guia : ''}</td>
              <td class="py-1 px-1 border-r border-black text-center font-bold">${left ? (left.piezas || 1) : ''}</td>
              <td class="py-1 px-2 border-r-2 border-black font-bold uppercase truncate max-w-[140px]">${left ? left.ciudad_destino : ''}</td>
              <!-- Bloque Derecho -->
              <td class="py-1 px-1.5 border-r border-black font-mono font-bold text-center">${right ? right.id_guia : ''}</td>
              <td class="py-1 px-1 border-r border-black text-center font-bold">${right ? (right.piezas || 1) : ''}</td>
              <td class="py-1 px-2 font-bold uppercase truncate max-w-[140px]">${right ? right.ciudad_destino : ''}</td>
            </tr>
          `;
        }

        if (previewListinTbody) {
          previewListinTbody.innerHTML = tableHtml;
        }
      }

      // ==========================================
      // FUNCIONES GLOBALES DE REORDENACIÓN Y ZONAS
      // ==========================================

      // 0. Toggle y Selección de Zonas
      (window as any).toggleListinZone = (zoneName: string) => {
        if (zoneName === 'ALL') {
          listinSelectedZones.clear();
        } else {
          if (listinSelectedZones.has(zoneName)) {
            listinSelectedZones.delete(zoneName);
          } else {
            listinSelectedZones.add(zoneName);
          }
        }
        renderListinView();
      };

      (window as any).clearListinZones = () => {
        listinSelectedZones.clear();
        renderListinView();
      };

      (window as any).selectListinZone = (zoneName: string) => {
        if (zoneName === 'ALL') {
          listinSelectedZones.clear();
        } else if (zoneName !== 'COMBINED') {
          listinSelectedZones.clear();
          listinSelectedZones.add(zoneName);
        }
        renderListinView();
      };

      // 1. Mover Guía dentro de una Zona
      (window as any).moveListinGuia = (cityName: string, guiaId: string, direction: number) => {
        const arr = listinCityGuiasOrder[cityName];
        if (!arr) return;
        const idx = arr.indexOf(guiaId);
        if (idx === -1) return;
        const newIdx = idx + direction;
        if (newIdx < 0 || newIdx >= arr.length) return;
        const temp = arr[idx];
        arr[idx] = arr[newIdx];
        arr[newIdx] = temp;
        syncFlatFromZones();
        renderListinView();
      };

      // 2. Mover Guía en Vista Plana Continua (1..N)
      (window as any).moveListinFlatGuia = (guiaId: string, direction: number) => {
        const idx = listinFlatGuiasOrder.indexOf(guiaId);
        if (idx === -1) return;
        const newIdx = idx + direction;
        if (newIdx < 0 || newIdx >= listinFlatGuiasOrder.length) return;
        const temp = listinFlatGuiasOrder[idx];
        listinFlatGuiasOrder[idx] = listinFlatGuiasOrder[newIdx];
        listinFlatGuiasOrder[newIdx] = temp;
        renderListinView();
      };

      // 3. Mover Zona Completa
      (window as any).moveListinCity = (cityName: string, direction: number) => {
        const idx = listinCitiesOrder.indexOf(cityName);
        if (idx === -1) return;
        const newIdx = idx + direction;
        if (newIdx < 0 || newIdx >= listinCitiesOrder.length) return;
        const temp = listinCitiesOrder[idx];
        listinCitiesOrder[idx] = listinCitiesOrder[newIdx];
        listinCitiesOrder[newIdx] = temp;
        syncFlatFromZones();
        renderListinView();
      };

      // 4. Drag & Drop de Guías
      (window as any).onListinGuiaDragStart = (e: DragEvent, guiaId: string, cityName: string) => {
        draggedGuiaId = guiaId;
        draggedCityName = cityName;
        if (e.dataTransfer) {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', guiaId);
        }
        const el = (e.currentTarget || e.target) as HTMLElement;
        el?.classList.add('opacity-40');
      };

      (window as any).onListinGuiaDragEnd = (e: DragEvent) => {
        const el = (e.currentTarget || e.target) as HTMLElement;
        el?.classList.remove('opacity-40');
      };

      (window as any).onListinGuiaDragOver = (e: DragEvent) => {
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
      };

      (window as any).onListinGuiaDrop = (e: DragEvent, targetGuiaId: string, targetCityName: string) => {
        e.preventDefault();
        e.stopPropagation();
        if (!draggedGuiaId || draggedGuiaId === targetGuiaId) return;

        if (listinViewSubMode === 'zones') {
          if (draggedCityName === targetCityName) {
            const arr = listinCityGuiasOrder[targetCityName];
            if (arr) {
              const fromIdx = arr.indexOf(draggedGuiaId);
              const toIdx = arr.indexOf(targetGuiaId);
              if (fromIdx !== -1 && toIdx !== -1) {
                arr.splice(fromIdx, 1);
                arr.splice(toIdx, 0, draggedGuiaId);
              }
            }
          } else if (draggedCityName) {
            // Mover guía entre diferentes zonas
            const srcArr = listinCityGuiasOrder[draggedCityName];
            const destArr = listinCityGuiasOrder[targetCityName];
            if (srcArr && destArr) {
              const fromIdx = srcArr.indexOf(draggedGuiaId);
              if (fromIdx !== -1) srcArr.splice(fromIdx, 1);
              const toIdx = destArr.indexOf(targetGuiaId);
              if (toIdx !== -1) destArr.splice(toIdx, 0, draggedGuiaId);
              else destArr.push(draggedGuiaId);
            }
          }
          syncFlatFromZones();
        } else {
          const fromIdx = listinFlatGuiasOrder.indexOf(draggedGuiaId);
          const toIdx = listinFlatGuiasOrder.indexOf(targetGuiaId);
          if (fromIdx !== -1 && toIdx !== -1) {
            listinFlatGuiasOrder.splice(fromIdx, 1);
            listinFlatGuiasOrder.splice(toIdx, 0, draggedGuiaId);
          }
        }

        draggedGuiaId = null;
        draggedCityName = null;
        renderListinView();
      };

      // 5. Drag & Drop de Zonas
      (window as any).onListinZoneDragStart = (e: DragEvent, cityName: string) => {
        draggedZoneName = cityName;
        if (e.dataTransfer) {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', cityName);
        }
      };

      (window as any).onListinZoneDragOver = (e: DragEvent) => {
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
      };

      (window as any).onListinZoneDrop = (e: DragEvent, targetCityName: string) => {
        e.preventDefault();
        e.stopPropagation();
        if (!draggedZoneName || draggedZoneName === targetCityName) return;
        const fromIdx = listinCitiesOrder.indexOf(draggedZoneName);
        const toIdx = listinCitiesOrder.indexOf(targetCityName);
        if (fromIdx !== -1 && toIdx !== -1) {
          listinCitiesOrder.splice(fromIdx, 1);
          listinCitiesOrder.splice(toIdx, 0, draggedZoneName);
        }
        syncFlatFromZones();
        draggedZoneName = null;
        renderListinView();
      };

      // 6. Excluir / Incluir y Colapsar
      (window as any).toggleListinCity = (cityName: string, isIncluded: boolean) => {
        if (isIncluded) {
          listinExcludedCities.delete(cityName);
        } else {
          listinExcludedCities.add(cityName);
        }
        renderListinView();
      };

      (window as any).toggleListinGuia = (guiaId: string, isIncluded: boolean) => {
        if (isIncluded) {
          listinExcludedGuiaIds.delete(guiaId);
        } else {
          listinExcludedGuiaIds.add(guiaId);
        }
        renderListinView();
      };

      (window as any).toggleListinCollapse = (cityName: string) => {
        if (listinCollapsedCities.has(cityName)) {
          listinCollapsedCities.delete(cityName);
        } else {
          listinCollapsedCities.add(cityName);
        }
        renderListinView();
      };

      // Listeners de Cambios de Filtros y Configuración
      listinDriverSelect?.addEventListener('change', () => {
        renderListinView();
      });
      listinPlacaInput?.addEventListener('input', () => {
        if (previewListinPlaca) {
          previewListinPlaca.textContent = listinPlacaInput.value.trim().toUpperCase() || 'NO ASIGNADA';
        }
      });
      listinFechaInput?.addEventListener('change', () => {
        if (previewListinFecha) {
          previewListinFecha.textContent = listinFechaInput.value || '';
        }
      });

      // Selector de Zona por Dropdown
      listinZoneSelect?.addEventListener('change', () => {
        const val = listinZoneSelect.value || 'ALL';
        if (val === 'ALL') {
          listinSelectedZones.clear();
        } else if (val !== 'COMBINED') {
          listinSelectedZones.clear();
          listinSelectedZones.add(val);
        }
        renderListinView();
      });

      // Navegación Anterior / Siguiente Zona
      btnListinPrevZone?.addEventListener('click', () => {
        if (listinCitiesOrder.length === 0) return;
        if (listinActiveZone === 'ALL') {
          listinActiveZone = listinCitiesOrder[listinCitiesOrder.length - 1];
        } else {
          const currIdx = listinCitiesOrder.indexOf(listinActiveZone);
          if (currIdx <= 0) {
            listinActiveZone = 'ALL';
          } else {
            listinActiveZone = listinCitiesOrder[currIdx - 1];
          }
        }
        renderListinView();
      });

      btnListinNextZone?.addEventListener('click', () => {
        if (listinCitiesOrder.length === 0) return;
        if (listinActiveZone === 'ALL') {
          listinActiveZone = listinCitiesOrder[0];
        } else {
          const currIdx = listinCitiesOrder.indexOf(listinActiveZone);
          if (currIdx >= listinCitiesOrder.length - 1) {
            listinActiveZone = 'ALL';
          } else {
            listinActiveZone = listinCitiesOrder[currIdx + 1];
          }
        }
        renderListinView();
      });

      // Selector de Submodo (Por Zonas vs Lista Plana)
      btnListinModeZones?.addEventListener('click', () => {
        listinViewSubMode = 'zones';
        renderListinView();
      });
      btnListinModeFlat?.addEventListener('click', () => {
        listinViewSubMode = 'flat';
        renderListinView();
      });

      // Buscador Rápido de Guías en el Listín
      listinSearchInput?.addEventListener('input', () => {
        listinSearchQuery = listinSearchInput.value || '';
        const srcShipments = getListinSourceShipments();
        renderListinHierarchy(srcShipments);
      });

      // Botón Expandir / Colapsar Todas las Zonas
      btnListinToggleAllCollapse?.addEventListener('click', () => {
        if (listinCollapsedCities.size >= listinCitiesOrder.length) {
          listinCollapsedCities.clear();
        } else {
          listinCitiesOrder.forEach(c => listinCollapsedCities.add(c));
        }
        const srcShipments = getListinSourceShipments();
        renderListinHierarchy(srcShipments);
      });

      // Ordenar Alfabéticamente / Auto Jerarquía
      btnListinAutoTsp?.addEventListener('click', () => {
        listinCitiesOrder.sort((a, b) => a.localeCompare(b));
        // Ordenar también internamente cada ciudad por # de guía
        Object.keys(listinCityGuiasOrder).forEach(city => {
          listinCityGuiasOrder[city].sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
        });
        syncFlatFromZones();
        showToast('Jerarquía de zonas y guías ordenadas de la A a la Z', 'success');
        renderListinView();
      });

      // Enviar Listín Oficial al Chofer (Guarda la asignación y orden jerárquico directamente en su portal)
      btnListinSend?.addEventListener('click', async () => {
        const selectedDriverOption = listinDriverSelect?.options[listinDriverSelect.selectedIndex];
        const driverId = listinDriverSelect?.value;

        if (!driverId || driverId === 'ALL') {
          showToast('Por favor selecciona un Chofer específico para despachar y enviarle su listín', 'info');
          listinDriverSelect?.focus();
          return;
        }

        const driverObj = drivers.find(d => String(d.id) === String(driverId));
        const driverName = driverObj ? driverObj.nombre : (selectedDriverOption?.text || 'Chofer');

        const srcShipments = getListinSourceShipments();
        const orderedActiveGuias = getOrderedActiveGuias(srcShipments);

        const totalGuias = orderedActiveGuias.length;
        const totalPiezas = orderedActiveGuias.reduce((acc, g) => acc + (g.piezas || 1), 0);

        if (totalGuias === 0) {
          showToast('No hay guías activas incluidas para este chofer', 'error');
          return;
        }

        const origHtml = btnListinSend.innerHTML;
        btnListinSend.disabled = true;
        btnListinSend.innerHTML = `
          <svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          <span>Despachando al portal...</span>
        `;

        try {
          // Guardar asignación y orden de ruta en base de datos para este chofer
          const updatePromises = orderedActiveGuias.map((g, idx) => 
            fetch(`/api/guias/${g.id_guia}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ orden_ruta: idx + 1, chofer_asignado_id: Number(driverId) })
            })
          );

          await Promise.all(updatePromises);

          showToast(`¡Listín enviado al portal de ${driverName}! Ya puede imprimir su hoja de carga.`, 'success');
          silentRefresh();
        } catch (e) {
          console.error('Error al despachar listín:', e);
          showToast('Error al enviar el listín al chofer. Intenta nuevamente.', 'error');
        } finally {
          btnListinSend.disabled = false;
          btnListinSend.innerHTML = origHtml;
        }
      });

      // Helper para generar el HTML de una hoja de zona específica
      function buildZoneSheetHtml(cityName: string, zoneGuias: GuiaRow[], driverName: string, placa: string, fecha: string): string {
        const totalGuias = zoneGuias.length;
        const totalPiezas = zoneGuias.reduce((acc, g) => acc + (g.piezas || 1), 0);
        const rowCount = Math.max(Math.ceil(zoneGuias.length / 2), 22);
        const leftGuias = zoneGuias.slice(0, rowCount);
        const rightGuias = zoneGuias.slice(rowCount, rowCount * 2);

        let tableRows = '';
        for (let i = 0; i < rowCount; i++) {
          const left = leftGuias[i];
          const right = rightGuias[i];
          tableRows += `
            <tr class="h-6 border-b border-black/30 text-black">
              <td class="py-1 px-1.5 border-r border-black font-mono font-bold text-center">${left ? left.id_guia : ''}</td>
              <td class="py-1 px-1 border-r border-black text-center font-bold">${left ? (left.piezas || 1) : ''}</td>
              <td class="py-1 px-2 border-r-2 border-black font-bold uppercase truncate max-w-[140px]">${left ? left.ciudad_destino : ''}</td>
              <td class="py-1 px-1.5 border-r border-black font-mono font-bold text-center">${right ? right.id_guia : ''}</td>
              <td class="py-1 px-1 border-r border-black text-center font-bold">${right ? (right.piezas || 1) : ''}</td>
              <td class="py-1 px-2 font-bold uppercase truncate max-w-[140px]">${right ? right.ciudad_destino : ''}</td>
            </tr>
          `;
        }

        return `
          <div class="w-full max-w-[760px] min-h-[960px] bg-white p-6 sm:p-7 rounded-xl text-black font-sans text-xs border border-slate-300 my-4" style="page-break-after: always; break-after: page;">
            <div class="flex items-start justify-between border-b-2 border-black pb-3 mb-2.5">
              <div class="flex items-center gap-3">
                <img src="/logo.png" alt="Envías C.A." class="h-12 w-auto object-contain shrink-0 mix-blend-multiply" />
                <div>
                  <h1 class="text-xl font-black tracking-tighter leading-none">ENVÍAS C.A.</h1>
                  <p class="text-[9px] font-black uppercase tracking-widest text-slate-800">Transporte y Encomiendas</p>
                  <p class="text-[8px] font-bold text-slate-600">Hub Central Barquisimeto &bull; Entregas Nacionales</p>
                </div>
              </div>
              <div class="border border-black rounded-lg p-2.5 w-64 space-y-1 text-[11px] bg-slate-50">
                <div class="flex items-center justify-between border-b border-slate-300 pb-0.5"><span class="font-bold">FECHA:</span><span class="font-mono font-bold">${fecha}</span></div>
                <div class="flex items-center justify-between border-b border-slate-300 pb-0.5"><span class="font-bold">PLACA:</span><span class="font-mono font-bold">${placa}</span></div>
                <div class="flex items-center justify-between border-b border-slate-300 pb-0.5"><span class="font-bold">CHOFER:</span><span class="font-bold truncate max-w-[130px]">${driverName}</span></div>
                <div class="flex items-center justify-between pt-0.5"><span class="font-black">DESTINO / ZONA:</span><span class="font-black font-mono uppercase truncate max-w-[130px]">${cityName}</span></div>
              </div>
            </div>
            <div class="text-center mb-2">
              <h2 class="text-xs font-black uppercase tracking-widest border-y border-black py-0.5 bg-slate-100 flex items-center justify-center gap-2">
                <span>LISTÍN DE CARGA Y DESPACHO DE GUÍAS</span>
                <span class="text-black">&bull;</span>
                <span class="font-mono uppercase font-black">DESTINO: ${cityName} (${totalGuias} GUÍAS, ${totalPiezas} PZAS)</span>
              </h2>
            </div>
            <div class="w-full mb-3">
              <table class="w-full border-collapse text-[10px] border-2 border-black">
                <thead>
                  <tr class="bg-slate-200 text-black uppercase font-black text-center border-b-2 border-black">
                    <th class="py-1 px-1.5 border-r border-black w-[17%]">NRO DE GUIA</th>
                    <th class="py-1 px-1 border-r border-black w-[8%]">PIEZAS</th>
                    <th class="py-1 px-2 border-r-2 border-black w-[25%]">DESTINO</th>
                    <th class="py-1 px-1.5 border-r border-black w-[17%]">NRO DE GUIA</th>
                    <th class="py-1 px-1 border-r border-black w-[8%]">PIEZAS</th>
                    <th class="py-1 px-2 w-[25%]">DESTINO</th>
                  </tr>
                </thead>
                <tbody class="font-mono font-semibold divide-y divide-black/40">
                  ${tableRows}
                </tbody>
              </table>
            </div>
          </div>
        `;
      }

      // 1. Descargar PDF (Zona Activa)
      btnListinDownloadPdf?.addEventListener('click', async () => {
        const element = document.getElementById('listin-print-wrapper');
        if (!element) return;
        const origHtml = btnListinDownloadPdf.innerHTML;
        btnListinDownloadPdf.disabled = true;
        btnListinDownloadPdf.innerHTML = `
          <svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          <span>Generando PDF...</span>
        `;

        try {
          const selectedDriverOption = listinDriverSelect?.options[listinDriverSelect.selectedIndex];
          const driverClean = selectedDriverOption && listinDriverSelect.value !== 'ALL'
            ? selectedDriverOption.text.replace(/[^a-zA-Z0-9]/g, '_')
            : 'Flota_General';
          const zoneClean = listinSelectedZones.size > 0 
            ? Array.from(listinSelectedZones).join('_').replace(/[^a-zA-Z0-9]/g, '_') 
            : 'Todas_Zonas';
          const fecha = listinFechaInput?.value || 'fecha';
          const filename = `Listin_Envias_${zoneClean}_${driverClean}_${fecha}.pdf`;

          const opt = {
            margin: [6, 6, 6, 6],
            filename: filename,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2, useCORS: true, letterRendering: true, logging: false },
            jsPDF: { unit: 'mm', format: 'letter', orientation: 'portrait' }
          };

          if ((window as any).html2pdf) {
            await (window as any).html2pdf().set(opt).from(element).save();
            showToast('PDF del Listín descargado exitosamente', 'success');
          } else {
            window.print();
          }
        } catch (err) {
          console.error('Error al generar PDF:', err);
          showToast('Abriendo cuadro de impresión del navegador...', 'info');
          window.print();
        } finally {
          btnListinDownloadPdf.disabled = false;
          btnListinDownloadPdf.innerHTML = origHtml;
        }
      });

      // 2. Descargar Todos los Listines (1 Hoja Oficial por cada Zona)
      btnListinDownloadAllPdf?.addEventListener('click', async () => {
        const srcShipments = getListinSourceShipments();
        if (srcShipments.length === 0 || listinCitiesOrder.length === 0) {
          showToast('No hay zonas con guías registradas para generar listines', 'error');
          return;
        }

        const origHtml = btnListinDownloadAllPdf.innerHTML;
        btnListinDownloadAllPdf.disabled = true;
        btnListinDownloadAllPdf.innerHTML = `
          <svg class="animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          <span>Generando ${listinCitiesOrder.length} listines...</span>
        `;

        try {
          const selectedDriverOption = listinDriverSelect?.options[listinDriverSelect.selectedIndex];
          const driverName = selectedDriverOption && listinDriverSelect.value !== 'ALL' 
            ? selectedDriverOption.text.replace(/\s*\(ID:.*?\)\s*/g, '') 
            : 'FLOTA CENTRAL / DESPACHO GENERAL';
          const placa = listinPlacaInput?.value?.trim()?.toUpperCase() || 'NO ASIGNADA';
          const fecha = listinFechaInput?.value || new Date().toISOString().split('T')[0];

          // Construir contenedor temporal con 1 hoja por cada zona
          const tempContainer = document.createElement('div');
          tempContainer.id = 'temp-multi-listin-pdf';
          tempContainer.style.position = 'absolute';
          tempContainer.style.left = '-9999px';
          tempContainer.style.top = '0';
          tempContainer.style.width = '760px';

          let combinedHtml = '';
          listinCitiesOrder.forEach(cityName => {
            if (listinExcludedCities.has(cityName)) return;
            const zoneGuias = getOrderedActiveGuias(srcShipments, cityName);
            if (zoneGuias.length === 0) return;
            combinedHtml += buildZoneSheetHtml(cityName, zoneGuias, driverName, placa, fecha);
          });

          tempContainer.innerHTML = combinedHtml;
          document.body.appendChild(tempContainer);

          const opt = {
            margin: [6, 6, 6, 6],
            filename: `Listines_Envias_Todas_Las_Zonas_${fecha}.pdf`,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2, useCORS: true, letterRendering: true, logging: false },
            jsPDF: { unit: 'mm', format: 'letter', orientation: 'portrait' },
            pagebreak: { mode: ['css', 'legacy'] }
          };

          if ((window as any).html2pdf) {
            await (window as any).html2pdf().set(opt).from(tempContainer).save();
            showToast(`¡Documento PDF de todas las zonas (${listinCitiesOrder.length} hojas) descargado exitosamente!`, 'success');
          } else {
            window.print();
          }

          document.body.removeChild(tempContainer);
        } catch (err) {
          console.error('Error al generar PDF de todas las zonas:', err);
          showToast('Error al exportar lote de listines. Abriendo impresión...', 'error');
          window.print();
        } finally {
          btnListinDownloadAllPdf.disabled = false;
          btnListinDownloadAllPdf.innerHTML = origHtml;
        }
      });



      // ============================================================
      // MOTOR DEL PLANIFICADOR DE CIRCUITO — SPOKE DISPATCH ENGINE
      // ============================================================

      // Estado del planificador
      let circuitStops: GuiaRow[] = [];
      let selectedZones = new Set<string>();   // Zonas seleccionadas (multi)
      let circuitOptimized = false;
      let plannerMapInstance: any = null;
      let plannerMapVisible = false;

      // Elementos del modal del planificador
      const routePlannerModal = document.getElementById('route-planner-modal');
      const plannerDriverSelect = document.getElementById('planner-driver-select') as HTMLSelectElement;
      const plannerZoneSummary = document.getElementById('planner-zone-summary');
      const plannerZoneGpsCount = document.getElementById('planner-zone-gps-count');
      const plannerZonePendingCount = document.getElementById('planner-zone-pending-count');
      const plannerZoneTotalCount = document.getElementById('planner-zone-total-count');
      const plannerZoneZonesCount = document.getElementById('planner-zone-zones-count');
      const plannerNoGpsWarning = document.getElementById('planner-no-gps-warning');
      const plannerNoGpsWarningText = document.getElementById('planner-no-gps-warning-text');
      const plannerStartInput = document.getElementById('planner-start-input') as HTMLInputElement;
      const plannerStartTimeInput = document.getElementById('planner-start-time') as HTMLInputElement;
      const plannerServiceTimeSelect = document.getElementById('planner-service-time') as HTMLSelectElement;
      const plannerStopsList = document.getElementById('planner-stops-list');
      const plannerStopsCountBadge = document.getElementById('planner-stops-count-badge');
      const plannerTotalKm = document.getElementById('planner-total-km');
      const plannerTotalTime = document.getElementById('planner-total-time');
      const plannerEtaEnd = document.getElementById('planner-eta-end');
      const plannerGmapsBatchButtons = document.getElementById('planner-gmaps-batch-buttons');
      const plannerRouteMapWrapper = document.getElementById('planner-route-map-wrapper');
      const btnToggleMapText = document.getElementById('btn-toggle-map-text');
      const plannerCancelBtn = document.getElementById('planner-cancel-btn');
      const plannerCloseBtn = document.getElementById('route-planner-close-btn');

      // Función: renderizar los chips de zonas disponibles
      function renderZoneChips() {
        const chipsContainer = document.getElementById('planner-zone-chips');
        if (!chipsContainer) return;

        const activeShipments = shipments.filter(g =>
          g.estado !== 'Entregado' && g.estado !== 'No entregado'
        );
        const ciudadesUnicas = [...new Set(
          activeShipments.map(g => (g.ciudad_destino || '').trim()).filter(Boolean)
        )].sort();

        if (ciudadesUnicas.length === 0) {
          chipsContainer.innerHTML = '<span class="text-[11px] text-slate-400 italic">No hay guías activas con ciudad asignada.</span>';
          return;
        }

        chipsContainer.innerHTML = ciudadesUnicas.map(ciudad => {
          const isSelected = selectedZones.has(ciudad);
          const guiasZona = activeShipments.filter(g =>
            (g.ciudad_destino || '').trim().toLowerCase() === ciudad.toLowerCase()
          );
          const conGps = guiasZona.filter(g =>
            g.gps_confirmado && g.gps_latitud != null && g.gps_longitud != null &&
            !isNaN(Number(g.gps_latitud)) && !isNaN(Number(g.gps_longitud))
          ).length;

          return `<button
            type="button"
            data-zone="${ciudad}"
            onclick="window.toggleZoneChip('${ciudad.replace(/'/g, "\\'")}')"
            class="zone-chip inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-bold border transition-all cursor-pointer ${
              isSelected
                ? 'bg-indigo-600 border-indigo-700 text-white shadow-sm shadow-indigo-200'
                : 'bg-white border-slate-200 text-slate-700 hover:border-indigo-400 hover:text-indigo-700 hover:bg-indigo-50'
            }"
          >
            ${ciudad}
            <span class="text-[10px] font-black ${isSelected ? 'text-indigo-200' : 'text-slate-400'}">${guiasZona.length}g/${conGps}GPS</span>
          </button>`;
        }).join('');
      }

      // Función: toggle de zona chip
      window.toggleZoneChip = function(ciudad: string) {
        if (selectedZones.has(ciudad)) {
          selectedZones.delete(ciudad);
        } else {
          selectedZones.add(ciudad);
        }
        renderZoneChips();
        actualizarCircuitoDesdeZonas();
      };

      // Función: actualizar circuito a partir de las zonas seleccionadas
      function actualizarCircuitoDesdeZonas() {
        const zoneClearBtn = document.getElementById('planner-zone-clear-btn');
        const selectedDisplay = document.getElementById('planner-selected-zones-display');
        const selectedLabels = document.getElementById('planner-selected-zones-labels');

        if (selectedZones.size === 0) {
          if (plannerZoneSummary) plannerZoneSummary.classList.add('hidden');
          if (plannerNoGpsWarning) plannerNoGpsWarning.classList.add('hidden');
          if (zoneClearBtn) zoneClearBtn.classList.add('hidden');
          if (selectedDisplay) selectedDisplay.classList.add('hidden');
          circuitStops = [];
          renderCircuitStops();
          return;
        }

        // Mostrar botón limpiar y resumen de zonas
        if (zoneClearBtn) zoneClearBtn.classList.remove('hidden');
        if (selectedDisplay) selectedDisplay.classList.remove('hidden');
        if (selectedLabels) {
          selectedLabels.textContent = [...selectedZones].join(' + ');
        }

        // Filtrar guías de TODAS las zonas seleccionadas (activas)
        const guiasZonas = shipments.filter(g =>
          selectedZones.has((g.ciudad_destino || '').trim()) &&
          g.estado !== 'Entregado' && g.estado !== 'No entregado'
        );

        const guiasConGps = guiasZonas.filter(g =>
          g.gps_confirmado && g.gps_latitud != null && g.gps_longitud != null &&
          !isNaN(Number(g.gps_latitud)) && !isNaN(Number(g.gps_longitud))
        );
        const guiasSinGps = guiasZonas.length - guiasConGps.length;

        // Actualizar contadores
        if (plannerZoneGpsCount) plannerZoneGpsCount.textContent = String(guiasConGps.length);
        if (plannerZonePendingCount) plannerZonePendingCount.textContent = String(guiasSinGps);
        if (plannerZoneTotalCount) plannerZoneTotalCount.textContent = String(guiasZonas.length);
        if (plannerZoneZonesCount) plannerZoneZonesCount.textContent = String(selectedZones.size);
        if (plannerZoneSummary) plannerZoneSummary.classList.remove('hidden');

        // Advertencia GPS
        if (guiasSinGps > 0 && plannerNoGpsWarning && plannerNoGpsWarningText) {
          const zonasList = [...selectedZones].join(', ');
          plannerNoGpsWarningText.textContent = `${guiasSinGps} guía${guiasSinGps > 1 ? 's' : ''} en (${zonasList}) no tienen GPS confirmado. Solo las ${guiasConGps.length} guías con GPS se incluirán.`;
          plannerNoGpsWarning.classList.remove('hidden');
        } else if (plannerNoGpsWarning) {
          plannerNoGpsWarning.classList.add('hidden');
        }

        // Cargar paradas combinadas
        circuitStops = [...guiasConGps];
        circuitOptimized = false;
        renderCircuitStops();
      }

      // Función: abrir el modal del planificador
      window.openRoutePlannerModal = function() {
        if (!routePlannerModal) return;

        // Poblar selector de choferes
        if (plannerDriverSelect) {
          plannerDriverSelect.innerHTML = '<option value="">-- Selecciona un chofer --</option>';
          drivers.filter(d => d.rol === 'chofer').forEach(d => {
            const opt = document.createElement('option');
            opt.value = String(d.id);
            opt.textContent = d.nombre;
            plannerDriverSelect.appendChild(opt);
          });
        }

        // Resetear estado
        selectedZones.clear();
        circuitStops = [];
        circuitOptimized = false;
        plannerMapVisible = false;
        if (plannerRouteMapWrapper) plannerRouteMapWrapper.classList.add('hidden');
        if (btnToggleMapText) btnToggleMapText.textContent = 'Ver Mapa';
        if (plannerZoneSummary) plannerZoneSummary.classList.add('hidden');
        if (plannerNoGpsWarning) plannerNoGpsWarning.classList.add('hidden');
        const zoneClearBtn = document.getElementById('planner-zone-clear-btn');
        if (zoneClearBtn) zoneClearBtn.classList.add('hidden');
        const selectedDisplay = document.getElementById('planner-selected-zones-display');
        if (selectedDisplay) selectedDisplay.classList.add('hidden');

        // Renderizar chips y paradas
        renderZoneChips();
        renderCircuitStops();

        routePlannerModal.classList.remove('hidden');
        routePlannerModal.classList.add('flex');
      };

      // Botón limpiar selección de zonas
      const zoneClearBtnEl = document.getElementById('planner-zone-clear-btn');
      if (zoneClearBtnEl) {
        zoneClearBtnEl.addEventListener('click', () => {
          selectedZones.clear();
          renderZoneChips();
          actualizarCircuitoDesdeZonas();
        });
      }


      // Función: renderizar las tarjetas de paradas con ETA
      function renderCircuitStops() {
        if (!plannerStopsList) return;

        const count = circuitStops.length;
        if (plannerStopsCountBadge) plannerStopsCountBadge.textContent = `${count} parada${count !== 1 ? 's' : ''}`;

        if (count === 0) {
          plannerStopsList.innerHTML = `
            <div class="text-center py-10 text-slate-400">
              <svg class="w-10 h-10 mx-auto mb-2 text-slate-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
              </svg>
              <p class="text-xs font-semibold text-slate-400">Selecciona una zona para cargar las paradas del circuito</p>
              <p class="text-[10px] text-slate-300 mt-1">Solo se incluyen guías con coordenadas GPS confirmadas</p>
            </div>`;
          if (plannerTotalKm) plannerTotalKm.textContent = '~0.0 km totales';
          if (plannerTotalTime) plannerTotalTime.textContent = '~0 min estimado';
          if (plannerEtaEnd) plannerEtaEnd.textContent = 'Llegada: --:--';
          if (plannerGmapsBatchButtons) plannerGmapsBatchButtons.innerHTML = '';
          return;
        }

        // Calcular métricas y ETAs
        const startCoords = getStartCoordinates();
        const serviceMinutes = parseInt(plannerServiceTimeSelect?.value || '8', 10);
        const startTimeStr = plannerStartTimeInput?.value || '08:00';
        const [startHour, startMin] = startTimeStr.split(':').map(Number);
        const isRoundTrip = (document.querySelector('input[name="circuit-type"]:checked') as HTMLInputElement)?.value === 'roundtrip';

        let totalKm = 0;
        let currentMinutes = startHour * 60 + startMin;
        let prevLat = startCoords.lat;
        let prevLon = startCoords.lon;

        // Velocidad promedio Venezuela urbana: 25 km/h
        const AVG_SPEED_KMH = 25;

        const stopData = circuitStops.map((stop, idx) => {
          const lat = Number(stop.gps_latitud);
          const lon = Number(stop.gps_longitud);
          const distKm = calculateDistance(prevLat, prevLon, lat, lon);
          const travelMin = Math.round((distKm / AVG_SPEED_KMH) * 60);
          currentMinutes += travelMin;
          const etaHora = Math.floor(currentMinutes / 60) % 24;
          const etaMin = currentMinutes % 60;
          const etaStr = `${String(etaHora).padStart(2, '0')}:${String(etaMin).padStart(2, '0')}`;

          totalKm += distKm;
          prevLat = lat;
          prevLon = lon;

          // Verificar ventana de tiempo del cliente
          let horaAlert = '';
          if (stop.hora_disponible) {
            const [hDisp, mDisp] = stop.hora_disponible.split(':').map(Number);
            const minDisponible = hDisp * 60 + mDisp;
            if (currentMinutes < minDisponible) {
              const espera = minDisponible - currentMinutes;
              horaAlert = `<span class="text-amber-600 font-bold text-[10px]">Llega ${espera}min antes (disponible a las ${stop.hora_disponible})</span>`;
              currentMinutes = minDisponible; // Esperar hasta la ventana
            } else if (currentMinutes > minDisponible + 120) {
              horaAlert = `<span class="text-rose-600 font-bold text-[10px]">Posible retraso (disponible ${stop.hora_disponible})</span>`;
            }
          }

          const result = { stop, idx, distKm, travelMin, etaStr, horaAlert };
          currentMinutes += serviceMinutes;
          return result;
        });

        // Distancia de retorno (si es round-trip)
        if (isRoundTrip && circuitStops.length > 0) {
          const last = circuitStops[circuitStops.length - 1];
          const retDist = calculateDistance(Number(last.gps_latitud), Number(last.gps_longitud), startCoords.lat, startCoords.lon);
          totalKm += retDist;
          const retMin = Math.round((retDist / AVG_SPEED_KMH) * 60);
          currentMinutes += retMin;
        }

        const totalMin = currentMinutes - (startHour * 60 + startMin);
        const horaFin = Math.floor(currentMinutes / 60) % 24;
        const minFin = currentMinutes % 60;
        if (plannerTotalKm) plannerTotalKm.textContent = `~${totalKm.toFixed(1)} km totales`;
        if (plannerTotalTime) plannerTotalTime.textContent = `~${totalMin} min estimado`;
        if (plannerEtaEnd) plannerEtaEnd.textContent = `Llegada: ${String(horaFin).padStart(2, '0')}:${String(minFin).padStart(2, '0')}`;

        // Renderizar tarjetas
        plannerStopsList.innerHTML = stopData.map(({ stop, idx, distKm, travelMin, etaStr, horaAlert }) => {
          const lat = Number(stop.gps_latitud);
          const lon = Number(stop.gps_longitud);
          const gmapsUrl = `https://www.google.com/maps/search/?api=1&query=${lat},${lon}`;

          return `
            <div class="group flex items-start gap-2.5 bg-white border border-slate-200 rounded-2xl p-3.5 hover:border-slate-300 hover:shadow-sm transition-all">
              <!-- Número de parada -->
              <div class="flex flex-col items-center gap-0.5 shrink-0 pt-0.5">
                <span class="w-7 h-7 rounded-xl ${circuitOptimized ? 'bg-indigo-600' : 'bg-slate-800'} text-white text-[11px] font-black flex items-center justify-center shadow-sm">${idx + 1}</span>
                ${idx < circuitStops.length - 1 ? '<div class="w-px h-3 bg-slate-200 rounded-full"></div>' : ''}
              </div>

              <!-- Info de la parada -->
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0">
                    <p class="text-xs font-extrabold text-slate-900 truncate">${stop.destinatario || '—'}</p>
                    <p class="text-[10px] text-slate-500 font-medium truncate">${stop.ciudad_destino || ''} · Guía #${stop.id_guia}</p>
                  </div>
                  <!-- ETA badge -->
                  <div class="shrink-0 text-right">
                    <span class="text-[11px] font-black text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded-lg block">${etaStr}</span>
                    <span class="text-[9px] text-slate-400 font-medium block mt-0.5">${travelMin} min · ${distKm.toFixed(1)} km</span>
                  </div>
                </div>

                <!-- Coordenadas GPS y alertas -->
                <div class="flex items-center justify-between mt-1.5 gap-2">
                  <div class="flex items-center gap-2">
                    <span class="text-[10px] text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded font-mono font-bold">${lat.toFixed(4)}, ${lon.toFixed(4)}</span>
                    ${stop.piezas ? `<span class="text-[10px] text-slate-500 font-bold">${stop.piezas} pza${stop.piezas > 1 ? 's' : ''}</span>` : ''}
                    ${horaAlert}
                  </div>
                  <!-- Botones de acción -->
                  <div class="flex items-center gap-1">
                    <a href="${gmapsUrl}" target="_blank" rel="noopener" class="p-1.5 rounded-lg bg-slate-50 border border-slate-200 hover:bg-slate-100 text-slate-600 transition-colors" title="Ver en Google Maps">
                      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                    </a>
                    <button type="button" onclick="window.moveCircuitStop(${idx}, -1)" class="p-1.5 rounded-lg bg-slate-50 border border-slate-200 hover:bg-slate-100 text-slate-600 transition-colors ${idx === 0 ? 'opacity-30 cursor-default' : 'cursor-pointer'}" title="Subir parada" ${idx === 0 ? 'disabled' : ''}>
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg>
                    </button>
                    <button type="button" onclick="window.moveCircuitStop(${idx}, 1)" class="p-1.5 rounded-lg bg-slate-50 border border-slate-200 hover:bg-slate-100 text-slate-600 transition-colors ${idx === circuitStops.length - 1 ? 'opacity-30 cursor-default' : 'cursor-pointer'}" title="Bajar parada" ${idx === circuitStops.length - 1 ? 'disabled' : ''}>
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          `;
        }).join('');

        // Generar botones de Google Maps por tramos de 9 paradas
        if (plannerGmapsBatchButtons) {
          const startCoords2 = getStartCoordinates();
          const batchSize = 9;
          const batches: string[] = [];

          for (let i = 0; i < circuitStops.length; i += batchSize) {
            const batch = circuitStops.slice(i, Math.min(i + batchSize, circuitStops.length));
            const batchStart = i === 0 ? `${startCoords2.lat},${startCoords2.lon}` : `${Number(circuitStops[i-1].gps_latitud)},${Number(circuitStops[i-1].gps_longitud)}`;
            const batchEnd = `${Number(batch[batch.length-1].gps_latitud)},${Number(batch[batch.length-1].gps_longitud)}`;
            const waypoints = batch.slice(0, -1).map(s => `${Number(s.gps_latitud)},${Number(s.gps_longitud)}`).join('|');
            const url = `https://www.google.com/maps/dir/?api=1&origin=${batchStart}&destination=${batchEnd}${waypoints ? `&waypoints=${encodeURIComponent(waypoints)}` : ''}&travelmode=driving`;

            batches.push(`<a href="${url}" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-indigo-200 text-indigo-800 text-[11px] font-bold hover:bg-indigo-50 hover:border-indigo-400 transition-all shadow-xs">
              <svg class="w-3 h-3 text-indigo-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
              Tramo ${batches.length + 1} (Paradas ${i+1}–${Math.min(i+batchSize, circuitStops.length)})
            </a>`);
          }

          plannerGmapsBatchButtons.innerHTML = batches.length > 0 ? batches.join('') : '<span class="text-[11px] text-slate-400">Optimiza el circuito para generar los enlaces de navegación</span>';
        }

        // Actualizar mapa si está visible
        if (plannerMapVisible) renderCircuitMap();
      }

      // Función: mover una parada del circuito
      window.moveCircuitStop = function(idx: number, direction: number) {
        const newIdx = idx + direction;
        if (newIdx < 0 || newIdx >= circuitStops.length) return;
        [circuitStops[idx], circuitStops[newIdx]] = [circuitStops[newIdx], circuitStops[idx]];
        circuitOptimized = false;
        renderCircuitStops();
      };

      // Algoritmo TSP con Agrupamiento Atómico y 2-Opt para eliminar cruces de ruta
      function solveDashboard2Opt(originLat: number, originLon: number, stops: GuiaRow[]): GuiaRow[] {
        if (stops.length <= 1) return stops;
        
        // 1. Agrupar paradas colindantes (< 180m)
        const clusters: { lat: number; lon: number; items: GuiaRow[] }[] = [];
        const visited = new Set<number>();

        for (let i = 0; i < stops.length; i++) {
          if (visited.has(i)) continue;
          const group: GuiaRow[] = [stops[i]];
          visited.add(i);
          const latI = Number(stops[i].gps_latitud);
          const lonI = Number(stops[i].gps_longitud);

          for (let j = i + 1; j < stops.length; j++) {
            if (visited.has(j)) continue;
            const latJ = Number(stops[j].gps_latitud);
            const lonJ = Number(stops[j].gps_longitud);
            const dist = calculateDistance(latI, lonI, latJ, lonJ);
            if (dist < 0.18) {
              group.push(stops[j]);
              visited.add(j);
            }
          }
          clusters.push({ lat: latI, lon: lonI, items: group });
        }

        // 2. Nearest Neighbor en clusters
        let remaining = [...clusters];
        let tour: { lat: number; lon: number; items: GuiaRow[] }[] = [];
        let currLat = originLat;
        let currLon = originLon;

        while (remaining.length > 0) {
          let bestIdx = 0;
          let bestDist = Infinity;
          for (let i = 0; i < remaining.length; i++) {
            const d = calculateDistance(currLat, currLon, remaining[i].lat, remaining[i].lon);
            if (d < bestDist) { bestDist = d; bestIdx = i; }
          }
          const next = remaining.splice(bestIdx, 1)[0];
          tour.push(next);
          currLat = next.lat;
          currLon = next.lon;
        }

        // 3. Refinamiento 2-Opt
        let improved = true;
        let iterations = 0;
        while (improved && iterations < 60) {
          improved = false;
          iterations++;
          for (let i = 0; i < tour.length - 1; i++) {
            for (let k = i + 1; k < tour.length; k++) {
              const pALat = i === 0 ? originLat : tour[i - 1].lat;
              const pALon = i === 0 ? originLon : tour[i - 1].lon;
              const pBLat = tour[i].lat;
              const pBLon = tour[i].lon;
              const pCLat = tour[k].lat;
              const pCLon = tour[k].lon;
              const pDLat = k + 1 < tour.length ? tour[k + 1].lat : originLat;
              const pDLon = k + 1 < tour.length ? tour[k + 1].lon : originLon;

              const dCurrent = calculateDistance(pALat, pALon, pBLat, pBLon) + calculateDistance(pCLat, pCLon, pDLat, pDLon);
              const dNew = calculateDistance(pALat, pALon, pCLat, pCLon) + calculateDistance(pBLat, pBLon, pDLat, pDLon);

              if (dNew < dCurrent - 0.001) {
                const sub = tour.slice(i, k + 1).reverse();
                tour.splice(i, k - i + 1, ...sub);
                improved = true;
              }
            }
          }
        }
        return tour;
      }

      // Función: optimizar el circuito con TSP 2-Opt Spoke Engine
      window.optimizeCircuit = function() {
        if (circuitStops.length < 2) {
          showToast('Selecciona una zona con al menos 2 guías con GPS para optimizar el circuito.', 'error');
          return;
        }

        const btn = document.getElementById('btn-optimize-circuit');
        if (btn) {
          btn.textContent = 'Optimizando...';
          (btn as HTMLButtonElement).disabled = true;
        }

        setTimeout(() => {
          try {
            const startCoords2 = getStartCoordinates();
            const optimized = solveDashboard2Opt(startCoords2.lat, startCoords2.lon, circuitStops);

            circuitStops = optimized;
            circuitOptimized = true;
            renderCircuitStops();

            showToast(`Circuito Spoke optimizado: ${optimized.length} paradas secuenciadas sin cruces desde la salida.`, 'success');
          } catch (err) {
            console.error('Error optimizando circuito:', err);
            showToast('Error al optimizar el circuito.', 'error');
          } finally {
            if (btn) {
              btn.textContent = 'Optimizar Circuito';
              (btn as HTMLButtonElement).disabled = false;
            }
          }
        }, 50);
      };

      // Función: mostrar/ocultar mapa del circuito
      window.togglePlannerRouteMap = function() {
        if (!plannerRouteMapWrapper) return;
        plannerMapVisible = !plannerMapVisible;

        if (plannerMapVisible) {
          plannerRouteMapWrapper.classList.remove('hidden');
          if (btnToggleMapText) btnToggleMapText.textContent = 'Ocultar Mapa';
          setTimeout(() => renderCircuitMap(), 100);
        } else {
          plannerRouteMapWrapper.classList.add('hidden');
          if (btnToggleMapText) btnToggleMapText.textContent = 'Ver Mapa';
        }
      };

      // Función: renderizar el mapa Leaflet del circuito con trazado OSRM real
      function renderCircuitMap() {
        if (!(window as any).L) return;
        const L = (window as any).L;
        const mapContainer = document.getElementById('planner-full-route-map');
        if (!mapContainer) return;

        if (plannerMapInstance) {
          try { plannerMapInstance.remove(); } catch (_) {}
          plannerMapInstance = null;
        }
        mapContainer.innerHTML = '';

        const startCoords2 = getStartCoordinates();
        const centerLat = circuitStops.length > 0 ? Number(circuitStops[0].gps_latitud) : startCoords2.lat;
        const centerLon = circuitStops.length > 0 ? Number(circuitStops[0].gps_longitud) : startCoords2.lon;

        plannerMapInstance = L.map(mapContainer, { zoomControl: true, attributionControl: false }).setView([centerLat, centerLon], 13);

        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
          maxZoom: 19, attribution: ''
        }).addTo(plannerMapInstance);

        const allPoints: [number, number][] = [];

        // Marcador de inicio
        const startIcon = L.divIcon({
          html: `<div style="width:28px;height:28px;border-radius:10px;background:#4338ca;border:2.5px solid white;box-shadow:0 3px 8px rgba(67,56,202,0.4);display:flex;align-items:center;justify-content:center;color:white">
                   <svg style="width:15px;height:15px;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                 </div>`,
          className: '', iconSize: [28, 28], iconAnchor: [14, 14]
        });
        L.marker([startCoords2.lat, startCoords2.lon], { icon: startIcon })
          .addTo(plannerMapInstance)
          .bindPopup(`<b>Salida / Almacén</b><br>${startCoords2.label}`);
        allPoints.push([startCoords2.lat, startCoords2.lon]);

        // Marcadores de paradas
        circuitStops.forEach((stop, idx) => {
          const lat = Number(stop.gps_latitud);
          const lon = Number(stop.gps_longitud);
          allPoints.push([lat, lon]);

          const stopIcon = L.divIcon({
            html: `<div style="width:26px;height:26px;border-radius:50%;background:#0f172a;border:2.5px solid white;box-shadow:0 2px 6px rgba(0,0,0,0.3);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;color:white">${idx + 1}</div>`,
            className: '', iconSize: [26, 26], iconAnchor: [13, 13]
          });

          L.marker([lat, lon], { icon: stopIcon })
            .addTo(plannerMapInstance)
            .bindPopup(`<b>Parada ${idx + 1}</b><br>${stop.destinatario || ''}<br>Guía #${stop.id_guia}`);
        });

        // Retorno si es bucle
        const isRoundTrip2 = (document.querySelector('input[name="circuit-type"]:checked') as HTMLInputElement)?.value === 'roundtrip';
        if (isRoundTrip2 && circuitStops.length > 0) {
          allPoints.push([startCoords2.lat, startCoords2.lon]);
        }

        if (allPoints.length > 1) {
          const directPoly = L.polyline(allPoints, { color: '#6366f1', weight: 3.5, opacity: 0.9 }).addTo(plannerMapInstance);
          plannerMapInstance.fitBounds(allPoints, { padding: [30, 30] });

          // Consulta OSRM para carretera real
          const pointsReq = allPoints.slice(0, 25);
          const url = 'https://router.project-osrm.org/route/v1/driving/' +
            pointsReq.map(p => p[1].toFixed(5) + ',' + p[0].toFixed(5)).join(';') +
            '?overview=full&geometries=geojson';

          fetch(url)
            .then(res => res.json())
            .then(data => {
              if (data.code === 'Ok' && data.routes && data.routes[0] && data.routes[0].geometry) {
                const roadCoords: [number, number][] = data.routes[0].geometry.coordinates.map((c: number[]) => [c[1], c[0]]);
                plannerMapInstance.removeLayer(directPoly);

                L.polyline(roadCoords, { color: '#312e81', weight: 6, opacity: 0.35, lineCap: 'round' }).addTo(plannerMapInstance);
                L.polyline(roadCoords, { color: '#4f46e5', weight: 3.5, opacity: 0.95, lineCap: 'round' }).addTo(plannerMapInstance);
              }
            })
            .catch(() => {});
        }
      }


      // Función: seleccionar punto de inicio
      window.selectStartLocation = function(name: string) {
        if (plannerStartInput) {
          plannerStartInput.value = name;
        }
        if (plannerMapVisible) renderCircuitMap();
      };

      // Función: guardar el circuito planificado en la BD
      window.savePlannedRoute = async function(dispatchToRoute: boolean) {
        if (circuitStops.length === 0) {
          showToast('No hay paradas en el circuito. Selecciona una zona primero.', 'error');
          return;
        }

        const driverId = plannerDriverSelect?.value;
        if (!driverId) {
          showToast('Selecciona un chofer para el circuito.', 'error');
          return;
        }

        const zona = [...selectedZones].join(' + ');
        if (!zona) {
          showToast('Selecciona al menos una zona para el circuito.', 'error');
          return;
        }

        const btn = document.getElementById(dispatchToRoute ? 'planner-save-btn' : 'planner-save-almacen-btn');
        const origHtml = btn?.innerHTML || '';
        if (btn) {
          btn.innerHTML = '<span class="opacity-60">Guardando...</span>';
          (btn as HTMLButtonElement).disabled = true;
        }

        try {
          // Una sola request con el formato correcto de /api/guias/ruta
          const res = await fetch('/api/guias/ruta', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              chofer_id: parseInt(driverId, 10),
              ruta_origen: getStartCoordinates().label,
              ruta_destino: zona,
              despachar_en_ruta: dispatchToRoute,
              paradas: circuitStops.map((stop, idx) => ({
                id_guia: stop.id_guia,
                orden: idx + 1
              }))
            })
          });

          const data = await res.json();

          if (data.success) {
            const action = dispatchToRoute ? 'despachado a ruta' : 'guardado en almacen';
            showToast(`Circuito de ${circuitStops.length} paradas ${action} exitosamente.`, 'success');
            closeRoutePlannerModal();
            await fetchData();
          } else {
            showToast(data.message || 'Error al guardar el circuito.', 'error');
          }

        } catch (err) {
          console.error('Error guardando circuito:', err);
          showToast('Error al guardar el circuito. Intenta nuevamente.', 'error');
        } finally {
          if (btn) {
            btn.innerHTML = origHtml;
            (btn as HTMLButtonElement).disabled = false;
          }
        }
      };

      // Función: cerrar modal del planificador
      function closeRoutePlannerModal() {
        if (!routePlannerModal) return;
        routePlannerModal.classList.add('hidden');
        routePlannerModal.classList.remove('flex');
        circuitStops = [];
        if (plannerMapInstance) {
          try { plannerMapInstance.remove(); } catch (_) {}
          plannerMapInstance = null;
        }
        plannerMapVisible = false;
      }

      // Event listeners del planificador
      if (plannerCloseBtn) plannerCloseBtn.addEventListener('click', closeRoutePlannerModal);
      if (plannerCancelBtn) plannerCancelBtn.addEventListener('click', closeRoutePlannerModal);
      if (routePlannerModal) {
        routePlannerModal.addEventListener('click', (e) => {
          if (e.target === routePlannerModal) closeRoutePlannerModal();
        });
      }

      // Recalcular ETAs cuando cambian hora de inicio o tiempo de servicio
      if (plannerStartTimeInput) plannerStartTimeInput.addEventListener('change', () => { if (circuitStops.length > 0) renderCircuitStops(); });
      if (plannerServiceTimeSelect) plannerServiceTimeSelect.addEventListener('change', () => { if (circuitStops.length > 0) renderCircuitStops(); });
      document.querySelectorAll('input[name="circuit-type"]').forEach(radio => {
        radio.addEventListener('change', () => { if (circuitStops.length > 0) renderCircuitStops(); });
      });

      // Autocomplete del punto de salida
      if (plannerStartInput) {
        plannerStartInput.addEventListener('input', () => {
          const val = plannerStartInput.value;
          const clearBtn = document.getElementById('btn-clear-start-input');
          if (clearBtn) clearBtn.classList.toggle('hidden', !val);

          const dropdown = document.getElementById('start-autocomplete-dropdown');
          if (!dropdown) return;
          if (val.length < 2) { dropdown.classList.add('hidden'); return; }

          const norm = normalizeText(val);
          const matches = Object.keys(VENEZUELA_COORDS_MAP).filter(k => k.includes(norm) || norm.includes(k));

          if (matches.length === 0) { dropdown.classList.add('hidden'); return; }

          dropdown.innerHTML = matches.slice(0, 8).map(k =>
            `<button type="button" class="w-full text-left px-3 py-2 text-xs text-slate-800 font-semibold hover:bg-indigo-50 hover:text-indigo-800 rounded-lg transition-colors" onclick="window.selectStartLocation('${k}')">${k.charAt(0).toUpperCase() + k.slice(1)}</button>`
          ).join('');
          dropdown.classList.remove('hidden');
        });

        document.addEventListener('click', (e) => {
          const dropdown = document.getElementById('start-autocomplete-dropdown');
          if (dropdown && !plannerStartInput.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
            dropdown.classList.add('hidden');
          }
        });
      }

      const btnClearStartInput = document.getElementById('btn-clear-start-input');
      if (btnClearStartInput) {
        btnClearStartInput.addEventListener('click', () => {
          if (plannerStartInput) plannerStartInput.value = '';
          btnClearStartInput.classList.add('hidden');
        });
      }

      // ============================================================
      // FIN MOTOR PLANIFICADOR DE CIRCUITO
      // ============================================================

      init();

    </script>
  </body>
</html>
