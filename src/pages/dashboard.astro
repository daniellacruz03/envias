      (window as any).deleteShipment = async (id_guia: string) => {
        if (!confirm(`¿Estás seguro de eliminar la guía #${id_guia} de PostgreSQL?`)) return;

        try {
          const res = await fetch(`/api/guias/${encodeURIComponent(id_guia)}`, {
            method: 'DELETE'
          });

          const json = await res.json();
          if (res.ok && json.success) {
            shipments = shipments.filter(s => s.id_guia !== id_guia);
            populateCityFilter();
            renderViews();
            showToast(`Guía #${id_guia} eliminada de la base de datos`, 'info');
          } else {
            showToast(json.message || 'Error al eliminar la guía', 'error');
          }
        } catch (err) {
          showToast('Error de red al eliminar la guía', 'error');
        }
      };

      // Formateador universal de números de teléfono para WhatsApp
      function formatPhoneForWhatsApp(rawPhone: string): string {
        let trimmed = rawPhone.trim();
        let clean = trimmed.replace(/\D/g, '');
        if (trimmed.startsWith('0')) {
          clean = '58' + clean.replace(/^0+/, '');
        }
        return clean;
      }

      // Formatear nombres a Title Case
      function toTitleCase(str: string): string {
        if (!str) return '';
        return str
          .toLowerCase()
          .split(' ')
          .map(word => word.charAt(0).toUpperCase() + word.slice(1))
          .join(' ');
      }

      // Acción de WhatsApp con plantilla oficial y cambio automático a "Contactado"
      (window as any).sendWhatsApp = async (id_guia: string) => {
        const item = shipments.find(s => s.id_guia === id_guia);
        if (!item) return;

        const phoneFormatted = formatPhoneForWhatsApp(item.telefono_principal);
        const host = window.location.origin;
        const customerUrl = `${host}/confirmar?guia=${encodeURIComponent(item.id_guia)}`;
        const customerName = toTitleCase(item.destinatario);
        const city = item.ciudad_destino || 'su localidad';
        const piecesText = (item.piezas || 1) === 1 ? '1 pieza' : `${item.piezas} piezas`;

        const message = 
`*ENVÍAS C.A. | Notificación de Despacho*

Estimado(a) *${customerName}*,

Le informamos que su paquete con *Guía #${item.id_guia}* (${piecesText}) se encuentra en proceso de entrega hacia *${city}*.

Para asegurar una entrega puntual y sin contratiempos, por favor confirme su punto de entrega en nuestro portal oficial:
${customerUrl}

_Envías C.A. • Transporte y Logística Nacional_`;

        const whatsappUrl = `https://wa.me/${phoneFormatted}?text=${encodeURIComponent(message)}`;

        window.open(whatsappUrl, '_blank');
        showToast(`Abriendo WhatsApp para guía #${item.id_guia}...`, 'success');

        // Si estaba "Por contactar", pasar automáticamente a "Contactado"
        if (item.estado === 'Por contactar') {
          await (window as any).updateShipmentStatus(item.id_guia, 'Contactado');
        }
      };

      // Helper para Toasts visuales sin emojis
      function showToast(message: string, type: 'success' | 'info' | 'error' = 'info') {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `px-4 py-3 rounded-2xl shadow-xl text-xs font-semibold flex items-center gap-2.5 border transition-all duration-300 transform translate-y-2 opacity-0 pointer-events-auto ${
          type === 'success' ? 'bg-slate-900 text-white border-slate-800' :
          type === 'error' ? 'bg-rose-600 text-white border-rose-700' :
          'bg-white text-slate-800 border-slate-200 shadow-slate-900/10'
        }`;

        let iconSvg = `
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sky-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        `;
        if (type === 'success') {
          iconSvg = `
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          `;
        }
        if (type === 'error') {
          iconSvg = `
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          `;
        }

        toast.innerHTML = `${iconSvg} <span>${message}</span>`;
        container.appendChild(toast);

        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-2', 'opacity-0');
        });

        setTimeout(() => {
          toast.classList.add('translate-y-2', 'opacity-0');
          setTimeout(() => toast.remove(), 300);
        }, 3500);
      }

      // Lightbox para ver fotos de comprobantes y guías con ZOOM y PAN
      const lightboxModal = document.getElementById('lightbox-modal') as HTMLElement;
      const lightboxCloseBtn = document.getElementById('lightbox-close-btn') as HTMLElement;
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
      const lightboxTitle = document.getElementById('lightbox-title') as HTMLElement;
      const lightboxInfo = document.getElementById('lightbox-info') as HTMLElement;
      const lightboxExternalLink = document.getElementById('lightbox-external-link') as HTMLAnchorElement;
      const lightboxDeleteBtn = document.getElementById('lightbox-delete-btn') as HTMLButtonElement;
      const lightboxViewport = document.getElementById('lightbox-viewport') as HTMLElement;
      const lightboxZoomIn = document.getElementById('lightbox-zoom-in') as HTMLButtonElement;
      const lightboxZoomOut = document.getElementById('lightbox-zoom-out') as HTMLButtonElement;
      const lightboxZoomReset = document.getElementById('lightbox-zoom-reset') as HTMLButtonElement;
      const lightboxZoomLevel = document.getElementById('lightbox-zoom-level') as HTMLElement;
      const lightboxRotate = document.getElementById('lightbox-rotate') as HTMLButtonElement;

      let zoomScale = 1;
      let panX = 0;
      let panY = 0;
      let rotation = 0;
      let isPanning = false;
      let startX = 0;
      let startY = 0;

      let currentLightboxTargetId: string | number | null = null;
      let currentLightboxTargetType: 'guia' | 'escaneo' | null = null;

      function applyTransform() {
        if (!lightboxImg) return;
        lightboxImg.style.transform = `translate(${panX}px, ${panY}px) scale(${zoomScale}) rotate(${rotation}deg)`;
        if (lightboxZoomLevel) {
          lightboxZoomLevel.textContent = `${Math.round(zoomScale * 100)}%`;
        }
      }

      function resetZoom() {
        zoomScale = 1;
        panX = 0;
        panY = 0;
        rotation = 0;
        applyTransform();
      }

      function setZoom(newScale: number) {
        zoomScale = Math.min(Math.max(0.5, newScale), 5.0);
        if (zoomScale === 1) {
          panX = 0;
          panY = 0;
        }
        applyTransform();
      }

      (window as any).openLightbox = (imgUrl: string, title?: string, info?: string, targetId?: string | number, targetType?: 'guia' | 'escaneo') => {
        if (!lightboxModal || !lightboxImg) return;
        resetZoom();
        lightboxImg.src = imgUrl;
        if (lightboxTitle) lightboxTitle.textContent = title || 'Visualizador de Imagen';
        if (lightboxInfo) lightboxInfo.textContent = info || '';
        if (lightboxExternalLink) lightboxExternalLink.href = imgUrl;

        currentLightboxTargetId = targetId || null;
        currentLightboxTargetType = targetType || (targetId ? 'guia' : null);

        if (lightboxDeleteBtn) {
          if (currentLightboxTargetId) {
            lightboxDeleteBtn.classList.remove('hidden');
          } else {
            lightboxDeleteBtn.classList.add('hidden');
          }
        }

        lightboxModal.classList.remove('hidden');
        lightboxModal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      };

      // Handler para eliminar foto desde el Lightbox
      lightboxDeleteBtn?.addEventListener('click', async () => {
        if (!currentLightboxTargetId) return;

        const isGuia = currentLightboxTargetType === 'guia' || !currentLightboxTargetType;
        const confirmMsg = isGuia
          ? `¿Estás seguro de que deseas eliminar la foto de la guía #${currentLightboxTargetId}?`
          : `¿Estás seguro de que deseas eliminar esta foto de escaneo?`;

        if (!confirm(confirmMsg)) return;

        const originalHtml = lightboxDeleteBtn.innerHTML;
        lightboxDeleteBtn.disabled = true;
        lightboxDeleteBtn.innerHTML = `
          <svg class="animate-spin w-3.5 h-3.5 text-rose-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          <span>Eliminando...</span>
        `;

        try {
          const endpoint = isGuia
            ? `/api/guias/${currentLightboxTargetId}/foto`
            : `/api/escaneos/${currentLightboxTargetId}`;

          const res = await fetch(endpoint, { method: 'DELETE' });
          const data = await res.json();

          if (res.ok && data.success) {
            showToast(data.message || 'Foto eliminada correctamente', 'success');

            if (isGuia) {
              // Actualizar en el estado local de guías en memoria
              const targetIdStr = currentLightboxTargetId.toString().toUpperCase();
              const guiaFound = shipments.find(g => g.id_guia && g.id_guia.toUpperCase() === targetIdStr);
              if (guiaFound) {
                guiaFound.comprobante_url = null;
                guiaFound.comprobante_base64 = null;
                guiaFound.recibido_por = null;
              }
              // Re-renderizar las vistas activas
              renderViews();
            } else {
              loadAndRenderEscaneos();
            }

            closeLightboxModal();
          } else {
            showToast(data.message || 'Error al eliminar la foto', 'error');
          }
        } catch (error: any) {
          showToast('Error de conexión al eliminar la foto', 'error');
        } finally {
          lightboxDeleteBtn.disabled = false;
          lightboxDeleteBtn.innerHTML = originalHtml;
        }
      });

      function closeLightboxModal() {
        lightboxModal?.classList.add('hidden');
        lightboxModal?.classList.remove('flex');
        if (lightboxImg) lightboxImg.src = '';
        resetZoom();
        const escaneoDrawerEl = document.getElementById('escaneo-drawer');
        if (!escaneoDrawerEl || escaneoDrawerEl.classList.contains('hidden')) {
          document.body.style.overflow = '';
        }
      }

      // Eventos de Zoom
      lightboxZoomIn?.addEventListener('click', () => setZoom(zoomScale + 0.3));
      lightboxZoomOut?.addEventListener('click', () => setZoom(zoomScale - 0.3));
      lightboxZoomReset?.addEventListener('click', () => resetZoom());
      lightboxRotate?.addEventListener('click', () => {
        rotation = (rotation + 90) % 360;
        applyTransform();
      });

      // Zoom con rueda del ratón
      lightboxViewport?.addEventListener('wheel', (e) => {
        e.preventDefault();
        const delta = e.deltaY > 0 ? -0.2 : 0.2;
        setZoom(zoomScale + delta);
      }, { passive: false });

      // Arrastre (Pan) con ratón
      lightboxViewport?.addEventListener('mousedown', (e) => {
        if (e.target === lightboxCloseBtn || (e.target as HTMLElement).closest('button') || (e.target as HTMLElement).closest('a')) return;
        isPanning = true;
        startX = e.clientX - panX;
        startY = e.clientY - panY;
        lightboxViewport.classList.add('cursor-grabbing');
      });

      window.addEventListener('mousemove', (e) => {
        if (!isPanning) return;
        panX = e.clientX - startX;
        panY = e.clientY - startY;
        applyTransform();
      });

      window.addEventListener('mouseup', () => {
        if (isPanning) {
          isPanning = false;
          lightboxViewport?.classList.remove('cursor-grabbing');
        }
      });

      // Soporte para gestos táctiles (Touch)
      let touchStartX = 0;
      let touchStartY = 0;
      let initialPinchDistance = 0;
      let initialPinchScale = 1;

      lightboxViewport?.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          isPanning = true;
          touchStartX = e.touches[0].clientX - panX;
          touchStartY = e.touches[0].clientY - panY;
        } else if (e.touches.length === 2) {
          isPanning = false;
          initialPinchDistance = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
          initialPinchScale = zoomScale;
        }
      }, { passive: true });

      lightboxViewport?.addEventListener('touchmove', (e) => {
        if (isPanning && e.touches.length === 1) {
          panX = e.touches[0].clientX - touchStartX;
          panY = e.touches[0].clientY - touchStartY;
          applyTransform();
        } else if (e.touches.length === 2 && initialPinchDistance > 0) {
          const currentDistance = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
          const factor = currentDistance / initialPinchDistance;
          setZoom(initialPinchScale * factor);
        }
      }, { passive: true });

      lightboxViewport?.addEventListener('touchend', () => {
        isPanning = false;
        initialPinchDistance = 0;
      });

      lightboxCloseBtn?.addEventListener('click', closeLightboxModal);
      lightboxModal?.addEventListener('click', (e) => {
        if (e.target === lightboxModal) {
          closeLightboxModal();
        }
