        // Capacidad por página: 20 filas por columna = 40 guías por hoja
        const MAX_PER_PAGE = 40;
        const totalSheets = Math.max(1, Math.ceil(zoneGuias.length / MAX_PER_PAGE));
        
        let allSheetsHtml = '';

        for (let sheetIdx = 0; sheetIdx < totalSheets; sheetIdx++) {
          const sheetGuias = zoneGuias.slice(sheetIdx * MAX_PER_PAGE, (sheetIdx + 1) * MAX_PER_PAGE);
          const half = Math.ceil(sheetGuias.length / 2);
          const leftGuias = sheetGuias.slice(0, half);
          const rightGuias = sheetGuias.slice(half);

          // 20 filas por hoja para que el alto total sea de ~980px y quepa 100% en hoja Carta sin desbordar
          const ROWS_PER_PAGE = 20;
