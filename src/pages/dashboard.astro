      // Función: agrupar guías con mismo cliente y misma ubicación satelital en 1 sola parada
      function groupGuiasIntoCircuitStops(guias: GuiaRow[]): CircuitStopGroup[] {
        const groups: CircuitStopGroup[] = [];

        guias.forEach(guia => {
          let lat = (guia.gps_latitud != null && !isNaN(Number(guia.gps_latitud))) ? Number(guia.gps_latitud) : null;
          let lon = (guia.gps_longitud != null && !isNaN(Number(guia.gps_longitud))) ? Number(guia.gps_longitud) : null;

          if (lat == null || lon == null) {
            const fallback = getCityFallbackCoordinates(guia.ciudad_destino || '');
            lat = fallback.lat;
            lon = fallback.lon;
          }

          const normClient = normalizeText(guia.destinatario || '');
          const cleanPhone = (guia.telefono_principal || guia.telefono_secundario || (guia as any).telefono_destinatario || '').replace(/\D/g, '');

          // Unir si es el mismo cliente (por nombre normalizado o teléfono idéntico) Y misma ubicación o ciudad
          const existing = groups.find(grp => {
            const sameClientName = normClient && normalizeText(grp.destinatario) === normClient;
            const samePhone = cleanPhone.length >= 7 && (grp.telefono_destinatario || '').replace(/\D/g, '') === cleanPhone;
            const clientMatches = Boolean(sameClientName || samePhone);

            const distKm = calculateDistance(grp.lat, grp.lon, lat!, lon!);
            const sameLocation = distKm < 0.1 || (grp.ciudad_destino.trim().toLowerCase() === (guia.ciudad_destino || '').trim().toLowerCase());

            return clientMatches && sameLocation;
          });

          const piezasNum = Number(guia.piezas) || 1;
          const volNum = Number(guia.pies_cubicos || (guia as any).volumen_pies_cubicos || 0);

          if (existing) {
            existing.guias.push(guia);
            existing.totalPiezas += piezasNum;
            existing.totalVolumen += volNum;
            if (!existing.hora_disponible && guia.hora_disponible) {
              existing.hora_disponible = guia.hora_disponible;
            }
          } else {
            groups.push({
              id: `stop-${guia.id_guia}`,
              destinatario: guia.destinatario || 'Cliente',
              ciudad_destino: guia.ciudad_destino || '',
              telefono_destinatario: guia.telefono_principal || guia.telefono_secundario || (guia as any).telefono_destinatario,
              direccion_destino: guia.direccion_referencia || (guia as any).direccion_destino,
              lat: lat!,
              lon: lon!,
              guias: [guia],
              totalPiezas: piezasNum,
              totalVolumen: volNum,
              hora_disponible: guia.hora_disponible
            });
          }
        });

        return groups;
      }

      // Función: actualizar circuito a partir de las zonas y lotes seleccionados
      function actualizarCircuitoDesdeZonas(customGuiasParam?: GuiaRow[] | null) {
        const zoneClearBtn = document.getElementById('planner-zone-clear-btn');
        const selectedDisplay = document.getElementById('planner-selected-zones-display');
        const selectedLabels = document.getElementById('planner-selected-zones-labels');

        if (selectedZones.size === 0 && (!customGuiasParam || customGuiasParam.length === 0)) {
          if (plannerZoneSummary) plannerZoneSummary.classList.add('hidden');
          if (plannerNoGpsWarning) plannerNoGpsWarning.classList.add('hidden');
          if (zoneClearBtn) zoneClearBtn.classList.add('hidden');
          if (selectedDisplay) selectedDisplay.classList.add('hidden');
          circuitStops = [];
          renderCircuitStops();
          return;
        }

        // Mostrar botón limpiar y resumen de zonas
        if (zoneClearBtn) zoneClearBtn.classList.remove('hidden');
        if (selectedDisplay) selectedDisplay.classList.remove('hidden');
        if (selectedLabels) {
          selectedLabels.textContent = [...selectedZones].join(' + ');
        }

        // Filtrar guías de TODAS las zonas seleccionadas intersectadas con lotes (o usar customGuiasParam)
        let guiasZonas: GuiaRow[] = [];
        if (customGuiasParam && customGuiasParam.length > 0) {
          guiasZonas = customGuiasParam;
        } else {
          const active = getActivePlannerShipments();
          const byLote = filterShipmentsBySelectedLotes(active);
          guiasZonas = byLote.filter(g => selectedZones.has((g.ciudad_destino || '').trim()));
        }

        // Auto-detección del chofer asignado a las guías de las zonas seleccionadas
        if (plannerDriverSelect) {
          if (plannerDriverSelect.options.length <= 1 && drivers.length > 0) {
            const curVal = plannerDriverSelect.value;
            plannerDriverSelect.innerHTML = '<option value="">-- Selecciona un chofer --</option>';
            drivers.forEach(d => {
              const opt = document.createElement('option');
              opt.value = String(d.id);
              opt.textContent = d.nombre;
              plannerDriverSelect.appendChild(opt);
            });
            if (curVal) plannerDriverSelect.value = curVal;
          }

          const guiasConChofer = guiasZonas.filter(g => g.chofer_asignado_id != null);
          const driverBadge = document.getElementById('planner-driver-auto-badge');
          if (guiasConChofer.length > 0) {
            const driverCounts: Record<number, number> = {};
            guiasConChofer.forEach(g => {
              const cid = Number(g.chofer_asignado_id);
              driverCounts[cid] = (driverCounts[cid] || 0) + 1;
            });
            const topDriverId = Object.keys(driverCounts).sort((a, b) => driverCounts[Number(b)] - driverCounts[Number(a)])[0];
            
            // Si el selector está vacío o si todas las guías pertenecen al mismo chofer, auto-seleccionar
            if (!plannerDriverSelect.value || driverCounts[Number(topDriverId)] === guiasZonas.length) {
              plannerDriverSelect.value = String(topDriverId);
              if (driverBadge) {
                const drv = drivers.find(d => String(d.id) === String(topDriverId));
                driverBadge.textContent = drv ? `Asignado (${drv.nombre})` : 'Pre-asignado';
                driverBadge.classList.remove('hidden');
              }
            }
          }
        }

        const guiasConGps = guiasZonas.filter(g =>
          g.gps_confirmado && g.gps_latitud != null && g.gps_longitud != null &&
          !isNaN(Number(g.gps_latitud)) && !isNaN(Number(g.gps_longitud))
        );
        const guiasSinGps = guiasZonas.length - guiasConGps.length;

        // Lotes únicos presentes en el circuito
        const lotesEnCircuito = new Set(guiasZonas.map(g => getGuiaLoteCode(g)));

        // Actualizar contadores
        if (plannerZoneGpsCount) plannerZoneGpsCount.textContent = String(guiasConGps.length);
        if (plannerZonePendingCount) plannerZonePendingCount.textContent = String(guiasSinGps);
        if (plannerZoneTotalCount) plannerZoneTotalCount.textContent = String(guiasZonas.length);
        if (plannerZoneZonesCount) plannerZoneZonesCount.textContent = String(selectedZones.size || 1);
        const plannerZoneLotesBadge = document.getElementById('planner-zone-lotes-count');
        if (plannerZoneLotesBadge) plannerZoneLotesBadge.textContent = String(lotesEnCircuito.size);
        if (plannerZoneSummary) plannerZoneSummary.classList.remove('hidden');

        // Advertencia informativa GPS
        if (guiasSinGps > 0 && plannerNoGpsWarning && plannerNoGpsWarningText) {
          const zonasList = [...selectedZones].join(', ') || 'Zona seleccionada';
          plannerNoGpsWarningText.textContent = `${guiasSinGps} guía${guiasSinGps > 1 ? 's' : ''} en (${zonasList}) no tienen GPS confirmado por cliente. Se asignarán al chofer usando la ubicación de referencia de su ciudad.`;
          plannerNoGpsWarning.classList.remove('hidden');
        } else if (plannerNoGpsWarning) {
          plannerNoGpsWarning.classList.add('hidden');
        }

        // Agrupar TODAS las guías de las zonas seleccionadas en paradas de circuito (usando fallback de ciudad si no tienen GPS)
        circuitStops = groupGuiasIntoCircuitStops(guiasZonas);
        circuitOptimized = false;
        
        // Auto-optimizar TSP si hay paradas
        if (circuitStops.length > 1) {
          const startCoords = getStartCoordinates();
          const endCoords = getEndCoordinates();
          circuitStops = solveDashboard2Opt(startCoords.lat, startCoords.lon, endCoords.lat, endCoords.lon, circuitStops);
          circuitOptimized = true;
        }

        renderCircuitStops();
      }
      (window as any).actualizarCircuitoDesdeZonas = actualizarCircuitoDesdeZonas;
      (window as any).actualizarCircuitoDesdeLotesYZonas = actualizarCircuitoDesdeZonas;

      // Función: abrir el modal del planificador con soporte para chofer, ciudad o guías pre-asignadas o lote pre-asignado
      window.openRoutePlannerModal = function(driverId?: number | string | null, zoneName?: string | null, customGuias?: GuiaRow[] | null, preselectedLote?: string | null) {
        if (!routePlannerModal) return;

        // Poblar selector de choferes con toda la flota
        if (plannerDriverSelect) {
          plannerDriverSelect.innerHTML = '<option value="">-- Selecciona un chofer --</option>';
          drivers.forEach(d => {
            const opt = document.createElement('option');
            opt.value = String(d.id);
            opt.textContent = d.nombre;
            plannerDriverSelect.appendChild(opt);
          });
        }

        // Cargar defaults de localStorage si existen
        try {
          const savedDefaults = localStorage.getItem('envias_route_defaults');
          if (savedDefaults) {
            const parsed = JSON.parse(savedDefaults);
            if (plannerStartInput && parsed.start) plannerStartInput.value = parsed.start;
            if (plannerEndInput && parsed.end) plannerEndInput.value = parsed.end;
            if (plannerRestSelect && parsed.rest) plannerRestSelect.value = parsed.rest;
            if (plannerServiceTimeSelect && parsed.serviceTime) plannerServiceTimeSelect.value = parsed.serviceTime;
            if (circuitSaveDefaultCheckbox) circuitSaveDefaultCheckbox.checked = true;
          }
        } catch (_) {}

        // Sincronizar sublabels de coordenadas
        updateStartSublabel();
        updateEndSublabel();

        // Resetear estado de zonas y lotes
        selectedZones.clear();
        selectedLotes.clear();
        const effectiveLote = (preselectedLote && preselectedLote.trim()) 
          ? preselectedLote.trim() 
          : (currentLoteFilter && currentLoteFilter !== 'ALL' ? currentLoteFilter : null);

        if (effectiveLote) {
          selectedLotes.add(effectiveLote);
        } else {
          selectedLotes.add('ALL');
        }

        circuitStops = [];
        circuitOptimized = false;
        plannerMapVisible = false;
        if (plannerRouteMapWrapper) plannerRouteMapWrapper.classList.add('hidden');
        if (btnToggleMapText) btnToggleMapText.textContent = 'Ver Mapa';
        if (plannerZoneSummary) plannerZoneSummary.classList.add('hidden');
        if (plannerNoGpsWarning) plannerNoGpsWarning.classList.add('hidden');
        const zoneClearBtn = document.getElementById('planner-zone-clear-btn');
        if (zoneClearBtn) zoneClearBtn.classList.add('hidden');
        const selectedDisplay = document.getElementById('planner-selected-zones-display');
        if (selectedDisplay) selectedDisplay.classList.add('hidden');
        const driverBadge = document.getElementById('planner-driver-auto-badge');
        if (driverBadge) driverBadge.classList.add('hidden');

        // Procesar argumentos si fueron provistos
        let targetDriverId = driverId ? String(driverId) : '';

        // Si se pasaron guías personalizadas
        if (customGuias && customGuias.length > 0) {
          const customZones = [...new Set(customGuias.map(g => (g.ciudad_destino || '').trim()).filter(Boolean))];
          customZones.forEach(z => selectedZones.add(z));
          if (!targetDriverId) {
            const firstWithDriver = customGuias.find(g => g.chofer_asignado_id != null || (g as any).chofer_id != null);
            if (firstWithDriver) {
              targetDriverId = String(firstWithDriver.chofer_asignado_id || (firstWithDriver as any).chofer_id);
            }
          }
        }

        // Si se pasó una zona específica (por ejemplo al hacer click en "Planificar Ruta" en una ciudad)
        if (zoneName && zoneName.trim()) {
          const cleanZone = zoneName.trim();
          selectedZones.add(cleanZone);
          if (!targetDriverId) {
            const zoneGuias = shipments.filter(g =>
              (g.ciudad_destino || '').trim().toLowerCase() === cleanZone.toLowerCase() &&
              g.estado !== 'Entregado' && g.estado !== 'No entregado' &&
              g.chofer_asignado_id != null
            );
            if (zoneGuias.length > 0) {
              targetDriverId = String(zoneGuias[0].chofer_asignado_id);
            }
          }
        }

        // Si se pasó chofer_id y NO se especificó zona ni customGuias, auto-seleccionar todas las zonas activas de ese chofer
        if (targetDriverId && selectedZones.size === 0 && (!customGuias || customGuias.length === 0)) {
          const parsedId = parseInt(targetDriverId, 10);
          const driverShipments = shipments.filter(g =>
            g.chofer_asignado_id === parsedId &&
            g.estado !== 'Entregado' && g.estado !== 'No entregado'
          );
          const driverZones = [...new Set(driverShipments.map(g => (g.ciudad_destino || '').trim()).filter(Boolean))];
          driverZones.forEach(z => selectedZones.add(z));
        }

        // Si hay un lote efectivo y aún no hay zonas seleccionadas, auto-cargar todas las ciudades de ese lote
        if (effectiveLote && selectedZones.size === 0 && (!customGuias || customGuias.length === 0)) {
          const activeShipments = getActivePlannerShipments();
          const filteredByLote = filterShipmentsBySelectedLotes(activeShipments);
          const loteZones = [...new Set(filteredByLote.map(g => (g.ciudad_destino || '').trim()).filter(Boolean))];
          loteZones.forEach(z => selectedZones.add(z));
        }

        // Fijar chofer en el selector si fue identificado
        if (targetDriverId && plannerDriverSelect) {
          plannerDriverSelect.value = targetDriverId;
          if (driverBadge) {
            const drv = drivers.find(d => String(d.id) === targetDriverId);
            driverBadge.textContent = drv ? `Asignado (${drv.nombre})` : 'Pre-asignado';
            driverBadge.classList.remove('hidden');
          }
        }

        // Poblar selector de lote del planificador y renderizar chips y zonas
        populatePlannerLoteSelect(effectiveLote || 'ALL');
        renderLoteChips();
        renderZoneChips();
        actualizarCircuitoDesdeZonas(customGuias);

        routePlannerModal.classList.remove('hidden');
        routePlannerModal.classList.add('flex');
      };

      function updateStartSublabel() {
        if (!plannerStartSublabel) return;
        const coords = getStartCoordinates();
        plannerStartSublabel.innerHTML = `<span class="font-mono font-bold text-indigo-700">${coords.lat.toFixed(4)}, ${coords.lon.toFixed(4)}</span> &bull; <span>${coords.label}</span>`;
      }

      function updateEndSublabel() {
        if (!plannerEndSublabel) return;
        const coords = getEndCoordinates();
        plannerEndSublabel.innerHTML = `<span class="font-mono font-bold text-emerald-700">${coords.lat.toFixed(4)}, ${coords.lon.toFixed(4)}</span> &bull; <span>${coords.label}</span>`;
      }

      // Botón limpiar selección de zonas
      const zoneClearBtnEl = document.getElementById('planner-zone-clear-btn');
      if (zoneClearBtnEl) {
        zoneClearBtnEl.addEventListener('click', () => {
          selectedZones.clear();
          renderZoneChips();
          actualizarCircuitoDesdeZonas();
        });
      }

      // ===== Modo de Ordenamiento Manual por Clic =====
      // orderQueue: orden en que el usuario va haciendo clic (posición 0 = primera parada)
      let orderQueue: number[] = []; // índices de circuitStops en el orden seleccionado
      let orderingMode = false;      // true cuando el usuario está asignando orden manualmente

      function activateOrderingMode() {
        orderQueue = [];
        orderingMode = true;
        renderCircuitStops();
        showToast('Modo de ordenamiento activo: haz clic en cada parada en el orden que quieres recorrerla (1, 2, 3...)', 'info');
      }

      function applyOrderQueue() {
        if (orderQueue.length !== circuitStops.length) {
          showToast(`Selecciona todas las paradas (${circuitStops.length}) antes de aplicar el orden.`, 'error');
          return;
        }
        const newOrder = orderQueue.map(i => circuitStops[i]);
        circuitStops = newOrder;
        orderingMode = false;
        orderQueue = [];
        circuitOptimized = false;
        renderCircuitStops();
        showToast('Orden aplicado correctamente.', 'success');
      }

      function cancelOrderingMode() {
        orderingMode = false;
        orderQueue = [];
        renderCircuitStops();
      }

      window.clickOrderStop = function(idx: number) {
        if (!orderingMode) return;
        if (orderQueue.includes(idx)) {
          // Desmarcar: quitar del queue
          orderQueue = orderQueue.filter(i => i !== idx);
        } else {
          orderQueue.push(idx);
        }
        renderCircuitStops();
        if (orderQueue.length === circuitStops.length) {
          applyOrderQueue();
        }
      };

      // Función: renderizar las tarjetas de paradas con ETA
      function renderCircuitStops() {
        if (!plannerStopsList) return;

        const count = circuitStops.length;
        const totalGuiasCount = circuitStops.reduce((acc, s) => acc + s.guias.length, 0);

        if (plannerStopsCountBadge) {
          plannerStopsCountBadge.textContent = count === totalGuiasCount 
            ? `${count} parada${count !== 1 ? 's' : ''}` 
            : `${count} parada${count !== 1 ? 's' : ''} (${totalGuiasCount} guías)`;
        }

        if (count === 0) {
          plannerStopsList.innerHTML = `
            <div class="text-center py-8 text-slate-400 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
              <svg class="w-8 h-8 mx-auto mb-1.5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
              </svg>
              <p class="text-xs font-semibold text-slate-500">Selecciona las zonas arriba para cargar las paradas del circuito</p>
              <p class="text-[10px] text-slate-400 mt-0.5">El sistema agrupará guías del mismo cliente y ordenará la ruta</p>
            </div>`;
          if (plannerTotalKm) plannerTotalKm.textContent = '~0.0 km';
          if (plannerTotalTime) plannerTotalTime.textContent = '~0 min';
          if (plannerEtaEnd) plannerEtaEnd.textContent = '--:--';
          if (plannerEtaEndMetric) plannerEtaEndMetric.textContent = '--:--';
          if (plannerGmapsBatchButtons) plannerGmapsBatchButtons.innerHTML = '<span class="text-[11px] text-slate-400">Selecciona una zona para generar tramos de navegación</span>';
          return;
        }

        // Calcular métricas y ETAs
        const startCoords = getStartCoordinates();
        const endCoords = getEndCoordinates();
        const serviceMinutes = parseInt(plannerServiceTimeSelect?.value || '8', 10);
        const restMinutes = parseInt(plannerRestSelect?.value || '30', 10);
        const startTimeStr = plannerStartTimeInput?.value || '08:00';
        const [startHour, startMin] = startTimeStr.split(':').map(Number);

        let totalKm = 0;
        let currentMinutes = startHour * 60 + startMin;
        let prevLat = startCoords.lat;
        let prevLon = startCoords.lon;

        // Velocidad promedio Venezuela urbana/interurbana: 30 km/h
        const AVG_SPEED_KMH = 30;

        const stopData = circuitStops.map((stop, idx) => {
          const lat = stop.lat;
          const lon = stop.lon;
          const distKm = calculateDistance(prevLat, prevLon, lat, lon);
          const travelMin = Math.round((distKm / AVG_SPEED_KMH) * 60);
          currentMinutes += travelMin;
          const etaHora = Math.floor(currentMinutes / 60) % 24;
          const etaMin = currentMinutes % 60;
          const etaStr = `${String(etaHora).padStart(2, '0')}:${String(etaMin).padStart(2, '0')}`;

          totalKm += distKm;
          prevLat = lat;
          prevLon = lon;

          // Añadir descanso en la mitad del recorrido
          if (restMinutes > 0 && idx === Math.floor(circuitStops.length / 2)) {
            currentMinutes += restMinutes;
          }

          // Verificar ventana de tiempo del cliente
          let horaAlert = '';
          if (stop.hora_disponible) {
            const [hDisp, mDisp] = stop.hora_disponible.split(':').map(Number);
            const minDisponible = hDisp * 60 + mDisp;
            if (currentMinutes < minDisponible) {
              const espera = minDisponible - currentMinutes;
              horaAlert = `<span class="text-amber-600 font-bold text-[10px]">Llega ${espera}min antes (disp. ${stop.hora_disponible})</span>`;
              currentMinutes = minDisponible;
            } else if (currentMinutes > minDisponible + 120) {
              horaAlert = `<span class="text-rose-600 font-bold text-[10px]">Retraso posible (disp. ${stop.hora_disponible})</span>`;
            }
          }

          const result = { stop, idx, distKm, travelMin, etaStr, horaAlert };
          currentMinutes += serviceMinutes;
          return result;
        });

        // Distancia hacia el punto de fin de ruta
        if (circuitStops.length > 0) {
          const last = circuitStops[circuitStops.length - 1];
          const retDist = calculateDistance(last.lat, last.lon, endCoords.lat, endCoords.lon);
          totalKm += retDist;
          const retMin = Math.round((retDist / AVG_SPEED_KMH) * 60);
          currentMinutes += retMin;
        }

        const totalMin = currentMinutes - (startHour * 60 + startMin);
        const horaFin = Math.floor(currentMinutes / 60) % 24;
        const minFin = currentMinutes % 60;
        const etaFinalStr = `${String(horaFin).padStart(2, '0')}:${String(minFin).padStart(2, '0')}`;

        if (plannerTotalKm) plannerTotalKm.textContent = `~${totalKm.toFixed(1)} km`;
        if (plannerTotalTime) plannerTotalTime.textContent = `~${totalMin} min`;
        if (plannerEtaEnd) plannerEtaEnd.textContent = etaFinalStr;
        if (plannerEtaEndMetric) plannerEtaEndMetric.textContent = etaFinalStr;

        // Renderizar tarjetas
        // Banner de modo ordenamiento activo
        const orderBannerHtml = orderingMode ? `
          <div class="flex items-center justify-between gap-2 bg-amber-50 border border-amber-200 rounded-2xl px-4 py-2.5 mb-3">
            <div class="flex items-center gap-2">
              <div class="w-5 h-5 rounded-full bg-amber-400 text-white text-[10px] font-black flex items-center justify-center animate-pulse">${orderQueue.length + 1}</div>
              <span class="text-xs font-bold text-amber-800">Modo Ordenar: haz clic en la parada que quieres en la posición <strong>${orderQueue.length + 1}</strong> de ${circuitStops.length}</span>
            </div>
            <button type="button" onclick="window.cancelOrderingMode()" class="text-[10px] font-bold text-amber-700 hover:text-amber-900 bg-amber-100 hover:bg-amber-200 px-2 py-1 rounded-lg transition-colors cursor-pointer">Cancelar</button>
          </div>
        ` : '';

        const stopCards = stopData.map(({ stop, idx, distKm, travelMin, etaStr, horaAlert }) => {
          const lat = stop.lat;
          const lon = stop.lon;
          const gmapsUrl = `https://www.google.com/maps/search/?api=1&query=${lat},${lon}`;
          const isGrouped = stop.guias.length > 1;

          // Estado en el modo de ordenamiento
          const posInQueue = orderQueue.indexOf(idx);
          const isSelected = posInQueue !== -1;
          const borderClass = orderingMode
            ? (isSelected ? 'border-emerald-400 bg-emerald-50/40 shadow-sm' : 'border-amber-200 bg-amber-50/30 hover:border-amber-400 cursor-pointer')
            : (isGrouped ? 'border-indigo-200 shadow-xs' : 'border-slate-200 hover:border-slate-300');

          const stopNumBadge = orderingMode
            ? (isSelected
                ? `<span class="w-7 h-7 rounded-xl bg-emerald-500 text-white text-[11px] font-black flex items-center justify-center shadow-xs ring-2 ring-emerald-300">${posInQueue + 1}</span>`
                : `<span class="w-7 h-7 rounded-xl bg-amber-400 text-white text-[11px] font-black flex items-center justify-center shadow-xs opacity-60">?</span>`)
            : `<span class="w-7 h-7 rounded-xl ${circuitOptimized ? 'bg-indigo-600' : 'bg-slate-800'} text-white text-[11px] font-black flex items-center justify-center shadow-xs">${idx + 1}</span>`;

          const clickAttr = orderingMode ? `onclick="window.clickOrderStop(${idx})" style="cursor:pointer"` : '';

          return `
            <div class="group flex items-start gap-2.5 bg-white border ${borderClass} rounded-2xl p-3.5 transition-all select-none" ${clickAttr}>
              <!-- Número de parada -->
              <div class="flex flex-col items-center gap-0.5 shrink-0 pt-0.5">
                ${stopNumBadge}
                ${idx < circuitStops.length - 1 ? '<div class="w-px h-3 bg-slate-200 rounded-full"></div>' : ''}
              </div>

              <!-- Info de la parada -->
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0">
                    <div class="flex items-center gap-1.5 flex-wrap">
                      <p class="text-xs font-extrabold text-slate-900 truncate">${stop.destinatario || '—'}</p>
                      ${isGrouped ? `
                        <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded-md bg-indigo-50 border border-indigo-200 text-indigo-700 text-[10px] font-black shrink-0">
                          <svg class="w-3 h-3 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                          </svg>
                          ${stop.guias.length} guías agrupadas
                        </span>
                      ` : ''}
                    </div>
                    
                    ${isGrouped ? `
                      <!-- Desglose de guías del mismo cliente -->
                      <div class="flex items-center gap-1.5 flex-wrap mt-1.5">
                        ${stop.guias.map(g => `
                          <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-slate-50 border border-slate-200 rounded-md text-[10px] font-bold text-slate-700">
                            <span class="text-indigo-600 font-extrabold">#${g.id_guia}</span>
                            <span class="text-slate-400">&bull;</span>
                            <span>${g.piezas || 1} pz${(g.piezas || 1) > 1 ? 's' : ''}</span>
                            <span class="text-slate-300">&bull;</span>
                            <span class="text-purple-700 font-mono text-[9px]">${getGuiaLoteCode(g)}</span>
                          </span>
                        `).join('')}
                      </div>
                    ` : `
                      <p class="text-[10px] text-slate-500 font-medium truncate flex items-center gap-1.5 flex-wrap mt-0.5">
                        <span>${stop.ciudad_destino || ''}</span>
                        <span>&bull;</span>
                        <span class="font-bold text-slate-700">Guía #${stop.guias[0]?.id_guia || ''}</span>
                        <span>&bull;</span>
                        <span class="inline-flex items-center px-1.5 py-0.2 rounded bg-purple-50 border border-purple-200 text-purple-700 font-mono font-bold text-[9px]">${getGuiaLoteCode(stop.guias[0])}</span>
                      </p>
                    `}
                  </div>

                  <!-- ETA badge -->
                  <div class="shrink-0 text-right">
                    <span class="text-[11px] font-black text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded-lg block">${etaStr}</span>
                    <span class="text-[9px] text-slate-400 font-medium block mt-0.5">${travelMin} min · ${distKm.toFixed(1)} km</span>
                  </div>
                </div>

                <!-- Coordenadas GPS y alertas -->
                <div class="flex items-center justify-between mt-2 gap-2 flex-wrap">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-[10px] text-emerald-700 bg-emerald-50 px-1.5 py-0.2 rounded font-mono font-bold">${lat.toFixed(4)}, ${lon.toFixed(4)}</span>
                    <span class="text-[10px] text-slate-700 font-bold bg-slate-100 px-1.5 py-0.2 rounded">${stop.totalPiezas} pza${stop.totalPiezas > 1 ? 's' : ''} total</span>
                    ${stop.totalVolumen > 0 ? `<span class="text-[10px] text-slate-500 font-medium">${stop.totalVolumen.toFixed(2)} ft³</span>` : ''}
                    ${horaAlert}
                  </div>
                  <!-- Botones de acción (ocultos en modo ordenamiento) -->
                  ${!orderingMode ? `
                  <div class="flex items-center gap-1" onclick="event.stopPropagation()">
                    <a href="${gmapsUrl}" target="_blank" rel="noopener" class="p-1 rounded-lg bg-slate-50 border border-slate-200 hover:bg-slate-100 text-slate-600 transition-colors" title="Ver en Google Maps">
                      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                    </a>
                  </div>` : `
                  <div class="flex items-center gap-1">
                    ${isSelected ? `<span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-lg border border-emerald-200">Parada ${posInQueue + 1} de ${circuitStops.length}</span>` : `<span class="text-[10px] font-semibold text-amber-600">Clic para asignar posicion</span>`}
                  </div>`}
                </div>
              </div>
            </div>
          `;
        }).join('');

        plannerStopsList.innerHTML = orderBannerHtml + stopCards;

        // Generar botones de Google Maps por tramos de 9 paradas
        if (plannerGmapsBatchButtons) {
          const startCoords2 = getStartCoordinates();
          const batchSize = 9;
          const batches: string[] = [];

          for (let i = 0; i < circuitStops.length; i += batchSize) {
            const batch = circuitStops.slice(i, Math.min(i + batchSize, circuitStops.length));
            const batchStart = i === 0 ? `${startCoords2.lat},${startCoords2.lon}` : `${circuitStops[i-1].lat},${circuitStops[i-1].lon}`;
            const batchEnd = `${batch[batch.length-1].lat},${batch[batch.length-1].lon}`;
            const waypoints = batch.slice(0, -1).map(s => `${s.lat},${s.lon}`).join('|');
            const url = `https://www.google.com/maps/dir/?api=1&origin=${batchStart}&destination=${batchEnd}${waypoints ? `&waypoints=${encodeURIComponent(waypoints)}` : ''}&travelmode=driving`;

            batches.push(`<a href="${url}" target="_blank" rel="noopener" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-white border border-indigo-200 text-indigo-800 text-[11px] font-bold hover:bg-indigo-50 hover:border-indigo-400 transition-all shadow-2xs">
              <svg class="w-3 h-3 text-indigo-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
              Tramo ${batches.length + 1} (${i+1}–${Math.min(i+batchSize, circuitStops.length)})
            </a>`);
          }

          plannerGmapsBatchButtons.innerHTML = batches.length > 0 ? batches.join('') : '<span class="text-[11px] text-slate-400">Sin paradas activas</span>';
        }

        // Actualizar mapa si está visible
        if (plannerMapVisible) renderCircuitMap();
      }

      // Función: mover una parada del circuito manualmente (legado, conservado)
      window.moveCircuitStop = function(idx: number, direction: number) {
        const newIdx = idx + direction;
        if (newIdx < 0 || newIdx >= circuitStops.length) return;
        [circuitStops[idx], circuitStops[newIdx]] = [circuitStops[newIdx], circuitStops[idx]];
        circuitOptimized = false;
        renderCircuitStops();
      };

      // Exponer funciones de ordenamiento por clic al scope global
      window.cancelOrderingMode = cancelOrderingMode;
      window.activateOrderingMode = activateOrderingMode;

      // Algoritmo TSP 2-Opt con soporte para Origen y Destino independientes en CircuitStopGroup[]
      function solveDashboard2Opt(originLat: number, originLon: number, endLat: number, endLon: number, stops: CircuitStopGroup[]): CircuitStopGroup[] {
        if (stops.length <= 1) return stops;
        
        // 1. Agrupar paradas colindantes (< 180m)
        const clusters: { lat: number; lon: number; items: CircuitStopGroup[] }[] = [];
        const visited = new Set<number>();

        for (let i = 0; i < stops.length; i++) {
          if (visited.has(i)) continue;
          const group: CircuitStopGroup[] = [stops[i]];
          visited.add(i);
          const latI = stops[i].lat;
          const lonI = stops[i].lon;

          for (let j = i + 1; j < stops.length; j++) {
            if (visited.has(j)) continue;
            const latJ = stops[j].lat;
            const lonJ = stops[j].lon;
            const dist = calculateDistance(latI, lonI, latJ, lonJ);
            if (dist < 0.18) {
              group.push(stops[j]);
              visited.add(j);
            }
          }
          clusters.push({ lat: latI, lon: lonI, items: group });
        }

        // 2. Nearest Neighbor desde Origen
        let remaining = [...clusters];
        let tour: { lat: number; lon: number; items: CircuitStopGroup[] }[] = [];
        let currLat = originLat;
        let currLon = originLon;

        while (remaining.length > 0) {
          let bestIdx = 0;
          let bestDist = Infinity;
          for (let i = 0; i < remaining.length; i++) {
            const d = calculateDistance(currLat, currLon, remaining[i].lat, remaining[i].lon);
            if (d < bestDist) { bestDist = d; bestIdx = i; }
          }
          const next = remaining.splice(bestIdx, 1)[0];
          tour.push(next);
          currLat = next.lat;
          currLon = next.lon;
        }

        // 3. Refinamiento 2-Opt con conexión al punto Final
        let improved = true;
        let iterations = 0;
        while (improved && iterations < 60) {
          improved = false;
          iterations++;
          for (let i = 0; i < tour.length - 1; i++) {
            for (let k = i + 1; k < tour.length; k++) {
              const pALat = i === 0 ? originLat : tour[i - 1].lat;
              const pALon = i === 0 ? originLon : tour[i - 1].lon;
              const pBLat = tour[i].lat;
              const pBLon = tour[i].lon;
              const pCLat = tour[k].lat;
              const pCLon = tour[k].lon;
              const pDLat = k + 1 < tour.length ? tour[k + 1].lat : endLat;
              const pDLon = k + 1 < tour.length ? tour[k + 1].lon : endLon;

              const dCurrent = calculateDistance(pALat, pALon, pBLat, pBLon) + calculateDistance(pCLat, pCLon, pDLat, pDLon);
              const dNew = calculateDistance(pALat, pALon, pCLat, pCLon) + calculateDistance(pBLat, pBLon, pDLat, pDLon);

              if (dNew < dCurrent - 0.001) {
                const sub = tour.slice(i, k + 1).reverse();
                tour.splice(i, k - i + 1, ...sub);
                improved = true;
              }
            }
          }
        }

        const flatResult: CircuitStopGroup[] = [];
        tour.forEach(c => flatResult.push(...c.items));
        return flatResult;
      }

      // Función: optimizar el circuito con TSP 2-Opt Spoke Engine
      window.optimizeCircuit = function() {
        if (circuitStops.length < 2) {
          showToast('Selecciona una zona con al menos 2 paradas con GPS para optimizar el circuito.', 'error');
          return;
        }

        const btn = document.getElementById('btn-optimize-circuit');
        if (btn) {
          btn.textContent = 'Optimizando...';
          (btn as HTMLButtonElement).disabled = true;
        }

        setTimeout(() => {
          try {
            const startCoords2 = getStartCoordinates();
            const endCoords2 = getEndCoordinates();
            const optimized = solveDashboard2Opt(startCoords2.lat, startCoords2.lon, endCoords2.lat, endCoords2.lon, circuitStops);

            circuitStops = optimized;
            circuitOptimized = true;
            renderCircuitStops();

            const totalGuias = circuitStops.reduce((a, s) => a + s.guias.length, 0);
            showToast(`Circuito organizado: ${optimized.length} paradas (${totalGuias} guías) desde ${startCoords2.label} hasta ${endCoords2.label}.`, 'success');
          } catch (err) {
            console.error('Error optimizando circuito:', err);
            showToast('Error al optimizar el circuito.', 'error');
          } finally {
            if (btn) {
              btn.textContent = 'Optimizar Circuito';
              (btn as HTMLButtonElement).disabled = false;
            }
          }
        }, 50);
      };

      // Función: mostrar/ocultar mapa del circuito
      window.togglePlannerRouteMap = function() {
        if (!plannerRouteMapWrapper) return;
        plannerMapVisible = !plannerMapVisible;

        if (plannerMapVisible) {
          plannerRouteMapWrapper.classList.remove('hidden');
          if (btnToggleMapText) btnToggleMapText.textContent = 'Ocultar Mapa';
          setTimeout(() => renderCircuitMap(), 100);
        } else {
          plannerRouteMapWrapper.classList.add('hidden');
          if (btnToggleMapText) btnToggleMapText.textContent = 'Ver Mapa';
        }
      };

      // Función: renderizar el mapa Leaflet del circuito con trazado OSRM real
      function renderCircuitMap() {
        if (!(window as any).L) return;
        const L = (window as any).L;
        const mapContainer = document.getElementById('planner-full-route-map');
        if (!mapContainer) return;

        if (plannerMapInstance) {
          try { plannerMapInstance.remove(); } catch (_) {}
          plannerMapInstance = null;
        }
        mapContainer.innerHTML = '';

        const startCoords2 = getStartCoordinates();
        const endCoords2 = getEndCoordinates();
        const centerLat = circuitStops.length > 0 ? circuitStops[0].lat : startCoords2.lat;
        const centerLon = circuitStops.length > 0 ? circuitStops[0].lon : startCoords2.lon;

        plannerMapInstance = L.map(mapContainer, { zoomControl: true, attributionControl: false }).setView([centerLat, centerLon], 13);

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '© OpenStreetMap'
        }).addTo(plannerMapInstance);

        const allPoints: [number, number][] = [];

        // Marcador de inicio
        const startIcon = L.divIcon({
          html: `<div style="width:28px;height:28px;border-radius:10px;background:#4338ca;border:2.5px solid white;box-shadow:0 3px 8px rgba(67,56,202,0.4);display:flex;align-items:center;justify-content:center;color:white">
                   <svg style="width:15px;height:15px;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                 </div>`,
          className: '', iconSize: [28, 28], iconAnchor: [14, 14]
        });
        L.marker([startCoords2.lat, startCoords2.lon], { icon: startIcon })
          .addTo(plannerMapInstance)
          .bindPopup(`<b>Inicio de Ruta</b><br>${startCoords2.label}`);
        allPoints.push([startCoords2.lat, startCoords2.lon]);

        // Marcadores de paradas
        circuitStops.forEach((stop, idx) => {
          const lat = stop.lat;
          const lon = stop.lon;
          allPoints.push([lat, lon]);

          const stopIcon = L.divIcon({
            html: `<div style="width:26px;height:26px;border-radius:50%;background:#0f172a;border:2.5px solid white;box-shadow:0 2px 6px rgba(0,0,0,0.3);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;color:white">${idx + 1}</div>`,
            className: '', iconSize: [26, 26], iconAnchor: [13, 13]
          });

          const guiasDescr = stop.guias.length > 1
            ? `<span style="color:#4f46e5;font-weight:bold">${stop.guias.length} Guías:</span> ${stop.guias.map(g => '#' + g.id_guia).join(', ')}`
            : `Guía #${stop.guias[0]?.id_guia || ''}`;

          L.marker([lat, lon], { icon: stopIcon })
            .addTo(plannerMapInstance)
            .bindPopup(`<b>Parada ${idx + 1}: ${stop.destinatario || ''}</b><br>${guiasDescr}<br>Total: ${stop.totalPiezas} piezas`);
        });

        // Marcador de Fin de ruta
        if (circuitStops.length > 0) {
          const endIcon = L.divIcon({
            html: `<div style="width:28px;height:28px;border-radius:10px;background:#059669;border:2.5px solid white;box-shadow:0 3px 8px rgba(5,150,105,0.4);display:flex;align-items:center;justify-content:center;color:white">
                     <svg style="width:15px;height:15px;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/></svg>
                   </div>`,
            className: '', iconSize: [28, 28], iconAnchor: [14, 14]
          });
          L.marker([endCoords2.lat, endCoords2.lon], { icon: endIcon })
            .addTo(plannerMapInstance)
            .bindPopup(`<b>Fin de Ruta</b><br>${endCoords2.label}`);
          allPoints.push([endCoords2.lat, endCoords2.lon]);
        }

        if (allPoints.length > 1) {
          const directPoly = L.polyline(allPoints, { color: '#6366f1', weight: 3.5, opacity: 0.9 }).addTo(plannerMapInstance);
          plannerMapInstance.fitBounds(allPoints, { padding: [30, 30] });

          // Consulta OSRM para carretera real
          const pointsReq = allPoints.slice(0, 25);
          const url = 'https://router.project-osrm.org/route/v1/driving/' +
            pointsReq.map(p => p[1].toFixed(5) + ',' + p[0].toFixed(5)).join(';') +
            '?overview=full&geometries=geojson';

          fetch(url)
            .then(res => res.json())
            .then(data => {
              if (data.code === 'Ok' && data.routes && data.routes[0] && data.routes[0].geometry) {
                const roadCoords: [number, number][] = data.routes[0].geometry.coordinates.map((c: number[]) => [c[1], c[0]]);
                plannerMapInstance.removeLayer(directPoly);

                L.polyline(roadCoords, { color: '#312e81', weight: 6, opacity: 0.35, lineCap: 'round' }).addTo(plannerMapInstance);
                L.polyline(roadCoords, { color: '#4f46e5', weight: 3.5, opacity: 0.95, lineCap: 'round' }).addTo(plannerMapInstance);
              }
            })
            .catch(() => {});
        }
      }

      // Autocomplete dinámico para Inicio y Fin
      function setupLocationAutocomplete(
        inputEl: HTMLInputElement | null,
        dropdownId: string,
        onSelect: (item: { label: string, lat: number, lon: number, desc?: string }) => void
      ) {
        if (!inputEl) return;
        const dropdown = document.getElementById(dropdownId);
        if (!dropdown) return;

        inputEl.addEventListener('input', () => {
          const val = inputEl.value.trim();
          if (val.length < 1) {
            dropdown.classList.add('hidden');
            return;
          }

          const parsed = parseUniversalLocation(val);
          const norm = normalizeText(val);

          const matches: { label: string, lat: number, lon: number, desc?: string }[] = [];

          // 1. Si es coordenada directa o Plus Code decodificado
          if (parsed) {
            matches.push({
              label: parsed.label,
              lat: parsed.lat,
              lon: parsed.lon,
              desc: `Coordenadas: ${parsed.lat.toFixed(4)}, ${parsed.lon.toFixed(4)}`
            });
          }

          // 2. Coincidencias en catálogo de ciudades
          POPULAR_LOCATIONS.forEach(loc => {
            if (normalizeText(loc.label).includes(norm) || (loc.desc && normalizeText(loc.desc).includes(norm))) {
              if (!matches.some(m => m.label === loc.label)) {
                matches.push(loc);
              }
            }
          });

          // 3. Fallback de ciudades del diccionario
          Object.entries(VENEZUELA_COORDS_MAP).forEach(([cityName, coords]) => {
            if (cityName.includes(norm) && !matches.some(m => m.label.toLowerCase() === cityName)) {
              matches.push({
                label: cityName.charAt(0).toUpperCase() + cityName.slice(1),
                lat: coords[0],
                lon: coords[1],
                desc: 'Venezuela'
              });
            }
          });

          if (matches.length === 0) {
            dropdown.classList.add('hidden');
            return;
          }

          dropdown.innerHTML = matches.slice(0, 6).map(m => `
            <button
              type="button"
              class="w-full text-left p-2.5 hover:bg-indigo-50/80 rounded-xl transition-colors flex items-center gap-3 cursor-pointer group"
              data-label="${m.label}"
              data-lat="${m.lat}"
              data-lon="${m.lon}"
              data-desc="${m.desc || ''}"
            >
              <div class="w-7 h-7 rounded-lg bg-slate-100 group-hover:bg-indigo-100 text-slate-600 group-hover:text-indigo-700 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-xs font-bold text-slate-900 group-hover:text-indigo-900 truncate">${m.label}</p>
                <p class="text-[10px] text-slate-500 truncate font-mono">${m.desc || `${m.lat.toFixed(4)}, ${m.lon.toFixed(4)}`}</p>
              </div>
            </button>
          `).join('');

          dropdown.querySelectorAll('button').forEach(btn => {
            btn.addEventListener('click', () => {
              const label = btn.getAttribute('data-label') || '';
              const lat = parseFloat(btn.getAttribute('data-lat') || '0');
              const lon = parseFloat(btn.getAttribute('data-lon') || '0');
              const desc = btn.getAttribute('data-desc') || '';
              onSelect({ label, lat, lon, desc });
              dropdown.classList.add('hidden');
            });
          });

          dropdown.classList.remove('hidden');
        });

        document.addEventListener('click', (e) => {
          if (!inputEl.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
            dropdown.classList.add('hidden');
          }
        });
      }

      setupLocationAutocomplete(plannerStartInput, 'start-autocomplete-dropdown', (item) => {
        if (plannerStartInput) plannerStartInput.value = item.label;
        updateStartSublabel();
        actualizarCircuitoDesdeZonas();
      });

      setupLocationAutocomplete(plannerEndInput, 'end-autocomplete-dropdown', (item) => {
        if (plannerEndInput) plannerEndInput.value = item.label;
        updateEndSublabel();
        actualizarCircuitoDesdeZonas();
      });

      if (plannerStartInput) {
        plannerStartInput.addEventListener('change', () => {
          updateStartSublabel();
          actualizarCircuitoDesdeZonas();
        });
      }

      if (plannerEndInput) {
        plannerEndInput.addEventListener('change', () => {
          updateEndSublabel();
          actualizarCircuitoDesdeZonas();
        });
      }

      if (plannerRestSelect) {
        plannerRestSelect.addEventListener('change', () => {
          if (circuitStops.length > 0) renderCircuitStops();
        });
      }

      // Función: guardar el circuito planificado en la BD
      window.savePlannedRoute = async function(dispatchToRoute: boolean) {
        if (circuitStops.length === 0) {
          showToast('No hay paradas en el circuito. Selecciona una zona primero.', 'error');
          return;
        }

        let driverId = plannerDriverSelect?.value;
        if (!driverId && circuitStops.length > 0) {
          const allGuias = circuitStops.flatMap(s => s.guias);
          const firstWithDriver = allGuias.find(g => g.chofer_asignado_id != null);
          if (firstWithDriver && firstWithDriver.chofer_asignado_id) {
            driverId = String(firstWithDriver.chofer_asignado_id);
            if (plannerDriverSelect) plannerDriverSelect.value = driverId;
          }
        }
        if (!driverId) {
          showToast('Selecciona un chofer para el circuito.', 'error');
          return;
        }

        const zona = [...selectedZones].join(' + ');
        if (!zona) {
          showToast('Selecciona al menos una zona para el circuito.', 'error');
          return;
        }

        // Guardar como predeterminado si está marcado
        if (circuitSaveDefaultCheckbox && circuitSaveDefaultCheckbox.checked) {
          try {
            localStorage.setItem('envias_route_defaults', JSON.stringify({
              start: plannerStartInput?.value || '',
              end: plannerEndInput?.value || '',
              rest: plannerRestSelect?.value || '30',
              serviceTime: plannerServiceTimeSelect?.value || '8'
            }));
          } catch (_) {}
        }

        const btn = document.getElementById(dispatchToRoute ? 'planner-save-btn' : 'planner-save-almacen-btn');
        const origHtml = btn?.innerHTML || '';
        if (btn) {
          btn.innerHTML = '<span class="opacity-60">Guardando...</span>';
          (btn as HTMLButtonElement).disabled = true;
        }

        try {
          // Desglosar guías agrupadas asignando el mismo orden secuencial a cada grupo
          const paradasPayload = circuitStops.flatMap((grp, idx) => 
            grp.guias.map(g => ({
              id_guia: g.id_guia,
              orden: idx + 1
            }))
          );

          const res = await fetch('/api/guias/ruta', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              chofer_id: parseInt(driverId, 10),
              ruta_origen: getStartCoordinates().label,
              ruta_destino: zona,
              despachar_en_ruta: dispatchToRoute,
              paradas: paradasPayload
            })
          });

          const data = await res.json();

          if (data.success) {
            const action = dispatchToRoute ? 'despachado a ruta' : 'guardado en almacén';
            const totalGuias = paradasPayload.length;
            showToast(`Circuito de ${circuitStops.length} paradas (${totalGuias} guías) ${action} exitosamente.`, 'success');
            closeRoutePlannerModal();
            await fetchData();
          } else {
            showToast(data.message || 'Error al guardar el circuito.', 'error');
          }

        } catch (err) {
          console.error('Error guardando circuito:', err);
          showToast('Error al guardar el circuito. Intenta nuevamente.', 'error');
        } finally {
          if (btn) {
            btn.innerHTML = origHtml;
            (btn as HTMLButtonElement).disabled = false;
          }
        }
      };

      // Función: cerrar modal del planificador
      function closeRoutePlannerModal() {
        if (!routePlannerModal) return;
        routePlannerModal.classList.add('hidden');
        routePlannerModal.classList.remove('flex');
        circuitStops = [];
        if (plannerMapInstance) {
          try { plannerMapInstance.remove(); } catch (_) {}
          plannerMapInstance = null;
        }
        plannerMapVisible = false;
      }

      // Event listeners del planificador
      if (plannerCloseBtn) plannerCloseBtn.addEventListener('click', closeRoutePlannerModal);
      if (plannerCancelBtn) plannerCancelBtn.addEventListener('click', closeRoutePlannerModal);
      if (routePlannerModal) {
        routePlannerModal.addEventListener('click', (e) => {
          if (e.target === routePlannerModal) closeRoutePlannerModal();
        });
      }

      // Recalcular ETAs cuando cambian hora de inicio o tiempo de servicio
      if (plannerStartTimeInput) plannerStartTimeInput.addEventListener('change', () => { if (circuitStops.length > 0) renderCircuitStops(); });
      if (plannerServiceTimeSelect) plannerServiceTimeSelect.addEventListener('change', () => { if (circuitStops.length > 0) renderCircuitStops(); });

      // Escuchar cambios en selector de chofer para sincronizar zonas y badge
      if (plannerDriverSelect) {
        plannerDriverSelect.addEventListener('change', () => {
          const selectedDriverId = plannerDriverSelect.value ? parseInt(plannerDriverSelect.value, 10) : null;
          const driverBadge = document.getElementById('planner-driver-auto-badge');
          if (driverBadge) {
            if (selectedDriverId) {
              const drv = drivers.find(d => d.id === selectedDriverId);
              driverBadge.textContent = drv ? `Seleccionado (${drv.nombre})` : 'Seleccionado';
              driverBadge.classList.remove('hidden');
            } else {
              driverBadge.classList.add('hidden');
            }
          }

          // Si no había zonas seleccionadas y se eligió un chofer, auto-seleccionar sus zonas activas
          if (selectedDriverId && selectedZones.size === 0) {
            const driverShipments = shipments.filter(g =>
              g.chofer_asignado_id === selectedDriverId &&
              g.estado !== 'Entregado' && g.estado !== 'No entregado'
            );
            const driverZones = [...new Set(driverShipments.map(g => (g.ciudad_destino || '').trim()).filter(Boolean))];
            if (driverZones.length > 0) {
              driverZones.forEach(z => selectedZones.add(z));
              renderZoneChips();
              actualizarCircuitoDesdeZonas();
            }
          } else {
            renderZoneChips();
          }
        });
      }

      // ============================================================
      // FIN MOTOR PLANIFICADOR DE CIRCUITO
      // ============================================================

      init();

    </script>
  </body>
</html>
