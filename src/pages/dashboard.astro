      (window as any).updateHistorialGuiaStatus = async function(routeId: number, guiaId: string, newStatus: string) {
        try {
          // Actualización optimista inmediata en memoria
          const route = filteredHistorialRoutes.find((r: any) => r.id === routeId) || historialRoutes.find((r: any) => r.id === routeId);
          if (route && Array.isArray(route.guias_snapshot)) {
            route.guias_snapshot = route.guias_snapshot.map((g: any) => {
              if (String(g.id_guia) === String(guiaId)) {
                return { ...g, estado: newStatus };
              }
              return g;
            });
            const total = route.guias_snapshot.length;
            route.total_entregadas = route.guias_snapshot.filter((g: any) => g.estado === 'Entregado').length;
            route.total_no_entregadas = route.guias_snapshot.filter((g: any) => g.estado === 'No entregado').length;
            route.total_pendientes = route.guias_snapshot.filter((g: any) => g.estado !== 'Entregado' && g.estado !== 'No entregado').length;
            route.porcentaje_efectividad = total > 0 ? Math.round((route.total_entregadas / total) * 100) : 0;
            renderHistorialView();
          }

          // Enviar actualización a PostgreSQL
          const res = await fetch('/api/rutas/estado', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ruta_id: routeId, id_guia: guiaId, estado: newStatus })
          });

          const json = await res.json();
          if (json.success && json.data) {
            const idx = historialRoutes.findIndex((r: any) => r.id === routeId);
            if (idx !== -1) historialRoutes[idx] = json.data;
            const fIdx = filteredHistorialRoutes.findIndex((r: any) => r.id === routeId);
            if (fIdx !== -1) filteredHistorialRoutes[fIdx] = json.data;

            // Actualizar si está en shipments principales
            const ship = shipments.find(s => String(s.id_guia) === String(guiaId));
            if (ship) {
              ship.estado = newStatus as any;
            }

            renderHistorialView();
            showToast(`Guía #${guiaId} actualizada a "${newStatus}"`, 'success');
          } else {
            showToast(json.message || 'Error al actualizar estado', 'error');
            window.loadHistorialData();
          }
        } catch (err) {
          console.error('Error actualizando estado en historial:', err);
          showToast('Error de red al actualizar estado', 'error');
          window.loadHistorialData();
        }
      };

      function renderHistorialView() {
        if (!historialRoutesList || !historialEmpty) return;

        if (filteredHistorialRoutes.length === 0) {
          historialRoutesList.innerHTML = '';
          historialEmpty.classList.remove('hidden');
          return;
        }

        historialEmpty.classList.add('hidden');

        // Auto-seleccionar la primera ruta si no hay ninguna activa o si la actual fue filtrada
        if (!selectedHistorialRouteId || !filteredHistorialRoutes.some((r: any) => r.id === selectedHistorialRouteId)) {
          selectedHistorialRouteId = filteredHistorialRoutes[0].id;
        }

        // Agrupar rutas en orden cronológico (Hoy -> Ayer -> A comienzos de esta semana -> A comienzos de este mes -> ...)
        const groups: Record<string, any[]> = {};
        const groupOrder: string[] = [];

        filteredHistorialRoutes.forEach((r: any) => {
          const category = getRouteDateCategory(r.fecha_finalizacion);
          if (!groups[category]) {
            groups[category] = [];
            groupOrder.push(category);
          }
          groups[category].push(r);
        });

        // Buscar ruta seleccionada
        const selectedRoute = filteredHistorialRoutes.find((r: any) => r.id === selectedHistorialRouteId) || filteredHistorialRoutes[0];
        const selectedGuias: any[] = (selectedRoute && Array.isArray(selectedRoute.guias_snapshot)) ? selectedRoute.guias_snapshot : [];

        // Filtrar guías dentro de la ruta seleccionada si hay búsqueda interna
        const detailQ = (historialDetailSearchQuery || '').toLowerCase().trim();
        const filteredDetailGuias = detailQ
          ? selectedGuias.filter((g: any) => 
              (g.id_guia || '').toLowerCase().includes(detailQ) ||
              (g.destinatario || '').toLowerCase().includes(detailQ) ||
              (g.ciudad_destino || '').toLowerCase().includes(detailQ) ||
