        <div class="px-4 sm:px-5 py-3 border-b border-slate-800 flex flex-wrap items-center justify-between gap-2 shrink-0 bg-slate-900/90">
          <div class="min-w-0 pr-2">
            <h4 id="lightbox-title" class="text-sm font-bold text-white truncate">Visualizador de Guía / Comprobante</h4>
            <p id="lightbox-info" class="text-[11px] text-slate-400 truncate"></p>
          </div>

          <!-- Barra de Herramientas de Zoom e Inspección -->
          <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
            <div class="flex items-center bg-slate-800 rounded-xl p-1 border border-slate-700">
              <!-- Zoom Out -->
              <button
                id="lightbox-zoom-out"
                type="button"
                class="p-1.5 rounded-lg hover:bg-slate-700 text-slate-300 hover:text-white transition-colors cursor-pointer"
                title="Alejar (Zoom -)"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                </svg>
              </button>

              <!-- Indicador de Zoom / Reset a 100% -->
              <button
                id="lightbox-zoom-reset"
                type="button"
                class="px-2 py-0.5 text-xs font-mono font-bold text-indigo-300 hover:text-white transition-colors cursor-pointer"
                title="Restablecer al 100%"
              >
                <span id="lightbox-zoom-level">100%</span>
              </button>

              <!-- Zoom In -->
              <button
                id="lightbox-zoom-in"
                type="button"
                class="p-1.5 rounded-lg hover:bg-slate-700 text-slate-300 hover:text-white transition-colors cursor-pointer"
                title="Acercar (Zoom +)"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
              </button>

              <div class="h-4 w-px bg-slate-700 mx-1"></div>

              <!-- Rotar 90° -->
              <button
                id="lightbox-rotate"
                type="button"
                class="p-1.5 rounded-lg hover:bg-slate-700 text-slate-300 hover:text-white transition-colors cursor-pointer"
                title="Rotar imagen 90°"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
              </button>
            </div>

            <!-- Abrir Original -->
            <a
              id="lightbox-external-link"
              href="#"
              target="_blank"
              class="px-2.5 sm:px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold flex items-center gap-1.5 transition-colors"
              title="Abrir imagen original en pestaña nueva"
            >
              <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              <span class="hidden md:inline">Original</span>
            </a>

            <!-- Botón Eliminar Foto de la Guía / Escaneo -->
            <button
              id="lightbox-delete-btn"
              type="button"
              class="px-2.5 sm:px-3 py-1.5 rounded-xl bg-rose-500/20 hover:bg-rose-600 text-rose-300 hover:text-white text-xs font-semibold flex items-center gap-1.5 transition-all border border-rose-500/30 cursor-pointer shadow-xs"
              title="Eliminar foto permanentemente"
            >
              <svg class="w-3.5 h-3.5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
              <span class="hidden sm:inline">Eliminar Foto</span>
              <span class="sm:hidden">Borrar</span>
            </button>

            <!-- Cerrar -->
            <button
              id="lightbox-close-btn"
              type="button"
              class="p-2 rounded-xl bg-slate-800 hover:bg-rose-500/20 hover:text-rose-400 text-slate-400 transition-colors cursor-pointer"
              title="Cerrar visor (Esc)"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Área de Inspección / Imagen con Zoom y Arrastre Pan -->
        <div
          id="lightbox-viewport"
          class="flex-1 overflow-hidden relative flex items-center justify-center bg-black/70 cursor-grab active:cursor-grabbing group"
          title="Usa la rueda del ratón para hacer zoom o arrastra para mover"
        >
          <img
            id="lightbox-img"
            src=""
            alt="Comprobante / Guía"
            class="max-w-full max-h-[82vh] object-contain rounded-xl shadow-2xl pointer-events-none select-none transition-transform duration-75"
            style="transform-origin: center center;"
          />

          <!-- Botones de Navegación Multi-Foto -->
          <button
            id="lightbox-prev-btn"
            type="button"
            class="hidden absolute left-4 top-1/2 -translate-y-1/2 p-3 rounded-full bg-slate-900/80 hover:bg-slate-900 text-white border border-slate-700 shadow-2xl transition-all cursor-pointer z-20 active:scale-95"
            title="Foto anterior"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button
            id="lightbox-next-btn"
            type="button"
            class="hidden absolute right-4 top-1/2 -translate-y-1/2 p-3 rounded-full bg-slate-900/80 hover:bg-slate-900 text-white border border-slate-700 shadow-2xl transition-all cursor-pointer z-20 active:scale-95"
            title="Foto siguiente"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
          </button>

          <!-- Guía flotante en esquina -->
          <div class="absolute bottom-3 left-3 bg-slate-900/80 backdrop-blur-xs text-[10px] text-slate-400 font-medium px-2.5 py-1 rounded-lg border border-slate-800 pointer-events-none flex items-center gap-1.5">
            <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/></svg>
            <span>Rueda del ratón para zoom &bull; Arrastra para mover</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- MODAL PARA EDITAR GUÍA COMPLETA           -->
    <!-- ========================================== -->
    <div
      id="edit-guia-modal"
      class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 hidden"
    >
      <div class="bg-white rounded-3xl shadow-2xl border border-slate-200/90 w-full max-w-2xl max-h-[90vh] flex flex-col overflow-hidden animate-fadeIn">
        
        <!-- Header del Modal -->
        <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/70">
          <div class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h3 class="text-sm font-bold text-slate-900">Editar Guía</h3>
                <span id="edit-guia-badge" class="font-mono text-xs font-extrabold px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700 border border-indigo-200">#---</span>
              </div>
              <p class="text-[11px] text-slate-400 font-medium">Modifica los datos del destinatario, destino, courier o estado</p>
            </div>
          </div>

          <button
            type="button"
            id="edit-guia-close-btn"
            class="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 rounded-xl transition-colors cursor-pointer"
            title="Cerrar ventana"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Formulario del Modal -->
        <form id="edit-guia-form" class="flex-1 overflow-y-auto p-5 sm:p-6 space-y-4 custom-scrollbar">
          <input type="hidden" id="edit-id-guia" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            
            <!-- Destinatario -->
            <div class="sm:col-span-2 space-y-1">
              <label for="edit-destinatario" class="block text-xs font-bold text-slate-700">
                Destinatario <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="edit-destinatario"
                required
                placeholder="Nombre y Apellido completo"
                class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all font-medium"
              />
            </div>

            <!-- Teléfono Principal -->
            <div class="space-y-1">
              <label for="edit-telefono-principal" class="block text-xs font-bold text-slate-700">
                Teléfono Principal (WhatsApp) <span class="text-rose-500">*</span>
              </label>
              <input
                type="tel"
                id="edit-telefono-principal"
                required
                placeholder="Ej: 04141234567"
                class="w-full text-xs font-mono bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
              />
            </div>

            <!-- Teléfono Secundario -->
            <div class="space-y-1">
              <label for="edit-telefono-secundario" class="block text-xs font-bold text-slate-700">
                Teléfono Alternativo <span class="text-slate-400 font-normal">(Opcional)</span>
              </label>
              <input
                type="tel"
                id="edit-telefono-secundario"
                placeholder="Ej: 04129876543"
                class="w-full text-xs font-mono bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
              />
            </div>

            <!-- Ciudad Destino -->
            <div class="space-y-1">
              <label for="edit-ciudad" class="block text-xs font-bold text-slate-700">
                Ciudad Destino <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="edit-ciudad"
                required
                placeholder="Ej: Mérida, Barquisimeto..."
                class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all font-medium"
              />
            </div>

            <!-- Piezas -->
            <div class="space-y-1">
              <label for="edit-piezas" class="block text-xs font-bold text-slate-700">
                Cantidad de Piezas <span class="text-rose-500">*</span>
              </label>
              <input
                type="number"
                id="edit-piezas"
                required
                min="1"
                class="w-full text-xs font-bold bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
              />
            </div>

            <!-- Pies Cúbicos -->
            <div class="space-y-1">
              <label for="edit-pies-cubicos" class="block text-xs font-bold text-slate-700">
                Pies Cúbicos <span class="text-slate-400 font-normal">(ft³)</span>
              </label>
              <input
                type="number"
                id="edit-pies-cubicos"
                step="0.01"
                min="0"
                placeholder="Ej: 12.5"
                class="w-full text-xs font-bold bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
              />
            </div>

            <!-- Empresa / Courier Aliado -->
            <div class="space-y-1">
              <label for="edit-empresa" class="block text-xs font-bold text-slate-700">
                Empresa / Courier Aliado
              </label>
              <select
                id="edit-empresa"
                class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all cursor-pointer font-medium"
              >
                <option value="">Sin Empresa / Directo</option>
                <option value="Troop">Troop</option>
                <option value="Crazy cargo">Crazy cargo</option>
                <option value="Cargo King">Cargo King</option>
                <option value="JJ">JJ</option>
                <option value="Greymar">Greymar</option>
                <option value="Ajbp">Ajbp</option>
                <option value="Global jats">Global jats</option>
                <option value="Su descarga">Su descarga</option>
                <option value="Rima cargo">Rima cargo</option>
                <option value="Dina cargo">Dina cargo</option>
                <option value="Send logístics">Send logístics</option>
                <option value="Alas cargo">Alas cargo</option>
                <option value="Aexpress">Aexpress</option>
                <option value="Priority">Priority</option>
                <option value="Alpi">Alpi</option>
                <option value="Venexcargo">Venexcargo</option>
                <option value="DBL">DBL</option>
                <option value="2BC">2BC</option>
              </select>
            </div>

            <!-- Estado del Envío -->
            <div class="space-y-1">
              <label for="edit-estado" class="block text-xs font-bold text-slate-700">
                Estado del Envío <span class="text-rose-500">*</span>
              </label>
              <select
                id="edit-estado"
                required
                class="w-full text-xs font-bold bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all cursor-pointer"
              >
                <option value="Por contactar">Por contactar</option>
                <option value="Contactado">Contactado</option>
                <option value="En ruta">En ruta</option>
                <option value="Entregado">Entregado</option>
                <option value="No entregado">No entregado / Incidencia</option>
              </select>
            </div>

            <!-- Chofer Asignado -->
            <div class="space-y-1">
              <label for="edit-chofer" class="block text-xs font-bold text-slate-700">
                Chofer Asignado
              </label>
              <select
                id="edit-chofer"
                class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all cursor-pointer font-medium"
              >
                <option value="">Sin Asignar</option>
              </select>
            </div>

            <!-- Lote de Despacho / Manifiesto -->
            <div class="space-y-1">
              <label for="edit-lote" class="block text-xs font-bold text-slate-700">
                Lote de Despacho / Manifiesto
              </label>
              <input
                type="text"
                id="edit-lote"
                placeholder="Ej: REL-2026-W35-BRM"
                class="w-full text-xs font-mono font-bold uppercase bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
              />
            </div>

            <!-- Fecha de Despacho / Carga -->
            <div class="space-y-1">
              <label for="edit-fecha" class="block text-xs font-bold text-slate-700">
                Fecha de Registro / Despacho
              </label>
              <input
                type="date"
                id="edit-fecha"
                class="w-full text-xs font-semibold bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all cursor-pointer"
              />
            </div>

            <!-- Horario Disponible -->
            <div class="space-y-1">
              <label for="edit-hora" class="block text-xs font-bold text-slate-700">
                Horario Disponible <span class="text-slate-400 font-normal">(Ej: 04:00 PM)</span>
              </label>
              <input
                type="text"
                id="edit-hora"
                placeholder="Ej: Hasta las 4:00 PM"
                class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
              />
            </div>

            <!-- Dirección / Referencias -->
            <div class="sm:col-span-2 space-y-1">
              <label for="edit-direccion" class="block text-xs font-bold text-slate-700">
                Dirección / Puntos de Referencia
              </label>
              <textarea
                id="edit-direccion"
                rows="2"
                placeholder="Ej: Av. Las Américas, Edif. Los Andes, frente a la panadería"
                class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all resize-none"
              ></textarea>
            </div>

            <!-- Coordenadas GPS -->
            <div class="space-y-1">
              <label for="edit-gps-lat" class="block text-xs font-bold text-slate-700">
                Latitud GPS <span class="text-slate-400 font-normal">(Opcional)</span>
              </label>
              <input
                type="number"
                step="any"
                id="edit-gps-lat"
                placeholder="Ej: 10.0808"
                class="w-full text-xs font-mono bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
              />
            </div>

            <div class="space-y-1">
              <label for="edit-gps-lon" class="block text-xs font-bold text-slate-700">
                Longitud GPS <span class="text-slate-400 font-normal">(Opcional)</span>
              </label>
              <input
                type="number"
                step="any"
                id="edit-gps-lon"
                placeholder="Ej: -69.3756"
                class="w-full text-xs font-mono bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
              />
            </div>

            <!-- Switch GPS Confirmado & Recibido por -->
            <div class="sm:col-span-2 flex items-center justify-between p-3 bg-slate-50 rounded-2xl border border-slate-200/80">
              <label class="flex items-center gap-2.5 cursor-pointer select-none">
                <input
                  type="checkbox"
                  id="edit-gps-confirmado"
                  class="w-4 h-4 text-indigo-600 rounded focus:ring-indigo-500 border-slate-300"
                />
                <span class="text-xs font-bold text-slate-800">Ubicación GPS Confirmada por Cliente</span>
              </label>
            </div>

          </div>

          <!-- Footer del Modal -->
          <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-2.5">
            <button
              type="button"
              id="edit-guia-cancel-btn"
              class="px-4 py-2.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all cursor-pointer"
            >
              Cancelar
            </button>
            <button
              type="submit"
              id="edit-guia-save-btn"
              class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-bold transition-all shadow-md flex items-center gap-2 cursor-pointer active:scale-95"
            >
              <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              <span>Guardar Cambios</span>
            </button>
          </div>

        </form>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- MODAL GESTIÓN MANUAL DE LOTES Y RELACIONES DE DESPACHO      -->
    <!-- ============================================================ -->
    <div
      id="modal-gestion-lotes"
      class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-3 sm:p-5"
    >
      <div class="bg-white rounded-3xl shadow-2xl border border-slate-200/90 w-full max-w-3xl max-h-[92vh] flex flex-col overflow-hidden animate-fadeIn">
        
        <!-- Header del Modal -->
        <div class="px-5 py-4 sm:px-6 sm:py-5 border-b border-slate-100 bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-950 text-white flex items-center justify-between gap-4">
          <div class="flex items-center gap-3 min-w-0">
