                                  commonStatus === 'Por contactar' ? 'bg-amber-50 text-amber-700 border-amber-200' :
                                  commonStatus === 'Contactado' ? 'bg-sky-50 text-sky-700 border-sky-200' :
                                  commonStatus === 'En ruta' ? 'bg-indigo-50 text-indigo-700 border-indigo-200' :
                                  commonStatus === 'Entregado' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
                                  'bg-rose-50 text-rose-700 border-rose-200'
