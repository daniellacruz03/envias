---
import '../styles/global.css';
import { getUserFromCookies } from '../lib/auth';

// Protección de Ruta: Validar sesión activa en SSR
const currentUser = getUserFromCookies(Astro.cookies);
if (!currentUser) {
  return Astro.redirect('/login');
}

// Si el usuario es Chofer, redirigir a su portal correspondiente
if (currentUser.rol === 'Chofer') {
  return Astro.redirect('/chofer');
}

// Encabezados anti-caché para impedir que al pulsar "Atrás" se vea la sesión cerrada
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

const title = "Envías | Logística Central - Panel Operativo";

// Iniciales del usuario para el avatar
const userInitials = currentUser.nombre
  ? currentUser.nombre.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase()
  : 'US';
---

<!doctype html>
<html lang="es" class="h-full bg-slate-50/50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Leaflet CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>
    


    
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
      /* Custom scrollbar para la tabla */
      .custom-scrollbar::-webkit-scrollbar {
        height: 6px;
      }
      .custom-scrollbar::-webkit-scrollbar-track {
        background: #f8fafc;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 9999px;
      }
      .tab-btn-active {
        background-color: #0f172a !important;
        color: #ffffff !important;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.15);
      }

      /* Estilos de Impresión Oficial (@media print) */
      @media print {
        @page {
          size: letter portrait;
          margin: 4mm 5mm 4mm 5mm;
        }
        html, body {
          background: #ffffff !important;
          color: #000000 !important;
          margin: 0 !important;
          padding: 0 !important;
          width: 100% !important;
        }
        body * {
          visibility: hidden !important;
        }
        #listin-print-wrapper, #listin-print-wrapper * {
          visibility: visible !important;
        }
        #listin-print-wrapper {
          position: absolute !important;
          left: 0 !important;
          top: 0 !important;
          width: 100% !important;
          max-width: 100% !important;
          min-height: auto !important;
          margin: 0 !important;
          padding: 2mm 3mm !important;
          background: #ffffff !important;
          box-shadow: none !important;
          border: none !important;
          border-radius: 0 !important;
          color: #000000 !important;
          z-index: 9999999 !important;
        }
      }

      /* ============================================ */
      /* ADAPTACIÓN MÓVIL DEL PANEL DE LOGÍSTICA      */
      /* Solo activo en pantallas < 768px (< md)      */
      /* ============================================ */
      @media (max-width: 767px) {

        /* --- HEADER --- */
        header { padding-left: 1rem !important; padding-right: 1rem !important; }
        header p { display: none; }

        /* --- MAIN CONTENT --- */
        main { padding: 0.75rem !important; gap: 0.75rem !important; }
        main > * + * { margin-top: 0.75rem; }

        /* --- KPIs: 2x2 compactos --- */
        section.grid { gap: 0.5rem !important; }

        /* --- FORMULARIO DE CARGA RÁPIDA --- */
        section form.grid { gap: 0.75rem !important; }

        /* --- BARRA DE LOTES DARK: scroll horizontal, sin wrap --- */
        .lotes-control-bar {
          overflow-x: auto !important;
          flex-wrap: nowrap !important;
          -webkit-overflow-scrolling: touch;
          padding-bottom: 2px;
          scrollbar-width: none;
        }
        .lotes-control-bar::-webkit-scrollbar { display: none; }

        /* Banner de lote activo: wrap y compacto */
        #banner-active-lote > div {
          flex-direction: column !important;
          gap: 0.5rem !important;
        }
        #banner-active-lote .flex.items-center.gap-2\.5 {
          flex-wrap: wrap !important;
          gap: 0.375rem !important;
        }
        #banner-active-lote span.font-mono { font-size: 0.65rem !important; }

        /* --- BARRA DARK DE RELACIÓN DE DESPACHO --- */
        .despacho-bar {
          flex-direction: column !important;
          gap: 0.75rem !important;
          padding: 0.75rem !important;
        }
        .despacho-bar .lotes-pill-row {
          overflow-x: auto;
          flex-wrap: nowrap !important;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
          padding-bottom: 2px;
          width: 100%;
        }
        .despacho-bar .lotes-pill-row::-webkit-scrollbar { display: none; }
        /* Ocultar texto en píldoras de filtro rápido en la dark bar */
        .despacho-bar .lotes-pill-row button span:not(.badge-pill) { font-size: 0.65rem !important; }
        /* Select y botón archivar: full width en móvil */
        .despacho-bar-actions {
          flex-direction: column !important;
          width: 100% !important;
        }
        .despacho-bar-actions select,
        .despacho-bar-actions button { width: 100% !important; max-width: 100% !important; }

        /* --- TÍTULO + BOTÓN PLANIFICAR RUTA --- */
        .title-planner-row {
          flex-direction: row !important;
          flex-wrap: wrap !important;
          gap: 0.5rem !important;
        }
        .title-planner-row button span { font-size: 0.65rem !important; }
        .title-planner-row button { padding: 0.375rem 0.75rem !important; }

        /* --- TABS DE VISTA: scroll horizontal, SOLO ÍCONOS en móvil --- */
        .views-tabs-bar {
          overflow-x: auto !important;
          flex-wrap: nowrap !important;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
          gap: 0.25rem !important;
          padding: 0.375rem !important;
        }
        .views-tabs-bar::-webkit-scrollbar { display: none; }
        /* Ocultar el texto de cada tab, dejar solo el ícono */
        .views-tabs-bar button > span:not([id]) { display: none !important; }
        /* Pills de conteo: también más pequeñas */
        .views-tabs-bar button [id*="-pill"], 
        .views-tabs-bar button [id*="-count"] { font-size: 0.5rem !important; padding: 0.1rem 0.35rem !important; }
        /* Botón GPS extra fuera de tabs: ocultar texto */
        #btn-open-global-gps-assign > span { display: none !important; }
        #btn-open-global-gps-assign { padding: 0.5rem !important; }
        /* Tabs: padding uniforme solo icono */
        .views-tabs-bar button { 
          padding: 0.5rem !important; 
          min-width: 2.25rem !important;
          flex-shrink: 0 !important;
        }

        /* --- FILTROS: apilados en columna, full width --- */
        .filters-row {
          flex-direction: column !important;
          gap: 0.5rem !important;
        }
        .filters-row > * { width: 100% !important; min-width: 0 !important; flex: 1 1 auto !important; }
        .filters-row .relative { min-width: 0 !important; }
        #search-input { width: 100% !important; }
        #filter-ciudad, #filter-empresa, #filter-estado, #filter-listin {
          width: 100% !important;
          min-width: 0 !important;
        }

        /* --- TABLA: scroll horizontal contenido --- */
        #view-container-table { overflow-x: auto !important; -webkit-overflow-scrolling: touch; }
        #view-container-table table { min-width: 600px; }
        #view-container-table th, #view-container-table td { 
          padding: 0.5rem 0.625rem !important; 
          font-size: 0.625rem !important;
          white-space: nowrap;
        }
        /* Ocultar columnas menos críticas en móvil */
        #view-container-table thead th:nth-child(6),
        #view-container-table tbody td:nth-child(6) { display: none; }

        /* --- VIEWS DE CIUDADES Y CHOFERES --- */
        #view-container-cities, #view-container-drivers { padding: 0.75rem !important; gap: 0.75rem !important; }

        /* --- MAPA: ajustar la barra superior --- */
        #view-container-mapa .bg-white.p-4 { flex-direction: column !important; gap: 0.75rem !important; }
        #view-container-mapa .bg-white.p-4 > div:last-child { flex-direction: column !important; align-items: stretch !important; }
        #view-container-mapa .bg-white.p-4 button { width: 100% !important; justify-content: center !important; }

        /* Controles sobre el mapa: scroll horizontal */
        #view-container-mapa .p-3\.5 { padding: 0.625rem !important; }
        #view-container-mapa .p-3\.5 > div:first-child { 
          overflow-x: auto;
          flex-wrap: nowrap !important;
          scrollbar-width: none;
          -webkit-overflow-scrolling: touch;
        }
        #view-container-mapa .p-3\.5 > div:first-child::-webkit-scrollbar { display: none; }
        #view-container-mapa .p-3\.5 button { white-space: nowrap; flex-shrink: 0; }

        /* Mapa: altura fija en móvil */
        #mapa-leaflet { min-height: 55vh !important; }

        /* --- HISTORIAL Y LISTÍN --- */
        #view-container-historial, #view-container-listin { padding: 0.75rem !important; }
      }
    </style>
  </head>
  <body class="min-h-full flex flex-col text-slate-800 bg-[#F8FAFC] antialiased selection:bg-slate-900 selection:text-white">
    
    <!-- ========================================== -->
    <!-- 1. BARRA SUPERIOR (HEADER CORPORATIVO)     -->
    <!-- ========================================== -->
    <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200/80 px-4 sm:px-8 py-3.5 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <!-- Logo & Marca -->
        <div class="flex items-center gap-3">
          <img 
            src="/logo.png" 
            alt="Envías C.A." 
            class="h-8 sm:h-9 w-auto object-contain mix-blend-multiply filter contrast-[1.20] brightness-[0.96]"
            loading="eager"
          />
          <div class="border-l border-slate-200 pl-3">
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-slate-900 text-white tracking-wider uppercase">Central</span>
              <span class="text-xs font-semibold text-slate-700 hidden sm:inline">Logística</span>
            </div>
            <p class="text-[11px] text-slate-400 font-medium">Panel de Despacho y Envíos</p>
          </div>
        </div>
      </div>

        <!-- Estado Operativo y Perfil -->
      <div class="flex items-center gap-3 sm:gap-6">
        <div class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50/80 border border-emerald-200/60 text-xs font-semibold text-emerald-700">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          Panel Operativo Activo
        </div>

        <!-- Usuario Conectado y Cerrar Sesión -->
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center text-xs font-bold shadow-xs">
              {userInitials}
            </div>
            <div class="hidden sm:block text-left">
              <p class="text-xs font-bold text-slate-900 leading-tight">{currentUser.nombre}</p>
              <p class="text-[10px] text-slate-400 font-medium">{currentUser.rol === 'Logistica' ? 'Logística Central' : currentUser.rol}</p>
            </div>
          </div>

          <a
            href="/api/auth/logout"
            title="Cerrar Sesión"
            class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-xl transition-colors cursor-pointer flex items-center gap-1.5 text-xs font-semibold"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span class="hidden md:inline">Salir</span>
          </a>
        </div>
      </div>
    </header>

    <!-- ========================================== -->
    <!-- CONTENIDO PRINCIPAL                        -->
    <!-- ========================================== -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-6">
      
      <!-- Métricas Rápidas (KPIs) -->
      <section class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        <div class="bg-white border border-slate-200/80 rounded-2xl p-4 shadow-sm">
          <p class="text-xs font-medium text-slate-500">Total de Guías</p>
          <p id="kpi-total" class="text-2xl font-extrabold text-slate-900 mt-1">0</p>
        </div>
        <div class="bg-white border border-slate-200/80 rounded-2xl p-4 shadow-sm">
          <p class="text-xs font-medium text-slate-500">Por Contactar</p>
          <p id="kpi-contactar" class="text-2xl font-extrabold text-amber-600 mt-1">0</p>
        </div>
        <div class="bg-white border border-slate-200/80 rounded-2xl p-4 shadow-sm">
          <p class="text-xs font-medium text-slate-500">En Ruta / Tránsito</p>
          <p id="kpi-ruta" class="text-2xl font-extrabold text-indigo-600 mt-1">0</p>
        </div>
        <div class="bg-white border border-slate-200/80 rounded-2xl p-4 shadow-sm">
          <p class="text-xs font-medium text-slate-500">GPS Confirmado</p>
          <p id="kpi-gps" class="text-2xl font-extrabold text-emerald-600 mt-1">0</p>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- 2. FORMULARIO DE CARGA RÁPIDA DE GUÍAS     -->
      <!-- ========================================== -->
      <section class="bg-white border border-slate-200/80 rounded-2xl p-5 sm:p-6 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 pb-3 mb-4 gap-2">
          <div>
            <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              <span>Carga Rápida de Envíos</span>
            </h2>
            <p class="text-xs text-slate-500">Ingresa los datos para generar la orden y habilitar el enlace de WhatsApp</p>
          </div>
          <div class="flex items-center gap-2">
            <button
              type="button"
              onclick="window.openFrequentClientsModal()"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold text-xs border border-indigo-200 shadow-2xs transition-all cursor-pointer"
              title="Abrir directorio de clientes frecuentes"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              <span>Directorio Clientes</span>
              <span id="quick-frequent-clients-count" class="text-[10px] bg-indigo-200/80 text-indigo-900 px-1.5 py-0.2 rounded-full font-bold">0</span>
            </button>
            <span class="text-[11px] font-medium text-slate-400 hidden sm:inline">Entrada ágil por teclado</span>
          </div>
        </div>

        <!-- Banner de Lote Activo para Carga Rápida -->
        <div id="banner-active-lote" class="hidden mb-3.5 animate-fadeIn">
          <div class="flex flex-wrap items-center justify-between p-3 rounded-2xl bg-gradient-to-r from-indigo-950 via-slate-900 to-indigo-900 text-white border border-indigo-500/40 shadow-sm text-xs gap-2.5">
            <div class="flex items-center gap-2.5 flex-wrap min-w-0">
              <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse shrink-0"></div>
              <span class="text-slate-300 font-semibold">Lote Activo de Carga:</span>
              <span id="banner-active-lote-code" class="font-mono font-black text-amber-300 bg-black/50 px-2.5 py-1 rounded-lg border border-white/15 shadow-inner tracking-wider">REL-2026-W35-BRM</span>
              <span id="banner-active-lote-date" class="text-[11px] font-mono font-bold text-slate-200 bg-white/10 px-2 py-1 rounded-md border border-white/10">2026-08-28</span>
              <span class="text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 font-bold px-2 py-0.5 rounded-md flex items-center gap-1">
                <svg class="w-3 h-3 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                Asignación automática a cada guía nueva
              </span>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <button
                type="button"
                onclick="window.openGestionLotesModal()"
                class="px-2.5 py-1 rounded-lg bg-white/10 hover:bg-white/20 text-white text-[11px] font-bold transition-all cursor-pointer"
                title="Cambiar o configurar otro lote"
              >
                Cambiar
              </button>
              <button
                type="button"
                onclick="window.clearActiveCargaLote()"
                class="px-2 py-1 rounded-lg text-slate-400 hover:text-rose-300 hover:bg-rose-950/40 text-[11px] font-bold transition-all cursor-pointer"
                title="Desactivar asignación automática de lote"
              >
                ✕ Desactivar
              </button>
            </div>
          </div>
        </div>

        <form id="new-shipment-form" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3.5" autocomplete="off">
          
          <!-- Número de Guía -->
          <div class="lg:col-span-1 space-y-1">
            <label for="input-guia" class="block text-xs font-semibold text-slate-700">
              N° Guía <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="input-guia"
              required
              placeholder="Ej: 98215"
              class="w-full font-mono text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all uppercase"
            />
          </div>

          <!-- Nombre y Apellido con Autocompletado Predictivo -->
          <div class="lg:col-span-2 space-y-1 relative" id="destinatario-container">
            <div class="flex items-center justify-between">
              <label for="input-destinatario" class="block text-xs font-semibold text-slate-700">
                Destinatario <span class="text-rose-500">*</span>
              </label>
              <span class="text-[10px] text-slate-400 font-medium">Autocompleta clientes frecuentes</span>
            </div>
            <input
              type="text"
              id="input-destinatario"
              required
              autocomplete="off"
              placeholder="Nombre y Apellido completo"
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
            />
            <!-- Dropdown flotante de sugerencias de clientes frecuentes -->
            <div
              id="destinatario-autocomplete-dropdown"
              class="hidden absolute left-0 right-0 top-full mt-1.5 bg-white/95 backdrop-blur-md rounded-2xl border border-slate-200 shadow-2xl z-50 max-h-64 overflow-y-auto custom-scrollbar divide-y divide-slate-100"
            >
              <!-- Render dinámico por JS -->
            </div>
            <!-- Badge de cliente frecuente seleccionado -->
            <div id="frequent-client-selected-badge" class="hidden text-[10px] font-semibold text-emerald-800 bg-emerald-50/90 border border-emerald-200 px-2.5 py-1 rounded-lg flex items-center justify-between gap-1.5 mt-1">
              <span id="frequent-client-selected-text">Cliente frecuente seleccionado</span>
              <button type="button" onclick="window.clearFrequentClientSelection()" class="text-slate-400 hover:text-slate-600 cursor-pointer font-bold">✕</button>
            </div>
          </div>

          <!-- Teléfono / WhatsApp Principal -->
          <div class="lg:col-span-1 space-y-1">
            <label for="input-telefono" class="block text-xs font-semibold text-slate-700">
              Teléfono (WhatsApp) <span class="text-rose-500">*</span>
            </label>
            <input
              type="tel"
              id="input-telefono"
              required
              placeholder="Ej: 04141234567"
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
            />
          </div>

          <!-- Teléfono Secundario / Alternativo (Opcional) -->
          <div class="lg:col-span-1 space-y-1">
            <label for="input-telefono-2" class="block text-xs font-semibold text-slate-700">
              Teléfono 2 <span class="text-slate-400 font-normal">(Opcional)</span>
            </label>
            <input
              type="tel"
              id="input-telefono-2"
              placeholder="Ej: 04129876543"
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
            />
          </div>

          <!-- Ciudad Destino -->
          <div class="lg:col-span-1 space-y-1">
            <label for="input-ciudad" class="block text-xs font-semibold text-slate-700">
              Ciudad Destino <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="input-ciudad"
              required
              placeholder="Ej: Mérida"
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 transition-all"
            />
          </div>

          <!-- N° Piezas -->
